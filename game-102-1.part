  <div class="su-av"><div class="av-img big" id="suAv"></div><div class="su-avb"><button class="btn" id="suCam" type="button">📷 Take photo</button><button class="btn" id="suPick" type="button">🖼 Choose photo</button><button class="btn x hidden" id="suAvX" type="button" title="Remove photo">✕</button></div></div>
  <label id="suNameL">USERNAME<input id="suName" maxlength="14" placeholder="3–14 letters or numbers" spellcheck="false" autocomplete="username"></label>
  <label id="suAgeL">AGE<input id="suAge" type="number" min="5" max="100" placeholder="Your age"></label>
  <div class="su-pw"><label>PASSWORD<div class="pwrow"><input id="suPw" type="password" maxlength="32" placeholder="At least 6 characters" autocomplete="new-password"><button class="pweye" type="button" data-eye="suPw">👁</button></div></label>
  <label>CONFIRM PASSWORD<input id="suPw2" type="password" maxlength="32" placeholder="Type it again" autocomplete="new-password"></label></div>
  <div class="pwmeter"><i id="suPwM"></i></div>
  <div class="err" id="suErr"></div>
  <button class="btn pri" id="suGo">CREATE ACCOUNT ▸</button>
