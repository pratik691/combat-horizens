  <div id="lkLogin"><div class="pwrow"><input id="lkPw" type="password" maxlength="32" placeholder="Password" autocomplete="current-password"><button class="pweye" type="button" data-eye="lkPw">👁</button></div>
    <label class="lk-stay"><input type="checkbox" id="lkStay"> Stay signed in on this device</label>
