const KTN=window.CR_KTN||{};
function ktnSkin(){return KTN[save.katanaSkin]?save.katanaSkin:'wooden';}
/* ---- KATANA v2: modelled blade (curved, hamon temper line), tsuba, wrapped tsuka ---- */
const KSTYLE={
  wooden:{blade:'wood',edge:0xcaa274,spine:0x8a5a32,ito:0x6b4a2a,same:0x9a7a52,tsuba:0x2a2018,habaki:0x5a3a20,glow:0},
  iron:{blade:'steel',edge:0xf4f7fa,spine:0x8e969e,ito:0x1a1c22,same:0xe9e4d6,tsuba:0x3a2e22,habaki:0xc9a24a,glow:0},
  sun:{blade:'sun',edge:0xfffbe8,spine:0xffd56a,ito:0xa3141c,same:0xfff1c8,tsuba:0xd8b03a,habaki:0xffe08a,glow:0x5a3a00}};
const _kTex={};
function hamonTex(k){if(_kTex['h'+k])return _kTex['h'+k];const S=KSTYLE[k];
  const t=canvasTex(512,(x,w,h)=>{const sp='#'+S.spine.toString(16).padStart(6,'0'),ed='#'+S.edge.toString(16).padStart(6,'0');
    if(S.blade==='wood'){x.fillStyle='#a97a4a';x.fillRect(0,0,w,h);for(let i=0;i<90;i++){x.strokeStyle=`rgba(${80+Math.random()*40|0},${50+Math.random()*25|0},20,${0.25+Math.random()*0.3})`;x.lineWidth=1+Math.random()*2;const y=Math.random()*h;x.beginPath();x.moveTo(0,y);x.bezierCurveTo(w*0.3,y+Math.random()*8-4,w*0.6,y+Math.random()*8-4,w,y+Math.random()*6-3);x.stroke();}return;}
    const g=x.createLinearGradient(0,0,0,h);g.addColorStop(0,sp);g.addColorStop(0.38,S.blade==='sun'?'#ffe9a8':'#c3cad1');g.addColorStop(0.55,S.blade==='sun'?'#fff6d8':'#dfe5ea');g.addColorStop(1,ed);x.fillStyle=g;x.fillRect(0,0,w,h);
    // hamon: wavy temper boundary
    x.fillStyle=S.blade==='sun'?'rgba(255,255,255,.9)':'rgba(250,252,255,.85)';x.beginPath();x.moveTo(0,h);for(let i=0;i<=w;i+=4){const yy=h*0.62+Math.sin(i*0.09)*h*0.07+Math.sin(i*0.031+1)*h*0.05+Math.sin(i*0.21)*h*0.02;x.lineTo(i,yy);}x.lineTo(w,h);x.fill();
    x.strokeStyle='rgba(255,255,255,.55)';x.lineWidth=1.2;x.beginPath();for(let i=0;i<=w;i+=4){const yy=h*0.62+Math.sin(i*0.09)*h*0.07+Math.sin(i*0.031+1)*h*0.05+Math.sin(i*0.21)*h*0.02;i?x.lineTo(i,yy):x.moveTo(i,yy);}x.stroke();
    for(let i=0;i<500;i++){x.fillStyle=`rgba(255,255,255,${Math.random()*0.12})`;x.fillRect(Math.random()*w,h*0.55+Math.random()*h*0.4,2,1);}
    x.fillStyle='rgba(0,0,0,.18)';x.fillRect(0,h*0.33,w,1.5);},64);
  t.wrapS=t.wrapT=THREE.ClampToEdgeWrapping;return _kTex['h'+k]=t;}
function itoTex(k){if(_kTex['i'+k])return _kTex['i'+k];const S=KSTYLE[k];const c=n=>'#'+n.toString(16).padStart(6,'0');
  const t=canvasTex(64,(x,w,h)=>{x.fillStyle=c(S.same);x.fillRect(0,0,w,h);for(let i=0;i<300;i++){x.fillStyle=`rgba(0,0,0,${Math.random()*0.08})`;x.fillRect(Math.random()*w,Math.random()*h,1.5,1.5);}
    x.fillStyle=c(S.ito);x.beginPath();x.moveTo(0,0);x.lineTo(w*0.5,h*0.5);x.lineTo(0,h);x.lineTo(0,h*0.86);x.lineTo(w*0.36,h*0.5);x.lineTo(0,h*0.14);x.fill();
    x.beginPath();x.moveTo(w,0);x.lineTo(w*0.5,h*0.5);x.lineTo(w,h);x.lineTo(w,h*0.86);x.lineTo(w*0.64,h*0.5);x.lineTo(w,h*0.14);x.fill();
    x.beginPath();x.moveTo(w*0.14,0);x.lineTo(w*0.5,h*0.36);x.lineTo(w*0.86,0);x.fill();x.beginPath();x.moveTo(w*0.14,h);x.lineTo(w*0.5,h*0.64);x.lineTo(w*0.86,h);x.fill();
    x.strokeStyle='rgba(255,255,255,.25)';x.lineWidth=1;x.beginPath();x.moveTo(2,2);x.lineTo(w*0.46,h*0.46);x.stroke();});
  t.repeat.set(1,7);return _kTex['i'+k]=t;}
function bladeGeo(){if(_kTex.geo)return _kTex.geo;const N=40,L=0.72,z0=-0.075,pos=[],uv=[],idx=[];
  const prof=t=>{let w=0.031-0.007*t,th=0.0075-0.002*t,lift=0;if(t>0.9){const k=(t-0.9)/0.1;w*=Math.max(0.02,1-k*k*0.98);lift=k*k*0.012;}return{w,th,lift};};
  const ring=[[-0.5,0.5,0.0],[0.5,0.5,0.0],[0.4,-0.1,0.38],[0,-0.5,1],[-0.4,-0.1,0.38]];// [x*th, y*w, v]
  for(let i=0;i<=N;i++){const t=i/N,z=z0-t*L,cy=0.05*t*t,P=prof(t);for(const r of ring){pos.push(r[0]*P.th,cy+r[1]*P.w+P.lift*(r[1]<0?1:0),z);uv.push(t,1-(r[1]+0.5));}}
  const R=ring.length;for(let i=0;i<N;i++)for(let j=0;j<R;j++){const a=i*R+j,b=i*R+(j+1)%R,c=(i+1)*R+j,d=(i+1)*R+(j+1)%R;idx.push(a,c,b,b,c,d);}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));g.setAttribute('uv',new THREE.Float32BufferAttribute(uv,2));g.setIndex(idx);g.computeVertexNormals();return _kTex.geo=g;}
function makeKatana(k){k=KSTYLE[k]?k:'wooden';const S=KSTYLE[k];const g=new THREE.Group();
  const bm=new THREE.MeshPhongMaterial({map:hamonTex(k),shininess:S.blade==='wood'?18:150,specular:S.blade==='wood'?0x332211:0xffffff,emissive:S.glow,side:THREE.DoubleSide});
  const blade=new THREE.Mesh(bladeGeo(),bm);g.add(blade);g.userData.bladeMesh=blade;
  const gold=new THREE.MeshPhongMaterial({color:S.habaki,shininess:120,specular:0xfff2c0});
  const hab=new THREE.Mesh(new THREE.BoxGeometry(0.012,0.036,0.03),gold);hab.position.set(0,0.0,-0.065);g.add(hab);
  const tsM=new THREE.MeshPhongMaterial({color:S.tsuba,shininess:60,specular:0x886644});
  const tsuba=new THREE.Mesh(new THREE.CylinderGeometry(0.042,0.042,0.008,18),tsM);tsuba.rotation.x=Math.PI/2;tsuba.scale.set(1,1,0.85);tsuba.position.z=-0.046;g.add(tsuba);
  const seppa=new THREE.Mesh(new THREE.CylinderGeometry(0.022,0.022,0.012,12),gold);seppa.rotation.x=Math.PI/2;seppa.position.z=-0.038;g.add(seppa);
  const tsuka=new THREE.Mesh(new THREE.CylinderGeometry(0.0155,0.0175,0.25,10,1),new THREE.MeshPhongMaterial({map:itoTex(k),shininess:20}));tsuka.rotation.x=Math.PI/2;tsuka.scale.set(0.82,1,1);tsuka.position.z=0.093;g.add(tsuka);
  const fuchi=new THREE.Mesh(new THREE.CylinderGeometry(0.019,0.019,0.014,10),tsM);fuchi.rotation.x=Math.PI/2;fuchi.scale.set(0.82,1,1);fuchi.position.z=-0.028;g.add(fuchi);
  const kash=new THREE.Mesh(new THREE.SphereGeometry(0.018,10,6,0,Math.PI*2,0,Math.PI/2),tsM);kash.rotation.x=Math.PI/2;kash.scale.set(0.82,1,0.8);kash.position.z=0.218;g.add(kash);
  for(const s of[-1,1]){const mn=new THREE.Mesh(new THREE.BoxGeometry(0.004,0.008,0.03),gold);mn.position.set(s*0.0135,0,0.07+s*0.03);g.add(mn);}
  g.traverse(o=>{if(o.isMesh)o.castShadow=true;});return g;}
const _kIcon={};
function katanaIcon(skin,dual){skin=KSTYLE[skin]?skin:ktnSkin();const key=skin+(dual?'d':'');if(_kIcon[key])return _kIcon[key];
  const g=new THREE.Group();const a=makeKatana(skin);a.rotation.x=dual?-0.62:-0.32;g.add(a);if(dual){const b=makeKatana(skin);b.rotation.x=0.62;b.position.set(0.02,0,0.02);b.rotation.y=Math.PI;g.add(b);}
  try{return _kIcon[key]=snap(g,256,128,'side');}catch(e){return (KTN[skin]&&KTN[skin].png)||'';}}
const KROLL=1.15;
function katanaVM(M,dual){const g=new THREE.Group();const{mk,glove,sleeve}=M;const skin=ktnSkin();
  const hand=(side)=>{const H=new THREE.Group();const O=new THREE.Group();O.rotation.set(0.9,0,0.12);O.position.set(0,0.005,0.0);H.add(O);const k=makeKatana(skin);k.scale.setScalar(0.74);k.rotation.z=KROLL;O.add(k);H.userData.k=k;
    mk(H,0.07,0.075,0.085,glove,0,-0.004,0.0);mk(H,0.072,0.072,0.2,sleeve,side*0.02,-0.075,0.13,0.55);return H;};
  const R=hand(1);g.add(R);g.userData.R=R;R.userData.rest={x:0,y:0,z:0};
  if(dual){const L=hand(-1);L.position.set(-0.36,0,0);L.scale.x=-1;g.add(L);g.userData.L=L;L.userData.rest={x:-0.36,y:0,z:0};}
  // slash trail lives in the viewmodel group
  const tm=new THREE.MeshBasicMaterial({color:skin==='sun'?0xffd36a:skin==='wooden'?0xe8d2a8:0xdff4ff,transparent:true,opacity:0,depthWrite:false,side:THREE.DoubleSide});
  const trail=new THREE.Mesh(new THREE.RingGeometry(0.34,0.5,40,1,0,Math.PI*0.95),tm);trail.renderOrder=5;g.userData.trail=trail;g.userData.trailMat=tm;g.add(trail);
  const fl=new THREE.Mesh(new THREE.PlaneGeometry(0.16,0.16),new THREE.MeshBasicMaterial({map:FIRE_TEX,color:0xbfefff,transparent:true,opacity:0,blending:THREE.AdditiveBlending,depthWrite:false}));g.userData.flash=fl;g.add(fl);
  return g;}
/* combo animation: each attack = windup → fast cut → recover */
const KCOMBO=[
  {s:{x:0.1,y:0.04,rx:0.15,ry:-0.55,rz:0.95},e:{x:-0.26,y:-0.02,rx:-0.1,ry:0.8,rz:-1.35},tr:{z:0.05,flip:0}},
  {s:{x:-0.2,y:-0.06,rx:-0.15,ry:0.7,rz:-1.5},e:{x:0.16,y:0.09,rx:0.2,ry:-0.6,rz:0.85},tr:{z:2.6,flip:1}},
  {s:{x:0.02,y:0.16,rx:1.05,ry:0.05,rz:0.25},e:{x:-0.04,y:-0.12,rx:-1.25,ry:0,rz:0.1},tr:{z:-1.45,flip:0}}];
const easeOut=t=>1-Math.pow(1-t,3),easeInOut=t=>t<0.5?2*t*t:1-Math.pow(-2*t+2,2)/2;
function kAttackPose(t,c){const C=KCOMBO[c%3];const o={x:0,y:0,z:0,rx:0,ry:0,rz:0};const lerp=(a,b,k)=>a+(b-a)*k;
  if(t<0.22){const k=easeInOut(t/0.22);for(const q in C.s)o[q]=C.s[q]*k;}
  else if(t<0.5){const k=easeOut((t-0.22)/0.28);for(const q in C.s)o[q]=lerp(C.s[q],C.e[q],k);o.z=-0.06*Math.sin(k*Math.PI);}
  else{const k=easeInOut(Math.min(1,(t-0.5)/0.5));for(const q in C.e)o[q]=C.e[q]*(1-k);}
  return o;}
function katanaAnim(m,dt,p,dual){const R=m.userData.R,L=m.userData.L;if(!R)return;const T=S.time;
  const breathe=Math.sin(T*1.7)*0.004,sway=Math.sin(T*0.9)*0.02;
  const dur=dual?0.34:0.48;const bk=vm.blockK||0;
  const poseFor=(H,which)=>{let o={x:0,y:breathe,z:0,rx:0,ry:0,rz:sway*(which?-1:1)};
    const atk=which?vm.kAtkL:vm.kAtk;if(atk!==undefined&&atk>=0&&atk<1){const a=kAttackPose(atk,which?(vm.kComboL||0):(vm.kCombo||0));for(const q in a)o[q]+=a[q]*(which?(q==='x'||q==='ry'||q==='rz'?-1:1):1);}
    // guard: single = horizontal blade across the screen; dual = crossed X
    if(bk>0){if(dual){o.x+=(which?0.1:-0.1)*bk;o.y+=0.06*bk;o.rz+=(which?-0.75:0.75)*bk;o.rx+=0.25*bk;}else{o.x-=0.08*bk;o.y+=0.04*bk;o.rz+=1.15*bk;o.rx+=0.12*bk;o.ry-=0.15*bk;}}
    const pr=vm.parry||0;o.rz+=Math.sin(pr*Math.PI)*0.3*(which?-1:1);
    const r=H.userData.rest;H.position.set(r.x+o.x*(which?-1:1)*(which?-1:1),r.y+o.y,r.z+o.z);H.rotation.set(o.rx,o.ry,o.rz);};
  if(vm.kAtk!==undefined&&vm.kAtk>=0){vm.kAtk+=dt/dur;if(vm.kAtk>=1)vm.kAtk=-1;}
  if(vm.kAtkL!==undefined&&vm.kAtkL>=0){vm.kAtkL+=dt/dur;if(vm.kAtkL>=1)vm.kAtkL=-1;}
  poseFor(R,0);if(L)poseFor(L,1);
  // inspect: spin the blade around its length
  if(vm.inspect>0){const k=1-vm.inspect/1.4;R.userData.k.rotation.z=KROLL+k*Math.PI*2;R.rotation.y+=Math.sin(k*Math.PI)*0.6;}else R.userData.k.rotation.z=KROLL;
  // trail
  const tr=m.userData.trail,tm=m.userData.trailMat;let tv=0,which=-1;
  for(const [a,w] of [[vm.kAtk,0],[vm.kAtkL,1]])if(a!==undefined&&a>0.2&&a<0.62){const k=(a-0.2)/0.42;const v=Math.sin(Math.min(1,k*1.4)*Math.PI)*0.55;if(v>tv){tv=v;which=w;}}
  if(which>=0){const c=KCOMBO[(which?vm.kComboL:vm.kCombo)%3];const k=((which?vm.kAtkL:vm.kAtk)-0.2)/0.42;tr.position.set(which?-0.2:-0.02,0.0,-0.22);tr.rotation.set(-0.35,0,c.tr.z+(which?Math.PI:0));tr.scale.set(1,1,1);tr.rotation.z+= (c.tr.flip?-1:1)*(k-0.5)*0.6;}
  tm.opacity=tv;tr.visible=tv>0.01;
  const fl=m.userData.flash;const pv=vm.parry||0;fl.material.opacity=pv*0.9;fl.visible=pv>0.01;fl.position.set(dual?-0.18:-0.05,0.09,-0.3);fl.scale.setScalar(1+pv*1.5);fl.rotation.z+=dt*8;}

/* ---- deflect: hold right-click with the katana; bullets that hit your blade fly back at the shooter ---- */
const isKatana=id=>id==='katana'||id==='dualkatana';
function canDeflect(p){return p.alive&&p.blocking&&isKatana(curW().id)&&!p.blockBroken;}
function facingFrom(p,src){const fx=-Math.sin(p.yaw),fz=-Math.cos(p.yaw);const dx=src.x-p.pos.x,dz=src.z-p.pos.z,d=Math.hypot(dx,dz)||1;return (fx*dx+fz*dz)/d;}
function tryDeflect(v,amt,att,wid,head){if(v!==player||!att||att===v||!att.alive||!canDeflect(v))return false;
  const W=WEAPONS[wid];if(!W||W.melee||W.nade||W.taser)return false;
  if(facingFrom(v,att.pos)<0.3)return false;
  const perfect=S.time-(v.blockStart||-9)<0.22;const mult=perfect?1.5:1;
  v.stamina=Math.max(0,(v.stamina||0)-(perfect?0.02:0.07));if(v.stamina<=0){v.blockBroken=true;v.blocking=false;center('<span style="color:#ff6b5f">GUARD BROKEN</span>',0.8);}
  const from=camera.position.clone().add(viewDir(v.yaw,v.pitch).multiplyScalar(0.7));const to=new V3(att.pos.x,att.pos.y+1.3,att.pos.z);
  tracer(from,to,DEFL_TR);particles(from,'spark',perfect?14:7,3);vm.parry=1;
  if(!playHZ('gp:misc/head_hit',0.7))sfx('clang');sfx('clang',perfect?1.2:0.8);
  floatText(from,perfect?'PERFECT PARRY':'DEFLECT',perfect?'#ffd23f':'#9fe8ff');
  const back=amt*0.9*mult;
  if(NET.role==='client'){netToHost({t:'hit',id:att.id,d:Math.round(back*10)/10,h:!!head,w:'katana'});}
  else damage(att,back,v,'katana',head);
  if(!att.alive){medal(perfect?'RETURN TO SENDER':'DEFLECT KILL',2);}
  return true;}
const DEFL_TR=new THREE.LineBasicMaterial({color:0x9fe8ff,transparent:true,opacity:0.95});

function vmBase(id){const w=WEAPONS[id];const c=w.melee?'melee':w.nade?'nade':w.cat;return VMB[c]||VMB.rifle;}

/* ================= AUDIO ================= */
/* ================= AUDIO ENGINE =================
   Everything is synthesised with WebAudio except the hit/kill/throw clips (decoded from the
   embedded sound pack). Gunshots are layered: crack + body + low thump + mechanical click + reverb tail,
   with stereo panning and distance muffling for other players. Reloads play staged mechanical sounds. */
let actx=null,master=null,noiseBuf=null,verbIn=null;const AUD={pend:null,indoor:0,envT:0,beatT:0,ui:0};const OWB={};let lastHitSnd=0;
function makeIR(sec,decay){const r=actx.sampleRate,len=Math.floor(r*sec),b=actx.createBuffer(2,len,r);for(let c=0;c<2;c++){const d=b.getChannelData(c);for(let i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,decay);}return b;}
function b64buf(b64){const s=atob(b64),u=new Uint8Array(s.length);for(let i=0;i<s.length;i++)u[i]=s.charCodeAt(i);return u.buffer;}
function loadOW(){const A=window.CR_ASSETS&&window.CR_ASSETS.sounds;if(!A)return;for(const k in A){try{const p=actx.decodeAudioData(b64buf(A[k]),buf=>{OWB[k]=buf;},()=>{});if(p&&p.catch)p.catch(()=>{});}catch(e){}}}
function initAudio(){if(actx)return;try{actx=new(window.AudioContext||window.webkitAudioContext)();
  const comp=actx.createDynamicsCompressor();comp.threshold.value=-14;comp.ratio.value=6;comp.connect(actx.destination);
  master=actx.createGain();master.gain.value=save.vol;AUD.hp=actx.createBiquadFilter();AUD.hp.type='lowpass';AUD.hp.frequency.value=20000;master.connect(AUD.hp);AUD.hp.connect(comp);
  noiseBuf=actx.createBuffer(1,actx.sampleRate*2,actx.sampleRate);const d=noiseBuf.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;
  const verb=actx.createConvolver();verb.buffer=makeIR(1.8,3.2);verbIn=actx.createGain();verbIn.gain.value=0.5;AUD.open=actx.createGain();AUD.room=actx.createGain();verbIn.connect(AUD.open);verbIn.connect(AUD.room);AUD.open.connect(verb);verb.connect(master);
  const roomV=actx.createConvolver();roomV.buffer=makeIR(0.9,2.2);AUD.room.connect(roomV);roomV.connect(master);AUD.open.gain.value=1;AUD.room.gain.value=0;
  /* open-air slapback echo off distant buildings */const dl=actx.createDelay(1);dl.delayTime.value=0.19;const fb=actx.createGain();fb.gain.value=0.28;const dlf=actx.createBiquadFilter();dlf.type='lowpass';dlf.frequency.value=1800;AUD.slap=actx.createGain();AUD.slap.gain.value=0.35;
  AUD.open.connect(dl);dl.connect(dlf);dlf.connect(fb);fb.connect(dl);dlf.connect(AUD.slap);AUD.slap.connect(master);
  loadOW();loadHZ();}catch(e){actx=null;}}
/* 3D voice: HRTF panning (front/back + height), air absorption with distance, and muffling when a wall is in the way */
function bus3d(vol,wet,pos){const g=actx.createGain();const cam=camera.position;const dx=pos.x-cam.x,dy=(pos.y||0)+1.2-cam.y,dz=pos.z-cam.z,d=Math.hypot(dx,dy,dz);
  let occ=0;if(d>1.5&&typeof worldMeshes!=='undefined'){const dir=new V3(dx,dy,dz).divideScalar(d);raycaster.set(cam,dir);raycaster.far=d-0.6;const h=raycaster.intersectObjects(worldMeshes,false);raycaster.far=Infinity;occ=Math.min(2,h.length);}
  g.gain.value=vol*(occ?0.55/occ:1);const lp=actx.createBiquadFilter();lp.type='lowpass';lp.frequency.value=Math.max(500,(occ?1400/occ:18000)*Math.exp(-d/90));
  const pn=actx.createPanner();pn.panningModel='HRTF';pn.distanceModel='linear';pn.rolloffFactor=0;pn.refDistance=1;
  if(pn.positionX){pn.positionX.value=pos.x;pn.positionY.value=(pos.y||0)+1.2;pn.positionZ.value=pos.z;}else pn.setPosition(pos.x,(pos.y||0)+1.2,pos.z);
  g.connect(lp);lp.connect(pn);pn.connect(master);if(wet>0&&verbIn){const w=actx.createGain();w.gain.value=wet*(1+occ*0.5);pn.connect(w);w.connect(verbIn);}return g;}
function audioListener(dt){if(!actx)return;const L=actx.listener,c=camera.position;const f=new V3(0,0,-1).applyQuaternion(camera.quaternion),u=new V3(0,1,0).applyQuaternion(camera.quaternion);
  if(L.positionX){L.positionX.value=c.x;L.positionY.value=c.y;L.positionZ.value=c.z;L.forwardX.value=f.x;L.forwardY.value=f.y;L.forwardZ.value=f.z;L.upX.value=u.x;L.upY.value=u.y;L.upZ.value=u.z;}else{L.setPosition(c.x,c.y,c.z);L.setOrientation(f.x,f.y,f.z,u.x,u.y,u.z);}
  // room detection: roof over your head = tight indoor reverb, open sky = long outdoor tail + slapback
  AUD.envT-=dt;if(AUD.envT<=0&&S.state==='game'){AUD.envT=0.4;raycaster.set(c,new V3(0,1,0));raycaster.far=14;const h=raycaster.intersectObjects(worldMeshes,false);raycaster.far=Infinity;AUD.indoor=h.length?1:0;
    const t=actx.currentTime;AUD.room.gain.setTargetAtTime(AUD.indoor?1.3:0,t,0.3);AUD.open.gain.setTargetAtTime(AUD.indoor?0.25:1,t,0.3);AUD.slap.gain.setTargetAtTime(AUD.indoor?0.05:0.35,t,0.3);}
  // low health: world goes muffled and you hear your heartbeat
  const low=S.state==='game'&&player.alive&&player.hp<30;AUD.hp.frequency.setTargetAtTime(low?1500+player.hp*40:20000,actx.currentTime,0.25);
  if(low){AUD.beatT-=dt;if(AUD.beatT<=0){AUD.beatT=0.55+player.hp/60;const o=bus(0.9,0,0);tn(o,52,0.12,0.9,'sine',0,38);tn(o,48,0.14,0.7,'sine',0.17,34);}}}
document.addEventListener('mouseover',e=>{const t=e.target.closest&&e.target.closest('button,.mode,.tab,[data-pk],.ic.r,.case-hit,.frf');if(t&&t!==AUD.hov){AUD.hov=t;if(S.state!=='game'||S.uiOpen)uiSnd('hover');}},true);
document.addEventListener('click',e=>{const t=e.target.closest&&e.target.closest('button,.mode,.tab,[data-pk],.ic.r,.case-hit');if(!t||t.disabled)return;if(S.state==='game'&&!S.uiOpen)return;uiSnd(t.classList.contains('tab')?'tab':/close|leave|back|✕/i.test(t.id+t.textContent)?'back':'click');},true);
/* match announcer: short radio callouts using the device's voice */
let _annV=null;function announce(t){if(save.announcer===false||!window.speechSynthesis)return;try{const sy=speechSynthesis;if(!_annV){const vs=sy.getVoices();_annV=vs.find(v=>/en(-|_)(GB|US)/i.test(v.lang)&&/male|daniel|google uk english male|david|alex/i.test(v.name))||vs.find(v=>/^en/i.test(v.lang))||null;}
  sy.cancel();const u=new SpeechSynthesisUtterance(t);if(_annV)u.voice=_annV;u.rate=1.05;u.pitch=0.75;u.volume=Math.min(1,(save.vol||0.6)*1.3);setTimeout(()=>{try{sy.speak(u);}catch(e){}},0);if(actx){const o=bus(0.4,0,0);nz(o,2400,0.05,0.25,'bandpass',0,1.5);}}catch(e){}}
function uiSnd(kind){if(!actx||save.uiSnd===false)return;const now=performance.now();if(kind==='hover'&&now-AUD.ui<45)return;AUD.ui=now;const o=bus(kind==='hover'?0.18:0.35,0,0.02);
  if(kind==='hover'){tn(o,2400,0.025,0.25,'sine');tn(o,3600,0.015,0.12,'sine',0.006);}
  else if(kind==='click'){nz(o,4200,0.02,0.4,'bandpass',0,3);tn(o,1250,0.05,0.35,'triangle',0,900);tn(o,1870,0.05,0.18,'sine',0.02);}
  else if(kind==='back'){tn(o,900,0.06,0.3,'triangle',0,600);}
  else if(kind==='tab'){nz(o,2600,0.03,0.3,'bandpass',0,2);tn(o,700,0.08,0.22,'sine',0,1100);}}
function bus(vol,pan=0,wet=0){if(AUD.pend){const p=AUD.pend;AUD.pend=null;return bus3d(vol,wet,p);}const g=actx.createGain();g.gain.value=vol;let n=g;if(pan&&actx.createStereoPanner){const p=actx.createStereoPanner();p.pan.value=clamp(pan,-1,1);g.connect(p);n=p;}n.connect(master);if(wet>0&&verbIn){const w=actx.createGain();w.gain.value=wet;n.connect(w);w.connect(verbIn);}return g;}
function _env(dest,node,a,dur,at,atk=0.002){const t=actx.currentTime+at,g=actx.createGain();g.gain.setValueAtTime(0.0001,t);g.gain.linearRampToValueAtTime(Math.max(0.0001,a),t+atk);g.gain.exponentialRampToValueAtTime(0.0001,t+atk+dur);node.connect(g);g.connect(dest);return t;}
function nz(dest,f,dur,a,type='lowpass',at=0,q=0.7,f2=null){const n=actx.createBufferSource();n.buffer=noiseBuf;n.playbackRate.value=0.8+Math.random()*0.4;const fl=actx.createBiquadFilter();fl.type=type;fl.frequency.value=f;fl.Q.value=q;const t=actx.currentTime+at;if(f2)fl.frequency.exponentialRampToValueAtTime(f2,t+dur);n.connect(fl);_env(dest,fl,a,dur,at);n.start(t,Math.random()*1.5);n.stop(t+dur+0.05);}
function tn(dest,f,dur,a,type='sine',at=0,f2=null){const o=actx.createOscillator();o.type=type;const t=actx.currentTime+at;o.frequency.setValueAtTime(f,t);if(f2)o.frequency.exponentialRampToValueAtTime(f2,t+dur);_env(dest,o,a,dur,at);o.start(t);o.stop(t+dur+0.05);}
function metal(dest,f,dur,a,at=0){for(const[m,k]of[[1,1],[2.76,0.6],[5.4,0.35],[8.9,0.2]])tn(dest,f*m*(0.98+Math.random()*0.04),dur*(1.2-k*0.4),a*k,'sine',at);}
function playOW(name,vol=1,rate=1,pan=0){const b=OWB[name];if(!b||!actx)return false;const s=actx.createBufferSource();s.buffer=b;s.playbackRate.value=rate;s.connect(bus(vol,pan,0.15));s.start();return true;}
function spatial(pos){AUD.pend=pos&&actx&&(save.audio3d!==false)?pos:null;if(AUD.pend)queueMicrotask(()=>{AUD.pend=null;});if(!pos)return{vol:1,pan:0,dist:0};const dx=pos.x-player.pos.x,dz=pos.z-player.pos.z,d=Math.hypot(dx,dz);if(d<0.5)return{vol:1,pan:0,dist:d};
  const rx=Math.cos(player.yaw),rz=-Math.sin(player.yaw);return{vol:clamp(1.2/(1+d*0.06),0.03,1),pan:clamp((dx*rx+dz*rz)/d,-1,1)*0.85,dist:d};}
/* per-gun voice: [crackHz, bodyHz, bodyDur, thumpHz, power, tail] */
const CATV={pistol:[5200,1500,0.09,170,0.8,0.35],smg:[5600,1700,0.07,160,0.7,0.3],shotgun:[3200,700,0.2,85,1.15,0.6],mg:[4200,1100,0.12,110,0.95,0.5],rifle:[4800,1200,0.12,130,0.95,0.5],sniper:[3800,650,0.3,60,1.3,0.85],dmr:[4200,900,0.2,90,1.1,0.65]};
const GUNV={deagle:[4300,900,0.16,95,1.15,0.6],r8:[4000,850,0.18,90,1.15,0.6],ak47:[4400,1000,0.14,115,1.0,0.55],m249:[4000,950,0.13,100,1.0,0.55],negev:[4400,1250,0.1,120,0.9,0.5],awp:[3500,520,0.38,50,1.45,1],barrett:[3300,480,0.42,45,1.5,1],ssg08:[4600,900,0.22,80,1.1,0.7],thompson:[4000,1050,0.1,120,0.85,0.4],p90:[6000,1900,0.06,170,0.65,0.3],xm1014:[3300,800,0.17,90,1.05,0.55],sawedoff:[3000,600,0.24,75,1.2,0.6]};
function hashId(id){let h=0;for(const c of id)h=(h*31+c.charCodeAt(0))>>>0;return h;}
function gunSound(id,pos){
  if(realShot(id,pos))return;
  if(!actx)return;const w=WEAPONS[id];if(!w)return;const sp=spatial(pos);if(sp.vol<0.035)return;
  const far=clamp(sp.dist/60,0,1),pv=0.96+Math.random()*0.08,hv=0.9+(hashId(id)%20)/100;
  if(w.sil){const o=bus(0.9*sp.vol,sp.pan,0.15);nz(o,3800*pv,0.07,0.45,'bandpass',0,1.2);tn(o,240*pv,0.06,0.3,'sine',0,110);metal(o,1900*pv,0.05,0.06,0.012);return;}
  const v=GUNV[id]||CATV[w.cat]||CATV.rifle;const[cr,bd,bdur,th,pw,tail]=v;
  const o=bus(sp.vol*0.85,sp.pan,tail*(0.6+far));
  if(far<0.8)nz(o,cr*hv*pv,0.018,0.55*pw*(1-far),'highpass',0,0.5);
  nz(o,bd*hv*pv*(1-far*0.6),bdur*(1+far*0.5),0.9*pw,'bandpass',0,0.6);
  nz(o,900*(1-far*0.5),bdur*1.6,0.55*pw,'lowpass',0.004);
  tn(o,th*pv,bdur*1.2,0.9*pw,'sine',0,Math.max(28,th*0.35));
  if(!pos||sp.dist<6)metal(o,2600*hv,0.035,0.05,0.015);
}
/* staged reload / handling sounds */
const REAL_MECH={rifle:{magout:'ak47m/ak47_clipout',magin:'ak47m/ak47_clipin',charge:'ak47m/ak47_boltpull',draw:'ak47m/ak47_draw'},
  smg:{magout:'mp9/mp9_clipout',magin:'mp9/mp9_clipin',charge:'mp9/mp9_boltback',draw:'mp9/mp9_draw'},
  pistol:{magout:'glock18/glock_clipout',magin:'glock18/glock_clipin',slide:'glock18/glock_sliderelease',draw:'glock18/glock_draw'},
  sniper:{magout:'awp/awp_clipout',magin:'awp/awp_clipin',bolt:'awp/awp_boltback_r',draw:'awp/awp_draw'}};
REAL_MECH.dmr=REAL_MECH.rifle;REAL_MECH.mg=Object.assign({},REAL_MECH.rifle,{draw:'ak47m/ak47_draw'});
function realMech(w,name){const m=REAL_MECH[w&&w.cat];const s=m&&m[name];if(!s)return false;const ok=playHZ('gp:'+s,0.8);
  if(ok&&name==='magout')setTimeout(()=>playHZ('gp:all/mag_drop_'+(1+(Math.random()*2|0)),0.45),280);
  if(ok&&name==='bolt')setTimeout(()=>playHZ('gp:awp/awp_boltforward_r',0.8),220);
  if(ok&&name==='charge'&&w.cat==='smg')setTimeout(()=>playHZ('gp:mp9/mp9_boltforward',0.8),160);
  return ok;}
function mech(name,pos,vol=1){
  if(!actx)return;const sp=spatial(pos);const o=bus(0.7*vol*sp.vol,sp.pan,0.08);
  switch(name){
    case 'magout':nz(o,2200,0.05,0.35,'bandpass',0,2);metal(o,1300,0.06,0.12,0.01);nz(o,700,0.08,0.25,'lowpass',0.05);break;
    case 'magin':nz(o,1600,0.04,0.4,'bandpass',0,2);metal(o,1700,0.05,0.18,0.0);tn(o,180,0.05,0.3,'square',0.0,90);metal(o,2200,0.04,0.12,0.06);break;
    case 'charge':nz(o,3000,0.06,0.35,'bandpass',0,3);metal(o,2100,0.05,0.2,0.0);nz(o,2600,0.05,0.4,'bandpass',0.12,3);metal(o,1500,0.07,0.25,0.12);tn(o,140,0.06,0.25,'square',0.12,70);break;
    case 'slide':nz(o,3400,0.05,0.35,'bandpass',0,3);metal(o,2400,0.05,0.25,0.02);tn(o,200,0.04,0.2,'square',0.02,100);break;
    case 'shell':nz(o,1800,0.03,0.3,'bandpass',0,2);metal(o,2000+Math.random()*300,0.05,0.12,0.0);tn(o,150,0.04,0.25,'square',0.0,80);break;
    case 'pump':nz(o,1400,0.07,0.5,'bandpass',0,1.5);metal(o,900,0.06,0.2,0);nz(o,1800,0.07,0.5,'bandpass',0.13,1.5);metal(o,1200,0.07,0.25,0.13);break;
    case 'bolt':nz(o,2600,0.05,0.4,'bandpass',0,2.5);metal(o,1800,0.06,0.2,0);nz(o,2000,0.06,0.35,'bandpass',0.16,2.5);metal(o,1300,0.06,0.25,0.16);nz(o,2400,0.05,0.35,'bandpass',0.32,2.5);metal(o,2000,0.05,0.2,0.32);break;
    case 'cyl':for(let i=0;i<3;i++)metal(o,2400-i*200,0.04,0.12,i*0.07);nz(o,2000,0.04,0.25,'bandpass',0,2);break;
    case 'boxopen':nz(o,1200,0.1,0.4,'bandpass',0,1.5);metal(o,800,0.12,0.2,0.02);break;
    case 'belt':for(let i=0;i<6;i++)metal(o,2600+Math.random()*600,0.03,0.07,i*0.03);break;
    case 'draw':nz(o,1200,0.12,0.25,'bandpass',0,1,2400);metal(o,2000,0.05,0.12,0.1);break;
    case 'knifedraw':nz(o,4000,0.25,0.3,'bandpass',0,4,9000);metal(o,3600,0.25,0.08,0.05);break;
    case 'swing':nz(o,1800,0.16,0.4,'bandpass',0,1.2,4200);break;
    case 'empty':metal(o,2600,0.03,0.25,0);tn(o,900,0.02,0.15,'square');break;
    case 'casing':for(let i=0;i<3;i++)metal(o,(4200+Math.random()*1200)*(i?0.92:1),0.07,0.06/(i+1),i*0.06+Math.random()*0.02);break;
    case 'hull':tn(o,320,0.06,0.15,'triangle',0,200);tn(o,300,0.05,0.08,'triangle',0.12,190);break;
    case 'step':nz(o,700+Math.random()*300,0.07,0.55,'lowpass',0,0.8);nz(o,2400,0.025,0.12,'highpass',0.005);break;
    case 'land':nz(o,500,0.12,0.7,'lowpass');tn(o,90,0.08,0.3,'sine',0,50);break;
    case 'whiz':nz(o,5000,0.16,0.5,'bandpass',0,6,1400);break;
    case 'ric':tn(o,3000+Math.random()*2000,0.18,0.08,'sine',0,1200+Math.random()*600);nz(o,4000,0.03,0.12,'highpass');break;
  }
}
const RELOAD_STAGES={pistol:[[0.15,'magout'],[0.55,'magin'],[0.85,'slide']],smg:[[0.15,'magout'],[0.55,'magin'],[0.85,'charge']],rifle:[[0.15,'magout'],[0.55,'magin'],[0.85,'charge']],dmr:[[0.15,'magout'],[0.55,'magin'],[0.85,'charge']],sniper:[[0.15,'magout'],[0.5,'magin'],[0.8,'bolt']],mg:[[0.1,'boxopen'],[0.35,'magout'],[0.55,'belt'],[0.75,'magin'],[0.9,'charge']],shotgun:[[0.15,'magout'],[0.55,'magin'],[0.85,'pump']]};
function reloadStages(w){if(w.id==='r8')return[[0.1,'cyl'],[0.5,'shell'],[0.6,'shell'],[0.85,'cyl']];if(w.id==='dualies')return[[0.1,'magout'],[0.35,'magin'],[0.55,'magout'],[0.75,'magin'],[0.9,'slide']];return RELOAD_STAGES[w.cat]||RELOAD_STAGES.rifle;}
function sfx(name,vol=1,pos){
  if(!actx)return;if(actx.state==='suspended')actx.resume();
  const GW=WEAPONS[name];if(GW&&!GW.nade&&!GW.melee&&!GW.taser){gunSound(name,pos);return;}
  const sp=spatial(pos);const o=bus(vol*sp.vol,sp.pan,0.12);
  switch(name){
    case 'enemy':gunSound('ak47',pos);break;
    case 'knife':mech('swing',null,vol);break;
    case 'throw':if(!playOW('bow',0.7*vol,1.1))nz(o,1800,0.15,0.2,'bandpass');break;
    case 'hit':{const now=performance.now();if(now-lastHitSnd<55)break;lastHitSnd=now;if(!playOW('successful_hit',0.55*vol,1.0))tn(o,1300,0.05,0.12,'square');break;}
    case 'head':lastHitSnd=performance.now();if(!playHZ('gp:misc/head_hit',0.9)){if(!playOW('successful_hit',0.6*vol,1.38))tn(o,1900,0.12,0.25);metal(o,2900,0.18,0.18,0.0);}break;
    case 'kill':if(HZB['ki:kill_sound'])break;playOW(pick(['bowhit1','bowhit2','bowhit3','bowhit4']),0.7*vol,1.15);tn(o,880,0.09,0.18,'triangle');tn(o,1320,0.16,0.18,'triangle',0.08);break;
    case 'empty':if(!playHZ('gp:misc/dry_fire',0.8))mech('empty');break;
    case 'reload':mech('magout');break;
    case 'shell':mech('shell');break;
    case 'scope':/* lens zoom: click + short servo whirr */nz(o,4200,0.02,0.28,'highpass');metal(o,1800,0.03,0.08,0.01);tn(o,320,0.12,0.06,'sawtooth',0.02,520);nz(o,2600,0.1,0.08,'bandpass',0.02,6,3600);break;
    case 'buy':/* gear grab: cloth rustle + metal clack + soft confirm */nz(o,1800,0.09,0.35,'bandpass',0,1.2,900);metal(o,1500,0.05,0.12,0.03);tn(o,140,0.06,0.35,'sine',0.03,80);tn(o,880,0.07,0.12,'triangle',0.05);tn(o,1320,0.12,0.12,'triangle',0.11);break;
    case 'deny':/* muted double thud */for(const at of[0,0.11]){tn(o,170,0.09,0.22,'triangle',at,120);nz(o,400,0.06,0.18,'lowpass',at);}break;
    case 'pickup':nz(o,2200,0.12,0.3,'bandpass',0,1.4,1100);metal(o,1100,0.06,0.16,0.04);tn(o,90,0.08,0.4,'sine',0.04,60);metal(o,1700,0.05,0.1,0.12);break;
    case 'hurt':if(!playOW('sx_hit'+(1+Math.floor(Math.random()*3)),0.8*vol))tn(o,120,0.18,0.5,'sine',0,60);nz(o,600,0.08,0.2);break;
    case 'beep':/* radio chirp */nz(o,2600,0.03,0.25,'bandpass',0,2);tn(o,1180,0.06,0.18,'square',0.02);tn(o,1480,0.07,0.14,'square',0.08);nz(o,3200,0.05,0.12,'bandpass',0.15,3);break;
    case 'bombbeep':/* C4 beep: two detuned square tones through a tiny speaker */{const f=actx.createBiquadFilter();f.type='bandpass';f.frequency.value=2200;f.Q.value=2.5;f.connect(o);tn(f,2093,0.085,0.35,'square');tn(f,2108,0.085,0.25,'square');nz(o,6000,0.006,0.08,'highpass');}break;
    case 'go':/* round start: radio squelch + rising horn */nz(o,2400,0.05,0.35,'bandpass',0,1.5);[392,523,659].forEach((f,i)=>{tn(o,f,0.5-i*0.1,0.12,'sawtooth',0.04+i*0.06);tn(o,f*2,0.4,0.05,'triangle',0.04+i*0.06);});nz(o,120,0.25,0.35,'lowpass',0.04);nz(o,2400,0.04,0.25,'bandpass',0.6,1.5);break;
    case 'warn':/* alarm: two-tone klaxon with a low pulse */for(let i=0;i<3;i++){tn(o,i%2?622:880,0.2,0.13,'sawtooth',i*0.22);tn(o,i%2?311:440,0.2,0.09,'square',i*0.22);}tn(o,55,0.8,0.35,'sine',0,40);break;
    case 'land':if(!playOW(vol>1?'sx_fallbig':'sx_fallsmall',0.8))mech('land');break;
    case 'click':nz(o,5000,0.012,0.25,'highpass');metal(o,2400,0.03,0.08,0.004);tn(o,180,0.02,0.15,'square',0.002,90);break;
    case 'slide':nz(o,1500,0.6,0.32,'bandpass',0,0.9,420);nz(o,300,0.35,0.18,'lowpass');break;
    case 'jump':/* gear shake + push-off */nz(o,650,0.09,0.2,'lowpass');nz(o,2800,0.07,0.08,'bandpass',0.01,2);metal(o,1600,0.04,0.04,0.02);break;
    case 'backstab':if(!playHZ('gp:misc/head_hit',1))tn(o,1900,0.12,0.25);tn(o,140,0.3,0.5,'sine',0,50);metal(o,3200,0.15,0.2);break;
    case 'boom':{const b2=bus(vol*sp.vol,sp.pan,0.9);if(!playOW(Math.random()<.5?'sx_explode1':'sx_explode2',1.1*vol*sp.vol,0.95+Math.random()*0.1,sp.pan))nz(b2,500,1.4,1.0);nz(b2,2500,0.08,0.4,'highpass');tn(b2,70,0.9,0.8,'sine',0,22);break;}
    case 'smoke':/* pop, then a long pressurised hiss that settles */nz(o,1200,0.05,0.5,'bandpass',0,1.5);tn(o,110,0.12,0.4,'sine',0,60);nz(o,5200,2.4,0.28,'highpass',0.05,0.7,1800);nz(o,900,1.8,0.25,'lowpass',0.08,0.7,250);break;
    case 'molly':nz(o,3800,0.12,0.5,'highpass');for(let i=0;i<4;i++)nz(o,5200+i*700,0.04,0.25,'bandpass',0.02+i*0.035,6);nz(o,700,0.9,0.45,'lowpass',0.05,0.7,180);break;
    case 'fire':for(let i=0;i<3;i++)nz(o,1800+Math.random()*2400,0.03,0.12+Math.random()*0.1,'bandpass',Math.random()*0.4,3);nz(o,400,0.6,0.12,'lowpass');break;
    case 'splash':nz(o,1400,0.35,0.5,'bandpass',0,1.2,500);nz(o,5000,0.12,0.2,'highpass');break;
    case 'wade':nz(o,900,0.28,0.35,'bandpass',0,1.5,350);nz(o,2600,0.1,0.12,'bandpass',0.05,3);break;
    case 'kwhoosh':nz(o,900,0.28,0.45,'bandpass',0,1.4,2600);nz(o,3200,0.18,0.18,'highpass',0.05);break;
    case 'glass':nz(o,5200,0.09,1.1*vol,'highpass');nz(o,2600,0.22,0.55*vol,'bandpass',0.01,1.2);nz(o,7000,0.5,0.35*vol,'highpass',0.05);
      for(let i=0;i<9;i++){const at=0.04+Math.random()*0.55,f=2800+Math.random()*5200;tn(o,f,0.05+Math.random()*0.08,(0.18+Math.random()*0.2)*vol,'sine',at);tn(o,f*1.51,0.04,0.08*vol,'triangle',at);}
      nz(o,1800,0.12,0.25*vol,'bandpass',0.45+Math.random()*0.2,2);break;
    case 'clang':metal(o,2600+Math.random()*900,0.35,0.55*vol);tn(o,1800,0.12,0.25,'triangle');nz(o,6000,0.06,0.3,'highpass');break;
    case 'hiss':nz(o,4200,0.9,0.35,'highpass',0,0.7,2000);break;
    case 'zeus':nz(o,5200,0.3,0.5,'highpass');tn(o,95,0.25,0.3,'square');for(let i=0;i<5;i++)nz(o,3000+i*400,0.03,0.3,'bandpass',i*0.05,4);break;
    case 'inspect':nz(o,1800,0.25,0.16,'bandpass',0,1.2,900);metal(o,1300,0.05,0.07,0.12);nz(o,3600,0.05,0.08,'bandpass',0.3,2);metal(o,2200,0.04,0.05,0.34);break;
    case 'win':{/* victory fanfare: brass-like stabs, rising major arpeggio, held chord + cymbal */
      const br=(f,at,d,a)=>{tn(o,f,d,a,'sawtooth',at);tn(o,f*2,d,a*0.35,'triangle',at);tn(o,f*1.005,d,a*0.5,'square',at);};
      br(392,0,0.14,0.16);br(392,0.16,0.14,0.16);br(523,0.32,0.5,0.2);
      [523,659,784,1046].forEach((f,i)=>tn(o,f,0.22,0.16,'triangle',0.62+i*0.09));
      [523,659,784].forEach(f=>{tn(o,f,1.5,0.13,'sawtooth',1.0);tn(o,f/2,1.5,0.1,'triangle',1.0);});tn(o,1046,1.4,0.1,'sine',1.0);
      nz(o,7000,1.1,0.22,'highpass',1.0);nz(o,140,0.35,0.5,'lowpass',0.32);nz(o,140,0.35,0.55,'lowpass',1.0);break;}
    case 'lose':{/* defeat stinger: slow falling minor line over a low drum and a dark drone */
      [[392,0],[349,0.42],[311,0.84],[262,1.26]].forEach(([f,at],i)=>{tn(o,f,i===3?1.6:0.48,0.15,'sawtooth',at);tn(o,f/2,i===3?1.6:0.48,0.1,'triangle',at);});
      tn(o,98,2.6,0.2,'sine',0.0);tn(o,65,2.6,0.16,'sine',1.26);
      nz(o,110,0.6,0.55,'lowpass',0.0);nz(o,90,0.9,0.6,'lowpass',1.26);nz(o,2400,1.2,0.05,'bandpass',1.3,0.8);break;}
    case 'rwin':[392,523,659,784].forEach((f,i)=>{tn(o,f,0.3,0.12,'sawtooth',i*0.08);tn(o,f/2,0.35,0.08,'triangle',i*0.08);});tn(o,784,0.9,0.1,'triangle',0.32);nz(o,7000,0.6,0.07,'highpass',0.32);nz(o,120,0.3,0.35,'lowpass',0);break;
    case 'rlose':[392,370,311].forEach((f,i)=>{tn(o,f,0.38,0.12,'sawtooth',i*0.2);tn(o,f/2,0.4,0.08,'triangle',i*0.2);});tn(o,73,1.1,0.3,'sine',0.4,55);break;
    case 'levelup':/* rising arpeggio, bass hit, shimmering chord */tn(o,65,0.5,0.45,'sine',0,45);[523,659,784,1046,1318].forEach((f,i)=>{tn(o,f,0.22,0.16,'triangle',i*0.07);tn(o,f*2,0.12,0.05,'sine',i*0.07);});[1046,1318,1568].forEach(f=>tn(o,f,1.0,0.07,'sine',0.38));nz(o,8000,0.9,0.08,'highpass',0.36);break;
    case 'medal':{const k=vol>1.2?1.26:1;[784,988,1175,1568].forEach((f,i)=>{tn(o,f*k,0.16,0.15,'triangle',i*0.06);tn(o,f*k*2.01,0.08,0.04,'sine',i*0.06);});metal(o,3000*k,0.4,0.05,0.24);nz(o,9000,0.4,0.05,'highpass',0.22);}break;
  }
}

/* footsteps from the sound pack: sand outdoors, wood on crates, stone on rooftops, cloth on ladders */
const STEP_N={sand:5,stone:4,wood:3,cloth:2};
function stepSound(pos,surface,vol=1){const sp=spatial(pos);if(sp.vol<0.04)return;const n=STEP_N[surface]||5;
  if(!playOW('sx_'+surface+(1+Math.floor(Math.random()*n)),0.55*vol*sp.vol,0.94+Math.random()*0.12,sp.pan))mech('step',pos,vol);}

