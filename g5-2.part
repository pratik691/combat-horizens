/* ===== REALISTIC FIRST-PERSON HANDS: tapered sleeve + cuff, fingerless tactical glove, palm, knuckles, curled fingers, trigger finger and thumb ===== */
let _HM=null,_HMag=null;
function handMats(){const ag=(typeof save!=='undefined'&&save.agent)||'operator';if(_HM&&_HMag===ag)return _HM;_HMag=ag;
  const pal=(typeof agentPal==='function'?agentPal(ag):{})||{};const camo=pal.camo!==undefined?pal.camo:0x56603a;
  const fab=canvasTex(128,(x,S)=>{x.fillStyle='#bdbdbd';x.fillRect(0,0,S,S);for(let i=0;i<S;i+=3){x.fillStyle=`rgba(0,0,0,${0.05+Math.random()*0.05})`;x.fillRect(0,i,S,1);x.fillRect(i,0,1,S);}for(let i=0;i<14;i++){x.fillStyle=`rgba(${Math.random()<.5?0:255},${Math.random()<.5?0:255},0,.06)`;x.beginPath();x.arc(Math.random()*S,Math.random()*S,6+Math.random()*16,0,7);x.fill();}});
  const camoTex=canvasTex(128,(x,S)=>{x.fillStyle='#c9c9c9';x.fillRect(0,0,S,S);const cs=['rgba(0,0,0,.22)','rgba(255,255,255,.18)','rgba(0,0,0,.12)'];for(let i=0;i<26;i++){x.fillStyle=cs[i%3];x.beginPath();const cx=Math.random()*S,cy=Math.random()*S;for(let k=0;k<7;k++){const a=k/7*6.283,r=8+Math.random()*14;x.lineTo(cx+Math.cos(a)*r,cy+Math.sin(a)*r*0.7);}x.fill();}for(let i=0;i<S;i+=2){x.fillStyle='rgba(0,0,0,.05)';x.fillRect(0,i,S,1);}});
  camoTex.repeat.set(2,3);
  _HM={glove:new THREE.MeshPhongMaterial({color:0x2f302c,map:fab,shininess:7,specular:0x121212}),
    pad:new THREE.MeshPhongMaterial({color:0x17181a,shininess:38,specular:0x2a2a2a}),
    skin:new THREE.MeshPhongMaterial({color:0x3b3833,map:fab,shininess:10,specular:0x161616}),
    sleeve:new THREE.MeshPhongMaterial({color:camo,map:camoTex,shininess:4,specular:0x0c0c0c}),
    cuff:new THREE.MeshPhongMaterial({color:new THREE.Color(camo).multiplyScalar(0.6),shininess:4,specular:0x080808}),
    watch:new THREE.MeshPhongMaterial({color:0x111214,shininess:70,specular:0x444444})};
  return _HM;}
const _HG={};function hgeo(k,f){return _HG[k]||(_HG[k]=f());}
function hSph(par,mat,p,sx,sy,sz,rot){const m=new THREE.Mesh(hgeo('s',()=>new THREE.SphereGeometry(1,16,12)),mat);m.position.copy(p);m.scale.set(sx,sy,sz);if(rot)m.quaternion.copy(rot);par.add(m);return m;}
function hLimb(par,mat,a,b,r0,r1,seg=14,caps=true){const d=new V3().subVectors(b,a),L=d.length();const m=new THREE.Mesh(new THREE.CylinderGeometry(r1,r0,L,seg,1,!caps),mat);m.position.copy(a).addScaledVector(d,0.5);m.quaternion.setFromUnitVectors(new V3(0,1,0),d.normalize());par.add(m);
  if(caps){hSph(par,mat,a,r0,r0,r0);hSph(par,mat,b,r1,r1,r1);}return m;}
function hArc(par,mat,R,tube,a0,a1,q,c){const m=new THREE.Mesh(hgeo('t'+R.toFixed(3)+tube.toFixed(4)+(a1-a0).toFixed(2),()=>new THREE.TorusGeometry(R,tube,8,18,a1-a0)),mat);m.quaternion.copy(q).multiply(new THREE.Quaternion().setFromAxisAngle(new V3(0,0,1),a0));m.position.copy(c);par.add(m);return m;}
/* point on a ring around axis frame (u,v) */
function hRing(c,u,v,R,a){return c.clone().addScaledVector(u,Math.cos(a)*R).addScaledVector(v,Math.sin(a)*R);}
function hArm(par,M,wrist,elbow,wristR=0.031,elbowR=0.05){
  const d=new V3().subVectors(elbow,wrist).normalize();const cuffA=wrist.clone().addScaledVector(d,0.045),cuffB=wrist.clone().addScaledVector(d,0.075);
  hLimb(par,M.glove,wrist,cuffA,wristR*0.95,wristR*1.05,12,false);hSph(par,M.glove,wrist,wristR*0.97,wristR*0.97,wristR*0.97);
  hLimb(par,M.cuff,cuffA,cuffB,wristR*1.35,wristR*1.38,16,false);
  const t=new THREE.Mesh(hgeo('cuffr',()=>new THREE.TorusGeometry(1,0.18,8,20)),M.cuff);t.scale.setScalar(wristR*1.36);t.position.copy(cuffA);t.quaternion.setFromUnitVectors(new V3(0,0,1),d);par.add(t);
  // sleeve with a couple of fabric folds
  const s0=cuffB,s1=elbow;hLimb(par,M.sleeve,s0,s1,wristR*1.45,elbowR,16,false);
  for(const k of[0.3,0.55,0.8]){const p=s0.clone().lerp(s1,k);const f=new THREE.Mesh(hgeo('fold',()=>new THREE.TorusGeometry(1,0.12,6,18)),M.sleeve);f.scale.setScalar(THREE.MathUtils.lerp(wristR*1.45,elbowR,k)*1.0);f.position.copy(p);f.quaternion.setFromUnitVectors(new V3(0,0,1),d);f.rotateX((Math.random()-0.5)*0.4);par.add(f);}
  hSph(par,M.sleeve,elbow,elbowR,elbowR,elbowR);}
/* right hand wrapped around a pistol grip. c = grip centre, axis tilted back by `tilt` */
function handGrip(par,M,o){const g=new THREE.Group();par.add(g);const c=o.c,r=o.r,tilt=o.tilt||0.3;
  const ax=new V3(0,Math.cos(tilt),Math.sin(tilt)).normalize();          // up the grip
  const u=new V3(1,0,0),v=new V3().crossVectors(ax,u).normalize();       // u = right side, v = toward muzzle (front)
  const q=new THREE.Quaternion().setFromRotationMatrix(new THREE.Matrix4().makeBasis(u,v,ax));
  const fT=0.0098,R=r+fT*0.9;
  // three curled fingers (middle, ring, pinky) wrapping from the right side, round the front, to the left
  const ys=[0.004,-0.016,-0.035],len=[3.35,3.2,2.95],tt=[1,0.96,0.86];
  ys.forEach((dy,i)=>{const cc=c.clone().addScaledVector(ax,dy);const T=fT*tt[i];hArc(g,M.glove,R,T,-0.35,len[i]-0.35,q,cc);
    const kn=hRing(cc,u,v,R,-0.35);hSph(g,M.pad,kn.clone().addScaledVector(u,0.004),T*1.25,T*1.15,T*1.25);
    const tip=hRing(cc,u,v,R,len[i]-0.35);const tip2=hRing(cc,u,v,R*0.93,len[i]-0.05);hLimb(g,M.skin,tip,tip2,T*0.95,T*0.85,10,true);});
  // index finger resting straight along the frame (trigger discipline)
  const fw=new V3(0,-0.08,-1).normalize();
  const i0=c.clone().addScaledVector(ax,0.026).addScaledVector(u,r+0.006).addScaledVector(v,0.004);const i1=i0.clone().addScaledVector(fw,0.045);const i2=i1.clone().addScaledVector(fw,0.022).addScaledVector(u,-0.004);
  hLimb(g,M.glove,i0,i1,0.0105,0.0095);hLimb(g,M.skin,i1,i2,0.0092,0.0085);hSph(g,M.pad,i0.clone().addScaledVector(u,0.005),0.012,0.011,0.012);
  // palm + back of hand on the right/back of the grip
