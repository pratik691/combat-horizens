    p90:{t:'p90'},famas:{t:'famas'},aug:{t:'aug'},
    ak47:{barrel:56,fs:1,hg:60,wood:1,rl:76,dust:1,mag:'curved',stock:'fixed',sl:78},
    m4a4:{barrel:44,fs:1,hg:68,rail:1,vents:1,rl:74,mag:'straight',stock:'m4',sl:70},
