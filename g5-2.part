  s.getContext('2d').putImageData(id,0,0);const t=new THREE.CanvasTexture(s);t.magFilter=THREE.LinearFilter;return t;}
let _gunEnv=null;function gunEnv(){if(_gunEnv)return _gunEnv;const face=(top,mid,bot)=>{const c=document.createElement('canvas');c.width=c.height=64;const x=c.getContext('2d');const g=x.createLinearGradient(0,0,0,64);g.addColorStop(0,top);g.addColorStop(0.5,mid);g.addColorStop(1,bot);x.fillStyle=g;x.fillRect(0,0,64,64);
    x.fillStyle='rgba(255,255,255,.45)';x.fillRect(8,14,48,4);x.fillStyle='rgba(255,240,210,.2)';x.fillRect(4,24,56,2);return c;};
  const side=face('#9aa3ad','#6f6556','#2a241e'),up=(()=>{const c=document.createElement('canvas');c.width=c.height=64;const x=c.getContext('2d');const g=x.createRadialGradient(32,32,4,32,32,40);g.addColorStop(0,'#d8dde3');g.addColorStop(1,'#8f98a3');x.fillStyle=g;x.fillRect(0,0,64,64);return c;})(),dn=face('#4a3e30','#3a3128','#2a221b');
