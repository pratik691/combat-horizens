      P([[0.03,0.008],[0.03,0.046*k],[-len+0.012,0.046*k],[-len,0.036*k],[-len,0.008]],0.038*k,skin);for(let i=0;i<7;i++)mk(g,0.04*k,0.028*k,0.003,dark,0,0.03*k,0.024-i*0.006);
      mk(g,0.003,0.016*k,0.05,dark,0.0195*k,0.03*k,-0.05);mk(g,0.008,0.012,0.008,black,0,0.052*k,-len+0.012);mk(g,0.026,0.012,0.008,black,0,0.052*k,0.022);
      P([[0.028,0.012],[0.028,-0.012],[0.03+0.04,-0.11*k],[-0.012+0.04,-0.118*k],[-0.022,-0.02],[-0.06,-0.02],[-0.07,-0.04],[-len+0.03,-0.012],[-len+0.012,0.012]],0.034*k,poly,0,[[[-0.012,-0.022],[-0.05,-0.022],[-0.055,-0.036],[-0.02,-0.04]]]);
