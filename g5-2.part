    put(2*x,2*y,e1);put(2*x+1,2*y,e2);put(2*x,2*y+1,e3);put(2*x+1,2*y+1,e4);}
  oc.putImageData(od,0,0);return out;}
function hdCanvas(src){let c=src;if(!(c instanceof HTMLCanvasElement)){const t=document.createElement('canvas');t.width=src.naturalWidth||src.width;t.height=src.naturalHeight||src.height;t.getContext('2d').drawImage(src,0,0);c=t;}
  if(c.width>256||c.height>256)return c;const lite=(typeof touchCapable==='function'&&touchCapable())||(typeof vid==='function'&&vid().detail==='low');return lite?epx(c):epx(epx(c));}
function srcCanvas(src){if(src instanceof HTMLCanvasElement)return src;const t=document.createElement('canvas');t.width=src.naturalWidth||src.width;t.height=src.naturalHeight||src.height;t.getContext('2d').drawImage(src,0,0);return t;}
/* specular/reflection strength per texel: grey/dark metal shines, saturated wood/polymer stays matte; paints are glossy everywhere */
function specCanvas(c,mode){const s=document.createElement('canvas');s.width=c.width;s.height=c.height;const id=readPx(c),d=id.data;
  for(let i=0;i<d.length;i+=4){const r=d[i]/255,g=d[i+1]/255,b=d[i+2]/255,mx=Math.max(r,g,b),mn=Math.min(r,g,b),sat=mx>0?(mx-mn)/mx:0,lum=0.3*r+0.59*g+0.11*b;
