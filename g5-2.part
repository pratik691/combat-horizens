/* ===== Hobbeswyn's gun models: each gun gets its own detailed model ===== */
const QA=window.CR_QA||{};const QA_TEX={};let qaLoaded=0;
for(const id in QA){const im=new Image();const t=new THREE.Texture(im);t.flipY=false;t.magFilter=THREE.NearestFilter;t.minFilter=THREE.NearestMipmapLinearFilter;t.anisotropy=4;
  im.onload=()=>{t.needsUpdate=true;if(++qaLoaded===Object.keys(QA).length){for(const k in _svgCache)if(/^[wq]\|/.test(k))delete _svgCache[k];try{if(S.state==='menu')renderMenu();}catch(e){}}};im.src=QA[id].img;QA_TEX[id]=t;}
const QA_FIT={pistol:0.27,smg:0.62,rifle:0.98,sniper:1.18,shotgun:0.95,mg:1.05,dmr:1.05};
const QA_CFG={dualies:{flip:1}};
const QA_HANDS={deagle:[105,145,0.24],p2000:[90,155,0.35],dualies:[85,145,0.19],r8:[105,152,0.4],
  mp5:[180,130,0.45,300,96],thompson:[175,135,0.3,300,115],ump45:[190,130,0.35,305,62],bizon:[50,130,0.4,260,80],m249:[142,122,0.4,255,100],negev:[132,90,0.3,290,80],
  barrett:[142,135,0.3,250,108],ssg08:[105,125,0.45,200,112],scar20:[172,115,0.3,280,90],m1a:[115,100,0.6,230,90],aug:[190,130,0.25,300,95],famas:[175,140,0.3,290,125],
  xm1014:[150,140,0.25,290,110],nova:[128,106,0.6,220,103],sawedoff:[115,130,0.6,300,122]};
function qaHandPt(px,py,L,yoff){return new V3(0,yoff+(110-py)/333.3*L,-0.2*L-(px-200)/333.3*L);}

const _qaGeo={};
function qaGeometry(id){if(_qaGeo[id])return _qaGeo[id];const M=QA[id];const pos=[],uv=[],nor=[];const D2R=Math.PI/180;
  const corners=(f,t,dir)=>{const[fx,fy,fz]=f,[tx,ty,tz]=t;switch(dir){
    case 0:return[[tx,ty,fz],[fx,ty,fz],[fx,fy,fz],[tx,fy,fz]];
    case 1:return[[tx,ty,tz],[tx,ty,fz],[tx,fy,fz],[tx,fy,tz]];
    case 2:return[[fx,ty,tz],[tx,ty,tz],[tx,fy,tz],[fx,fy,tz]];
    case 3:return[[fx,ty,fz],[fx,ty,tz],[fx,fy,tz],[fx,fy,fz]];
    case 4:return[[fx,ty,fz],[tx,ty,fz],[tx,ty,tz],[fx,ty,tz]];
    default:return[[fx,fy,tz],[tx,fy,tz],[tx,fy,fz],[fx,fy,fz]];}};
  const v=new THREE.Vector3(),e=new THREE.Euler(),q=new THREE.Quaternion();
  for(const[f,t,o,r,fs]of M.el){const rot=r[0]||r[1]||r[2];if(rot){e.set(r[0]*D2R,r[1]*D2R,r[2]*D2R,'XYZ');q.setFromEuler(e);}
    for(let d=0;d<6;d++){const F=fs[d];if(!F)continue;const c=corners(f,t,d);let U=[[F[0],F[1]],[F[2],F[1]],[F[2],F[3]],[F[0],F[3]]];const k=((F[4]||0)/90)|0;for(let i=0;i<k;i++)U.unshift(U.pop());
      const P=c.map(p=>{v.set(p[0],p[1],p[2]);if(rot){v.sub(new THREE.Vector3(o[0],o[1],o[2])).applyQuaternion(q).add(new THREE.Vector3(o[0],o[1],o[2]));}return[v.x,v.y,v.z];});
      for(const i of[0,3,2,0,2,1]){pos.push(...P[i]);uv.push(...U[i]);}}}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));g.setAttribute('uv',new THREE.Float32BufferAttribute(uv,2));g.computeVertexNormals();
  return _qaGeo[id]=g;}
let _qaMat={};function qaMaterial(id){return _qaMat[id]||(_qaMat[id]=new THREE.MeshPhongMaterial({map:QA_TEX[id],side:THREE.DoubleSide,alphaTest:0.3,shininess:30,specular:0x1c1e22}));}
/* returns {g (gun only, muzzle toward -z, length L, grip near origin), muzzleZ, L} */
function qaGun(id,L){const M=QA[id];const geo=qaGeometry(id);const m=new THREE.Mesh(geo,qaMaterial(id));const[x0,x1,y0,y1,z0,z1]=M.bb;
  const len=z1-z0,k=L/len,flip=!!(QA_CFG[id]&&QA_CFG[id].flip);const inner=new THREE.Group();inner.add(m);
  m.position.set(-(x0+x1)/2,-(y0+y1)/2,-(z0+z1)/2);inner.scale.setScalar(k);if(flip)inner.rotation.y=Math.PI;
  const g=new THREE.Group();g.add(inner);return{g,inner,mesh:m,L,h:(y1-y0)*k};}
/* Generated viewmodels for every gun without a hand-built model */
function genericVM(w,M){
  const s=w.vm||{};const g=new THREE.Group();const{mk,cyl,skin,black,wood,metal,tan,olive,yellow,glove,sleeve,pistolHands,longHands,grip,tguard,rail,port,vents,lens,poly,dark,steel}=M;
  const furn={wood,black,tan,olive,skin}[s.furn||'black'];const L=s.len||1;let fz=-0.5,pump=null,fs=1;
  const supp=(z,r,len)=>{cyl(g,r,len,black,0,0.01,z-len/2);for(let i=0;i<3;i++)cyl(g,r*1.04,0.004,metal,0,0.01,z-len*(0.2+i*0.3));const cap=new THREE.Mesh(new THREE.CircleGeometry(r*0.35,12),dark);cap.position.set(0,0.01,z-len-0.0005);cap.rotation.y=Math.PI;g.add(cap);return z-len-0.01;};
  const hider=(z,y=0.005)=>{cyl(g,0.017,0.05,black,0,y,z-0.025);for(let i=0;i<4;i++){const a=i*Math.PI/2+0.4;mk(g,0.004,0.004,0.022,dark,Math.cos(a)*0.015,y+Math.sin(a)*0.015,z-0.035);}return z-0.05;};
  const magF=(type,z,y=-0.12)=>{
    if(type==='curved'){mk(g,0.045,0.12,0.07,black,0,y+0.01,z,0.3);mk(g,0.045,0.1,0.07,black,0,y-0.08,z-0.04,0.65);for(let i=0;i<3;i++)mk(g,0.047,0.006,0.072,poly,0,y+0.04-i*0.035,z-0.012+i*0.012,0.3);mk(g,0.05,0.012,0.075,metal,0,y-0.13,z-0.07,0.65);}
    else if(type==='box'){mk(g,0.07,0.1,0.11,black,0.01,y+0.02,z);}
    else if(type==='tube'){cyl(g,0.035,0.28,black,0,-0.06,z-0.12);}
    else if(type!=='none'){mk(g,0.04,0.15,0.06,black,0,y,z,0.12);mk(g,0.044,0.014,0.066,metal,0,y-0.078,z+0.01,0.12);mk(g,0.042,0.1,0.004,dark,0,y,z-0.031,0.12);}};
  const stockF=(type,z)=>{
    if(type==='fixed')mk(g,0.05,0.085,0.22,furn,0,-0.01,z+0.11);
    else if(type==='wire'){mk(g,0.012,0.012,0.22,metal,0.02,0,z+0.11);mk(g,0.012,0.012,0.22,metal,-0.02,-0.04,z+0.11,0.15);mk(g,0.05,0.07,0.015,metal,0,-0.02,z+0.22);}
    else if(type==='thumb')mk(g,0.03,0.05,0.1,black,0,-0.02,z+0.05);};
  const scopeF=(z,size)=>{const r=size>1?0.032:0.022,l=size>1?0.32:0.18,y=size>1?0.125:0.1;cyl(g,r,l,black,0,y,z);cyl(g,r*1.35,0.05,black,0,y,z-l/2);cyl(g,r*1.2,0.04,black,0,y,z+l/2);mk(g,0.02,0.04,0.02,black,0,y-0.035,z-l*0.3);mk(g,0.02,0.04,0.02,black,0,y-0.035,z+l*0.3);
    lens(g,r*1.35,y,z-l/2-0.026);lens(g,r*1.2,y,z+l/2+0.021);cyl(g,r*0.55,0.03,metal,0,y+r+0.01,z,'y');cyl(g,r*0.55,0.03,metal,r+0.01,y,z,'x');cyl(g,r*1.05,0.006,metal,0,y,z-l*0.2);};
  switch(s.t){
