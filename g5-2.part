  const port=(g,y,z,len=0.07)=>{mk(g,0.003,0.022,len,dark,0.031,y,z);mk(g,0.004,0.004,len+0.01,steel,0.032,y+0.013,z);};
  const vents=(g,y,z,len,n,side=0.034)=>{for(let i=0;i<n;i++){const zz=z-len/2+(i+0.5)*len/n;mk(g,0.004,0.014,len/n*0.45,dark,side,y,zz);mk(g,0.004,0.014,len/n*0.45,dark,-side,y,zz);}};
