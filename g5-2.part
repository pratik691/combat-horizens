    const drop=type==='wood'?0.05:0.035;P([[z,y+0.03],[z+0.25,y+0.03-drop*0.4],[z+0.265,y-0.08-drop],[z+0.235,y-0.088-drop],[z+0.06,y-0.045],[z,y-0.04]],0.046,mat);mk(g,0.05,0.11,0.012,dark,0,y-0.03-drop*0.6,z+0.262);};
  switch(s.t){
