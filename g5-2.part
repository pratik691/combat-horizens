  };
  function special(g,t){
    const y=50;
    if(t==='dual'){pistol(g,{sl:80,sh:17},26,-16);pistol(g,{sl:80,sh:17},0,0);return;}
    if(t==='revolver'){g.rect(0,y-4,72,9,'B',2);g.rect(4,y-8,64,4,'D',1);g.rect(72,y-11,30,22,'B',3);for(let i=0;i<4;i++)g.rect(75+i*6.5,y-9,3,18,'D',1,false);
      g.rect(102,y-8,16,18,'B',2);g.poly([[112,y+8],[128,y+6],[142,y+40],[124,y+46],[114,y+20]],'W');g.line([[100,y+10],[98,y+20],[106,y+22],[110,y+16]],'#1f2227',2.4);g.poly([[114,y-8],[124,y-16],[128,y-12],[118,y-4]],'D');return;}
    if(t==='tec9'){g.rect(0,y-4,14,8,'D',1);g.rect(14,y-7,52,14,'P',2);for(let i=0;i<5;i++)g.circ(20+i*9,y,2.2,'D',false);g.rect(66,y-9,62,19,'B',2);
      g.poly([[72,y+10],[88,y+10],[86,y+58],[74,y+58]],'P');g.poly([[100,y+10],[116,y+10],[124,y+40],[110,y+42]],'P');g.line([[90,y+11],[90,y+22],[98,y+24],[102,y+18]],'#1f2227',2.4);return;}
    if(t==='taser'){g.rect(0,y-8,14,16,'D',2);g.rect(14,y-11,62,22,'Y',4);g.rect(20,y-7,40,4,'#7a5f10',1,false);g.poly([[52,y+11],[70,y+11],[80,y+44],[62,y+46]],'P');g.line([[46,y+12],[45,y+22],[54,y+24],[58,y+18]],'#1f2227',2.4);return;}
    if(t==='p90'){g.rect(0,y-4,12,8,'D',1);g.path(`M12,${y-10}L60,${y-14}Q120,${y-16} 150,${y-6}Q160,${y+8} 150,${y+30}L120,${y+34}Q112,${y+10} 96,${y+12}L80,${y+30}L62,${y+30}L58,${y+12}L12,${y+10}Z`,'B',[[12,y-16],[160,y+34]]);
      g.rect(40,y-24,108,12,'X',3);g.path(`M84,${y+14}Q98,${y+10} 108,${y+28}L98,${y+30}Q92,${y+20} 86,${y+22}Z`,'D',[[84,y+10],[108,y+30]],false);return;}
    if(t==='famas'){g.rect(0,y-4,10,8,'D',1);g.rect(10,y-3,40,6,'D',1);g.line([[22,y+3],[10,y+38]],'#1f2227',3);g.line([[26,y+3],[38,y+38]],'#1f2227',3);
      g.poly([[50,y-10],[180,y-12],[180,y+14],[170,y+24],[110,y+14],[50,y+10]],'B');g.poly([[60,y-10],[66,y-30],[150,y-30],[162,y-12]],'B',[[[72,y-14],[76,y-24],[146,y-24],[150,y-14]]]);
      g.poly([[124,y+12],[142,y+12],[146,y+44],[128,y+46]],'P');g.poly([[74,y+12],[90,y+12],[96,y+38],[82,y+40]],'P');g.line([[66,y+12],[66,y+22],[74,y+24],[78,y+18]],'#1f2227',2.4);g.rect(178,y-12,5,36,'P',1);return;}
    if(t==='aug'){g.rect(0,y-4,12,8,'D',1);g.rect(12,y-3,34,6,'D',1);g.path(`M46,${y-10}L170,${y-12}Q182,${y} 176,${y+24}L120,${y+20}L46,${y+10}Z`,'B',[[46,y-12],[182,y+24]]);
      g.poly([[60,y+10],[72,y+10],[70,y+38],[62,y+38]],'P');g.path(`M78,${y+10}Q92,${y+40} 110,${y+18}`,'none',[[78,y+10],[110,y+40]],false);g.line([[78,y+10],[84,y+32],[100,y+34],[110,y+18]],'#1f2227',3);
      g.poly([[120,y+18],[138,y+18],[140,y+48],[122,y+48]],'X');g.rect(58,y-26,74,12,'D',4);g.poly([[58,y-26],[50,y-30],[50,y-10],[58,y-14]],'D');g.rect(130,y-24,8,8,'D',2);return;}
  }
  function weapon(id,fill){const s=SPEC[id];const g=mk();if(!s){g.rect(0,40,120,20,'B',3);return g.svg(fill);}
    if(s.t==='pistol')pistol(g,s,0,40);else if(s.t)special(g,s.t);else longGun(g,s);
    return g.svg(fill);}
  /* ---- knives ---- */
  function knife(id,blade){
    const w=WEAPONS[id]||WEAPONS.knife,s=w.shape||{};const g=mk();const L=(s.L||0.22)*640,Wd=(s.W||0.042)*520,c=s.curve||0,y=50,hc='#'+((s.hc||0x2b2b2b).toString(16).padStart(6,'0'));
    const hl=s.t==='push'?0:Math.max(70,L*0.72);
    if(s.t==='push'){g.rect(L-6,y-40,16,80,hc,6);g.path(`M${L},${y-Wd*0.8}L4,${y}L${L},${y+Wd*0.8}Z`,'S',[[4,y-Wd],[L,y+Wd]]);g.rect(L-8,y-Wd*0.9,10,Wd*1.8,'D',2);return g.svg(null,blade);}
    const dy=-c*0.34*L,tipX=0,gx=L;
    // handle
    if(s.t==='butterfly'){g.rect(gx,y-10,hl,8,hc,3);g.rect(gx,y+2,hl,8,hc,3);for(let i=0;i<5;i++){g.circ(gx+12+i*(hl-24)/4,y-6,1.8,'D',false);g.circ(gx+12+i*(hl-24)/4,y+6,1.8,'D',false);}g.circ(gx+3,y,4,'M');}
    else if(s.ring&&c<-0.5){g.path(`M${gx},${y-8}Q${gx+hl*0.5},${y-14} ${gx+hl},${y-2}L${gx+hl-4},${y+12}Q${gx+hl*0.5},${y+4} ${gx},${y+9}Z`,hc,[[gx,y-14],[gx+hl,y+12]]);}
    else g.path(`M${gx},${y-9}L${gx+hl-6},${y-8}Q${gx+hl+4},${y-6} ${gx+hl},${y+6}Q${gx+hl-4},${y+12} ${gx+hl-12},${y+11}L${gx},${y+9}Z`,hc,[[gx,y-9],[gx+hl+4,y+12]]);
    if(s.cord)for(let i=0;i<7;i++)g.line([[gx+8+i*(hl-16)/6,y-9],[gx+3+i*(hl-16)/6,y+10]],'#111',2.2);
    if(s.ring){const rcx=gx+hl+10,rcy=y+(c<-0.5?6:0);g.raw(`<circle cx="${rcx}" cy="${rcy}" r="10" fill="none" stroke="#c9ced4" stroke-width="4"/><circle cx="${rcx}" cy="${rcy}" r="12" fill="none" stroke="#0c0d0f" stroke-width="1"/><circle cx="${rcx}" cy="${rcy}" r="8" fill="none" stroke="#0c0d0f" stroke-width="1"/>`,rcx-13,rcy-13,rcx+13,rcy+13);}
    if(id==='skeleton')g.raw(`<ellipse cx="${gx+hl*0.5}" cy="${y}" rx="${hl*0.3}" ry="4" fill="#15171a"/>`);
    // guard / bolster
    if(s.guard)g.rect(gx-4,y-15,7,30,'M',2);else if(s.t==='fold'||s.t==='butterfly')g.circ(gx+2,y,5,'M');else g.rect(gx-3,y-10,6,20,'M',2);
    // blade
    const sp=-Wd*0.5,ed=Wd*0.5;
    const clip=(id==='bowie'||id==='huntsman'||id==='survival');
    let d=`M${gx},${y+sp}`;
    if(clip)d+=`L${gx-L*0.62},${y+sp}Q${gx-L*0.85},${y+sp+dy*0.3} ${tipX},${y+dy}`;
    else d+=`Q${gx-L*0.55},${y+sp+dy*0.25-(c>0?Wd*0.15:0)} ${tipX},${y+dy}`;
    d+=`Q${gx-L*0.45},${y+ed+Wd*0.45+dy*0.55} ${gx},${y+ed}Z`;
    g.path(d,'S',[[tipX,y+sp+Math.min(0,dy)],[gx,y+ed+Wd*0.45+Math.max(0,dy)]]);
    g.raw(`<path d="M${gx-4},${y+ed*0.25}Q${gx-L*0.5},${y+ed*0.25+dy*0.45} ${tipX+8},${y+dy*0.95}" fill="none" stroke="rgba(0,0,0,.25)" stroke-width="1.2"/>`);
    if(s.serr)for(let i=0;i<6;i++){const sx=gx-10-i*6;g.raw(`<path d="M${sx},${y+sp}L${sx-3},${y+sp-4}L${sx-6},${y+sp}Z" fill="#cfd5db" stroke="#0c0d0f" stroke-width=".8"/>`);}
    if(s.t==='gut')g.raw(`<path d="M${gx-L*0.45},${y+sp-0.5}Q${gx-L*0.4},${y+sp+7} ${gx-L*0.32},${y+sp-0.5}" fill="#15171a" stroke="#0c0d0f" stroke-width="1"/>`);
    return g.svg(null,blade);
  }
  return{weapon,knife,SPEC};
})();
const _svgCache={};
function svgUrl(svg){return 'data:image/svg+xml;charset=utf-8,'+encodeURIComponent(svg);}
const HB_MODES={ffa:1,br:1,tdm:1};
const NADE_SVG={he:'<svg viewBox="0 0 32 32"><rect x="13" y="3" width="6" height="5" rx="1" fill="#9aa0a6"/><path d="M19 5h6v3" stroke="#9aa0a6" stroke-width="2" fill="none"/><ellipse cx="16" cy="19" rx="9" ry="10" fill="#4f6a2c" stroke="#1d2614" stroke-width="1.5"/><path d="M8 17h16M8 22h16M16 9v20" stroke="#2f3f1a" stroke-width="1.3"/></svg>',
molotov:'<svg viewBox="0 0 32 32"><rect x="12" y="12" width="8" height="17" rx="2" fill="#7a4518" stroke="#3a2008" stroke-width="1.2"/><rect x="14" y="6" width="4" height="7" fill="#7a4518"/><rect x="13.5" y="4" width="5" height="3" fill="#d8c6a0"/><path d="M16 0c3 2 2 4 0 5c-2-1-3-3 0-5z" fill="#ff8a2a"/></svg>',
 incendiary:'<svg viewBox="0 0 32 32"><rect x="13" y="3" width="6" height="5" rx="1" fill="#9aa0a6"/><rect x="9" y="8" width="14" height="21" rx="3" fill="#8a8f95" stroke="#4a4f57" stroke-width="1.4"/><rect x="9" y="13" width="14" height="4" fill="#c2362b"/><path d="M16 19c3 3 1 7-1 7c-3 0-3-4 1-7z" fill="#ff8a2a"/></svg>',
 firebomb:'<svg viewBox="0 0 32 32"><rect x="13" y="3" width="6" height="5" rx="1" fill="#9aa0a6"/><circle cx="16" cy="19" r="10" fill="#a12a1a" stroke="#4a1208" stroke-width="1.5"/><path d="M16 12c5 4 2 11-1 11c-4 0-4-6 1-11z" fill="#ffb02a"/></svg>',
 smoke:'<svg viewBox="0 0 32 32"><rect x="12" y="3" width="8" height="4" rx="1" fill="#9aa0a6"/><rect x="9" y="7" width="14" height="22" rx="3" fill="#c8ccd0" stroke="#4a4f57" stroke-width="1.5"/><rect x="9" y="14" width="14" height="4" fill="#5b6370"/></svg>'};
let _hbKey='';
function hbIcon(id){const w=WEAPONS[id];if(!w)return '';
  if(w.nade){const t=NPK_ID[id]&&NPK.tex[NPK_ID[id]];return t?`<img class="px" src="${t}">`:(NADE_SVG[id]||NADE_SVG.he);}
  if(w.melee){const v=save.kskin&&window.CR_HZ&&HZ.kv[save.kskin]&&HZ.kv[save.kskin].w===id?save.kskin:null;let u=null;if(v&&typeof realIcon==='function')u=realIcon(id,null,v);if(!u)u=knifeIcon(id,v?'':save.knifeFin);return u?`<img src="${u}">`:'';}
  const u=weaponIcon(id,equippedPaint(id));return u?`<img src="${u}">`:'';}
function renderHotbar(){const on=(!!HB_MODES[S.mode]||(typeof TOUCH!=='undefined'&&TOUCH.on))&&player.alive&&!S.uiOpen;document.body.classList.toggle('hb',on);if(!on)return;
  const p=player,el=$('hotbar'),inf=S.mode==='practice';const parts=[];let key='';
  for(const s of [1,2,3,4,5]){const it=p.inv[s];if(!it&&s===5)continue;const w=it&&WEAPONS[it.id];let c='',cls='hb-s';
    if(!it)cls+=' empty';else{
      if(w.nade){const n=p.nades.length;c=n>1?'×'+n:'';}
      else if(w.melee)c='';
      else if(p.reloading&&s===p.slot&&!w.shell){c='…';cls+=' rel';}
      else{c=`${it.ammo}<small>/${inf?'∞':it.reserve}</small>`;if(w.mag&&it.ammo<=Math.ceil(w.mag*0.2))cls+=' low';}}
    if(s===p.slot)cls+=' on';
    key+=s+(it?it.id:'-')+c+cls+'|';
    parts.push({s,it,c,cls});}
  if((p.meds||0)>0||p.healT>0){const c=(p.meds||0)>1?'×'+p.meds:'';const cls='hb-s hb-med'+(p.healT>0?' on':'');key+='6med'+c+cls;parts.push({s:6,med:1,c,cls});}
  key+=save.kskin+save.knifeFin;
  if(key===_hbKey)return;_hbKey=key;
  el.innerHTML=parts.map(({s,it,c,cls,med})=>`<div class="${cls}" data-s="${s}"><span class="hb-k">${med?'H':s}</span>${med?'<svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="15" rx="2.5"/><path d="M10.5 9.5h3v3h3v3h-3v3h-3v-3h-3v-3h3z" fill="#fff"/></svg>':''}${it?hbIcon(it.id):''}${c?`<span class="hb-c">${c}</span>`:''}</div>`).join('');}
function weaponIcon(id,pid){if(typeof hasReal==='function'&&hasReal(id)){const u=realIcon(id,pid);if(u)return u;}if(typeof QA!=='undefined'&&QA[id]&&!pid&&QA_TEX[id]&&QA_TEX[id].image&&QA_TEX[id].image.complete){const k='q|'+id;if(_svgCache[k])return _svgCache[k];try{const r=qaGun(id,(REAL_LEN[WEAPONS[id].cat]||0.7));if(QA_CFG[id]&&QA_CFG[id].flip)r.inner.rotation.y=0;const u=snap(r.g,256,128,'side');if(u)return _svgCache[k]=u;}catch(e){}}const key='w|'+id+'|'+(pid||'');if(_svgCache[key])return _svgCache[key];
  const p=pid&&PAINTS[pid];const fill=p?(p.fin?{img:finUrl(p.fin)}:{col:'#'+p.c.toString(16).padStart(6,'0')}):null;
  return _svgCache[key]=svgUrl(SVGICON.weapon(id,fill));}
function knifeIcon(id,fin){if(id==='katana')return katanaIcon();if(id==='dualkatana')return katanaIcon(null,true);if(typeof hasReal==='function'&&hasReal(id)){const u=realIcon(id,fin&&FINS[fin]?fin:null);if(u)return u;}const key='k|'+id+'|'+(fin||'');if(_svgCache[key])return _svgCache[key];
  return _svgCache[key]=svgUrl(SVGICON.knife(id,fin&&FINS[fin]?finUrl(fin):null));}

/* =====================================================================
   REAL MODELS — Bedrock geometry + keyframe animations converted from the gun pack (lolokeia, CC BY-NC 4.0) and the knife pack (Shidzuko).
   Kill banner art & sounds by GD656.
   ===================================================================== */
const HZ=window.CR_HZ||{models:{},anims:{},tex:{},att:{},kv:{},snd:{},ki:{},kisnd:{}};
const DEG=Math.PI/180;
/* Every rifle, sniper, pistol and SMG uses a detailed model (same quality and animations as the AK-47), each with its own factory finish and size */
const GUN_ALIAS={m4a4:['ak47',0x3d4249,1.02],m4a1s:['ak47',0x2f3338,1.04],galil:['ak47',0xa08a62,0.98],famas:['ak47',0x5c6150,0.94],sg553:['ak47',0xb59a6a,1.0],aug:['ak47',0x55603c,0.96],m1a:['ak47',null,1.08],
  m249:['ak47',0x3a3d33,1.12],negev:['ak47',0x4a4e3c,1.1],
  ssg08:['awp',0x3b3f45,0.92],g3sg1:['awp',0x2c2f33,1.0],scar20:['awp',0xb7a074,1.0],barrett:['awp',0x2a2c30,1.08],
  p2000:['usp',null,0.95],fiveseven:['p250',0x55595e,1.0],cz75:['p250',0x6b4a32,1.0],deagle:['glock',0x9aa0a6,1.2],r8:['p250',0x7a7d80,1.08],dualies:['glock',0xb0b4b8,1.0],
  mp7:['mp9',0x3a3d40,1.0],mp5:['mp9',0x2b2d30,1.08],ump45:['mac10',0x45484c,1.12],bizon:['mac10',0x5a4a3a,1.08],p90:['mp9',0x5b6048,1.04],thompson:['mac10',0x6b4a2a,1.12]};
/* (aliasing disabled — every gun keeps its own model) */
function realBase(id){return GUN_ALIAS[id]&&HZ.models[id]===HZ.models[GUN_ALIAS[id][0]]?GUN_ALIAS[id][0]:id;}
function hasReal(id){return !!(HZ.models[id]&&HZ.tex[id]);}
const REAL_GUNS=Object.keys(HZ.models).filter(id=>WEAPONS[id]&&!WEAPONS[id].melee);
const REAL_KNIVES=Object.keys(HZ.models).filter(id=>WEAPONS[id]&&WEAPONS[id].melee);
/* ---- image preloading (textures must be decoded before icons can be rendered) ---- */
const HZIMG={};let hzReady=false;
(function preload(){const urls=new Set([...Object.values(HZ.tex),...Object.values(HZ.att).map(a=>a.tex),...Object.values(HZ.kv).map(v=>v.tex),...Object.keys(FINS).map(k=>finUrl(k))]);let left=urls.size;if(!left){hzReady=true;return;}
