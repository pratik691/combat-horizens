  const pq=new THREE.Quaternion().setFromRotationMatrix(new THREE.Matrix4().makeBasis(u,v,ax));hSph(g,M.glove,pc,0.019,0.034,0.046,pq);
  hSph(g,M.pad,pc.clone().addScaledVector(u,0.014).addScaledVector(v,0.004),0.006,0.026,0.03,pq);
  // thumb along the left side of the frame, pointing forward
  const t0=c.clone().addScaledVector(u,-r*0.6).addScaledVector(v,-r*0.9).addScaledVector(ax,0.006),t1=t0.clone().addScaledVector(u,-r*0.55).addScaledVector(fw,0.03),t2=t1.clone().addScaledVector(fw,0.022).addScaledVector(u,0.002);
  hLimb(g,M.glove,t0,t1,0.0125,0.011);hLimb(g,M.skin,t1,t2,0.0105,0.0092);
  // wrist and forearm back to the camera
  const wrist=c.clone().addScaledVector(ax,-0.062).addScaledVector(v,-0.026).addScaledVector(u,0.006);
  hLimb(g,M.glove,pc.clone().addScaledVector(ax,-0.03),wrist,0.026,0.027,14,false);
