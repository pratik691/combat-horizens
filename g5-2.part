function realTexFor(id,pid,variant){
  if(!pid&&!variant&&GUN_ALIAS[id]&&GUN_ALIAS[id][1]!=null&&realBase(id)!==id)return tintTex(HZ.tex[id],GUN_ALIAS[id][1],'a|'+id);
  if(variant&&HZ.kv[variant])return paintedTex(HZ.kv[variant].tex,null,'v|'+variant);
