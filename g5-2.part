  return g;}
function canopyMesh(col){const g=new THREE.Group();const m=new THREE.MeshLambertMaterial({color:col,side:THREE.DoubleSide});const c=new THREE.Mesh(new THREE.SphereGeometry(2.2,14,6,0,Math.PI*2,0,Math.PI/2.6),m);c.scale.y=0.55;c.position.y=4.2;g.add(c);
  const st=new THREE.Mesh(new THREE.SphereGeometry(2.21,14,6,0,Math.PI*2,0,Math.PI/2.6),new THREE.MeshLambertMaterial({color:0xffffff,side:THREE.DoubleSide,wireframe:true}));st.scale.y=0.55;st.position.y=4.2;g.add(st);
  const lm=new THREE.LineBasicMaterial({color:0x222222});for(let i=0;i<8;i++){const a=i/8*Math.PI*2;const geo=new THREE.BufferGeometry().setFromPoints([new V3(0,1.5,0),new V3(Math.cos(a)*2,3.9,Math.sin(a)*2)]);g.add(new THREE.Line(geo,lm));}return g;}
/* ---------- start of a BR match ---------- */
function brStart(){if(S.mode!=='br')return;const H=mapH;const a=Math.random()*Math.PI*2;const L=H*1.35;
  const A=new V3(Math.cos(a)*L,120,Math.sin(a)*L),B=new V3(-Math.cos(a)*L,120,-Math.sin(a)*L);
  BRF.plane={A,B,t:0,dur:Math.round(34*Math.max(1,H/150)),pos:A.clone(),dir:B.clone().sub(A).normalize()};
  if(BRF.planeMesh)scene.remove(BRF.planeMesh);BRF.planeMesh=brPlaneMesh();BRF.planeMesh.position.copy(A);BRF.planeMesh.rotation.y=Math.atan2(BRF.plane.dir.x,BRF.plane.dir.z);scene.add(BRF.planeMesh);
  S.air={next:70+Math.random()*20,list:[]};
  for(const e of S.ents){if(e.isNet||e.isProxy)continue;e.drop={phase:'plane'};if(e.isPlayer){e.meds=1;}else{e.drop.jumpAt=0.12+Math.random()*0.72;const L2=S.loot.filter(l=>!l.taken);const tgt=L2.length?L2[(Math.random()*L2.length)|0].g.position:new V3(rand(-H*0.7,H*0.7),0,rand(-H*0.7,H*0.7));e.drop.tx=tgt.x+rand(-6,6);e.drop.tz=tgt.z+rand(-6,6);if(e.model)e.model.g.visible=false;}}
  if(S.zone){S.zone.t+=25;}
}
function brEnd(){if(BRF.planeMesh){scene.remove(BRF.planeMesh);BRF.planeMesh=null;}BRF.plane=null;for(const w of S.gloos||[])glooRemove(w,true);S.gloos=[];for(const a of (S.air&&S.air.list)||[])airRemove(a);S.air=null;
  vmRoot.visible=true;document.body.classList.remove('dropping');for(const e of S.ents||[]){if(e.canopy){scene.remove(e.canopy);e.canopy=null;}e.drop=null;}const dh=$('dropHud');if(dh)dh.classList.remove('show');}
function updatePlane(dt){const P=BRF.plane;if(!P)return;P.t+=dt;const k=Math.min(1,P.t/P.dur);P.pos.lerpVectors(P.A,P.B,k);
  if(BRF.planeMesh){BRF.planeMesh.position.copy(P.pos);BRF.planeMesh.rotation.y=Math.atan2(P.dir.x,P.dir.z);BRF.planeMesh.rotation.z=Math.sin(S.time*0.6)*0.03;BRF.planeMesh.traverse(o=>{if(o.userData.prop)o.rotation.z+=dt*40;if(o.userData.blink)o.visible=((S.time+o.userData.blink)%1)<0.09;});}
  if(k>=1){for(const e of S.ents)if(e.drop&&e.drop.phase==='plane')dropJump(e);scene.remove(BRF.planeMesh);BRF.planeMesh=null;BRF.plane=null;}
  else for(const e of S.ents)if(e.drop&&e.drop.phase==='plane'&&!e.isPlayer&&k>=e.drop.jumpAt)dropJump(e);}
function dropJump(e){const P=BRF.plane;const p=P?P.pos:new V3(e.pos.x,120,e.pos.z);e.pos.set(p.x+rand(-1,1),p.y-3,p.z+rand(-1,1));e.drop.phase='fall';e.drop.vy=-8;e.drop.vh=P?P.dir.clone().multiplyScalar(14):new V3();
  if(e.model){e.model.g.visible=true;}if(e.isPlayer){sfx('jump');center('',0);}}
function openChute(e){if(!e.drop||e.drop.phase!=='fall')return;e.drop.phase='chute';e.drop.vy=Math.min(e.drop.vy,-6);
  const cols=[0xff7a1a,0x3d9bff,0xe8e8e8,0x5ac85a,0xff4a6a,0xffd23a];e.canopy=canopyMesh(e.isPlayer?0xffb347:cols[(Math.random()*cols.length)|0]);scene.add(e.canopy);if(e.isPlayer)sfx('pickup');}
function dropLand(e,gy){e.pos.y=gy;e.drop=null;if(e.canopy){scene.remove(e.canopy);e.canopy=null;}if(e.model){resetPose(e.model);e.model.g.rotation.x=0;}if(e.isPlayer){vmRoot.visible=true;document.body.classList.remove('dropping');e.vel.set(0,0,0);sfx('land',1);center('',0);const dh=$('dropHud');if(dh)dh.classList.remove('show');}else{e.wp=null;e.tpos&&e.tpos.copy(e.pos);}}
/* player: camera + steering while in the plane / air. returns true when it handled the frame */
function updateDropPlayer(p,dt){const d=p.drop;vmRoot.visible=false;document.body.classList.add('dropping');const dh=$('dropHud');const f=viewDir(p.yaw,p.pitch);
  if(d.phase==='plane'){const P=BRF.plane;if(!P){dropJump(p);return true;}p.pos.copy(P.pos);
    camera.position.copy(P.pos).addScaledVector(f,-24).add(new V3(0,5,0));camera.rotation.set(clamp(p.pitch,-1.4,1.2),p.yaw,0);
    if((keys.Space||keys.KeyF)&&P.t>0.6)dropJump(p);
    if(dh){dh.classList.add('show');dh.innerHTML=`<b>IN FLIGHT</b><span>${TOUCH.on?'Tap <kbd>⤒</kbd> to jump':'<kbd>SPACE</kbd> jump'} · ${Math.max(0,Math.ceil(P.dur-P.t))}s until forced drop</span>`;}return true;}
  const gy=groundAt(p.pos.x,p.pos.z,p.pos.y,0.3)||0;const alt=p.pos.y-gy;const fx=Math.sin(p.yaw)*-1,fz=Math.cos(p.yaw)*-1;
  const fw=new V3(-Math.sin(p.yaw),0,-Math.cos(p.yaw)),rt=new V3(Math.cos(p.yaw),0,-Math.sin(p.yaw));let mx=0,mz=0;
  if(keys.KeyW){mx+=fw.x;mz+=fw.z;}if(keys.KeyS){mx-=fw.x*0.6;mz-=fw.z*0.6;}if(keys.KeyD){mx+=rt.x;mz+=rt.z;}if(keys.KeyA){mx-=rt.x;mz-=rt.z;}
  if(d.phase==='fall'){const dive=keys.KeyW?1:0;const tv=-(38+dive*14);d.vy+=(tv-d.vy)*Math.min(1,dt*1.2);const hs=keys.KeyW?20:13;d.vh.x+=(mx*hs-d.vh.x)*Math.min(1,dt*1.6);d.vh.z+=(mz*hs-d.vh.z)*Math.min(1,dt*1.6);
    if((keys.Space&&!d.spaceHeld&&d.t>0.5)||alt<42)openChute(p);d.spaceHeld=keys.Space;}
  else{d.vy+=(-6.5-d.vy)*Math.min(1,dt*3);const hs=9.5;d.vh.x+=(mx*hs-d.vh.x)*Math.min(1,dt*2);d.vh.z+=(mz*hs-d.vh.z)*Math.min(1,dt*2);}
  d.t=(d.t||0)+dt;p.pos.x=clamp(p.pos.x+d.vh.x*dt,-mapH+2,mapH-2);p.pos.z=clamp(p.pos.z+d.vh.z*dt,-mapH+2,mapH-2);p.pos.y+=d.vy*dt;
  if(alt<6)collide(p.pos,0.35,p.pos.y+0.2,1.7);if(ISL&&alt<30)islClamp(p.pos,-2);
  const g2=groundAt(p.pos.x,p.pos.z,p.pos.y+0.5,0.3)||0;if(p.pos.y<=g2){dropLand(p,g2);return true;}
  if(p.canopy){p.canopy.position.set(p.pos.x,p.pos.y,p.pos.z);p.canopy.rotation.y=p.yaw;}
  const sway=d.phase==='fall'?Math.sin(S.time*7)*0.01:Math.sin(S.time*1.3)*0.03;
  camera.position.set(p.pos.x,p.pos.y+1.62,p.pos.z);camera.rotation.set(clamp(p.pitch+sway,-1.56,1.56),p.yaw,d.phase==='fall'?Math.sin(S.time*5)*0.02:Math.sin(S.time*1.1)*0.04);
  if(dh){dh.classList.add('show');dh.innerHTML=d.phase==='fall'?`<b>FREEFALL · ${Math.round(alt)} m</b><span>${TOUCH.on?'Joystick up: dive · <kbd>⤒</kbd> parachute':'<kbd>W</kbd> dive · <kbd>A</kbd><kbd>D</kbd> steer · <kbd>SPACE</kbd> parachute'}</span>`:`<b>PARACHUTE · ${Math.round(alt)} m</b><span>${TOUCH.on?'Use the joystick':'<kbd>WASD</kbd>'} to glide to your landing spot</span>`;}
  return true;}
/* bots in the plane / air */
function updateDropBot(b,dt){const d=b.drop;if(d.phase==='plane'){if(BRF.plane)b.pos.copy(BRF.plane.pos);b.model.g.visible=false;return;}
  const gy=groundAt(b.pos.x,b.pos.z,b.pos.y,0.3)||0;const alt=b.pos.y-gy;const dx=d.tx-b.pos.x,dz=d.tz-b.pos.z,dl=Math.hypot(dx,dz)||1;
  if(d.phase==='fall'){d.vy+=(-42-d.vy)*Math.min(1,dt*1.2);const hs=Math.min(19,dl*0.6);d.vh.x+=(dx/dl*hs-d.vh.x)*Math.min(1,dt*1.5);d.vh.z+=(dz/dl*hs-d.vh.z)*Math.min(1,dt*1.5);if(alt<40+Math.random()*4)openChute(b);}
  else{d.vy+=(-6.5-d.vy)*Math.min(1,dt*3);const hs=Math.min(9,dl*0.5);d.vh.x+=(dx/dl*hs-d.vh.x)*Math.min(1,dt*2);d.vh.z+=(dz/dl*hs-d.vh.z)*Math.min(1,dt*2);}
  b.pos.x=clamp(b.pos.x+d.vh.x*dt,-mapH+2,mapH-2);b.pos.z=clamp(b.pos.z+d.vh.z*dt,-mapH+2,mapH-2);b.pos.y+=d.vy*dt;if(alt<6)collide(b.pos,0.35,b.pos.y+0.2,1.7);if(ISL&&alt<30)islClamp(b.pos,-2);
  const m=b.model;m.g.position.copy(b.pos);m.g.rotation.order='YXZ';m.g.rotation.y=Math.atan2(d.vh.x,d.vh.z)||b.yaw;m.g.rotation.x=d.phase==='fall'?1.15:0;animSoldier(m,{spd:0,pitch:d.phase==='fall'?-0.6:0,dt});
  if(b.canopy){b.canopy.position.copy(b.pos);b.canopy.rotation.y=m.g.rotation.y;}
  const g2=groundAt(b.pos.x,b.pos.z,b.pos.y+0.5,0.3)||0;if(b.pos.y<=g2){b.yaw=m.g.rotation.y;dropLand(b,g2);syncBot(b);}}
/* ---------- Gloo Wall ---------- */
let _glooMat=null;function glooMat(){if(_glooMat)return _glooMat;const t=canvasTex(128,(c,s)=>{const g=c.createLinearGradient(0,0,0,s);g.addColorStop(0,'#dff6ff');g.addColorStop(1,'#8fd0f0');c.fillStyle=g;c.fillRect(0,0,s,s);
    for(let i=0;i<26;i++){c.strokeStyle=`rgba(255,255,255,${0.2+Math.random()*0.4})`;c.lineWidth=1+Math.random()*2;c.beginPath();let x=Math.random()*s,y=Math.random()*s;c.moveTo(x,y);for(let j=0;j<4;j++){x+=(Math.random()-0.5)*40;y+=(Math.random()-0.5)*40;c.lineTo(x,y);}c.stroke();}
    for(let i=0;i<40;i++){c.fillStyle=`rgba(255,255,255,${Math.random()*0.5})`;c.beginPath();c.arc(Math.random()*s,Math.random()*s,1+Math.random()*3,0,7);c.fill();}});
  _glooMat=new THREE.MeshPhongMaterial({map:t,color:0xbfe9ff,emissive:0x1a4a66,shininess:120,specular:0xffffff,transparent:true,opacity:0.88});return _glooMat;}
function glooSfx(kind,pos){if(!actx)return;const sp=spatial(pos);if(sp.vol<0.03)return;const o=bus(0.6*sp.vol,sp.pan||0,0.2);
  if(kind==='up'){nz(o,2400,0.35,0.35,'bandpass',0,2,800);tn(o,180,0.3,0.4,'sine',0,90);tn(o,1200,0.18,0.08,'triangle',0.05,2400);}
  else if(kind==='hit'){tn(o,2600+Math.random()*900,0.06,0.12,'triangle');}
  else{nz(o,3200,0.5,0.6,'highpass',0,0.8);for(let i=0;i<6;i++)tn(o,1800+Math.random()*2500,0.15,0.12,'triangle',i*0.03);}}
function deployGloo(e){if(!e||!e.alive||(e.gloo||0)<=0||e.drop)return false;const f=e.isPlayer?new V3(-Math.sin(e.yaw),0,-Math.cos(e.yaw)):new V3(Math.sin(e.yaw),0,Math.cos(e.yaw));
  const c=new V3(e.pos.x+f.x*2.3,e.pos.y,e.pos.z+f.z*2.3);const yaw=Math.atan2(f.x,f.z);e.gloo--;
  const w={hp:600,life:22,age:0,parts:[],cols:[],owner:e,pos:c.clone()};const R=2.0,N=5;
  for(let i=0;i<N;i++){const a=yaw+(i-(N-1)/2)*0.32;const x=c.x+Math.sin(a)*R-f.x*R,z=c.z+Math.cos(a)*R-f.z*R;
    const m=new THREE.Mesh(new THREE.BoxGeometry(0.72,2.15,0.32),glooMat());m.position.set(x,c.y+1.075,z);m.rotation.y=a;m.castShadow=true;m.receiveShadow=true;m.scale.y=0.05;m.userData.gloo=w;scene.add(m);worldMeshes.push(m);w.parts.push(m);
    const col={minX:x-0.33,maxX:x+0.33,minZ:z-0.33,maxZ:z+0.33,minY:c.y,maxY:c.y+2.15};colliders.push(col);w.cols.push(col);}
  CGN=-1;S.gloos=S.gloos||[];S.gloos.push(w);glooSfx('up',c);if(e.isPlayer)center('<span style="color:#9fe0ff">GLOO WALL</span> · '+e.gloo+' left',0.8);return true;}
function glooRemove(w,silent){for(const m of w.parts){scene.remove(m);const i=worldMeshes.indexOf(m);if(i>=0)worldMeshes.splice(i,1);}for(const c of w.cols){const i=colliders.indexOf(c);if(i>=0)colliders.splice(i,1);}w.parts=[];w.cols=[];w.dead=true;CGN=-1;
  if(!silent){particles(w.pos.clone().add(new V3(0,1,0)),'water',22,4);glooSfx('break',w.pos);}}
function glooHit(w,dmg,pt){if(!w||w.dead)return;w.hp-=dmg;glooSfx('hit',pt||w.pos);if(pt)particles(pt,'water',3,2);const k=Math.max(0,w.hp/600);for(const m of w.parts){m.material=m.material===glooMat()?glooMat().clone():m.material;m.material.opacity=0.45+0.43*k;m.material.color.setHex(k>0.5?0xbfe9ff:k>0.25?0x9fcfe8:0x7fb0cc);}if(w.hp<=0)glooRemove(w);}
/* ===== breakable windows: shoot the glass (or blast it) and it shatters with a glass-break sound ===== */
let WINDOWS=[];let _winBroken=null;const _GEO_WINB_Z=new THREE.BoxGeometry(0.92,1.12,0.085),_GEO_WINB_X=new THREE.BoxGeometry(0.085,1.12,0.92);
function winBrokenMat(){if(_winBroken)return _winBroken;const t=canvasTex(64,(x,S)=>{x.fillStyle='#0d1116';x.fillRect(0,0,S,S);
    x.fillStyle='rgba(150,190,210,.85)';const edge=(pts)=>{x.beginPath();x.moveTo(pts[0],pts[1]);for(let i=2;i<pts.length;i+=2)x.lineTo(pts[i],pts[i+1]);x.closePath();x.fill();};
    edge([0,0,26,0,8,18,0,30]);edge([S,0,S-20,0,S-6,22,S,12]);edge([0,S,0,S-24,14,S-8,30,S]);edge([S,S,S-28,S,S-10,S-14,S,S-34]);edge([30,0,40,0,35,10]);
    x.strokeStyle='rgba(220,240,250,.6)';x.lineWidth=1;for(let i=0;i<8;i++){x.beginPath();x.moveTo(Math.random()*S,Math.random()*12);x.lineTo(Math.random()*S,Math.random()*S*0.3);x.stroke();}});
  _winBroken=new THREE.MeshLambertMaterial({map:t});return _winBroken;}
function winReg(m,x,y,z,alongX){WINDOWS.push({i:WINDOWS.length,x,y,z,alongX,broken:false,ov:null});}
function winsClear(){for(const w of WINDOWS)if(w.ov)scene.remove(w.ov);WINDOWS=[];}
function winsRestore(){for(const w of WINDOWS)if(w.broken){w.broken=false;if(w.ov){scene.remove(w.ov);w.ov=null;}}}
function winAt(pt,tol=0.45){for(const w of WINDOWS){if(w.broken)continue;const along=w.alongX?Math.abs(pt.x-w.x):Math.abs(pt.z-w.z),across=w.alongX?Math.abs(pt.z-w.z):Math.abs(pt.x-w.x);
    if(along<0.5&&Math.abs(pt.y-w.y)<0.58&&across<tol)return w;}return null;}
function winBreak(w,net){if(!w||w.broken)return;w.broken=true;const ov=new THREE.Mesh(w.alongX?_GEO_WINB_Z:_GEO_WINB_X,winBrokenMat());ov.position.set(w.x,w.y,w.z);scene.add(ov);w.ov=ov;
  const c=new V3(w.x,w.y,w.z);const n=Math.round(16*(typeof fxMul==='function'?fxMul():1))||6;
  for(let i=0;i<n;i++){const m=new THREE.Mesh(GEO.part,PMAT.glass);const s=0.6+Math.random()*1.6;m.scale.set(s,s*1.4,0.4);m.rotation.set(Math.random()*3,Math.random()*3,0);
    m.position.set(c.x+(w.alongX?(Math.random()-0.5)*0.85:0),c.y+(Math.random()-0.5)*1.0,c.z+(w.alongX?0:(Math.random()-0.5)*0.85));scene.add(m);
    S.fx.push({m,v:new V3((Math.random()-0.5)*2.2,Math.random()*1.4,(Math.random()-0.5)*2.2),life:0.9+Math.random()*0.8,kind:'p'});}
  sfx('glass',1,c);if(net&&NET.role)netSendOrBroadcast({t:'win',i:w.i});}
function winsBlast(pos,R){for(const w of WINDOWS){if(w.broken)continue;if(Math.hypot(w.x-pos.x,w.y-pos.y,w.z-pos.z)<R)winBreak(w,false);}}
/* ===== AIM ASSIST: mobile/tablet, the Android beta app, and new players below level 15 =====
   gentle pull toward the closest visible enemy near the crosshair + look slow-down over targets.
   Only active while you're aiming/looking/firing, never snaps, never locks on through walls or smoke. */
const AA_LEVEL=15;
function aimAssistOn(){const m=save.aimAssist||'auto';if(m==='off')return false;if(m==='on')return true;
  return !!(TOUCH.on||GP.active||(typeof IN_APP!=='undefined'&&IN_APP)||(save.level||1)<AA_LEVEL);}
function aimAssistWhy(){if(TOUCH.on)return 'touch controls';if(GP.active)return 'controller';if(typeof IN_APP!=='undefined'&&IN_APP)return 'beta app';if((save.level||1)<AA_LEVEL)return 'new player · until level '+AA_LEVEL;return '';}
const AA={t:null,act:0,fr:0};const _aaV=new V3(),_aaE=new V3();
function aaEnemy(e){if(!e.alive||e===player||e.drop)return false;if(S.mode==='ffa'||S.mode==='br')return true;return e.team!==player.team;}
function aimAssistTick(dt){AA.t=null;AA.fr=0;const p=player;if(S.state!=='game'||S.uiOpen||!p.alive||S.paused||p.drop||!aimAssistOn())return;
  AA.act=Math.max(0,AA.act-dt);const w=curW();if(!w||w.nade||w.melee)return;
  const engaged=AA.act>0||mouse.down||p.ads||p.scoped;
  _aaE.copy(camera.position);const fwd=new V3(-Math.sin(p.yaw)*Math.cos(p.pitch),Math.sin(p.pitch),-Math.cos(p.yaw)*Math.cos(p.pitch));
  let best=null,bs=1e9;
  for(const e of S.ents){if(!aaEnemy(e))continue;_aaV.set(e.pos.x,e.pos.y+(e.crouch?0.95:1.25),e.pos.z).sub(_aaE);const d=_aaV.length();if(d>70||d<0.5)continue;
    const ang=Math.acos(clamp(_aaV.dot(fwd)/d,-1,1));const cone=clamp(Math.atan(1.6/d)*(p.ads||p.scoped?1.35:1),0.035,0.16)*(TOUCH.on?1.25:1);if(ang>cone)continue;
    const dir=_aaV.clone().divideScalar(d);raycaster.set(_aaE,dir);raycaster.far=d-0.4;const hit=raycaster.intersectObjects(worldMeshes,false).find(h=>h.object.material&&h.object.material.visible!==false);raycaster.far=Infinity;if(hit)continue;
    const tp=_aaE.clone().add(_aaV);if(smokeBlocks(_aaE,tp))continue;const sc=ang/cone+d*0.004;if(sc<bs){bs=sc;best={e,ang,cone,d,v:_aaV.clone()};}}
  if(!best)return;AA.t=best.e;const prox=1-best.ang/best.cone;AA.fr=prox;
  if(!engaged)return;
  const ty=Math.atan2(-best.v.x,-best.v.z),tpi=Math.atan2(best.v.y,Math.hypot(best.v.x,best.v.z));
  let dy=ty-p.yaw;dy=Math.atan2(Math.sin(dy),Math.cos(dy));const dpi=tpi-p.pitch;
  const k=(TOUCH.on?5.2:3.0)*(0.35+0.65*prox)*dt;   // fraction of the gap closed per second
  p.yaw+=dy*Math.min(1,k);p.pitch=clamp(p.pitch+dpi*Math.min(1,k*0.8),-1.55,1.55);applyCamRot();}
function aaFriction(){return AA.t?1-(TOUCH.on?0.4:0.28)*AA.fr:1;}
/* ===== explosive barrels: shoot until it ignites, then it blows (chains to nearby barrels, HE also sets them off) ===== */
let BARREL_SPOTS=[];const BARREL_HP=55;let _barrelMats=null;
function barrelMats(){if(_barrelMats)return _barrelMats;const lab=canvasTex(64,(x,s)=>{x.fillStyle='#b5221a';x.fillRect(0,0,s,s);x.fillStyle='#f2c21b';x.fillRect(0,s*0.3,s,s*0.4);x.fillStyle='#111';for(let i=-2;i<8;i++){x.beginPath();x.moveTo(i*12,s*0.3);x.lineTo(i*12+6,s*0.3);x.lineTo(i*12+14,s*0.7);x.lineTo(i*12+8,s*0.7);x.fill();}x.fillStyle='rgba(0,0,0,.25)';for(let i=0;i<40;i++)x.fillRect(Math.random()*s,Math.random()*s,2,2);});
  _barrelMats={body:pm(0xffffff,{map:lab}),rim:pm(0x7d1712),lid:pm(0x5a120e),hot:new THREE.MeshBasicMaterial({color:0xff7a20})};return _barrelMats;}
function barrelsClear(){for(const br of (S.barrels||[]))barrelRemove(br);S.barrels=[];}
function barrelRemove(br){if(br.g){scene.remove(br.g);const i=worldMeshes.indexOf(br.hit);if(i>=0)worldMeshes.splice(i,1);}const j=colliders.indexOf(br.col);if(j>=0)colliders.splice(j,1);if(br.flame){scene.remove(br.flame);br.flame=null;}br.g=null;CGN=-1;}
function barrelsSpawn(){barrelsClear();const M=barrelMats();
  BARREL_SPOTS.forEach(([x,z],i)=>{const g=new THREE.Group();g.position.set(x,0,z);g.rotation.y=i*1.3;
    const body=new THREE.Mesh(new THREE.CylinderGeometry(0.42,0.42,1.12,16),M.body);body.position.y=0.56;body.castShadow=body.receiveShadow=true;g.add(body);
    for(const y of[0.04,0.38,0.74,1.08]){const r=new THREE.Mesh(new THREE.CylinderGeometry(0.445,0.445,0.05,16),M.rim);r.position.y=y;g.add(r);}
    const lid=new THREE.Mesh(new THREE.CylinderGeometry(0.4,0.4,0.03,16),M.lid);lid.position.y=1.13;g.add(lid);
    const cap=new THREE.Mesh(new THREE.CylinderGeometry(0.06,0.06,0.05,8),M.rim);cap.position.set(0.22,1.16,0.05);g.add(cap);
    scene.add(g);g.updateMatrixWorld(true);body.userData.barrel=i;worldMeshes.push(body);
    const col={minX:x-0.42,maxX:x+0.42,minZ:z-0.42,maxZ:z+0.42,minY:0,maxY:1.14};colliders.push(col);
    S.barrels.push({i,g,hit:body,col,pos:new V3(x,0.6,z),hp:BARREL_HP,fuse:-1,owner:null,dead:false,flame:null});});CGN=-1;}
function barrelHit(i,dmg,pt,owner){const br=S.barrels&&S.barrels[i];if(!br||br.dead)return;br.hp-=dmg;br.owner=owner||br.owner;
  if(pt){particles(pt,'spark',5,3);decal(pt,null);}sfx('clang',0.5,pt||br.pos);
  if(br.hp<=0&&br.fuse<0)barrelIgnite(br,0.12);
  else if(br.hp<BARREL_HP*0.5&&br.fuse<0)barrelIgnite(br,1.4);}
function barrelIgnite(br,t){br.fuse=t;if(!br.flame){const f=new THREE.Sprite(FIRE_MAT);f.position.set(br.pos.x,1.35,br.pos.z);f.scale.set(0.6,0.9,1);scene.add(f);br.flame=f;sfx('hiss',0.8,br.pos);}}
function barrelExplode(br,net){if(br.dead)return;br.dead=true;const pos=br.pos.clone();pos.y=0.7;barrelRemove(br);
  boom(pos,4.2);particles(pos,'spark',26,7);particles(pos,'dust',20,5);
  const sc=new THREE.Mesh(GEO_SCORCH,SCORCH);sc.rotation.x=-Math.PI/2;sc.position.set(pos.x,0.02,pos.z);sc.scale.setScalar(1.8);scene.add(sc);S.decals.push(sc);
  const d0=player.pos.distanceTo(pos);if(!playHZ('nade:he',d0>38?0.9:1.5,d0>38?0.92:1,pos)&&!npkPlay('hegrenade/hegrenade_explode',1.3,pos))sfx('boom',1,pos);
  blastPush(pos,7,9);
  if(net&&NET.role)netSendOrBroadcast({t:'bar',i:br.i,by:br.owner?br.owner.id:null});
  if(NET.role!=='client'){for(const e of S.ents){if(!e.alive)continue;const eye=new V3(e.pos.x,e.pos.y+1.0,e.pos.z),d=eye.distanceTo(pos);if(d>7.5)continue;
      const dir=eye.clone().sub(pos).normalize();raycaster.set(pos,dir);raycaster.far=d;const hit=raycaster.intersectObjects(worldMeshes,false);raycaster.far=Infinity;if(hit.length)continue;
      damage(e,110*(1-d/7.5),br.owner&&br.owner.alive!==undefined?br.owner:null,'he',false);}}
  barrelsBlast(pos,5.5,br.owner);winsBlast(pos,6.5);}
function barrelsBlast(pos,R,owner){if(!S.barrels)return;for(const o of S.barrels){if(o.dead)continue;const d=o.pos.distanceTo(pos);if(d<R){o.owner=o.owner||owner;if(o.fuse<0||o.fuse>0.25)barrelIgnite(o,0.12+d*0.04);}}}
function barrelNet(m,ent){const br=S.barrels&&S.barrels[m.i];if(!br||br.dead)return;br.owner=ent||null;barrelExplode(br,false);}
function updateBarrels(dt){if(!S.barrels||!S.barrels.length)return;for(const br of S.barrels){if(br.dead||br.fuse<0)continue;br.fuse-=dt;
  if(br.flame){const k=0.8+Math.sin(S.time*30+br.i)*0.2;br.flame.scale.set(0.55*k,0.95*k,1);}if(Math.random()<dt*14)particles(new V3(br.pos.x,1.3,br.pos.z),'spark',1,1.5);
  if(br.fuse<=0)barrelExplode(br,true);}}
function updateGloos(dt){if(!S.gloos||!S.gloos.length)return;for(let i=S.gloos.length-1;i>=0;i--){const w=S.gloos[i];if(w.dead){S.gloos.splice(i,1);continue;}w.age+=dt;const g=Math.min(1,w.age/0.28);for(const m of w.parts){m.scale.y=0.05+0.95*(1-Math.pow(1-g,3));m.position.y=w.pos.y+1.075*m.scale.y;}
  if(w.age>w.life){glooRemove(w);S.gloos.splice(i,1);}}}
/* ---------- medkit: full heal with a first-person animation (case up, lid flips open, syringe out, stab, plunger, case away) ---------- */
const MED_HOLD=3.4,MED_T=2.6+MED_HOLD,MED_COMMIT=1.72+MED_HOLD;
/* 6 s total: the quick moves keep their natural speed, the extra time is a slow injection (plunger 1.42→1.70 in animation time) */
function medA(e){if(e<1.42)return e;const P=0.28+MED_HOLD;if(e<1.42+P)return 1.42+(e-1.42)*0.28/P;return e-MED_HOLD;}
function medMax(){return S.mode==='br'?5:2;}
function startHeal(){const p=player;if(S.state!=='game'||S.ended||!p.alive||p.drop)return;
  if(p.healT>0)return;if((p.meds||0)<=0){center('No medkits',0.8);return;}if(p.hp>=100){center('Health already full',0.8);return;}
  if(p.planting>0||p.defusing>0)return;
  p.healT=MED_T;p.healDone=false;p.reloading=false;p.ads=false;p.sprinting=false;try{setScoped(false);}catch(e){}sfx('click');}
function cancelHeal(msg){const p=player;if(!(p.healT>0)||p.healDone)return false;p.healT=0;if(msg)center('Healing cancelled',0.6);return true;}
function updateHeal(p,dt){medHud();if(!(p.healT>0))return;
  if(!p.alive||S.state!=='game'){p.healT=0;return;}
  const el=MED_T-p.healT;
  if(!p.healDone&&mouse.down&&el>0.2){cancelHeal(true);return;}
  p.healT-=dt;const e2=MED_T-p.healT;
  if(e2>0.42&&!p._medLid){p._medLid=1;sfx('click');}
  if(!p.healDone&&e2>=MED_COMMIT){p.healDone=true;p.meds=Math.max(0,(p.meds||0)-1);medApply();}
  if(p.healT<=0){p.healT=0;p._medLid=0;}}
function medApply(){const p=player;const gain=Math.max(0,Math.round(100-p.hp));
  if(NET.role==='client')netToHost({t:'heal'});
  p.hp=100;sfx('pickup');
  const fx=$('healFx');if(fx){fx.classList.remove('on');void fx.offsetWidth;fx.classList.add('on');}
  center('<span style="color:#7dff9b">+'+gain+' HP</span> · '+(p.meds||0)+' medkit'+((p.meds||0)===1?'':'s')+' left',1.1);}
let _medHudK='';
function medHud(){const el=$('medChip');if(!el)return;const n=(player.alive&&S.state==='game')?(player.meds||0):0;const k=n+'|'+(player.healT>0?1:0);if(k===_medHudK)return;_medHudK=k;
  el.classList.toggle('hidden',n<=0&&!(player.healT>0));el.classList.toggle('on',player.healT>0);const nn=$('medN');if(nn)nn.textContent='×'+n;}

/* ---- first-person model ---- */
const MEDVM={g:null,ag:null};
function medBuild(){const ag=(typeof save!=='undefined'&&save.agent)||'operator';if(MEDVM.g&&MEDVM.ag===ag)return MEDVM;
  if(MEDVM.g){vmRoot.remove(MEDVM.g);}
  const HM=handMats();const g=new THREE.Group();g.visible=false;vmRoot.add(g);MEDVM.g=g;MEDVM.ag=ag;MEDVM.tr=null;
  const red=gunMat(0xc4232b,40,'poly'),redD=gunMat(0x8e161c,30,'poly'),white=gunMat(0xf1efe8,20,'poly'),grey=gunMat(0x8d9399,70,'metal'),foam=gunMat(0xd9d5ca,6,'poly'),dark=gunMat(0x2a2c30,30,'poly'),orange=gunMat(0xe0861f,30,'poly');
  const bx=(par,w,h,d,mat,x,y,z)=>{const m=new THREE.Mesh(rbox(w,h,d,Math.min(w,h,d)*0.22,2),mat);m.position.set(x,y,z);par.add(m);return m;};
  const cy=(par,r,len,mat,x,y,z,rx=0,rz=0,seg=14)=>{const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,len,seg),mat);m.position.set(x,y,z);m.rotation.set(rx,0,rz);par.add(m);return m;};
  // case
  const K=new THREE.Group();g.add(K);MEDVM.K=K;
  K.scale.setScalar(0.88);
  bx(K,0.17,0.085,0.15,red,0,-0.0175,0);bx(K,0.172,0.008,0.152,redD,0,0.022,0);
  bx(K,0.06,0.017,0.003,white,0,-0.02,0.076);bx(K,0.017,0.06,0.003,white,0,-0.02,0.076);
  for(const sx of[-1,1])bx(K,0.018,0.012,0.006,grey,sx*0.052,0.017,0.0765);
  bx(K,0.16,0.004,0.14,foam,0,0.0235,0);
  cy(K,0.011,0.034,white,-0.052,0.032,-0.02,Math.PI/2,0);cy(K,0.0115,0.004,white,-0.052,0.032,-0.02,Math.PI/2,0).scale.set(0.6,1,0.6);
  cy(K,0.010,0.026,orange,0.052,0.036,0.03);cy(K,0.0105,0.008,white,0.052,0.052,0.03);
  bx(K,0.03,0.006,0.05,white,-0.052,0.028,0.035);
  // side handle (right side) + standoffs
  cy(K,0.0085,0.072,dark,0.105,-0.018,0);for(const dy of[-0.05,0.014])bx(K,0.026,0.012,0.014,dark,0.093,dy,0);
  // lid on a hinge along the back top edge
  const L=new THREE.Group();L.position.set(0,0.026,-0.075);K.add(L);MEDVM.L=L;
  bx(L,0.17,0.03,0.15,red,0,0.015,0.075);bx(L,0.06,0.003,0.017,white,0,0.0315,0.075);bx(L,0.017,0.003,0.06,white,0,0.0315,0.075);
  bx(L,0.16,0.004,0.14,foam,0,0.0005,0.075);
  // syringe (axis +y: plunger up, needle down)
  const mkSyr=()=>{const s=new THREE.Group();const glass=new THREE.MeshPhongMaterial({color:0xdff3ff,transparent:true,opacity:0.32,shininess:90,depthWrite:false});
    const liq=new THREE.MeshBasicMaterial({color:0x38ff6e});
    const bar=new THREE.Mesh(new THREE.CylinderGeometry(0.0095,0.0095,0.08,16,1,true),glass);bar.position.y=-0.005;bar.renderOrder=3;s.add(bar);
    const lq=new THREE.Mesh(new THREE.CylinderGeometry(0.0082,0.0082,1,14),liq);s.add(lq);
    for(let i=0;i<4;i++)cy(s,0.0097,0.0012,dark,0,-0.035+i*0.016).material=dark;
    cy(s,0.0095,0.004,white,0,-0.046);const hub=new THREE.Mesh(new THREE.ConeGeometry(0.006,0.01,12),white);hub.rotation.x=Math.PI;hub.position.y=-0.053;s.add(hub);
    cy(s,0.0011,0.034,grey,0,-0.075,0,0,0,6);
    bx(s,0.04,0.004,0.013,white,0,0.036,0);
    const pl=new THREE.Group();s.add(pl);const st=cy(pl,0.0086,0.006,dark,0,0.032);cy(pl,0.0028,0.034,white,0,0.05);cy(pl,0.0125,0.003,white,0,0.068);
    s.userData={pl,lq,st};return s;};
  const SCP=new THREE.Group();K.add(SCP);const SC=mkSyr();SCP.add(SC);MEDVM.SC=SC;MEDVM.SCP=SCP;
  // right hand on the handle
  if(!ICON)handGrip(K,HM,{c:new V3(0.105,-0.02,0.0),tilt:0.05,r:0.012,side:1,arm:new V3(0.07,-0.15,0.26)});
  // left hand (holds the syringe in an ice-pick grip)
  const LH=new THREE.Group();g.add(LH);MEDVM.LH=LH;
  if(!ICON)handSupport(LH,HM,{c:new V3(0,0,0),r:0.0125,arm:new V3(-0.05,-0.13,0.24)});
  const ax=new V3(0,0.96,0.28).normalize();const SH=mkSyr();SH.quaternion.setFromUnitVectors(new V3(0,1,0),ax);SH.position.copy(ax).multiplyScalar(-0.004);SH.scale.setScalar(0.92*0.88);LH.add(SH);MEDVM.SH=SH;MEDVM.ax=ax;
  return MEDVM;}
const _sm=t=>t<=0?0:t>=1?1:t*t*(3-2*t);
/* smooth monotone cubic through keyframes (Fritsch–Butland tangents): flows through poses, no overshoot, holds stay still */
function medTrack(keys){const T=keys.map(k=>k[0]),n=T.length,C=keys[0][1].length;const V=[],M=[];
  for(let c=0;c<C;c++){const v=keys.map(k=>k[1][c]);const d=[];for(let i=0;i<n-1;i++)d.push((v[i+1]-v[i])/Math.max(1e-5,T[i+1]-T[i]));
    const m=new Array(n).fill(0);for(let i=1;i<n-1;i++){if(d[i-1]*d[i]>0)m[i]=2/(1/d[i-1]+1/d[i]);}V.push(v);M.push(m);}
  return {T,V,M,C};}
function medEval(tr,t,out){const{T,V,M,C}=tr;const n=T.length;if(t<=T[0]){for(let c=0;c<C;c++)out[c]=V[c][0];return out;}if(t>=T[n-1]){for(let c=0;c<C;c++)out[c]=V[c][n-1];return out;}
  let i=0;while(i<n-2&&t>T[i+1])i++;const h=T[i+1]-T[i],s=(t-T[i])/h,s2=s*s,s3=s2*s;const h00=2*s3-3*s2+1,h10=s3-2*s2+s,h01=-2*s3+3*s2,h11=s3-s2;
  for(let c=0;c<C;c++)out[c]=h00*V[c][i]+h10*h*M[c][i]+h01*V[c][i+1]+h11*h*M[c][i+1];return out;}
const _mE=new THREE.Euler(),_mQ=new THREE.Quaternion(),_mV=new V3(),_mO=new THREE.Object3D();
const MQ=(x,y,z)=>{_mQ.setFromEuler(_mE.set(x,y,z));return[_mQ.x,_mQ.y,_mQ.z,_mQ.w];};
/* pose track: [t,[x,y,z],[qx,qy,qz,qw]] -> position + quaternion (components kept on one hemisphere, renormalised) */
function medPoseTrack(keys){let prev=null;const fixed=keys.map(k=>{let q=k[2].slice();if(prev&&q[0]*prev[0]+q[1]*prev[1]+q[2]*prev[2]+q[3]*prev[3]<0)q=q.map(v=>-v);prev=q;return[k[0],[...k[1],...q]];});return medTrack(fixed);}
const _mOut=new Array(7).fill(0);
function medApplyPose(o,tr,t){medEval(tr,t,_mOut);o.position.set(_mOut[0],_mOut[1],_mOut[2]);o.quaternion.set(_mOut[3],_mOut[4],_mOut[5],_mOut[6]).normalize();}
/* build the choreography from the real geometry so the grab and the needle land exactly */
function medTracks(G){if(G.tr)return G.tr;
  const R=[0.06,-0.10,-0.37],RE=[0.48,-0.24,0.04];const add=(a,b)=>a.map((v,i)=>v+b[i]);
  const kit=medPoseTrack([[0,add(R,[0.04,-0.4,0]),MQ(0.95,-0.45,0.25)],[0.28,add(R,[0,0.008,0]),MQ(RE[0]-0.05,RE[1],RE[2])],[0.4,R,MQ(...RE)],[1.36,R,MQ(...RE)],
    [1.38,add(R,[0.004,-0.01,0]),MQ(RE[0]-0.03,RE[1],RE[2]-0.03)],[1.52,R,MQ(...RE)],[2.2,R,MQ(...RE)],[2.56,add(R,[0.05,-0.42,0]),MQ(0.95,-0.4,0.25)]]);
  // kit rest matrix (in the medkit group's space)
  _mO.position.set(...R);_mO.rotation.set(...RE);_mO.scale.setScalar(0.88);_mO.updateMatrix();const KM=_mO.matrix.clone();
  G.SC.updateMatrix();G.SH.updateMatrix();
  // grab pose: the hand keeps its natural upright grip; the case's spring holder stands the syringe up to exactly where that grip expects it
  const gq=new THREE.Quaternion().setFromEuler(new THREE.Euler(0.1,0,0.1));const tipL=new V3(0,-0.092,0).applyMatrix4(G.SH.matrix);
  const pt=new V3(-0.02,0.016,0.066);const gp=pt.clone().applyMatrix4(KM).sub(tipL.clone().applyQuaternion(gq));
  const LHM=new THREE.Matrix4().compose(gp,gq,new V3(1,1,1));
  const up=new THREE.Matrix4().copy(KM).invert().multiply(LHM).multiply(G.SH.matrix);
  G.SCP.position.copy(pt);G.SCP.rotation.set(0,0,0);const rel=new THREE.Matrix4().makeTranslation(-pt.x,-pt.y,-pt.z).multiply(up);
  rel.decompose(G.SC.position,G.SC.quaternion,G.SC.scale);
  const GP=[gp.x,gp.y,gp.z],GQ=[gq.x,gq.y,gq.z,gq.w];
  // stab: needle tip onto the back of the right wrist
  const P=new V3(0.111,-0.07,0.034).applyMatrix4(KM);
  const qs=new THREE.Quaternion().setFromEuler(new THREE.Euler(0.12,-0.18,1.0));
  const tip=new V3(0,-0.092,0).applyMatrix4(G.SH.matrix).applyQuaternion(qs);
  const dir=new V3(0,-1,0).applyQuaternion(G.SH.quaternion).applyQuaternion(qs).normalize();
  const base=P.clone().sub(tip);const pre=base.clone().addScaledVector(dir,-0.034),inn=base.clone().addScaledVector(dir,0.011);
  const QS=[qs.x,qs.y,qs.z,qs.w],A=v=>[v.x,v.y,v.z];
  const lidEdge=new V3(0,0.045,0.08).applyMatrix4(KM);
  const lh=medPoseTrack([[0,[-0.36,-0.44,-0.30],MQ(0,0,0.5)],[0.3,[-0.24,-0.3,-0.31],MQ(0.1,0,0.55)],
    [0.47,[lidEdge.x-0.07,lidEdge.y-0.035,lidEdge.z+0.02],MQ(0.25,0,0.6)],[0.62,[lidEdge.x-0.05,lidEdge.y+0.03,lidEdge.z-0.01],MQ(0.15,0,0.75)],
    [0.75,[GP[0],GP[1]+0.05,GP[2]+0.012],GQ],[0.86,GP,GQ],[1.06,[-0.055,-0.005,-0.30],MQ(0.12,0,0.14)],
    [1.2,[-0.062,0.018,-0.30],MQ(0.02,0,0.08)],[1.34,[-0.078,-0.112,-0.27],MQ(0.32,0,0.2)],[1.74,[-0.078,-0.114,-0.27],MQ(0.32,0,0.2)],[1.88,[-0.066,-0.03,-0.30],MQ(0.1,0,0.12)],[2.08,[-0.4,-0.36,-0.26],MQ(0.4,0,2.2)]]);
  const lid=medTrack([[0,[0]],[0.47,[0]],[0.58,[-2.1]],[0.66,[-1.92]],[0.72,[-1.97]],[1.95,[-1.97]],[2.1,[0.05]],[2.15,[-0.02]],[2.2,[0]]]);
  const sc=medTrack([[0,[-Math.PI/2]],[0.52,[-Math.PI/2]],[0.66,[0.14]],[0.72,[-0.05]],[0.78,[0]]]);
  return G.tr={kit,lh,lid,sc};}
function medVM(dt){const p=player;const M=MEDVM.g?MEDVM:null;
  if(!(p.healT>0)||!p.alive||p.tp){if(M)M.g.visible=false;return;}
  medBuild();const t=medA(MED_T-p.healT);const G=MEDVM;G.g.visible=true;const TR=medTracks(G);
  // lower the gun out of the way
  const gk=t<0.25?_sm(t/0.25):t>2.35?1-_sm((t-2.35)/0.25):1;const id=p.inv[p.slot]?p.inv[p.slot].id:'knife';const m=vm.models[id];
  if(m){m.position.y-=0.34*gk;m.rotation.x-=0.9*gk;if(gk>0.97)m.visible=false;}
  medApplyPose(G.K,TR.kit,t);G.L.rotation.x=medEval(TR.lid,t,[0])[0];G.SCP.rotation.x=medEval(TR.sc,t,[0])[0];medApplyPose(G.LH,TR.lh,t);
  if(t>1.4&&t<1.72){const w=S.time;G.LH.position.x+=Math.sin(w*11)*0.0012;G.LH.position.y+=Math.sin(w*8.3+1)*0.0014;G.K.position.y+=Math.sin(w*1.9)*0.0015;}
  G.SC.visible=t<0.86;G.SH.visible=t>=0.86&&t<2.3;
  // plunger + liquid
  const pr=_sm((t-1.42)/0.28);const ud=G.SH.userData;ud.pl.position.y=-0.058*pr;const top=0.029-0.058*pr,bot=-0.043;const len=Math.max(0.001,top-bot);ud.lq.scale.y=len;ud.lq.position.y=(top+bot)/2;ud.lq.visible=len>0.002;
  const uc=G.SC.userData;uc.lq.scale.y=0.072;uc.lq.position.y=-0.007;
  // walk bob + gentle breathing so it sits in the hands like the guns do
  const sp=Math.hypot(p.vel.x,p.vel.z),bob=p.onGround?Math.min(sp/4.5,1):0;
  G.g.position.set(-0.01+Math.sin(vm.bobT||0)*0.008*bob,0.05+Math.abs(Math.cos(vm.bobT||0))*0.007*bob+Math.sin(S.time*1.6)*0.0015,0);
  G.g.rotation.set(0,0,Math.sin(vm.bobT||0)*0.01*bob);}
/* ---------- airdrops ---------- */
const AIR_LOOT=['awp','m249','barrett','scar20','ak47','m4a1s','negev','g3sg1'];
function airSpawn(){const z=S.zone;if(!z)return;const r=Math.max(4,Math.min(z.r,z.tr)*0.6);const a=Math.random()*6.28,d=Math.random()*r;let x=clamp(z.x+Math.cos(a)*d,-mapH+5,mapH-5),zz=clamp(z.z+Math.sin(a)*d,-mapH+5,mapH-5);const op=openPoint(x,zz,6,0);if(op){x=op.x;zz=op.z;}
  const g=new THREE.Group();const box=new THREE.Mesh(new THREE.BoxGeometry(1.4,1.1,1.4),pm(0x3d5a8a));box.position.y=0.55;box.castShadow=true;g.add(box);
  for(const[w,h,d,y]of[[1.46,0.12,1.46,0.08],[1.46,0.12,1.46,1.02]]){const bd=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),pm(0xe0a030));bd.position.y=y;g.add(bd);}
  const lt=new THREE.Mesh(new THREE.SphereGeometry(0.12,8,6),new THREE.MeshBasicMaterial({color:0xff4020}));lt.position.y=1.2;g.add(lt);
  const can=canopyMesh(0xff3d2a);can.position.y=0.6;can.scale.setScalar(1.3);g.add(can);g.position.set(x,85,zz);scene.add(g);
  const beam=new THREE.Mesh(new THREE.CylinderGeometry(0.6,1.4,60,12,1,true),new THREE.MeshBasicMaterial({color:0xff3a2a,transparent:true,opacity:0.22,depthWrite:false,blending:THREE.AdditiveBlending,side:THREE.DoubleSide}));beam.position.set(x,30,zz);scene.add(beam);
  const A={g,beam,lt,can,x,z:zz,y:85,landed:false,opened:false};S.air.list.push(A);center('<span style="color:#ff6a4a">✈ AIRDROP INCOMING</span>',2.5);sfx('warn');
  for(const b of S.bots.filter(b=>b.alive&&!b.drop).sort((a,c)=>Math.hypot(a.pos.x-x,a.pos.z-zz)-Math.hypot(c.pos.x-x,c.pos.z-zz)).slice(0,2)){b.wp=new V3(x,0,zz);b.airGoal=A;}}
function airRemove(A){scene.remove(A.g);scene.remove(A.beam);}
function airOpen(A){if(A.opened)return;A.opened=true;const items=[AIR_LOOT[(Math.random()*AIR_LOOT.length)|0],'armor','med','ammo'];if(Math.random()<0.6)items.push('med');
  items.forEach((t,i)=>{const a=i/items.length*Math.PI*2;spawnLoot(t,new V3(A.x+Math.cos(a)*1.4,0,A.z+Math.sin(a)*1.4));});A.lt.visible=false;A.beam.visible=false;sfx('pickup');}
function updateAir(dt){S.nearAir=null;const R=S.air;if(!R)return;if(!NET.role){R.next-=dt;if(R.next<=0&&!S.ended){R.next=65+Math.random()*25;airSpawn();}}
  for(const A of R.list){if(!A.landed){const gy=groundAt(A.x,A.z,A.y,0.6)||0;A.y-=dt*5.2;A.g.position.y=A.y;A.g.rotation.y+=dt*0.4;if(A.y<=gy){A.y=gy;A.g.position.y=gy;A.landed=true;A.can.visible=false;sfx('land',1.2);}}
    else{A.lt.material.color.setHex(Math.sin(S.time*8)>0?0xff4020:0x601008);}
    A.beam.material.opacity=A.opened?0:0.16+0.08*Math.sin(S.time*3);
    if(A.landed&&!A.opened){for(const e of S.ents){if(!e.alive||e.drop)continue;if(Math.hypot(e.pos.x-A.x,e.pos.z-A.z)<1.8){if(e.isPlayer){S.nearAir=A;}else if(!e.isNet)airOpen(A);}}}}}
/* ---------- bots: use gloo walls when hurt in a fight ---------- */
function botGloo(b,t,dist){if(S.mode!=='br'||(b.gloo||0)<=0||b.hp>55||dist<4||dist>40||S.time<(b.glooT||0))return;b.glooT=S.time+8;deployGloo(b);}

/* ================= BATTLE ROYALE ================= */
const BR_H=215,BR_MIN=30,BR_MAX=35;
const ZP=[{r:165,wait:50,shrink:40,dps:1},{r:110,wait:40,shrink:35,dps:2},{r:65,wait:35,shrink:30,dps:4},{r:35,wait:30,shrink:25,dps:7},{r:15,wait:25,shrink:20,dps:11},{r:3,wait:20,shrink:20,dps:16}];
let zoneMesh=null;
function setupZone(){
  S.zone={x:0,z:0,r:300,fx:0,fz:0,fr:300,tx:0,tz:0,tr:300,phase:0,state:'wait',t:45};nextZone();
  zoneMesh=new THREE.Mesh(new THREE.CylinderGeometry(1,1,90,96,1,true),new THREE.MeshBasicMaterial({color:0x3d9bff,transparent:true,opacity:0.22,side:THREE.DoubleSide,depthWrite:false,fog:false}));scene.add(zoneMesh);
}
function nextZone(){const z=S.zone,ph=ZP[z.phase];if(!ph)return;const off=Math.max(0,z.r-ph.r)*0.7*Math.random(),a=Math.random()*6.283;
  const lim=Math.max(0,mapH-ph.r*0.6);z.tx=clamp(z.x+Math.cos(a)*off,-lim,lim);z.tz=clamp(z.z+Math.sin(a)*off,-lim,lim);if(ISL){for(let i=0;i<30&&!islIn(z.tx,z.tz,Math.min(ph.r*0.6,30));i++){const b=Math.random()*6.283,o2=off*Math.random();z.tx=z.x+Math.cos(b)*o2;z.tz=z.z+Math.sin(b)*o2;}if(!islIn(z.tx,z.tz,4)){z.tx*=0.5;z.tz*=0.5;}}z.tr=ph.r;z.state='wait';z.t=ph.wait;}
function zoneVisual(){const z=S.zone;if(!zoneMesh||!z)return;zoneMesh.position.set(z.x,45,z.z);zoneMesh.scale.set(Math.max(0.5,z.r),1,Math.max(0.5,z.r));}
function updateZone(dt){
  const z=S.zone;const ph=ZP[Math.min(z.phase,ZP.length-1)];
  if(z.phase<ZP.length){z.t-=dt;
    if(z.state==='wait'&&z.t<=0){z.state='shrink';z.t=ph.shrink;z.fx=z.x;z.fz=z.z;z.fr=z.r;center('⚠ The zone is closing in',2.5);sfx('warn');}
    else if(z.state==='shrink'){const k=1-Math.max(0,z.t)/ph.shrink;z.x=z.fx+(z.tx-z.fx)*k;z.z=z.fz+(z.tz-z.fz)*k;z.r=z.fr+(z.tr-z.fr)*k;if(z.t<=0){z.phase++;if(z.phase<ZP.length)nextZone();else z.state='final';}}}
  zoneVisual();
  for(const e of S.ents){if(!e.alive)continue;if(Math.hypot(e.pos.x-z.x,e.pos.z-z.z)>z.r){e.hp-=ph.dps*dt;if(e.isPlayer)dmgA=Math.max(dmgA,0.25);if(e.hp<=0)kill(e,null,'zone',false);}}
}
const LOOT={gloo:{c:0x9fe0ff,label:'Gloo Wall'},ammo:{c:0x58d26b,label:'Ammo Box'},armor:{c:0x4ea8ff,label:'Kevlar Vest'},med:{c:0xff5a6e,label:'Medkit'},he:{c:0x8fa84a},smoke:{c:0xc8ccd0},molotov:{c:0xff8a2a},incendiary:{c:0xff6a3a},firebomb:{c:0xff3d1a},flashbang:{c:0xe8f4ff},decoy:{c:0x9a9a60}};
const LOOT_CAT_C={pistol:0xffe14d,smg:0xffc04d,shotgun:0xff8f4d,mg:0xff6fd0,rifle:0xff9f1c,sniper:0xff3c3c,dmr:0xff6a3c,taser:0x66e0ff};
function lootColor(t){return LOOT[t]?LOOT[t].c:(LOOT_CAT_C[WEAPONS[t].cat]||0xffffff);}
function lootLabel(t){return (LOOT[t]&&LOOT[t].label)||WEAPONS[t].name;}
const LOOT_TABLE=['ak47','m4a4','m4a1s','galil','famas','sg553','aug','mp9','mac10','mp7','ump45','p90','bizon','mp5','thompson','nova','xm1014','mag7','sawedoff','remington','spas','m249','negev','ssg08','awp','g3sg1','scar20','m1a','barrett','deagle','r8','fiveseven','tec9','p250','cz75','dualies','usp','p2000','zeus','ammo','ammo','ammo','ammo','armor','armor','armor','med','med','med','med','he','he','smoke','molotov','molotov','firebomb','firebomb','flashbang','flashbang','decoy'];
/* ---- loot props: the real item lying on the ground with a soft rarity glow ---- */
const LOOTM={};
/* lay a model on its side: pick the orientation with the lowest height */
function layFlat(g,m){let best=null,bh=1e9;for(const r of[[0,0,Math.PI/2],[Math.PI/2,0,0],[0,Math.PI/2,Math.PI/2],[Math.PI/2,Math.PI/2,0]]){m.rotation.set(r[0],r[1],r[2]);g.updateMatrixWorld(true);const b=new THREE.Box3().setFromObject(g);const h=b.max.y-b.min.y;if(h<bh-1e-4){bh=h;best=r;}}m.rotation.set(best[0],best[1],best[2]);g.updateMatrixWorld(true);}
function lootProp(type){const w=WEAPONS[type];
  if(w&&!w.nade&&typeof hasReal==='function'&&hasReal(type)&&typeof hzReady!=='undefined'&&hzReady){try{const r=makeRealStatic(type,null);r.traverse(o=>{if(o.isMesh)o.castShadow=true;});const g=new THREE.Group();g.add(r);r.scale.multiplyScalar(1.35);layFlat(g,r);
      const box=new THREE.Box3().setFromObject(g);const c=box.getCenter(new V3());r.position.sub(new V3(c.x,box.min.y,c.z));return g;}catch(e){}}
  if(w&&!w.nade){try{const M=getIconModels();const src=M[type];if(src){const m=src.clone(true);m.traverse(o=>{if(o.isMesh){o.castShadow=true;}});const g=new THREE.Group();g.add(m);m.scale.setScalar(w.cat==='pistol'?2.1:1.7);layFlat(g,m);
      const box=new THREE.Box3().setFromObject(g);const c=box.getCenter(new V3());m.position.sub(new V3(c.x,box.min.y,c.z));return g;}}catch(e){}}
  if(isNadeId(type)){const n=nadeMesh(type);if(n){const g=new THREE.Group();n.scale.multiplyScalar(1.6);g.add(n);n.traverse(o=>{if(o.isMesh)o.castShadow=true;});const box=new THREE.Box3().setFromObject(g);n.position.y-=box.min.y;return g;}}
  const g=new THREE.Group();const add=(geo,mat,x,y,z,rx=0,ry=0,rz=0)=>{const m=new THREE.Mesh(geo,mat);m.position.set(x,y,z);m.rotation.set(rx,ry,rz);m.castShadow=true;g.add(m);return m;};
  if(type==='ammo'){const ol=pm(0x4d5a2e),dk=pm(0x2c3319),lab=LOOTM.ammoLab||(LOOTM.ammoLab=new THREE.MeshLambertMaterial({map:canvasTex(64,(c,w2,h)=>{c.fillStyle='#4d5a2e';c.fillRect(0,0,w2,h);c.fillStyle='#e8d88a';c.font='bold 13px Arial';c.textAlign='center';c.fillText('AMMO',w2/2,h/2-2);c.font='9px Arial';c.fillText('5.56 · 7.62',w2/2,h/2+10);},32)}));
    add(new THREE.BoxGeometry(0.42,0.26,0.2),ol,0,0.13,0);add(new THREE.BoxGeometry(0.44,0.04,0.22),dk,0,0.27,0);add(new THREE.BoxGeometry(0.16,0.025,0.05),dk,0,0.3,0);add(new THREE.PlaneGeometry(0.26,0.13),lab,0,0.14,0.101);
    add(new THREE.BoxGeometry(0.3,0.2,0.14),ol,0.34,0.1,0.06,0,0.5);add(new THREE.BoxGeometry(0.32,0.03,0.16),dk,0.34,0.21,0.06,0,0.5);return g;}
  if(type==='armor'){try{const v=kevlarVest({flat:true});v.rotation.x=-Math.PI/2;v.scale.setScalar(1.3);g.add(v);v.updateMatrixWorld(true);const bb=new THREE.Box3().setFromObject(v);v.position.y-=bb.min.y;return g;}catch(e){}const v=pm(0x2f4f78),st=pm(0x1f2a36),pl=pm(0x5a7fa8);add(rbox(0.46,0.5,0.1,0.04),v,0,0.06,0,-Math.PI/2);add(rbox(0.36,0.36,0.03,0.02),pl,0,0.115,0.0,-Math.PI/2);
    for(const x of[-0.12,0,0.12])add(new THREE.BoxGeometry(0.1,0.03,0.12),st,x,0.13,0.12);for(const sx of[-1,1])add(new THREE.BoxGeometry(0.08,0.03,0.22),st,sx*0.16,0.1,-0.3);return g;}
  if(type==='med'){const tex=LOOTM.med||(LOOTM.med=new THREE.MeshLambertMaterial({map:canvasTex(64,(c,w2,h)=>{c.fillStyle='#eeeeea';c.fillRect(0,0,w2,h);c.fillStyle='#d82a2a';c.fillRect(w2/2-7,h/2-20,14,40);c.fillRect(w2/2-20,h/2-7,40,14);})}));
    const red=pm(0xc62828),wh=pm(0xeeeeea);add(rbox(0.38,0.2,0.26,0.05),red,0,0.1,0);add(new THREE.PlaneGeometry(0.2,0.2),tex,0,0.205,0,-Math.PI/2);add(new THREE.BoxGeometry(0.39,0.03,0.05),wh,0,0.1,0.11);add(new THREE.TorusGeometry(0.06,0.012,6,12,Math.PI),pm(0x222222),0,0.2,0);return g;}
  add(new THREE.BoxGeometry(0.4,0.3,0.4),pm(lootColor(type)),0,0.15,0);return g;}
function glowTex(){return LOOTM.glow||(LOOTM.glow=canvasTex(64,(c,s)=>{const g=c.createRadialGradient(s/2,s/2,0,s/2,s/2,s/2);g.addColorStop(0,'rgba(255,255,255,.75)');g.addColorStop(0.5,'rgba(255,255,255,.28)');g.addColorStop(1,'rgba(255,255,255,0)');c.fillStyle=g;c.fillRect(0,0,s,s);}));}
function spawnLoot(type,pos){
  const g=new THREE.Group();const c=lootColor(type);
  const b=new THREE.Group();const prop=lootProp(type);b.add(prop);b.position.y=0.02;b.rotation.y=Math.random()*Math.PI*2;g.add(b);
  const glow=new THREE.Mesh(new THREE.PlaneGeometry(1.5,1.5),new THREE.MeshBasicMaterial({map:glowTex(),color:c,transparent:true,opacity:0.45,depthWrite:false,blending:THREE.AdditiveBlending}));glow.rotation.x=-Math.PI/2;glow.position.y=0.03;g.add(glow);
  const beam=new THREE.Mesh(new THREE.CylinderGeometry(0.02,0.07,1.5,8,1,true),new THREE.MeshBasicMaterial({color:c,transparent:true,opacity:0.1,depthWrite:false,blending:THREE.AdditiveBlending,side:THREE.DoubleSide}));beam.position.y=0.75;g.add(beam);g.userData.glow=glow;g.userData.beam=beam;
  const gy=groundAt(pos.x,pos.z,(pos.y||0)+2,0.3);if(gy!==undefined&&isFinite(gy))pos=new V3(pos.x,gy,pos.z);
  g.position.copy(pos);scene.add(g);S.loot.push({i:S.loot.length,type,g,b,taken:false});
}
function lootEffectLocal(L){
  const p=player;const w=WEAPONS[L.type];
  if(w&&!w.nade){const s=p.inv[w.slot];if(s&&s.id===L.type)s.reserve+=w.mag*2;else giveWeapon(L.type,w.mag);}
  else if(L.type==='ammo'){for(const s of[1,2]){const ws=p.inv[s];if(ws)ws.reserve+=WEAPONS[ws.id].mag*2;}}
  else if(isNadeId(L.type)){p.nades.push(L.type);refreshNades();}
}
function lootAllowed(L,e){if(L.type==='armor'&&e.armor>=100)return 'Armor already full';if(L.type==='gloo'&&(e.gloo||0)>=6)return 'Gloo Walls full (6)';if(L.type==='med'&&e.isPlayer&&S.mode==='br'){if((e.meds||0)>=5)return 'Medkits full (5)';}else if(L.type==='med'&&e.hp>=100)return 'Health already full';
  if(e.isPlayer){if(isNadeId(L.type)&&e.nades.filter(x=>x===L.type).length>=(L.type==='flashbang'?2:1))return 'Already carrying one';if(isNadeId(L.type)&&e.nades.length>=4)return 'Grenade slots full';if(L.type==='ammo'&&!e.inv[1]&&!e.inv[2])return 'No gun for this ammo';}return null;}
function lootHostEffect(L,e){if(L.type==='armor')e.armor=Math.min(100,e.armor+50);if(L.type==='gloo')e.gloo=(e.gloo||0)+1;if(L.type==='med'){if(e.isPlayer&&S.mode==='br')e.meds=(e.meds||0)+1;else e.hp=Math.min(100,e.hp+50);}}
function removeLoot(L){L.taken=true;scene.remove(L.g);}
function pickup(L){
  const p=player;const why=lootAllowed(L,p);if(why){center(why,1);return;}
  if(NET.role==='client'){netToHost({t:'pick',i:L.i});return;}
  lootHostEffect(L,p);lootEffectLocal(L);removeLoot(L);sfx('pickup');center('Picked up '+lootLabel(L.type),1);
  if(NET.role==='host')netBroadcast({t:'lootgone',i:L.i,by:'h'});
}
function updateLoot(dt){for(const L of S.loot){if(L.taken)continue;const k=0.5+0.5*Math.sin(S.time*2.2+L.g.position.x);if(L.g.userData.glow)L.g.userData.glow.material.opacity=0.35+0.3*k;if(L.g.userData.beam)L.g.userData.beam.material.opacity=0.05+0.07*k;}}

/* =====================================================================
   MULTIPLAYER — peer-to-peer rooms (PeerJS public broker for the handshake).
   The host runs the whole simulation (bots, rounds, damage, zone) and sends
   snapshots 20×/s. Each client moves its own player locally (so movement stays
   instant), does its own hit detection, and reports hits/actions to the host.
   ===================================================================== */
const NET={role:null,conns:{},hostConn:null,myId:'h',code:null,roster:[],mode:null,fill:true,inGame:false,stT:0,ping:0,transport:null,peer:null};
const PEER_URLS=['https://cdnjs.cloudflare.com/ajax/libs/peerjs/1.5.4/peerjs.min.js','https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js','https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js'];
function loadPeer(cb){if(window.Peer)return cb();let i=0;const next=()=>{if(i>=PEER_URLS.length){cb(new Error('Could not load the networking library — check your internet connection.'));return;}const s=document.createElement('script');s.src=PEER_URLS[i++];s.onload=()=>window.Peer?cb():next();s.onerror=next;document.head.appendChild(s);};next();}
function wrapConn(c){return{id:c.peer,send:m=>{try{if(c.open)c.send(m);}catch(e){}},onData:f=>c.on('data',f),onClose:f=>{c.on('close',f);c.on('error',f);},close:()=>{try{c.close();}catch(e){}}};}
const PeerTransport={
  host(code,onConn,onReady,onErr){loadPeer(err=>{if(err)return onErr(err.message);const peer=new Peer('combatrival-'+code.toLowerCase());NET.peer=peer;
    peer.on('open',()=>onReady());peer.on('error',e=>onErr(e.type==='unavailable-id'?'That room code is taken — try again.':'Network error: '+(e.type||e)));
    peer.on('connection',c=>{c.on('open',()=>onConn(wrapConn(c)));});});},
  join(code,onOpen,onErr){loadPeer(err=>{if(err)return onErr(err.message);const peer=new Peer();NET.peer=peer;
    peer.on('error',e=>onErr(e.type==='peer-unavailable'?'Room not found — check the code.':'Network error: '+(e.type||e)));
    peer.on('open',()=>{const c=peer.connect('combatrival-'+code.toLowerCase(),{reliable:true,serialization:'json'});c.on('open',()=>onOpen(wrapConn(c)));});});},
  close(){if(NET.peer){try{NET.peer.destroy();}catch(e){}NET.peer=null;}}
};
function transport(){return window.__mockNet||PeerTransport;}
function netBroadcast(m,except){for(const id in NET.conns)if(id!==except)NET.conns[id].send(m);}
function netSend(id,m){const c=NET.conns[id];if(c)c.send(m);}
function netToHost(m){if(NET.hostConn)NET.hostConn.send(m);}
function netSendOrBroadcast(m){if(NET.role==='host')netBroadcast(m);else netToHost(m);}
function netShotFx(a,b,w,by){if(!a||!b)return;const m={t:'shot',f:[+a.x.toFixed(2),+a.y.toFixed(2),+a.z.toFixed(2)],to:[+b.x.toFixed(2),+b.y.toFixed(2),+b.z.toFixed(2)],w,by};if(NET.role==='host')netBroadcast(m,by);else netToHost(m);}
function genCode(){const A='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';let s='';for(let i=0;i<5;i++)s+=A[Math.floor(Math.random()*A.length)];return s;}
function myName(){return (save.name||'Rival').slice(0,14);}
function mpErr(t){$('mpErr').textContent=t||'';}
function lobbyTeams(mode){return MODES[mode].teams||null;}
function rebalance(){const T=lobbyTeams(NET.mode);if(!T)return;for(const r of NET.roster)if(!T.includes(r.team))r.team=null;
  const F=NET.mode==='tdm'&&fmtParse(NET.fmt);
  for(const r of NET.roster)if(!r.team){const c0=NET.roster.filter(x=>x.team===T[0]).length,c1=NET.roster.filter(x=>x.team===T[1]).length;r.team=F?((F[1]-c1)>(F[0]-c0)?T[1]:T[0]):(c0<=c1?T[0]:T[1]);}}
function hostRoom(mode,fmt,ranked){
  netLeave(true);mpErr('');const code=genCode();
  NET.role='host';NET.code=code;NET.mode=mode;NET.fmt=mode==='tdm'&&fmtParse(fmt)?fmt:null;NET.ranked=ranked&&(mode==='br'||mode==='tdm')?mode:null;NET.myId='h';NET.fill=$('lbFill').checked;NET.inGame=false;
  const T=lobbyTeams(mode);NET.roster=[{id:'h',name:myName(),level:save.level,agent:save.agent||'operator',team:T?(mode==='defuse'&&T.includes(save.side)?save.side:T[0]):null,host:true}];
  showLobby('Opening room…');
  transport().host(code,conn=>{
    conn.onData(m=>hostOnData(conn.id,m));
    conn.onClose(()=>hostOnClose(conn.id));
    NET.conns[conn.id]=conn;
  },()=>{renderLobby('Share the code with friends, or press Invite friends.');NET.ready=true;if(NET._ready){const f=NET._ready;NET._ready=null;f();}},err=>{renderLobby('');mpErr(err);$('lbStatus').textContent=err;});
}
function joinRoom(code){
  code=(code||'').toUpperCase().trim();if(code.length<4){mpErr('Enter the 5-letter room code.');return;}
  netLeave(true);mpErr('Connecting…');NET.role='client';NET.code=code;
  transport().join(code,conn=>{
    NET.hostConn=conn;conn.onData(m=>clientOnData(m));conn.onClose(()=>clientHostLost());
    conn.send({t:'hello',name:myName(),level:save.level,agent:save.agent||'operator'});mpErr('');
  },err=>{mpErr(err);NET.role=null;});
}
function netLeave(silent){
  if(NET._leaving)return;NET._leaving=true;
  if(NET.role==='client'&&NET.hostConn){NET.hostConn.send({t:'bye'});NET.hostConn.close();}
  if(NET.role==='host'){netBroadcast({t:'closed'});for(const id in NET.conns)NET.conns[id].close();}
  transport().close&&transport().close();
  Object.assign(NET,{role:null,conns:{},hostConn:null,myId:'h',code:null,roster:[],mode:null,fmt:null,inGame:false,ready:false,_ready:null});
  $('lobby').classList.add('hidden');NET._leaving=false;
}
function showLobby(status){$('lobby').classList.remove('hidden');renderLobby(status);}
function renderLobby(status){
  if(!NET.role){$('lobby').classList.add('hidden');return;}
  const host=NET.role==='host',mode=NET.mode;const T=mode&&lobbyTeams(mode);
  const F=mode==='tdm'&&fmtParse(NET.fmt);
  $('lbTitle').innerHTML=`<b>${NET.ranked?'<span style="color:#ffd34d">RANKED</span> · ':''}${F?NET.fmt.toUpperCase()+' · ':''}${mode?MODES[mode].name:'Room'}</b><span>${host?'You are hosting':'Waiting for the host to start'}</span>`;
  $('lbCode').innerHTML=(NET.code||'·····').split('').map(c=>`<i>${c}</i>`).join('');
  if(status!==undefined)$('lbStatus').textContent=status;
  const size=mode?MODES[mode].size:10,fill=NET.fill&&mode!=='practice';
  const tName=t=>t==='A'?'Blue':t==='B'?'Red':t==='T'?'Attack':t==='CT'?'Defense':t;
  const pRow=r=>`<div class="lrow ${r.id===NET.myId?'me':''}"><span>${badgeSvg(r.level||1,24)}</span><div class="ln"><b>${esc(r.name)}</b><small>Level ${r.level||1}${r.host?' · host':''}${r.id===NET.myId?' · you':''}</small></div>${T?`<span class="tm c${r.team} ${host?'click':''}" data-id="${r.id}" title="${host?'Switch team':''}">${tName(r.team)}${host?' ⇄':''}</span>`:''}</div>`;
  const empty=n=>Array.from({length:n},()=>`<div class="lrow slot">${fill?'<span class="bi">🤖</span><div class="ln"><b>Bot</b><small>fills this slot</small></div>':'<span class="bi">＋</span><div class="ln"><b>Open slot</b><small>invite a friend</small></div>'}</div>`).join('');
  let html;
  if(T){html=`<div class="lteams">`+T.map((t,ti)=>{const per=F?F[ti]:Math.floor(size/2);const m=NET.roster.filter(r=>r.team===t);return `<div class="lteam t${t}"><div class="lth">${tName(t)} <span>${m.length}/${per}</span></div>${m.map(pRow).join('')}${empty(Math.max(0,per-m.length))}</div>`;}).join('')+`</div>`;}
  else{const shown=Math.min(size,10);const left=Math.max(0,shown-NET.roster.length);html=NET.roster.map(pRow).join('')+empty(left)+(size>10&&fill?`<div class="lrow bot">+ ${size-10} more bots drop in with you</div>`:'');}
  $('lbList').innerHTML=html;
  $('lbHostRow').classList.toggle('hidden',!host);$('lbStart').classList.toggle('hidden',!host);$('lbInvite').classList.toggle('hidden',!host);
  $('lbHint').textContent=T&&host?'Tap a team tag to move a player':'';
  $('lbFill').checked=NET.fill;
}
$('lbList').addEventListener('click',e=>{const t=e.target.closest('.tm.click');if(!t||NET.role!=='host')return;const r=NET.roster.find(x=>x.id===t.dataset.id);const T=lobbyTeams(NET.mode);if(!r||!T)return;const to=r.team===T[0]?T[1]:T[0];const F=NET.mode==='tdm'&&fmtParse(NET.fmt);if(F&&NET.roster.filter(x=>x.team===to).length>=F[T.indexOf(to)]){$('lbStatus').textContent='That side is full in '+NET.fmt+'.';return;}r.team=to;hostLobbyUpdate();});
$('lbFill').addEventListener('change',e=>{NET.fill=e.target.checked;hostLobbyUpdate();});
$('lbCopy').onclick=()=>{try{navigator.clipboard.writeText(NET.code);$('lbCopy').textContent='Copied!';setTimeout(()=>$('lbCopy').textContent='Copy code',1200);}catch(e){}};
$('lbLeave').onclick=()=>{netLeave();renderMenu();};
$('lbStart').onclick=()=>{if(NET.role==='host')hostStart();};

/* ================= FRIENDS: friend codes, online status, 1v1 + lobby invites (peer-to-peer, no server of our own) ================= */
const FR={peer:null,ready:false,st:{},err:'',timer:0,inv:null,pending:{}};
function frCode(){if(!save.fid){const A='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';let s='';for(let i=0;i<6;i++)s+=A[Math.floor(Math.random()*A.length)];save.fid=s;persist();}return save.fid;}
function frFmt(c){return c.slice(0,3)+'-'+c.slice(3);}
function frNorm(c){return String(c||'').toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,6);}
function frList(){if(!Array.isArray(save.friends))save.friends=[];return save.friends;}
function frMe(){return{fid:frCode(),name:myName(),level:save.level||1,st:S.state==='game'?'match':NET.role?'lobby':'menu'};}
const FRPeer={
  listen(fid,onMsg,onReady,onErr){loadPeer(err=>{if(err)return onErr('No internet — friends need a connection.');
    const mk=()=>{const peer=new Peer('chfriend-'+fid.toLowerCase());FR.peer=peer;
      peer.on('open',()=>onReady());
      peer.on('connection',c=>{c.on('data',m=>onMsg(m,r=>{try{c.send(r);}catch(e){}setTimeout(()=>{try{c.close();}catch(e){}},800);}));});
      peer.on('disconnected',()=>{setTimeout(()=>{try{if(!peer.destroyed)peer.reconnect();}catch(e){}},3000);});
      peer.on('error',e=>{if(e.type==='peer-unavailable'){const id=(String(e.message).match(/chfriend-([a-z0-9]+)/)||[])[1];if(id&&FR.pending[id.toUpperCase()])FR.pending[id.toUpperCase()].forEach(f=>f(null));}
        else if(e.type==='unavailable-id')onErr('Your friend code is already open in another window or tab.');
        else if(e.type==='network'||e.type==='server-error'||e.type==='socket-error')onErr('Can\'t reach the friends network — check your internet.');});};mk();});},
  ask(fid,msg,ms,cb){if(!FR.peer||!FR.ready){cb(null);return;}let done=false;const key=fid;const fin=r=>{if(done)return;done=true;clearTimeout(t);const L=FR.pending[key];if(L){L.splice(L.indexOf(fin),1);if(!L.length)delete FR.pending[key];}try{c.close();}catch(e){}cb(r||null);};
    (FR.pending[key]=FR.pending[key]||[]).push(fin);const t=setTimeout(()=>fin(null),ms);let c;
    try{c=FR.peer.connect('chfriend-'+fid.toLowerCase(),{reliable:true,serialization:'json'});}catch(e){fin(null);return;}
    c.on('open',()=>{try{c.send(msg);}catch(e){fin(null);}});c.on('data',r=>fin(r));c.on('error',()=>fin(null));},
  close(){if(FR.peer){try{FR.peer.destroy();}catch(e){}FR.peer=null;}}
};
function frT(){return window.__mockFriends||FRPeer;}
function frStart(){if(FR.started||!save.profile)return;FR.started=true;frCode();
  frT().listen(frCode(),frOnMsg,()=>{FR.ready=true;FR.err='';frRender();frPollAll();},e=>{FR.err=e;FR.ready=false;frRender();});
  setInterval(()=>{if(!$('friends').classList.contains('hidden'))frPollAll();else if(S.state!=='game')frPollAll(true);},20000);}
function frToast(t,ms=3200){const el=$('frToast');el.textContent=t;el.classList.remove('hidden');clearTimeout(FR.tt);FR.tt=setTimeout(()=>el.classList.add('hidden'),ms);}
function frUpd(fid,r){const f=frList().find(x=>x.id===fid);if(f&&r){if(r.name)f.name=String(r.name).replace(/[<>]/g,'').slice(0,14);if(r.level)f.level=clamp(r.level|0,1,MAX_LEVEL);persist();}}
function frPoll(f){FR.st[f.id]=FR.st[f.id]&&FR.st[f.id]!=='off'?FR.st[f.id]:'chk';frRender();
  frT().ask(f.id,Object.assign({t:'hi'},frMe()),7000,r=>{FR.st[f.id]=r?(r.st||'menu'):'off';if(r)frUpd(f.id,r);frRender();});}
function frPollAll(quiet){for(const f of frList())if(!quiet||FR.st[f.id]!=='chk')frPoll(f);}
function frOnline(){return frList().filter(f=>FR.st[f.id]&&FR.st[f.id]!=='off'&&FR.st[f.id]!=='chk').length;}
function frOnMsg(m,reply){if(!m||typeof m!=='object')return;const from=frNorm(m.fid);if(!from||from===frCode())return;
  const nm=String(m.name||'Player').replace(/[<>]/g,'').slice(0,14);
  if(m.t==='hi'){reply(Object.assign({t:'hi-r'},frMe()));if(frList().find(f=>f.id===from)){FR.st[from]=m.st||'menu';frUpd(from,m);frRender();}return;}
  if(m.t==='freq'){reply(Object.assign({t:'fok'},frMe()));const ex=frList().find(f=>f.id===from);
    if(ex){FR.st[from]=m.st||'menu';frUpd(from,m);frRender();return;}
    save.frReqs=(save.frReqs||[]).filter(r=>r.id!==from);save.frReqs.push({id:from,name:nm,level:m.level|0||1});persist();frRender();frToast(nm+' added you as a friend — open Friends to add them back.',5000);return;}
  if(m.t==='inv'){const mode=MODES[m.mode]?m.mode:'duel';
    if(S.state==='game'||FR.inv||(NET.role&&NET.inGame)){reply({t:'invr',ok:false,busy:true,fid:frCode(),name:myName()});return;}
    frShowInvite({from,name:nm,code:String(m.code||'').toUpperCase().slice(0,5),mode,fmt:fmtParse(m.fmt)?m.fmt:(mode==='duel'?'1v1':null)},reply);return;}}
function frShowInvite(inv,reply){FR.inv=inv;const mn=MODES[inv.mode].name;
  $('ipT').textContent=inv.fmt?`${inv.name} challenges you to a ${inv.fmt}!`:`${inv.name} invites you to their lobby`;
  $('ipS').textContent=inv.mode==='duel'?'1v1 Duel · first to 10 kills':inv.fmt?`${inv.fmt} Team Deathmatch · first to ${fmtGoal(fmtParse(inv.fmt))} kills`:mn+' · room '+inv.code;
  $('invPop').classList.remove('hidden');sfx('beep');const bar=$('ipBar');bar.style.transition='none';bar.style.width='100%';requestAnimationFrame(()=>{bar.style.transition='width 30s linear';bar.style.width='0%';});
  const close=ok=>{if(FR.inv!==inv)return;FR.inv=null;clearTimeout(inv.t);$('invPop').classList.add('hidden');reply({t:'invr',ok,fid:frCode(),name:myName()});
    if(ok){$('friends').classList.add('hidden');if(NET.role)netLeave(true);joinRoom(inv.code);if(!$('lobby').classList.contains('hidden'))return;frToast('Joining '+inv.name+'…');}};
  inv.t=setTimeout(()=>close(false),30000);$('ipYes').onclick=()=>close(true);$('ipNo').onclick=()=>close(false);}
function frInvite(f,mode,fmt){if(S.state==='game'){frToast('Finish your match first.');return;}
  if(NET.role==='client'){frToast('Only the room host can invite.');return;}
  const send=()=>{frToast('Invite sent to '+f.name+'…',30000);
    frT().ask(f.id,Object.assign({t:'inv',code:NET.code,mode:NET.mode,fmt:NET.fmt||(NET.mode==='duel'?'1v1':null)},frMe()),33000,r=>{
      if(!r)frToast(f.name+' didn\'t answer.');else if(r.ok)frToast(f.name+' accepted — they\'re joining your lobby.');else frToast(f.name+(r.busy?' is busy in a match.':' declined.'));});};
  if(NET.role==='host'&&NET.code){if(NET.ready)send();else NET._ready=send;return;}
  $('friends').classList.add('hidden');hostRoom(mode||'duel',fmt);NET._ready=send;}
function frAdd(code){code=frNorm(code);$('frErr').textContent='';
  if(code.length!==6){$('frErr').textContent='A friend code has 6 letters and numbers, like ABC-123.';return;}
  if(code===frCode()){$('frErr').textContent='That\'s your own code.';return;}
  if(frList().find(f=>f.id===code)){$('frErr').textContent='Already in your friends.';return;}
  if(frList().length>=50){$('frErr').textContent='Friends list is full (50).';return;}
  const req=(save.frReqs||[]).find(r=>r.id===code);frList().push({id:code,name:req?req.name:'Player '+frFmt(code),level:req?req.level:1});
  save.frReqs=(save.frReqs||[]).filter(r=>r.id!==code);persist();$('frIn').value='';FR.st[code]='chk';frRender();
  frT().ask(code,Object.assign({t:'freq'},frMe()),7000,r=>{if(r){frUpd(code,r);FR.st[code]=r.st||'menu';frToast('Added '+(r.name||'friend')+'.');}else{FR.st[code]='off';frToast('Friend added. They\'re offline right now.');}frRender();});}
function frRemove(id){save.friends=frList().filter(f=>f.id!==id);persist();frRender();}
const FR_ST={on:'Online',menu:'Online',lobby:'In a lobby',match:'In a match',off:'Offline',chk:'Checking…'};
function frRender(){const n=frOnline();const b=$('frBadge');if(b){b.textContent=n;b.classList.toggle('hidden',!n);}
  if($('friends').classList.contains('hidden'))return;
  $('frMy').textContent=frFmt(frCode());$('frNet').textContent=FR.err||(FR.ready?'':'Connecting to the friends network…');
  const host=NET.role==='host'&&NET.code;
  $('frReqs').innerHTML=(save.frReqs||[]).map(r=>`<div class="frf frreq"><span class="dot on"></span><div class="nm"><b>${esc(r.name)}</b><small>${frFmt(r.id)} · added you</small></div><button class="btn pri" data-ra="${r.id}">Add back</button><button class="btn x" data-rx="${r.id}">✕</button></div>`).join('');
  const L=frList().slice().sort((a,b)=>{const o=x=>{const s=FR.st[x.id];return s&&s!=='off'&&s!=='chk'?0:s==='chk'?1:2;};return o(a)-o(b);});
  $('frList').innerHTML=L.length?L.map(f=>{const st=FR.st[f.id]||'off';const on=st!=='off'&&st!=='chk';
    return `<div class="frf"><span class="dot ${st==='chk'?'chk':st==='match'?'busy':on?'on':''}"></span><span>${badgeSvg(f.level||1,24)}</span><div class="nm"><b>${esc(f.name)}</b><small>${frFmt(f.id)} · LV ${f.level||1} · ${FR_ST[st]||'Online'}</small></div>`+
      (on&&st!=='match'?(host?`<button class="btn pri" data-inv="${f.id}">Invite</button>`:`<button class="btn pri" data-duel="${f.id}">⚔ Challenge</button>`):'')+`<button class="btn x" data-rm="${f.id}" title="Remove">✕</button></div>`;}).join('')
    :'<div class="note" style="text-align:center">No friends yet — add one with their friend code.</div>';}
function openFriends(){frStart();$('friends').classList.remove('hidden');frRender();if(FR.ready)frPollAll();}
$('bFriends').onclick=()=>{sfx('click');openFriends();};$('mpFriends').onclick=()=>openFriends();$('lbInvite').onclick=()=>openFriends();
$('frClose').onclick=()=>$('friends').classList.add('hidden');
$('friends').addEventListener('click',e=>{if(e.target.id==='friends'){$('friends').classList.add('hidden');return;}const t=e.target.closest('[data-duel],[data-inv],[data-rm],[data-ra],[data-rx]');if(!t)return;
  const id=t.dataset.duel||t.dataset.inv||t.dataset.rm||t.dataset.ra||t.dataset.rx;const f=frList().find(x=>x.id===id);
  if(t.dataset.duel&&f)openVsPick(f);else if(t.dataset.inv&&f)frInvite(f);else if(t.dataset.rm){if(t.dataset.sure)frRemove(id);else{t.dataset.sure=1;t.textContent='Remove?';setTimeout(()=>{if(t.isConnected){delete t.dataset.sure;t.textContent='✕';}},2500);}}
  else if(t.dataset.ra)frAdd(id);else if(t.dataset.rx){save.frReqs=(save.frReqs||[]).filter(r=>r.id!==id);persist();frRender();}});
$('frAdd').onclick=()=>frAdd($('frIn').value);$('frIn').addEventListener('keydown',e=>{if(e.key==='Enter')frAdd($('frIn').value);e.stopPropagation();});
$('frIn').addEventListener('input',e=>{const v=frNorm(e.target.value);e.target.value=v.length>3?v.slice(0,3)+'-'+v.slice(3):v;});
$('frCopy').onclick=()=>{try{navigator.clipboard.writeText(frFmt(frCode()));$('frCopy').textContent='Copied!';setTimeout(()=>$('frCopy').textContent='Copy',1200);}catch(e){}};

/* ================= CONTROLLER (Gamepad API): Xbox / PlayStation / generic "standard" pads, in game and in menus ================= */
const GP={active:false,idx:-1,prev:[],t:0,rep:{},sprint:false,crouch:false,focus:null,lastNav:0,name:''};
const GB={A:0,B:1,X:2,Y:3,LB:4,RB:5,LT:6,RT:7,VIEW:8,MENU:9,LS:10,RS:11,UP:12,DOWN:13,LEFT:14,RIGHT:15};
function gpToast(t){const el=$('gpToast');if(!el)return;$('gpTt').textContent=t;el.classList.remove('hide');clearTimeout(GP.tt);GP.tt=setTimeout(()=>el.classList.add('hide'),2600);}
function gpStatus(){const el=$('gpSt');if(!el)return;let n='';try{const ps=navigator.getGamepads?navigator.getGamepads():[];for(const g of ps)if(g){n=g.id.replace(/\(.*?\)/g,'').trim().slice(0,38);break;}}catch(e){}el.textContent=n?'· '+n+' connected':'· none connected — plug in or pair a controller and press a button';}
function gpRumble(strong,weak,ms){if(save.padVib===false||!GP.active)return;try{const g=navigator.getGamepads()[GP.idx];const a=g&&g.vibrationActuator;if(a&&a.playEffect)a.playEffect('dual-rumble',{duration:ms,strongMagnitude:clamp(strong,0,1),weakMagnitude:clamp(weak,0,1)});}catch(e){}}
function gpSetActive(on){if(GP.active===on)return;GP.active=on;document.body.classList.toggle('gpad',on);
  if(on){if(!save.padHelpSeen)setTimeout(()=>{if(GP.active&&!PH.open){GP.phArmed=false;openPadHelp();}},350);S.noLock=true;S.mIn=false;if(document.pointerLockElement)try{document.exitPointerLock();}catch(e){}if(S.state==='game'&&!S.ended&&!$('pause').classList.contains('hidden')&&!S.pausedByUser)closePause();}
  else{S.noLock=TOUCH.on||!!S.lockBlocked;gpBlur();for(const k of['KeyW','KeyS','KeyA','KeyD','ShiftLeft','ControlLeft','Space','KeyE','Tab'])vKey(k,false);mouse.down=false;}}
addEventListener('gamepadconnected',e=>{gpToast((e.gamepad.id.replace(/\(.*?\)/g,'').trim().slice(0,30)||'Controller')+' connected');gpStatus();});
addEventListener('gamepaddisconnected',()=>{gpToast('Controller disconnected');if(GP.active)gpSetActive(false);gpStatus();});
addEventListener('mousemove',e=>{if(GP.active&&(Math.abs(e.movementX)+Math.abs(e.movementY)>6))gpSetActive(false);},true);
addEventListener('keydown',e=>{if(GP.active&&e.isTrusted)gpSetActive(false);},true);
addEventListener('touchstart',e=>{if(GP.active&&e.isTrusted)gpSetActive(false);},{capture:true,passive:true});
function gpDZ(v,dz=0.14){const a=Math.abs(v);if(a<dz)return 0;return Math.sign(v)*((a-dz)/(1-dz));}
/* ---- menu navigation ---- */
function gpLayer(){const vis=el=>el&&!el.classList.contains('hidden');for(const id of['camScr','acctSw','recScr','lockScr'])if(vis($(id)))return $(id);
  if(vis($('invPop')))return $('invPop');
  const mods=[...document.querySelectorAll('.modal:not(.hidden)')].filter(m=>m.offsetParent!==null||getComputedStyle(m).position==='fixed');if(mods.length)return mods[mods.length-1];
  for(const id of['end','buy','pause'])if(vis($(id)))return $(id);
  if(S.state!=='game')return $('menu');return null;}
const GP_SEL='button,select,input:not([type=hidden]),.mode,[data-pk],[data-k],[data-it],.care-c.open,.wcard[data-w],.lrow .tm.click';
function gpItems(L){return [...L.querySelectorAll(GP_SEL)].filter(el=>{if(el.disabled)return false;const r=el.getBoundingClientRect();if(r.width<4||r.height<4)return false;if(r.bottom<0||r.top>innerHeight+400)return false;const cs=getComputedStyle(el);return cs.visibility!=='hidden'&&cs.display!=='none'&&el.offsetParent!==null;});}
function gpBlur(){if(GP.focus){GP.focus.classList.remove('gpfocus');GP.focus=null;}}
function gpFocus(el){if(GP.focus===el)return;gpBlur();if(!el)return;GP.focus=el;el.classList.add('gpfocus');try{el.scrollIntoView({block:'nearest',inline:'nearest'});}catch(e){}sfx('click',0.25);}
function gpMove(dx,dy){const L=gpLayer();if(!L)return;const items=gpItems(L);if(!items.length)return;
  if(!GP.focus||!L.contains(GP.focus)||!items.includes(GP.focus)){gpFocus(items.find(el=>el.classList.contains('play'))||items.find(el=>el.classList.contains('pri'))||items[0]);return;}
  const f=GP.focus;if(f.type==='range'&&dx){const st=+f.step||0.05;f.value=clamp(+f.value+dx*st,+f.min,+f.max);f.dispatchEvent(new Event('input',{bubbles:true}));return;}
  const r0=f.getBoundingClientRect(),cx=r0.left+r0.width/2,cy=r0.top+r0.height/2;let best=null,bs=1e9;
  for(const el of items){if(el===f)continue;const r=el.getBoundingClientRect(),x=r.left+r.width/2,y=r.top+r.height/2,vx=x-cx,vy=y-cy;
    const along=vx*dx+vy*dy;if(along<=4)continue;const perp=Math.abs(vx*dy-vy*dx);const sc=along+perp*2.2;if(sc<bs){bs=sc;best=el;}}
  if(best)gpFocus(best);}
function gpPress(){const f=GP.focus;if(!f||!document.contains(f))return gpMove(0,0);
  if(f.tagName==='SELECT'){f.selectedIndex=(f.selectedIndex+1)%f.options.length;f.dispatchEvent(new Event('change',{bubbles:true}));sfx('click');return;}
  if(f.type==='checkbox'){f.checked=!f.checked;f.dispatchEvent(new Event('change',{bubbles:true}));sfx('click');return;}
  if(f.tagName==='INPUT'&&f.type!=='range'){f.focus();return;}
  f.click();setTimeout(()=>{if(GP.focus&&!document.contains(GP.focus))GP.focus=null;},50);}
function gpBack(){const pop=$('invPop');if(pop&&!pop.classList.contains('hidden')){$('ipNo').click();return;}
  if(document.activeElement&&document.activeElement.tagName==='INPUT'){document.activeElement.blur();return;}
  const L=gpLayer();
  if(S.state==='game'){if(S.buyOpen){closeBuy();return;}if(L&&L.id==='pause'){closePause();return;}}
  if(L&&L.classList.contains('modal')){const c=L.querySelector('#frClose,#lbLeave,#sClose,#stClose,.mclose,[data-close],.btn.close')||[...L.querySelectorAll('button')].find(b=>/^(✕|×|close|done|back|cancel|ok)$/i.test(b.textContent.trim()));
    if(c){c.click();}else{L.classList.add('hidden');}gpBlur();return;}
  if(S.state!=='game'){const h=$('bHome');if(h)h.click();gpBlur();}}
function gpTab(d){const tabs=[...document.querySelectorAll('#topbar .tab')];if(!tabs.length||S.state==='game')return;let i=tabs.findIndex(t=>t.classList.contains('on')||t.classList.contains('active'));if(i<0)i=2;i=(i+d+tabs.length)%tabs.length;tabs[i].click();gpBlur();setTimeout(()=>gpMove(0,0),60);}
/* stick calibration: remembers each axis' resting value, spots triggers that live on axes, and slowly soaks up stick drift */
function gpCal(g){const key=g.index+'|'+g.id+'|'+g.axes.length;let c=GP.cal;const now=performance.now();
  if(!c||c.key!==key){const rest=g.axes.map(v=>v);c=GP.cal={key,rest,t0:now,still:g.axes.map(()=>now),last:g.axes.slice(),lt:-1,rt:-1,map:[0,1,2,3]};
    if(g.mapping!=='standard'){const trig=[],stick=[];rest.forEach((v,i)=>{if(Math.abs(v)>1.05)return;/* hat switch */if(v<-0.5)trig.push(i);else stick.push(i);});
      c.map=[stick[0]??0,stick[1]??1,stick[2]??2,stick[3]??3];c.lt=trig[0]??-1;c.rt=trig[1]??-1;}
    for(const i of c.map)if(Math.abs(c.rest[i])>0.3)c.rest[i]=0;}
  // first second after connecting: keep re-sampling the rest pose (thumbs usually off the sticks)
  const ax=[];for(let k=0;k<4;k++){const i=c.map[k];const v=g.axes[i]||0;
    if(Math.abs(v-c.last[i])>0.02){c.still[i]=now;c.last[i]=v;}
    const off=v-c.rest[i];
    if((now-c.t0<1000&&Math.abs(v)<0.3)||(Math.abs(off)<0.3&&now-c.still[i]>2500))c.rest[i]=v;   // drift absorption
    ax.push(clamp(v-c.rest[i],-1,1));}
  c.ax=ax;return c;}
function gpRadial(x,y,dz){const m=Math.hypot(x,y);if(m<dz)return[0,0];const k=Math.min(1,(m-dz)/(1-dz))/m;return[x*k,y*k];}

/* ===== CONTROLLER LAYOUT SCREEN (shown to new controller players, and from Settings / Pause) ===== */
const PH={open:false,ly:'xbox',wasPaused:false};
function padKind(id){return /054c|dualsense|dualshock|playstation|ps[345]|wireless controller/i.test(id||'')?'ps':'xbox';}
const PH_NAMES={ps:{0:'✕',1:'○',2:'□',3:'△',4:'L1',5:'R1',6:'L2',7:'R2',8:'Create',9:'Options',10:'L3',11:'R3'},xbox:{0:'A',1:'B',2:'X',3:'Y',4:'LB',5:'RB',6:'LT',7:'RT',8:'View',9:'Menu',10:'LS',11:'RS'}};
const PH_COL={ps:{0:'#5b8cff',1:'#ff5b6e',2:'#ff7ad9',3:'#3fd9b5'},xbox:{0:'#52c24a',1:'#e5484d',2:'#3b82f6',3:'#f2c21b'}};
function phG(i,ly){ly=ly||PH.ly;const n=PH_NAMES[ly][i];if(n===undefined){const d={12:'▲',13:'▼',14:'◀',15:'▶'}[i];return `<span class="ph-g sq">${d}</span>`;}
  const face=i<=3;const c=face?PH_COL[ly][i]:null;return `<span class="ph-g${face?' r':''}" ${c?`style="color:${c};background:#1b2029;box-shadow:inset 0 0 0 2px ${c}"`:''}>${n}</span>`;}
function padName(i){return PH_NAMES[(GP.name?padKind(GP.name):'xbox')][i];}
function phRow(i,txt,sub){return `<div class="ph-row" data-b="${i}">${phG(i)}<div>${txt}${sub?`<small>${sub}</small>`:''}</div></div>`;}
function phSvg(){const ps=PH.ly==='ps';const k=(i,inner)=>`<g class="kb" data-b="${i}">${inner}</g>`;
  const dc=ps?[165,150]:[225,215],lc=ps?[225,215]:[165,150],rc=[375,215],fc=[435,150];
  const face=[[3,0,-28],[1,28,0],[0,0,28],[2,-28,0]].map(([i,dx,dy])=>{const col=PH_COL[PH.ly][i];return k(i,`<circle class="k" cx="${fc[0]+dx}" cy="${fc[1]+dy}" r="14"/><text class="t" x="${fc[0]+dx}" y="${fc[1]+dy}" fill="${col}">${PH_NAMES[PH.ly][i]}</text>`);}).join('');
  const dp=[[12,0,-1],[13,0,1],[14,-1,0],[15,1,0]].map(([i,x,y])=>k(i,`<rect class="k" x="${dc[0]+x*19-10}" y="${dc[1]+y*19-10}" width="20" height="20" rx="4"/>`)).join('')+`<rect class="k" x="${dc[0]-10}" y="${dc[1]-10}" width="20" height="20" style="pointer-events:none"/>`;
  const stick=(i,c,id)=>k(i,`<circle class="ln" cx="${c[0]}" cy="${c[1]}" r="31"/><g id="${id}"><circle class="k" cx="${c[0]}" cy="${c[1]}" r="22"/><circle class="ln" cx="${c[0]}" cy="${c[1]}" r="13" style="opacity:.5"/></g>`);
  const sh=(i,x,y,w,h,t)=>k(i,`<rect class="k" x="${x}" y="${y}" width="${w}" height="${h}" rx="9"/><text class="t" x="${x+w/2}" y="${y+h/2}" fill="#c9d1dc" style="font-size:12px">${t}</text>`);
  const N=PH_NAMES[PH.ly];
  $('phSvg').innerHTML=`<defs><linearGradient id="phGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#222a36"/><stop offset="1" stop-color="#121720"/></linearGradient></defs><path class="bd" d="M150,82 C110,82 92,110 82,150 L42,300 C32,346 62,372 98,350 L172,282 C186,270 200,264 222,264 L378,264 C400,264 414,270 428,282 L502,350 C538,372 568,346 558,300 L518,150 C508,110 490,82 450,82 Z"/>`+
    sh(6,135,22,82,26,N[6])+sh(7,383,22,82,26,N[7])+sh(4,128,54,96,22,N[4])+sh(5,376,54,96,22,N[5])+
    (ps?`<rect class="ln" x="238" y="94" width="124" height="70" rx="12"/>`:`<circle class="ln" cx="300" cy="118" r="20"/>`)+
    k(8,`<rect class="k" x="${ps?212:252}" y="${ps?100:150}" width="${ps?14:22}" height="${ps?22:14}" rx="5"/>`)+k(9,`<rect class="k" x="${ps?374:326}" y="${ps?100:150}" width="${ps?14:22}" height="${ps?22:14}" rx="5"/>`)+
    dp+face+stick(10,lc,'phLS')+stick(11,rc,'phRS');}
function phRender(){const R=phRow,br=S.mode==='br';
  $('phL').innerHTML=R(4,'Grenade','press again to switch type')+R(6,'Aim down sights','scope on snipers · block with katana')+R(8,'Scoreboard','hold');
  $('phR').innerHTML=R(5,'Use','plant · defuse · pick up · restock')+R(7,'Fire','hold for full-auto')+R(9,'Pause','and the controls screen');
  $('phB').innerHTML=`<div><div class="ph-sec">DIRECTIONAL PAD</div>${R(12,'Primary weapon')}${R(14,'Pistol')}${R(13,'Knife')}${R(15,'Buy menu','Heal in Battle Royale')}</div>`+
    `<div><div class="ph-sec">LEFT STICK</div><div class="ph-row" data-b="la">${phG(10).replace(/>[^<]*</,'>◎<')}<div>Move</div></div>${R(10,'Sprint','click the stick')}</div>`+
    `<div><div class="ph-sec">RIGHT STICK</div><div class="ph-row" data-b="ra">${phG(11).replace(/>[^<]*</,'>◎<')}<div>Look around</div></div>${R(11,'Inspect weapon','click the stick')}</div>`+
    `<div><div class="ph-sec">FACE BUTTONS</div>${R(0,'Jump')}${R(1,'Crouch','slide while sprinting')}${R(2,'Reload')}${R(3,'Next weapon')}</div>`;
  $('phMenu').innerHTML=`In menus: ${phG(12)}${phG(13)} move · ${phG(0)} select · ${phG(1)} back · ${phG(4)}${phG(5)} tabs &nbsp;·&nbsp; press ${phG(9)} to continue`;
  document.querySelectorAll('.ph-seg button').forEach(b=>b.classList.toggle('on',b.dataset.ly===PH.ly));phSvg();}
function openPadHelp(){PH.ly=GP.name?padKind(GP.name):(save.padLy||'xbox');PH.open=true;phRender();$('padHelp').classList.remove('hidden');
  if(S.state==='game'&&!S.ended){PH.wasPaused=S.uiOpen;if(!S.uiOpen){S.paused=!NET.role;S.uiOpen=true;mouse.down=false;}}
  if(document.pointerLockElement)try{document.exitPointerLock();}catch(e){}gpBlur();}
function closePadHelp(){if(!PH.open)return;PH.open=false;save.padHelpSeen=1;persist();$('padHelp').classList.add('hidden');
  if(S.state==='game'&&!S.ended&&!PH.wasPaused&&$('pause').classList.contains('hidden')){S.paused=false;S.uiOpen=false;S.simClock=performance.now();}}
function phTick(b,ax){if(!PH.open)return;const on=new Set();b.forEach((v,i)=>{if(v)on.add(String(i));});
  if(Math.hypot(ax[0]||0,ax[1]||0)>0.2)on.add('la');if(Math.hypot(ax[2]||0,ax[3]||0)>0.2)on.add('ra');
  document.querySelectorAll('#padHelp [data-b]').forEach(el=>el.classList.toggle(el.tagName==='g'?'ph-hot':'hot',on.has(el.dataset.b)));
  document.querySelectorAll('#phSvg .kb').forEach(g=>g.querySelectorAll('.k').forEach(c=>c.classList.toggle('hot',on.has(g.dataset.b)||(g.dataset.b==='10'&&on.has('la'))||(g.dataset.b==='11'&&on.has('ra')))));
  const mv=(id,x,y)=>{const e=$(id);if(e)e.setAttribute('transform',`translate(${(x||0)*9},${(y||0)*9})`);};mv('phLS',ax[0],ax[1]);mv('phRS',ax[2],ax[3]);}
document.querySelectorAll('.ph-seg button').forEach(b=>b.onclick=()=>{PH.ly=b.dataset.ly;save.padLy=PH.ly;persist();phRender();});
$('phOk').onclick=()=>closePadHelp();$('sPadHelp').onclick=()=>{$('settings').classList.add('hidden');openPadHelp();};$('pPad').onclick=()=>openPadHelp();
/* ---- per-frame poll ---- */
function gpPoll(dt){let pads;try{pads=navigator.getGamepads?navigator.getGamepads():null;}catch(e){pads=null;}if(!pads)return;
  let g=null;for(const p of pads)if(p&&p.connected&&(p.mapping==='standard'||p.buttons.length>=10)&&p.axes.length>=2){g=p;break;}if(!g)return;
  const C=gpCal(g),ax=C.ax;
  const b=g.buttons.map((x,i)=>x&&(x.pressed||x.value>((i===6||i===7)?0.3:0.5)));
  // non-standard pads report the triggers as axes resting at -1: map them onto LT/RT
  if(C.lt>=0&&!b[GB.LT])b[GB.LT]=(g.axes[C.lt]-C.rest[C.lt])>0.6;if(C.rt>=0&&!b[GB.RT])b[GB.RT]=(g.axes[C.rt]-C.rest[C.rt])>0.6;
  const pr=GP.prev;const down=i=>b[i]&&!pr[i],up=i=>!b[i]&&pr[i];
  const anyIn=b.some(Boolean)||ax.some(v=>Math.abs(v)>0.45);if(anyIn&&!GP.active){GP.idx=g.index;gpSetActive(true);GP.name=g.id;initAudio();}
  if(!GP.active){GP.prev=b;return;}
  GP.idx=g.index;
  if(PH.open){phTick(b,ax);if(down(GB.MENU))closePadHelp();{const ry2=gpDZ(ax[3]||0,0.3);if(ry2)$('padHelp').scrollTop+=ry2*600*dt;}GP.prev=b;return;}
  const dz=save.padDZ||0.16;const[lx,ly]=gpRadial(ax[0]||0,ax[1]||0,dz);const[rx,ry]=gpRadial(ax[2]||0,ax[3]||0,dz);GP.live=[lx,ly,rx,ry];
  const inGame=S.state==='game'&&!S.ended&&!S.uiOpen;
  if(inGame){gpBlur();const p=player;
    // move (W/A/S/D) + sprint latch on L3 or full forward push held
    const th=0.3;vKey('KeyW',ly<-th);vKey('KeyS',ly>th);vKey('KeyA',lx<-th);vKey('KeyD',lx>th);
    if(down(GB.LS))GP.sprint=!GP.sprint;if(ly>-0.3)GP.sprint=false;vKey('ShiftLeft',GP.sprint);
    // look: response curve + aim-assist friction, slower while aiming
    if(rx||ry){const curve=v=>Math.sign(v)*Math.pow(Math.abs(v),1.8);const sp=3.4*(save.padSens||1)*(camera.fov/80)*aaFriction()*(p.ads||p.scoped?0.6:1);
      p.yaw-=curve(rx)*sp*dt;p.pitch=clamp(p.pitch-curve(ry)*sp*0.8*dt*(save.padInv?-1:1),-1.55,1.55);AA.act=0.35;applyCamRot();vm.mdx+=rx*6;vm.mdy+=ry*6;}
    // fire / aim (re-use mouse paths)
    if(down(GB.RT))canvas.dispatchEvent(new MouseEvent('mousedown',{button:0,bubbles:true}));if(up(GB.RT))dispatchEvent(new MouseEvent('mouseup',{button:0}));
    if(down(GB.LT))canvas.dispatchEvent(new MouseEvent('mousedown',{button:2,bubbles:true}));if(up(GB.LT)){const w=curW();if(!(w&&w.zoom))dispatchEvent(new MouseEvent('mouseup',{button:2}));}
    // face buttons
    vKey('Space',!!b[GB.A]);
    if(down(GB.B)){if(p.sprinting||GP.sprint)vTap('KeyQ');else{GP.crouch=!GP.crouch;vKey('ControlLeft',GP.crouch);}}
    if(down(GB.X))vTap('KeyR');
    if(down(GB.Y)){const order=[1,2,3,4,5].filter(s=>p.inv[s]);let i=order.indexOf(p.slot);i=(i+1)%order.length;switchSlot(order[i]);}
    if(down(GB.LB))vTap('Digit4');vKey('KeyE',!!b[GB.RB]);
    if(down(GB.RS))vTap('KeyF');
    if(down(GB.UP))vTap('Digit1');if(down(GB.LEFT))vTap('Digit2');if(down(GB.DOWN))vTap('Digit3');
    if(down(GB.RIGHT)){if(S.mode==='br')vTap('KeyH');else vTap('KeyB');}
    vKey('Tab',!!b[GB.VIEW]);
    if(down(GB.MENU)){openPause(true);setTimeout(()=>gpMove(0,0),30);}
  }else{
    // release held game keys when leaving gameplay
    if(GP.wasGame){for(const k of['KeyW','KeyS','KeyA','KeyD','ShiftLeft','Space','KeyE','Tab'])vKey(k,false);if(GP.crouch){GP.crouch=false;vKey('ControlLeft',false);}mouse.down=false;GP.sprint=false;}
    // spectating while dead: RT cycles players
    if(S.state==='game'&&!S.uiOpen&&!player.alive&&down(GB.RT))canvas.dispatchEvent(new MouseEvent('mousedown',{button:0,bubbles:true}));
    // menu navigation with D-pad / left stick (auto-repeat)
    const now=performance.now();let dx=0,dy=0;
    if(b[GB.LEFT]||lx<-0.55)dx=-1;else if(b[GB.RIGHT]||lx>0.55)dx=1;if(b[GB.UP]||ly<-0.55)dy=-1;else if(b[GB.DOWN]||ly>0.55)dy=1;
    if(dx||dy){const first=!GP.navHeld;if(first||now-GP.lastNav>(GP.navRep?110:380)){GP.navRep=!first;GP.lastNav=now;GP.navHeld=true;gpMove(dy?0:dx,dy);}}else{GP.navHeld=false;GP.navRep=false;}
    if(ry){const L=gpLayer();const sc=L&&([...L.querySelectorAll('*')].find(el=>el.scrollHeight>el.clientHeight+20&&/(auto|scroll)/.test(getComputedStyle(el).overflowY))||L);if(sc)sc.scrollTop+=ry*900*dt;}
    if(down(GB.A))gpPress();if(down(GB.B))gpBack();
    if(down(GB.LB))gpTab(-1);if(down(GB.RB))gpTab(1);
    if(down(GB.MENU)&&S.state==='game'&&S.uiOpen&&$('pause')&&!$('pause').classList.contains('hidden'))closePause();
    if(down(GB.MENU)&&S.state==='game'&&S.buyOpen)closeBuy();
  }
  GP.wasGame=inGame;GP.prev=b;}
function hostLobbyUpdate(){if(NET.role!=='host')return;netBroadcast({t:'lobby',roster:NET.roster,mode:NET.mode,fmt:NET.fmt||null,code:NET.code,fill:NET.fill,ranked:NET.ranked||null});renderLobby();}
function hostOnData(id,m){
  const e=S.byId[id];
  switch(m.t){
    case 'hello':{
      if(NET.inGame){netSend(id,{t:'busy'});NET.conns[id]&&NET.conns[id].close();delete NET.conns[id];return;}
      if(NET.ranked&&(m.level|0)<RANK_UNLOCK){netSend(id,{t:'lowlvl'});return;}
      {const F=NET.mode==='tdm'&&fmtParse(NET.fmt);if(NET.roster.length>=(F?F[0]+F[1]:Math.min(10,MODES[NET.mode].size))){netSend(id,{t:'full'});return;}}
      if(!NET.roster.find(r=>r.id===id))NET.roster.push({id,name:String(m.name||'Player').slice(0,14),level:clamp(m.level|0,1,MAX_LEVEL),team:null,agent:AGENTS[m.agent]?m.agent:'operator'});
      rebalance();netSend(id,{t:'welcome',id});hostLobbyUpdate();break;}
    case 'bye':hostOnClose(id);break;
    case 'st':if(e&&e.isNet){e.tpos.set(m.x,m.y,m.z);e.tyaw=m.yaw;e.crouch=m.c?1:0;e.moving=!!m.m;e.wid=m.w;}break;
    case 'hit':{if(!e||!e.alive||S.state!=='game')break;const v=S.byId[m.id];if(!v||!v.alive||v===e)break;
      if((S.mode==='tdm'||S.mode==='defuse')&&v.team===e.team)break;const wid=WEAPONS[m.w]?m.w:'glock';damage(v,clamp(+m.d||0,0,300),e,wid,!!m.h);break;}
    case 'heal':{if(e&&e.alive&&S.state==='game'&&S.time-(e.lastHealT||-99)>2){e.lastHealT=S.time;e.hp=100;}break;}
    case 'bar':{barrelNet(m,e);netBroadcast({t:'bar',i:m.i,by:id},id);break;}
    case 'win':{winBreak(WINDOWS[m.i],false);netBroadcast({t:'win',i:m.i},id);break;}
    case 'shot':{const a=new V3(...m.f),b=new V3(...m.to);tracer(a,b,TRACER2);const d=player.pos.distanceTo(a);gunSound(m.w,a);if(e)e.lastShot=S.time;netBroadcast({t:'shot',f:m.f,to:m.to,w:m.w,by:id},id);break;}
    case 'nade':if(e){spawnNade(m.id,new V3(...m.p),new V3(...m.v),e,false);netBroadcast({t:'nade',id:m.id,p:m.p,v:m.v,by:id},id);}break;
    case 'plant':if(e&&e.alive&&e.hasBomb&&S.round&&S.round.phase==='live'&&siteAt(e.pos))plantBomb(e);break;
    case 'defuse':if(e&&e.alive&&e.team==='CT'&&S.round&&S.round.phase==='planted'&&e.pos.distanceTo(S.round.bomb.pos)<2.5)defuseBomb(e);break;
    case 'buy':{if(!e)break;const it=itemInfo(m.k);if(!it||e.money<it.price)break;e.money-=it.price;if(m.k==='armor')e.armor=100;if(m.k==='kit')e.kit=true;netSend(id,{t:'buyok',k:m.k,money:e.money});break;}
    case 'pick':{const L=S.loot[m.i];if(!e||!L||L.taken)break;const why=lootAllowed(L,e);if(why)break;lootHostEffect(L,e);removeLoot(L);netBroadcast({t:'lootgone',i:L.i,by:id});break;}
    case 'pscore':if(e)e.score=m.s|0;break;
  }
}
function hostOnClose(id){
  const c=NET.conns[id];delete NET.conns[id];
  const idx=NET.roster.findIndex(r=>r.id===id);if(idx>=0)NET.roster.splice(idx,1);
  const e=S.byId[id];
  if(e&&S.state==='game'){e.isNet=false;e.human=false;e.name+=' (bot)';e.wpn=WEAPONS.ak47;e.mag=e.wpn.mag;center(`${esc(e.name.replace(' (bot)',''))} left — a bot took over`,2);netBroadcast({t:'ents',list:entList()});}
  if(!NET.inGame)hostLobbyUpdate();
}
function entList(){return S.ents.map(x=>({id:x.id,name:x.isPlayer?myName():x.name,team:x.team,human:x.isPlayer||!!x.human,lvl:x.isPlayer?save.level:(x.lvl||0),agent:x.isPlayer?(save.agent||'operator'):(x.agent||null)}));}
function hostStart(){
  const mode=NET.mode;rebalance();
  const seed=(Math.random()*1e9)|0;NET.inGame=true;
  for(const r of NET.roster)netSend(r.id,{t:'start',mode,seed,team:r.team,diff:save.diff,fmt:NET.fmt||null,ranked:NET.ranked||null});
  startMatch(mode,{seed,net:'host',fmt:NET.fmt,ranked:NET.ranked||null});
}
function clientOnData(m){
  switch(m.t){
    case 'welcome':NET.myId=m.id;player.id=m.id;break;
    case 'lobby':NET.roster=m.roster;NET.mode=m.mode;NET.fmt=fmtParse(m.fmt)?m.fmt:null;NET.ranked=m.ranked||null;NET.code=m.code;NET.fill=m.fill;if(S.state!=='game'||S.ended){if(S.state==='game')toMenu(true);showLobby('Waiting for the host to start…');}break;
    case 'full':mpErr('That room is full.');netLeave(true);break;
    case 'busy':mpErr('That room is already in a match — wait for it to finish.');netLeave(true);break;
    case 'closed':clientHostLost('The host closed the room.');break;
    case 'start':$('lobby').classList.add('hidden');save.diff=m.diff||save.diff;startMatch(m.mode,{seed:m.seed,net:'client',team:m.team,fmt:fmtParse(m.fmt)?m.fmt:null,ranked:(m.ranked&&rkUnlocked())?m.ranked:null});break;
    case 'lowlvl':mpErr('Ranked rooms need Level '+RANK_UNLOCK+'.');netLeave(true);break;
    case 'ents':clientEnts(m.list);break;
    case 'snap':if(S.state==='game')applySnap(m);break;
    case 'tp':player.pos.set(m.x,0,m.z);player.vel.set(0,0,0);player.yaw=m.yaw;player.pitch=0;break;
    case 'respawn':player.pos.set(m.x,0,m.z);player.yaw=m.yaw;player.pitch=0;respawnPlayer();break;
    case 'round':{if(m.reset)resetLoadout(player);player.healT=0;if(m.reset||!(player.meds>0))player.meds=1;refillAmmo(player);player.alive=true;player.hp=100;player.pos.set(m.x,0,m.z);player.vel.set(0,0,0);player.yaw=m.yaw;player.pitch=0;player.spawnTime=S.time;player.deadT=0;S.spec=null;camera.rotation.z=0;clearNadesSmokes();roundStartMsg(m.n,m.bomb);break;}
    case 'feed':{const a=m.a?entById(m.a):null,v=entById(m.v);if(!v)break;feed(a,m.w,v,m.h);
      if(m.a===NET.myId&&m.v!==NET.myId){onPlayerKill(v,m.w,m.h,player.pos.distanceTo(v.pos));sfx('kill');hitmarker(m.h,true);center(`<span style="color:#ff6b5f">ELIMINATED</span> ${esc(v.name)}`+(m.r?` <span style="color:#7dff9b">+$${m.r}</span>`:''),1.4);if(m.h)player.heads++;}
      if(m.v===NET.myId){if(S.mode==='br')player.place=S.ents.filter(e=>e.alive&&e!==player).length+1;if(player.alive)onLocalDeath(a,m.w);}
      else if(v){v.alive=false;v.deadT=0;}break;}
    case 'bar':barrelNet(m,m.by?entById(m.by):null);break;
    case 'win':winBreak(WINDOWS[m.i],false);break;
    case 'shot':{const a=new V3(...m.f),b=new V3(...m.to);tracer(a,b,TRACER2);const d=player.pos.distanceTo(a);gunSound(m.w,a);const e=entById(m.by);if(e)e.lastShot=S.time;break;}
    case 'nade':spawnNade(m.id,new V3(...m.p),new V3(...m.v),null,true);break;
    case 'fire':igniteAt({pos:new V3(m.x,0,m.z),owner:null,visual:true},m.y,'firebomb',1.7,5,m.g);break;
    case 'boom':{const p=new V3(...m.p);boom(p,m.s);sfx('boom');break;}
    case 'planted':plantedMsg(m.site);break;
    case 'roundend':roundEndMsg(m.win,m.reason,m.reward,m.lossB);break;
    case 'buyok':player.money=m.money;applyBuy(m.k);break;
    case 'lootgone':{const L=S.loot[m.i];if(!L)break;if(m.by===NET.myId&&!L.taken){lootEffectLocal(L);sfx('pickup');center('Picked up '+lootLabel(L.type),1);}removeLoot(L);break;}
    case 'end':if(m.o.ts)S.teamScore=m.o.ts;if(m.o.wins&&S.round)S.round.wins=m.o.wins;finish(clientWin(m.o),m.o);break;
  }
}
function clientHostLost(msg){
  if(!NET.role||NET._leaving)return;
  const inGame=S.state==='game';const wasRole=NET.role;
  netLeave(true);if(!wasRole)return;
  if(inGame)toMenu();showTab('play');setCat('mp');mpErr(msg||'Lost connection to the host.');
}
function entById(id){if(id===NET.myId||(NET.role!=='client'&&id==='h'))return player;return S.byId[id];}
function clientEnts(list){
  for(const info of list){if(info.id===NET.myId){player.team=info.team;continue;}
    let e=S.byId[info.id];
    if(!e){const accent=S.mode==='defuse'?(info.team==='CT'?0x3b82f6:0xe8892b):S.mode==='tdm'?(info.team==='A'?0x3b82f6:0xef4444):0xef4444;
      e=spawnBot(info.name,info.team,accent,'ak47',{id:info.id,isProxy:true,human:info.human,lvl:info.lvl,pal:info.agent?agentPal(info.agent):null});e.alive=false;e.model.g.visible=false;}
    e.name=info.name;e.human=info.human;e.lvl=info.lvl;}
}
function netSnapshot(){
  const e=S.ents.map(x=>[x.id,+x.pos.x.toFixed(2),+x.pos.y.toFixed(2),+x.pos.z.toFixed(2),+(x.isPlayer?x.yaw+Math.PI:x.yaw).toFixed(3),x.alive?1:0,Math.ceil(x.hp),Math.ceil(x.armor||0),x.isPlayer?((x.inv[x.slot]||{}).id||'knife'):(x.isNet?x.wid:x.wpn.id),x.crouch>0.5?1:0,x.kills,x.deaths,x.money|0,x.hasBomb?1:0,x.moving?1:0,x.score|0]);
  const g={tl:+S.timeLeft.toFixed(2),cd:+S.countdown.toFixed(2),ts:S.teamScore};
  if(S.round){const R=S.round,b=R.bomb;g.r={n:R.n,ph:R.phase,t:+R.t.toFixed(2),w:R.wins,bs:b.state,bp:[+b.pos.x.toFixed(2),+b.pos.y.toFixed(2),+b.pos.z.toFixed(2)],site:b.site};}
  if(S.zone){const z=S.zone;g.z=[z.x,z.z,z.r,z.tx,z.tz,z.tr,z.state,z.t,z.phase].map(v=>typeof v==='number'?+v.toFixed(2):v);}
  netBroadcast({t:'snap',e,g});
}
function applySnap(m){
  for(const a of m.e){const[id,x,y,z,yaw,al,hp,ar,wid,cr,k,d,mo,hb,mv,sc]=a;
    if(id===NET.myId){const p=player;if(hp<p.hp-0.5&&p.alive&&al){dmgA=Math.min(0.75,dmgA+0.25+(p.hp-hp)/150);sfx('hurt',0.6);}
      p.hp=hp;p.armor=ar;p.money=mo;p.kills=k;p.deaths=d;p.hasBomb=!!hb;
      if(!al&&p.alive)onLocalDeath(null,'');
      continue;}
    const e=S.byId[id];if(!e)continue;
    e.tpos.set(x,y,z);e.tyaw=yaw;
    if(al&&!e.alive){e.alive=true;resetPose(e.model);e.model.g.visible=true;e.pos.set(x,y,z);e.yaw=yaw;}
    if(!al&&e.alive){e.alive=false;e.deadT=0;}
    e.hp=hp;e.armor=ar;e.kills=k;e.deaths=d;e.money=mo;e.hasBomb=!!hb;e.crouch=cr;e.moving=!!mv;e.score=sc;e.wid=wid;}
  const g=m.g;S.timeLeft=g.tl;S.countdown=g.cd;S.teamScore=g.ts;
  if(g.r&&S.round){const R=S.round;if(R.phase!==g.r.ph&&g.r.ph==='live'){center('<span class="cd">GO</span>',0.9);sfx('go');}
    R.n=g.r.n;R.phase=g.r.ph;R.t=g.r.t;R.wins=g.r.w;const b=R.bomb;b.state=g.r.bs;b.pos.set(...g.r.bp);b.site=g.r.site;b.mesh.g.position.copy(b.pos);b.mesh.g.visible=(b.state==='dropped'||b.state==='planted');}
  if(g.z&&S.zone){const z=S.zone,[zx,zz,zr,tx,tz,tr,st,zt,ph]=g.z;if(z.state!=='shrink'&&st==='shrink'){center('⚠ The zone is closing in',2.5);sfx('warn');}Object.assign(z,{x:zx,z:zz,r:zr,tx,tz,tr,state:st,t:zt,phase:ph});zoneVisual();}
}
function sendState(){const p=player;netToHost({t:'st',x:+p.pos.x.toFixed(2),y:+p.pos.y.toFixed(2),z:+p.pos.z.toFixed(2),yaw:+(p.yaw+Math.PI).toFixed(3),c:p.crouch>0.5?1:0,m:p.moving?1:0,w:(p.inv[p.slot]||{}).id||'knife'});
  if(S.mode==='practice')netToHost({t:'pscore',s:S.score});}
function spawnNetPlayer(r,accent){const b=spawnBot(r.name,r.team||('P'+r.id),accent,'ak47',{id:r.id,isNet:true,human:true,lvl:r.level,pal:agentPal(r.agent)});b.agent=r.agent;b.money=S.mode==='defuse'?800:1000;return b;}
function respawnNet(b){b.alive=true;b.hp=100;b.armor=0;b.deadT=0;resetPose(b.model);b.model.g.visible=true;placeEnt(b);b.tpos.copy(b.pos);syncBot(b);netSend(b.id,{t:'respawn',x:b.pos.x,z:b.pos.z,yaw:b.yaw+Math.PI});}
function matchOutcome(){
  const o={mode:S.mode,ts:S.teamScore,wins:S.round?S.round.wins:null};
  if(S.mode==='tdm')o.winTeam=S.teamScore.A>S.teamScore.B?'A':S.teamScore.B>S.teamScore.A?'B':null;
  else if(S.mode==='defuse')o.winTeam=S.round.wins.T>=ROUND.toWin?'T':S.round.wins.CT>=ROUND.toWin?'CT':null;
  else if(S.mode==='ffa'){const lead=S.ents.reduce((a,b)=>b.kills>a.kills?b:a);o.winnerId=lead.id;o.ranks={};S.ents.slice().sort((a,b)=>b.kills-a.kills).forEach((e,i)=>o.ranks[e.id]=i+1);}
  else if(S.mode==='br'){const alive=S.ents.filter(e=>e.alive);o.winnerId=alive[0]?alive[0].id:null;o.places={};for(const e of S.ents)o.places[e.id]=e.alive?1:(e.place||S.ents.length);}
  else if(S.mode==='practice'){o.scores={};for(const e of S.ents)if(e.isPlayer||e.human)o.scores[e.id]=e.isPlayer?S.score:e.score;const top=Object.entries(o.scores).sort((a,b)=>b[1]-a[1])[0];o.winnerId=top?top[0]:null;}
  return o;
}
function clientWin(o){if(o.winTeam!==undefined)return o.winTeam===player.team;return o.winnerId===NET.myId;}

/* ================= MATCH FLOW ================= */
function cleanupMatch(){
  brEnd();bloodClear();barrelsClear();for(const e of S.ents||[])if(e.aoBlob){scene.remove(e.aoBlob);e.aoBlob=null;}
  for(const b of S.bots)scene.remove(b.model.g);for(const t of S.targets)scene.remove(t.g);for(const L of S.loot)scene.remove(L.g);
  for(const f of S.fx){scene.remove(f.m);if(f.kind==='spr'&&f.m.material)f.m.material.dispose();}for(const d of S.decals)scene.remove(d);for(const f of S.floats)f.el.remove();
  clearNadesSmokes();
  if(S.round)scene.remove(S.round.bomb.mesh.g);
  if(zoneMesh){scene.remove(zoneMesh);zoneMesh=null;}
  S.bots=[];S.targets=[];S.loot=[];S.fx=[];S.decals=[];S.floats=[];S.ents=[];S.byId={};S.zone=null;S.round=null;S.spec=null;
  if(player.body){scene.remove(player.body.g);player.body=null;}player.tp=false;player.ads=false;
  setScoped(false);
  $('killfeed').innerHTML='';['buy','pause','end','scoreboard'].forEach(id=>$(id).classList.add('hidden'));
}
function startMatch(mode,opts={}){try{CHM.play(null);}catch(e){}
  const duel=mode==='duel';if(duel)mode='ffa';
  initAudio();cleanupMatch();scene.remove(operator.g);botSeq=0;resetFun();
  const net=opts.net||null;
  bloodClear();Object.assign(S,{mode,time:0,flashEnd:0,ended:false,paused:false,uiOpen:false,buyOpen:false,teamScore:{A:0,B:0},score:0,tHits:0,countdown:mode==='defuse'?0:3.99,cdShown:0,respawns:mode==='tdm'||mode==='ffa',endT:0,place:0,tSpawnT:0,simClock:performance.now(),netT:0,crates:[],nearCrate:null,rearm:0});
  anReset();S.duel=duel;S.fmt=(mode==='tdm'&&fmtParse(opts.fmt))||null;S.ranked=(opts.ranked===mode&&(mode==='br'||mode==='tdm'))?mode:null;S.rankedDone=0;S.rankDiff=S.ranked&&net!=='client'?rkDiff(S.ranked):null;S.tdmGoal=fmtGoal(S.fmt);S.endReason=null;S._endSnd=0;S.ffaGoal=duel?10:20;_lbT=0;_lbKey='';{const lb=$('lb');if(lb)lb.innerHTML='';}
  // ---- seeded build: identical map (and BR loot) for everyone in the room ----
  rng=mulberry32(opts.seed!==undefined?opts.seed:(Math.random()*1e9)|0);
  {lobbyLight(false);LOBBY.dust=null;LOBBY.squad=[];LOBBY.shafts=[];LOBBY.ring=null;LOBBY.pad=null;const mi=Math.floor(rng()*MAP_IDS.length);applyTheme(mode==='practice'?'dust2':(opts.map&&MAPS[opts.map]?opts.map:MAP_IDS[mi]));S.mapId=THEME_ID;showMapName();}
  if(mode==='practice'){buildPractice();scene.fog.near=40;scene.fog.far=170;}
  else if(mode==='br'){buildIsland(BR_H);scene.fog.near=90;scene.fog.far=520;}
  else if(mode==='defuse'){buildDefuse();scene.fog.near=45;scene.fog.far=160;}
  else if(smallArenaH()){const H=smallArenaH();spawns.A.set(0,0,H-4);spawns.B.set(0,0,-(H-4));buildArena(H,Math.round(H/3.2),Math.round(H*1.1),{trees:2,lowWalls:Math.round(H/3),keep:[[0,H-4,6],[0,-(H-4),6]],ladderChance:0.2});scene.fog.near=40;scene.fog.far=150;}
  else{spawns.A.set(0,0,43);spawns.B.set(0,0,-43);buildClassic(50);scene.fog.near=45;scene.fog.far=160;}
  tacticalProps(mode,mapH);try{mapDetail(mode);}catch(e){console.error(e);}if(NAV)navBuild(NAV_CL);
  {const d=typeof propDetail==='function'?propDetail():'high';if(d!=='high'){let i=0;for(const o of world.children.slice()){if(o.userData.clutter&&(d==='low'||(i++%2===0))){world.remove(o);const j=worldMeshes.indexOf(o);if(j>=0)worldMeshes.splice(j,1);}}}}
  mergeWorld();
  if(mode==='br'){const HS=S.houseSpots||[];for(const h of HS)spawnLoot(pick(LOOT_TABLE),new V3(h[0],h[1],h[2]));for(let i=0;i<Math.max(90,260-HS.length);i++)spawnLoot(pick(LOOT_TABLE),openPoint(0,0,mapH-4,0));}
  rng=Math.random;
  const p=player;
  let myTeam=mode==='defuse'?save.side:(mode==='tdm'||mode==='practice')?'A':'P';
  if(net==='host'){const me=NET.roster.find(r=>r.id==='h');if(me&&me.team)myTeam=me.team;}
  if(net==='client')myTeam=opts.team||('P'+NET.myId);
  if(mode==='ffa'||mode==='br')myTeam='P'+(net==='client'?NET.myId:'h');
  Object.assign(p,{id:net==='client'?NET.myId:'h',hp:100,armor:0,meds:mode==='br'?0:1,healT:0,healDone:false,alive:true,onGround:true,onLadder:false,crouch:0,kills:0,deaths:0,heads:0,shots:0,hits:0,cool:0,reloading:false,switchT:0,sprayIdx:0,punchP:0,punchY:0,pitch:0,respawnT:0,deadT:0,nades:[],kit:false,hasBomb:false,planting:0,defusing:0,scoped:false,rescope:false,score:0,place:0,team:myTeam});
  p.vel.set(0,0,0);p.pos.y=0;p.money=mode==='practice'?16000:mode==='br'?0:mode==='defuse'?800:1000;
  p.inv={1:null,2:null,3:{id:knifeId()},4:null,5:null};p.slot=3;
  const startPistol=mode==='defuse'?startPistolFor(myTeam):'glock';giveWeapon(startPistol,mode==='br'?WEAPONS[startPistol].mag:undefined);if(mode==='tdm'||mode==='ffa'||mode==='practice')giveWeapon(spawnPrimaryId());S.mode=mode;giveStarterNades(p);p.switchT=0;
  S.ents=[p];S.byId={};S.byId[p.id]=p;
  if(p.body)scene.remove(p.body.g);p.body=makeSoldier(mode==='defuse'?(myTeam==='CT'?0x3b82f6:0xe8892b):0xb08a3e,agentPal(save.agent));p.body.g.visible=false;scene.add(p.body.g);p.ads=false;p.sprinting=false;p.stamina=1;p.exhausted=false;
  NET.inGame=!!net;
  if(net!=='client'){
    const names=NAMES.slice().sort(()=>Math.random()-0.5);let ni=0;
    const humans=net==='host'?NET.roster.filter(r=>r.id!=='h'):[];
    const accentFor=t=>mode==='defuse'?(t==='CT'?0x3b82f6:0xe8892b):mode==='tdm'?(t==='A'?0x3b82f6:0xef4444):0xef4444;
    for(const r of humans){const t=(mode==='ffa'||mode==='br')?'P'+r.id:(mode==='practice'?'A':r.team);spawnNetPlayer(Object.assign({},r,{team:t}),accentFor(t));}
    const fill=!net||NET.fill;
    if(mode==='tdm'||mode==='defuse'){const T=MODES[mode].teams;for(const tm of T){const have=S.ents.filter(e=>e.team===tm).length;const cap=S.fmt&&mode==='tdm'?(tm==='A'?S.fmt[0]:S.fmt[1]):5;const n=fill?Math.max(0,cap-have):0;for(let i=0;i<n;i++)spawnBot(names[ni++%names.length],tm,accentFor(tm),mode==='defuse'?'glock':randBotGun());}}
    else if(mode==='ffa'){const n=fill?Math.max(0,(S.duel?2:8)-S.ents.length):0;for(let i=0;i<n;i++)spawnBot(names[ni++%names.length],'T'+i,0xef4444,randBotGun());}
    else if(mode==='br'){S.brN=BR_MIN+Math.floor(Math.random()*(BR_MAX-BR_MIN+1));const n=fill?Math.max(0,S.brN-S.ents.length):0;for(let i=0;i<n;i++)spawnBot(names[i%names.length]+(i>=names.length?String(1+Math.floor(i/names.length)):''),'T'+i,new THREE.Color().setHSL(Math.random(),0.7,0.5).getHex(),Math.random()<0.5?'deagle':'glock');setupZone();}
    if(S.bots.some(b=>!b.isNet))for(const b of S.bots)if(!b.isNet)b.money=mode==='defuse'?800:1000;
    placeEnt(p);p.spawnTime=0;
    if(net==='host'){netBroadcast({t:'ents',list:entList()});for(const b of S.bots)if(b.isNet)netSend(b.id,{t:'tp',x:b.pos.x,z:b.pos.z,yaw:b.yaw+Math.PI});}
  }else{
    if(mode==='br')setupZone();
    placeEnt(p);p.spawnTime=0;
  }
  if(TOUCH.on){try{const de=document.documentElement;if(!document.fullscreenElement&&de.requestFullscreen)de.requestFullscreen().then(()=>{try{screen.orientation&&screen.orientation.lock&&screen.orientation.lock('landscape').catch(()=>{});}catch(e){}}).catch(()=>{});}catch(e){}}
  if(mode==='br')brStart();
  try{applyFilter();applyContrast();applyDynShadows();for(const e of S.ents)e.aoBlob=null;if(vid().display==='fullscreen')applyFullscreen();}catch(e){}
  S.timeLeft=mode==='practice'?60:300;
  camera.fov=save.fov;camera.updateProjectionMatrix();camera.rotation.z=0;
  buildVM();try{agHud();agDeployMsg();}catch(e){}
  $('menu').classList.add('hidden');$('lobby').classList.add('hidden');$('hud').classList.remove('hidden');
  $('minimap').style.display=mode==='practice'?'none':'';
  const L={tdm:['BLUE','TIME','RED'],ffa:['YOU','TIME','LEADER'],br:['ALIVE','ZONE','KILLS'],practice:['SCORE','TIME',net?'RANK':'ACCURACY'],defuse:['CT · DEF','ROUND','T · ATK']}[mode];
  $('lA').textContent=L[0];$('lT').textContent=L[1];$('lB').textContent=L[2];
  $('tB').style.color=mode==='defuse'?'#ffb35c':'';
  $('eAgain').textContent=net?(net==='host'?'Back to lobby':'Waiting for host…'):'Play again';$('eAgain').disabled=net==='client';
  $('pauseSub').textContent=net?'Online match keeps running while you are here':'Match is frozen';
  try{const p=player;$('pzMode').innerHTML=`<b>${MODES[S.mode]?MODES[S.mode].name:''}</b><span>${THEME&&THEME.n||''}</span>`;const acc=p.shots?Math.round(p.hits/p.shots*100):0;
    $('pzStats').innerHTML=[['Kills',p.kills],['Deaths',p.deaths],['Headshots',p.heads||0],['Accuracy',acc+'%']].map(([k,v])=>`<div><b>${v}</b><span>${k}</span></div>`).join('');}catch(e){}
  S.state='game';if(S.lockBlocked){S.noLock=true;setTimeout(showLockNote,600);}
  if(mode==='defuse'){setupDefuse();if(net!=='client')startRound();}
  lockPointer();
}
function finish(win,outcome){
  if(S.ended||(FUN.pendingFinish&&!FUN.flush))return;
  if(!NET.role&&!FUN.flush&&S.mode!=='practice'&&S.time-FUN.multiT<0.05){FUN.pendingFinish=[win,outcome];FUN.slowmo=1.4;center('<span style="color:var(--acc2)">FINAL KILL</span>',1.4);return;}
  S.ended=true;S.uiOpen=true;mouse.down=false;setScoped(false);
  if(document.pointerLockElement)document.exitPointerLock();
  if(NET.role==='host'){outcome=matchOutcome();netBroadcast({t:'end',o:outcome});NET.inGame=false;}
  const p=player,acc=p.shots?Math.round(p.hits/p.shots*100):0;
  let title,sub='',stats=[],coins=p.kills*10;
  const xpLines=[];let roundsWon=0,rank=null;
  if(S.mode==='practice'){title='TIME!';const best=Math.max(save.bestPractice,S.score);sub=S.score>save.bestPractice?'New personal best!':'Best: '+save.bestPractice;save.bestPractice=best;coins+=Math.floor(S.score/40);
    stats=[['SCORE',S.score],['TARGETS',S.tHits],['ACCURACY',acc+'%'],['SHOTS',p.shots]];
    if(outcome&&outcome.scores){const arr=Object.entries(outcome.scores).sort((a,b)=>b[1]-a[1]);rank=arr.findIndex(x=>x[0]===p.id)+1;stats.unshift(['RANK','#'+rank+'/'+arr.length]);title=rank===1?'TOP SCORE':'TIME!';win=rank===1;}}
  else if(S.mode==='tdm'){title=win?'VICTORY':'DEFEAT';sub=`Blue ${S.teamScore.A} — ${S.teamScore.B} Red`;stats=[['KILLS',p.kills],['DEATHS',p.deaths],['ACCURACY',acc+'%']];}
  else if(S.mode==='defuse'){const R=S.round,ot=p.team==='T'?'CT':'T';roundsWon=R.wins[p.team]||0;title=win?'VICTORY':'DEFEAT';sub=`CT ${R.wins.CT} — ${R.wins.T} T · you played ${p.team==='T'?'Attack':'Defense'}`;coins+=roundsWon*10;stats=[['ROUNDS',roundsWon+'–'+(R.wins[ot]||0)],['KILLS',p.kills],['DEATHS',p.deaths],['ACCURACY',acc+'%']];}
  else if(S.mode==='ffa'){rank=outcome&&outcome.ranks?outcome.ranks[p.id]:S.ents.slice().sort((a,b)=>b.kills-a.kills).indexOf(p)+1;const w=outcome?entById(outcome.winnerId):S.ents.reduce((a,b)=>b.kills>a.kills?b:a);title=win?'VICTORY':(S.duel?'DEFEAT':'#'+rank+' PLACE');sub=S.duel?(()=>{const o=S.ents.find(x=>x!==p);return `1v1 · You ${p.kills} — ${o?o.kills:0} ${o?o.name:''}`;})():(S.endReason==='kills'?(win?'You reached '+(S.ffaGoal||20)+' kills first':(w?w.name:'?')+' reached '+(S.ffaGoal||20)+' kills first'):S.endReason==='time'?("Time's up · "+(win?'you had the most kills':(w?w.name:'?')+' had the most kills')):(win?'You topped the leaderboard':'Winner: '+(w?w.name:'?')));stats=[['KILLS',p.kills],['DEATHS',p.deaths],['RANK','#'+rank],['ACCURACY',acc+'%']];}
  else{const place=win?1:(outcome&&outcome.places?outcome.places[p.id]:(S.place||p.place));const total=S.ents.length;title=win?'BOOYAH!':'ELIMINATED';sub=win?`You outlasted ${total-1} operators`:'Placed #'+place+' of '+total;stats=[['PLACE','#'+place],['KILLS',p.kills],['ACCURACY',acc+'%']];rank=place;}
  coins+=win?100:25;
  // ---- XP ----
  const kXP=p.kills*100,hXP=(p.heads||0)*25,wXP=win?600:200,pXP=150;
  xpLines.push(['Kills ×'+p.kills,kXP]);if(p.heads)xpLines.push(['Headshots ×'+p.heads,hXP]);
  if(S.mode==='defuse')xpLines.push(['Rounds won ×'+roundsWon,roundsWon*150]);
  if(S.mode==='practice')xpLines.push(['Range score',Math.floor(S.score/2)]);
  if(S.mode==='br'&&rank)xpLines.push(['Placement #'+rank,Math.max(0,(36-rank)*17)]);
  if(FUN.medals.length)xpLines.push(['Medals ×'+FUN.medals.length,FUN.medals.length*50]);
  xpLines.push([win?'Victory':'Match played',wXP],['Participation',pXP]);
  let total=xpLines.reduce((s,x)=>s+x[1],0);
  let STK=null;if(S.mode!=='practice'){STK=streakUpdate(win);if(STK.xpPct){const b=Math.round(total*STK.xpPct);xpLines.push(['🔥 Win streak '+STK.level+' bonus +'+Math.round(STK.xpPct*100)+'%',b]);total+=b;}if(STK.coins)coins+=STK.coins;}
  if(agSig().bounty&&S.mode!=='practice'){const b=Math.round(total*0.1);xpLines.push(['$ Bounty Hunter +10%',b]);total+=b;coins=Math.round(coins*1.25);}
  if((save.xpBoostM|0)>0&&S.mode!=='practice'){const b=total;xpLines.push(['⚡ Daily XP boost 2× ('+(save.xpBoostM-1)+' left)',b]);total+=b;save.xpBoostM--;}
  if(NET.role){const bonus=Math.round(total*0.25);xpLines.push(['Multiplayer bonus +25%',bonus]);total+=bonus;}
  const beforeLevel=save.level;let rkHtml='';try{rkHtml=rkFinish(win,rank);}catch(e){console.error(e);}
  const ups=addXP(total);
  save.coins+=coins;save.matches++;save.kills+=p.kills;if(win&&S.mode!=='practice')save.wins++;try{anRecord(win,rank);}catch(e){}persist();
  stats.push(['COINS','+'+coins]);
  $('endMode').textContent=(S.ranked?'RANKED · ':'')+MODES[S.mode].name.toUpperCase()+(NET.role?' · ONLINE':'');
  const et=$('endT');et.textContent=title;et.className='endt '+(win?'win':/PLACE/.test(title)?'mid':'lose');{const outcomeSnd=win?'win':'lose';if(!S._endSnd){S._endSnd=1;setTimeout(()=>{try{initAudio();sfx(outcomeSnd,1.1);}catch(e){}},250);}}
  $('endSub').textContent=sub;
  try{streakEnd(typeof STK!=='undefined'?STK:null);}catch(e){}
  $('endStats').innerHTML=stats.map(([k,v])=>`<div><b>${v}</b><span>${k.charAt(0)+k.slice(1).toLowerCase()}</span></div>`).join('');
  const need=xpToNext(save.level);
  let xh=rkHtml+xpLines.map(([k,v])=>`<div class="xl"><span>${k}</span><b>+${v} XP</b></div>`).join('')+`<div class="xl" style="border-top:1px solid var(--line);margin-top:4px;padding-top:4px"><span>Total</span><b style="color:var(--acc2)">+${total} XP</b></div>`;
  xh+=`<div class="lv">${badgeSvg(save.level,30)}<div style="flex:1"><b>Level ${save.level}</b>${save.level>=MAX_LEVEL?' (max)':''}<div class="xpbar"><i style="width:${save.level>=MAX_LEVEL?100:(save.xp/need*100).toFixed(1)}%"></i></div></div><span style="font-size:12px;color:var(--dim)">${save.level>=MAX_LEVEL?'MAX':save.xp+' / '+need}</span></div>`;
  if(ups>0)xh+=`<div class="up">▲ LEVEL UP! ${beforeLevel} → ${save.level}${beforeLevel<RANK_UNLOCK&&save.level>=RANK_UNLOCK?' · RANKED UNLOCKED!':''}</div>`;
  $('endXP').innerHTML=xh;
  $('buy').classList.add('hidden');$('pause').classList.add('hidden');$('end').classList.remove('hidden');
  if(ups>0)setTimeout(()=>{try{sfx('levelup');}catch(e){}},win?2500:3000);
}
function timeUp(){
  if(NET.role==='client')return;
  if(S.mode==='practice')finish(true);
  else if(S.mode==='tdm')finish(S.teamScore[player.team]>S.teamScore[player.team==='A'?'B':'A']);
  else if(S.mode==='ffa'){S.endReason='time';const lead=S.ents.reduce((a,b)=>b.kills>a.kills?b:a);finish(lead===player);}
}
function toMenu(keepNet){try{rkAbandon();}catch(e){}try{CHM.play('lobby');}catch(e){}
  cleanupMatch();S.state='menu';S.uiOpen=false;S.paused=false;S.ended=false;
  if(!keepNet)netLeave(true);
  if(document.pointerLockElement)document.exitPointerLock();
  buildMenuStreet();scene.add(operator.g);operator.g.position.set(0,0,0);
  camera.fov=42;camera.updateProjectionMatrix();camera.rotation.z=0;
  $('hud').classList.add('hidden');$('menu').classList.remove('hidden');renderMenu();showTab('home');
}

/* ================= INPUT ================= */
function lockPointer(force){if((S.noLock&&!force)||document.pointerLockElement===canvas)return;if(performance.now()-(S.lockReqAt||0)<250)return;S.lockReqAt=performance.now();
  const plain=()=>{try{const r2=canvas.requestPointerLock();if(r2&&r2.catch)r2.catch(()=>{});}catch(e){}};
  if(S.noUnadj){plain();return;}
  try{const r=canvas.requestPointerLock({unadjustedMovement:true});if(r&&r.catch)r.catch(err=>{if(err&&err.name==='NotSupportedError')S.noUnadj=true;plain();});else if(!r&&document.pointerLockElement!==canvas)plain();}catch(e){S.noUnadj=true;plain();}}
document.addEventListener('pointerlockerror',()=>{S.lockErr=(S.lockErr||0)+1;if(S.lockErr>=2&&!S.locked)enterFreeLook();});
/* Some viewers (embedded previews / sandboxed frames) refuse pointer lock entirely.
   Free-look keeps 360° mouse aim with a hidden cursor and turns the view when the cursor reaches an edge. */
function enterFreeLook(){if(S.lockBlocked)return;S.lockBlocked=true;S.noLock=true;showLockNote();}
function showLockNote(){}
if(typeof canvas.requestPointerLock!=='function')setTimeout(enterFreeLook,0);
document.addEventListener('pointerlockchange',()=>{S.locked=document.pointerLockElement===canvas;if(!S.locked)S.unlockAt=performance.now();else S.lostAt=0;if(S.locked){S.noLock=false;S.lockErr=0;S.lockBlocked=false;clearTimeout(S.lockT);S.lmx=S.lmy=0;}if(!S.locked&&S.state==='game'&&!S.uiOpen&&!S.ended&&!(typeof GP!=='undefined'&&GP.active))openPause();});
function openPause(byUser){S.pausedByUser=!!byUser;S.paused=!NET.role;S.uiOpen=true;mouse.down=false;setScoped(false);$('pause').classList.remove('hidden');}
function closePause(){S.paused=false;S.uiOpen=false;$('pause').classList.add('hidden');S.simClock=performance.now();lockPointer();}
$('pResume').onclick=closePause;$('pLeave').onclick=()=>toMenu();$('pSet').onclick=()=>openSettings();
$('eAgain').onclick=()=>{if(NET.role==='host'){toMenu(true);NET.inGame=false;showLobby('Pick teams and start the next match.');hostLobbyUpdate();}else if(!NET.role)startMatch(S.duel?'duel':S.mode,{fmt:S.fmt?S.fmt.join('v'):null});};
$('eMenu').onclick=()=>toMenu();
const wantLock=()=>S.state==='game'&&!S.uiOpen&&!S.ended&&!S.locked&&!S.noLock&&!document.pointerLockElement;
document.addEventListener('keydown',e=>{if(e.code!=='Escape'&&wantLock()&&performance.now()-(S.unlockAt||0)>1100){initAudio();lockPointer(true);}},true);
document.addEventListener('mousedown',e=>{if(wantLock()&&!(e.target.closest&&e.target.closest('.modal,button,input,select'))){initAudio();lockPointer(true);}},true);
document.addEventListener('pointerup',e=>{if(wantLock()&&!(e.target.closest&&e.target.closest('.modal,button,input,select')))lockPointer(true);},true);
$('click').addEventListener('mousedown',e=>{e.preventDefault();e.stopPropagation();if(S.state==='game'&&!S.uiOpen){initAudio();lockPointer(true);}});
canvas.addEventListener('mousedown',e=>{
  if(S.state!=='game'||S.uiOpen)return;initAudio();
  if(!S.locked&&!S.noLock){lockPointer(true);return;}
  if(e.button===2&&isKatana(curW().id)&&player.alive){if(!player.blockBroken){player.blocking=true;player.blockStart=S.time;player.sprinting=false;}return;}
  if(e.button===2){const w=curW();if(!w.zoom&&!w.melee&&!w.nade&&!w.taser&&player.alive){player.ads=true;player.sprinting=false;return;}if(w.zoom&&player.alive&&!player.reloading){setScoped(!player.scoped);player.rescope=false;if(!playHZ(player.scoped?'gp:awp/zoom':'gp:awp/awp_zoom_out',0.6))sfx('scope');}return;}
  if(e.button!==0)return;
  if(!player.alive&&S.spec!==undefined&&(S.mode==='defuse'||S.mode==='br')){const al=S.ents.filter(x=>x.alive&&x!==player);if(al.length){const i=al.indexOf(S.spec);S.spec=al[(i+1)%al.length];}return;}
  mouse.down=true;
  tryFire();
});
addEventListener('mouseup',e=>{if(e.button===0)mouse.down=false;if(e.button===2){player.ads=false;player.blocking=false;}});
canvas.addEventListener('contextmenu',e=>e.preventDefault());
let menuMX=0;
document.addEventListener('mouseleave',()=>{S.mIn=false;});
addEventListener('mousemove',e=>{
  S.mx=e.clientX;S.my=e.clientY;S.mIn=true;
  if(S.state==='menu'){menuMX=(e.clientX/innerWidth-0.5)*2;return;}
  if(S.state!=='game'||S.uiOpen||!player.alive)return;
  if(!S.locked&&!S.noLock)return;
  let mx=e.movementX||0,my=e.movementY||0;
  if((Math.abs(mx)>500&&Math.abs(S.lmx||0)<80)||(Math.abs(my)>500&&Math.abs(S.lmy||0)<80)){S.lmx=S.lmy=0;return;}
  S.lmx=mx;S.lmy=my;
  const k=0.0022*save.sens*(camera.fov/80)*aaFriction();AA.act=0.3;
  player.yaw-=mx*k;player.pitch=clamp(player.pitch-my*k,-1.55,1.55);
  applyCamRot();
  vm.mdx+=e.movementX;vm.mdy+=e.movementY;
});
addEventListener('wheel',e=>{if(S.state!=='game'||S.uiOpen)return;const order=[1,2,3,4,5].filter(s=>player.inv[s]);let i=order.indexOf(player.slot);i=(i+(e.deltaY>0?1:-1)+order.length)%order.length;switchSlot(order[i]);},{passive:true});
addEventListener('keydown',e=>{
  const now=performance.now();
  if(e.target&&e.target.tagName==='INPUT')return;
  if(S.state!=='game'){keys[e.code]=true;return;}
  if(['Space','Tab','KeyB','ControlLeft','AltLeft','AltRight'].includes(e.code)||e.code.startsWith('Arrow'))e.preventDefault();
  keys[e.code]=true;klDown(e.code,now);
  if(e.code==='Tab'){renderScoreboard();$('scoreboard').classList.remove('hidden');return;}
  if(S.ended)return;
  if(S.buyOpen){if(e.code==='KeyB'||e.code==='Escape')closeBuy();return;}
  if(S.uiOpen){if(e.code==='Escape'&&S.noLock)closePause();return;}
  if(e.code==='Escape'&&S.noLock){openPause(true);return;}
  if(e.code==='Space'&&!e.repeat)player.jumpQ=S.time;
  if(e.repeat)return;
  if(e.code==='KeyV'){player.tp=!player.tp;if(player.tp&&player.scoped)setScoped(false);sfx('click');center(player.tp?'Third-person view':'First-person view',0.8);return;}
  if(e.code==='KeyB')openBuy();
  else if(e.code==='Digit1')switchSlot(1);else if(e.code==='Digit2')switchSlot(2);else if(e.code==='Digit3')switchSlot(3);
  else if(e.code==='Digit4'){if(player.slot===4&&player.nades.length>1){player.nades.push(player.nades.shift());refreshNades();sfx('click');}else switchSlot(4);}
  else if(e.code==='Digit5')switchSlot(5);
  else if(e.code==='Digit6')startHeal();
  else if(e.code==='KeyF'){const R=curReal();if(R&&!player.reloading&&R.anim.play('inspect')){}else{vm.inspect=1.4;sfx('inspect');}}
  else if(e.code==='KeyQ')player.slideQ=S.time;
  else if(e.code==='Backquote')switchSlot(player.prevSlot);
  else if(e.code==='KeyR'){if(!(manualOn()&&manualReloadPress()))startReload();}
  else if(e.code==='KeyE'&&S.nearLoot)pickup(S.nearLoot);
  else if(e.code==='KeyE'&&S.nearAir)airOpen(S.nearAir);
  else if(e.code==='KeyH')startHeal();
});
addEventListener('keyup',e=>{keys[e.code]=false;klUp(e.code,performance.now());if(e.code==='Tab')$('scoreboard').classList.add('hidden');});
addEventListener('blur',()=>{const now=performance.now();for(const k in keys){keys[k]=false;klUp(k,now);}mouse.down=false;});

/* ================= HUD ================= */
const _tc=new Map();function setT(el,v){v=String(v);if(_tc.get(el)!==v){_tc.set(el,v);el.textContent=v;}}
const H={hp:$('hp'),arm:$('arm'),hpB:$('hpB').firstElementChild,armB:$('armB').firstElementChild,wname:$('wname'),ammo:$('ammo'),res:$('res'),slots:$('slots'),money:$('money'),buyhint:$('buyhint'),vA:$('vA'),vB:$('vB'),vT:$('vT'),tT:$('tT'),info:$('info'),xh:$('xh'),prompt:$('prompt'),click:$('click'),act:$('act'),actT:$('actT'),actB:$('actB'),spec:$('spec'),bombic:$('bombic'),speed:$('speed'),netb:$('netb')};
function practiceRank(){const sc=S.ents.filter(e=>e.isPlayer||e.human).map(e=>e.isPlayer?S.score:e.score).sort((a,b)=>b-a);return (sc.indexOf(S.score)+1)+'/'+sc.length;}
function updateHUD(){
  const p=player,ws=p.inv[p.slot],w=curW();
  setT(H.hp,Math.ceil(Math.max(0,p.hp)));setT(H.arm,Math.ceil(p.armor));
  {const hp=Math.max(0,Math.min(100,p.hp)),ar=Math.max(0,Math.min(100,p.armor));if(H._hp!==hp){H.hpB.style.width=hp+'%';H.hpB.nextElementSibling.style.width=hp+'%';if(H._hp!==undefined&&hp<H._hp){const v=$('vit');v.classList.remove('hurt');void v.offsetWidth;v.classList.add('hurt');clearTimeout(H._hurtT);H._hurtT=setTimeout(()=>v.classList.remove('hurt'),260);}$('vit').classList.toggle('low',hp>0&&hp<=25);H._hp=hp;}
   if(H._ar!==ar){H.armB.style.width=ar+'%';H.armB.nextElementSibling.style.width=ar+'%';H.armB.closest('.vb').classList.toggle('zero',ar<=0);H._ar=ar;}}
  setT(H.wname,w.name.toUpperCase());
  setT(H.ammo,w.nade?'×'+p.nades.filter(n=>n===w.id).length:w.melee?'—':(p.reloading&&!w.shell?'…':ws.ammo));
  setT(H.res,w.nade||w.melee?'':(S.mode==='practice'?'/ ∞':'/ '+ws.reserve));
  {const mag=w.mag||0,am=ws&&!w.nade&&!w.melee?ws.ammo:0,low=mag&&am<=Math.max(1,Math.ceil(mag*0.25));H.ammo.classList.toggle('low',!!low&&am>0);H.ammo.classList.toggle('empty',!!mag&&am===0&&!w.nade&&!w.melee);
   const mb=$('magBar'),key=mag+'|'+am;if(mb._k!==key){mb._k=key;const n=Math.min(mag,40);mb.innerHTML=mag&&!w.nade&&!w.melee?Array.from({length:n},(_,i)=>`<i class="${i>=Math.round(am/mag*n)?'u':''}"></i>`).join(''):'';mb.classList.toggle('low',!!low);}}
  {const T=S.mode==='defuse'?['CT','T']:S.mode==='tdm'?['A','B']:null;const pa=$('pipsA'),pb=$('pipsB');const key=T?S.ents.map(e=>e.team+(e.alive?1:0)+(e.hasBomb?'b':'')).join(''):'';
   if(pa._k!==key){pa._k=key;const row=t=>S.ents.filter(e=>e.team===t).sort((a,b)=>(b.alive-a.alive)).map(e=>`<i class="${e.alive?'':'dead'} ${e===p?'me':''} ${e.hasBomb&&e.alive?'bomb':''}" title="${esc(e.name||'You')}"></i>`).join('');pa.innerHTML=T?row(T[0]):'';pb.innerHTML=T?row(T[1]):'';}}
  const sl=[1,2,3,4,5].filter(s=>p.inv[s]).map(s=>s===p.slot?`<b>${s}</b>`:s).join(' · ')+(p.kit?' · KIT':'');if(H.slots._v!==sl){H.slots._v=sl;H.slots.innerHTML=sl;}
  renderHotbar();renderLeaderboard();
  {const fo=$('flashO');const rem=(S.flashEnd||0)-S.time;const v=rem>0&&p.alive?Math.min(1,rem/1.3):0;if(fo._v!==v){fo._v=v;fo.style.opacity=v;}}
  setT(H.money,S.mode==='br'?'':S.mode==='practice'?'$∞':'$'+p.money);
  setT(H.buyhint,(S.mode!=='br'&&buyAllowed()&&!S.uiOpen)?'[B] BUY':'');
  H.tT.classList.toggle('bomb',S.mode==='defuse'&&!!S.round&&S.round.phase==='planted');
  if(S.mode==='tdm'){setT(H.vA,S.teamScore.A);setT(H.vB,S.teamScore.B);setT(H.vT,fmtTime(S.timeLeft));}
  else if(S.mode==='ffa'){setT(H.vA,p.kills);setT(H.vB,Math.max(...S.ents.map(b=>b.kills),0));setT(H.vT,fmtTime(S.timeLeft));}
  else if(S.mode==='br'){{const el=$('brInv'),tx=`<span>✚ <kbd>H</kbd> Medkit ×${p.meds||0}</span>${S.nearAir?'<span class="air"><kbd>E</kbd> open airdrop</span>':''}`;if(el._t!==tx){el._t=tx;el.innerHTML=tx;}}setT(H.vA,S.ents.filter(e=>e.alive).length);setT(H.vB,p.kills);const z=S.zone;setT(H.vT,!z?'—':z.state==='wait'?fmtTime(z.t):z.state==='shrink'?'⇣ '+fmtTime(z.t):'—');}
  else if(S.mode==='defuse'){const R=S.round;if(R){setT(H.vA,R.wins.CT);setT(H.vB,R.wins.T);setT(H.vT,R.phase==='planted'?'✸ '+fmtTime(R.t):fmtTime(R.t));}}
  else{setT(H.vA,S.score);setT(H.vB,NET.role?practiceRank():(p.shots?Math.round(p.hits/p.shots*100):0)+'%');setT(H.vT,fmtTime(S.timeLeft));}
  let info='',bad=false;
  if(S.mode==='br'&&S.zone&&p.alive){const z=S.zone,d=Math.hypot(p.pos.x-z.x,p.pos.z-z.z);if(d>z.r){info='OUTSIDE THE ZONE — '+Math.round(d-z.r)+' m to safety';bad=true;}else info=z.state==='shrink'?'Zone closing':(z.state==='wait'?'Zone shrinks in '+fmtTime(z.t):'Final zone');}
  else if(S.mode==='defuse'&&S.round){const R=S.round,aC=S.ents.filter(e=>e.alive&&e.team==='CT').length,aT=S.ents.filter(e=>e.alive&&e.team==='T').length;
    const ph={freeze:'BUY PHASE',live:'ROUND '+R.n,planted:'BOMB PLANTED — SITE '+R.bomb.site,post:'ROUND OVER'}[R.phase];info=`${ph} · CT alive ${aC} · T alive ${aT} · first to ${ROUND.toWin}`;bad=R.phase==='planted';}
  else if(S.mode==='practice'&&S.countdown<=0)info='Bullseye 100 · Inner 50 · Outer 25';
  else if(S.mode==='tdm')info=(S.fmt?S.fmt.join('v')+' · ':'')+'First to '+(S.tdmGoal||40);else if(S.mode==='ffa')info=S.duel?'1v1 · First to 10':'First to 20';
  setT(H.info,info);H.info.className=bad?'bad':'';
  setT(H.netb,NET.role?`ONLINE · ROOM ${NET.code} · ${S.ents.filter(e=>e.isPlayer||e.human).length} players`:'');
  const gap=clamp(4+inaccuracy()*300,4,46);H.xh.style.setProperty('--gap',gap+'px');H.xh.style.display=(p.alive&&!w.melee&&!w.nade&&!p.scoped)?'':'none';H.xh.classList.toggle('ads',(vm.adsK||0)>0.5);
  {const st=$('stam');const v=p.stamina===undefined?1:p.stamina;st.classList.toggle('show',p.alive&&v<0.99);st.firstElementChild.style.width=(v*100)+'%';st.classList.toggle('ex',!!p.exhausted);}
  if(p.alive&&w.inacc){const wsp=wSpeed(w),sp=Math.hypot(p.vel.x,p.vel.z),ok=sp<=wsp*0.34&&p.onGround&&!p.onLadder,wc=wClass(w);const v=`${wc?`<span class="wcls ${wc.toLowerCase()}">${wc}</span> · `:''}${p.sprinting?'<b>SPRINT</b> · ':''}${p.ads&&!w.zoom?'<b class="ok">ADS</b> · ':''}SPEED <b class="${ok?'ok':''}">${Math.round(sp/wsp*100)}%</b> ${ok?'· ACCURATE':''}${w.zoom&&!p.scoped?' · RMB to scope':''}`;if(H.speed._v!==v){H.speed._v=v;H.speed.innerHTML=v;}}else setT(H.speed,'');
  let pr='';
  if(S.nearLoot&&!S.uiOpen)pr='[E] Pick up '+lootLabel(S.nearLoot.type);
  if(S.mode==='defuse'&&S.round&&p.alive&&!S.uiOpen){const R=S.round,bomb=R.bomb;
    if(p.hasBomb&&R.phase==='live'&&siteAt(p.pos)&&p.planting<=0)pr='Hold [E] to plant the bomb';
    if(p.team==='CT'&&R.phase==='planted'&&bomb.state==='planted'&&p.pos.distanceTo(bomb.pos)<1.8&&p.defusing<=0)pr='Hold [E] to defuse'+(p.kit?' (kit: 5 s)':' (10 s)');}
  if(pr){H.prompt.classList.remove('hidden');setT(H.prompt,gpKeys(pr));}else H.prompt.classList.add('hidden');
  if(p.planting>0||p.defusing>0){H.act.classList.remove('hidden');const plant=p.planting>0,tot=plant?ROUND.plant:(p.kit?ROUND.kit:ROUND.defuse),cur=plant?p.planting:p.defusing;if(plant){const dg=Math.min(7,Math.floor(cur/tot*8));if(dg!==p._pd){if(dg>(p._pd||0))sfx('click',0.7);p._pd=dg;}setT(H.actT,gpKeys('ARMING C4  '+'✱'.repeat(dg)+'·'.repeat(7-dg)+'  — keep holding E'));}else{p._pd=0;setT(H.actT,gpKeys('DEFUSING — keep holding E'));}H.actB.style.width=(cur/tot*100)+'%';}else if(p.healT>0&&!p.healDone){H.act.classList.remove('hidden');setT(H.actT,'HEALING');H.actB.style.width=Math.min(100,(MED_T-p.healT)/MED_COMMIT*100)+'%';}else if(S.nearCrate&&p.alive){H.act.classList.remove('hidden');const cd=(S.nearCrate.cd[p.id]||0)-S.time;setT(H.actT,cd>0?'AMMO CRATE — restocked, ready in '+Math.ceil(cd)+'s':S.rearm>0?'RESTOCKING — keep holding E':gpKeys('HOLD E — restock ammo & armor'));H.actB.style.width=(cd>0?0:(S.rearm||0)/1.4*100)+'%';}else H.act.classList.add('hidden');
  {const el=$('mrHint'),t=mrHint();if(el._t!==t){el._t=t;el.innerHTML=t;el.classList.toggle('show',!!t);}}
  H.bombic.classList.toggle('hidden',!(S.mode==='defuse'&&p.hasBomb&&p.alive));
  if(!p.alive&&S.spec&&p.deadT>2&&(S.mode==='defuse'||(S.mode==='br'&&NET.role))){H.spec.classList.remove('hidden');setT(H.spec,gpKeys('Spectating '+S.spec.name+' · click to switch'));}else H.spec.classList.add('hidden');
  {const need=!(S.locked||S.noLock||S.uiOpen||S.ended||S.state!=='game');if(need){if(!S.lostAt)S.lostAt=performance.now();}else S.lostAt=0;H.click.classList.toggle('hidden',!need||performance.now()-S.lostAt<1200);}
}
function renderScoreboard(){
  const teamed=S.mode==='tdm'||S.mode==='defuse',T=S.mode==='defuse'?['CT','T']:['A','B'],tn={CT:'Counter-Terrorists',T:'Terrorists',A:'Blue',B:'Red'};
  const money=S.mode==='defuse';
  const row=(e,i)=>{const lv=e.isPlayer?save.level:(e.human?e.lvl:0);const kd=e.deaths?(e.kills/e.deaths).toFixed(2):e.kills.toFixed(2);
    return `<div class="sbr ${e.isPlayer?'me':''} ${e.alive?'':'dead'}"><span class="sbn">${teamed?'':'<i>'+(i+1)+'</i>'}<img src="${avatarUrl(e.name||'You',e.isPlayer)}" alt=""><b>${esc(e.isPlayer?(save.name||'You'):e.name)}</b>${e.human?'<em>online</em>':''}${e.hasBomb&&e.alive&&e.team===player.team?'<em class="c4">C4</em>':''}</span>
      <span>${lv?badgeSvg(lv,16):'<small>bot</small>'}</span><span>${e.kills}</span><span>${e.deaths}</span><span>${kd}</span>${money?`<span class="m">${e.team===player.team?'$'+e.money:''}</span>`:''}<span>${e.alive?'':'☠'}</span></div>`;};
  const head=`<div class="sbr sbhd"><span>Player</span><span>Rank</span><span>K</span><span>D</span><span>K/D</span>${money?'<span>Money</span>':''}<span></span></div>`;
  let h=`<div class="sb-top"><div><b>${MODES[S.mode].name}</b><small>${THEME&&THEME.n||''}${NET.role?' · online':''}</small></div>`;
  if(teamed){const sc=S.mode==='defuse'&&S.round?[S.round.wins.CT,S.round.wins.T]:[S.teamScore.A,S.teamScore.B];h+=`<div class="sb-score"><span class="a">${sc[0]}</span><i>:</i><span class="b">${sc[1]}</span></div>`;}
  h+=`<div class="sb-t">${fmtTime(S.mode==='defuse'&&S.round?S.round.t:S.timeLeft||0)}</div></div>`;
  if(teamed){for(const[k,t]of T.entries()){const L=S.ents.filter(e=>e.team===t).sort((a,b)=>b.kills-a.kills||a.deaths-b.deaths);
      h+=`<div class="sbteam t${k}${money?'':' nomoney'}"><div class="sbth"><b>${tn[t]}</b><small>${L.filter(e=>e.alive).length} alive</small></div>${head}${L.map(row).join('')}</div>`;}}
  else{const L=S.ents.slice().sort((a,b)=>b.kills-a.kills||a.deaths-b.deaths);h+=`<div class="sbteam nomoney">${head}${L.map(row).join('')}</div>`;}
  $('scoreboard').innerHTML=h;
}
const mm=$('minimap'),mx=mm.getContext('2d');
function drawMinimap(){
  if(S.mode==='practice')return;
  const W=mm.width,R=S.mode==='br'?60:38,sc=W/2/R,p=player;
  const cx=p.alive?p.pos.x:(S.spec?S.spec.pos.x:p.pos.x),cz=p.alive?p.pos.z:(S.spec?S.spec.pos.z:p.pos.z),yaw=p.alive?p.yaw:(S.spec?S.spec.yaw+Math.PI:p.yaw);
  mx.clearRect(0,0,W,W);mx.save();mx.beginPath();mx.arc(W/2,W/2,W/2,0,7);mx.clip();
  mx.translate(W/2,W/2);mx.rotate(yaw);
  if(ISL){mx.fillStyle='rgba(22,92,132,.85)';mx.fillRect(-W*1.5,-W*1.5,W*3,W*3);const isl=(off,col)=>{mx.fillStyle=col;mx.beginPath();for(let i=0;i<=72;i++){const th=i/72*Math.PI*2,r=islR(th)+off;const X=(Math.cos(th)*r-cx)*sc,Z=(Math.sin(th)*r-cz)*sc;i?mx.lineTo(X,Z):mx.moveTo(X,Z);}mx.closePath();mx.fill();};isl(2.5,'rgba(70,170,190,.9)');isl(0,'rgba(222,200,150,.95)');isl(-6,'rgba(150,150,110,.8)');}
  mx.fillStyle=ISL?'rgba(70,52,36,.9)':'rgba(225,205,160,.55)';
  for(const c of colliders){if(c.minY>0.5)continue;const x0=(c.minX-cx)*sc,z0=(c.minZ-cz)*sc,w=(c.maxX-c.minX)*sc,d=(c.maxZ-c.minZ)*sc;if(x0>W||z0>W||x0+w<-W||z0+d<-W)continue;mx.fillRect(x0,z0,w,d);}
  if(S.mode==='defuse'&&S.round){mx.strokeStyle='rgba(255,154,60,.9)';mx.lineWidth=2;for(const k in SITES){const s=SITES[k];mx.beginPath();mx.arc((s.x-cx)*sc,(s.z-cz)*sc,s.r*sc,0,7);mx.stroke();mx.save();mx.translate((s.x-cx)*sc,(s.z-cz)*sc);mx.rotate(-yaw);mx.fillStyle='#ff9a3c';mx.font='bold 13px sans-serif';mx.textAlign='center';mx.textBaseline='middle';mx.fillText(k,0,0);mx.restore();}
    const bomb=S.round.bomb;let bp=null;if(bomb.state==='planted'||(bomb.state==='dropped'&&p.team==='T'))bp=bomb.pos;else if(bomb.state==='carried'&&p.team==='T'){const c=S.ents.find(e=>e.hasBomb);if(c)bp=c.pos;}
    if(bp){mx.fillStyle=bomb.state==='planted'&&Math.floor(S.time*4)%2?'#fff':'#ff3b30';mx.fillRect((bp.x-cx)*sc-4,(bp.z-cz)*sc-4,8,8);}}
  if(S.zone){const z=S.zone;mx.strokeStyle='#4ea8ff';mx.lineWidth=2;mx.beginPath();mx.arc((z.x-cx)*sc,(z.z-cz)*sc,z.r*sc,0,7);mx.stroke();
    if(z.state==='wait'&&z.phase<ZP.length){mx.strokeStyle='rgba(255,255,255,.7)';mx.setLineDash([4,4]);mx.beginPath();mx.arc((z.tx-cx)*sc,(z.tz-cz)*sc,z.tr*sc,0,7);mx.stroke();mx.setLineDash([]);}}
  if(S.mode==='br'){mx.fillStyle='#ffd34d';for(const L of S.loot){if(L.taken)continue;const x=(L.g.position.x-cx)*sc,z=(L.g.position.z-cz)*sc;if(Math.abs(x)<W/2&&Math.abs(z)<W/2)mx.fillRect(x-1,z-1,2,2);}}
  for(const f of S.fires||[]){mx.fillStyle='rgba(255,110,30,.65)';mx.beginPath();mx.arc((f.pos.x-cx)*sc,(f.pos.z-cz)*sc,Math.max(2,f.r*sc),0,7);mx.fill();}
  for(const s of S.smokes){mx.fillStyle='rgba(200,200,200,.6)';mx.beginPath();mx.arc((s.pos.x-cx)*sc,(s.pos.z-cz)*sc,s.r*sc,0,7);mx.fill();}
  for(const b of S.bots){if(!b.alive)continue;const ally=b.team===p.team;if(!ally&&S.time-b.lastShot>1.5)continue;mx.fillStyle=ally?(b.human?'#7dff9b':'#4ea8ff'):'#ff4a3d';mx.beginPath();mx.arc((b.pos.x-cx)*sc,(b.pos.z-cz)*sc,3.5,0,7);mx.fill();}
  mx.restore();
  mx.fillStyle='#ffd34d';mx.beginPath();mx.moveTo(W/2,W/2-7);mx.lineTo(W/2-5,W/2+5);mx.lineTo(W/2+5,W/2+5);mx.closePath();mx.fill();
}

/* ================= VIEWMODEL ANIM ================= */
function updateVM(dt){updateVM0(dt);try{medVM(dt);}catch(e){}}
function updateVM0(dt){
  const p=player,id=p.inv[p.slot]?p.inv[p.slot].id:'knife';
  for(const k in vm.models)vm.models[k].visible=(k===id&&p.alive&&!p.scoped&&!p.tp);
  const WW=wWeight(curW());vm.adsK=(vm.adsK||0)+(((p.ads&&!p.scoped&&p.alive)?1:0)-(vm.adsK||0))*Math.min(1,dt*12/WW);
  vm.sprintK=(vm.sprintK||0)+((p.sprinting?1:0)-(vm.sprintK||0))*Math.min(1,dt*8);
  vm.slideK=(vm.slideK||0)+((p.slideT>0?1:0)-(vm.slideK||0))*Math.min(1,dt*(p.slideT>0?14:6));{const sf=$('slideFx');if(sf){const v=+(vm.slideK*0.9).toFixed(2);if(sf._v!==v){sf._v=v;sf.style.opacity=v;}}}
  if(!p.scoped){const tf=save.fov*(1-0.2*vm.adsK)+6*vm.sprintK+10*vm.slideK+(player.vkF||0);if(Math.abs(camera.fov-tf)>0.01){camera.fov=tf;camera.updateProjectionMatrix();}}
  const m=vm.models[id];if(!m)return;const b=vmBase(id);const ak=vm.adsK,skk=vm.sprintK,calm=1-ak*0.85;
  const sp=Math.hypot(p.vel.x,p.vel.z);vm.bobT+=dt*sp*1.9;const bob=p.onGround?Math.min(sp/4.5,1):0;
  vm.sx+=(clamp(-vm.mdx*0.0012*WW,-0.06,0.06)-vm.sx)*Math.min(1,dt*10/WW);vm.sy+=(clamp(vm.mdy*0.0012,-0.05,0.05)-vm.sy)*Math.min(1,dt*10);vm.mdx=vm.mdy=0;
  const w=WEAPONS[id];const heavy=w.cat==='sniper'?1.6:w.cat==='shotgun'?1.3:w.cat==='mg'?1.3:1;
  vm.kick=Math.max(0,vm.kick-dt*12/heavy);
  const lx=(p.vel.x*Math.cos(p.yaw)-p.vel.z*Math.sin(p.yaw));
  let x=b[0]+Math.sin(vm.bobT)*0.012*bob+vm.sx-lx*0.004,y=b[1]+Math.abs(Math.cos(vm.bobT))*0.01*bob+vm.sy-p.crouch*0.01+(p.onGround?0:clamp(-p.vel.y*0.004,-0.02,0.02)),z=b[2]+vm.kick*0.05*heavy;
  let rx=vm.kick*0.12*heavy,ry=0,rz=lx*0.012;
  const RV=vm.real&&vm.real[id];
  if(RV){x=(Math.sin(vm.bobT)*0.01*bob*(1+skk)+vm.sx*0.6-lx*0.003)*calm;y=(Math.abs(Math.cos(vm.bobT))*0.008*bob*(1+skk*1.5)+vm.sy*0.6)*calm-p.crouch*0.01*(1-ak)+(p.onGround?0:clamp(-p.vel.y*0.004,-0.02,0.02));z=vm.kick*0.012*(1-ak*0.5);rx=vm.kick*0.02;ry=0;rz=lx*0.01*calm;
    x-=0.03*skk;y-=0.05*skk;rx-=0.35*skk;ry+=0.5*skk;rz+=0.35*skk;
    if(p.reloading&&!RV.anim.is('reload')){const tot=p.mstep?MR_STEP[p.mstep]:(w.shell||w.reload);const k=1-p.reloadT/tot,s=Math.sin(k*Math.PI);y-=s*0.12;rx-=s*0.7;}
    if(p.switchT>0&&!RV.anim.is('draw')){const k=p.switchT/0.35;y-=k*0.3;rx-=k*0.6;}
    if(p.planting>0||p.defusing>0){y-=0.15;rx-=0.6;}
    {const sk=vm.slideK||0;x+=0.025*sk;y-=0.04*sk;rz-=0.32*sk;rx+=0.1*sk;}
    m.position.set(x,y,z);m.rotation.set(rx,ry,rz);
    if(RV.pivot&&!w.melee){const H=RV.hip,A=RV.ads;RV.pivot.position.set(H[0]+(A[0]-H[0])*ak,H[1]+(A[1]-H[1])*ak,H[2]+(A[2]-H[2])*ak);RV.pivot.rotation.set(H[3]*(1-ak),H[4]*(1-ak),H[5]*(1-ak));}
    RV.anim.update(dt);
    vm.flashT-=dt;for(const k in vm.flash){const f=vm.flash[k];f.visible=vm.flashT>0&&k===id&&!p.scoped;if(f.visible)f.rotation.z=Math.random()*3;}
    return;}
  const gs=m.userData.gs;if(gs&&!w.melee&&!w.nade&&!w.taser){ry+=0.26;rz-=0.06;z-=0.02;x+=0.0;y+=0.012;}/* AK-style three-quarter presentation so the side profile shows */
  if(ak>0){x+=(0-x)*ak;y+=((gs?-0.058:-0.068)-y)*ak;z+=0.05*ak;rx*=1-ak*0.6;ry*=1-ak;rz*=1-ak;}
  if(skk>0){x-=0.04*skk;y-=0.06*skk;rx-=0.4*skk;ry+=0.55*skk;rz+=0.3*skk;}
  if(p.reloading){const tot=p.mstep?MR_STEP[p.mstep]:(w.shell||w.reload);const k=1-p.reloadT/tot,s=Math.sin(k*Math.PI);if(w.shell){y-=0.05;rz+=0.4;rx+=s*0.1;}else{y-=s*0.12;rx-=s*0.7;rz+=s*0.3;}}
  if(p.switchT>0){const k=p.switchT/0.35;y-=k*0.3;rx-=k*0.6;}
  const isK=isKatana(id);vm.blockK=(vm.blockK||0)+(((p.blocking&&isK)?1:0)-(vm.blockK||0))*Math.min(1,dt*16);if(vm.parry>0)vm.parry=Math.max(0,vm.parry-dt*6);
  if(vm.slash>0){vm.slash=Math.max(0,vm.slash-dt*(isK?3.2:4));const s=Math.sin((1-vm.slash)*Math.PI);if(isK){}else{x-=s*0.12;ry+=s*0.7;rz-=s*0.8;z-=s*0.08;}}
  if(isK){katanaAnim(m,dt,p,id==='dualkatana');if(p.switchT>0){const k=p.switchT/0.35;rz+=k*1.4;x+=k*0.06;}}
  if(p.planting>0||p.defusing>0){y-=0.15;rx-=0.6;}
  if(vm.inspect>0){vm.inspect-=dt;const k=Math.sin(Math.min(1,(1.4-vm.inspect)/1.4)*Math.PI);if(isK){}else if(w.melee){ry+=k*1.2;rz+=Math.sin((1.4-vm.inspect)*(w.shape&&w.shape.t==='butterfly'?14:5))*k*0.8;x-=k*0.08;}else{ry+=k*0.9;rz+=k*0.5;x-=k*0.1;y+=k*0.03;}}
  {const sk=vm.slideK||0;x+=0.025*sk;y-=0.04*sk;rz-=0.32*sk;rx+=0.1*sk;}
  m.position.set(x,y,z);m.rotation.set(rx,ry,rz);
  if(vm.pumpT>0){vm.pumpT-=dt;}const pm=vm.pump[id];if(pm){const base=pm.userData.bz;const k=vm.pumpT>0&&vm.pumpT<0.35?Math.sin((0.35-vm.pumpT)/0.35*Math.PI):0;pm.position.z=base+k*0.08;}
  vm.flashT-=dt;for(const k in vm.flash){const f=vm.flash[k];f.visible=vm.flashT>0&&k===id&&!p.scoped;if(f.visible)f.rotation.z=Math.random()*3;}
}

/* ================= MAIN LOOP ================= */
const MODE_HINT={practice:'Hit as many targets as you can in 60s · press B to buy',tdm:'First team to 40 kills',ffa:'Everyone is hostile — first to 20',br:'Loot weapons & stay inside the zone'};
function update(dt,t0,t1){
  S.time+=dt;
  const client=NET.role==='client';
  if(S.countdown>0){if(!client)S.countdown-=dt;else S.countdown=Math.max(0,S.countdown-dt);const c=Math.ceil(S.countdown);
    if(c!==S.cdShown){S.cdShown=c;if(c>0){center(`<span class="cd">${c}</span><small>${MODE_HINT[S.mode]}</small>`,1.2);sfx('beep');}else{center('<span class="cd">GO</span>',0.8);sfx('go');}}}
  else if(S.mode!=='br'&&S.mode!=='defuse'){if(!client){S.timeLeft-=dt;if(S.timeLeft<=0){S.timeLeft=0;timeUp();}}else S.timeLeft=Math.max(0,S.timeLeft-dt);}
  updatePlayer(dt,t0,t1);
  for(const b of S.bots){if(b.isNet||b.isProxy)netEntUpdate(b,dt);else if(S.countdown<=0&&!client)updateBot(b,dt);}
  if(S.mode==='practice'&&S.countdown<=0)updateTargets(dt);
  updateBarrels(dt);aimAssistTick(dt);
  if(S.mode==='br'){if(S.countdown<=0&&!client&&S.zone)updateZone(dt);updateLoot(dt);if(S.countdown<=0){updatePlane(dt);updateAir(dt);}updateGloos(dt);}
  if(S.mode==='defuse'&&!S.ended&&S.round){if(!client)updateRound(dt);else{S.round.t-=dt;bombFx(dt);}}
  updateNades(dt);
  if(S.endT>0){S.endT-=dt;if(S.endT<=0)finish(false);}
  if(NET.role){S.netT+=dt;if(S.netT>=0.05){S.netT=0;if(NET.role==='host')netSnapshot();else sendState();}}
}
let last=performance.now(),menuT=0;
function applyCamRot(){const p=player;if(S.state!=='game'||!p.alive)return;camera.rotation.set(clamp(p.pitch+p.punchP+(p.shx||0)+(p.vkP||0),-1.56,1.56),p.yaw-p.punchY+(p.shy||0)+(p.vkY||0),(p.roll||0)+(p.vkR||0)+(p.leanRoll||0));}
const camA=new V3(),camB=new V3();let camOk=false;
/* tell (don't force) players on slow devices that they can lower Graphics */
const GFXW={t:0,shown:0};
function gfxSlowCheck(ms){if(GFXW.shown||S.state!=='game'||S.paused||(save.qual||'high')==='low')return;if(PERF.fps&&PERF.fps<20)GFXW.t+=ms;else GFXW.t=Math.max(0,GFXW.t-ms*0.5);
  if(GFXW.t>12000){GFXW.shown=1;try{frToast('Running slowly on this device. For smoother play, set Settings → Video → Render resolution to Native, or Graphics to Medium.',7000);}catch(e){}}}
const PERF={ema:16,t:0,n:0,fpsT:0,fps:0};
function perfTick(rawMs){PERF.ema+=(Math.min(rawMs,100)-PERF.ema)*0.05;PERF.n++;PERF.fpsT+=rawMs;
  if(PERF.fpsT>=500){PERF.fps=Math.round(PERF.n*1000/PERF.fpsT);PERF.n=0;PERF.fpsT=0;const el=$('fpsTag');if(el){el.style.display=save.showFps?'block':'none';if(save.showFps)el.textContent=PERF.fps+' FPS · '+qualNow;}}
  gfxSlowCheck(rawMs);if((save.qual||'high')!=='auto'||S.state!=='game')return;PERF.t+=rawMs;if(PERF.t<2500)return;PERF.t=0;
  if(PERF.ema>26&&qualNow!=='low')setQuality(qualNow==='high'?'medium':'low');else if(PERF.ema<11&&qualNow!=='high')setQuality(qualNow==='low'?'medium':'high');}
/* ================= MOBILE / TABLET (BETA) — touch controls =================
   left thumb: floating joystick (push far = sprint) · right thumb: drag anywhere to look
   buttons: fire (look while holding), aim/scope, jump, crouch, reload, slide, use, heal, grenade, buy, scores, pause */
const TOUCH={on:false,joy:null,look:null,fireId:null,lookIds:new Set(),keys:{},crouch:false};
function touchCapable(){try{return (matchMedia('(pointer: coarse)').matches||('ontouchstart' in window))&&(navigator.maxTouchPoints||0)>0;}catch(e){return false;}}
function touchWanted(){const m=save.touchMode||'auto';return m==='on'||(m==='auto'&&touchCapable());}
function vKey(code,down){if(!!TOUCH.keys[code]===down)return;TOUCH.keys[code]=down;
  const ev=new KeyboardEvent(down?'keydown':'keyup',{code,key:code,bubbles:true});window.dispatchEvent(ev);}
function vTap(code){vKey(code,true);setTimeout(()=>vKey(code,false),60);}
function touchAim(on){const p=player;if(!p.alive||S.state!=='game')return;const w=curW();
  if(isKatana(w.id)){if(on&&!p.blockBroken){p.blocking=true;p.blockStart=S.time;p.sprinting=false;}else p.blocking=false;return;}
  if(!w.zoom&&!w.melee&&!w.nade&&!w.taser){p.ads=on?!p.ads:p.ads;if(p.ads)p.sprinting=false;return;}
  if(on&&w.zoom&&!p.reloading){setScoped(!p.scoped);p.rescope=false;if(!playHZ(p.scoped?'gp:awp/zoom':'gp:awp/awp_zoom_out',0.6))sfx('scope');}}
function touchLook(dx,dy){const k=0.0058*(save.sens||1)*(save.touchSens||1)*(camera.fov/80)*aaFriction();AA.act=0.35;player.yaw-=dx*k;player.pitch=clamp(player.pitch-dy*k*0.85,-1.55,1.55);applyCamRot();vm.mdx+=dx*0.6;vm.mdy+=dy*0.6;}
function buildTouchUI(){if($('touchUI'))return;const d=document.createElement('div');d.id='touchUI';
  d.innerHTML=`<div id="tJoyZone"></div><div id="tJoy"><i></i></div><button class="tb big" id="tFire" data-a="fire"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="6.5"/><path d="M12 2v5M12 17v5M2 12h5M17 12h5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/></svg></button><button class="tb mid" id="tFire2" data-a="fire"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="6.5"/><path d="M12 2v5M12 17v5M2 12h5M17 12h5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/></svg></button><button class="tb mid" id="tAim" data-a="aim"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V5a1 1 0 0 1 1-1h4M15 4h4a1 1 0 0 1 1 1v4M20 15v4a1 1 0 0 1-1 1h-4M9 20H5a1 1 0 0 1-1-1v-4"/><circle cx="12" cy="12" r="2.4"/></svg></button><button class="tb " id="tReload" data-a="reload"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/></svg></button><button class="tb " id="tJump" data-a="jump"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 14l6-6 6 6"/><path d="M6 19l6-6 6 6" opacity=".55"/></svg></button><button class="tb " id="tCrouch" data-a="crouch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2"/><path d="M12 8l-3 5h5l2 6M9 13l-3 6"/></svg></button><button class="tb " id="tSlide" data-a="slide"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="17" cy="6" r="2"/><path d="M15 9l-6 3-4 6M9 12l6 2 4 5M3 21h18"/></svg></button><button class="tb " id="tNade" data-a="nade"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="14" r="6"/><path d="M10 7h4v2h-4zM14 7l3-3"/></svg></button><button class="tb sm" id="tUse" data-a="use"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 13V6.5a1.5 1.5 0 0 1 3 0V12M11 11V4.5a1.5 1.5 0 0 1 3 0V11M14 11V6a1.5 1.5 0 0 1 3 0v7c0 4-2.5 7-6 7s-5-2-6.5-5L3 11.5a1.4 1.4 0 0 1 2.3-1.5L8 13"/></svg></button><button class="tb " id="tHeal" data-a="heal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="6" width="16" height="13" rx="2"/><path d="M12 9.5v6M9 12.5h6M9 6V4h6v2"/></svg></button><button class="tb sm" id="tPeekL" data-a="peekL"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13" cy="5" r="2"/><path d="M13 8l-4 6v7M9 14l5 2v5M16 10l-4-1"/><path d="M4 9l-2 3 2 3" /></svg></button><button class="tb sm" id="tPeekR" data-a="peekR"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="5" r="2"/><path d="M11 8l4 6v7M15 14l-5 2v5M8 10l4-1"/><path d="M20 9l2 3-2 3"/></svg></button><div id="tTop"><button class="tb top" id="tPause" data-a="pause"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5v14M15 5v14"/></svg></button><button class="tb top" id="tScore" data-a="score"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button><button class="tb top" id="tBuy" data-a="buy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1.5 11h-11z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg></button></div><div id="tCompass"><div id="tCmpS"></div><b id="tCmpD">0</b><i></i></div><div id="tBeta">MOBILE BETA</div>`;
  document.body.appendChild(d);
  const opt={passive:false};
  // joystick
  const zone=$('tJoyZone'),joy=$('tJoy'),knob=joy.firstElementChild;
  zone.addEventListener('touchstart',e=>{e.preventDefault();if(TOUCH.joy)return;const t=e.changedTouches[0];TOUCH.joy={id:t.identifier,x:t.clientX,y:t.clientY};joy.style.left=t.clientX+'px';joy.style.top=t.clientY+'px';joy.classList.add('on');knob.style.transform='translate(-50%,-50%)';},opt);
  const joyMove=e=>{if(!TOUCH.joy)return;for(const t of e.changedTouches){if(t.identifier!==TOUCH.joy.id)continue;e.preventDefault();let dx=t.clientX-TOUCH.joy.x,dy=t.clientY-TOUCH.joy.y;const R=58,L=Math.hypot(dx,dy);if(L>R){dx*=R/L;dy*=R/L;}
      knob.style.transform=`translate(calc(-50% + ${dx}px),calc(-50% + ${dy}px))`;const nx=dx/R,ny=dy/R;const th=0.32;
      vKey('KeyW',ny<-th);vKey('KeyS',ny>th);vKey('KeyA',nx<-th);vKey('KeyD',nx>th);vKey('ShiftLeft',L>=R*0.97&&ny<-0.75);}};
  const joyEnd=e=>{if(!TOUCH.joy)return;for(const t of e.changedTouches){if(t.identifier!==TOUCH.joy.id)continue;TOUCH.joy=null;joy.classList.remove('on');for(const k of['KeyW','KeyS','KeyA','KeyD','ShiftLeft'])vKey(k,false);}};
  // look: any touch on the canvas / free area on the right
  const lookStart=e=>{if(S.state!=='game')return;for(const t of e.changedTouches){if(TOUCH.joy&&t.identifier===TOUCH.joy.id)continue;TOUCH.lookIds.add(t.identifier);TOUCH['l'+t.identifier]={x:t.clientX,y:t.clientY};}e.preventDefault();};
  const lookMove=e=>{for(const t of e.changedTouches){const L=TOUCH['l'+t.identifier];if(!L)continue;e.preventDefault();touchLook(t.clientX-L.x,t.clientY-L.y);L.x=t.clientX;L.y=t.clientY;}};
  const lookEnd=e=>{for(const t of e.changedTouches){delete TOUCH['l'+t.identifier];TOUCH.lookIds.delete(t.identifier);}};
  $('touchUI').addEventListener('touchstart',e=>{if(e.target.id!=='touchUI')return;const t=e.changedTouches[0];const hb=document.elementsFromPoint(t.clientX,t.clientY).find(el=>el.classList&&el.classList.contains('hb-s'));
    if(hb){e.preventDefault();const s=+hb.dataset.s;if(s===6){startHeal();return;}if(s===4&&player.slot===4)vTap('Digit4');else if(s)switchSlot(s);return;}lookStart(e);},opt);
  addEventListener('touchmove',e=>{if(!TOUCH.on)return;joyMove(e);lookMove(e);},opt);
  addEventListener('touchend',e=>{if(!TOUCH.on)return;joyEnd(e);lookEnd(e);},opt);addEventListener('touchcancel',e=>{if(!TOUCH.on)return;joyEnd(e);lookEnd(e);},opt);
  // buttons
  const hb=$('hotbar');hb.addEventListener('touchstart',e=>{const el=e.target.closest('.hb-s');if(!el||!TOUCH.on)return;e.preventDefault();e.stopPropagation();const sl=+el.dataset.s;if(!player.inv[sl])return;if(sl===4&&player.slot===4)vTap('Digit4');else switchSlot(sl);el.classList.add('tap');setTimeout(()=>el.classList.remove('tap'),150);},opt);
  for(const b of d.querySelectorAll('.tb')){const a=b.dataset.a;
    b.addEventListener('touchstart',e=>{e.preventDefault();e.stopPropagation();b.classList.add('down');initAudio();const t=e.changedTouches[0];
      if(a==='fire'){TOUCH['l'+t.identifier]={x:t.clientX,y:t.clientY};if(!player.alive&&(S.mode==='defuse'||S.mode==='br')){const al=S.ents.filter(x=>x.alive&&x!==player);if(al.length){const i=al.indexOf(S.spec);S.spec=al[(i+1)%al.length];}return;}if(S.uiOpen)return;mouse.down=true;tryFire();}
      else if(a==='aim')touchAim(true);
      else if(a==='jump'){vKey('Space',true);}
      else if(a==='crouch'){TOUCH.crouch=!TOUCH.crouch;vKey('ControlLeft',TOUCH.crouch);b.classList.toggle('lit',TOUCH.crouch);}
      else if(a==='reload')vTap('KeyR');else if(a==='slide')vTap('KeyQ');else if(a==='use')vKey('KeyE',true);else if(a==='heal')vTap('KeyH');
      else if(a==='nade'){vTap('Digit4');}
      else if(a==='peekL'||a==='peekR'){const k=a==='peekL'?'KeyZ':'KeyX',o=a==='peekL'?'KeyX':'KeyZ';const on=!TOUCH.keys[k];vKey(o,false);vKey(k,on);$('tPeekL').classList.toggle('lit',a==='peekL'&&on);$('tPeekR').classList.toggle('lit',a==='peekR'&&on);}
      else if(a==='pause'){if(S.uiOpen)closePause();else openPause(true);}
      else if(a==='score'){vKey('Tab',true);}
      else if(a==='buy')vTap('KeyB');},opt);
    const up=e=>{e.preventDefault();b.classList.remove('down');for(const t of e.changedTouches)delete TOUCH['l'+t.identifier];
      if(a==='fire')mouse.down=false;else if(a==='jump')vKey('Space',false);else if(a==='use')vKey('KeyE',false);else if(a==='score')vKey('Tab',false);
      else if(a==='aim'){const w=curW();if(isKatana(w.id))touchAim(false);}};
    b.addEventListener('touchend',up,opt);b.addEventListener('touchcancel',up,opt);}
}
function touchUpdate(){const want=touchWanted();if(want!==TOUCH.on){TOUCH.on=want;document.body.classList.toggle('touch',want);if(want){buildTouchUI();S.noLock=true;S.lockBlocked=true;touchPerf();}}
  if(!TOUCH.on)return;const ingame=S.state==='game'&&!S.ended;document.body.classList.toggle('tgame',ingame&&!S.uiOpen);
  if(ingame){S.noLock=true;S.mIn=false;}
  const p=player;const br=S.mode==='br',def=S.mode==='defuse';const show=(id,v)=>{const e=$(id);if(e)e.style.display=v?'':'none';};
  show('tHeal',br);show('tBuy',def||S.mode==='tdm'||S.mode==='practice');show('tUse',br||def||(S.crates&&S.crates.length>0));show('tNade',p.nades&&p.nades.length>0);
  if(!(S.state==='game')&&TOUCH.crouch){TOUCH.crouch=false;vKey('ControlLeft',false);$('tCrouch').classList.remove('lit');}
  if(!(S.state==='game')&&(TOUCH.keys.KeyZ||TOUCH.keys.KeyX)){vKey('KeyZ',false);vKey('KeyX',false);$('tPeekL').classList.remove('lit');$('tPeekR').classList.remove('lit');}
  document.documentElement.style.setProperty('--tbs',save.touchSize||1);
  if(ingame){const hd=((-player.yaw*180/Math.PI)%360+360)%360;if(Math.abs(hd-(TOUCH.hd||-99))>0.4){TOUCH.hd=hd;const L={0:'N',45:'NE',90:'E',135:'SE',180:'S',225:'SW',270:'W',315:'NW'};let h='';
      for(let a=Math.floor((hd-75)/15)*15;a<=hd+75;a+=15){const n=((a%360)+360)%360;const x=(a-hd)*2.2;h+=`<span style="left:calc(50% + ${x.toFixed(1)}px)" class="${L[n]!==undefined?'c':''}">${L[n]!==undefined?L[n]:n}</span>`;}
      $('tCmpS').innerHTML=h;$('tCmpD').textContent=Math.round(hd)%360;}}
  const portrait=innerHeight>innerWidth*1.05;document.body.classList.toggle('tportrait',portrait&&ingame);}
/* auto low graphics on phones/tablets the first time */
function touchPerf(){if(!touchCapable()||save.touchPerfSet)return;save.touchPerfSet=1;persist();}

setTimeout(()=>{try{applyVideo();}catch(e){console.warn('video',e);}},0);
let menuLdK=0,menuLdT=-9,menuLdN=0,menuPanel=false;
/* keep the operator and the logo clear of whatever panel the current tab shows */
function menuFrame(){const W=innerWidth;const pg=[...document.querySelectorAll('section.pg')].find(e=>!e.classList.contains('hidden'));
  const pan=pg&&pg.id!=='pg-home'?pg.firstElementChild:null;let r=pan&&pan.getBoundingClientRect();
  if(!r||r.width<40||r.width>W*0.92){menuPanel=false;}
  else{const freeL=r.left>W*0.35?0:r.right,freeR=r.left>W*0.35?r.left:W;menuPanel=freeR-freeL>W*0.26;menuLdN=clamp(((freeL+freeR)/2)/W*2-1,-0.85,0.85);}
  const lg=$('logo');if(!lg)return;lg.classList.remove('tight');lg.classList.remove('gone');
  if(menuPanel&&r){lg.classList.add('tight');let lr=lg.getBoundingClientRect();const hit=()=>lr.right>r.left-12&&lr.left<r.right+12&&lr.bottom>r.top&&lr.top<r.bottom;
    if(hit()){lg.classList.add('tight');lr=lg.getBoundingClientRect();if(hit())lg.classList.add('gone');}}}
function loop(now){
  requestAnimationFrame(loop);
  try{touchUpdate();}catch(e){}
  perfTick(now-last);
  const dt=Math.min(0.05,(now-last)/1000);last=now;
  try{gpPoll(dt);}catch(e){}
  try{audioListener(dt);}catch(e){}
  if(S.state==='menu'){
    menuT+=dt;const g=operator.g;
    g.rotation.y+=((Math.sin(menuT*0.35)*0.12+menuMX*0.45)-g.rotation.y)*Math.min(1,dt*3);
    animSoldier(operator,{spd:0,pitch:0.04,carry:true,dt});
    if(menuT-menuLdT>0.3){menuLdT=menuT;menuFrame();}
    menuLdK+=((menuPanel?1:0)-menuLdK)*Math.min(1,dt*6);
    g.position.x=0;for(const s of LOBBY.squad)s.g.visible=menuLdK<0.5;
    camera.position.set(Math.sin(menuT*0.15)*0.35*(1-menuLdK)+menuMX*0.12,1.32+Math.sin(menuT*0.23)*0.04,4.4-Math.sin(menuT*0.1)*0.15);camera.lookAt(0,1.12,0);
    {const W=innerWidth,Hh=innerHeight,sh=Math.round(menuLdK*menuLdN*W/2);if(Math.abs(sh)>1)camera.setViewOffset(W,Hh,-sh,0,W,Hh);else if(camera.view&&camera.view.enabled)camera.clearViewOffset();}
    updateLobby(dt,menuT);
  }else if(S.state==='game'){
    if(camera.view&&camera.view.enabled){camera.clearViewOffset();menuLdK=0;}
    const run=!S.ended&&!(S.paused&&!NET.role);
    if(run){
      if(now-S.simClock>250){const gap=now-S.simClock;/* slow device: the sim can't keep up — don't let the match clock fall behind real time */
        if(gap<2500&&!S.paused&&S.state==='game'&&!S.ended&&NET.role!=='client'){const lost=(gap-250)/1000;if(S.countdown>0){S.countdown=Math.max(0.001,S.countdown-lost);}else if(S.mode!=='br'&&S.mode!=='defuse'&&S.timeLeft>0)S.timeLeft=Math.max(0.001,S.timeLeft-lost);else if(S.mode==='defuse'&&S.round&&S.round.t>0)S.round.t=Math.max(0.001,S.round.t-lost);}
        S.simClock=now-250;}
      let n=0;while(S.simClock+TICK_MS<=now&&n<40&&S.state==='game'&&!S.ended){if(camOk)camA.copy(camB);update(TICK*(FUN.slowmo>0?0.25:1),S.simClock,S.simClock+TICK_MS);S.simClock+=TICK_MS;n++;
        if(!camOk||camB.distanceToSquared(camera.position)>9){camA.copy(camera.position);}camB.copy(camera.position);camOk=true;}
      if(camOk&&player.alive&&S.state==='game'){const a=vid().vsync==='off'?1:clamp((now-S.simClock)/TICK_MS,0,1);camera.position.lerpVectors(camA,camB,a);applyCamRot();}
    }else S.simClock=now;
    if(S.state==='game'){updateFun(dt);updateKillBanner(dt);if(FUN.slowmo>0){FUN.slowmo-=dt;if(FUN.slowmo<=0&&FUN.pendingFinish){FUN.flush=true;const pf=FUN.pendingFinish;finish(pf[0],pf[1]);FUN.flush=false;FUN.pendingFinish=null;}}updateVM(dt);updateFx(dt);updateFloats(dt);updateHUD();drawMinimap();
      if(!$('scoreboard').classList.contains('hidden')&&Math.random()<0.1)renderScoreboard();}
  }
  document.body.classList.toggle('br',S.state==='game'&&S.mode==='br');document.body.classList.toggle('playing',S.state==='game'&&!S.uiOpen&&!S.ended);
  if(S.state!=='game'||S.ended||!player.alive)document.body.classList.remove('hb');
  if(cmT>0){cmT-=dt;if(cmT<=0)$('cmsg').style.opacity=0;}
  if(hmT>0){hmT-=dt;if(hmT<=0)$('hitmark').style.opacity=0;}
  dmgA=Math.max(0,dmgA-dt*1.2);$('dmg').style.opacity=dmgA;
  const cp=camera.position;if(S.state==='menu'){sun.position.set(-6,14,-40);sun.target.position.set(0,0.8,0);}else{sunFollow(cp);}
  if(vidFrameSkip(now))return;
  try{updateAO();}catch(e){}
  try{skyTick(dt);}catch(e){}
  renderer.clear();renderer.render(scene,camera);
  if(S.state==='game'&&player.alive&&!player.scoped){renderer.clearDepth();renderer.render(vmScene,vmCam);}
}


/* ================= VIDEO SETTINGS ================= */
const VID_DEF={res:'native',display:'windowed',fps:'native',contrast:'off',vsync:'on',lowlat:'on',msaa:'4x',shadowq:'vhigh',dynsh:'all',detail:'high',filter:'aniso16',fx:'high',ao:'medium',hdr:'quality',fsr:'off'};
const VID_COMP={res:'native',display:'fullscreen',fps:'native',contrast:'on',vsync:'off',lowlat:'boost',msaa:'4x',shadowq:'high',dynsh:'all',detail:'low',filter:'aniso4',fx:'low',ao:'medium',hdr:'quality',fsr:'off'};
const VID_OPTS=[
 ['res','Render resolution','4K Ultra draws the game at 3840×2160 and scales it to your screen, with 2K textures: the sharpest picture. Needs a strong graphics card',[['4k','4K Ultra'],['1440','1440p (2K)'],['native','Native (screen size)']]],
 ['display','Display mode','Fullscreen hides browser bars and avoids desktop stutter',[['fullscreen','Fullscreen'],['windowed','Windowed']]],
 ['fps','Refresh rate / FPS cap','Native runs at your screen\'s highest rate',[['native','Native (highest)'],['144','144 FPS'],['120','120 FPS'],['60','60 FPS'],['30','30 FPS']]],
 ['contrast','Boost player contrast','Makes soldiers stand out against busy backgrounds',[['on','Enabled'],['off','Disabled']]],
 ['vsync','Wait for vertical sync','Off draws the newest game state instantly (no frame smoothing)',[['off','Disabled'],['on','Enabled']]],
 ['lowlat','Low latency mode','Like NVIDIA Reflex: low-latency canvas, Boost asks for the fast GPU',[['boost','Enabled + Boost'],['on','Enabled'],['off','Disabled']],true],
 ['msaa','Multisampling anti-aliasing','Smooths rough edges',[['4x','4x MSAA'],['none','None']],true],
 ['shadowq','Global shadow quality','Shadow sharpness and distance',[['auto','Auto (follow Graphics)'],['ultra','Ultra (8K)'],['vhigh','Very high'],['high','High'],['medium','Medium'],['low','Low']]],
 ['dynsh','Dynamic shadows','Players cast shadows you can see around corners',[['all','All'],['sun','Sun only (no player shadows)'],['off','Off']]],
 ['detail','Model / texture detail','Low removes rooftop clutter and extra props (next match)',[['high','High'],['medium','Medium'],['low','Low']]],
 ['filter','Texture filtering','Sharper textures on walls at an angle',[['bilinear','Bilinear'],['trilinear','Trilinear'],['aniso4','Anisotropic 4x'],['aniso8','Anisotropic 8x'],['aniso16','Anisotropic 16x']]],
 ['fx','Shader & particle detail','Amount of sparks, dust, blood and debris',[['high','High'],['low','Low']]],
 ['ao','Ambient occlusion','Soft contact shadows under players',[['medium','Medium'],['off','Disabled']]],
 ['hdr','High dynamic range','Quality = deeper contrast and richer colours',[['quality','Quality'],['performance','Performance']]],
 ['fsr','Upscaling (FSR-style)','Renders fewer pixels and upscales; Disabled = native sharpness',[['off','Disabled'],['uq','Ultra quality (77%)'],['q','Quality (67%)'],['bal','Balanced (59%)'],['perf','Performance (50%)']]]];
function vid(){return Object.assign({},VID_DEF,save.vid||{});}
function vidSet(k,v){save.vid=Object.assign({},save.vid||{},{[k]:v});persist();applyVideo(k);}
function renderVidUI(){const V=vid();$('vidBox').innerHTML=VID_OPTS.map(([k,n,d,o,rs])=>`<label><span class="vt">${n}${rs?' <b style="color:#ffd08a">*</b>':''}<small>${d}</small></span><select data-v="${k}">${o.map(([v,t])=>`<option value="${v}"${V[k]===v?' selected':''}>${t}</option>`).join('')}</select></label>`).join('')+'<div id="vidNote"></div>';
  for(const sel of $('vidBox').querySelectorAll('select'))sel.onchange=e=>{vidSet(e.target.dataset.v,e.target.value);};vidNote();}
function vidNote(){const V=vid();const need=(V.msaa!==VID0.msaa)||(V.lowlat!==VID0.lowlat);const n=$('vidNote');if(n)n.innerHTML=need?'* Restart needed for this change — <a href="#" id="vidRestart" style="color:#fff">restart now</a>':'';const r=$('vidRestart');if(r)r.onclick=e=>{e.preventDefault();location.reload();};}
$('vPreset').onclick=()=>{save.vid=Object.assign({},VID_COMP);persist();renderVidUI();applyVideo();center('Competitive video preset applied',1.4);};
let VIDFPS=0,_vidLast=0;
/* ---- 4K: texture size per device, render resolution, GPU tier ---- */
function gpuName(){try{const gl=renderer.getContext();const e=gl.getExtension('WEBGL_debug_renderer_info');return String(e?gl.getParameter(e.UNMASKED_RENDERER_WEBGL):gl.getParameter(gl.RENDERER)||'');}catch(e){return '';}}
function gpuStrong(){const g=gpuName().toLowerCase();if(!g||/swiftshader|llvmpipe|software|mali|adreno|powervr|intel|uhd|iris|apple gpu/.test(g))return false;return /nvidia|geforce|rtx|gtx|quadro|radeon|amd|apple m[1-9]/.test(g);}
function texCap(){let V={};try{V=vid();}catch(e){}const mob=typeof touchCapable==='function'&&touchCapable();if(V.res==='4k')return mob?1024:2048;const q=typeof qualNow!=='undefined'?qualNow:'high';if(q==='low')return 512;if(q==='medium')return mob?512:1024;return mob?1024:2048;}
function texCapApply(t){try{const im=t.image,cap=texCap();if(!im||!im.width||im.width<=cap)return;const c=document.createElement('canvas');c.width=cap;c.height=Math.max(1,Math.round(im.height*cap/im.width));const x=c.getContext('2d');x.imageSmoothingQuality='high';x.drawImage(im,0,0,c.width,c.height);t.image=c;t.needsUpdate=true;}catch(e){}}
function resTarget(){let r='native';try{r=vid().res;}catch(e){}return r==='4k'?3840:r==='1440'?2560:0;}
function vidScale(){return {off:1,uq:0.77,q:0.67,bal:0.59,perf:0.5}[vid().fsr]||1;}
function applyPixelRatio(){const Q=QUAL[qualNow]||QUAL.high;let pr=Math.min(window.devicePixelRatio||1,Q.pr)*vidScale();const tw=resTarget();if(tw){const w=Math.max(320,window.innerWidth||1280);pr=Math.max(pr,Math.min(4,tw/w));}renderer.setPixelRatio(pr);if(typeof resize==='function')resize();}
let _resT=0;window.addEventListener('resize',()=>{if(!resTarget())return;clearTimeout(_resT);_resT=setTimeout(()=>{try{applyPixelRatio();}catch(e){}},200);});
function applyShadowQ(){const V=vid();if(V.shadowq==='auto'||typeof sun==='undefined')return;const sh=Math.min({ultra:8192,vhigh:4096,high:2048,medium:1024,low:512}[V.shadowq]||2048,(renderer.capabilities&&renderer.capabilities.maxTextureSize)||4096);if(sun.shadow.mapSize.x===sh)return;sun.shadow.mapSize.set(sh,sh);sunShadowFit(sh);if(sun.shadow.map){sun.shadow.map.dispose();sun.shadow.map=null;}}
function vidAniso(){const f=vid().filter;const mx=renderer.capabilities.getMaxAnisotropy?renderer.capabilities.getMaxAnisotropy():1;return Math.min(mx,{bilinear:1,trilinear:1,aniso4:4,aniso8:8,aniso16:16}[f]||1);}
function applyFilter(root){const f=vid().filter,an=vidAniso();const seen=new Set();(root||scene).traverse(o=>{const ms=o.material?(Array.isArray(o.material)?o.material:[o.material]):[];for(const m of ms)for(const key of['map','normalMap']){const t=m&&m[key];if(!t||seen.has(t)||t.magFilter===THREE.NearestFilter)continue;seen.add(t);
    const mf=f==='bilinear'?THREE.LinearMipmapNearestFilter:THREE.LinearMipmapLinearFilter;if(t.anisotropy!==an||t.minFilter!==mf){t.anisotropy=an;t.minFilter=mf;if(t.image)t.needsUpdate=true;}}});}
const _contrastMats=new Set();
function applyContrast(){const on=vid().contrast==='on';const set=m=>{if(!m||!m.emissive)return;if(m.userData.baseEm===undefined)m.userData.baseEm=m.emissive.getHex();m.emissive.setHex(on?0x2a2a2a:m.userData.baseEm);};
  const ents=(S.ents||[]).filter(e=>e.model||e.body);for(const e of ents){const m=e.model||e.body;if(m&&m.g)m.g.traverse(o=>{if(o.isMesh&&o.material)set(o.material);});}}
function applyDynShadows(){const V=vid();const en=V.dynsh!=='off',chg=renderer.shadowMap.enabled!==en;renderer.shadowMap.enabled=en;const cast=V.dynsh==='all';for(const e of S.ents||[]){const m=e.model||e.body;if(m&&m.g)m.g.traverse(o=>{if(o.isMesh)o.castShadow=cast;});}
  if(typeof operator!=='undefined')operator.g.traverse(o=>{if(o.isMesh)o.castShadow=V.dynsh!=='off';});if(chg)scene.traverse(o=>{if(o.material){const ms=Array.isArray(o.material)?o.material:[o.material];for(const m of ms)m.needsUpdate=true;}});}
function applyHDR(){const q=vid().hdr==='quality';renderer.toneMapping=q?THREE.ACESFilmicToneMapping:THREE.NoToneMapping;renderer.toneMappingExposure=q?1.0:1;canvas.style.filter=q?'contrast(1.1) saturate(1.04)':'';
  let vg=$('vignette');if(!vg){vg=document.createElement('div');vg.id='vignette';document.body.appendChild(vg);}vg.style.display=q?'block':'none';
  try{scene.traverse(o=>{if(o.material){const ms=Array.isArray(o.material)?o.material:[o.material];for(const m of ms)m.needsUpdate=true;}});}catch(e){}}
function applyFullscreen(){const want=vid().display==='fullscreen';try{if(want&&!document.fullscreenElement&&document.documentElement.requestFullscreen)document.documentElement.requestFullscreen().catch(()=>{});else if(!want&&document.fullscreenElement)document.exitFullscreen();}catch(e){}}
function applyVideo(k){const V=vid();VIDFPS={native:0,'144':144,'120':120,'60':60,'30':30}[V.fps]||0;
  if(!k||k==='fsr'||k==='res')applyPixelRatio();if(!k||k==='shadowq')applyShadowQ();if(!k||k==='filter')applyFilter();if(!k||k==='contrast')applyContrast();if(!k||k==='dynsh')applyDynShadows();if(!k||k==='hdr')applyHDR();if(k==='display')applyFullscreen();vidNote();}
/* ambient occlusion: soft contact blob under every soldier */
let _aoTex=null;function aoBlob(){if(!_aoTex)_aoTex=canvasTex(64,(c,s)=>{const g=c.createRadialGradient(s/2,s/2,0,s/2,s/2,s/2);g.addColorStop(0,'rgba(0,0,0,.55)');g.addColorStop(0.6,'rgba(0,0,0,.22)');g.addColorStop(1,'rgba(0,0,0,0)');c.fillStyle=g;c.fillRect(0,0,s,s);});
  const m=new THREE.Mesh(new THREE.PlaneGeometry(1.1,1.1),new THREE.MeshBasicMaterial({map:_aoTex,transparent:true,depthWrite:false,polygonOffset:true,polygonOffsetFactor:-2}));m.rotation.x=-Math.PI/2;m.renderOrder=1;return m;}
function updateAO(){const on=vid().ao!=='off'&&S.state==='game';for(const e of S.ents||[]){if(!e.model||e.isPlayer)continue;if(!e.aoBlob){if(!on)continue;e.aoBlob=aoBlob();scene.add(e.aoBlob);}
    const b=e.aoBlob;b.visible=on&&e.alive&&!e.drop&&e.model.g.visible;if(b.visible){b.position.set(e.pos.x,(e.pos.y||0)+0.025,e.pos.z);}}}
function vidFrameSkip(now){if(!VIDFPS)return false;const iv=1000/VIDFPS;if(now-_vidLast<iv-1)return true;_vidLast=now-((now-_vidLast)%iv);return false;}
function fxMul(){return vid().fx==='low'?0.45:1;}
function propDetail(){return vid().detail;}

/* ================= MENU UI ================= */


/* ================= APP BUILD + AUTO UPDATE (Android beta) ================= */
const GAME_BUILD=63,GAME_VER='0.63-public',APP_SHELL=(()=>{const m=/CombatHorizensApp\/(\d+)/.exec(navigator.userAgent||'');return m?+m[1]:2;})();
const IN_APP=/CombatHorizensApp/.test(navigator.userAgent);
function idbOpen(){return new Promise((res,rej)=>{try{const r=indexedDB.open('ch-update',1);r.onupgradeneeded=()=>r.result.createObjectStore('kv');r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error);}catch(e){rej(e);}});}
async function idbPut(k,v){const db=await idbOpen();return new Promise((res,rej)=>{const tx=db.transaction('kv','readwrite');tx.objectStore('kv').put(v,k);tx.oncomplete=()=>res();tx.onerror=()=>rej(tx.error);});}
function updBase(){return (save.updUrl||'').trim().replace(/\/+$/,'');}
function updStatus(t){const e=$('sUpdSt');if(e)e.textContent=t;}
let _updBusy=false;
async function checkUpdate(manual){const base=updBase();if(!base){if(manual)updStatus('Enter your update server link first');return;}if(_updBusy)return;_updBusy=true;updStatus('Checking…');
  try{const r=await fetch(base+'/version.json?t='+Date.now(),{cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);const j=await r.json();save.updLast=Date.now();persist();
    if(j.apk&&+j.apk.build>APP_SHELL){updBanner(`New app version <b>${esc(j.apk.name||'')}</b> — reinstall the APK from ${esc(j.apk.url||base)}`,false);}
    if(!(+j.build>GAME_BUILD)){updStatus('You have the latest version ('+GAME_VER+')');_updBusy=false;return;}
    updStatus('Downloading '+(j.name||('build '+j.build))+'…');const u=/^https?:/.test(j.url||'')?j.url:base+'/'+(j.url||'game.html');
    const g=await fetch(u+(u.includes('?')?'&':'?')+'t='+Date.now(),{cache:'no-store'});if(!g.ok)throw new Error('HTTP '+g.status);const html=await g.text();
    if(html.length<100000||!/COMBAT HORIZENS/i.test(html))throw new Error('download looks broken');
    if(IN_APP){await idbPut('game',{build:+j.build,name:j.name||'',html,at:Date.now()});updStatus('Update '+(j.name||j.build)+' ready — restart to play it');updBanner(`Update <b>${esc(j.name||('build '+j.build))}</b> downloaded${j.notes?' · '+esc(j.notes):''}`,true);}
    else updStatus('New version '+(j.name||j.build)+' is online — reload the page to get it');}
  catch(e){updStatus((manual?'Update check failed: ':'')+(e.message||e));}
  _updBusy=false;}
function updBanner(html,restart){$('updTxt').innerHTML=html;$('updGo').style.display=restart?'':'none';$('updBanner').classList.add('show');}
$('updGo').onclick=()=>{if(IN_APP&&/game\.html$/.test(location.pathname))location.replace('index.html');else location.reload();};
$('updLater').onclick=()=>$('updBanner').classList.remove('show');
$('sUpdBtn').onclick=()=>{save.updUrl=$('sUpd').value.trim();persist();checkUpdate(true);};
$('sUpd').onchange=e=>{save.updUrl=e.target.value.trim();persist();};
$('updVer').textContent='· v'+GAME_VER+' (build '+GAME_BUILD+')'+(IN_APP?' · app':'');
if(!IN_APP&&!save.updUrl)$('updBox').style.display='none';
/* auto-check once per start (and at most every 30 min) while in the menu */
setTimeout(()=>{if(IN_APP&&updBase()&&S.state==='menu'&&Date.now()-(save.updLast||0)>30*60e3)checkUpdate(false);},4000);
window.chInfo=()=>({build:GAME_BUILD,ver:GAME_VER,app:IN_APP,url:save.updUrl||''});window.chSetUpdateUrl=u=>{save.updUrl=u;persist();};window.chUpdate=checkUpdate;
/* Android back button */
window.chBack=function(){try{if(!$('about').classList.contains('hidden')){closeAbout();return;}if(!$('settings').classList.contains('hidden')){$('settings').classList.add('hidden');return;}
  if(S.state==='game'){if(S.buyOpen){closeBuy();return;}if(S.uiOpen)closePause();else openPause(true);return;}showTab('home');}catch(e){}};

/* ---- About screen: click the logo ---- */
function openAbout(){const m=$('about');{const used=(save.redeemed||[]).includes('HORIZENS');$('abClaim').disabled=used;$('abClaim').textContent=used?'Claimed ✓':'Claim 200 coins';$('abMsg').textContent='';}const em=document.querySelector('.lg-em');if(em&&!$('abEm').src)$('abEm').src=em.src;m.classList.remove('hidden');try{sfx('click');}catch(e){}}
function closeAbout(){$('about').classList.add('hidden');}
$('logo').addEventListener('click',()=>{if(S.state==='menu')openAbout();});
$('abX').onclick=closeAbout;
