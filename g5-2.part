  let s=97;const r=()=>((s=(Math.imul(s,1664525)+1013904223)>>>0)/4294967296);const bl=[];for(let i=0;i<14;i++)bl.push([0.25+r()*0.5,0.25+r()*0.5,0.08+r()*0.22]);
  MD.blot=mdCanvasTex(128,(u,v)=>{let a=0;for(const[cx,cy,rr]of bl){const d=Math.hypot(u-cx,v-cy)/rr;if(d<1)a=Math.max(a,(1-d*d));}const e=Math.hypot(u-0.5,v-0.5)*2;return a*Math.max(0,1-e*e)*(0.75+0.25*Math.sin(u*41+v*23)*Math.sin(u*17-v*37));});}
function mdQuads(list,map,color,opacity){if(!list.length)return null;const P=new Float32Array(list.length*18),U=new Float32Array(list.length*12);let p=0,q=0;
  for(const c of list){// c = [ax,az,ua,va, bx,bz,ub,vb, cx,cz,uc,vc, dx,dz,ud,vd, y]
    const y=c[16];const v=[[0,1,2],[0,2,3]];for(const tri of v)for(const k of tri){P[p++]=c[k*4];P[p++]=y;P[p++]=c[k*4+1];U[q++]=c[k*4+2];U[q++]=c[k*4+3];}}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(P,3));g.setAttribute('uv',new THREE.BufferAttribute(U,2));g.computeBoundingSphere();
  const m=new THREE.MeshBasicMaterial({color,alphaMap:map,transparent:true,opacity,depthWrite:false,side:THREE.DoubleSide,polygonOffset:true,polygonOffsetFactor:-2,polygonOffsetUnits:-2});
  const mesh=new THREE.Mesh(g,m);mesh.renderOrder=1;mesh.receiveShadow=false;mesh.castShadow=false;world.add(mesh);return mesh;}

function mdBlur(a,W,H,r,pass){const t=new Float32Array(a.length);for(let p=0;p<pass;p++){
  for(let y=0;y<H;y++){let acc=0;const o=y*W;for(let x=-r;x<=r;x++)acc+=a[o+Math.min(W-1,Math.max(0,x))];for(let x=0;x<W;x++){t[o+x]=acc/(2*r+1);acc+=a[o+Math.min(W-1,x+r+1)]-a[o+Math.max(0,x-r)];}}
  for(let x=0;x<W;x++){let acc=0;for(let y=-r;y<=r;y++)acc+=t[Math.min(H-1,Math.max(0,y))*W+x];for(let y=0;y<H;y++){a[y*W+x]=acc/(2*r+1);acc+=t[Math.min(H-1,y+r+1)*W+x]-t[Math.max(0,y-r)*W+x];}}}}
function mdBakeAO(){const E=(mapH||50)+12,span=E*2;const ppm=Math.max(1.5,Math.min(5,1024/span));const N=Math.min(1024,Math.ceil(span*ppm));const k=N/span;
  const occ=new Uint8Array(N*N),near=new Float32Array(N*N),far=new Float32Array(N*N);
  for(const c of colliders){if(c.minY>0.25||c.maxY<0.3)continue;const h=c.maxY-Math.max(0,c.minY);
    const x0=Math.max(0,Math.floor((c.minX+E)*k)),x1=Math.min(N-1,Math.ceil((c.maxX+E)*k)-1),z0=Math.max(0,Math.floor((c.minZ+E)*k)),z1=Math.min(N-1,Math.ceil((c.maxZ+E)*k)-1);
    const wn=Math.min(1,0.35+h*0.45),wf=Math.min(1,Math.max(0,(h-1.2)/5));
    for(let z=z0;z<=z1;z++)for(let x=x0;x<=x1;x++){const q=z*N+x;occ[q]=1;near[q]=Math.max(near[q],wn);far[q]=Math.max(far[q],wf);}}
  mdBlur(near,N,N,Math.max(1,Math.round(0.55*k)),3);mdBlur(far,N,N,Math.max(1,Math.round(1.8*k)),3);
  const cv=document.createElement('canvas');cv.width=cv.height=N;const x=cv.getContext('2d');const id=x.createImageData(N,N);
  for(let q=0;q<N*N;q++){const a=occ[q]?0:Math.min(1,near[q]*1.25*0.62+far[q]*0.42);const v=(Math.pow(a,0.85)*255)|0;const o=q*4;id.data[o]=id.data[o+1]=id.data[o+2]=v;id.data[o+3]=255;}
  x.putImageData(id,0,0);const tex=new THREE.CanvasTexture(cv);tex.minFilter=THREE.LinearFilter;tex.generateMipmaps=false;tex.wrapS=tex.wrapT=THREE.ClampToEdgeWrapping;
  const g=new THREE.PlaneGeometry(span,span);g.rotateX(-Math.PI/2);
  const m=new THREE.MeshBasicMaterial({color:0x0b0906,alphaMap:tex,transparent:true,opacity:0.78,depthWrite:false,polygonOffset:true,polygonOffsetFactor:-2,polygonOffsetUnits:-2});
  const mesh=new THREE.Mesh(g,m);mesh.position.y=0.008;mesh.renderOrder=1;world.add(mesh);MD.ao=mesh;}
function mapDetail(mode){if(!world)return;mdTex();
  let sd=((S.seed||7)*2654435761)>>>0||7;const rnd=()=>((sd=(Math.imul(sd,1664525)+1013904223)>>>0)/4294967296);
  // 1) baked ambient occlusion for the ground: top-down occupancy map of everything standing on the floor,
  //    blurred at two radii (tight contact + wide sky-blocking) and laid over the ground as one soft decal
  try{mdBakeAO();}catch(e){console.error(e);}
  // 2) ground wear: dark grime and sun-bleached patches break up the texture tiling
  const H=mapH||50,dark=[],light=[];const n=Math.round(Math.min(260,H*H*0.035));
  const inside=(x,z)=>colliders.some(c=>c.minY<0.3&&x>c.minX&&x<c.maxX&&z>c.minZ&&z<c.maxZ&&c.maxY>0.4);
  for(let i=0;i<n;i++){const x=(rnd()*2-1)*H,z=(rnd()*2-1)*H;if(inside(x,z))continue;if(ISL&&!islIn(x,z,2))continue;const r=1.2+rnd()*3.8,a=rnd()*Math.PI,ca=Math.cos(a)*r,sa=Math.sin(a)*r,el=0.55+rnd()*0.45;
    const q=[x-ca+sa*el,z-sa-ca*el,0,0, x+ca+sa*el,z+sa-ca*el,1,0, x+ca-sa*el,z+sa+ca*el,1,1, x-ca-sa*el,z-sa+ca*el,0,1, 0.006];(rnd()<0.7?dark:light).push(q);}
  mdQuads(dark,MD.blot,0x2a2014,0.3);mdQuads(light,MD.blot,0xfff4e0,0.10);
}

/* sun shadow frustum: pushed ahead of where you look and snapped to whole shadow-map texels so edges don't crawl as you move */
const _sunD=new THREE.Vector3(44,40,27).normalize(),_sunU=new THREE.Vector3(),_sunV=new THREE.Vector3(),_sunF=new THREE.Vector3(),_sunC=new THREE.Vector3();
_sunU.crossVectors(new THREE.Vector3(0,1,0),_sunD).normalize();_sunV.crossVectors(_sunD,_sunU).normalize();
function sunFollow(cp){camera.getWorldDirection(_sunF);_sunF.y=0;if(_sunF.lengthSq()>1e-6)_sunF.normalize();
  const c=sun.shadow.camera,ext=c.right-c.left,tx=ext/sun.shadow.mapSize.x;
  _sunC.set(cp.x+_sunF.x*ext*0.18,0,cp.z+_sunF.z*ext*0.18);
  const u=Math.round(_sunC.dot(_sunU)/tx)*tx,v=Math.round(_sunC.dot(_sunV)/tx)*tx,d=_sunC.dot(_sunD);
  _sunC.copy(_sunU).multiplyScalar(u).addScaledVector(_sunV,v).addScaledVector(_sunD,d);
  sun.target.position.copy(_sunC);sun.position.copy(_sunC).addScaledVector(_sunD,100);sun.target.updateMatrixWorld();}
/* how much ground the sun shadow covers per quality: bigger maps cover more without losing sharpness */
function sunShadowFit(sh){const e=sh>=8192?72:sh>=4096?55:sh>=2048?42:sh>=1024?30:22;const c=sun.shadow.camera;c.left=c.bottom=-e;c.right=c.top=e;c.near=1;c.far=260;c.updateProjectionMatrix();
  const tx=e*2/sh;sun.shadow.normalBias=tx*1.6;sun.shadow.bias=-0.00025;}
/* ================= BATTLE ROYALE ISLAND =================
   An island with an irregular coastline in an open ocean (Free Fire style): sandy beaches that slope under
   a wave-shaded sea, enterable one- and two-storey houses with furniture and loot inside. */
var ISL=null;
function islR(th){const I=ISL;return I.R0*(1+I.A[0]*Math.sin(3*th+I.P[0])+I.A[1]*Math.sin(5*th+I.P[1])+I.A[2]*Math.sin(7*th+I.P[2]));}
function islRel(x,z){return Math.hypot(x,z)-islR(Math.atan2(z,x));}/* <0 on land, >0 at sea */
function islIn(x,z,m){return !ISL||islRel(x,z)<-(m||0);}
function islClamp(p,lim){if(!ISL)return;const L=lim===undefined?1.0:lim;const rel=islRel(p.x,p.z);if(rel>L){const r=Math.hypot(p.x,p.z)||1;const k=Math.max(0,r-(rel-L))/r;p.x*=k;p.z*=k;}}
function islBeachY(rel){return rel<=0?0:rel<=2?-0.32*(rel/2):Math.max(-2.7,-0.32-(rel-2)/24*2.4);}
let _isMats=null;
function islMats(){if(_isMats)return _isMats;
  const sand=canvasTex(256,(c,w,h)=>{c.fillStyle='#d8c08e';c.fillRect(0,0,w,h);const id=c.getImageData(0,0,w,h),d=id.data;for(let i=0;i<d.length;i+=4){const n=(Math.random()-0.5)*30;d[i]+=n;d[i+1]+=n*0.95;d[i+2]+=n*0.8;}c.putImageData(id,0,0);
    for(let i=0;i<60;i++){c.fillStyle=`rgba(${120+Math.random()*60|0},${100+Math.random()*40|0},70,.18)`;c.beginPath();c.arc(Math.random()*w,Math.random()*h,1+Math.random()*2.5,0,7);c.fill();}
    c.strokeStyle='rgba(150,120,70,.12)';c.lineWidth=2;for(let y=8;y<h;y+=22){c.beginPath();for(let x=0;x<=w;x+=8)c.lineTo(x,y+Math.sin(x*0.05+y)*4);c.stroke();}});
  const plank=canvasTex(128,(c,w,h)=>{for(let i=0;i<8;i++){const y=i*h/8;c.fillStyle=`hsl(${28+Math.random()*6},${38+Math.random()*10}%,${30+Math.random()*8}%)`;c.fillRect(0,y,w,h/8);c.fillStyle='rgba(20,10,4,.55)';c.fillRect(0,y,w,1.5);
    for(let k=0;k<5;k++){c.strokeStyle='rgba(60,30,12,.25)';c.beginPath();const yy=y+3+Math.random()*(h/8-6);c.moveTo(0,yy);c.bezierCurveTo(w*0.3,yy+2,w*0.6,yy-2,w,yy+1);c.stroke();}const sx=Math.random()*w;c.fillStyle='rgba(20,10,4,.5)';c.fillRect(sx,y,1.5,h/8);}});
  const tile=canvasTex(128,(c,w,h)=>{const n=4;for(let i=0;i<n;i++)for(let j=0;j<n;j++){const v=196+Math.random()*24|0;c.fillStyle=`rgb(${v},${v-14},${v-34})`;c.fillRect(i*w/n,j*h/n,w/n,h/n);}c.strokeStyle='rgba(90,70,50,.6)';c.lineWidth=2;for(let i=0;i<=n;i++){c.beginPath();c.moveTo(i*w/n,0);c.lineTo(i*w/n,h);c.stroke();c.beginPath();c.moveTo(0,i*h/n);c.lineTo(w,i*h/n);c.stroke();}});
  const fab=canvasTex(64,(c,w,h)=>{c.fillStyle='#7a2f2a';c.fillRect(0,0,w,h);c.strokeStyle='rgba(230,200,140,.5)';c.lineWidth=3;c.strokeRect(5,5,w-10,h-10);for(let i=0;i<w;i+=8){c.fillStyle='rgba(0,0,0,.08)';c.fillRect(i,0,4,h);}});
  return _isMats={beach:new THREE.MeshLambertMaterial({map:sand,vertexColors:true}),plank:Lm({map:plank}),tile:Lm({map:tile}),wood:Lm({color:0x6b4528}),woodD:Lm({color:0x4a2e18}),
    cloth:Lm({color:0xd9d3c4}),blanket:Lm({color:0x3d5f86}),rug:Lm({map:fab}),metal:Lm({color:0x6d7177}),books:[0x8a3b2a,0x2f5f8a,0xb08a2a,0x3f6f3a,0x6a2a5a,0xd0c8b0].map(c=>Lm({color:c})),seabed:new THREE.MeshBasicMaterial({color:0x0b3550})};}
/* land (theme ground) cut to the coastline + a sloping beach ring that runs under the sea */
function islTerrain(){const M=islMats();const NA=180,size=mapH*2+120;
  const land=new THREE.Shape();for(let i=0;i<=NA;i++){const th=i/NA*Math.PI*2,r=islR(th)-3;const x=Math.cos(th)*r,z=Math.sin(th)*r;if(i===0)land.moveTo(x,-z);else land.lineTo(x,-z);}
  const lg=new THREE.ShapeGeometry(land,2);lg.rotateX(-Math.PI/2);{const P=lg.attributes.position,U=lg.attributes.uv;for(let i=0;i<P.count;i++)U.setXY(i,P.getX(i)/size+0.5,0.5-P.getZ(i)/size);}
  const gm=GROUND_MAT||MAT_SAND;if(gm.map&&gm!==MAT_SAND&&(!gm.isMeshPhongMaterial||gm.userData.pbr))gm.map.repeat.set(size/THEME._m.gtile,size/THEME._m.gtile);
  const lm=new THREE.Mesh(lg,gm);lm.userData.noMerge=1;lm.receiveShadow=true;world.add(lm);worldMeshes.push(lm);
  // beach ring: rel from -5 (under the land edge) out to +40 on the sea floor
  const RS=[-5,-3.2,-2,-1,0,0.7,1.4,2.2,3.5,5.5,8,12,18,26,40];const pos=[],col=[],uv=[],idx=[];const NR=RS.length;
  for(let i=0;i<=NA;i++){const th=i/NA*Math.PI*2,R=islR(th);for(let j=0;j<NR;j++){const rel=RS[j],r=R+rel,x=Math.cos(th)*r,z=Math.sin(th)*r;const y=rel<-3?-0.012:islBeachY(rel);pos.push(x,y,z);uv.push(x/6,z/6);
    const wet=rel>-0.6?Math.min(1,(rel+0.6)/1.6):0,deep=rel>1.4?Math.min(1,(rel-1.4)/14):0;const k=1-wet*0.22;col.push(k*(1-deep*0.45),k*(1-deep*0.32),k*(1-deep*0.18));}}
  for(let i=0;i<NA;i++)for(let j=0;j<NR-1;j++){const a=i*NR+j,b=(i+1)*NR+j;idx.push(a,b,a+1,b,b+1,a+1);}
  const bg=new THREE.BufferGeometry();bg.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));bg.setAttribute('color',new THREE.Float32BufferAttribute(col,3));bg.setAttribute('uv',new THREE.Float32BufferAttribute(uv,2));bg.setIndex(idx);bg.computeVertexNormals();
  const bm=new THREE.Mesh(bg,M.beach);bm.userData.noMerge=1;bm.receiveShadow=true;world.add(bm);
  const sb=new THREE.Mesh(new THREE.PlaneGeometry(2600,2600),M.seabed);sb.rotation.x=-Math.PI/2;sb.position.y=-2.75;sb.userData.noMerge=1;world.add(sb);}
/* open ocean: waves, sun glint, sky reflection, shallow turquoise -> deep blue, shoreline foam */
function islOcean(){const U=Object.assign(THREE.UniformsUtils.clone(THREE.UniformsLib.fog),{uT:WSH.uT,uR0:{value:ISL.R0},uA:{value:new THREE.Vector3(...ISL.A)},uP:{value:new THREE.Vector3(...ISL.P)},
    uSun:{value:new THREE.Vector3(44,40,27).normalize()},uSky:{value:new THREE.Color(THEME.sky).lerp(new THREE.Color(0x6f9fd0),0.45)},uDeep:{value:new THREE.Color(0x0a3f66)},uShal:{value:new THREE.Color(0x27b8c2)}});
  const m=new THREE.ShaderMaterial({uniforms:U,transparent:true,depthWrite:false,fog:true,
    vertexShader:`varying vec3 vW;\n#include <fog_pars_vertex>\nvoid main(){vec4 wp=modelMatrix*vec4(position,1.0);vW=wp.xyz;vec4 mvPosition=viewMatrix*wp;gl_Position=projectionMatrix*mvPosition;\n#include <fog_vertex>\n}`,
    fragmentShader:`uniform float uT,uR0;uniform vec3 uA,uP,uSun,uSky,uDeep,uShal;varying vec3 vW;
#include <fog_pars_fragment>
float islR(float th){return uR0*(1.0+uA.x*sin(3.0*th+uP.x)+uA.y*sin(5.0*th+uP.y)+uA.z*sin(7.0*th+uP.z));}
void main(){vec2 p=vW.xz;float rel=length(p)-islR(atan(p.y,p.x));
  vec2 g=vec2(0.0);
  g+=0.30*vec2(0.8,0.6)*cos(dot(p,vec2(0.8,0.6))*0.55+uT*1.3);
  g+=0.22*vec2(-0.5,0.86)*cos(dot(p,vec2(-0.5,0.86))*0.9+uT*1.7);
  g+=0.14*vec2(0.96,-0.28)*cos(dot(p,vec2(0.96,-0.28))*1.6+uT*2.3);
  g+=0.08*vec2(-0.7,-0.7)*cos(dot(p,vec2(-0.7,-0.7))*2.7+uT*3.1);
  vec3 n=normalize(vec3(-g.x*0.55,1.0,-g.y*0.55));
  vec3 V=normalize(cameraPosition-vW);float fr=pow(1.0-max(dot(n,V),0.0),3.0);
  float dk=smoothstep(0.5,30.0,rel);vec3 col=mix(uShal,uDeep,dk);
  col=mix(col,uSky,0.15+fr*0.5);
  float sp=pow(max(dot(reflect(-uSun,n),V),0.0),160.0);col+=vec3(1.0,0.95,0.85)*sp*1.6;
  float wave=sin(rel*2.4-uT*1.8+sin(atan(p.y,p.x)*23.0)*1.5)*0.5+0.5;
  float foam=smoothstep(2.6,0.9,rel)*(0.35+0.65*wave)+smoothstep(1.6,1.0,rel);
  col=mix(col,vec3(0.96,0.98,1.0),clamp(foam,0.0,1.0)*0.75);
  float a=mix(0.45,0.94,smoothstep(1.0,12.0,rel));a=max(a,clamp(foam,0.0,1.0)*0.85);
  if(rel<0.9)discard;
  gl_FragColor=vec4(col,a);
