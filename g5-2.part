  const t0=c.clone().addScaledVector(u,R*0.45).addScaledVector(v,-R*0.95).addScaledVector(ax,-0.01),t1=t0.clone().addScaledVector(ax,0.04).addScaledVector(u,-0.01),t2=t1.clone().addScaledVector(ax,0.022);hLimb(g,M.glove,pc.clone().addScaledVector(v,-0.02),t0,0.013,0.012);hLimb(g,M.glove,t0,t1,0.012,0.011);hLimb(g,M.skin,t1,t2,0.0105,0.009);
