  const P=(c,s=30)=>gunMat(c,Math.max(8,s),s>=50?'metal':'poly');
  const skin=gunMat(0x4a4f57,55,'metal'),black=gunMat(0x222428,48,'metal'),glove=gunMat(0x2a2a26,5,'poly'),sleeve=Lm({color:0x56603a,map:gunNoise('poly')}),steel=gunMat(0xc9ced4,110,'metal'),wood=gunMat(0x7a4a24,18,'wood'),metal=gunMat(0x6e737a,80,'metal'),poly=gunMat(0x1b1c1e,14,'poly'),dark=new THREE.MeshBasicMaterial({color:0x050506}),glass=new THREE.MeshPhongMaterial({color:0x13263a,shininess:120,specular:0x8aa8c8,envMap:typeof gunEnv==='function'?gunEnv():null,combine:THREE.MixOperation,reflectivity:0.45});
  if(ICON){glove.visible=false;sleeve.visible=false;}
  const fm=new THREE.MeshBasicMaterial({color:0xffd27a,transparent:true,opacity:0.95,blending:THREE.AdditiveBlending,depthWrite:false,side:THREE.DoubleSide});
  const mk=(par,w,h,d,mat,x,y,z,rx=0,ry=0,rz=0)=>{const m=new THREE.Mesh(boxPx(w,h,d),mat);m.position.set(x,y,z);m.rotation.set(rx,ry,rz);par.add(m);return m;};
  const cyl=(par,r,len,mat,x,y,z,axis='z')=>{const m=new THREE.Mesh(cylPx(r,len),mat);m.position.set(x,y,z);if(axis==='z')m.rotation.x=Math.PI/2;else if(axis==='x')m.rotation.z=Math.PI/2;par.add(m);return m;};
  const flash=(par,z,s=1)=>{const f=new THREE.Group();for(let i=0;i<3;i++){const pl=new THREE.Mesh(new THREE.PlaneGeometry(0.17*s,0.17*s),fm);pl.rotation.z=i*1.05;f.add(pl);}const p2=new THREE.Mesh(new THREE.PlaneGeometry(0.07*s,0.24*s),fm);p2.rotation.set(Math.PI/2,0,0);p2.position.z=-0.07*s;f.add(p2);f.position.set(0,0.005,z);f.visible=false;par.add(f);return f;};
  const HM=handMats();
  const pistolHands=g=>{if(ICON)return;handGrip(g,HM,{c:new V3(0.004,-0.072,0.03),tilt:0.28,r:0.019,side:1});handSupport(g,HM,{c:new V3(-0.004,-0.084,0.02),r:0.036});};
  const longHands=(g,fz,fy=-0.055)=>{if(ICON)return;handGrip(g,HM,{c:new V3(0.005,-0.088,0.022),tilt:0.36,r:0.02,side:1,arm:new V3(0.07,-0.13,0.3)});handFore(g,HM,{c:new V3(-0.002,fy-0.012,fz),r:0.025});};
  const grip=(g,z=0)=>{const m=mk(g,0.045,0.11,0.05,poly,0,-0.09,z,-0.35);for(let i=0;i<4;i++)mk(g,0.047,0.006,0.03,black,0,-0.06-i*0.022,z+0.008+i*0.008,-0.35);tguard(g,z-0.05);return m;};
  const tguard=(g,z,y=-0.045)=>{const t=new THREE.Mesh(new THREE.TorusGeometry(0.026,0.0045,6,14,Math.PI),black);t.rotation.set(0,Math.PI/2,Math.PI);t.position.set(0,y,z);g.add(t);mk(g,0.004,0.022,0.004,metal,0,y-0.006,z+0.004,0.3);};
