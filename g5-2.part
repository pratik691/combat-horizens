  g=new THREE.Group();mk(g,0.055,0.09,0.32,skin,0,0,-0.1);mk(g,0.045,0.055,0.14,black,0,0.005,-0.31);mk(g,0.02,0.02,0.05,black,0,0.01,-0.4);mk(g,0.04,0.18,0.05,black,0,-0.13,-0.16,0.32);grip(g,0.03);mk(g,0.03,0.04,0.2,black,0,0.0,0.15);mk(g,0.02,0.04,0.02,black,0,0.065,-0.33);longHands(g,-0.3);cyl(g,0.026,0.2,black,0,0.01,-0.52);vm.flash.mp5=flash(g,-0.63,0.7);vm.models.mp5=g;
