  if(A.carry>0.002){const c=A.carry;_cq.copy(CARRY.q);m.gun.quaternion.slerp(_cq,c);m.gun.rotation.x+=breathe*0.4*c;m.gun.position.lerp(CARRY.p,c);m.gun.position.y+=breathe*0.15*c;
    m.up.rotation.y+=0.22*c;m.head.rotation.y-=0.3*c;m.head.rotation.x+=0.05*c;}
  soldierArms(m);}
