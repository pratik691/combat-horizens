  g=new THREE.Group();mk(g,0.05,0.06,0.27,skin,0,0.025,-0.1);mk(g,0.046,0.035,0.22,metal,0,-0.02,-0.08);mk(g,0.05,0.13,0.065,black,0,-0.09,0.03,-0.22);mk(g,0.03,0.03,0.03,black,0,0.03,-0.24);pistolHands(g);vm.flash.deagle=flash(g,-0.27,1.3);vm.models.deagle=g;
