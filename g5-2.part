  geo.translate(0,0,-(w-2*b)/2);geo.rotateY(Math.PI/2);
  const pos=geo.attributes.position,uv=geo.attributes.uv;for(let i=0;i<pos.count;i++)uv.setXY(i,pos.getZ(i)/0.12,pos.getY(i)/0.12+pos.getX(i)/0.12);
  geo.computeVertexNormals();fsizeConst(geo,0,0);return _profG[key]=geo;}
const _pe=new Map();function profEdges(geo){if(_pe.has(geo))return _pe.get(geo);const e=new THREE.EdgesGeometry(geo,25);_pe.set(geo,e);return e;}
function arcPts(cz,cy,r0,r1,a0,a1,n){const o=[],inn=[];for(let i=0;i<=n;i++){const a=a0+(a1-a0)*i/n;o.push([cz+Math.sin(a)*r1,cy-Math.cos(a)*r1]);inn.push([cz+Math.sin(a)*r0,cy-Math.cos(a)*r0]);}return o.concat(inn.reverse());}
