function texFromImg(im,key){if(_rtex[key])return _rtex[key];return hdTex(im,key,'stock');}
function tintTex(url,col,key){if(_rtex[key])return _rtex[key];const im=HZIMG[url];if(!im||!im.complete||!im.naturalWidth)return null;
  const c=document.createElement('canvas');c.width=im.naturalWidth;c.height=im.naturalHeight;const x=c.getContext('2d');x.drawImage(im,0,0);
  x.globalCompositeOperation='color';x.globalAlpha=0.72;x.fillStyle='#'+col.toString(16).padStart(6,'0');x.fillRect(0,0,c.width,c.height);
  x.globalAlpha=1;x.globalCompositeOperation='destination-in';x.drawImage(im,0,0);x.globalCompositeOperation='source-over';return hdTex(c,key,'stock');}
function paintedTex(url,pid,key){
  const im=HZIMG[url];if(!im||!im.complete||!im.naturalWidth)return null;
  const p=pid&&PAINTS[pid];if(!p||pid==='stock')return texFromImg(im,url);
  if(_rtex[key])return _rtex[key];
