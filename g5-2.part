  m.head.rotation.x=-A.pitch*0.45-m.up.rotation.x*0.5+0.02*Math.sin(A.breath*0.5)*idle;m.head.rotation.y=-m.up.rotation.y*0.7+Math.sin(A.shift*1.7)*0.12*idle;
