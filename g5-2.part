  else{m.legL.rotation.x=amp*L-1.05*c+shift;m.legR.rotation.x=amp*R-1.05*c-shift;m.legL.rotation.z=-0.02-0.06*c;m.legR.rotation.z=0.02+0.06*c;
    m.kneeL.rotation.x=0.1+amp*(1.25*Math.max(0,cl)+0.18*Math.max(0,-cl))+1.75*c;m.kneeR.rotation.x=0.1+amp*(1.25*Math.max(0,cr2)+0.18*Math.max(0,-cr2))+1.75*c;
    m.pelvis.position.y=0.92-0.045*amp*Math.abs(L)+0.012*amp-0.33*c+0.004*Math.sin(A.breath)*idle;}
  m.pelvis.rotation.y=0.13*amp*L;m.pelvis.rotation.z=0.035*amp*Math.cos(ph)+shift*0.3;m.pelvis.position.x=Math.sin(A.shift)*0.015*idle;
