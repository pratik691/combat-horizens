/* ===== HD gun textures: pixel-art aware 4× upscale (EPX/Scale2x twice), per-texel specular map and reflections ===== */
function readPx(c){const t=document.createElement('canvas');t.width=c.width;t.height=c.height;const x=t.getContext('2d',{willReadFrequently:true});x.drawImage(c,0,0);return x.getImageData(0,0,c.width,c.height);}
function epx(src){const w=src.width,h=src.height,sx=readPx(src).data;const out=document.createElement('canvas');out.width=w*2;out.height=h*2;const oc=out.getContext('2d'),od=oc.createImageData(w*2,h*2),o=od.data;
  const px=(x,y)=>{x=x<0?0:x>=w?w-1:x;y=y<0?0:y>=h?h-1:y;return(y*w+x)*4;};const eq=(a,b)=>sx[a]===sx[b]&&sx[a+1]===sx[b+1]&&sx[a+2]===sx[b+2]&&sx[a+3]===sx[b+3];
  const put=(X,Y,i)=>{const d=(Y*w*2+X)*4;o[d]=sx[i];o[d+1]=sx[i+1];o[d+2]=sx[i+2];o[d+3]=sx[i+3];};
  for(let y=0;y<h;y++)for(let x=0;x<w;x++){const P=px(x,y),A=px(x,y-1),B=px(x+1,y),C=px(x-1,y),D=px(x,y+1);
