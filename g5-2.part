  hArm(g,M,wrist,wrist.clone().add(o.arm||new V3(0.06,-0.12,0.3)));return g;}
/* left hand cupping the right hand on a pistol (two-handed grip) */
function handSupport(par,M,o){const g=new THREE.Group();par.add(g);const c=o.c,R=o.r;const ax=new V3(0,0.96,0.28).normalize(),u=new V3(-1,0,0),v=new V3().crossVectors(ax,u).normalize();
