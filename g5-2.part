/* ===== GUNSMITH v2: guns cut from side-profile silhouettes (bevelled extrusions) + barrels, rails, sights, muzzle devices ===== */
const VM2_OVR={deagle:{t:'pistol',len:1.25,big:1},mp5:{t:'smg',len:1,stock:'fixed',mag:'curved',round:1},thompson:{t:'smg',len:1.15,stock:'wood',mag:'drum',furn:'wood',fins:1},remington:{t:'shotgun',pump:1,furn:'wood'},spas:{t:'shotgun',pump:1,furn:'black',stock:'fold'},
  m4a4:{t:'rifle',ar:1,mag:'straight',stock:'ar'},m1a:{t:'rifle',furn:'wood',stock:'wood',mag:'straight',len:1.35,wood:1},barrett:{t:'sniper',len:1.3,auto:1,big:1}};
const _profG={};
function profGeo(pts,w,holes,bev){const key=JSON.stringify([pts,w,holes||0,bev]);if(_profG[key])return _profG[key];
  const sh=new THREE.Shape();pts.forEach(([z,y],i)=>i?sh.lineTo(-z,y):sh.moveTo(-z,y));sh.closePath();
  if(holes)for(const h of holes){const p=new THREE.Path();h.forEach(([z,y],i)=>i?p.lineTo(-z,y):p.moveTo(-z,y));p.closePath();sh.holes.push(p);}
