/* left hand under a rifle handguard: palm below, fingers curling up the right side, thumb along the left */
function handFore(par,M,o){const g=new THREE.Group();par.add(g);const c=o.c,R=o.r+0.009;const ax=new V3(0,0,-1),u=new V3(0,-1,0),v=new V3(1,0,0);
