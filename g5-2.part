      x.globalAlpha=1;x.globalCompositeOperation='destination-in';x.drawImage(im,0,0);x.globalCompositeOperation='source-over';if(_rtex[key]&&_rtex[key].userData.regen)_rtex[key].userData.regen();};
    if(fi.complete&&fi.naturalWidth)draw();else fi.onload=draw;}
  else{const col='#'+p.c.toString(16).padStart(6,'0');x.globalCompositeOperation='color';x.fillStyle=col;x.fillRect(0,0,c.width,c.height);x.globalCompositeOperation='overlay';x.globalAlpha=0.35;x.fillRect(0,0,c.width,c.height);
