/* ---- Bedrock geometry → three.js ---- */
function addCube(c,bp,pos,uv,tw,th,yCut){
  const o=c[1],s=c[2],inf=c[3]||0,cp=c[4],cr=c[5],F=c[6];
  let y0=o[1]-inf,y1=o[1]+s[1]+inf;if(yCut){y0=Math.max(y0,yCut[0]);y1=Math.min(y1,yCut[1]);if(y1<=y0)return;}
  const x0=-(o[0]+s[0])-inf,x1=-o[0]+inf,z0=o[2]-inf,z1=o[2]+s[2]+inf;
  let M=null;if(cr&&(cr[0]||cr[1]||cr[2])){const P=new V3(-cp[0],cp[1],cp[2]);M=new THREE.Matrix4().makeTranslation(P.x,P.y,P.z).multiply(new THREE.Matrix4().makeRotationFromEuler(new THREE.Euler(-cr[0]*DEG,-cr[1]*DEG,cr[2]*DEG,'ZYX'))).multiply(new THREE.Matrix4().makeTranslation(-P.x,-P.y,-P.z));}
  const tv=new V3();const V=(x,y,z)=>{tv.set(x,y,z);if(M)tv.applyMatrix4(M);return[tv.x-bp[0],tv.y-bp[1],tv.z-bp[2]];};
  const faces=[ // north, east, south, west, up, down — corners TL,TR,BR,BL seen from outside
    [[x1,y1,z0],[x0,y1,z0],[x0,y0,z0],[x1,y0,z0]],
    [[x1,y1,z1],[x1,y1,z0],[x1,y0,z0],[x1,y0,z1]],
    [[x0,y1,z1],[x1,y1,z1],[x1,y0,z1],[x0,y0,z1]],
    [[x0,y1,z0],[x0,y1,z1],[x0,y0,z1],[x0,y0,z0]],
    [[x0,y1,z0],[x1,y1,z0],[x1,y1,z1],[x0,y1,z1]],
    [[x0,y0,z1],[x1,y0,z1],[x1,y0,z0],[x0,y0,z0]]];
  for(let i=0;i<6;i++){const f=F[i];if(!f)continue;const q=faces[i].map(p=>V(p[0],p[1],p[2]));
    const u1=f[0]/tw,v1=1-f[1]/th,u2=(f[0]+f[2])/tw,v2=1-(f[1]+f[3])/th;
    const U=[[u1,v1],[u2,v1],[u2,v2],[u1,v2]];
