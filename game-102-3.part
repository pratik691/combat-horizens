const MOB=(('ontouchstart' in window)&&(navigator.maxTouchPoints||0)>0)||/CombatHorizensApp|Android|iPhone|iPad|Mobile/i.test(navigator.userAgent||'');
/* 0.77: Graphics "Auto" (adapts to the device) + shadow size follows the quality level, instead of the forced High + 4096 shadows */
if(save.gfxV!==2){const fresh=!save.gfxV;save.gfxV=2;if(!save.qual||save.qual==='high'||fresh)save.qual='auto';
  save.vid=Object.assign({},save.vid||{});if(!save.vid.shadowq||save.vid.shadowq==='vhigh'||save.vid.shadowq==='ultra')save.vid.shadowq='auto';
  if(MOB){save.vid.msaa='none';if(save.vid.fsr===undefined)save.vid.fsr='off';}
  try{localStorage.setItem('dustline_v1',JSON.stringify(save));}catch(e){}}
const VID0=Object.assign({msaa:MOB?'none':'4x',lowlat:'on'},save.vid||{});
const renderer=new THREE.WebGLRenderer({canvas,antialias:VID0.msaa!=='none',powerPreference:VID0.lowlat==='boost'?'high-performance':'default',desynchronized:VID0.lowlat!=='off'});
renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
const QUAL={high:{pr:2,sh:2048},medium:{pr:1.25,sh:1024},low:{pr:0.8,sh:512}};let qualNow='high';
function setQuality(q){if(!QUAL[q]||q===qualNow)return;qualNow=q;try{groundDetUpd();}catch(e){}const Q=QUAL[q];if(typeof applyPixelRatio==='function'&&typeof VID_DEF!=='undefined'){try{applyPixelRatio();}catch(e){renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,Q.pr));}}else renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,Q.pr)*(typeof vidScale==='function'?vidScale():1));if(typeof resize==='function')resize();
  if(typeof sun!=='undefined'){sun.shadow.mapSize.set(Q.sh,Q.sh);sunShadowFit(Q.sh);if(sun.shadow.map){sun.shadow.map.dispose();sun.shadow.map=null;}}if(typeof applyShadowQ==='function')applyShadowQ();}
renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.autoClear=false;
const scene=new THREE.Scene();
const SKY=0xd8ccb2;scene.background=new THREE.Color(SKY);scene.fog=new THREE.Fog(SKY,10,90);
const camera=new THREE.PerspectiveCamera(save.fov,1,0.05,700);camera.rotation.order='YXZ';scene.add(camera);
scene.add(new THREE.HemisphereLight(0xfff4e0,0x8a7350,0.85));
const sun=new THREE.DirectionalLight(0xfff0d6,0.95);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);
{const c=sun.shadow.camera;c.left=-55;c.right=55;c.top=55;c.bottom=-55;c.near=1;c.far=260;c.updateProjectionMatrix();}sunShadowFit(sun.shadow.mapSize.x);sun.shadow.bias=-0.0006;sun.shadow.normalBias=0.04;
scene.add(sun);scene.add(sun.target);
const vmScene=new THREE.Scene();const vmCam=new THREE.PerspectiveCamera(72,1,0.01,10);
vmScene.add(new THREE.HemisphereLight(0xfff2dd,0x6b5a40,0.85));{const vd=new THREE.DirectionalLight(0xffffff,0.75);vd.position.set(1,2,1);vmScene.add(vd);const rim=new THREE.DirectionalLight(0xbfd8ff,0.3);rim.position.set(-1.2,0.05,-1.6);vmScene.add(rim);const fill=new THREE.DirectionalLight(0xffd9a8,0.18);fill.position.set(-0.6,-0.8,1);vmScene.add(fill);}
function resize(){const w=innerWidth,h=innerHeight;renderer.setSize(w,h);camera.aspect=w/h;camera.updateProjectionMatrix();vmCam.aspect=w/h;vmCam.updateProjectionMatrix();}
addEventListener('resize',resize);resize();
if(!save.gfxV){save.gfxV=1;if(!save.qual||save.qual==='auto'||save.qual==='low'||save.qual==='medium')save.qual='high';save.vid=Object.assign({},save.vid||{},{hdr:'quality',shadowq:'vhigh',detail:'high',fx:'high',filter:'aniso16'});try{localStorage.setItem('dustline_v1',JSON.stringify(save));}catch(e){}}
setTimeout(()=>{const q=save.qual||'auto';setQuality(q==='auto'?(MOB?'medium':'high'):q);},0);
setTimeout(()=>{try{if(save.gfx4k!==1){save.gfx4k=1;const mob=typeof touchCapable==='function'&&touchCapable();if(!mob&&gpuStrong()){save.vid=Object.assign({},save.vid||{},{res:'4k',shadowq:'ultra'});}persist();if(typeof applyVideo==='function')applyVideo();}}catch(e){}},0);

/* ================= TEXTURES / MATERIALS ================= */
function canvasTex(size,draw,h){const c=document.createElement('canvas');c.width=size;c.height=h||size;draw(c.getContext('2d'),size,h||size);const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;return t;}
/* ---- wooden crate face: varied planks with grain, gaps, bevelled frame, diagonal brace, nails, stencil ---- */
function drawCrate(x,s,stencil){let sd=1337;const R=()=>((sd=(Math.imul(sd,1103515245)+12345)>>>0)/4294967296);
  const plank=(x0,y0,w,h,hor,base)=>{const tone=0.86+R()*0.26;const c=base.map(v=>Math.min(255,v*tone|0));const g=hor?x.createLinearGradient(0,y0,0,y0+h):x.createLinearGradient(x0,0,x0+w,0);
    g.addColorStop(0,`rgb(${c[0]+14},${c[1]+10},${c[2]+6})`);g.addColorStop(0.5,`rgb(${c})`);g.addColorStop(1,`rgb(${c[0]-22},${c[1]-18},${c[2]-12})`);x.fillStyle=g;x.fillRect(x0,y0,w,h);
    x.save();x.beginPath();x.rect(x0,y0,w,h);x.clip();for(let i=0;i<(hor?h:w)/2.2;i++){x.strokeStyle=`rgba(${R()<.5?60:40},${R()<.5?36:28},18,${0.08+R()*0.16})`;x.lineWidth=0.6+R()*1.1;x.beginPath();
      if(hor){const yy=y0+R()*h,amp=R()*2.2,ph=R()*6;x.moveTo(x0,yy);for(let t=0;t<=w;t+=8)x.lineTo(x0+t,yy+Math.sin(t*0.035+ph)*amp);}else{const xx=x0+R()*w,amp=R()*2.2,ph=R()*6;x.moveTo(xx,y0);for(let t=0;t<=h;t+=8)x.lineTo(xx+Math.sin(t*0.035+ph)*amp,y0+t);}x.stroke();}
    if(R()<0.8){const kx=x0+R()*w,ky=y0+R()*h,kr=2+R()*4;const kg=x.createRadialGradient(kx,ky,0,kx,ky,kr*2.2);kg.addColorStop(0,'rgba(55,32,14,.75)');kg.addColorStop(0.45,'rgba(80,50,22,.4)');kg.addColorStop(1,'rgba(80,50,22,0)');x.fillStyle=kg;x.beginPath();x.ellipse(kx,ky,hor?kr*2.2:kr,hor?kr:kr*2.2,0,0,7);x.fill();}
    x.restore();x.fillStyle='rgba(30,18,8,.55)';if(hor)x.fillRect(x0,y0+h-1.5,w,1.5);else x.fillRect(x0+w-1.5,y0,1.5,h);};
  const base=[176,128,74],dark=[140,98,54];x.fillStyle='#2a1a0c';x.fillRect(0,0,s,s);
  const n=6,ph=s/n;for(let i=0;i<n;i++)plank(0,i*ph,s,ph,true,base);
  const F=s*0.12;const bev=(x0,y0,w,h,hor)=>{plank(x0,y0,w,h,hor,dark);x.fillStyle='rgba(255,230,190,.16)';hor?x.fillRect(x0,y0,w,2):x.fillRect(x0,y0,2,h);x.fillStyle='rgba(0,0,0,.35)';hor?x.fillRect(x0,y0+h-2,w,2):x.fillRect(x0+w-2,y0,2,h);};
  x.fillStyle='rgba(0,0,0,.35)';x.fillRect(F,F,s-2*F,4);x.fillRect(F,F,4,s-2*F);
  // diagonal brace with drop shadow
  x.save();x.translate(s/2,s/2);x.rotate(Math.PI/4);const L=Math.hypot(s-2*F,s-2*F);x.fillStyle='rgba(0,0,0,.4)';x.fillRect(-L/2,-F*0.42+4,L,F*0.84);x.restore();
  x.save();x.beginPath();x.rect(F,F,s-2*F,s-2*F);x.clip();x.translate(s/2,s/2);x.rotate(Math.PI/4);plank(-L/2,-F*0.42,L,F*0.84,true,dark);x.fillStyle='rgba(255,230,190,.14)';x.fillRect(-L/2,-F*0.42,L,2);x.restore();
  bev(0,0,s,F,true);bev(0,s-F,s,F,true);bev(0,F,F,s-2*F,false);bev(s-F,F,F,s-2*F,false);
  // nails
  for(const[nx,ny]of[[F/2,F/2],[s-F/2,F/2],[F/2,s-F/2],[s-F/2,s-F/2],[s/2,F/2],[s/2,s-F/2],[F/2,s/2],[s-F/2,s/2]]){const g=x.createRadialGradient(nx-1,ny-1,0,nx,ny,3.2);g.addColorStop(0,'#d8d4cc');g.addColorStop(0.6,'#6a655e');g.addColorStop(1,'rgba(20,15,10,.8)');x.fillStyle=g;x.beginPath();x.arc(nx,ny,3,0,7);x.fill();
    x.fillStyle='rgba(90,40,10,.25)';x.beginPath();x.ellipse(nx+2,ny+5,2.5,5,0,0,7);x.fill();}
  if(stencil){x.save();x.globalAlpha=0.55;x.fillStyle='#1d140b';x.font=`900 ${s*0.075}px Arial`;x.textAlign='center';x.fillText('COMBAT HORIZENS',s/2,s*0.36);x.font=`700 ${s*0.055}px Arial`;x.fillText('7.62 × 39 · 1440 RDS',s/2,s*0.7);x.font=`900 ${s*0.05}px Arial`;x.fillText('▲ THIS SIDE UP ▲',s/2,s*0.8);x.restore();}
  speckle(x,s,900,0.1);}
function speckle(x,s,n,a){for(let i=0;i<n;i++){const v=Math.random()<.5?0:255;x.fillStyle=`rgba(${v},${v},${v},${Math.random()*a})`;const r=Math.random()*2.5+0.5;x.fillRect(Math.random()*s,Math.random()*s,r,r);}}

/* ===== HD wall textures v2 (512px, seamless) + world-space weathering shader for building walls ===== */
function wrap9(x,s,f){for(const ox of[-s,0,s])for(const oy of[-s,0,s]){x.save();x.translate(ox,oy);f();x.restore();}}
function hdNoise(x,s,n,amin,amax,rmin,rmax,dark){for(let i=0;i<n;i++){const px=Math.random()*s,py=Math.random()*s,r=rmin+Math.random()*(rmax-rmin),a=amin+Math.random()*(amax-amin),d=dark===undefined?Math.random()<0.5:dark;
  wrap9(x,s,()=>{const g=x.createRadialGradient(px,py,0,px,py,r);g.addColorStop(0,d?`rgba(60,50,40,${a})`:`rgba(255,255,255,${a})`);g.addColorStop(1,'rgba(0,0,0,0)');x.fillStyle=g;x.fillRect(px-r,py-r,2*r,2*r);});}}
function hdGrain(x,s,n,a){for(let i=0;i<n;i++){const v=Math.random()<.5?40:255;x.fillStyle=`rgba(${v},${v},${v},${Math.random()*a})`;const r=Math.random()*1.8+0.6;x.fillRect(Math.random()*s,Math.random()*s,r,r);}}
function hdCracks(x,s,n,a,len){x.lineCap='round';for(let i=0;i<n;i++){let px=Math.random()*s,py=Math.random()*s;const pts=[[px,py]];let ang=Math.random()*6.28;for(let k=0;k<len;k++){ang+=(Math.random()-0.5)*1.1;px+=Math.cos(ang)*(5+Math.random()*7);py+=Math.sin(ang)*(5+Math.random()*7);pts.push([px,py]);}
  wrap9(x,s,()=>{x.strokeStyle=`rgba(40,32,26,${a})`;x.lineWidth=1.1;x.beginPath();x.moveTo(pts[0][0],pts[0][1]);for(const q of pts)x.lineTo(q[0],q[1]);x.stroke();x.strokeStyle=`rgba(255,255,255,${a*0.35})`;x.lineWidth=0.8;x.beginPath();x.moveTo(pts[0][0]+1,pts[0][1]+1);for(const q of pts)x.lineTo(q[0]+1,q[1]+1);x.stroke();});}}
function hdPocks(x,s,n){for(let i=0;i<n;i++){const px=Math.random()*s,py=Math.random()*s,r=1.5+Math.random()*3;wrap9(x,s,()=>{x.fillStyle='rgba(50,40,32,.45)';x.beginPath();x.arc(px,py,r,0,7);x.fill();x.fillStyle='rgba(255,255,255,.25)';x.beginPath();x.arc(px+r*0.5,py+r*0.5,r*0.7,0,3.14);x.fill();});}}
const texPlaster=canvasTex(512,(x,s)=>{x.fillStyle='#efefef';x.fillRect(0,0,s,s);
  hdNoise(x,s,40,0.03,0.06,60,160,false);hdNoise(x,s,30,0.02,0.045,60,160,true);hdNoise(x,s,60,0.02,0.05,8,26);
  // trowel sweeps
  for(let i=0;i<70;i++){const px=Math.random()*s,py=Math.random()*s,r=20+Math.random()*50,a0=Math.random()*6.28,lt=Math.random()<.5;wrap9(x,s,()=>{x.strokeStyle=lt?'rgba(255,255,255,.10)':'rgba(70,60,50,.06)';x.lineWidth=6+Math.random()*10;x.beginPath();x.arc(px,py,r,a0,a0+0.9+Math.random());x.stroke();});}
  hdGrain(x,s,16000,0.14);
  // chipped patches showing the brick underneath
  for(let i=0;i<0;i++){const cx=60+Math.random()*(s-120),cy=60+Math.random()*(s-120),rw=24+Math.random()*30,rh=16+Math.random()*20;x.save();x.beginPath();for(let k=0;k<14;k++){const a=k/14*6.283,rr=0.7+Math.random()*0.45;x.lineTo(cx+Math.cos(a)*rw*rr,cy+Math.sin(a)*rh*rr);}x.closePath();
    x.fillStyle='#b9aea2';x.fill();x.clip();for(let r=-4;r<5;r++)for(let c=-4;c<5;c++){const o=r%2?11:0;x.fillStyle=`rgb(${170+Math.random()*30|0},${150+Math.random()*25|0},${135+Math.random()*20|0})`;x.fillRect(cx+c*22+o-10,cy+r*9-4,20,7);}x.restore();
    x.strokeStyle='rgba(60,50,40,.55)';x.lineWidth=1.5;x.beginPath();for(let k=0;k<=14;k++){const a=k/14*6.283;x.lineTo(cx+Math.cos(a)*rw*0.95,cy+Math.sin(a)*rh*0.95);}x.stroke();}
  hdCracks(x,s,5,0.28,12);});
const texGround=canvasTex(256,(x,s)=>{x.fillStyle='#d2bd93';x.fillRect(0,0,s,s);speckle(x,s,9000,0.14);for(let i=0;i<40;i++){x.fillStyle=`rgba(120,95,60,${Math.random()*0.12})`;x.beginPath();x.arc(Math.random()*s,Math.random()*s,Math.random()*18+4,0,7);x.fill();}});
const texCrate=canvasTex(256,(x,s)=>drawCrate(x,s,false));
if(window.CR_PBR&&CR_PBR.wood){const im=new Image();im.onload=()=>{const c=texCrate.image,x=c.getContext('2d');x.save();x.globalCompositeOperation='overlay';x.globalAlpha=0.7;x.drawImage(im,0,0,c.width,c.height);x.restore();texCrate.needsUpdate=true;};im.src=CR_PBR.wood.c;}
const texTarget=canvasTex(128,(x,s)=>{const c=s/2;for(const[r,col]of[[1,'#f4f4f4'],[0.8,'#d92b2b'],[0.55,'#f4f4f4'],[0.35,'#d92b2b'],[0.22,'#f4f4f4'],[0.11,'#d92b2b']]){x.fillStyle=col;x.beginPath();x.arc(c,c,r*c,0,7);x.fill();}});
const texRoad=canvasTex(128,(x,s)=>{x.fillStyle='#77736d';x.fillRect(0,0,s,s);speckle(x,s,4000,0.2);});
const texLadder=canvasTex(64,(x,s)=>{x.clearRect(0,0,s,s);x.fillStyle='#6b6f74';x.fillRect(2,0,7,s);x.fillRect(s-9,0,7,s);x.fillStyle='#8a8f95';x.fillRect(4,s/2-3,s-8,6);});
function letterTex(L){return canvasTex(128,(x,s)=>{x.clearRect(0,0,s,s);x.strokeStyle='rgba(255,140,30,.85)';x.lineWidth=6;x.setLineDash([14,10]);x.strokeRect(5,5,s-10,s-10);x.setLineDash([]);x.fillStyle='rgba(255,140,30,.35)';x.font='bold 84px Arial';x.textAlign='center';x.textBaseline='middle';x.fillText(L,s/2,s/2+4);});}
function signTex(L){return canvasTex(128,(x,s)=>{x.fillStyle='#1f2a33';x.fillRect(0,0,s,s);x.fillStyle='#ff9a3c';x.font='bold 96px Arial';x.textAlign='center';x.textBaseline='middle';x.fillText(L,s/2,s/2+6);});}
{const an=Math.min(8,renderer.capabilities.getMaxAnisotropy?renderer.capabilities.getMaxAnisotropy():1);for(const t of[texRoad,texPlaster,texGround,texCrate])if(t){t.anisotropy=an;t.needsUpdate=true;}}
const Lm=o=>new THREE.MeshLambertMaterial(o);
const MAT={
  walls:[0xe3d2ab,0xd8c296,0xeadfc4,0xcdb489,0xdccaa2,0xc9b799].map(c=>Lm({color:c,map:texPlaster})),
  ledge:Lm({color:0xc4ab80,map:texPlaster}),boundary:Lm({color:0xb59d74,map:texPlaster}),
  crate:Lm({map:texCrate}),door:[0x3f6d5a,0x2e5878,0x6e4b2c,0x4d6e3a].map(c=>Lm({color:c})),
  win:Lm({color:0x2a2f36}),frame:Lm({color:0xf1e6cf}),ground:Lm({map:texGround}),road:Lm({map:texRoad}),
  line:new THREE.MeshBasicMaterial({color:0xf0e6d0}),yellow:new THREE.MeshBasicMaterial({color:0xf2c230}),
  trunk:Lm({color:0x7a5a3a}),leaf:Lm({color:0x667f3c}),sign:Lm({color:0x2f8f4e,emissive:0x0d3a1c}),metal:Lm({color:0x8d9399})
};
/* ---- 0.89 realistic ground: detail level (0 off / .5 mid / 1 full) shared by sand + grass shaders ---- */
const GROUND_DET={value:1};
function groundDetUpd(){let v=1;try{const lo=qualNow==='low'||vid().detail==='low';v=lo?0:(MOB&&qualNow!=='high'?0.5:1);}catch(e){}GROUND_DET.value=v;}
const GNOISE=`float sh21(vec2 p){p=fract(p*vec2(123.34,456.21));p+=dot(p,p+45.32);return fract(p.x*p.y);}
float vn(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);return mix(mix(sh21(i),sh21(i+vec2(1,0)),f.x),mix(sh21(i+vec2(0,1)),sh21(i+vec2(1,1)),f.x),f.y);}
float fbm(vec2 p){return vn(p)*0.6+vn(p*2.03+7.1)*0.28+vn(p*4.1+3.3)*0.12;}`;
