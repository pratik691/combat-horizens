function knifeId(){const k=save.knife;if(!WEAPONS[k]||!WEAPONS[k].melee)return 'knife';if(save.level>=WEAPONS[k].unlock||save.allKnives)return k;const ks=window.CR_HZ&&save.kskin&&window.CR_HZ.kv[save.kskin];return ks&&ks.w===k&&(save.items||[]).some(i=>i.k==='kskin'&&i.v===save.kskin)?k:'knife';}
function patternAt(w,idx){const P=w.pattern;if(!P||idx<=0)return[0,0];const L=P[P.length-1];if(idx>=L[0])return[L[1],L[2]];
  for(let i=1;i<P.length;i++)if(idx<=P[i][0]){const a=P[i-1],b=P[i],k=(idx-a[0])/(b[0]-a[0]);return[a[1]+(b[1]-a[1])*k,a[2]+(b[2]-a[2])*k];}return[L[1],L[2]];}
function rangeMul(w,d){if(w.pellets)return clamp(1-(d-w.range*0.4)/(w.range*1.4),0.12,1);return clamp(1-Math.max(0,d-w.range)/(w.range*4),0.6,1);}
