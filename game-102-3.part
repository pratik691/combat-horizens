","n":"data:image/jpeg;base64,"},"grass":{"c":"data:image/jpeg;base64,","n":"data:image/jpeg;base64,"},"gconcrete":{"c":"data:image/jpeg;base64,","n":"data:image/jpeg;base64,"},"wood":{"c":"data:image/jpeg;base64,"},"wooddetail":{"c":"data:image/jpeg;base64,"},"metal":{"c":"data:image/jpeg;base64,"}};
