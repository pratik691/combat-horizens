<script>
(function(){
if(!window.THREE){document.getElementById('err').classList.remove('hidden');return;}
const V3=THREE.Vector3;
const $=id=>document.getElementById(id);
const clamp=(v,a,b)=>v<a?a:v>b?b:v;
/* rng is swapped for a seeded generator while a map is built, so every player in a multiplayer room gets the identical map */
let rng=Math.random;
function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
const rand=(a,b)=>a+(b-a)*rng();
const pick=a=>a[Math.floor(rng()*a.length)];
const D2R=Math.PI/180;
function angDiff(a,b){let d=a-b;while(d>Math.PI)d-=Math.PI*2;while(d<-Math.PI)d+=Math.PI*2;return d;}
function lerpAng(a,b,t){return a-angDiff(a,b)*t;}
function fmtTime(s){s=Math.max(0,Math.ceil(s));return Math.floor(s/60)+':'+String(s%60).padStart(2,'0');}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

/* ================= SAVE ================= */
const SKINS={desert:{name:'Desert Tan',price:0,color:0xb39a6b},arctic:{name:'Arctic',price:150,color:0xdfe7ec},jungle:{name:'Jungle',price:300,color:0x4a6b2f},crimson:{name:'Crimson',price:450,color:0xa3262a},cobalt:{name:'Cobalt',price:600,color:0x2a5bd7},neon:{name:'Neon Rush',price:800,color:0x19e3c8},gold:{name:'24K Gold',price:1500,color:0xd8b03a}};
const FINS=(window.CR_ASSETS&&window.CR_ASSETS.finishes)||{};const _finTex={};
FINS.sand_viper={n:'Sand Viper',p:3200,ex:1,b:''};
function finUrl(id){return 'data:image/png;base64,'+FINS[id].b;}
function finTex(id){if(!_finTex[id]){const t=new THREE.TextureLoader().load(finUrl(id));t.wrapS=t.wrapT=THREE.RepeatWrapping;_finTex[id]=t;}return _finTex[id];}
let save={coins:200,owned:['desert'],skin:'desert',sens:1,fov:80,vol:0.6,diff:'normal',side:'T',xh:'#7CFF6B',matches:0,kills:0,wins:0,bestPractice:0,level:1,xp:0,totalXp:0,name:'',cat:'bots',knife:'knife',ownedFin:[],knifeFin:'',dmgNums:true,items:[],equipSkin:{},loadout:null,agent:'operator',medal:'',careNext:0,careOffer:null,uidSeq:0};
try{const s=JSON.parse(localStorage.getItem('dustline_v1')||'null');if(s)Object.assign(save,s);}catch(e){}
if(!save.name)save.name='Horizen'+Math.floor(1000+Math.random()*9000);
function persist(){try{localStorage.setItem('dustline_v1',JSON.stringify(save));}catch(e){}}
if(save.dmgNums===undefined)save.dmgNums=true;
document.documentElement.style.setProperty('--xh',save.xh);

/* ================= LEVELS & RANKS ================= */
const MAX_LEVEL=500;
function xpToNext(l){return 800+40*l;}
const RANKS=[[1,'Recruit','#9aa3ad'],[5,'Private','#b9a07a'],[10,'Private First Class','#c8a46a'],[15,'Corporal','#cf9b55'],[22,'Sergeant','#d58c3b'],[30,'Staff Sergeant','#d97a2b'],[39,'Master Sergeant','#de6a2a'],[48,'Lieutenant','#7fb3e0'],[58,'Captain','#5aa0e0'],[68,'Major','#3e8be0'],[78,'Colonel','#8a7df0'],[89,'General','#b06cf0'],[100,'Combat Horizens','#ffcc33']];
const PRESTIGE=[[100,'Combat Horizens','#ffcc33'],[200,'Combat Horizens II','#ffb21f'],[300,'Combat Horizens III','#ff8f1f'],[400,'Combat Horizens IV','#ff5f3a'],[500,'Legend','#ff3b6b']];
function rankOf(l){let i=0;for(let k=0;k<RANKS.length;k++)if(l>=RANKS[k][0])i=k;let name=RANKS[i][1],color=RANKS[i][2],pi=-1;
  if(l>=100){for(let k=0;k<PRESTIGE.length;k++)if(l>=PRESTIGE[k][0])pi=k;name=PRESTIGE[pi][1];color=PRESTIGE[pi][2];}
  const next=i<RANKS.length-1?RANKS[i+1]:(pi>=0&&pi<PRESTIGE.length-1?PRESTIGE[pi+1]:null);
  return{i,pi,name,color,next:next?{level:next[0],name:next[1]}:null};}
function badgeSvg(l,size=34){
  const r=rankOf(l),c=r.color;let inner='';
  if(r.i<7){const n=(r.i%3)+1+(r.i>=3?1:0);for(let k=0;k<Math.min(n,4);k++){const y=13+k*6;inner+=`<path d="M10 ${y} L20 ${y+5} L30 ${y}" fill="none" stroke="#1a1206" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>`;}}
  else if(r.i<12){const n=r.i-6;for(let k=0;k<n;k++){const x=20+(k-(n-1)/2)*7.5;inner+=`<circle cx="${x}" cy="22" r="3" fill="#1a1206"/>`;}}
  else{inner=`<path d="M20 10 L23 18 L31 18 L24.5 23 L27 31 L20 26 L13 31 L15.5 23 L9 18 L17 18 Z" fill="#1a1206"/>`;if(r.pi>0)for(let k=0;k<r.pi;k++)inner+=`<circle cx="${14+k*4}" cy="35" r="1.6" fill="#1a1206"/>`;}
  return `<svg width="${size}" height="${size*1.05}" viewBox="0 0 40 42"><path d="M20 2 L37 8 L35 26 Q31 36 20 40 Q9 36 5 26 L3 8 Z" fill="${c}" stroke="rgba(0,0,0,.35)" stroke-width="1.5"/>${inner}</svg>`;
}
function addXP(n){const before=save.level;save.totalXp+=n;if(save.level>=MAX_LEVEL)return 0;save.xp+=n;while(save.level<MAX_LEVEL&&save.xp>=xpToNext(save.level)){save.xp-=xpToNext(save.level);save.level++;}if(save.level>=MAX_LEVEL){save.level=MAX_LEVEL;save.xp=0;}return save.level-before;}

/* ================= WEAPONS =================
   Roster & base stats from a gun data pack (Gamingbarn, CC BY-NC-ND 4.0):
   magazine sizes, reload times (ticks/20), ranges, fire-rate ordering, recoil strength and zoom.
   Damage is rescaled to 100 HP. Patterns: [shot, yaw° (+right), pitch° (+up)], deterministic per gun. */
function makePattern(n,climb,sway,seed){const r=mulberry32(seed*9973+7);const ph=r()*6.28,fr=0.8+r()*0.9,dir=r()<.5?-1:1;const P=[[0,0,0]];
  for(let i=1;i<Math.max(n,2);i++){const t=i/Math.max(n-1,1);const rise=Math.min(1,t/0.38);const pitch=climb*(0.82*(1-(1-rise)*(1-rise))+0.18*t);
    const sw=t<0.3?dir*sway*0.15*(t/0.3):sway*Math.sin((t-0.3)*Math.PI*2*fr*1.4+ph*0.3)*dir+(r()-0.5)*sway*0.15;
    P.push([i,+sw.toFixed(3),+pitch.toFixed(3)]);}
  return P;}
const IN=(stand,move,air,spray,extra)=>Object.assign({stand,crouch:stand*0.6,move,air,ladder:air*0.6,spray},extra||{});
let PSEED=11;
const CAT_DEF={pistol:{slot:2,reward:300,range:45,move:0.035,air:0.14,spray:0.004},smg:{slot:1,reward:600,range:40,move:0.045,air:0.15,spray:0.0025},shotgun:{slot:1,reward:900,range:22,move:0.035,air:0.1,spray:0},mg:{slot:1,reward:300,range:60,move:0.12,air:0.3,spray:0.003},rifle:{slot:1,reward:300,range:60,move:0.09,air:0.25,spray:0.002},sniper:{slot:1,reward:300,range:120,move:0.2,air:0.4,spray:0},dmr:{slot:1,reward:300,range:90,move:0.12,air:0.3,spray:0.006}};
function gun(o){const C=CAT_DEF[o.cat];const w=Object.assign({slot:C.slot,head:4,auto:false,reward:C.reward,range:C.range,recover:{k:4,lin:2.5}},o);
  if(w.reserve===undefined)w.reserve=w.mag*3;
  if(!w.inacc)w.inacc=IN(w.stand||0,w.move||C.move,w.air||C.air,w.sprayK!==undefined?w.sprayK:C.spray,w.zoom?{scoped:w.scopedAcc||0}:null);
  if(!w.pattern){const pt=w.pat||[5,1.5];w.pattern=makePattern(w.mag,pt[0],pt[1],PSEED++);}
  return w;}
