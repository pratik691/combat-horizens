  const M={mk,cyl,P,skin,black,wood,metal,tan,olive,yellow,glove,sleeve,steel,pistolHands,longHands,grip,tguard,rail,port,vents,lens,poly,dark};
  for(const id of GUN_IDS){if(!QA[id])continue;try{const w=WEAPONS[id],cat=w.cat||'rifle',L=(QA_FIT[cat]||0.9)*(id==='dualies'?1:1);const pist=cat==='pistol';
      const g=new THREE.Group();const add=(ox)=>{const r=qaGun(id,L);const back=L*(pist?0.3:0.3);r.g.position.set(ox,pist?-0.01:-0.015,-L/2+back);g.add(r.g);return r;};
      const r=add(0);if(id==='dualies')add(-0.34);
      const QH=QA_HANDS[id],yoff=pist?-0.01:-0.015;
      if(ICON){}else if(QH){const gc=qaHandPt(QH[0],QH[1],L,yoff);
        if(pist){if(id==='dualies'){for(const ox of[0,-0.34]){const hg=handGrip(g,HM,{c:gc.clone().setX(0),tilt:QH[2],r:0.019,arm:new V3(0.06,-0.12,0.3)});if(ox){hg.scale.x=-1;hg.position.x=ox;}}}
          else{handGrip(g,HM,{c:gc,tilt:QH[2],r:0.019});handSupport(g,HM,{c:gc.clone().add(new V3(-0.008,-0.012,-0.012)),r:0.036});}}
        else{handGrip(g,HM,{c:gc,tilt:QH[2],r:0.02,arm:new V3(0.07,-0.13,0.3)});const fc=qaHandPt(QH[3],QH[4],L,yoff);fc.y-=0.022;handFore(g,HM,{c:fc,r:0.024});}}
      else if(pist)pistolHands(g);else longHands(g,-L*0.38,-0.05);
      if(vm.models[id])vmRoot.remove(vm.models[id]);delete vm.pump[id];g.userData.gs=1;g.userData.qa=1;vm.models[id]=g;vm.flash[id]=flash(g,-L*0.7-0.02,pist?1:cat==='shotgun'?1.3:1);}catch(e){console.warn('qa',id,e);}}
  for(const id of GUN_IDS){if(vm.models[id]&&(!VM2_OVR[id]||vm.models[id].userData.qa))continue;if(VM2_OVR[id]){vmRoot.remove(vm.models[id]);delete vm.pump[id];}let r;try{r=gunsmith(WEAPONS[id],M,id);}catch(e){console.warn('gunsmith',id,e);r=genericVM(WEAPONS[id],M);}if(!ICON)r.g.scale.setScalar(0.8);r.g.userData.gs=1;vm.models[id]=r.g;vm.flash[id]=flash(r.g,r.fz,r.fs);if(r.pump)vm.pump[id]=r.pump;}
  vm.models.zeus=genericVM(WEAPONS.zeus,M).g;
  const kid=(player.inv&&player.inv[3])?player.inv[3].id:knifeId();vm.models[kid]=knifeVM(WEAPONS[kid],M);
  for(const id of['remington','spas'])if(vm.pump[id])vm.pump[id].userData.bz=vm.pump[id].position.z;
  vm.real={};
  if(!ICON){for(const id of REAL_GUNS){const r=makeRealVM(id,equippedPaint(id),null,fm);vm.models[id]=r.outer;vm.real[id]=r;if(r.flash)vm.flash[id]=r.flash;else delete vm.flash[id];}
    if(hasReal(kid)){const v=save.kskin&&HZ.kv[save.kskin]&&HZ.kv[save.kskin].w===kid?save.kskin:null;const r=makeRealVM(kid,v?null:(FINS[save.knifeFin]?save.knifeFin:null),v,null);vm.models[kid]=r.outer;vm.real[kid]=r;}}
  else if(hzReady){for(const id of REAL_GUNS)vm.models[id]=makeRealStatic(id);}
  vm.M=M;vm.skinMat=skin;
  if(!ICON)for(const id in vm.models){const pid=equippedPaint(id);if(!pid)continue;const mat=paintMat(pid);vm.models[id].traverse(o=>{if(o.isMesh&&o.material===skin)o.material=mat;});}
  for(const m of Object.values(vm.models)){m.visible=false;vmRoot.add(m);}
}

/* ===== GUNSMITH v2: guns cut from side-profile silhouettes (bevelled extrusions) + barrels, rails, sights, muzzle devices ===== */
const VM2_OVR={deagle:{t:'pistol',len:1.25,big:1},mp5:{t:'smg',len:1,stock:'fixed',mag:'curved',round:1},thompson:{t:'smg',len:1.15,stock:'wood',mag:'drum',furn:'wood',fins:1},remington:{t:'shotgun',pump:1,furn:'wood'},spas:{t:'shotgun',pump:1,furn:'black',stock:'fold'},
  m4a4:{t:'rifle',ar:1,mag:'straight',stock:'ar'},m1a:{t:'rifle',furn:'wood',stock:'wood',mag:'straight',len:1.35,wood:1},barrett:{t:'sniper',len:1.3,auto:1,big:1}};
const _profG={};
function profGeo(pts,w,holes,bev){const key=JSON.stringify([pts,w,holes||0,bev]);if(_profG[key])return _profG[key];
  const sh=new THREE.Shape();pts.forEach(([z,y],i)=>i?sh.lineTo(-z,y):sh.moveTo(-z,y));sh.closePath();
  if(holes)for(const h of holes){const p=new THREE.Path();h.forEach(([z,y],i)=>i?p.lineTo(-z,y):p.moveTo(-z,y));p.closePath();sh.holes.push(p);}
  const b=bev;const geo=new THREE.ExtrudeGeometry(sh,{depth:Math.max(0.001,w-2*b),bevelEnabled:b>0,bevelThickness:b,bevelSize:b*0.8,bevelSegments:2,steps:1,curveSegments:6});
  geo.translate(0,0,-(w-2*b)/2);geo.rotateY(Math.PI/2);
  const pos=geo.attributes.position,uv=geo.attributes.uv;for(let i=0;i<pos.count;i++)uv.setXY(i,pos.getZ(i)/0.12,pos.getY(i)/0.12+pos.getX(i)/0.12);
  geo.computeVertexNormals();fsizeConst(geo,0,0);return _profG[key]=geo;}
const _pe=new Map();function profEdges(geo){if(_pe.has(geo))return _pe.get(geo);const e=new THREE.EdgesGeometry(geo,25);_pe.set(geo,e);return e;}
function arcPts(cz,cy,r0,r1,a0,a1,n){const o=[],inn=[];for(let i=0;i<=n;i++){const a=a0+(a1-a0)*i/n;o.push([cz+Math.sin(a)*r1,cy-Math.cos(a)*r1]);inn.push([cz+Math.sin(a)*r0,cy-Math.cos(a)*r0]);}return o.concat(inn.reverse());}
