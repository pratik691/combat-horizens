  else{solidT(x,0,z,w+0.1,0.55,d+0.1,shadeOf(WM,0.72),3,false);if(h>6.5)solidT(x,3.15,z,w+0.08,0.16,d+0.08,shadeOf(WM,0.86),3,false);}
  // parapet with coping
  const flat=!THEME.roof||THEME.roof==='flat';const pw=0.18,ph=flat?0.55:0;if(flat)for(const[sx,sz,ww,dd]of[[0,d/2-pw/2,w,pw],[0,-d/2+pw/2,w,pw],[w/2-pw/2,0,pw,d-2*pw],[-w/2+pw/2,0,pw,d-2*pw]])solidT(x+sx,h,z+sz,ww,ph,dd,WM,3,true);
  const ce=OC?0:0.1;if(flat){for(const[sx,sz,ww,dd]of[[0,d/2-pw/2,w+ce,pw+ce],[0,-d/2+pw/2,w+ce,pw+ce],[w/2-pw/2,0,pw+ce,d],[-w/2+pw/2,0,pw+ce,d]])solidT(x+sx,h+ph,z+sz,ww,0.07,dd,MAT.ledge,3,false);if(OC)sideBands(x,z,w,d,h-0.05,0.12,0.11,MAT.ledge,self);else solidT(x,h-0.05,z,w+0.22,0.12,d+0.22,MAT.ledge,3,false);}
  else if(OC){solid(x,h,z,w,0.22,d,MAT.ledge,false);sideBands(x,z,w,d,h,0.22,0.15,MAT.ledge,self);}else solid(x,h,z,w+0.3,0.22,d+0.3,MAT.ledge,false);
  if(!themeRoof(x,z,w,d,h,self)&&rng()<0.4)solid(x+rand(-w/5,w/5),h+0.22,z+rand(-d/5,d/5),w*0.45,1.3,d*0.45,pick(MAT.walls),false);
