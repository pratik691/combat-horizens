/* ===== ambientCG photo textures (CC0): walls, grounds, crates, doors, ladders ===== */
const PBR=window.CR_PBR||{};const _pbrT={};
function pbrNew(k,ch){const u=PBR[k]&&PBR[k][ch||'c'];if(!u)return null;const t=new THREE.TextureLoader().load(u,texCapApply);t.wrapS=t.wrapT=THREE.RepeatWrapping;t.anisotropy=Math.min(8,renderer.capabilities.getMaxAnisotropy?renderer.capabilities.getMaxAnisotropy():1);if(k==='bricks')t.repeat.set(1,2);return t;}
function pbrTex(k,ch){const key=k+(ch||'c');return _pbrT[key]||(_pbrT[key]=pbrNew(k,ch));}
function pbrHi(){try{const v=vid();return v.detail!=='low'&&v.fx!=='low';}catch(e){return true;}}
function wallMat(c,key,fallback){const map=pbrTex(key)||fallback;const nm=pbrHi()&&pbrTex(key,'n');
  const m=nm?new THREE.MeshPhongMaterial({color:c,map,normalMap:nm,normalScale:new THREE.Vector2(0.9,0.9),shininess:4,specular:0x0c0c0c}):Lm({color:c,map});return wallFX(m);}
function grassFX(m){m.onBeforeCompile=sh=>{sh.uniforms.uDet=GROUND_DET;
    sh.vertexShader=sh.vertexShader.replace('#include <common>','#include <common>\nvarying vec2 vGW;').replace('#include <begin_vertex>','#include <begin_vertex>\nvGW=(modelMatrix*vec4(transformed,1.0)).xz;');
    sh.fragmentShader=sh.fragmentShader.replace('#include <common>','#include <common>\nvarying vec2 vGW;uniform float uDet;\n'+GNOISE)
     .replace('#include <map_fragment>',`
       vec4 g1=texture2D(map,vUv);vec4 g2=texture2D(map,vec2(vUv.y,-vUv.x)*0.41+vec2(0.27,0.63));
       vec3 gc=mix(g1.rgb,g2.rgb,0.42);float gl=dot(gc,vec3(0.3333));
       float gd=distance(vGW,cameraPosition.xz);
       float n1=fbm(vGW*0.028+vec2(3.0,7.0)),n2=fbm(vGW*0.09+vec2(11.0,2.0)),n3=vn(vGW*0.8);
       vec3 gm=mix(vec3(0.9,1.14,0.62),vec3(1.14,1.06,0.68),smoothstep(0.56,0.76,n1));
       float bare=smoothstep(0.60,0.73,n1*0.55+n2*0.45+(n3-0.5)*0.24);
       gc*=gm;gc=mix(gc,vec3(gl)*vec3(2.5,1.75,1.15),bare*0.8);gc*=0.88+0.34*n2;
       float gdet=uDet*(1.0-smoothstep(9.0,18.0,gd));
       if(gdet>0.0){vec2 fq=vGW*4.5;vec2 fc=floor(fq);float fh=sh21(fc+3.7);
         if(fh>0.972){vec2 fo=vec2(sh21(fc+1.3),sh21(fc+8.1))*0.6+0.2;float fd=length(fract(fq)-fo);float fm=(1.0-smoothstep(0.05,0.1,fd))*gdet;
           vec3 fcol=fh>0.99?vec3(1.0,0.95,0.55):vec3(0.95,0.95,0.9);gc=mix(gc,fcol*0.9,fm);}
         gc*=1.0+(sh21(floor(vGW*60.0))-0.5)*0.12*gdet;}
       diffuseColor*=vec4(gc,1.0);`);};
  m.customProgramCacheKey=()=>'grass2'+(m.normalMap?'n':'p');return m;}
function pbrGround(k){const key=k==='cobble'?'cobble':k==='grass'?'grass':'gconcrete';const map=pbrNew(key);if(!map)return null;
  const nm=pbrHi()?pbrNew(key,'n'):null;const col=k==='cobble'?0x9c968c:k==='grass'?0x66704f:0xaaa8a4;const m=nm?new THREE.MeshPhongMaterial({color:col,map,normalMap:nm,normalScale:new THREE.Vector2(1.1,1.1),shininess:k==='grass'?2:8,specular:0x101010}):Lm({color:col,map});m.userData.pbr=1;if(k==='grass')grassFX(m);return m;}
const PBR_WALL={plaster:'plaster',stone:'rock',concrete:'concrete',brick:'bricks'};
const _wtex={plaster:()=>texPlaster,brick:()=>texBrick,concrete:()=>texConcrete,stone:()=>texStone};
MAT.walls.forEach(wallFX);wallFX(MAT.ledge);wallFX(MAT.boundary);
const _defMAT={walls:MAT.walls,ledge:MAT.ledge,boundary:MAT.boundary,door:MAT.door};
function applyTheme(id){const t=MAPS[id]||MAPS.dust2;THEME=t;THEME_ID=MAPS[id]?id:'dust2';try{groundDetUpd();}catch(e){}
  if(!t._m){const tx=_wtex[t.wt](),pk=PBR_WALL[t.wt];t._m={walls:t.walls.map(c=>wallMat(c,pk,tx)),ledge:wallMat(t.ledge,'plaster',texPlaster),boundary:wallMat(t.bound,pk,tx),door:t.doors.map(c=>Lm({color:c,map:pbrTex('wooddetail')||null}))};
    if(id==='inferno'&&PBR.bricks)t._m.walls.push(wallMat(0xffffff,'bricks',texBrick),wallMat(0xe8d8c8,'bricks',texBrick));
    const g=t.ground;t._m.ground=g.k==='sand'?makeSand(g.t||[1,1,1]):pbrGround(g.k)||Lm({map:(g.k==='cobble'?texCobble:g.k==='grass'?texGrass:texGConcrete).clone(),color:g.k==='cobble'?0x9a928a:g.k==='grass'?0x8f9a78:0x8c8a86});if(g.k!=='sand'&&!t._m.ground.userData.pbr&&t._m.ground.map&&t._m.ground.map.image)t._m.ground.map.needsUpdate=true;t._m.gtile=g.k==='cobble'?(t._m.ground.userData.pbr?2.4:3):g.k==='grass'?(t._m.ground.userData.pbr?4:6):8;}
  Object.assign(MAT,{walls:t._m.walls,ledge:t._m.ledge,boundary:t._m.boundary,door:t._m.door});GROUND_MAT=t._m.ground;
  scene.background.setHex(t.sky);WSH.uSky.value.setHex(t.sky);WSH.uSkyTop.value.setHex(t.sky).lerp(new THREE.Color(0x6f9fd0),0.55);scene.fog.color.setHex(t.sky);try{skyTheme(t);}catch(e){}if(HEMI){HEMI.color.setHex(t.hemi[0]).lerp(new THREE.Color(0x9cc2f0),0.3);HEMI.groundColor.setHex(t.hemi[1]);HEMI.intensity=t.hemi[2]*0.84;}sun.color.setHex(t.sun);sun.intensity=1.1;}

/* ---- match sky: gradient dome, sun disc + halo, drifting fbm clouds; horizon = fog colour so buildings melt into it ---- */
const SKYD={mesh:null,u:null,glare:null,vis:0,occT:0,occ:1};
function skyDome(){if(SKYD.mesh)return SKYD.mesh;
  SKYD.u={uHor:{value:new THREE.Color(0xd8ccb2)},uZen:{value:new THREE.Color(0x5a8ccc)},uSunDir:{value:new THREE.Vector3(44,40,27).normalize()},uSunCol:{value:new THREE.Color(0xfff0d6)},uT:{value:0},uCloud:{value:0.55}};
  const m=new THREE.ShaderMaterial({uniforms:SKYD.u,depthWrite:false,depthTest:false,fog:false,side:THREE.BackSide,
    vertexShader:'varying vec3 vDir;void main(){vDir=normalize(position);gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}',
    fragmentShader:`uniform vec3 uHor,uZen,uSunDir,uSunCol;uniform float uT,uCloud;varying vec3 vDir;
float h21(vec2 p){p=fract(p*vec2(123.34,456.21));p+=dot(p,p+45.32);return fract(p.x*p.y);}
float vn(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);return mix(mix(h21(i),h21(i+vec2(1,0)),f.x),mix(h21(i+vec2(0,1)),h21(i+vec2(1,1)),f.x),f.y);}
float fbm(vec2 p){float a=0.5,s=0.0;for(int i=0;i<5;i++){s+=a*vn(p);p=p*2.03+vec2(1.7,9.2);a*=0.5;}return s;}
void main(){vec3 d=normalize(vDir);float h=clamp(d.y,0.0,1.0);
  vec3 col=mix(uHor,uZen,pow(h,0.5));
  float sd=max(dot(d,uSunDir),0.0);
  col+=uSunCol*(pow(sd,6.0)*0.10+pow(sd,48.0)*0.30);
  if(d.y>0.0){vec2 p=d.xz/(d.y+0.18)*1.6+vec2(uT*0.006,uT*0.002);
    float n=fbm(p);float n2=fbm(p*2.7+3.1);float c=smoothstep(0.50,0.82,n*0.75+n2*0.35)*uCloud*smoothstep(0.0,0.22,d.y);
    vec3 cc=mix(uHor*0.82+vec3(0.06),vec3(1.0,0.98,0.95),0.55+0.45*n2)+uSunCol*pow(sd,8.0)*0.35;
    col=mix(col,cc,c*0.88);}
  col+=uSunCol*smoothstep(0.9993,0.99965,sd)*1.6;
  col=mix(uHor,col,smoothstep(-0.02,0.10,d.y));
  gl_FragColor=vec4(col,1.0);
  #include <tonemapping_fragment>
  #include <encodings_fragment>
}`});
  const g=new THREE.Mesh(new THREE.SphereGeometry(400,32,16),m);g.frustumCulled=false;g.renderOrder=-1000;g.visible=false;scene.add(g);SKYD.mesh=g;return g;}
function skyTheme(t){skyDome();const U=SKYD.u;U.uHor.value.setHex(t.sky);U.uZen.value.setHex(t.sky).lerp(new THREE.Color(0x2f6cc8),0.72);U.uSunCol.value.setHex(t.sun);U.uCloud.value=t.clouds!=null?t.clouds:0.55;}
function _rayBox(o,d,c){let t0=0,t1=400;for(const[a,mn,mx]of[['x',c.minX,c.maxX],['y',c.minY,c.maxY],['z',c.minZ,c.maxZ]]){const iv=1/(d[a]||1e-9);let ta=(mn-o[a])*iv,tb=(mx-o[a])*iv;if(ta>tb){const q=ta;ta=tb;tb=q;}t0=Math.max(t0,ta);t1=Math.min(t1,tb);if(t1<t0)return false;}return true;}
const _skV=new THREE.Vector3(),_skF=new THREE.Vector3();
function skyTick(dt){const on=S.state==='game'&&vid().fx!=='low';const g=skyDome();g.visible=on;
  if(!SKYD.glare){const e=document.createElement('div');e.id='sunGlare';document.body.appendChild(e);SKYD.glare=e;}
  if(!on){SKYD.glare.style.opacity=0;return;}
  g.position.copy(camera.position);SKYD.u.uT.value+=dt;
  const sd=SKYD.u.uSunDir.value;
  SKYD.occT-=dt;if(SKYD.occT<=0){SKYD.occT=0.12;let hit=false;const o=camera.position;for(const c of colliders){if(c.maxY<o.y)continue;if(_rayBox(o,sd,c)){hit=true;break;}}SKYD.occ=hit?0:1;}
  camera.getWorldDirection(_skF);const facing=Math.max(0,_skF.dot(sd));
  const tgt=SKYD.occ*Math.pow(facing,4)*(player&&player.scoped?0.4:1)*(player&&player.alive?1:0);SKYD.vis+=(tgt-SKYD.vis)*Math.min(1,dt*6);
  _skV.copy(camera.position).add(sd).project(camera);const G=SKYD.glare;
  if(SKYD.vis<0.01||_skV.z>1){G.style.opacity=0;return;}
  G.style.opacity=(SKYD.vis*0.75).toFixed(3);G.style.transform=`translate(${((_skV.x*0.5+0.5)*innerWidth).toFixed(0)}px,${((-_skV.y*0.5+0.5)*innerHeight).toFixed(0)}px)`;}

/* ---- map detail pass: contact shadows where things meet the ground, ground wear/dirt breakup ---- */
const MD={};
function mdCanvasTex(sz,fn){const c=document.createElement('canvas');c.width=c.height=sz;const x=c.getContext('2d');const id=x.createImageData(sz,sz);
  for(let j=0;j<sz;j++)for(let i=0;i<sz;i++){const a=fn(i/(sz-1),j/(sz-1));const k=(j*sz+i)*4;id.data[k]=id.data[k+1]=id.data[k+2]=Math.max(0,Math.min(255,a*255))|0;id.data[k+3]=255;}
  x.putImageData(id,0,0);const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.ClampToEdgeWrapping;return t;}
function mdTex(){if(MD.strip)return;
  const fall=t=>{t=Math.min(1,Math.max(0,t));return Math.pow(1-t,1.7);};
  MD.strip=mdCanvasTex(64,(u,v)=>fall(v));
  MD.corner=mdCanvasTex(64,(u,v)=>fall(Math.hypot(u,v)));
  // soft irregular blotch for ground wear
  let s=97;const r=()=>((s=(Math.imul(s,1664525)+1013904223)>>>0)/4294967296);const bl=[];for(let i=0;i<14;i++)bl.push([0.25+r()*0.5,0.25+r()*0.5,0.08+r()*0.22]);
  MD.blot=mdCanvasTex(128,(u,v)=>{let a=0;for(const[cx,cy,rr]of bl){const d=Math.hypot(u-cx,v-cy)/rr;if(d<1)a=Math.max(a,(1-d*d));}const e=Math.hypot(u-0.5,v-0.5)*2;return a*Math.max(0,1-e*e)*(0.75+0.25*Math.sin(u*41+v*23)*Math.sin(u*17-v*37));});}
function mdQuads(list,map,color,opacity){if(!list.length)return null;const P=new Float32Array(list.length*18),U=new Float32Array(list.length*12);let p=0,q=0;
  for(const c of list){// c = [ax,az,ua,va, bx,bz,ub,vb, cx,cz,uc,vc, dx,dz,ud,vd, y]
    const y=c[16];const v=[[0,1,2],[0,2,3]];for(const tri of v)for(const k of tri){P[p++]=c[k*4];P[p++]=y;P[p++]=c[k*4+1];U[q++]=c[k*4+2];U[q++]=c[k*4+3];}}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(P,3));g.setAttribute('uv',new THREE.BufferAttribute(U,2));g.computeBoundingSphere();
  const m=new THREE.MeshBasicMaterial({color,alphaMap:map,transparent:true,opacity,depthWrite:false,side:THREE.DoubleSide,polygonOffset:true,polygonOffsetFactor:-2,polygonOffsetUnits:-2});
  const mesh=new THREE.Mesh(g,m);mesh.renderOrder=1;mesh.receiveShadow=false;mesh.castShadow=false;world.add(mesh);return mesh;}

function mdBlur(a,W,H,r,pass){const t=new Float32Array(a.length);for(let p=0;p<pass;p++){
  for(let y=0;y<H;y++){let acc=0;const o=y*W;for(let x=-r;x<=r;x++)acc+=a[o+Math.min(W-1,Math.max(0,x))];for(let x=0;x<W;x++){t[o+x]=acc/(2*r+1);acc+=a[o+Math.min(W-1,x+r+1)]-a[o+Math.max(0,x-r)];}}
  for(let x=0;x<W;x++){let acc=0;for(let y=-r;y<=r;y++)acc+=t[Math.min(H-1,Math.max(0,y))*W+x];for(let y=0;y<H;y++){a[y*W+x]=acc/(2*r+1);acc+=t[Math.min(H-1,y+r+1)*W+x]-t[Math.max(0,y-r)*W+x];}}}}
function mdBakeAO(){const E=(mapH||50)+12,span=E*2;const ppm=Math.max(1.5,Math.min(5,1024/span));const N=Math.min(1024,Math.ceil(span*ppm));const k=N/span;
  const occ=new Uint8Array(N*N),near=new Float32Array(N*N),far=new Float32Array(N*N);
  for(const c of colliders){if(c.minY>0.25||c.maxY<0.3)continue;const h=c.maxY-Math.max(0,c.minY);
    const x0=Math.max(0,Math.floor((c.minX+E)*k)),x1=Math.min(N-1,Math.ceil((c.maxX+E)*k)-1),z0=Math.max(0,Math.floor((c.minZ+E)*k)),z1=Math.min(N-1,Math.ceil((c.maxZ+E)*k)-1);
    const wn=Math.min(1,0.35+h*0.45),wf=Math.min(1,Math.max(0,(h-1.2)/5));
    for(let z=z0;z<=z1;z++)for(let x=x0;x<=x1;x++){const q=z*N+x;occ[q]=1;near[q]=Math.max(near[q],wn);far[q]=Math.max(far[q],wf);}}
  mdBlur(near,N,N,Math.max(1,Math.round(0.55*k)),3);mdBlur(far,N,N,Math.max(1,Math.round(1.8*k)),3);
  const cv=document.createElement('canvas');cv.width=cv.height=N;const x=cv.getContext('2d');const id=x.createImageData(N,N);
  for(let q=0;q<N*N;q++){const a=occ[q]?0:Math.min(1,near[q]*1.25*0.62+far[q]*0.42);const v=(Math.pow(a,0.85)*255)|0;const o=q*4;id.data[o]=id.data[o+1]=id.data[o+2]=v;id.data[o+3]=255;}
  x.putImageData(id,0,0);const tex=new THREE.CanvasTexture(cv);tex.minFilter=THREE.LinearFilter;tex.generateMipmaps=false;tex.wrapS=tex.wrapT=THREE.ClampToEdgeWrapping;
  const g=new THREE.PlaneGeometry(span,span);g.rotateX(-Math.PI/2);
  const m=new THREE.MeshBasicMaterial({color:0x0b0906,alphaMap:tex,transparent:true,opacity:0.78,depthWrite:false,polygonOffset:true,polygonOffsetFactor:-2,polygonOffsetUnits:-2});
  const mesh=new THREE.Mesh(g,m);mesh.position.y=0.008;mesh.renderOrder=1;world.add(mesh);MD.ao=mesh;}
function mapDetail(mode){if(!world)return;mdTex();
  let sd=((S.seed||7)*2654435761)>>>0||7;const rnd=()=>((sd=(Math.imul(sd,1664525)+1013904223)>>>0)/4294967296);
  // 1) baked ambient occlusion for the ground: top-down occupancy map of everything standing on the floor,
  //    blurred at two radii (tight contact + wide sky-blocking) and laid over the ground as one soft decal
  try{mdBakeAO();}catch(e){console.error(e);}
  // 2) ground wear: dark grime and sun-bleached patches break up the texture tiling
  const H=mapH||50,dark=[],light=[];const n=Math.round(Math.min(260,H*H*0.035));
  const inside=(x,z)=>colliders.some(c=>c.minY<0.3&&x>c.minX&&x<c.maxX&&z>c.minZ&&z<c.maxZ&&c.maxY>0.4);
  for(let i=0;i<n;i++){const x=(rnd()*2-1)*H,z=(rnd()*2-1)*H;if(inside(x,z))continue;if(ISL&&!islIn(x,z,2))continue;const r=1.2+rnd()*3.8,a=rnd()*Math.PI,ca=Math.cos(a)*r,sa=Math.sin(a)*r,el=0.55+rnd()*0.45;
    const q=[x-ca+sa*el,z-sa-ca*el,0,0, x+ca+sa*el,z+sa-ca*el,1,0, x+ca-sa*el,z+sa+ca*el,1,1, x-ca-sa*el,z-sa+ca*el,0,1, 0.006];(rnd()<0.7?dark:light).push(q);}
  mdQuads(dark,MD.blot,0x2a2014,0.3);mdQuads(light,MD.blot,0xfff4e0,0.10);
}

/* sun shadow frustum: pushed ahead of where you look and snapped to whole shadow-map texels so edges don't crawl as you move */
const _sunD=new THREE.Vector3(44,40,27).normalize(),_sunU=new THREE.Vector3(),_sunV=new THREE.Vector3(),_sunF=new THREE.Vector3(),_sunC=new THREE.Vector3();
_sunU.crossVectors(new THREE.Vector3(0,1,0),_sunD).normalize();_sunV.crossVectors(_sunD,_sunU).normalize();
function sunFollow(cp){camera.getWorldDirection(_sunF);_sunF.y=0;if(_sunF.lengthSq()>1e-6)_sunF.normalize();
  const c=sun.shadow.camera,ext=c.right-c.left,tx=ext/sun.shadow.mapSize.x;
  _sunC.set(cp.x+_sunF.x*ext*0.18,0,cp.z+_sunF.z*ext*0.18);
  const u=Math.round(_sunC.dot(_sunU)/tx)*tx,v=Math.round(_sunC.dot(_sunV)/tx)*tx,d=_sunC.dot(_sunD);
  _sunC.copy(_sunU).multiplyScalar(u).addScaledVector(_sunV,v).addScaledVector(_sunD,d);
  sun.target.position.copy(_sunC);sun.position.copy(_sunC).addScaledVector(_sunD,100);sun.target.updateMatrixWorld();}
/* how much ground the sun shadow covers per quality: bigger maps cover more without losing sharpness */
function sunShadowFit(sh){const e=sh>=8192?72:sh>=4096?55:sh>=2048?42:sh>=1024?30:22;const c=sun.shadow.camera;c.left=c.bottom=-e;c.right=c.top=e;c.near=1;c.far=260;c.updateProjectionMatrix();
  const tx=e*2/sh;sun.shadow.normalBias=tx*1.6;sun.shadow.bias=-0.00025;}
/* ================= BATTLE ROYALE ISLAND =================
   An island with an irregular coastline in an open ocean (Free Fire style): sandy beaches that slope under
   a wave-shaded sea, enterable one- and two-storey houses with furniture and loot inside. */
var ISL=null;
function islR(th){const I=ISL;return I.R0*(1+I.A[0]*Math.sin(3*th+I.P[0])+I.A[1]*Math.sin(5*th+I.P[1])+I.A[2]*Math.sin(7*th+I.P[2]));}
function islRel(x,z){return Math.hypot(x,z)-islR(Math.atan2(z,x));}/* <0 on land, >0 at sea */
function islIn(x,z,m){return !ISL||islRel(x,z)<-(m||0);}
function islClamp(p,lim){if(!ISL)return;const L=lim===undefined?1.0:lim;const rel=islRel(p.x,p.z);if(rel>L){const r=Math.hypot(p.x,p.z)||1;const k=Math.max(0,r-(rel-L))/r;p.x*=k;p.z*=k;}}
function islBeachY(rel){return rel<=0?0:rel<=2?-0.32*(rel/2):Math.max(-2.7,-0.32-(rel-2)/24*2.4);}
function islSand(){const m=makeSand([1.04,0.97,0.86]);m.vertexColors=true;m.customProgramCacheKey=()=>'sand4tv';return m;}
let _isMats=null;
function islMats(){if(_isMats)return _isMats;
  const sand=canvasTex(256,(c,w,h)=>{c.fillStyle='#d8c08e';c.fillRect(0,0,w,h);const id=c.getImageData(0,0,w,h),d=id.data;for(let i=0;i<d.length;i+=4){const n=(Math.random()-0.5)*30;d[i]+=n;d[i+1]+=n*0.95;d[i+2]+=n*0.8;}c.putImageData(id,0,0);
    for(let i=0;i<60;i++){c.fillStyle=`rgba(${120+Math.random()*60|0},${100+Math.random()*40|0},70,.18)`;c.beginPath();c.arc(Math.random()*w,Math.random()*h,1+Math.random()*2.5,0,7);c.fill();}
    c.strokeStyle='rgba(150,120,70,.12)';c.lineWidth=2;for(let y=8;y<h;y+=22){c.beginPath();for(let x=0;x<=w;x+=8)c.lineTo(x,y+Math.sin(x*0.05+y)*4);c.stroke();}});
  const plank=canvasTex(128,(c,w,h)=>{for(let i=0;i<8;i++){const y=i*h/8;c.fillStyle=`hsl(${28+Math.random()*6},${38+Math.random()*10}%,${30+Math.random()*8}%)`;c.fillRect(0,y,w,h/8);c.fillStyle='rgba(20,10,4,.55)';c.fillRect(0,y,w,1.5);
    for(let k=0;k<5;k++){c.strokeStyle='rgba(60,30,12,.25)';c.beginPath();const yy=y+3+Math.random()*(h/8-6);c.moveTo(0,yy);c.bezierCurveTo(w*0.3,yy+2,w*0.6,yy-2,w,yy+1);c.stroke();}const sx=Math.random()*w;c.fillStyle='rgba(20,10,4,.5)';c.fillRect(sx,y,1.5,h/8);}});
  const tile=canvasTex(128,(c,w,h)=>{const n=4;for(let i=0;i<n;i++)for(let j=0;j<n;j++){const v=196+Math.random()*24|0;c.fillStyle=`rgb(${v},${v-14},${v-34})`;c.fillRect(i*w/n,j*h/n,w/n,h/n);}c.strokeStyle='rgba(90,70,50,.6)';c.lineWidth=2;for(let i=0;i<=n;i++){c.beginPath();c.moveTo(i*w/n,0);c.lineTo(i*w/n,h);c.stroke();c.beginPath();c.moveTo(0,i*h/n);c.lineTo(w,i*h/n);c.stroke();}});
  const fab=canvasTex(64,(c,w,h)=>{c.fillStyle='#7a2f2a';c.fillRect(0,0,w,h);c.strokeStyle='rgba(230,200,140,.5)';c.lineWidth=3;c.strokeRect(5,5,w-10,h-10);for(let i=0;i<w;i+=8){c.fillStyle='rgba(0,0,0,.08)';c.fillRect(i,0,4,h);}});
  return _isMats={beach:islSand(),plank:Lm({map:plank}),tile:Lm({map:tile}),wood:Lm({color:0x6b4528}),woodD:Lm({color:0x4a2e18}),
    cloth:Lm({color:0xd9d3c4}),blanket:Lm({color:0x3d5f86}),rug:Lm({map:fab}),metal:Lm({color:0x6d7177}),books:[0x8a3b2a,0x2f5f8a,0xb08a2a,0x3f6f3a,0x6a2a5a,0xd0c8b0].map(c=>Lm({color:c})),seabed:new THREE.MeshBasicMaterial({color:0x0b3550})};}
/* land (theme ground) cut to the coastline + a sloping beach ring that runs under the sea */
function islTerrain(){const M=islMats();const NA=180,size=mapH*2+120;
  const land=new THREE.Shape();for(let i=0;i<=NA;i++){const th=i/NA*Math.PI*2,r=islR(th)-3;const x=Math.cos(th)*r,z=Math.sin(th)*r;if(i===0)land.moveTo(x,-z);else land.lineTo(x,-z);}
  const lg=new THREE.ShapeGeometry(land,2);lg.rotateX(-Math.PI/2);{const P=lg.attributes.position,U=lg.attributes.uv;for(let i=0;i<P.count;i++)U.setXY(i,P.getX(i)/size+0.5,0.5-P.getZ(i)/size);}
  const gm=GROUND_MAT||MAT_SAND;if(gm.map&&gm!==MAT_SAND&&(!gm.isMeshPhongMaterial||gm.userData.pbr))gm.map.repeat.set(size/THEME._m.gtile,size/THEME._m.gtile);
  const lm=new THREE.Mesh(lg,gm);lm.userData.noMerge=1;lm.receiveShadow=true;world.add(lm);worldMeshes.push(lm);
  // beach ring: rel from -5 (under the land edge) out to +40 on the sea floor
  const RS=[-5,-3.2,-2,-1,0,0.7,1.4,2.2,3.5,5.5,8,12,18,26,40];const pos=[],col=[],uv=[],idx=[];const NR=RS.length;
  for(let i=0;i<=NA;i++){const th=i/NA*Math.PI*2,R=islR(th);for(let j=0;j<NR;j++){const rel=RS[j],r=R+rel,x=Math.cos(th)*r,z=Math.sin(th)*r;const y=rel<-3?-0.012:islBeachY(rel);pos.push(x,y,z);uv.push(x/6,z/6);
    const wet=rel>-0.6?Math.min(1,(rel+0.6)/1.6):0,deep=rel>1.4?Math.min(1,(rel-1.4)/14):0;const k=1-wet*0.34;col.push(k*(1-deep*0.45),k*(1-deep*0.32),k*(1-deep*0.18));}}
  for(let i=0;i<NA;i++)for(let j=0;j<NR-1;j++){const a=i*NR+j,b=(i+1)*NR+j;idx.push(a,b,a+1,b,b+1,a+1);}
  const bg=new THREE.BufferGeometry();bg.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));bg.setAttribute('color',new THREE.Float32BufferAttribute(col,3));bg.setAttribute('uv',new THREE.Float32BufferAttribute(uv,2));bg.setIndex(idx);bg.computeVertexNormals();
  const bm=new THREE.Mesh(bg,M.beach);bm.userData.noMerge=1;bm.receiveShadow=true;world.add(bm);
  const sb=new THREE.Mesh(new THREE.PlaneGeometry(2600,2600),M.seabed);sb.rotation.x=-Math.PI/2;sb.position.y=-2.75;sb.userData.noMerge=1;world.add(sb);}
/* open ocean: waves, sun glint, sky reflection, shallow turquoise -> deep blue, shoreline foam */
function islOcean(){const U=Object.assign(THREE.UniformsUtils.clone(THREE.UniformsLib.fog),{uT:WSH.uT,uR0:{value:ISL.R0},uA:{value:new THREE.Vector3(...ISL.A)},uP:{value:new THREE.Vector3(...ISL.P)},
    uSun:{value:new THREE.Vector3(44,40,27).normalize()},uSky:{value:new THREE.Color(THEME.sky).lerp(new THREE.Color(0x6f9fd0),0.45)},uDeep:{value:new THREE.Color(0x0a3f66)},uShal:{value:new THREE.Color(0x27b8c2)}});
  const m=new THREE.ShaderMaterial({uniforms:U,transparent:true,depthWrite:false,fog:true,
    vertexShader:`varying vec3 vW;\n#include <fog_pars_vertex>\nvoid main(){vec4 wp=modelMatrix*vec4(position,1.0);vW=wp.xyz;vec4 mvPosition=viewMatrix*wp;gl_Position=projectionMatrix*mvPosition;\n#include <fog_vertex>\n}`,
    fragmentShader:`uniform float uT,uR0;uniform vec3 uA,uP,uSun,uSky,uDeep,uShal;varying vec3 vW;
#include <fog_pars_fragment>
float islR(float th){return uR0*(1.0+uA.x*sin(3.0*th+uP.x)+uA.y*sin(5.0*th+uP.y)+uA.z*sin(7.0*th+uP.z));}
void main(){vec2 p=vW.xz;float rel=length(p)-islR(atan(p.y,p.x));
  vec2 g=vec2(0.0);
  g+=0.30*vec2(0.8,0.6)*cos(dot(p,vec2(0.8,0.6))*0.55+uT*1.3);
  g+=0.22*vec2(-0.5,0.86)*cos(dot(p,vec2(-0.5,0.86))*0.9+uT*1.7);
  g+=0.14*vec2(0.96,-0.28)*cos(dot(p,vec2(0.96,-0.28))*1.6+uT*2.3);
  g+=0.08*vec2(-0.7,-0.7)*cos(dot(p,vec2(-0.7,-0.7))*2.7+uT*3.1);
  vec3 n=normalize(vec3(-g.x*0.55,1.0,-g.y*0.55));
  vec3 V=normalize(cameraPosition-vW);float fr=pow(1.0-max(dot(n,V),0.0),3.0);
  float dk=smoothstep(0.5,30.0,rel);vec3 col=mix(uShal,uDeep,dk);
  col=mix(col,uSky,0.15+fr*0.5);
  float sp=pow(max(dot(reflect(-uSun,n),V),0.0),160.0);col+=vec3(1.0,0.95,0.85)*sp*1.6;
  float wave=sin(rel*2.4-uT*1.8+sin(atan(p.y,p.x)*23.0)*1.5)*0.5+0.5;
  float foam=smoothstep(2.6,0.9,rel)*(0.35+0.65*wave)+smoothstep(1.6,1.0,rel);
  col=mix(col,vec3(0.96,0.98,1.0),clamp(foam,0.0,1.0)*0.75);
  float a=mix(0.45,0.94,smoothstep(1.0,12.0,rel));a=max(a,clamp(foam,0.0,1.0)*0.85);
  if(rel<0.9)discard;
  gl_FragColor=vec4(col,a);
  #include <tonemapping_fragment>
  #include <encodings_fragment>
  #include <fog_fragment>
}`});
  const o=new THREE.Mesh(new THREE.PlaneGeometry(2600,2600,1,1),m);o.rotation.x=-Math.PI/2;o.position.y=-0.2;o.renderOrder=2;o.userData.noMerge=1;world.add(o);ISL.ocean=o;}
/* wall with openings (doors / windows). axis 'x': runs along x at z=c; 'z': along z at x=c. openings: [a,b,y0,y1] along the run */
function islWall(axis,a0,a1,c,t,y0,h,mat,ops){ops=(ops||[]).slice().sort((p,q)=>p[0]-q[0]);let cur=a0;
  const piece=(a,b,ya,yb)=>{if(b-a<0.02||yb-ya<0.02)return;const L=b-a,m=(a+b)/2;if(axis==='x')solidT(m,y0+ya,c,L,yb-ya,t,mat,3);else solidT(c,y0+ya,m,t,yb-ya,L,mat,3);};
  for(const[a,b,oy0,oy1]of ops){piece(cur,a,0,h);piece(a,b,0,oy0);piece(a,b,oy1,h);cur=b;}piece(cur,a1,0,h);}
function islFrame(axis,a,b,c,t,y0,oy0,oy1,lm){/* sill + lintel + jambs around an opening, sticking out a little */
  const out=t/2+0.05,m=(a+b)/2,L=b-a+0.24;
  const bx=(cx,cy,cz,w,h,d)=>solid(cx,cy,cz,w,h,d,lm,false,false);
  for(const s of[-1,1]){if(axis==='x'){if(oy0>0.05)bx(m,y0+oy0-0.08,c+s*out,L,0.1,0.12);bx(m,y0+oy1,c+s*out,L,0.14,0.1);}else{if(oy0>0.05)bx(c+s*out,y0+oy0-0.08,m,0.12,0.1,L);bx(c+s*out,y0+oy1,m,0.1,0.14,L);}}}
function islFurn(x,z,kind,rot){const M=islMats();const b=(cx,cy,cz,w,h,d,mat,col=true)=>{const W=rot?d:w,D=rot?w:d;const X=x+(rot?cz:cx),Z=z+(rot?cx:cz);return solid(X,cy,Z,W,h,D,mat,col,true);};
  if(kind==='table'){b(0,0.72,0,1.3,0.07,0.8,M.wood,false);for(const sx of[-1,1])for(const sz of[-1,1])b(sx*0.58,0,sz*0.33,0.07,0.72,0.07,M.woodD,false);colliders.push({minX:x-(rot?0.4:0.65),maxX:x+(rot?0.4:0.65),minZ:z-(rot?0.65:0.4),maxZ:z+(rot?0.65:0.4),minY:0,maxY:0.79});
    for(const sx of[-1,1]){b(sx*0.95,0.42,0,0.42,0.05,0.42,M.wood,false);b(sx*1.14,0.42,0,0.05,0.5,0.42,M.wood,false);for(const k of[-1,1])b(sx*0.95+k*0.17,0,0.17,0.04,0.42,0.04,M.woodD,false);}}
  else if(kind==='bed'){b(0,0,0,0.95,0.32,1.95,M.woodD);b(0,0.32,0.02,0.9,0.16,1.88,M.cloth,false);b(0,0.48,0.25,0.92,0.06,1.3,M.blanket,false);b(0,0.48,-0.72,0.6,0.1,0.32,M.cloth,false);b(0,0,-0.99,0.95,0.85,0.06,M.woodD,false);}
  else if(kind==='shelf'){const BK=[0x8a3b2a,0x2f5f8a,0xb08a2a,0x3f6f3a,0x6a2a5a,0xd0c8b0];
    b(0,0,-0.17,1.2,1.9,0.04,M.woodD,false);for(const sx of[-1,1])b(sx*0.58,0,0,0.04,1.9,0.4,M.wood,false);
    for(const y of[0.04,0.5,0.98,1.46,1.88])b(0,y,0,1.16,0.035,0.38,M.wood,false);
    colliders.push({minX:x-(rot?0.2:0.6),maxX:x+(rot?0.2:0.6),minZ:z-(rot?0.6:0.2),maxZ:z+(rot?0.6:0.2),minY:0,maxY:1.92});
    for(const y of[0.075,0.535,1.015,1.495]){let cx=-0.52;while(cx<0.48){const bw=0.035+rng()*0.04,bh=0.24+rng()*0.14;if(rng()<0.82)b(cx+bw/2,y,0.02,bw,bh,0.26,pick(M.books),false);cx+=bw+0.004;}}}
  else if(kind==='sofa'){b(0,0,0,1.9,0.42,0.85,M.blanket);b(0,0.42,-0.33,1.9,0.45,0.2,M.blanket,false);for(const sx of[-1,1])b(sx*0.88,0.42,0,0.16,0.25,0.85,M.blanket,false);}
  else if(kind==='rug'){const r=new THREE.Mesh(new THREE.BoxGeometry(rot?1.4:2.2,0.015,rot?2.2:1.4),M.rug);r.position.set(x,0.075,z);r.receiveShadow=true;world.add(r);}}
/* ===== 1.02: BGMI-style Battle Royale houses — cottages, two-storey houses, villas with roof access, apartment blocks, shops, walled compounds ===== */
const BG_ROOF={nuke:0x4c515a,cache:0x5c5049,inferno:0xa9492f,ancient:0x55704a,mirage:0xb0603a,dust2:0x9c5b3b,anubis:0x7d5c3c};
let _bgM=null,_bgMT=null,_bgGlass=[];
function bgMats(){if(_bgM&&_bgMT===THEME_ID)return _bgM;_bgMT=THEME_ID;const M=islMats();
  const rc='#'+new THREE.Color(BG_ROOF[THEME_ID]||0x8a4a34).getHexString();
  const tiles=brTex(128,128,(c,w,h)=>{c.fillStyle=rc;c.fillRect(0,0,w,h);for(let r=0;r<8;r++){const y=r*h/8;for(let k=0;k<9;k++){const x=k*w/8-(r%2)*w/16;const g=c.createLinearGradient(x,0,x+w/8,0);g.addColorStop(0,'rgba(0,0,0,.30)');g.addColorStop(0.45,'rgba(255,255,255,.13)');g.addColorStop(1,'rgba(0,0,0,.30)');c.fillStyle=g;c.fillRect(x,y,w/8,h/8);
      c.fillStyle=`rgba(${Math.random()<0.5?0:255},${Math.random()<0.5?0:255},0,${Math.random()*0.06})`;c.fillRect(x,y,w/8,h/8);}c.fillStyle='rgba(0,0,0,.42)';c.fillRect(0,y+h/8-2.5,w,2.5);}},1,1);
  const tar=brTex(64,64,(c,w,h)=>{c.fillStyle='#6f6c66';c.fillRect(0,0,w,h);for(let i=0;i<500;i++){const v=80+Math.random()*60|0;c.fillStyle=`rgba(${v},${v},${v-6},.5)`;c.fillRect(Math.random()*w,Math.random()*h,1.5,1.5);}},1,1);
  const bars=brTex(64,64,(c,w,h)=>{c.clearRect(0,0,w,h);c.fillStyle='#2c3034';for(let i=0;i<8;i++)c.fillRect(i*8+2,0,3,h);c.fillRect(0,2,w,4);c.fillRect(0,h-6,w,4);c.fillRect(0,h/2-2,w,4);});
  return _bgM={tiles:Lm({map:tiles}),tar:Lm({map:tar}),plank:M.plank,tile:M.tile,wood:M.wood,woodD:M.woodD,metal:M.metal,
    glass:new THREE.MeshPhongMaterial({color:0x9ec3d6,specular:0xffffff,shininess:90,transparent:true,opacity:0.3,depthWrite:false,side:THREE.DoubleSide}),
    gate:new THREE.MeshLambertMaterial({map:bars,alphaTest:0.4,side:THREE.DoubleSide}),
    stone:pm(0x9a948a,{map:texConcrete}),dark:pm(0x2b2f33),white:pm(0xeeeae2),steel:pm(0x8c9399),rail:pm(0x3a3f45),
    fab:[0xc0392b,0x2f7fbf,0xe0a21a,0x3f8f4a,0x8e44ad,0xd35400].map(c=>pm(c)),
    car:[0xb03a2e,0x2e5d8a,0xd8d4c8,0x3c4a3a,0x1f1f22,0xc9a227].map(c=>pm(c)),doorMats:new Map()};}
function bgFlat(g){world.add(g);g.updateMatrixWorld(true);for(const ch of g.children.slice()){ch.matrixWorld.decompose(ch.position,ch.quaternion,ch.scale);world.add(ch);}world.remove(g);}
function bgDoorMat(col){const B=bgMats();if(!B.doorMats.has(col))B.doorMats.set(col,Lm({color:col,map:islMats().plank.map}));return B.doorMats.get(col);}
function bgGlassFlush(){if(!_bgGlass.length)return;const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(_bgGlass,3));g.computeVertexNormals();
  const m=new THREE.Mesh(g,bgMats().glass);m.userData.noMerge=1;m.renderOrder=3;world.add(m);_bgGlass=[];}
/* furniture at any height, world coords; rot=true turns it 90° */
function bgFurn(X,Y,Z,kind,rot){const M=islMats(),B=bgMats();const b=(cx,cy,cz,w,h,d,mat,col=true)=>{const W=rot?d:w,D=rot?w:d;return solid(X+(rot?cz:cx),Y+cy,Z+(rot?cx:cz),W,h,D,mat,col,true);};
  const cbox=(w,h,d)=>colliders.push({minX:X-(rot?d:w)/2,maxX:X+(rot?d:w)/2,minZ:Z-(rot?w:d)/2,maxZ:Z+(rot?w:d)/2,minY:Y,maxY:Y+h});
  if(kind==='table'){b(0,0.72,0,1.3,0.07,0.8,M.wood,false);for(const sx of[-1,1])for(const sz of[-1,1])b(sx*0.58,0,sz*0.33,0.07,0.72,0.07,M.woodD,false);cbox(1.3,0.79,0.8);
    for(const sx of[-1,1]){b(sx*0.95,0.42,0,0.42,0.05,0.42,M.wood,false);b(sx*1.14,0.42,0,0.05,0.5,0.42,M.wood,false);}}
  else if(kind==='bed'){b(0,0,0,0.95,0.32,1.95,M.woodD);b(0,0.32,0.02,0.9,0.16,1.88,M.cloth,false);b(0,0.48,0.25,0.92,0.06,1.3,M.blanket,false);b(0,0.48,-0.72,0.6,0.1,0.32,M.cloth,false);b(0,0,-0.99,0.95,0.85,0.06,M.woodD,false);}
  else if(kind==='sofa'){b(0,0,0,1.9,0.42,0.85,M.blanket);b(0,0.42,-0.33,1.9,0.45,0.2,M.blanket,false);for(const sx of[-1,1])b(sx*0.88,0.42,0,0.16,0.25,0.85,M.blanket,false);}
  else if(kind==='wardrobe'){b(0,0,0,1.3,2.0,0.6,M.woodD);b(-0.33,0.25,0.31,0.6,1.6,0.02,M.wood,false);b(0.33,0.25,0.31,0.6,1.6,0.02,M.wood,false);}
  else if(kind==='counter'){b(0,0,0,2.4,0.88,0.62,B.white);b(0,0.88,0,2.44,0.05,0.66,B.stone,false);b(0.6,0.93,0,0.5,0.04,0.36,B.steel,false);b(0,1.55,-0.12,2.4,0.65,0.36,B.white,false);}
  else if(kind==='fridge'){b(0,0,0,0.75,1.85,0.7,B.white);b(0.3,0.9,0.36,0.04,0.5,0.03,B.steel,false);}
  else if(kind==='desk'){b(0,0.74,0,1.4,0.05,0.7,M.wood,false);b(-0.6,0,0,0.08,0.74,0.66,M.woodD,false);b(0.45,0,0,0.5,0.74,0.66,M.woodD,false);cbox(1.4,0.79,0.7);b(-0.2,0.79,-0.15,0.5,0.32,0.04,B.dark,false);}
  else if(kind==='shelf'){b(0,0,-0.17,1.2,1.9,0.04,M.woodD,false);for(const sx of[-1,1])b(sx*0.58,0,0,0.04,1.9,0.4,M.wood,false);for(const y of[0.04,0.5,0.98,1.46,1.88])b(0,y,0,1.16,0.035,0.38,M.wood,false);cbox(1.2,1.92,0.4);
    for(const y of[0.075,0.535,1.015,1.495]){let cx=-0.52;while(cx<0.48){const bw=0.04+rng()*0.06,bh=0.18+rng()*0.2;if(rng()<0.8)b(cx+bw/2,y,0.02,bw,bh,0.28,pick(M.books),false);cx+=bw+0.01;}}}
  else if(kind==='rug'){const r=new THREE.Mesh(new THREE.BoxGeometry(rot?1.4:2.2,0.015,rot?2.2:1.4),M.rug);r.position.set(X,Y+0.075,Z);r.receiveShadow=true;world.add(r);}
  else if(kind==='tank'){const tk=new THREE.Mesh(new THREE.CylinderGeometry(0.75,0.75,1.4,16),B.dark);brDeco(tk,X,Y+1.3,Z);for(const sx of[-1,1])for(const sz of[-1,1])solid(X+sx*0.5,Y,Z+sz*0.5,0.1,0.6,0.1,B.rail,false,false);cbox(1.5,2,1.5);}
  else if(kind==='ac'){b(0,0,0,0.9,0.6,0.5,B.white);b(0,0.12,0.26,0.6,0.36,0.02,B.rail,false);}}
/* parked car — solid cover */
function bgCar(x,z,alongX,col){const B=bgMats(),m=col||pick(B.car);const g=new THREE.Group();g.position.set(x,0,z);g.rotation.y=alongX?Math.PI/2:0;
  const add=(geo,mat,px,py,pz)=>{const o=new THREE.Mesh(geo,mat);o.position.set(px,py,pz);o.castShadow=o.receiveShadow=true;g.add(o);return o;};
  add(new THREE.BoxGeometry(1.8,0.7,4.2),m,0,0.62,0);add(new THREE.BoxGeometry(1.62,0.58,2.1),m,0,1.25,-0.2);
  add(new THREE.BoxGeometry(1.64,0.44,1.9),B.dark,0,1.27,-0.2);add(new THREE.BoxGeometry(1.7,0.12,0.2),B.steel,0,0.5,2.12);add(new THREE.BoxGeometry(1.7,0.12,0.2),B.steel,0,0.5,-2.12);
  for(const sx of[-1,1])for(const sz of[-1.35,1.35]){const w=add(new THREE.CylinderGeometry(0.34,0.34,0.24,12),B.dark,sx*0.86,0.34,sz);w.rotation.z=Math.PI/2;}
  for(const sx of[-0.6,0.6])add(new THREE.BoxGeometry(0.3,0.14,0.04),pm(0xfff3c4),sx,0.72,2.11);
  bgFlat(g);if(alongX)brCol(x,z,4.2,1.55,1.8);else brCol(x,z,1.8,1.55,4.2);}

/* ---- the house builder. Works in a local frame: u = long side, v = depth (+v is the front). k turns it by 90° steps. ---- */
function bgHouse(x,z,w,d,F,arch){const B=bgMats(),M=islMats(),lm=MAT.ledge;
  const k=w>=d?(rng()<0.5?0:2):(rng()<0.5?1:3),c=Math.round(Math.cos(k*Math.PI/2)),s=Math.round(Math.sin(k*Math.PI/2));
  const L=Math.max(w,d),D=Math.min(w,d);const mat=pick(MAT.walls),t=0.3,H1=3.2,th=0.22,run=0.28,n=12,rise=H1/n,wid=1.05;
  const WX=(u,v)=>x+u*c+v*s,WZ=(u,v)=>z-u*s+v*c,odd=k%2===1;
  const LB=(u,y,v,lu,h,lv,m,col=true,sh=true,tile=0)=>{const X=WX(u,v),Z=WZ(u,v),a=odd?lv:lu,b=odd?lu:lv;return tile?solidT(X,y,Z,a,h,b,m,tile,col):solid(X,y,Z,a,h,b,m,col,sh);};
  const LC=(u0,u1,v0,v1,y0,y1)=>{const xs=[WX(u0,v0),WX(u1,v1)],zs=[WZ(u0,v0),WZ(u1,v1)];colliders.push({minX:Math.min(...xs),maxX:Math.max(...xs),minZ:Math.min(...zs),maxZ:Math.max(...zs),minY:y0,maxY:y1});};
  const LP=(u,y,v)=>S.houseSpots.push([WX(u,v),y,WZ(u,v)]);
  const LF=(u,y,v,kind,r)=>bgFurn(WX(u,v),y,WZ(u,v),kind,r!==odd);
  /* wall along u at v=cc ('u') or along v at u=cc ('v'); ops [a,b,y0,y1] in local run coords */
  const LW=(ax,a0,a1,cc,y0,h,m,ops,tk=t)=>{ops=(ops||[]).slice().sort((p,q)=>p[0]-q[0]);let cur=a0;
    const piece=(a,b,ya,yb)=>{if(b-a<0.02||yb-ya<0.02)return;const mm=(a+b)/2;if(ax==='u')LB(mm,y0+ya,cc,b-a,yb-ya,tk,m,true,true,3);else LB(cc,y0+ya,mm,tk,yb-ya,b-a,m,true,true,3);};
    for(const[a,b,o0,o1]of ops){piece(cur,a,0,h);piece(a,b,0,o0);piece(a,b,o1,h);cur=Math.max(cur,b);}piece(cur,a1,0,h);};
  const glassQ=(ax,a,b,cc,y0,y1)=>{const P=ax==='u'?[[a,y0,cc],[b,y0,cc],[b,y1,cc],[a,y1,cc]]:[[cc,y0,a],[cc,y0,b],[cc,y1,b],[cc,y1,a]];const Q=P.map(([u,y,v])=>[WX(u,v),y,WZ(u,v)]);for(const i of[0,1,2,0,2,3])_bgGlass.push(...Q[i]);};
  const shut=THEME.wt==='concrete'?null:bgDoorMat(pick(THEME.doors||[0x3d5a2a]));
  /* window/door trim, glass, shutters, open door leaves */
  const trim=(ax,cc,out,y0,o,isDoor,shutters)=>{const[a,b,o0,o1]=o;const m=(a+b)/2,Lr=b-a,off=cc+out*(t/2+0.04);
    const P=(cu,cy,lu,h,lo)=>ax==='u'?LB(cu,cy,off,lu,h,lo,lm,false,false):LB(off,cy,cu,lo,h,lu,lm,false,false);
    if(!isDoor)P(m,y0+o0-0.09,Lr+0.26,0.1,0.14);P(m,y0+o1,Lr+0.26,0.13,0.11);P(a-0.07,y0+o0,0.12,o1-o0,0.08);P(b+0.07,y0+o0,0.12,o1-o0,0.08);
    if(!isDoor){glassQ(ax,a,b,cc,y0+o0,y0+o1);if(shutters&&shut)for(const[sx,sg]of[[a-0.33,-1],[b+0.33,1]]){if(ax==='u')LB(sx,y0+o0-0.04,cc+out*(t/2+0.05),0.52,o1-o0+0.08,0.04,shut,false,false);else LB(cc+out*(t/2+0.05),y0+o0-0.04,sx,0.04,o1-o0+0.08,0.52,shut,false,false);}}
    else if(o0<0.05){const DL=Lr-0.06,dm=bgDoorMat(pick(THEME.doors||[0x6e4b2c]));const iv=cc-out*(t/2+DL/2+0.02);if(ax==='u')LB(a+0.05,y0,iv,0.05,o1-0.06,DL,dm,false,false);else LB(iv,y0,a+0.05,DL,o1-0.06,0.05,dm,false,false);}};
  /* slab with stair holes */
  const slab=(y,h,m,holes,col=true,tile=3,ext=0)=>{const u0=-L/2-ext,u1=L/2+ext,v0=-D/2-ext,v1=D/2+ext;const U=[u0,u1],V=[v0,v1];for(const q of holes){U.push(q[0],q[1]);V.push(q[2],q[3]);}
    const uq=A=>{const o=[];for(const a of A.slice().sort((p,q)=>p-q))if(!o.length||a-o[o.length-1]>1e-3)o.push(a);return o;};const us=uq(U.map(a=>Math.min(u1,Math.max(u0,a)))),vs=uq(V.map(a=>Math.min(v1,Math.max(v0,a))));
    for(let j=0;j<vs.length-1;j++){let st=null;for(let i=0;i<=us.length-1;i++){const inC=i<us.length-1&&!holes.some(q=>(us[i]+us[i+1])/2>q[0]&&(us[i]+us[i+1])/2<q[1]&&(vs[j]+vs[j+1])/2>q[2]&&(vs[j]+vs[j+1])/2<q[3]);
      if(inC&&st===null)st=us[i];if(!inC&&st!==null){const e=us[i];LB((st+e)/2,y,(vs[j]+vs[j+1])/2,e-st,h,vs[j+1]-vs[j],m,col,col,tile);st=null;}}}};
  /* ---- plan ---- */
  const flat=arch!=='gable';const access=arch==='villa'||arch==='apart';const vb=-D/2+t+0.02,vf=vb+wid+0.05;
  const sA0=-L/2+t+0.2,sA1=sA0+n*run;let up=F>1||access?sA1+0.38:-L/2+L*(0.42+rng()*0.16);const sB0=up+0.48,sB1=sB0+n*run;
  const stairs=[];for(let f=0;f<F-1;f++)stairs.push(f);if(access)stairs.push(F-1);
  const region=f=>f%2===0?[sA0,sA1]:[sB0,sB1];
  const canB=sB1<L/2-t-0.12;let acc=access;if(stairs.some(f=>f%2===1)&&!canB){stairs.length=Math.min(stairs.length,1);acc=false;}
  const hasPart=L>=7.6;const dv=Math.max(vf+0.75,Math.min(D/2-t-0.75,(vf+D/2-t)/2));
  const holeOf=f=>{const[a,b]=region(f);return f%2===0?[-L/2+t,b,vb-0.02,vf]:[a,b,vb-0.02,vf];};
  /* doors */
  const rng2=(lo,hi)=>lo+rng()*Math.max(0,hi-lo);
  const doorU=hasPart?((rng()<0.6||up-1.1<-L/2+2.2)&&L/2-1.3>up+1.1?rng2(up+1.1,L/2-1.3):rng2(-L/2+2.2,up-1.1)):rng2(-L/2+1.3,L/2-1.3);
  const backU=hasPart&&L/2-2.0>up+1.1&&rng()<0.55?rng2(up+1.1,L/2-2.0):null;
  const sideDoor=!backU&&rng()<0.35;
  const balc=(arch==='gable'||arch==='villa'||arch==='apart')&&F>=2&&rng()<0.75;const balU=balc?([0,-L/4,L/4].filter(q=>!hasPart||Math.abs(q-up)>1.35)[0]):null;
  const doors=[];const roomWin=arch!=='shop';
  /* ---- walls, floor by floor ---- */
  for(let f=0;f<F;f++){const y0=f*H1;
    const walls=[['u',-L/2,L/2,D/2,1],['u',-L/2,L/2,-D/2,-1],['v',-D/2,D/2,L/2,1],['v',-D/2,D/2,-L/2,-1]];
    walls.forEach(([ax,a0,a1,cc,out],wi)=>{const ops=[],dr=[];const Lr=a1-a0;
      if(f===0&&wi===0){ops.push([doorU-0.65,doorU+0.65,0,2.35]);dr.push(1);}
      if(f===0&&wi===1&&backU!==null){ops.push([backU-0.62,backU+0.62,0,2.3]);dr.push(1);}
      if(f===0&&wi===2&&sideDoor){ops.push([-0.62,0.62,0,2.3]);dr.push(1);}
      if(f>=1&&wi===0&&balc&&(f===1||arch==='apart')){ops.push([balU-0.7,balU+0.7,0,2.4]);dr.push(1);}
      if(arch==='shop'&&f===0&&wi===0){for(const[p,q]of[[-L/2+0.9,doorU-0.95],[doorU+0.95,L/2-0.9]])if(q-p>1.2){ops.push([p,q,0.5,2.55]);dr.push(0);}}
      const nW=Math.max(1,Math.floor((Lr-1.6)/2.9));for(let i=0;i<nW;i++){const cx=a0+(i+0.5)*(Lr/nW),ww=ax==='u'?1.2:1.0;
        if(ops.some(o=>cx+ww/2+0.45>o[0]&&cx-ww/2-0.45<o[1]))continue;if(cx-ww/2<a0+0.8||cx+ww/2>a1-0.8)continue;
        if(ax==='u'&&hasPart&&Math.abs(cx-up)<ww/2+0.4)continue;
        if(wi===1&&stairs.includes(f)){const[r0,r1]=region(f);if(cx+ww/2>r0-0.3&&cx-ww/2<r1+0.3)continue;}
        if(!roomWin&&f===0&&wi===0)continue;ops.push([cx-ww/2,cx+ww/2,1.0,2.3]);dr.push(0);}
      LW(ax,a0,a1,cc,y0,H1,mat,ops);
      const shW=arch==='gable'&&rng()<0.85;ops.forEach((o,i)=>trim(ax,cc,out,y0,o,!!dr[i],!dr[i]&&o[3]-o[2]<1.5&&shW));
      if(f===0)for(const[i,o]of ops.entries())if(dr[i]&&o[2]<0.05){const m=(o[0]+o[1])/2;const lu=ax==='u'?m:cc+out*0.5,lv=ax==='u'?cc+out*0.5:m;const vx=ax==='u'?0:out,vz=ax==='u'?out:0;
        doors.push({x:WX(lu,lv),z:WZ(lu,lv),nx:vx*c+vz*s,nz:-vx*s+vz*c});}});
    /* partition with a doorway on the front strip */
    if(hasPart)LW('v',-D/2+t/2,D/2-t/2,up,y0,H1-th*(f<F-1?0:0),mat,[[dv-0.62,dv+0.62,0,2.3]],0.18);
    /* floor finish */
    const holesBelow=f>0&&stairs.includes(f-1)?[holeOf(f-1)]:[];
    if(f===0){const fl=new THREE.Mesh(new THREE.BoxGeometry(L-2*t,0.05,D-2*t),hasPart&&rng()<0.6?M.tile:M.plank);fl.position.set(x,0.045,z);fl.rotation.y=k*Math.PI/2;fl.receiveShadow=true;world.add(fl);}
    /* floor band outside */
    if(f>0){for(const[ax,cc]of[['u',D/2],['u',-D/2]])LB(0,y0-0.12,cc+Math.sign(cc)*(t/2+0.04),L+0.12,0.22,0.08,lm,false,false);for(const cc of[L/2,-L/2])LB(cc+Math.sign(cc)*(t/2+0.04),y0-0.12,0,0.08,0.22,D+0.12,lm,false,false);}}
  /* upper slabs + stairs */
  for(let f=1;f<F;f++){const holes=stairs.includes(f-1)?[holeOf(f-1)]:[];slab(f*H1-th,th,mat,holes);
    slab(f*H1,0.04,M.plank,holes.map(q=>[q[0],q[1],q[2],q[3]]),false,2,-t);}
  for(const f of stairs){const y0=f*H1,[a,b]=region(f);for(let i=0;i<n;i++)LB(a+(i+0.5)*run,y0,vb+wid/2,run,(i+1)*rise+0.02,wid,i%2?M.woodD:M.wood,true,true,2);
    LB((a+b)/2,y0,vb+wid+0.02,b-a,0.3,0.04,M.woodD,false,false);
    /* rail on the floor above around the low half of the hole */
    {const yt=(f+1)*H1;const[h0,h1,hv0,hv1]=holeOf(f);const rl=(h1-h0)*0.55;LB(h0+rl/2,yt,hv1+0.03,rl,1.0,0.06,B.rail,true,false);LB(h0+rl/2,yt+0.97,hv1+0.03,rl,0.06,0.1,M.woodD,false,false);if(f%2===1)LB(h0-0.03,yt,(hv0+hv1)/2,0.06,1.0,hv1-hv0,B.rail,true,false);}}
  /* ---- roof ---- */
  const hT=F*H1;
  if(flat){const holes=acc?[holeOf(F-1)]:[];slab(hT-th,th+0.02,mat,holes,true,3,0.08);slab(hT+0.02,0.03,B.tar,holes,false,2,-0.1);
    const ph=acc?1.0:0.6;for(const[ax,cc]of[['u',D/2],['u',-D/2]])LB(0,hT,cc-Math.sign(cc)*0.12+Math.sign(cc)*0.08,L+0.16,ph,0.24,mat,true,true,3);
    for(const cc of[L/2,-L/2])LB(cc-Math.sign(cc)*0.12+Math.sign(cc)*0.08,hT,0,0.24,ph,D-0.32,mat,true,true,3);
    for(const cc of[D/2,-D/2])LB(0,hT+ph,cc+Math.sign(cc)*0.08,L+0.3,0.08,0.34,lm,false,false);for(const cc of[L/2,-L/2])LB(cc+Math.sign(cc)*0.08,hT+ph,0,0.34,0.08,D+0.3,lm,false,false);
    LB(0,hT-0.32,D/2+0.2,L+0.3,0.16,0.12,lm,false,false);LB(0,hT-0.32,-D/2-0.2,L+0.3,0.16,0.12,lm,false,false);
    if(acc){/* stair hut on the roof, door beside the top of the stairs */const[a,b]=region(F-1);const hu0=(F-1)%2===0?-L/2+0.02:a-0.15,hu1=b+0.15,hv=vf+1.3,HH=2.5;
      LW('u',hu0,hu1,hv,hT,HH,mat,[[b-1.3,b-0.1,0,2.25]],0.24);LW('u',hu0,hu1,-D/2+0.14,hT+1.0,HH-1.0,mat,[],0.24);LW('v',-D/2+0.14,hv,hu1,hT,HH,mat,[],0.24);LW('v',-D/2+0.14,hv,hu0+0.12,hT,HH,mat,[],0.24);
      LB((hu0+hu1)/2,hT+HH,(-D/2+hv)/2,hu1-hu0+0.4,0.2,hv+D/2+0.4,mat,true,true,3);LB((hu0+hu1)/2,hT+HH+0.2,(-D/2+hv)/2,hu1-hu0+0.5,0.06,hv+D/2+0.5,lm,false,false);
      trim('u',hv,1,hT,[b-1.3,b-0.1,0,2.25],true,false);
      const opp=(F-1)%2===0?1:-1;LP(opp*L/4,hT+0.06,D/4);LP(opp*(L/2-1.4),hT+0.06,D/2-1.3);
      if(rng()<0.7)LF(opp*(L/2-1.3),hT,-D/2+1.2,'tank',false);}
    else if(arch!=='flat1'&&rng()<0.5)LF(L/4,hT,0,'tank',false);
    if(arch==='villa'||arch==='apart')LF(-L/2-t/2-0.27,H1+0.6,-D/4,'ac',true);}
  else{/* gable roof: ridge along the long side, tiles, overhang, stepped colliders */
    slab(hT-th,th+0.02,mat,[],true,3,0.06);const R=D*0.3+0.35,a=Math.atan2(R,D/2),hw=D/2+0.55,Ls=hw/Math.cos(a)+0.06,yR=hT+R;
    const g=new THREE.Group();g.position.set(x,0,z);g.rotation.y=k*Math.PI/2;
    for(const sg of[-1,1]){const p=new THREE.Mesh(new THREE.BoxGeometry(L+0.9,0.14,Ls),B.tiles);p.rotation.x=sg*a;p.position.set(0,yR-(hw/2)*Math.tan(a)+0.09,sg*hw/2);p.castShadow=p.receiveShadow=true;g.add(p);worldMeshes.push(p);
      const fa=new THREE.Mesh(new THREE.BoxGeometry(L+0.95,0.22,0.06),lm);fa.position.set(0,hT-0.42+0.1,sg*(hw+0.02));g.add(fa);
      for(let i=0;i<3;i++){const v0=i*(D/2)/3,v1=(i+1)*(D/2)/3,top=yR-v0*Math.tan(a)+0.05;LC(-L/2,L/2,sg>0?v0:-v1,sg>0?v1:-v0,top-0.45,top);}}
    const sh=new THREE.Shape();sh.moveTo(-D/2,0);sh.lineTo(D/2,0);sh.lineTo(0,R);sh.lineTo(-D/2,0);
    for(const sg of[-1,1]){const ge=new THREE.ExtrudeGeometry(sh,{depth:t,bevelEnabled:false});const m=new THREE.Mesh(ge,mat);m.rotation.y=Math.PI/2;m.position.set(sg*L/2-t/2,hT,0);m.castShadow=m.receiveShadow=true;g.add(m);worldMeshes.push(m);
      const ve=new THREE.Mesh(new THREE.CircleGeometry(0.32,12),B.dark);ve.rotation.y=sg*Math.PI/2;ve.position.set(sg*(L/2+t/2+0.01),hT+R*0.42,0);g.add(ve);}
    const ridge=new THREE.Mesh(new THREE.BoxGeometry(L+1,0.16,0.34),shadeOf(B.tiles,0.7));ridge.position.set(0,yR+0.06,0);g.add(ridge);
    const ch=new THREE.Mesh(new THREE.BoxGeometry(0.7,2.2,0.7),shadeOf(mat,0.8));ch.position.set(L/2-1.4,yR-0.5,-D/4);ch.castShadow=true;g.add(ch);const cc=new THREE.Mesh(new THREE.BoxGeometry(0.85,0.12,0.85),lm);cc.position.set(L/2-1.4,yR+0.62,-D/4);g.add(cc);
    bgFlat(g);}
  /* corner pilasters, plinth, drainpipe */
  for(const su of[-1,1])for(const sv of[-1,1])LB(su*(L/2),0,sv*(D/2),t+0.14,hT,t+0.14,lm,false,false);
  for(const cc of[D/2,-D/2])LB(0,0,cc,L+0.1,0.45,t+0.1,shadeOf(mat,0.7),false,false);for(const cc of[L/2,-L/2])LB(cc,0,0,t+0.1,0.45,D+0.1,shadeOf(mat,0.7),false,false);
  {const dp=new THREE.Mesh(new THREE.CylinderGeometry(0.06,0.06,hT,6),B.rail);brDeco(dp,WX(L/2-0.25,D/2+t/2+0.08),hT/2,WZ(L/2-0.25,D/2+t/2+0.08),false);}
  /* front step + canopy over the front door */
  LB(doorU,0,D/2+t/2+0.4,1.9,0.16,0.8,B.stone);
  if(arch!=='shop'){LB(doorU,2.62,D/2+t/2+0.6,2.0,0.1,1.2,flat?lm:B.tiles,false,false);for(const sg of[-1,1])LB(doorU+sg*0.92,2.25,D/2+t/2+0.2,0.08,0.38,0.4,lm,false,false);}
  else{const aw=pick(B.fab);const g=new THREE.Group();g.position.set(WX(0,D/2+t/2+0.75),2.75,WZ(0,D/2+t/2+0.75));g.rotation.y=k*Math.PI/2;const p=new THREE.Mesh(new THREE.BoxGeometry(L-0.6,0.06,1.6),aw);p.rotation.x=0.32;p.castShadow=true;g.add(p);bgFlat(g);
    const sg=new THREE.Mesh(new THREE.PlaneGeometry(Math.min(4.5,L-2),0.7),new THREE.MeshLambertMaterial({map:brTextTex(pick(['MARKET','STORE','PHARMACY','BAKERY','GROCERY','CAFE','HARDWARE']),'#f2ede2','#2a2a2a')}));
    sg.position.set(WX(0,D/2+t/2+0.03),3.05,WZ(0,D/2+t/2+0.03));sg.rotation.y=k*Math.PI/2;sg.userData.noMerge=1;world.add(sg);}
  /* balconies */
  if(balc)for(let f=1;f<F;f++){if(f>1&&arch!=='apart')break;const y=f*H1,bv=D/2+0.75;LB(balU,y-0.2,bv,3.3,0.2,1.5,shadeOf(mat,0.9));LB(balU,y-0.32,bv,3.3,0.12,1.5,lm,false,false);
    LB(balU,y,D/2+1.47,3.3,1.0,0.06,B.rail,true,false);LB(balU,y+0.98,D/2+1.47,3.36,0.06,0.12,lm,false,false);for(const sg of[-1,1])LB(balU+sg*1.62,y,bv,0.06,1.0,1.44,B.rail,true,false);
    for(let i=-6;i<=6;i++)LB(balU+i*0.25,y,D/2+1.47,0.03,1.0,0.03,B.rail,false,false);LP(balU,y+0.02,bv);}
  /* ---- furniture + loot ---- */
  const inA0=-L/2+t,inA1=hasPart?up-0.09:L/2-t,inB0=hasPart?up+0.09:null,inB1=L/2-t,fv0=vf+0.15,fv1=D/2-t;
  for(let f=0;f<F;f++){const y=f*H1+(f?0.04:0.07);const stairB=(stairs.includes(f)&&f%2===1)||(f>0&&stairs.includes(f-1)&&(f-1)%2===1);
    if(arch==='shop'&&f===0){for(let i=0;i<Math.floor((L-3)/2.2);i++)LF(-L/2+2+i*2.2,y,-0.2,'shelf',false);LF(L/2-t-0.35,y,-D/4,'counter',true);LP(0,y,D/4);LP(-L/4,y,-D/2+t+1.5);LP(L/4,y,-D/2+t+1.5);continue;}
    if(f===0){if(hasPart){if(inA1-inA0>2.4)LF(inA0+0.48,y,(fv0+fv1)/2,'sofa',true);if(inA1-inA0>3.4&&fv1-fv0>2.3)LF((inA0+inA1)/2+0.3,y,(fv0+fv1)/2,'rug',false);
        if(inB1-inB0>2.6&&(D>=7.2||!sideDoor)&&D>6.1){LF(inB1-0.33,y,-D/2+t+1.45,'counter',true);LF(inB1-0.4,y,-D/2+t+0.45+0.0,'fridge',false);{const tu=(inB0+inB1)/2+0.45;if(inB1-inB0>4.4&&Math.abs(tu-doorU)>2&&!(sideDoor&&inB1-tu<2.2))LF(tu,y,0.3,'table',false);}}
        LP((inA0+inA1)/2,y,(fv0+fv1)/2);LP((inB0+inB1)/2,y,0);}
      else{LF(inA0+1.05,y,0.2,'bed',true);LF(L/4,y,-D/2+t+0.22,'shelf',false);if(L>7&&Math.abs(0.5-doorU)>2.1)LF(0.5,y,D/4-0.3,'table',false);LP(0,y,0);LP(L/4,y,-D/4);}}
    else{if(hasPart){LF(inA0+1.05,y,(fv0+fv1)/2,'bed',true);if(inA1-inA0>3)LF(inA1-0.36,y,fv1-0.75,'wardrobe',true);
        if(!stairB){LF(inB1-1.05,y,0.4,'bed',true);LF((inB0+inB1)/2,y,-D/2+t+0.4,'desk',false);}else{LF(inB1-1.05,y,fv1-1.05,'bed',true);}
        LP((inA0+inA1)/2+0.4,y,(fv0+fv1)/2);LP((inB0+inB1)/2,y,stairB?fv1-1.5:0);}
      else LP(0,y,0);}}
  const tst={stairs:stairs.map(f=>{const[a,b]=region(f);const P=[];for(let u=(f%2?a-0.25:a+0.14);u<=b+0.3;u+=0.1)P.push([WX(u,vb+wid/2),WZ(u,vb+wid/2)]);return{f,y:f*H1,P};}),
    door:[[WX(doorU,D/2+1.5),WZ(doorU,D/2+1.5)],[WX(doorU,D/2-t-0.8),WZ(doorU,D/2-t-0.8)]],part:hasPart?[[WX(up-1,dv),WZ(up-1,dv)],[WX(up+1,dv),WZ(up+1,dv)]]:null};
  const xs=[WX(-L/2,-D/2),WX(L/2,D/2)],zs=[WZ(-L/2,-D/2),WZ(L/2,D/2)];
  return{x0:Math.min(...xs),x1:Math.max(...xs),z0:Math.min(...zs),z1:Math.max(...zs),doors,h:flat?hT+1:hT+D*0.3+0.4,tst};}

/* walled compound around a house, gates lined up with its doors; a car or cover inside */
function bgCompound(r,m){const B=bgMats(),lm=MAT.ledge;const wm=shadeOf(pick(MAT.walls),0.86);const X0=r.x0-m,X1=r.x1+m,Z0=r.z0-m,Z1=r.z1+m,WH=1.75,T=0.32;
  const gates={n:[],s:[],e:[],w:[]};for(const d of r.doors){if(d.nz>0.5)gates.n.push(d.x);else if(d.nz<-0.5)gates.s.push(d.x);else if(d.nx>0.5)gates.e.push(d.z);else gates.w.push(d.z);}
  if(!r.doors.length)gates.n.push((X0+X1)/2);
  const run=(edge,a0,a1,fix,isX)=>{const G=gates[edge].map(g=>[Math.max(a0+0.6,g-1.7),Math.min(a1-0.6,g+1.7)]).sort((p,q)=>p[0]-q[0]);let cur=a0;
    const seg=(a,b)=>{if(b-a<0.15)return;const mm=(a+b)/2;if(isX){solidT(mm,0,fix,b-a,WH,T,wm,3);solid(mm,WH,fix,b-a+0.06,0.1,T+0.12,lm,false,false);}else{solidT(fix,0,mm,T,WH,b-a,wm,3);solid(fix,WH,mm,T+0.12,0.1,b-a+0.06,lm,false,false);}};
    for(const[g0,g1]of G){seg(cur,g0);cur=g1;
      for(const p of[g0,g1]){if(isX)solid(p,0,fix,0.5,2.15,0.5,lm);else solid(fix,0,p,0.5,2.15,0.5,lm);}
      const gl=Math.min(1.6,g1-g0-0.7);if(gl>0.5){const inw=isX?(fix>r.z1?-1:1):(fix>r.x1?-1:1);const gm=new THREE.Mesh(isX?new THREE.BoxGeometry(0.04,1.6,gl):new THREE.BoxGeometry(gl,1.6,0.04),B.gate);
        if(isX)gm.position.set(g0+0.32,0.9,fix+inw*(gl/2+0.2));else gm.position.set(fix+inw*(gl/2+0.2),0.9,g0+0.32);      world.add(gm);}}
    seg(cur,a1);};
  run('n',X0,X1,Z1,true);run('s',X0,X1,Z0,true);run('e',Z0+T/2,Z1-T/2,X1,false);run('w',Z0+T/2,Z1-T/2,X0,false);
  /* yard contents on a side without a gate */
  const sides=[['n',(X0+X1)/2,(Z1+r.z1)/2,X1-X0,true],['s',(X0+X1)/2,(Z0+r.z0)/2,X1-X0,true],['e',(X1+r.x1)/2,(Z0+Z1)/2,Z1-Z0,false],['w',(X0+r.x0)/2,(Z0+Z1)/2,Z1-Z0,false]].filter(q=>!gates[q[0]].length&&q[3]>6);
  const q=sides.length?pick(sides):null;
  if(q){if(rng()<0.6)bgCar(q[1],q[2],q[4]);else{crate(q[1]-0.6*(q[4]?1:0),q[2]-0.6*(q[4]?0:1));crate(q[1]+0.6*(q[4]?1:0),q[2]+0.6*(q[4]?0:1));solid(q[1],1.1,q[2],0.85,0.85,0.85,MAT.crate);}
    S.houseSpots.push([q[1]+(q[4]?2.6:0),0.1,q[2]+(q[4]?0:2.6)]);}}
/* house type for the place and the map */
function bgArch(F,town){const desert=THEME.roof==='flat'||THEME.roof==='dome'||THEME_ID==='anubis'||THEME_ID==='dust2';
  if(F>=3)return'apart';if(F===2)return desert?(rng()<0.85?'villa':'gable'):(rng()<0.55?'gable':'villa');
  if(town&&rng()<0.4)return'shop';return desert?(rng()<0.85?'flat1':'gable'):(rng()<0.7?'gable':'flat1');}

function islHouse(x,z,w,d,floors,arch){return bgHouse(x,z,w,d,floors,arch||bgArch(floors,false));}
function islSpot(m,r){for(let i=0;i<60;i++){const a=rng()*Math.PI*2,rr=Math.sqrt(rng())*ISL.R0;const x=Math.cos(a)*rr,z=Math.sin(a)*rr;if(!islIn(x,z,m))continue;if(blocked(x,z,r||1))continue;if(brFlat(x,z,(r||1)+0.6))continue;return[x,z];}return null;}function brHouse(x,z,w,d,f,a){brFlatRect(x,z,w+3,d+3);return islHouse(x,z,w,d,f,a);}

/* ===== Battle Royale island: named places, landmarks, roads (all from the seeded rng, so every player builds the same island) ===== */
const POI_DEF=[
  {k:'harbor',n:'Harbor',coast:1,r:34,w:9},
  {k:'lighthouse',n:'Lighthouse Point',coast:1,r:18,w:2},
  {k:'airfield',n:'Airfield',r:58,w:3},
  {k:'base',n:'Military Base',r:30,w:0},
  {k:'farm',n:'Sunset Farm',r:34,w:5},
  {k:'radio',n:'Radio Hill',r:20,w:2},
  {k:'town',n:'Old Town',r:46,w:26},
  {k:'town2',n:'Palm Village',r:38,w:18},
  {k:'town3',n:'Market Square',r:36,w:18}];
/* ===== 1.01: enterable BR structures + theme-aware places ===== */
const POI_THEME={
  nuke:{farm:{k:'plant',n:'Reactor Plant',r:42,w:3},town2:{n:'Staff Housing'},town3:{n:'Visitor Center'}},
  cache:{farm:{n:'Kolkhoz Farm'},town2:{n:'Workers Village'}},
  inferno:{farm:{n:'Vineyard Farm'},town2:{n:'Olive Village'}},
  ancient:{farm:{n:'Maize Farm'},town2:{n:'Jungle Village'}},
  anubis:{farm:{n:'Nile Farm'}},
  dust2:{farm:{n:'Oasis Farm'}},
  mirage:{farm:{n:'Oasis Farm'}}};
function islPoiDefs(){const o=POI_THEME[THEME_ID]||{};return POI_DEF.map(d=>Object.assign({},d,o[d.k]||{}));}
function brConcRep(rx,ry,col,side){const t=texConcrete.clone();t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(rx,ry);t.needsUpdate=true;return Lm({color:col||0xdfe1dd,map:t,side:side||THREE.FrontSide});}
function brShoot(m){worldMeshes.push(m);return m;}
function brLadder(lx,lz,nx,nz,h){const along=nz!==0;ladderMesh(lx,lz,nx,nz,along,h);const cx=lx+nx*0.38,cz=lz+nz*0.38;
  ladders.push({minX:cx-(along?0.45:0.4),maxX:cx+(along?0.45:0.4),minZ:cz-(along?0.4:0.45),maxZ:cz+(along?0.4:0.45),top:h,nx,nz});}
/* trees that fit the theme (no palms around a reactor or in Ukraine) */
function brShoreTree(x,z){const k=THEME.tree;if(k==='palm'||k==='jungle'){palmTree(x,z);return;}if(k==='none')return;themedTree(x,z);}
function brLamp(x,z){const pole=pm(0x50565c);solid(x,0,z,0.16,4.2,0.16,pole);solid(x+0.45,4.1,z,1.0,0.1,0.14,pole,false,false);
  const h=new THREE.Mesh(new THREE.BoxGeometry(0.42,0.12,0.26),new THREE.MeshBasicMaterial({color:0xfff2c8}));h.position.set(x+0.8,4.04,z);h.userData.noMerge=1;world.add(h);}
function brSquareTree(x,z){if(THEME.tree==='none')brLamp(x,z);else if(THEME.tree==='palm'||THEME.tree==='jungle')palmTree(x,z);else themedTree(x,z);}
let _brM=null;
function brMats(){if(_brM)return _brM;
  const barn=brTex(128,128,(c,w,h)=>{for(let i=0;i<8;i++){const x=i*w/8;c.fillStyle=`hsl(${4+Math.random()*4},${52+Math.random()*10}%,${30+Math.random()*6}%)`;c.fillRect(x,0,w/8,h);c.fillStyle='rgba(25,6,4,.6)';c.fillRect(x,0,2,h);
    for(let k=0;k<4;k++){c.fillStyle='rgba(255,230,210,.05)';c.fillRect(x+3+Math.random()*(w/8-6),0,1,h);}c.fillStyle='rgba(20,8,4,.5)';c.beginPath();c.arc(x+w/16,h*0.12,1.2,0,7);c.arc(x+w/16,h*0.88,1.2,0,7);c.fill();}});
  const tin=brTex(128,128,(c,w,h)=>{c.fillStyle='#4a4644';c.fillRect(0,0,w,h);for(let x=0;x<w;x+=8){const g=c.createLinearGradient(x,0,x+8,0);g.addColorStop(0,'rgba(255,255,255,.08)');g.addColorStop(0.5,'rgba(0,0,0,.18)');g.addColorStop(1,'rgba(255,255,255,.08)');c.fillStyle=g;c.fillRect(x,0,8,h);}
    for(let i=0;i<40;i++){c.fillStyle=`rgba(${120+Math.random()*40|0},70,40,.12)`;c.fillRect(Math.random()*w,Math.random()*h,3+Math.random()*10,2+Math.random()*12);}});
  const door=brTex(64,128,(c,w,h)=>{c.fillStyle='#8f2a20';c.fillRect(0,0,w,h);for(let i=0;i<4;i++){c.fillStyle='rgba(0,0,0,.25)';c.fillRect(i*w/4,0,1.5,h);}c.strokeStyle='#efe9dc';c.lineWidth=5;c.strokeRect(3,3,w-6,h-6);c.beginPath();c.moveTo(3,3);c.lineTo(w-3,h/2);c.lineTo(3,h-3);c.moveTo(w-3,3);c.lineTo(3,h/2);c.lineTo(w-3,h-3);c.stroke();c.beginPath();c.moveTo(3,h/2);c.lineTo(w-3,h/2);c.stroke();});
  const hay=brTex(64,64,(c,w,h)=>{c.fillStyle='#cfae5a';c.fillRect(0,0,w,h);for(let i=0;i<260;i++){c.strokeStyle=`rgba(${150+Math.random()*80|0},${120+Math.random()*60|0},40,.55)`;c.beginPath();const x=Math.random()*w,y=Math.random()*h;c.moveTo(x,y);c.lineTo(x+Math.random()*10-5,y+Math.random()*3);c.stroke();}c.fillStyle='rgba(90,60,20,.5)';c.fillRect(0,h*0.3,w,2);c.fillRect(0,h*0.7,w,2);});
  const haz=brTex(128,128,(c,w,h)=>{c.fillStyle='#f2c418';c.fillRect(0,0,w,h);c.strokeStyle='#111';c.lineWidth=6;c.strokeRect(5,5,w-10,h-10);c.fillStyle='#111';const cx=w/2,cy=h*0.44;c.beginPath();c.arc(cx,cy,7,0,7);c.fill();
    for(let i=0;i<3;i++){const a=-Math.PI/2+i*Math.PI*2/3;c.beginPath();c.moveTo(cx+Math.cos(a-0.52)*12,cy+Math.sin(a-0.52)*12);c.arc(cx,cy,34,a-0.52,a+0.52);c.arc(cx,cy,12,a+0.52,a-0.52,true);c.fill();}
    c.font='bold 15px Arial';c.textAlign='center';c.fillText('RADIATION',cx,h-14);});
  const steam=brTex(64,64,(c,w,h)=>{const g=c.createRadialGradient(w/2,h/2,0,w/2,h/2,w/2);g.addColorStop(0,'rgba(255,255,255,.9)');g.addColorStop(0.5,'rgba(245,248,250,.45)');g.addColorStop(1,'rgba(240,244,248,0)');c.fillStyle=g;c.fillRect(0,0,w,h);});
  return _brM={barn:Lm({map:barn}),tin:Lm({map:tin,side:THREE.DoubleSide}),door:Lm({map:door}),hay:Lm({map:hay}),trim:pm(0xefe9dc),haz:Lm({map:haz}),steam,
    conc:pm(0xd4d6d2,{map:texConcrete}),concD:pm(0xb4b8b6,{map:texConcrete}),steel:pm(0x7d858c),steelD:pm(0x4a5056),canvas:pm(0x5b6b43),cot:pm(0x3f4a30)};}
function brSign(tex,x,y,z,ry,w,h){const m=new THREE.Mesh(new THREE.PlaneGeometry(w||1,h||1),tex.isMaterial?tex:Lm({map:tex}));m.position.set(x,y,z);m.rotation.y=ry||0;m.userData.noMerge=1;world.add(m);return m;}
function brTextTex(txt,bg,fg){return brTex(512,96,(c,w,h)=>{c.fillStyle=bg;c.fillRect(0,0,w,h);c.fillStyle=fg;c.font='bold 58px Arial';c.textAlign='center';c.textBaseline='middle';c.fillText(txt,w/2,h/2+2);});}

/* ---- enterable red barn: big front doors, side + back doors, hay loft with a ladder, a real gable roof ---- */
function brBarn(x,z){const B=brMats(),M=islMats();const W=10,D=14,t=0.3,H=5.5,R=2.6;const x0=x-W/2,x1=x+W/2,z0=z-D/2,z1=z+D/2;
  const tr=B.trim;
  islWall('x',x0,x1,z1,t,0,H,B.barn,[[x-1.8,x+1.8,0,3.8]]);
  islWall('x',x0,x1,z0,t,0,H,B.barn,[[x+2.4,x+3.7,0,2.4]]);
  islWall('z',z0,z1,x0,t,0,H,B.barn,[[z+2.6,z+3.9,0,2.4],[z-1.2,z,1.2,2.2],[z-5.6,z-4.6,3.6,4.6]]);
  islWall('z',z0,z1,x1,t,0,H,B.barn,[[z+2.2,z+3.2,1.2,2.2],[z-1.2,z,1.2,2.2],[z-5.6,z-4.6,3.6,4.6]]);
  islFrame('x',x-1.8,x+1.8,z1,t,0,0,3.8,tr);islFrame('x',x+2.4,x+3.7,z0,t,0,0,2.4,tr);islFrame('z',z+2.6,z+3.9,x0,t,0,0,2.4,tr);
  for(const c of[x0,x1])for(const[a,b,o0,o1]of[[z-1.2,z,1.2,2.2],[z-5.6,z-4.6,3.6,4.6]])islFrame('z',a,b,c,t,0,o0,o1,tr);islFrame('z',z+2.2,z+3.2,x1,t,0,1.2,2.2,tr);
  /* white corner boards + eave trim */
  for(const cx of[x0,x1])for(const cz of[z0,z1])solid(cx,0,cz,t+0.12,H,t+0.12,tr,false,false);
  for(const cz of[z0,z1])solid(x,H-0.12,cz,W+0.1,0.14,t+0.14,tr,false,false);
  /* gable ends (triangles) */
  const sh=new THREE.Shape();sh.moveTo(-W/2,0);sh.lineTo(W/2,0);sh.lineTo(0,R);sh.lineTo(-W/2,0);
  for(const s of[-1,1]){const g=new THREE.ExtrudeGeometry(sh,{depth:t,bevelEnabled:false});const m=new THREE.Mesh(g,B.barn);m.position.set(x,H,(s>0?z1:z0)-t/2);brDeco(m,m.position.x,m.position.y,m.position.z);brShoot(m);
    /* hay door in the gable */
    solid(x,H+0.35,(s>0?z1:z0)+s*(t/2+0.03),1.5,1.4,0.06,B.door,false,false);for(const[w,h,dx,dy]of[[1.7,0.12,0,1.75],[1.7,0.12,0,0.29],[0.12,1.6,0.8,1.0],[0.12,1.6,-0.8,1.0]])solid(x+dx,H+dy-h/2,(s>0?z1:z0)+s*(t/2+0.07),w,h,0.06,tr,false,false);}
  /* hoist beam over the front */
  solid(x,H+R-0.55,z1+0.8,0.22,0.22,1.9,M.woodD,false,false);
  /* roof: two slopes sitting exactly on the walls, overhang + ridge cap */
  const a=Math.atan2(R,W/2),hw=W/2+0.6,Ls=hw/Math.cos(a)+0.05,yR=H+R;
  for(const s of[-1,1]){const m=new THREE.Mesh(new THREE.BoxGeometry(Ls,0.16,D+0.9),B.tin);m.rotation.z=-s*a;brDeco(m,x+s*hw/2,yR-(hw/2)*Math.tan(a)+0.1,z);brShoot(m);
    for(let i=0;i<3;i++){const u0=i*(W/2)/3,u1=(i+1)*(W/2)/3;const top=yR-u0*Math.tan(a)+0.05;colliders.push({minX:s>0?x+u0:x-u1,maxX:s>0?x+u1:x-u0,minZ:z0,maxZ:z1,minY:top-0.4,maxY:top});}}
  solid(x,yR,z,0.5,0.18,D+0.9,pm(0x34302e),false,false);
  /* sliding doors parked beside the opening + track */
  for(const s of[-1,1])solid(x+s*2.75,0.02,z1+t/2+0.07,1.9,3.9,0.1,B.door,false,false);
  solid(x,3.95,z1+t/2+0.14,7.6,0.12,0.1,B.steelD,false,false);
  /* floor */
  const fl=new THREE.Mesh(new THREE.BoxGeometry(W-2*t,0.05,D-2*t),M.plank);fl.position.set(x,0.045,z);fl.receiveShadow=true;world.add(fl);
  /* hay loft over the back half */
  const lz1=z0+t+4.8,ly=2.8;solidT(x,ly,(z0+t+lz1)/2,W-2*t,0.2,lz1-z0-t,M.plank,2);
  for(const px of[x0+t+0.15,x-0.9,x+2.2,x1-t-0.15])solid(px,0,lz1-0.12,0.22,ly,0.22,M.woodD);
  solid(x+0.9,ly+0.2+0.95,lz1-0.04,6.6,0.08,0.06,M.woodD);solid(x+0.9,ly+0.2+0.5,lz1-0.04,6.6,0.06,0.05,M.woodD,false);
  for(const px of[x-1.9,x+0.6,x+3.1])solid(px,ly+0.2,lz1-0.04,0.07,0.95,0.07,M.woodD,false);
  brLadder(x-3.1,lz1,0,1,ly+0.2);
  /* hay bales: under and on the loft, plus stalls on the right */
  const bale=(bx,by,bz,rot)=>solid(bx,by,bz,rot?0.55:1.15,0.55,rot?1.15:0.55,B.hay);
  bale(x+3.6,ly+0.2,z0+t+0.6,0);bale(x+2.4,ly+0.2,z0+t+0.6,0);bale(x+3.0,ly+0.75,z0+t+0.6,0);bale(x-1.4,ly+0.2,z0+t+0.9,1);
  bale(x-3.8,0,z0+t+0.6,0);bale(x-3.8,0.55,z0+t+0.6,0);bale(x-2.6,0,z0+t+0.6,0);bale(x+0.8,0,z+0.6,1);bale(x+0.8,0.55,z+0.6,1);
  for(const sz of[z+1.0,z+4.4])solid(x1-t-1.1,0,sz,2.2,1.3,0.12,M.wood);solid(x1-t-2.2,0,z+2.7,0.12,1.3,3.4-1.6,M.wood);
  bale(x1-t-0.6,0,z+2.7,1);
  /* lantern hooks + loot */
  brSpot(x-1.5,0.1,z+3.5);brSpot(x+3.4,0.1,z+2.7);brSpot(x-3.2,0.1,z-1.0);brSpot(x+1.2,ly+0.22,z0+t+2.6);brSpot(x-3.2,ly+0.22,z0+t+2.2);
  return{x0,x1,z0,z1};}

/* ---- airfield control tower: door at the bottom, ladder up the side, glass cab you can stand in ---- */
function brCtrlTower(tx,tz,nx,nz){const B=brMats(),M=islMats();const SZ=4.4,t=0.3,H=8;const x0=tx-SZ/2,x1=tx+SZ/2,z0=tz-SZ/2,z1=tz+SZ/2;const cw=pm(0xc9c2b2,{map:texConcrete}),lm=MAT.ledge;
  const sides=[['x',x0,x1,z1,0,1],['z',z0,z1,x1,1,0],['x',x0,x1,z0,0,-1],['z',z0,z1,x0,-1,0]];
  for(const[ax,a0,a1,c,sx,sz]of sides){const m=(a0+a1)/2;const ops=[];
    const lad=sx===nx&&sz===nz;if(sx===-nx&&sz===-nz)ops.push([m-0.65,m+0.65,0,2.4]);else if(!lad)ops.push([m-1.3,m-0.4,1.2,2.1]);
    if(!lad)ops.push([m+0.6,m+1.5,4.6,5.5]);
    islWall(ax,a0,a1,c,t,0,H,cw,ops);for(const o of ops)islFrame(ax,o[0],o[1],c,t,0,o[2],o[3],lm);}
  const fl=new THREE.Mesh(new THREE.BoxGeometry(SZ-2*t,0.05,SZ-2*t),M.tile);fl.position.set(tx,0.045,tz);world.add(fl);
  solidT(tx,H-0.25,tz,SZ,0.25,SZ,cw,3);solid(tx,H-0.42,tz,SZ+0.1,0.16,SZ+0.1,lm,false,false);
  /* cab: low wall + glass, entrance on the ladder side */
  const ct=0.15,gl=new THREE.MeshPhongMaterial({color:0x9fc4d8,specular:0xffffff,shininess:80,transparent:true,opacity:0.42,depthWrite:false});
  for(const[ax,a0,a1,c0,sx,sz]of sides){
    const cc=ax==='x'?z1*(sz>0)+z0*(sz<0)-sz*ct/2:x1*(sx>0)+x0*(sx<0)-sx*ct/2;const m=(a0+a1)/2,ent=sx===nx&&sz===nz;
    const seg=(p,q)=>{if(q-p<0.05)return;if(ax==='x'){solid((p+q)/2,H,cc,q-p,1.0,ct,cw);const g=new THREE.Mesh(new THREE.BoxGeometry(q-p,1.45,0.05),gl);g.position.set((p+q)/2,H+1.0+0.725,cc);g.userData.noMerge=1;world.add(g);colliders.push({minX:p,maxX:q,minZ:cc-0.08,maxZ:cc+0.08,minY:H+1,maxY:H+2.45});}
      else{solid(cc,H,(p+q)/2,ct,1.0,q-p,cw);const g=new THREE.Mesh(new THREE.BoxGeometry(0.05,1.45,q-p),gl);g.position.set(cc,H+1.0+0.725,(p+q)/2);g.userData.noMerge=1;world.add(g);colliders.push({minX:cc-0.08,maxX:cc+0.08,minZ:p,maxZ:q,minY:H+1,maxY:H+2.45});}};
    if(ent){seg(a0,m-0.6);seg(m+0.6,a1);}else seg(a0,a1);}
  for(const cx of[x0+0.08,x1-0.08])for(const cz of[z0+0.08,z1-0.08])solid(cx,H,cz,0.16,2.5,0.16,lm,false,false);
  solidT(tx,H+2.5,tz,SZ+0.8,0.3,SZ+0.8,cw,3);solid(tx,H+2.8,tz,SZ+0.9,0.1,SZ+0.9,lm,false,false);
  /* console + antenna + beacon */
  solid(tx-nx*1.4,H,tz-nz*1.4,nx?0.6:2.4,0.95,nx?2.4:0.6,B.steelD);
  solid(tx+1.2,H+2.8,tz-1.2,0.1,2.4,0.1,B.steel,false,false);
  const bl=new THREE.Mesh(new THREE.SphereGeometry(0.16,8,6),new THREE.MeshBasicMaterial({color:0xff2a1a}));bl.position.set(tx+1.2,H+5.3,tz-1.2);bl.userData.noMerge=1;world.add(bl);let bt=rng()*2;S.wanim.push(dt=>{bt+=dt;bl.visible=(bt%1.2)<0.5;});
  brLadder(tx+nx*SZ/2,tz+nz*SZ/2,nx,nz,H);
  brSpot(tx+0.8,0.1,tz-0.8);brSpot(tx-0.6,H+0.02,tz+0.6);brSpot(tx+0.9,H+0.02,tz-0.2);}

/* ---- watch tower with a ladder, railings and a roof on posts ---- */
function brWatchTower(cx,cz,nx,nz){const wood=pm(0x6d5338),roofM=pm(0x4a5a3a),P=6.3;
  for(const lx of[-1,1])for(const lz of[-1,1])solid(cx+lx*1.3,0,cz+lz*1.3,0.25,P-0.3,0.25,wood);
  for(const s of[-1,1]){solid(cx,1.6,cz+s*1.3,2.6,0.12,0.12,wood,false,false);solid(cx+s*1.3,3.4,cz,0.12,0.12,2.6,wood,false,false);}
  solid(cx,P-0.3,cz,3.2,0.3,3.2,wood);
  for(const[sx,sz]of[[1,0],[-1,0],[0,1],[0,-1]]){const ent=sx===nx&&sz===nz;const px=cx+sx*1.54,pz=cz+sz*1.54;
    const seg=(a,b)=>{if(sx)solid(px,P,cz+(a+b)/2,0.1,1.05,b-a,wood);else solid(cx+(a+b)/2,P,pz,b-a,1.05,0.1,wood);};
    if(ent){seg(-1.6,-0.55);seg(0.55,1.6);}else seg(-1.6,1.6);}
  for(const lx of[-1,1])for(const lz of[-1,1])solid(cx+lx*1.5,P,cz+lz*1.5,0.14,2.1,0.14,wood,false,false);
  solid(cx,P+2.1,cz,3.8,0.2,3.8,roofM);
  brLadder(cx+nx*1.6,cz+nz*1.6,nx,nz,P);
  brSpot(cx-nx*0.2+nz*0.6,P+0.02,cz-nz*0.2+nx*0.6);}

/* ---- open army tent you can walk under ---- */
function brTent(tx,tz,rot){const B=brMats(),wood=pm(0x5b4a34);const hx=2.1,hz=2.6,E=2.1,RH=1.5;const X=rot?hz:hx,Z=rot?hx:hz;
  for(const sx of[-1,1])for(const sz of[-1,1])solid(tx+sx*(X-0.1),0,tz+sz*(Z-0.1),0.12,E,0.12,wood);
  /* A-frame roof along the long side */
  const a=Math.atan2(RH,hx),Ls=(hx+0.3)/Math.cos(a);
  for(const s of[-1,1]){const m=new THREE.Mesh(new THREE.BoxGeometry(Ls,0.06,2*hz+0.4),B.canvas);if(rot){m.rotation.set(0,Math.PI/2,s*a);brDeco(m,tx,E+RH/2,tz+s*(hx+0.3)/2);}else{m.rotation.z=-s*a;brDeco(m,tx+s*(hx+0.3)/2,E+RH/2,tz);}brShoot(m);}
  const ridge=rot?solid(tx,E+RH-0.05,tz,2*hz+0.4,0.1,0.1,wood,false,false):solid(tx,E+RH-0.05,tz,0.1,0.1,2*hz+0.4,wood,false,false);
  /* back flap = cover; cot, crate */
  if(rot)solid(tx,0,tz-Z+0.04,2*X,E,0.06,B.canvas);else solid(tx-X+0.04,0,tz,0.06,E,2*Z,B.canvas);
  solid(tx+(rot?-1:0.8),0,tz+(rot?0.8:-1),rot?1.9:0.75,0.42,rot?0.75:1.9,B.cot);
  crate(tx+(rot?1.2:-1.2),tz+(rot?-1.2:1.2),0.8);
  brSpot(tx,0.1,tz);}

/* ---- nuclear plant (Reactor theme): containment you can walk into, cooling towers you can walk under, turbine hall ---- */
function poiPlant(p){const x=p.x,z=p.z,B=brMats(),M=islMats(),lm=MAT.ledge;const PW=70,PD=58;
  brFlatRect(x,z,PW,PD);
  const padT=texConcrete.clone();padT.wrapS=padT.wrapT=THREE.RepeatWrapping;padT.repeat.set(PW/6,PD/6);padT.needsUpdate=true;
  const pad=new THREE.Mesh(new THREE.PlaneGeometry(PW,PD),Lm({color:0xbfc2bf,map:padT,polygonOffset:true,polygonOffsetFactor:-1}));pad.rotation.x=-Math.PI/2;pad.position.set(x,0.018,z);pad.receiveShadow=true;pad.userData.noMerge=1;world.add(pad);
  p.fence={x,z,w:PW-2,d:PD-2};
  /* containment building */
  {const cx=x-17,cz=z-9,R=7,HW=10,DH=3.6,g=3.4/R;const outer=new THREE.CylinderGeometry(R,R,HW,40,1,true,g/2,Math.PI*2-g);const inner=new THREE.CylinderGeometry(R-0.5,R-0.5,HW,40,1,true,g/2,Math.PI*2-g);
    const cm=brConcRep(9,2.5,0xdfe1dd,THREE.DoubleSide);for(const G of[outer,inner]){const m=new THREE.Mesh(G,cm);brDeco(m,cx,HW/2,cz);brShoot(m);}
    for(const r of[R,R-0.5]){const o=new THREE.Mesh(new THREE.CylinderGeometry(r,r,HW-DH,6,1,true,-g/2,g),cm);brDeco(o,cx,DH+(HW-DH)/2,cz);brShoot(o);}
    solid(cx,DH-0.25,cz+R-0.25,3.6,0.25,0.7,cm,false);
    const band=new THREE.Mesh(new THREE.CylinderGeometry(R+0.06,R+0.06,0.6,40,1,true),Lm({color:lm.color,side:THREE.DoubleSide}));brDeco(band,cx,HW-0.6,cz);
    const dome=new THREE.Mesh(new THREE.SphereGeometry(R,40,14,0,Math.PI*2,0,Math.PI/2),cm);brDeco(dome,cx,HW,cz);brShoot(dome);
    for(const[h,r]of[[2.4,6.5],[4.4,5.4],[6,3.6]]){const s=r*1.38;colliders.push({minX:cx-s/2,maxX:cx+s/2,minZ:cz-s/2,maxZ:cz+s/2,minY:HW+h-0.6,maxY:HW+h});}
    const N=56;for(let i=0;i<N;i++){const th=i/N*Math.PI*2;const wth=Math.atan2(Math.sin(th),Math.cos(th));const ox=Math.sin(th)*(R-0.25),oz=Math.cos(th)*(R-0.25);
      if(Math.abs(wth)<g/2+0.04)colliders.push({minX:cx+ox-0.45,maxX:cx+ox+0.45,minZ:cz+oz-0.45,maxZ:cz+oz+0.45,minY:DH,maxY:HW});
      else colliders.push({minX:cx+ox-0.5,maxX:cx+ox+0.5,minZ:cz+oz-0.5,maxZ:cz+oz+0.5,minY:0,maxY:HW});}
    /* airlock entrance */
    const dz=cz+R;for(const s of[-1,1])solid(cx+s*2.05,0,dz+1.0,0.4,4.0,3.2,B.concD);solidT(cx,4.0,dz+1.0,4.5,0.35,3.4,B.concD,3);solid(cx,4.35,dz+2.62,4.6,0.18,0.1,lm,false,false);
    brSign(B.haz,cx+1.4,2.2,dz+2.66,0,0.8,0.8);brSign(brTextTex('UNIT 1 · REACTOR','#2f4f78','#f2f4f6'),cx,4.7,dz+2.7,0,4.4,0.82);
    /* inside: reactor vessel, two steam generators, polar crane ring */
    const fl=new THREE.Mesh(new THREE.CircleGeometry(R-0.5,40),pm(0x8f9a90,{map:texConcrete}));fl.rotation.x=-Math.PI/2;fl.position.set(cx,0.03,cz);fl.userData.noMerge=1;world.add(fl);
    const ves=new THREE.Mesh(new THREE.CylinderGeometry(2.1,2.1,3.6,24),B.steel);brDeco(ves,cx,1.8,cz-0.6);const vt=new THREE.Mesh(new THREE.SphereGeometry(2.1,24,8,0,Math.PI*2,0,Math.PI/2),pm(0xc0392b));brDeco(vt,cx,3.6,cz-0.6);brShoot(ves);brShoot(vt);brCol(cx,cz-0.6,3.6,5.6,3.6);
    for(const s of[-1,1]){const th=s*2.2,gx=cx+Math.sin(th)*4.2,gz=cz+Math.cos(th)*4.2;const sg=new THREE.Mesh(new THREE.CylinderGeometry(0.95,1.1,6.2,18),pm(0xe6e8e4));brDeco(sg,gx,3.1,gz);brShoot(sg);brCol(gx,gz,1.9,6.2,1.9);
      const pipe=new THREE.Mesh(new THREE.CylinderGeometry(0.28,0.28,2.4,10),B.steelD);pipe.rotation.z=Math.PI/2;pipe.rotation.y=th+Math.PI/2;brDeco(pipe,(gx+cx)/2,1.2,(gz+cz-0.6)/2);}
    const ring=new THREE.Mesh(new THREE.TorusGeometry(R-1,0.22,6,40),pm(0xe0a21a));ring.rotation.x=Math.PI/2;brDeco(ring,cx,8.4,cz,false);
    brSpot(cx,0.1,cz-5.2);brSpot(cx+3.2,0.1,cz+3.6);brSpot(cx-3.2,0.1,cz+3.6);brSpot(cx,0.1,cz+5.4);}
  /* two cooling towers — walk in under the shell between the legs */
  const prof=y=>4.6*Math.sqrt(1+((y-15)/9.7)**2);
  const pts=[];for(let i=0;i<=14;i++){const y=2.5+i*(22-2.5)/14;pts.push(new THREE.Vector2(prof(y),y));}
  const shellG=new THREE.LatheGeometry(pts,36),shellM=brConcRep(10,5,0xd6d8d4,THREE.DoubleSide);
  for(const[ox,oz]of[[17,-12],[17,12]]){const cx=x+ox,cz=z+oz;const sm=new THREE.Mesh(shellG,shellM);brDeco(sm,cx,0,cz);brShoot(sm);
    const lip=new THREE.Mesh(new THREE.TorusGeometry(prof(22),0.18,6,36),pm(0xb8bcb8));lip.rotation.x=Math.PI/2;brDeco(lip,cx,22,cz,false);
    const ft=new THREE.Mesh(new THREE.TorusGeometry(prof(2.5),0.25,6,36),pm(0xb8bcb8));ft.rotation.x=Math.PI/2;brDeco(ft,cx,2.5,cz);
    for(let i=0;i<16;i++){const th=i/16*Math.PI*2;const lx=cx+Math.sin(th)*prof(2.5),lz=cz+Math.cos(th)*prof(2.5);const leg=new THREE.Mesh(new THREE.BoxGeometry(0.4,2.7,0.4),B.concD);leg.rotation.y=th;brDeco(leg,lx,1.35,lz);brShoot(leg);brCol(lx,lz,0.5,2.6,0.5);}
    for(const[y0,y1]of[[2.5,7],[7,12],[12,17],[17,22]]){const r=prof((y0+y1)/2)-0.15,n=Math.ceil(2*Math.PI*r/0.95);for(let i=0;i<n;i++){const th=i/n*Math.PI*2,px=cx+Math.sin(th)*r,pz=cz+Math.cos(th)*r;colliders.push({minX:px-0.55,maxX:px+0.55,minZ:pz-0.55,maxZ:pz+0.55,minY:y0,maxY:y1});}}
    /* basin floor + cover inside */
    const wat=new THREE.Mesh(new THREE.CircleGeometry(prof(2.5)-0.4,36),pm(0x6f7f80,{map:texConcrete}));wat.rotation.x=-Math.PI/2;wat.position.set(cx,0.03,cz);wat.userData.noMerge=1;world.add(wat);
    crate(cx-1.5,cz+0.8);crate(cx+1.8,cz-1.2);solid(cx+0.2,0,cz+2.4,3.2,1.1,0.5,MAT.ledge);
    brSpot(cx,0.1,cz);brSpot(cx-2.6,0.1,cz-2.2);
    /* steam plume */
    const st=[];for(let i=0;i<7;i++){const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:B.steam,transparent:true,depthWrite:false,opacity:0.5,fog:true}));sp.userData.noMerge=1;sp.userData.t=i/7;world.add(sp);st.push(sp);}
    S.wanim.push(dt=>{for(const sp of st){let t=sp.userData.t+dt*0.06;if(t>1)t-=1;sp.userData.t=t;const s=7+t*16;sp.scale.set(s,s,1);sp.position.set(cx+t*6,22.5+t*20,cz+t*2);sp.material.opacity=0.55*(1-t)*Math.min(1,t*6);}});}
  /* turbine hall */
  {const cx=x-15,cz=z+15,W=18,D=10,t=0.3,H=7;const x0=cx-W/2,x1=cx+W/2,z0=cz-D/2,z1=cz+D/2;const wm=pm(0xe4e7e6,{map:texConcrete});
    const win=[];for(let k=0;k<4;k++){const a=x0+2+k*4;win.push([a,a+2.4,4.4,5.8]);}
    islWall('x',x0,x1,z1,t,0,H,wm,win.concat([[cx+3.6,cx+4.8,0,2.4]]));islWall('x',x0,x1,z0,t,0,H,wm,win.slice());
    islWall('z',z0,z1,x0,t,0,H,wm,[[cz-1.6,cz+1.6,0,4.0]]);islWall('z',z0,z1,x1,t,0,H,wm,[[cz-1.6,cz+1.6,0,4.0]]);
    for(const o of win){islFrame('x',o[0],o[1],z1,t,0,o[2],o[3],lm);islFrame('x',o[0],o[1],z0,t,0,o[2],o[3],lm);}
    for(const c of[x0,x1])islFrame('z',cz-1.6,cz+1.6,c,t,0,0,4.0,lm);islFrame('x',cx+3.6,cx+4.8,z1,t,0,0,2.4,lm);
    solidT(cx,H,cz,W+0.3,0.3,D+0.3,wm,3);for(const s of[-1,1]){solid(cx,H+0.3,cz+s*(D/2+0.05),W+0.3,0.5,0.25,wm);solid(cx+s*(W/2+0.05),H+0.3,cz,0.25,0.5,D+0.3,wm);}
    solid(cx,H-0.6,z1+t/2+0.05,W,0.35,0.1,lm,false,false);
    brSign(brTextTex('TURBINE HALL','#e4e7e6','#2f4f78'),cx-3,H-1.5,z1+t/2+0.06,0,5,0.95);
    const fl=new THREE.Mesh(new THREE.BoxGeometry(W-2*t,0.05,D-2*t),pm(0x9aa49c,{map:texConcrete}));fl.position.set(cx,0.045,cz);world.add(fl);
    /* turbine-generator set */
    solid(cx+0.5,0,cz+1.4,12,0.7,3.2,B.concD);const tb=new THREE.Mesh(new THREE.CylinderGeometry(1.25,1.25,8,22),pm(0x3f6f9a));tb.rotation.z=Math.PI/2;brDeco(tb,cx-1.5,1.95,cz+1.4);brShoot(tb);
    solid(cx+4.7,0.7,cz+1.4,3.4,2.6,2.6,pm(0xe0a21a));brCol(cx-1.5,cz+1.4,8,2.6,2.5,0.7);
    for(let k=-1;k<=1;k++){const r=new THREE.Mesh(new THREE.CylinderGeometry(1.35,1.35,0.25,22),B.steelD);r.rotation.z=Math.PI/2;brDeco(r,cx-1.5+k*2.6,1.95,cz+1.4);}
    /* catwalk along the back wall with a ladder */
    const cy=3.0,cz1=z0+t+2.0;solid(cx,cy,(z0+t+cz1)/2,W-2*t,0.2,cz1-z0-t,B.steel);
    for(const px of[x0+t+0.2,cx-2,cx+3,x1-t-0.2])solid(px,0,cz1-0.1,0.2,cy,0.2,B.steelD);
    solid(cx+1.6,cy+0.2+0.95,cz1-0.04,14,0.06,0.06,pm(0xe0a21a));solid(cx+1.6,cy+0.2,cz1-0.04,14,0.95,0.04,B.steelD,true,false);
    brLadder(cx-6.4,cz1,0,1,cy+0.2);
    /* overhead crane beam */
    solid(cx,H-1.0,cz+1.4,W-2*t,0.5,0.6,pm(0xe0a21a),false,false);
    brSpot(cx-6,0.1,cz+3.6);brSpot(cx+6.8,0.1,cz-2);brSpot(cx+2,0.1,cz-2.2);brSpot(cx-3,cy+0.22,z0+t+1.0);brSpot(cx+5,cy+0.22,z0+t+1.0);}
  /* steam pipes reactor -> hall on supports */
  {const pm2=B.steel;const ax=x-12,az=z-4.3,bz=z+9.8;const pp=new THREE.Mesh(new THREE.CylinderGeometry(0.45,0.45,bz-az,12),pm2);pp.rotation.x=Math.PI/2;brDeco(pp,ax,4.2,(az+bz)/2);brShoot(pp);
    for(let s=az+1.5;s<bz;s+=3)solid(ax,0,s,0.3,3.75,0.3,B.steelD);}
  /* vent stack */
  {const sx=x+2,sz=z-4;const st=new THREE.Mesh(new THREE.CylinderGeometry(0.9,1.4,28,18),pm(0xe8e8e4));brDeco(st,sx,14,sz);brShoot(st);brCol(sx,sz,2.6,28,2.6);
    for(const y of[22,25.5])brDeco(new THREE.Mesh(new THREE.CylinderGeometry(1.04-(y-20)*0.012,1.08-(y-21)*0.012,1.6,18),pm(0xc0392b)),sx,y,sz);}
  /* transformer yard */
  {const yx=x-1,yz=z-21;const gm=pm(0x7a7a72);const gr=new THREE.Mesh(new THREE.PlaneGeometry(14,9),gm);gr.rotation.x=-Math.PI/2;gr.position.set(yx,0.026,yz);gr.userData.noMerge=1;world.add(gr);
    for(let k=-1;k<=1;k++){const tx=yx+k*4.4;solid(tx,0,yz,2.4,2.4,1.8,pm(0x6a747c));for(let f=-2;f<=2;f++)solid(tx+f*0.45,0.2,yz+0.95,0.08,1.9,0.18,B.steelD,false,false);
      for(let i=-1;i<=1;i++){const ins=new THREE.Mesh(new THREE.CylinderGeometry(0.1,0.14,0.9,8),pm(0x8a5a3a));brDeco(ins,tx+i*0.7,2.85,yz);}}
    const fm=pm(0x9aa0a6);for(const s of[-1,1])solid(yx,0,yz+s*4.5,14,1.8,0.08,fm);solid(yx-7,0,yz,0.08,1.8,9,fm);solid(yx+7,0,yz-2.5,0.08,1.8,4,fm);
    brSign(B.haz,yx,1.2,yz+4.56,0,0.7,0.7);brSpot(yx+2.2,0.1,yz-2.8);
    const lat=new THREE.MeshLambertMaterial({color:0x8a9096,wireframe:true});const py=new THREE.Mesh(new THREE.CylinderGeometry(0.5,1.6,16,4,6,true),lat);py.rotation.y=Math.PI/4;brDeco(py,yx+9.5,8,yz,false);brCol(yx+9.5,yz,2.2,16,2.2);
    for(const y of[12,15])solid(yx+9.5,y,yz,0.2,0.2,7,B.steelD,false,false);}
