  const bg=new THREE.Group();bg.position.set(x,19.6,z);for(const s of[1,-1]){const c=new THREE.Mesh(new THREE.ConeGeometry(3.2,46,18,1,true),beamM);c.rotation.z=s*Math.PI/2;c.position.x=s*23;bg.add(c);}bg.userData.noMerge=1;world.add(bg);
  S.wanim.push(dt=>{bg.rotation.y+=dt*0.8;});
