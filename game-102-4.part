  for(const[ox,oz,h]of[[-2,8,1],[9,0,0],[-12,-20,1],[10,24,0]])solid(x+ox,0,z+oz,h?3.6:0.6,0.95,h?0.6:3.6,B.concD);
  brSpot(x,0.1,z);brSpot(x+9,0.1,z-2);}
/* plant fence goes up after the roads so every road gets a gate */
function plantFence(p){const F=p.fence;if(!F)return;const B=brMats(),fm=pm(0x9aa0a6),post=pm(0x6a7076);const X0=F.x-F.w/2,X1=F.x+F.w/2,Z0=F.z-F.d/2,Z1=F.z+F.d/2;
  const gaps={n:[],s:[],e:[],w:[]};
  for(const r of S.roads||[]){for(const[ax,az,bx,bz]of[[r.ax,r.az,r.bx,r.bz]]){
      const hit=(t)=>[ax+(bx-ax)*t,az+(bz-az)*t];
      for(const[edge,fix,isX]of[['n',Z1,true],['s',Z0,true],['e',X1,false],['w',X0,false]]){const d=isX?bz-az:bx-ax;if(Math.abs(d)<1e-6)continue;const t=(fix-(isX?az:ax))/d;if(t<0||t>1)continue;const[hx,hz]=hit(t);
        if(isX&&hx>X0&&hx<X1)gaps[edge].push(hx);if(!isX&&hz>Z0&&hz<Z1)gaps[edge].push(hz);}}}
  gaps.s.push(F.x+6);
  const run=(edge,a0,a1,fix,isX)=>{const G=gaps[edge].map(g=>[g-3.6,g+3.6]).sort((p,q)=>p[0]-q[0]);let cur=a0;const seg=(a,b)=>{if(b-a<0.3)return;const m=(a+b)/2;if(isX)solid(m,0,fix,b-a,2.3,0.07,fm);else solid(fix,0,m,0.07,2.3,b-a,fm);
      for(let s=a;s<=b+0.01;s+=3){if(isX)solid(s,0,fix,0.12,2.6,0.12,post,false,false);else solid(fix,0,s,0.12,2.6,0.12,post,false,false);}};
    for(const[g0,g1]of G){seg(cur,Math.max(cur,g0));cur=Math.max(cur,g1);}seg(cur,a1);
    for(const g of gaps[edge]){if(isX)brSign(B.haz,g+4.2,1.5,fix+0.06*(edge==='n'?1:-1),edge==='n'?0:Math.PI,0.7,0.7);else brSign(B.haz,fix+0.06*(edge==='e'?1:-1),1.5,g+4.2,edge==='e'?Math.PI/2:-Math.PI/2,0.7,0.7);}};
  run('n',X0,X1,Z1,true);run('s',X0,X1,Z0,true);run('e',Z0,Z1,X1,false);run('w',Z0,Z1,X0,false);}

function islPlacePOIs(){const R0=ISL.R0,out=[];
  const free=(x,z,r,gap)=>out.every(p=>Math.hypot(p.x-x,p.z-z)>p.r+r+gap);
  for(const d of islPoiDefs()){let best=null;
    for(let i=0;i<260&&!best;i++){let x,z,th=0;
      if(d.coast){th=rng()*Math.PI*2;const r=islR(th)-(d.r+12);x=Math.cos(th)*r;z=Math.sin(th)*r;}
      else{const a=rng()*Math.PI*2,rr=(0.12+0.88*Math.sqrt(rng()))*R0*0.74;x=Math.cos(a)*rr;z=Math.sin(a)*rr;}
      if(!islIn(x,z,d.coast?8:d.r*0.8+8)||!free(x,z,d.r,i<200?62:30))continue;
      const rot=rng()<0.5?0:1;
      if(d.k==='airfield'){const ax=rot?0:1,az=rot?1:0;if(!islIn(x+ax*58,z+az*58,10)||!islIn(x-ax*58,z-az*58,10))continue;}
      best={x,z,th,rot};}
    if(best)out.push(Object.assign({},d,best));}
  return out;}
/* no trees / crates / houses on runways, fields, plazas and roads */
function brFlat(x,z,m){for(const b of S.poiFlat||[])if(x>b.x0-m&&x<b.x1+m&&z>b.z0-m&&z<b.z1+m)return true;
  for(const r of S.roads||[]){const dx=r.bx-r.ax,dz=r.bz-r.az,L2=dx*dx+dz*dz||1;let t=((x-r.ax)*dx+(z-r.az)*dz)/L2;t=clamp(t,0,1);if(Math.hypot(x-(r.ax+dx*t),z-(r.az+dz*t))<r.w/2+m)return true;}return false;}
function brFlatRect(x,z,w,d){(S.poiFlat=S.poiFlat||[]).push({x0:x-w/2,x1:x+w/2,z0:z-d/2,z1:z+d/2});}
function brSpot(x,y,z){S.houseSpots.push([x,y,z]);}
function brTex(w,h,draw,rx,ry){const c=document.createElement('canvas');c.width=w;c.height=h;draw(c.getContext('2d'),w,h);const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(rx||1,ry||1);t.anisotropy=4;return t;}
function brDeco(mesh,x,y,z,cast=true){mesh.position.set(x,y,z);mesh.castShadow=cast;mesh.receiveShadow=true;world.add(mesh);return mesh;}
function brCol(x,z,w,h,d,y=0){colliders.push({minX:x-w/2,maxX:x+w/2,minZ:z-d/2,maxZ:z+d/2,minY:y,maxY:y+h});}
let _roadMat=null,_runMat=null,_fieldMat=null;
function islRoads(P){S.roads=[];if(P.length<2)return;
  if(!_roadMat)_roadMat=Lm({map:brTex(64,256,(x,w,h)=>{x.fillStyle='#8a7558';x.fillRect(0,0,w,h);for(let i=0;i<1600;i++){const v=110+Math.random()*60|0;x.fillStyle=`rgba(${v},${v-14},${v-34},.35)`;x.fillRect(Math.random()*w,Math.random()*h,2,2);}
    x.fillStyle='rgba(70,56,40,.35)';x.fillRect(w*0.22,0,w*0.14,h);x.fillRect(w*0.64,0,w*0.14,h);const g=x.createLinearGradient(0,0,w,0);g.addColorStop(0,'rgba(150,170,90,.55)');g.addColorStop(0.12,'rgba(150,170,90,0)');g.addColorStop(0.88,'rgba(150,170,90,0)');g.addColorStop(1,'rgba(150,170,90,.55)');x.fillStyle=g;x.fillRect(0,0,w,h);},1,8),polygonOffset:true,polygonOffsetFactor:-2});
  /* minimum spanning tree over the places, plus one extra link so the network has a loop */
  const inT=[0],edges=[];while(inT.length<P.length){let best=null;for(const i of inT)for(let j=0;j<P.length;j++){if(inT.includes(j))continue;const d=Math.hypot(P[i].x-P[j].x,P[i].z-P[j].z);if(!best||d<best.d)best={i,j,d};}edges.push(best);inT.push(best.j);}
  {let best=null;for(let i=0;i<P.length;i++)for(let j=i+1;j<P.length;j++){if(edges.some(e=>(e.i===i&&e.j===j)||(e.i===j&&e.j===i)))continue;const d=Math.hypot(P[i].x-P[j].x,P[i].z-P[j].z);if(!best||d<best.d)best={i,j,d};}if(best)edges.push(best);}
  for(const e of edges){const A=P[e.i],B=P[e.j];
    /* skip roads that would cross the sea */
    let wet=false;for(let t=0.05;t<1;t+=0.05)if(!islIn(A.x+(B.x-A.x)*t,A.z+(B.z-A.z)*t,4)){wet=true;break;}if(wet)continue;
    const dx=B.x-A.x,dz=B.z-A.z,L=Math.hypot(dx,dz);const m=new THREE.Mesh(new THREE.PlaneGeometry(5.6,L),_roadMat.clone());m.material.map=_roadMat.map.clone();m.material.map.repeat.set(1,L/14);m.material.map.needsUpdate=true;
    m.rotation.set(-Math.PI/2,0,Math.atan2(dx,dz));m.position.set((A.x+B.x)/2,0.022,(A.z+B.z)/2);m.receiveShadow=true;m.userData.noMerge=1;world.add(m);
    S.roads.push({ax:A.x,az:A.z,bx:B.x,bz:B.z,w:5.6});}}
/* ---- landmarks ---- */
function poiLighthouse(p){const x=p.x,z=p.z;const white=pm(0xeeeae0),red=pm(0xb3312a),stone=pm(0x8f8a80,{map:texConcrete}),dark=pm(0x2a2a2e);
  solid(x,0,z,5.2,1.4,5.2,stone);
  brDeco(new THREE.Mesh(new THREE.CylinderGeometry(1.35,1.95,17,22),white),x,1.4+8.5,z);brCol(x,z,3.4,17,3.4,1.4);
  for(const y of[5,10.5,15.2])brDeco(new THREE.Mesh(new THREE.CylinderGeometry(1.95-(y/17)*0.58+0.05,1.95-((y-1.6)/17)*0.58+0.05,1.7,22),red),x,1.4+y-0.8,z);
