  const lamp=brDeco(new THREE.Mesh(new THREE.CylinderGeometry(1.05,1.05,1.9,16),new THREE.MeshBasicMaterial({color:0xfff0b8})),x,19.6,z,false);lamp.userData.noMerge=1;
