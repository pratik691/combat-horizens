  brFlatRect(x,z,2*F,2*F);}
function poiAirfield(p){const x=p.x,z=p.z,along=p.rot?'z':'x';const L=112,W=15;
  if(!_runMat)_runMat=Lm({map:brTex(256,1024,(c,w,h)=>{c.fillStyle='#4a4846';c.fillRect(0,0,w,h);for(let i=0;i<9000;i++){const v=60+Math.random()*40|0;c.fillStyle=`rgba(${v},${v},${v},.4)`;c.fillRect(Math.random()*w,Math.random()*h,2,2);}
    c.fillStyle='rgba(235,235,225,.85)';for(let y=60;y<h-60;y+=70)c.fillRect(w/2-4,y,8,36);for(const yy of[10,h-46])for(let i=0;i<8;i++)c.fillRect(20+i*28,yy,14,36);c.fillRect(8,0,5,h);c.fillRect(w-13,0,5,h);
    c.font='bold 44px Arial';c.textAlign='center';c.save();c.translate(w/2,120);c.fillText('09',0,0);c.restore();c.save();c.translate(w/2,h-90);c.rotate(Math.PI);c.fillText('27',0,0);c.restore();},1,1),polygonOffset:true,polygonOffsetFactor:-2});
  const rw=new THREE.Mesh(new THREE.PlaneGeometry(W,L),_runMat);rw.rotation.set(-Math.PI/2,0,p.rot?0:Math.PI/2);rw.position.set(x,0.024,z);rw.receiveShadow=true;rw.userData.noMerge=1;world.add(rw);
  if(p.rot)brFlatRect(x,z,W+2,L+2);else brFlatRect(x,z,L+2,W+2);
  /* hangar beside the runway, open toward it */
  const off=W/2+16,hx=p.rot?x+off:x,hz=p.rot?z:z+off,HW=24,HD=18,HH=9;const wall=pm(0x9aa1a8,{map:texConcrete}),roof=pm(0x6c737a);
  if(p.rot){solid(hx+HD/2,0,hz,0.4,HH,HW,wall);solid(hx,0,hz-HW/2,HD,HH,0.4,wall);solid(hx,0,hz+HW/2,HD,HH,0.4,wall);solid(hx-HD/2,HH-2.2,hz,0.4,2.2,HW,wall);solid(hx,HH,hz,HD+0.6,0.45,HW+0.6,roof);}
  else{solid(hx,0,hz+HD/2,HW,HH,0.4,wall);solid(hx-HW/2,0,hz,0.4,HH,HD,wall);solid(hx+HW/2,0,hz,0.4,HH,HD,wall);solid(hx,HH-2.2,hz-HD/2,HW,2.2,0.4,wall);solid(hx,HH,hz,HW+0.6,0.45,HD+0.6,roof);}
  brFlatRect(hx,hz,p.rot?HD:HW,p.rot?HW:HD);
