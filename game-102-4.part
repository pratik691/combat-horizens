$('abLicBtn').onclick=()=>{const e=$('abLic');if(!e.textContent)e.textContent=CH_LICENSE+'\n\n'+CH_NOTICES;e.classList.toggle('hidden');if(!e.classList.contains('hidden'))e.scrollIntoView({block:'nearest'});};
$('abCopy').onclick=()=>{try{navigator.clipboard.writeText('HORIZENS');}catch(e){}$('abMsg').textContent='Copied! You can also type it in Store → Redeem.';$('abMsg').className='ok';};
$('abClaim').onclick=()=>{const ok=redeemCode('HORIZENS');const m=$('abMsg');m.textContent=ok?'+200 coins added! Check your balance at the top right.':($('rdMsg').textContent||'Could not redeem');m.className=ok?'ok':'bad';if(ok){renderMenu();$('abClaim').disabled=true;$('abClaim').textContent='Claimed ✓';}};$('about').addEventListener('click',e=>{if(e.target.id==='about')closeAbout();});
addEventListener('keydown',e=>{if(e.code==='Escape'&&!$('about').classList.contains('hidden'))closeAbout();});
function showTab(t){
  document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('on',b.dataset.tab===t));
  ['home','play','inventory','loadout','store','news','ranks'].forEach(n=>$('pg-'+n).classList.toggle('hidden',n!==t));
  document.body.classList.toggle('subpage',!(t==='home'||t==='play'||t==='news'));menuLdT=-9;
  if(t==='inventory'){try{arShow();}catch(e){console.error(e);}}
  if(t==='store'){try{renderStore();}catch(e){console.error(e);}}
  sfx('click');requestAnimationFrame(tabInk);if(t==='home')try{sdRender();}catch(e){}
}
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{initAudio();showTab(b.dataset.tab);});
$('bHome').onclick=()=>showTab('home');
$('rankChip').onclick=()=>showTab('ranks');$('opcard').onclick=()=>showTab('ranks');
$('bFull').onclick=()=>{try{if(document.fullscreenElement)document.exitFullscreen();else document.documentElement.requestFullscreen();}catch(e){}};
$('bSet').onclick=()=>openSettings();
function hex(c){return '#'+c.toString(16).padStart(6,'0');}
function patternSvg(w){const n=Math.max(w.mag,2),pts=[];let maxY=0,maxX=0;for(let i=0;i<n;i++){const[a,b]=patternAt(w,i);maxY=Math.max(maxY,b);maxX=Math.max(maxX,Math.abs(a));}
  const sy=Math.min(12.5,100/Math.max(maxY,1)),sx=Math.min(7,38/Math.max(maxX,1));
  for(let i=0;i<n;i++){const[a,b]=patternAt(w,i);pts.push(`<circle cx="${(45+a*sx).toFixed(1)}" cy="${(112-b*sy).toFixed(1)}" r="2.4" fill="${i===0?'#7dff9b':'#f2a33a'}" opacity="${(1-i/n*0.6).toFixed(2)}"/>`);}
  return `<svg width="90" height="122" viewBox="0 0 90 122"><line x1="45" y1="4" x2="45" y2="118" stroke="rgba(255,255,255,.12)"/>${pts.join('')}</svg>`;}
function setCat(c){save.cat=c;persist();
  document.querySelectorAll('#catSeg button').forEach(b=>b.classList.toggle('on',b.dataset.c===c));
  $('mpBox').classList.toggle('hidden',c!=='mp');$('modeHead').textContent=c==='mp'?'Host a room':'Choose a mode';$('pg-play').classList.toggle('mp',c==='mp');
  document.querySelectorAll('.mode .mt').forEach(el=>el.textContent=c==='mp'?'Host':'Play');}
function renderMenu(){
  try{mutBannerRender();}catch(e){}
  $('coins').textContent='⛃ '+save.coins;
  const r=rankOf(save.level),need=xpToNext(save.level);
  $('rcBadge').innerHTML=badgeSvg(save.level,22);$('rcLv').textContent='LV '+save.level;
  $('opBadge').innerHTML=badgeSvg(save.level,40)+(save.medal&&MEDAL_BY[save.medal]&&MEDAL_BY[save.medal].ok()?medalSvg(MEDAL_BY[save.medal],40):'');$('opName').textContent=save.name.toUpperCase();
  $('oplvl').textContent=`Level ${save.level}`+(save.level<MAX_LEVEL?` · ${save.xp}/${need} XP`:' · MAX');
  try{const ch=streakChip();if(ch)$('opName').innerHTML=esc(save.name.toUpperCase())+' '+ch;}catch(e){}
  {const ag=save.agent||'operator';if(ag!=='operator'&&typeof agSig==='function'){const G=agSig(ag);$('oplvl').innerHTML=esc($('oplvl').textContent)+` · <span style="color:${G.hex};font-weight:800">${G.glyph} ${esc(G.perk)}</span>`;}}
  $('opXp').style.width=(save.level>=MAX_LEVEL?100:save.xp/need*100)+'%';
  {const wr=save.matches?Math.round(save.wins/save.matches*100):0;
  $('career').innerHTML=`<div class="cr-top">${badgeSvg(save.level,46)}<div class="cr-rk"><b>LEVEL ${save.level}</b><span>${rkUnlocked()?'RANKED · '+rkInfo(rkData('br').rp).name+' / '+rkInfo(rkData('tdm').rp).name:'RANKED AT LEVEL '+RANK_UNLOCK}</span></div></div><div class="cr-grid">${[['MATCHES',save.matches],['KILLS',save.kills],['WINS',save.wins]].map(([k,v])=>`<div><b>${v}</b><span>${k}</span></div>`).join('')}</div><div class="cr-bar"><span>WIN RATE</span><span>${wr}%</span></div><div class="cr-wr"><i style="width:${wr}%"></i></div><div class="cr-bar"><span>WIN STREAK</span><span>${streakLv()?streakFlames(Math.min(streakLv(),3))+' '+streakLv():(save.winRun|0)+'/2'} · best ${save.bestStreak|0}</span></div><div class="cr-bar"><span>BEST PRACTICE</span><span>${save.bestPractice}</span></div>`;}
  homeDeck();
  $('modes').innerHTML=rankedCard()+Object.entries(MODES).map(([k,m])=>`<button class="mode${m.feat?' feat':''}" data-m="${k}" style="--art:url('${modeArt(k)}')"><span class="art"></span><div class="mi">${m.icon}</div><div class="mb"><div class="mn">${m.name}</div><div class="md">${MODE_META[k]?MODE_META[k].line:m.desc}</div><div class="mm">${(MODE_META[k]?MODE_META[k].chips:[]).map(c=>`<span>${c}</span>`).join('')}</div></div><div class="mt"></div></button>`).join('');
  $('diffSeg').innerHTML=['easy','normal','hard'].map(d=>`<button data-d="${d}" class="${save.diff===d?'on':''}">${d[0].toUpperCase()+d.slice(1)}</button>`).join('');
  $('sideSeg').innerHTML=[['T','Attack (T)'],['CT','Defense (CT)']].map(([v,l])=>`<button data-s="${v}" class="${save.side===v?'on':''}">${l}</button>`).join('');
  $('nameIn').value=save.name;setCat(save.cat||'bots');
  renderInventory();renderLoadout();renderStore();
  renderRanks();
}
function rankedCard(){const ok=rkUnlocked();
  if(!ok){const pct=Math.min(100,(save.level/RANK_UNLOCK)*100);return `<button class="mode rankedc lock" data-m="ranked"><div class="mi">🔒</div><div class="mb"><div class="mn">RANKED</div><div class="md">Unlocks at <b>Level ${RANK_UNLOCK}</b>. You are Level ${save.level}. Battle Royale and Team Deathmatch ladders, Bronze to Legend.</div><div class="xpbar rkbar" style="margin-top:7px"><i style="width:${pct.toFixed(0)}%"></i></div></div><div class="mt"></div></button>`;}
  const b=rkData('br'),t=rkData('tdm'),best=Math.max(b.rp,t.rp);
  return `<button class="mode rankedc" data-m="ranked"><div class="mi rkmi">${rkBadge(best,40)}</div><div class="mb"><div class="mn">RANKED</div><div class="md">Climb from Bronze to Legend. Platinum and up earns a character, codes and skins.</div><div class="mm"><span>${RK_MODES.br.icon} ${rkInfo(b.rp).name}</span><span>${RK_MODES.tdm.icon} ${rkInfo(t.rp).name}</span>${rkClaimable().length?`<span style="color:#ffd34d">🎁 ${rkClaimable().length} reward${rkClaimable().length>1?'s':''} ready</span>`:''}</div></div><div class="mt"></div></button>`;}
function renderRanks(){
  const need=xpToNext(save.level),ok=rkUnlocked();
  $('rankHead').innerHTML=`<div class="rhead">${badgeSvg(save.level,64)}<div style="flex:1"><div class="big">LEVEL ${save.level}</div><div class="oplvl">${save.level>=MAX_LEVEL?'Max level reached':save.xp.toLocaleString()+' / '+need.toLocaleString()+' XP to level '+(save.level+1)} · ${save.totalXp.toLocaleString()} total XP</div><div class="xpbar" style="height:7px"><i style="width:${save.level>=MAX_LEVEL?100:save.xp/need*100}%"></i></div></div></div>
  <div class="note" style="margin:8px 0 14px">Level goes up with XP from every match (kills, headshots, wins). It does not change your rank. <b>Level ${RANK_UNLOCK}</b> unlocks Ranked.</div>`;
  const cards=Object.entries(RK_MODES).map(([m,M])=>{const R=rkData(m),I=rkInfo(R.rp),pct=I.hi?(R.rp-I.lo)/(I.hi-I.lo)*100:100;
    return `<div class="rkc ${ok?'':'lock'}"><div class="rkc-h">${rkBadge(R.rp,52)}<div><div class="rkc-m">${M.icon} ${M.name.toUpperCase()}</div><div class="rkc-n" style="color:${I.color}">${ok?I.name:'Locked'}</div><div class="rkc-s">${ok?R.rp+' RP · peak '+rkInfo(R.peak).name+' · '+R.played+' played':'Reach level '+RANK_UNLOCK}</div></div></div><div class="xpbar rkbar"><i style="width:${ok?pct.toFixed(1):0}%;background:${I.color}"></i></div></div>`;}).join('');
  let lo=0;const ladder=RTIERS.map(([n,d,c],ti)=>{const span=ti===5?800:d*100,a=lo;lo+=span;return `<div class="rk"><span>${rkBadge(a,28)}</span><span class="rn" style="color:${c}">${n}${d>1?' I–'+ROMAN[d-1]:''}</span><span class="rl">${ti===RTIERS.length-1?a+'+ RP':a+'–'+(a+span-1)+' RP'}</span></div>`;}).join('');
  $('rankList').innerHTML=`<h3 class="rksec">RANKED</h3><div class="rkcards">${cards}</div>${ok?'<div style="margin:10px 0"><button class="btn pri" id="rkGo">Play Ranked</button></div>':''}
    <div class="note" style="margin:6px 0 10px">Battle Royale: RP for placement and kills. Team Deathmatch: RP for winning, your K−D and being team MVP. Higher tiers gain a little less and lose more. Matches vs bots give 60% RP and bots get harder as you climb. Leaving a ranked match early costs RP.</div>${rkRewardsHTML()}<h3 class="rksec" style="margin-top:14px">ALL RANKS</h3>${ladder}`;
  const g=$('rkGo');if(g)g.onclick=openRanked;
}
/* ===== ACCOUNTS: password lock, recovery code, profile photo, several accounts per device ===== */
function sha256(str){const K=[0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2];
  const b=unescape(encodeURIComponent(str)),l=b.length,w=[];for(let i=0;i<l;i++)w[i>>2]|=b.charCodeAt(i)<<(24-(i%4)*8);w[l>>2]|=0x80<<(24-(l%4)*8);const n=((l+8)>>6)*16+16;for(let i=(l>>2)+1;i<n;i++)w[i]=w[i]|0;w[n-1]=l*8;
  let H=[0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19];const W=new Array(64),r=(x,k)=>(x>>>k)|(x<<(32-k));
  for(let o=0;o<n;o+=16){let[a,b2,c,d,e,f,g,h]=H;for(let t=0;t<64;t++){if(t<16)W[t]=w[o+t]|0;else{const x=W[t-15],y=W[t-2];W[t]=(W[t-16]+(r(x,7)^r(x,18)^(x>>>3))+W[t-7]+(r(y,17)^r(y,19)^(y>>>10)))|0;}
    const t1=(h+(r(e,6)^r(e,11)^r(e,25))+((e&f)^(~e&g))+K[t]+W[t])|0,t2=((r(a,2)^r(a,13)^r(a,22))+((a&b2)^(a&c)^(b2&c)))|0;h=g;g=f;f=e;e=(d+t1)|0;d=c;c=b2;b2=a;a=(t1+t2)|0;}
    H=[H[0]+a|0,H[1]+b2|0,H[2]+c|0,H[3]+d|0,H[4]+e|0,H[5]+f|0,H[6]+g|0,H[7]+h|0];}
  return H.map(x=>(x>>>0).toString(16).padStart(8,'0')).join('');}
function pwHash(pw,salt){let h=salt+'|'+pw;for(let i=0;i<1500;i++)h=sha256(h+salt);return h;}
function rndStr(n,abc){abc=abc||'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';const a=new Uint32Array(n);try{crypto.getRandomValues(a);}catch(e){for(let i=0;i<n;i++)a[i]=Math.random()*1e9;}let s='';for(let i=0;i<n;i++)s+=abc[a[i]%abc.length];return s;}
function pwSet(pw){const salt=rndStr(16);save.pw={s:salt,h:pwHash(pw,salt)};}
function pwCheck(pw){return !!save.pw&&pwHash(pw,save.pw.s)===save.pw.h;}
function recNew(){const code=rndStr(4)+'-'+rndStr(4);const salt=rndStr(12);save.rec={s:salt,h:pwHash(code,salt)};return code;}
function recCheck(code){code=String(code||'').toUpperCase().replace(/[^A-Z0-9]/g,'');if(code.length!==8)return false;code=code.slice(0,4)+'-'+code.slice(4);return !!save.rec&&pwHash(code,save.rec.s)===save.rec.h;}
function pwScore(pw){let s=0;if(pw.length>=6)s++;if(pw.length>=10)s++;if(/[A-Z]/.test(pw)&&/[a-z]/.test(pw))s++;if(/\d/.test(pw))s++;if(/[^A-Za-z0-9]/.test(pw))s++;return Math.min(4,s);}
function pwMeter(inp,bar){const sc=pwScore(inp.value),c=['#ff6b5f','#ff9a3c','#ffd24a','#9fe39f','#5fbf5f'][sc];bar.style.width=(inp.value?(sc+1)*20:0)+'%';bar.style.background=c;}
document.addEventListener('click',e=>{const b=e.target.closest('[data-eye]');if(!b)return;const i=$(b.dataset.eye);if(!i)return;i.type=i.type==='password'?'text':'password';b.classList.toggle('on',i.type==='text');});
/* ---- avatar ---- */
function avSet(el,url){if(!el)return;el.style.backgroundImage=url?`url("${url}")`:'';el.classList.toggle('has',!!url);}
function avRefresh(){const u=save.av||'';avSet($('opAv'),u);avSet($('suAv'),AV.pending!==undefined?AV.pending:u);const b=$('bAcct');if(b){b.classList.toggle('has',!!u);let im=b.querySelector('.av-img');if(u){if(!im){im=document.createElement('div');im.className='av-img xs';b.prepend(im);}avSet(im,u);}else if(im)im.remove();}
  const x=$('suAvX');if(x)x.classList.toggle('hidden',!(AV.pending!==undefined?AV.pending:u));}
const AV={pending:undefined,img:null,zoom:1,ox:0,oy:0,stream:null,target:null};
function avThumb(url,size){return new Promise(res=>{if(!url)return res('');const im=new Image();im.onload=()=>{const c=document.createElement('canvas');c.width=c.height=size;c.getContext('2d').drawImage(im,0,0,size,size);try{res(c.toDataURL('image/jpeg',0.8));}catch(e){res('');}};im.onerror=()=>res('');im.src=url;});}
function camOpen(target){if(oldShell()){frToast('The camera needs the new app version — please reinstall the latest APK.',5000);return;}AV.target=target;AV.img=null;$('camScr').classList.remove('hidden');$('camTitle').textContent='TAKE A PHOTO';camMode('live');$('camNote').textContent='Starting camera…';
  const v=$('camVid');if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){camNoCam();return;}
  navigator.mediaDevices.getUserMedia({video:{facingMode:'user',width:{ideal:720},height:{ideal:720}},audio:false}).then(st=>{AV.stream=st;v.srcObject=st;v.play().catch(()=>{});$('camNote').textContent='Look at the camera and press Snap.';}).catch(()=>camNoCam());}
function camNoCam(){$('camNote').textContent='Camera not available here. Pick a photo from your gallery instead.';$('camSnap').classList.add('hidden');}
function camStop(){if(AV.stream){AV.stream.getTracks().forEach(t=>t.stop());AV.stream=null;}const v=$('camVid');try{v.srcObject=null;}catch(e){}}
function camMode(m){const live=m==='live';$('camVid').classList.toggle('hidden',!live);$('camCrop').classList.toggle('hidden',live);$('camSnap').classList.toggle('hidden',!live);$('camRetake').classList.toggle('hidden',live||!AV.fromCam);$('camUse').classList.toggle('hidden',live);$('camZoomRow').classList.toggle('hidden',live);}
function camClose(){camStop();$('camScr').classList.add('hidden');}
function camEdit(img,fromCam){AV.img=img;AV.fromCam=fromCam;AV.zoom=1;AV.ox=0;AV.oy=0;$('camZoom').value=1;camStop();camMode('edit');$('camTitle').textContent='ADJUST YOUR PHOTO';$('camNote').textContent='Drag to move, use the slider to zoom.';camDraw();}
function camDraw(){const c=$('camCrop'),x=c.getContext('2d'),im=AV.img;if(!im)return;const S=c.width,base=Math.max(S/im.width,S/im.height)*AV.zoom,w=im.width*base,h=im.height*base;
  AV.ox=clamp(AV.ox,-(w-S)/2,(w-S)/2);AV.oy=clamp(AV.oy,-(h-S)/2,(h-S)/2);x.fillStyle='#000';x.fillRect(0,0,S,S);x.save();if(AV.fromCam){x.translate(S,0);x.scale(-1,1);}x.drawImage(im,(S-w)/2+(AV.fromCam?-AV.ox:AV.ox),(S-h)/2+AV.oy,w,h);x.restore();}
function camSnap(){const v=$('camVid');if(!v.videoWidth){$('camNote').textContent='Camera is still starting…';return;}const c=document.createElement('canvas');c.width=v.videoWidth;c.height=v.videoHeight;c.getContext('2d').drawImage(v,0,0);const im=new Image();im.onload=()=>camEdit(im,true);im.src=c.toDataURL('image/jpeg',0.92);sfx('click');}
function camUse(){const src=$('camCrop'),c=document.createElement('canvas');c.width=c.height=256;c.getContext('2d').drawImage(src,0,0,256,256);let url='';try{url=c.toDataURL('image/jpeg',0.85);}catch(e){}
  camClose();if(!url)return;if(AV.target==='setup'){AV.pending=url;avRefresh();}else{save.av=url;persist();acctSync();avRefresh();try{acRender();}catch(e){}frToast('Profile photo updated.');}sfx('buy');}
function oldShell(){return /CombatHorizensApp\/1\b/.test(navigator.userAgent||'');}
function avPickFile(target){if(oldShell()){frToast('Photos need the new app version — please reinstall the latest APK.',5000);return;}AV.target=target;const f=$('avFile');f.value='';f.click();}
$('avFile').addEventListener('change',e=>{const f=e.target.files&&e.target.files[0];if(!f)return;if(!/^image\//.test(f.type)&&f.type){frToast('Please choose an image file.');return;}
  const rd=new FileReader();rd.onload=()=>{const im=new Image();im.onload=()=>{$('camScr').classList.remove('hidden');camEdit(im,false);};im.onerror=()=>frToast('Could not open that image.');im.src=rd.result;};rd.readAsDataURL(f);});
{const cv=$('camCrop');let drag=null;const pt=e=>{const t=e.touches?e.touches[0]:e;return[t.clientX,t.clientY];};
  const down=e=>{if(!AV.img)return;drag=pt(e);e.preventDefault();},move=e=>{if(!drag)return;const p=pt(e),k=cv.width/cv.getBoundingClientRect().width;AV.ox+=(p[0]-drag[0])*k;AV.oy+=(p[1]-drag[1])*k;drag=p;camDraw();e.preventDefault();},up=()=>drag=null;
  cv.addEventListener('mousedown',down);addEventListener('mousemove',move);addEventListener('mouseup',up);cv.addEventListener('touchstart',down,{passive:false});cv.addEventListener('touchmove',move,{passive:false});cv.addEventListener('touchend',up);
  cv.addEventListener('wheel',e=>{if(!AV.img)return;AV.zoom=clamp(AV.zoom*(e.deltaY<0?1.06:0.94),1,3);$('camZoom').value=AV.zoom;camDraw();e.preventDefault();},{passive:false});}
$('camZoom').addEventListener('input',e=>{AV.zoom=+e.target.value;camDraw();});
$('camSnap').onclick=camSnap;$('camUse').onclick=camUse;$('camCancel').onclick=camClose;$('camRetake').onclick=()=>camOpen(AV.target);$('camGal').onclick=()=>{const t=AV.target;camClose();avPickFile(t);};
$('suCam').onclick=()=>camOpen('setup');$('suPick').onclick=()=>avPickFile('setup');$('suAvX').onclick=()=>{AV.pending='';avRefresh();};
/* ---- account registry (several accounts on one device) ---- */
function acctReg(){let r=null;try{r=JSON.parse(localStorage.getItem('ch_accts')||'null');}catch(e){}if(!r||!Array.isArray(r.list))r={cur:null,list:[]};return r;}
function acctRegSave(r){try{localStorage.setItem('ch_accts',JSON.stringify(r));}catch(e){}}
function acctSync(){if(!save.profile)return;if(!save.acctId){save.acctId='a'+Date.now().toString(36)+rndStr(4).toLowerCase();persist();}const r=acctReg();let e=r.list.find(x=>x.id===save.acctId);if(!e){e={id:save.acctId};r.list.push(e);}
  Object.assign(e,{name:save.name,lv:save.level,pw:!!save.pw,t:Date.now()});r.cur=save.acctId;if(save.av&&e.avSrc!==save.av.length){avThumb(save.av,72).then(u=>{const r2=acctReg(),e2=r2.list.find(x=>x.id===save.acctId);if(e2){e2.av=u;e2.avSrc=save.av.length;acctRegSave(r2);}});}else if(!save.av){e.av='';e.avSrc=0;}acctRegSave(r);}
function acctPark(){persist();try{localStorage.setItem('ch_acct_'+save.acctId,localStorage.getItem('dustline_v1'));}catch(e){frToast('Not enough storage space to switch accounts.');return false;}return true;}
function acctSwitchTo(id){if(id===save.acctId){$('acctSw').classList.add('hidden');return;}acctSync();if(!acctPark())return;const data=localStorage.getItem('ch_acct_'+id);if(!data){frToast('That account could not be found.');return;}
  try{localStorage.setItem('dustline_v1',data);localStorage.removeItem('ch_acct_'+id);}catch(e){return;}const r=acctReg();r.cur=id;acctRegSave(r);try{sessionStorage.removeItem('ch_unlocked');}catch(e){}acctReload();}
function acctAdd(){if(save.profile){acctSync();if(!acctPark())return;}try{localStorage.setItem('dustline_v1',JSON.stringify({newAcct:1}));sessionStorage.removeItem('ch_unlocked');}catch(e){}const r=acctReg();r.cur=null;acctRegSave(r);acctReload();}
function acctReload(){try{netLeave(true);}catch(e){}document.body.style.opacity='0.4';setTimeout(()=>location.reload(),120);}
function openSwitcher(){const r=acctReg();if(save.profile&&!r.list.find(x=>x.id===save.acctId)){acctSync();}const L=acctReg().list.slice().sort((a,b)=>(b.id===save.acctId)-(a.id===save.acctId)||b.t-a.t);
  $('swList').innerHTML=L.map(a=>`<button class="sw-a ${a.id===save.acctId?'cur':''}" data-acct="${a.id}"><div class="av-img md ${a.av?'has':''}" style="${a.av?`background-image:url('${a.av}')`:''}"></div><div><b>${esc((a.name||'Player').toUpperCase())}</b><small>Level ${a.lv||1}${a.pw?' · 🔒 password':''}</small></div>${a.id===save.acctId?'<em>SIGNED IN</em>':''}</button>`).join('')||'<div class="note">No other accounts yet.</div>';
  $('acctSw').classList.remove('hidden');}
$('swList').addEventListener('click',e=>{const b=e.target.closest('[data-acct]');if(b)acctSwitchTo(b.dataset.acct);});
$('swAdd').onclick=()=>{if(!confirmInline($('swAdd'),'Tap again to add a new account'))return;acctAdd();};$('swClose').onclick=()=>$('acctSw').classList.add('hidden');
function confirmInline(btn,msg){if(btn.dataset.sure){delete btn.dataset.sure;return true;}btn.dataset.sure=1;const old=btn.textContent;btn.textContent=msg;setTimeout(()=>{if(btn.dataset.sure){delete btn.dataset.sure;btn.textContent=old;}},3000);return false;}
/* ---- lock screen ---- */
function lockShow(mode){const L=$('lockScr');avSet($('lkAv'),save.av||'');$('lkName').textContent=(save.name||'Player').toUpperCase();$('lkErr').textContent='';$('lkErr2').textContent='';$('lkPw').value='';$('lkCode').value='';$('lkNew').value='';
  const change=mode==='change';$('lkLogin').classList.toggle('hidden',mode!=='login');$('lkReset').classList.toggle('hidden',mode==='login');$('lkSub').textContent=change?'Change your password':mode==='reset'?'Reset your password':'Enter your password to continue';
  $('lkCode').placeholder=change?'Current password or recovery code':'RECOVERY CODE (XXXX-XXXX)';$('lkCode').type=change?'password':'text';$('lkCode').style.textTransform=change?'none':'uppercase';$('lkBack').textContent=change?'Cancel':'Back to sign in';
  L.dataset.mode=mode;L.classList.remove('hidden');setTimeout(()=>{try{(mode==='login'?$('lkPw'):$('lkCode')).focus();}catch(e){}},60);}
function lockDone(){$('lockScr').classList.add('hidden');try{sessionStorage.setItem('ch_unlocked',save.acctId||'1');}catch(e){}initAudio();sfx('buy');acctSync();renderMenu();avRefresh();}
let _lkFails=0,_lkUntil=0;
$('lkGo').onclick=()=>{if(Date.now()<_lkUntil){$('lkErr').textContent=`Too many tries. Wait ${Math.ceil((_lkUntil-Date.now())/1000)} s.`;return;}
  if(pwCheck($('lkPw').value)){_lkFails=0;save.stay=$('lkStay').checked?1:0;persist();lockDone();}else{_lkFails++;if(_lkFails>=5){_lkUntil=Date.now()+30000;_lkFails=0;}$('lkErr').textContent='Wrong password.';sfx('deny');$('lkPw').select();}};
$('lkPw').addEventListener('keydown',e=>{if(e.key==='Enter')$('lkGo').click();});
$('lkForgot').onclick=()=>lockShow('reset');$('lkSwitch').onclick=openSwitcher;
$('lkBack').onclick=()=>{if($('lockScr').dataset.mode==='change')$('lockScr').classList.add('hidden');else lockShow('login');};
$('lkResetGo').onclick=()=>{const mode=$('lockScr').dataset.mode,c=$('lkCode').value,np=$('lkNew').value;const ok=mode==='change'?(pwCheck(c)||recCheck(c)):recCheck(c);
  if(!ok){$('lkErr2').textContent=mode==='change'?'Current password (or recovery code) is wrong.':'That recovery code is wrong.';sfx('deny');return;}
  if(np.length<6){$('lkErr2').textContent='New password must be at least 6 characters.';return;}
  pwSet(np);persist();acctSync();if(mode==='change'){$('lockScr').classList.add('hidden');frToast('Password changed.');sfx('buy');}else lockDone();};
$('lkNew').addEventListener('keydown',e=>{if(e.key==='Enter')$('lkResetGo').click();});
/* ---- recovery code screen ---- */
function recShow(code,then){$('recCode').textContent=code;$('recOk').checked=false;$('recGo').disabled=true;$('recScr').classList.remove('hidden');$('recGo').onclick=()=>{$('recScr').classList.add('hidden');then&&then();};}
$('recOk').addEventListener('change',e=>{$('recGo').disabled=!e.target.checked;});
$('recCopy').onclick=()=>{try{navigator.clipboard.writeText($('recCode').textContent);$('recCopy').textContent='Copied!';setTimeout(()=>$('recCopy').textContent='Copy code',1200);}catch(e){}};
/* ---- account screen buttons ---- */
$('acPhoto').onclick=()=>camOpen('acct');$('acPass').onclick=()=>{if(!save.pw){showSetup('secure');return;}lockShow('change');};
$('acSw').onclick=openSwitcher;$('acOut').onclick=()=>{if(!save.pw){showSetup('secure');return;}closeAccount();save.stay=0;persist();try{sessionStorage.removeItem('ch_unlocked');}catch(e){}lockShow('login');};
$('suPw').addEventListener('input',()=>pwMeter($('suPw'),$('suPwM')));
/* ---- boot: lock if needed ---- */
function acctBoot(){if(!save.profile)return;acctSync();avRefresh();
  if(!save.pw){setTimeout(()=>showSetup('secure'),400);return;}
  let un='';try{un=sessionStorage.getItem('ch_unlocked')||'';}catch(e){}
  if(!save.stay&&un!==(save.acctId||'1'))lockShow('login');}
/* ===== AGENT SIGNATURES: every bought agent has its own perk, kill effect and colour ===== */
const AG_SIG={
  operator:{c:0xb08a3e,hex:'#c9a25a',perk:'Standard Issue',d:'No perk. Buy an agent in the Store to unlock a signature perk.',glyph:'★'},
  viper:{c:0xe0b060,hex:'#e0b060',perk:'Quick Hands',d:'Reload 15% faster.',glyph:'◆',k:{reload:1.15}},
  ghost:{c:0x8cff5a,hex:'#8cff5a',perk:'Fieldcraft',d:'After 4 s without taking damage, heal 2 HP a second, up to 60 HP.',glyph:'❦',regen:1},
  owl:{c:0x2ad0ff,hex:'#2ad0ff',perk:'Steady Aim',d:'15% less recoil on every gun.',glyph:'✦',k:{recoil:0.85}},
  fox:{c:0xa8e4ff,hex:'#a8e4ff',perk:'Swift',d:'Move 6% faster.',glyph:'❄',k:{speed:1.06}},
  fang:{c:0xff3a3a,hex:'#ff4a4a',perk:'Bloodlust',d:'Every kill heals you 15 HP.',glyph:'✖',killHeal:15},
  gold:{c:0xffd24a,hex:'#ffd24a',perk:'Bounty Hunter',d:'Earn 25% more coins and 10% more XP from every match.',glyph:'$',bounty:1}};
function agSig(id){return AG_SIG[id||save.agent||'operator']||AG_SIG.operator;}
function agentK(stat){const k=agSig().k;return k&&k[stat]||1;}
function agHpOk(){return !NET.role||NET.role==='host';}
const _agTex={};function agGlyphTex(id){if(_agTex[id])return _agTex[id];const S=agSig(id);const c=document.createElement('canvas');c.width=c.height=64;const x=c.getContext('2d');
  x.font='bold 46px Arial';x.textAlign='center';x.textBaseline='middle';x.shadowColor=S.hex;x.shadowBlur=12;x.fillStyle='#fff';x.fillText(S.glyph,32,35);x.fillStyle=S.hex;x.globalAlpha=0.55;x.fillText(S.glyph,32,35);
  const t=new THREE.CanvasTexture(c);_agTex[id]=t;return t;}
function agKillFx(pos){const id=save.agent||'operator';if(id==='operator')return;const S=agSig(id),p=pos.clone();p.y+=1.1;
  try{fxSpr({pos:p,tex:FX_BALL,c0:S.c,c1:S.c,s0:0.2,s1:2.4,life:0.45,o0:0.9});
    const n=fxN(14);for(let i=0;i<n;i++){const a=i/n*Math.PI*2+Math.random()*0.4,sp=1.6+Math.random()*1.8;fxSpr({pos:p.clone(),tex:agGlyphTex(id),c0:0xffffff,s0:0.22,s1:0.12,life:0.9+Math.random()*0.5,o0:1,vel:new V3(Math.cos(a)*sp,1.4+Math.random()*2.2,Math.sin(a)*sp),drag:1.6,rise:-2.2,spin:(Math.random()-0.5)*6,add:true});}
    fxSpr({pos:p.clone().add(new V3(0,0.6,0)),tex:agGlyphTex(id),c0:0xffffff,s0:0.3,s1:0.75,life:1.1,o0:1,rise:0.9,add:true});}catch(e){}}
function agOnKill(){const S=agSig();if(S.killHeal&&agHpOk()&&player.alive&&player.hp<hpMax()){player.hp=Math.min(hpMax(),player.hp+S.killHeal);agFlash('+'+S.killHeal+' HP');}}
function agTick(dt){const G=agSig(),p=player;if(!G.regen||!p.alive||!agHpOk()||S_paused()||S.mode==='practice')return;
  if(S.time-(p.lastHurtT||-99)>4&&p.hp<60*hpK()){const before=p.hp;p._rg=(p._rg||0)+dt*2;if(p._rg>=1){const n=Math.floor(p._rg);p._rg-=n;p.hp=Math.min(60*hpK(),p.hp+n);if(p.hp>before&&!p._rgFlash){p._rgFlash=1;agFlash('Healing');}}}else p._rgFlash=0;}
function S_paused(){return S.paused||S.ended;}
function agFlash(t){const el=$('perkChip');if(!el)return;el.classList.remove('fl');void el.offsetWidth;el.classList.add('fl');const sp=el.querySelector('em');if(sp){sp.textContent=t;}}
function agHud(){const el=$('perkChip');if(!el)return;const id=save.agent||'operator',G=agSig(id);if(id==='operator'||S.mode==='practice'){el.classList.add('hidden');return;}
  el.classList.remove('hidden');el.style.setProperty('--ag',G.hex);el.innerHTML=`<i>${G.glyph}</i><b>${esc(G.perk.toUpperCase())}</b><em></em>`;el.title=AGENTS[id].n+' · '+G.d;}
function agDeployMsg(){const id=save.agent||'operator';if(id==='operator'||S.mode==='practice')return;const G=agSig(id);setTimeout(()=>{try{if(S_paused())return;floatHint(`<b style="color:${G.hex}">${G.glyph} ${esc(AGENTS[id].n.toUpperCase())}</b> · ${esc(G.perk)}: ${esc(G.d)}`);}catch(e){}},1200);}
function floatHint(html){const el=$('agHint');if(!el)return;el.innerHTML=html;el.classList.remove('hidden','go');void el.offsetWidth;el.classList.add('go');clearTimeout(el._t);el._t=setTimeout(()=>el.classList.add('hidden'),4200);}
function agKillPreview(){try{if(S.state==='game'||!operator||!operator.g)return;const p=operator.g.position.clone();agKillFx(p);}catch(e){}}
function agLobbyTint(){if(LOBBY.pad){const G=agSig();LOBBY.pad.material.color.set(save.agent&&save.agent!=='operator'?G.c:0xffffff);}}
/* ===== WEAPON WEIGHT → MOVE SPEED (setting) ===== */
const WEIGHT_BASE=4.5,WEIGHT_K={off:0,normal:1,real:1.8};
function weightMode(){return NET.role?'normal':(WEIGHT_K[save.weightMode]!==undefined?save.weightMode:'normal');}
function wSpeed(w){const k=WEIGHT_K[weightMode()];const v=WEIGHT_BASE+((w&&w.speed||WEIGHT_BASE)-WEIGHT_BASE)*k;return Math.max(2.6,v);}
function wClass(w){if(weightMode()==='off')return '';const sp=w&&w.speed||WEIGHT_BASE;return sp>=4.6?'LIGHT':sp>=4.05?'MEDIUM':'HEAVY';}
function weightNote(){const m=save.weightMode||'normal';const ex=id=>Math.round(wSpeed(WEAPONS[id])/WEIGHT_BASE*100)+'%';
  const old=save.weightMode;save.weightMode=m;const t=m==='off'?'Every weapon moves at the same speed.':`Knife ${ex(knifeId())} · Glock ${ex('glock')} · AK-47 ${ex('ak47')} · AWP ${ex('awp')} · Negev ${ex('negev')} of normal speed.`;save.weightMode=old;return t+' Online matches always use Normal so it stays fair.';}
/* ===== WIN STREAK: every 2 wins in a row = 1 streak level. A loss resets it. ===== */
function streakLv(){return Math.floor((save.winRun|0)/2);}
function streakUpdate(win){const before=streakLv(),run0=save.winRun|0;let out={level:0,xpPct:0,coins:0,up:false,lost:0,run:0};
  if(win){save.winRun=run0+1;const lv=streakLv();out.level=lv;out.run=save.winRun;if(lv>before){out.up=true;out.coins=Math.min(400,100*lv);save.streakUps=(save.streakUps|0)+1;}
    out.xpPct=Math.min(0.5,0.1*lv);if(lv>(save.bestStreak|0))save.bestStreak=lv;if(save.winRun>(save.bestRun|0))save.bestRun=save.winRun;}
  else{out.lost=before;out.lostRun=run0;save.winRun=0;}
  return out;}
function streakFlames(n){return n>0?'🔥'.repeat(Math.min(n,5))+(n>5?'+':''):'';}
function streakEnd(st){const el=$('endStreak');if(!el)return;if(!st){el.innerHTML='';return;}
  const run=save.winRun|0,lv=streakLv(),toNext=2-(run%2);
  const pips=`<div class="stk-pips">${[0,1].map(i=>`<i class="${(run%2)>i||(st.up&&i<2&&run%2===0)?'on':''}"></i>`).join('')}</div>`;
  if(st.up){el.innerHTML=`<div class="stk up"><div class="stk-f">${streakFlames(lv)}</div><div class="stk-t"><b>STREAK ${lv}!</b><span>${run} wins in a row · +${st.coins} coins · +${Math.round(st.xpPct*100)}% XP every win while it lasts</span></div>${pips}</div>`;setTimeout(()=>{try{sfx('medal');}catch(e){}},900);}
  else if(st.level>0||run>0){el.innerHTML=`<div class="stk"><div class="stk-f">${lv?streakFlames(lv):'🔥'}</div><div class="stk-t"><b>${lv?'STREAK '+lv:'WIN STREAK'}</b><span>${run} win${run>1?'s':''} in a row · ${toNext} more win${toNext>1?'s':''} for streak ${lv+1}</span></div>${pips}</div>`;}
  else if(st.lost>0||st.lostRun>0){el.innerHTML=`<div class="stk lost"><div class="stk-f">💨</div><div class="stk-t"><b>STREAK LOST</b><span>${st.lost?'You were on streak '+st.lost+' ('+st.lostRun+' wins). ':''}Win 2 matches in a row to start a new one.</span></div></div>`;}
  else el.innerHTML='';}
function streakChip(){const lv=streakLv(),run=save.winRun|0;if(!run)return '';return `<span class="stk-chip" title="${run} wins in a row">${lv?streakFlames(Math.min(lv,3))+' '+lv:'🔥 '+run+'/2'}</span>`;}
/* ===== DAILY TASKS: 3 tasks a day (easy / medium / hard) paying coins, a weapon skin and a level boost, plus a bonus for finishing all three ===== */
const DT_POOL=[
  {id:'play',tier:0,t:n=>`Play ${n} matches`,n:[2,3],ev:r=>1},
  {id:'kills',tier:0,t:n=>`Get ${n} kills`,n:[10,15],ev:r=>r.k},
  {id:'dmg',tier:0,t:n=>`Deal ${n.toLocaleString()} damage`,n:[1500,2500],ev:r=>r.dmg},
  {id:'hs',tier:1,t:n=>`Get ${n} headshot kills`,n:[5,8],ev:r=>r.hk},
  {id:'rifle',tier:1,t:n=>`Get ${n} kills with rifles`,n:[8,10],ev:r=>dtCat(r,['rifle','mg'])},
  {id:'pistol',tier:1,t:n=>`Get ${n} kills with pistols`,n:[5,6],ev:r=>dtCat(r,['pistol'])},
  {id:'smg',tier:1,t:n=>`Get ${n} kills with SMGs or shotguns`,n:[6,8],ev:r=>dtCat(r,['smg','shotgun'])},
  {id:'wins',tier:1,t:n=>`Win ${n} matches`,n:[2],ev:r=>r.win&&r.mode!=='br'||r.mode==='br'&&r.rank===1?1:0},
  {id:'kills2',tier:1,t:n=>`Get ${n} kills`,n:[25,30],ev:r=>r.k},
  {id:'sniper',tier:2,t:n=>`Get ${n} kills with sniper rifles`,n:[3,4],ev:r=>dtCat(r,['sniper','dmr'])},
  {id:'knife',tier:2,t:n=>`Get ${n} knife kills`,n:[2],ev:r=>dtCat(r,['melee'])},
  {id:'nade',tier:2,t:n=>`Get ${n} kills with grenades, fire or barrels`,n:[2],ev:r=>Object.entries(r.w||{}).reduce((a,[id,w])=>a+((WEAPONS[id]&&WEAPONS[id].nade)||id==='barrel'||id==='fire'||id==='molotov'||id==='incendiary'?w.k:0),0)},
  {id:'acc',tier:2,t:n=>`Finish a match with ${n}%+ accuracy (30+ shots)`,n:[30,35],one:1,ev:(r,n)=>r.sh>=30&&r.hi/r.sh*100>=n?1:0},
  {id:'hs1',tier:2,t:n=>`Get ${n} headshot kills in one match`,n:[4,5],one:1,ev:(r,n)=>r.hk>=n?1:0},
  {id:'defuse',tier:2,t:()=>`Win a Bomb Defusal match`,n:[1],ev:r=>r.mode==='defuse'&&r.win?1:0},
  {id:'br5',tier:2,t:()=>`Finish top 5 in Battle Royale`,n:[1],ev:r=>r.mode==='br'&&r.rank&&r.rank<=5?1:0},
  {id:'dmg1',tier:2,t:n=>`Deal ${n.toLocaleString()} damage in one match`,n:[1500,2000],one:1,ev:(r,n)=>r.dmg>=n?1:0}];
const DT_TIER=['EASY','MEDIUM','HARD'];
function dtCat(r,cats){let k=0;for(const[id,w]of Object.entries(r.w||{})){const W=WEAPONS[id];if(W&&cats.includes(W.cat))k+=w.k;}return k;}
function dtSkin(rng,maxR,minR=0){const pool=[];for(const w of GUN_IDS.filter(gunOwned))for(const p of Object.keys(PAINTS)){const P=PAINTS[p];if(P.r>maxR||P.r<minR)continue;if(P.fin&&FINS[P.fin]&&FINS[P.fin].ex)continue;pool.push([w,p]);}
  if(!pool.length)return dtSkin(rng,maxR+1,Math.max(0,minR-1));const x=pool[Math.floor(rng()*pool.length)];return{k:'skin',w:x[0],p:x[1]};}
function dtNew(day){const r=mulberry32(day*104729+((save.fid||'x').charCodeAt(0)|0));const pick=a=>a[Math.floor(r()*a.length)];
  const kinds=['coins','skin','boost'].sort(()=>r()-0.5);const tasks=[];
  for(let tier=0;tier<3;tier++){const T=pick(DT_POOL.filter(x=>x.tier===tier));tasks.push(dtMake(T,pick(T.n),tier,kinds[tier],r));}
  return {day,tasks,bonus:false,rr:false,bonusRw:dtSkin(r,4,3)};}
function dtMake(T,n,tier,kind,r){const rw=kind==='coins'?{k:'coins',v:[150,250,400][tier]}:kind==='skin'?dtSkin(r,[1,2,3][tier],[0,1,2][tier]):{k:'boost',xp:[600,1000,1500][tier],m:[1,2,3][tier]};return {id:T.id,n,p:0,tier,rw,c:false};}
function dtState(){const d=dayKey();if(!save.daily||save.daily.day!==d){save.daily=dtNew(d);persist();}return save.daily;}
function dtDef(t){return DT_POOL.find(x=>x.id===t.id)||DT_POOL[0];}
function dtProgress(rec){const D=dtState(),done=[];for(const t of D.tasks){if(t.c||t.p>=t.n)continue;const T=dtDef(t);const v=T.ev(rec,t.n)||0;t.p=Math.min(t.n,t.p+v);if(t.p>=t.n)done.push(T.t(t.n));}
  if(done.length){persist();setTimeout(()=>{try{frToast('✔ Daily task complete: '+done.join(' · ')+' — claim it in Daily Tasks',6000);sfx('medal');}catch(e){}},1600);}dtBadge();}
function dtClaimable(){const D=dtState();let n=D.tasks.filter(t=>!t.c&&t.p>=t.n).length;if(!D.bonus&&D.tasks.every(t=>t.c))n++;return n;}
function dtBadge(){const b=$('dtBadge');if(!b)return;const D=dtState(),c=dtClaimable(),left=D.tasks.filter(t=>!t.c&&t.p<t.n).length;b.textContent=c||left;b.classList.toggle('hidden',!c&&!left);b.classList.toggle('go',!!c);b.style.background=c?'#f2a33a':'#5d6573';b.style.color=c?'#1a1208':'#fff';}
function dtRwHtml(rw){if(rw.k==='coins')return `<div class="dt-coin">⛃ ${rw.v}</div><small>COINS</small>`;
  if(rw.k==='boost')return `<div class="dt-xp">⚡ +${rw.xp.toLocaleString()} XP<em>+ 2× XP for ${rw.m} match${rw.m>1?'es':''}</em></div><small>LEVEL BOOST</small>`;
  return itemCardHtml(rw)+`<small>WEAPON SKIN</small>`;}
function dtLeft(){const ms=(dayKey()+1)*86400000-Date.now(),h=Math.floor(ms/3600000),m=Math.floor(ms%3600000/60000);return h+'h '+m+'m';}
function openDaily(){initAudio();dtRender();$('daily').classList.remove('hidden');sfx('click');clearInterval(window._dtT);window._dtT=setInterval(()=>{if($('daily').classList.contains('hidden')){clearInterval(window._dtT);return;}if(save.daily&&save.daily.day!==dayKey())dtRender();else $('dtSub').innerHTML=dtSubHtml();},30000);}
function dtSubHtml(){const D=dtState();return `New tasks in <b>${dtLeft()}</b> · ${D.tasks.filter(t=>t.c).length} of 3 claimed`;}
function dtRender(){const D=dtState();$('dtSub').innerHTML=dtSubHtml();
  $('dtBoost').innerHTML=(save.xpBoostM|0)>0?`<div class="dt-boost">⚡ <span><b>2× XP active</b> for your next ${save.xpBoostM} match${save.xpBoostM>1?'es':''} (not the practice range)</span></div>`:'';
  $('dtList').innerHTML=D.tasks.map((t,i)=>{const T=dtDef(t),done=t.p>=t.n;const st=t.c?'<div class="dt-st ok">✔ CLAIMED</div>':done?`<button class="btn pri" data-claim="${i}">CLAIM</button>`:`<div class="dt-st">${T.one?'ONE MATCH':'IN PROGRESS'}</div>`+(!D.rr?`<button class="dt-rr" data-rr="${i}" title="Swap for a different task (once a day)">↻ Swap task</button>`:'');
    return `<div class="dt-t ${t.c?'claimed':done?'done':''}" data-i="${i}"><div class="dt-main"><span class="dt-tier t${t.tier}">${DT_TIER[t.tier]}</span><b>${esc(T.t(t.n))}</b><div class="dt-pr"><div class="dt-bar"><i style="width:${Math.round(t.p/t.n*100)}%"></i></div><span>${T.one&&t.n>1?(t.p?'Done':'0 / 1'):t.p.toLocaleString()+' / '+t.n.toLocaleString()}</span></div></div><div class="dt-rw">${dtRwHtml(t.rw)}</div><div class="dt-act">${st}</div></div>`;}).join('');
  const all=D.tasks.every(t=>t.c),nDone=D.tasks.filter(t=>t.c).length;
  $('dtBonus').innerHTML=`<div class="dt-chest">${D.bonus?'✅':'🎁'}</div><div style="flex:1"><b>Daily bonus · complete all 3</b><small>+300 coins and a rare weapon skin (${nDone}/3)</small></div><div class="dt-rw">${itemCardHtml(D.bonusRw)}</div><div class="dt-act">${D.bonus?'<div class="dt-st ok">✔ CLAIMED</div>':all?'<button class="btn pri" data-bonus="1">CLAIM</button>':'<div class="dt-st">LOCKED</div>'}</div>`;
  dtBadge();}
function dtGive(rw,el){let msg='';
  if(rw.k==='coins'){save.coins+=rw.v;msg=`+${rw.v} coins`;sfx('buy');}
  else if(rw.k==='boost'){const before=save.level;addXP(rw.xp);save.xpBoostM=(save.xpBoostM|0)+rw.m;msg=`+${rw.xp} XP · 2× XP for ${rw.m} match${rw.m>1?'es':''}`+(save.level>before?` · LEVEL UP ${before} → ${save.level}!`:'');sfx(save.level>before?'levelup':'medal');}
  else{addItem({k:rw.k,w:rw.w,p:rw.p});msg='Added to your inventory';sfx('medal');}
  persist();renderMenu();
  if(el){const pop=document.createElement('div');pop.className='dt-pop';pop.innerHTML=(rw.k==='skin'?itemCardHtml(rw):'')+`<span>${esc(msg)}</span>`;el.appendChild(pop);}
  return msg;}
$('dtList').addEventListener('click',e=>{const D=dtState();const c=e.target.closest('[data-claim]');
  if(c){const t=D.tasks[+c.dataset.claim];if(!t||t.c||t.p<t.n)return;t.c=true;const card=c.closest('.dt-t');dtGive(t.rw,card);setTimeout(dtRender,1500);return;}
  const r=e.target.closest('[data-rr]');if(r&&!D.rr){const i=+r.dataset.rr,t=D.tasks[i];if(!t||t.c||t.p>=t.n)return;const used=D.tasks.map(x=>x.id);const opts=DT_POOL.filter(x=>x.tier===t.tier&&!used.includes(x.id));if(!opts.length)return;
    const T=opts[Math.floor(Math.random()*opts.length)];D.tasks[i]=Object.assign(dtMake(T,T.n[Math.floor(Math.random()*T.n.length)],t.tier,'coins',Math.random),{rw:t.rw});D.rr=true;persist();sfx('click');dtRender();}});
$('dtBonus').addEventListener('click',e=>{const D=dtState();if(!e.target.closest('[data-bonus]')||D.bonus||!D.tasks.every(t=>t.c))return;D.bonus=true;save.coins+=300;dtGive(D.bonusRw,$('dtBonus'));setTimeout(dtRender,1600);});
$('bDaily').onclick=openDaily;$('dtClose').onclick=()=>$('daily').classList.add('hidden');$('daily').addEventListener('click',e=>{if(e.target.id==='daily')$('daily').classList.add('hidden');});
addEventListener('keydown',e=>{if(e.code==='Escape'&&!$('daily').classList.contains('hidden'))$('daily').classList.add('hidden');});
setTimeout(()=>{try{dtBadge();}catch(e){}},500);
/* ===== ACCOUNT · personal combat analytics ===== */
let AN={w:{},taken:0,melee:0,longest:0};
function anReset(){AN={w:{},taken:0,longest:0};}
function anW(id){id=id||'other';return AN.w[id]||(AN.w[id]={s:0,h:0,hh:0,k:0,hk:0,dmg:0});}
function anShot(id,melee){if(melee)return;anW(id).s++;}
function anHit(id,head){const w=anW(id);w.h++;if(head)w.hh++;}
function anDmg(id,d){if(!(d>0))return;anW(id).dmg+=d;}
function anKill(id,head,dist){const w=anW(id);w.k++;if(head)w.hk++;if(dist>AN.longest)AN.longest=dist;}
function anStore(){const A=save.an||(save.an={hist:[],w:{},tot:{m:0,sh:0,hi:0,hh:0,k:0,hk:0,d:0,dmg:0,taken:0,time:0,longest:0,wins:0}});return A;}
function anRecord(win,rank){if(!S.mode)return;const A=anStore(),p=player;let sh=0,hi=0,hh=0,hk=0,dmg=0;const W={};
  const prac=S.mode==='practice';
  for(const[id,w]of Object.entries(AN.w)){sh+=w.s;hi+=w.h;hh+=w.hh;hk+=w.hk;dmg+=w.dmg;W[id]={s:w.s,h:w.h,hh:w.hh,k:w.k,hk:w.hk,dmg:Math.round(w.dmg)};if(prac)continue;
    const L=A.w[id]||(A.w[id]={s:0,h:0,hh:0,k:0,hk:0,dmg:0,m:0});L.s+=w.s;L.h+=w.h;L.hh+=w.hh;L.k+=w.k;L.hk+=w.hk;L.dmg+=Math.round(w.dmg);L.m++;}
  const rec={t:Date.now(),mode:S.duel?'duel':S.mode,fmt:S.fmt?S.fmt.join('v'):null,map:S.mapId||'',win:!!win,rank:rank||null,k:p.kills|0,d:p.deaths|0,sh,hi,hh,hk,dmg:Math.round(dmg),taken:Math.round(AN.taken),dur:Math.round(S.time||0),lk:Math.round(AN.longest||0),w:W,
    rounds:S.mode==='defuse'&&S.round?((S.round.wins.CT||0)+(S.round.wins.T||0)):0,net:!!NET.role};
  A.hist.push(rec);if(A.hist.length>80)A.hist.splice(0,A.hist.length-80);
  if(prac)return;try{dtProgress(rec);}catch(e){console.warn(e);}const T=A.tot;T.m++;T.sh+=sh;T.hi+=hi;T.hh+=hh;T.k+=rec.k;T.hk+=hk;T.d+=rec.d;T.dmg+=rec.dmg;T.taken+=rec.taken;T.time+=rec.dur;if(rec.lk>T.longest)T.longest=rec.lk;if(win&&S.mode!=='practice')T.wins++;}
const AC={tab:'ov',metric:'acc',wsort:'k'};
const pct=(a,b)=>b?a/b*100:null;
const fmtP=v=>v==null?'—':(Math.round(v*10)/10).toFixed(1)+'%';
const fmtN=v=>v==null?'—':Math.round(v).toLocaleString();
function anMetric(m,r){switch(m){case'acc':return pct(r.hi,r.sh);case'hs':return pct(r.hk,r.k);case'dmg':return r.dmg/Math.max(1,r.rounds||1);case'kd':return r.k/Math.max(1,r.d);}}
const AN_MET={acc:['Accuracy','%',v=>fmtP(v)],hs:['Headshot %','%',v=>fmtP(v)],dmg:['Damage per match','',v=>fmtN(v)],kd:['K/D ratio','',v=>v==null?'—':v.toFixed(2)]};
function anAgg(list){const t={sh:0,hi:0,hh:0,k:0,hk:0,d:0,dmg:0,n:list.length,w:0,rounds:0};for(const r of list){t.sh+=r.sh;t.hi+=r.hi;t.hh+=r.hh;t.k+=r.k;t.hk+=r.hk;t.d+=r.d;t.dmg+=r.dmg;t.w+=r.win?1:0;t.rounds+=r.rounds||1;}return t;}
function wName(id){const w=WEAPONS[id];return w&&w.name?w.name:id==='barrel'?'Explosive barrel':String(id).toUpperCase();}
function wIcon(id){try{const w=WEAPONS[id];if(!w)return '';if(w.melee)return knifeIcon(id)||'';return weaponIcon(id)||'';}catch(e){return '';}}
function openAccount(){initAudio();$('acct').classList.remove('hidden');sfx('click');acRender();}
function closeAccount(){$('acct').classList.add('hidden');}
function acRender(){const r=rankOf(save.level);
  $('acId').innerHTML=`<div class="av-img md ${save.av?'has':''}" style="${save.av?`background-image:url('${save.av}')`:''}"></div><div><b>${esc((save.name||'Operator').toUpperCase())}</b><small>LEVEL ${save.level} · ${Math.max(save.matches,(save.an&&save.an.hist.length)||0)} MATCHES</small></div>`;
  document.querySelectorAll('#acTabs button').forEach(b=>b.classList.toggle('on',b.dataset.t===AC.tab));
  const A=anStore(),H=A.hist.filter(h=>h.mode!=='practice');
  if(!A.hist.length){$('acBody').innerHTML=`<div class="ac-empty"><b>No matches tracked yet</b>Play any match and your accuracy, headshots, damage and weapon stats will appear here.<br>Tracking started in version 0.37 — older matches aren't included.</div>`;return;}
  $('acBody').innerHTML=AC.tab==='ov'?acOverview(A,H):AC.tab==='wp'?acWeapons(A):acHistory(A);
  if(AC.tab==='ov')acChartHook(H);}
function trend(H,m){if(H.length<4)return '';const n=Math.min(10,Math.floor(H.length/2)),a=anAgg(H.slice(-n)),b=anAgg(H.slice(-2*n,-n));
  const f=x=>m==='acc'?pct(x.hi,x.sh):m==='hs'?pct(x.hk,x.k):m==='dmg'?x.dmg/Math.max(1,x.rounds):x.k/Math.max(1,x.d);const va=f(a),vb=f(b);if(va==null||vb==null)return '';
  const d=va-vb,cls=Math.abs(d)<(m==='kd'?0.03:m==='dmg'?2:0.5)?'fl':d>0?'up':'dn',sym=cls==='fl'?'■':d>0?'▲':'▼';
  const txt=m==='kd'?Math.abs(d).toFixed(2):m==='dmg'?Math.round(Math.abs(d)):Math.abs(d).toFixed(1)+' pts';
  return `<small class="${cls}">${sym} ${txt} <span class="ac-tr">last ${n} vs previous ${n}</span></small>`;}
function acOverview(A,H){const T=A.tot,all=anAgg(H);
  const k=(lab,val,tr,extra)=>`<div class="ac-k"><span>${lab}</span><b>${val}</b>${tr||extra||'<small class="fl">&nbsp;</small>'}</div>`;
  const acc=pct(all.hi,all.sh),hs=pct(all.hk,all.k),hh=pct(all.hh,all.hi),kd=all.k/Math.max(1,all.d),wr=pct(all.w,all.n),dpm=all.dmg/Math.max(1,all.rounds);
  let html=`<div class="ac-kpis">${k('ACCURACY',fmtP(acc),trend(H,'acc'))}${k('HEADSHOT KILLS',fmtP(hs),trend(H,'hs'))}${k('DAMAGE / MATCH',fmtN(dpm),trend(H,'dmg'),'<small class="fl">per round in Bomb Defusal</small>')}${k('K / D',kd.toFixed(2),trend(H,'kd'))}
    ${k('HEAD HITS',fmtP(hh),'',`<small class="fl">of all your hits</small>`)}${k('TOTAL DAMAGE',fmtN(T.dmg),'',`<small class="fl">${fmtN(T.taken)} taken</small>`)}${k('WIN RATE',fmtP(wr),'',`<small class="fl">${all.w} of ${all.n} matches</small>`)}${k('LONGEST KILL',T.longest?T.longest+' m':'—','',`<small class="fl">${Math.round(T.time/60)} min played</small>`)}${k('WIN STREAK',streakLv()?streakFlames(Math.min(streakLv(),3))+' '+streakLv():'0','',`<small class="fl">${save.winRun|0} wins in a row now</small>`)}${k('BEST STREAK',(save.bestStreak|0)+'','',`<small class="fl">most wins in a row: ${save.bestRun|0}</small>`)}</div>`;
  html+=`<div class="ac-sec"><h4>IMPROVEMENT OVER TIME<span class="ac-chips" id="acMet">${Object.entries(AN_MET).map(([m,v])=>`<button data-m="${m}" class="${AC.metric===m?'on':''}">${v[0].toUpperCase()}</button>`).join('')}</span></h4>
    <div class="ac-chart" id="acChart"></div></div>`;
  html+=`<div class="ac-sec"><h4>INSIGHTS</h4><div class="ac-ins">${acInsights(A,H).map(t=>`<div>${t}</div>`).join('')}</div></div>`;
  html+=`<div class="ac-note">Practice range matches are left out of these numbers. Accuracy counts bullets that hit an enemy; headshot % is the share of your kills that were headshots. Damage per match counts real damage dealt (armor and overkill removed).</div>`;
  return html;}
function acInsights(A,H){const out=[];const n=Math.min(10,Math.floor(H.length/2));
  const ws=Object.entries(A.w).filter(([id,w])=>w.s>=30&&!(WEAPONS[id]&&WEAPONS[id].melee));
  if(ws.length){const best=ws.slice().sort((a,b)=>b[1].k/Math.max(1,b[1].m)-a[1].k/Math.max(1,a[1].m))[0];out.push(`Your best weapon is the <b>${esc(wName(best[0]))}</b>: ${best[1].k} kills, ${fmtP(pct(best[1].h,best[1].s))} accuracy.`);
    const acc=ws.filter(w=>w[1].s>=60).sort((a,b)=>pct(b[1].h,b[1].s)-pct(a[1].h,a[1].s));if(acc.length>1){const lo=acc[acc.length-1];out.push(`Lowest accuracy: <b>${esc(wName(lo[0]))}</b> at ${fmtP(pct(lo[1].h,lo[1].s))}. Fire in short bursts and stop moving before you shoot.`);}}
  if(n>=2){const a=anAgg(H.slice(-n)),b=anAgg(H.slice(-2*n,-n));const da=pct(a.hi,a.sh)-pct(b.hi,b.sh);if(isFinite(da))out.push(da>=0?`Accuracy is <b>up ${da.toFixed(1)} points</b> over your last ${n} matches. Keep it up.`:`Accuracy is <b>down ${Math.abs(da).toFixed(1)} points</b> over your last ${n} matches. Try crouching on long shots.`);}
  const all=anAgg(H);const hh=pct(all.hh,all.hi);if(hh!=null)out.push(hh<20?`Only <b>${fmtP(hh)}</b> of your hits land on the head. Keep your crosshair at head height while you move.`:`<b>${fmtP(hh)}</b> of your hits are headshots. Great crosshair placement.`);
  const T=A.tot;if(T.taken&&T.dmg)out.push(`You deal <b>${(T.dmg/T.taken).toFixed(2)}×</b> the damage you take.`+(T.dmg<T.taken?' Use cover and peek less often.':''));
  return out.slice(0,4).length?out.slice(0,4):['Play a few more matches to unlock insights.'];}
function acChartHook(H){const box=$('acChart');if(!box)return;const m=AC.metric,[label,,fmt]=AN_MET[m];const L=H.slice(-30);
  const pts=L.map((r,i)=>({i,v:anMetric(m,r),r})).filter(p=>p.v!=null&&isFinite(p.v));
  if(pts.length<2){box.innerHTML=`<div class="ac-empty" style="padding:30px">Play ${2-pts.length} more match${pts.length?'':'es'} to see your ${label.toLowerCase()} trend.</div>`;return;}
  const Wd=box.clientWidth-16||800,Hd=parseInt(getComputedStyle(box).getPropertyValue('--h'))||220,pl=44,pr=14,pt=14,pb=26;
  const vals=pts.map(p=>p.v);let lo=Math.min(...vals),hi=Math.max(...vals);if(m==='acc'||m==='hs'){lo=0;hi=Math.max(10,Math.ceil(hi/10)*10);}else{lo=0;hi=hi*1.15||1;}
  const X=i=>pl+(L.length<=1?0:i/(L.length-1))*(Wd-pl-pr),Y=v=>pt+(1-(v-lo)/(hi-lo||1))*(Hd-pt-pb);
  // rolling average (5)
  const avg=pts.map((p,k)=>{const s=pts.slice(Math.max(0,k-4),k+1);return {i:p.i,v:s.reduce((a,b)=>a+b.v,0)/s.length};});
  let g='';for(let t=0;t<=4;t++){const v=lo+(hi-lo)*t/4,y=Y(v);g+=`<line x1="${pl}" x2="${Wd-pr}" y1="${y}" y2="${y}" stroke="rgba(255,255,255,${t?0.07:0.18})"/><text x="${pl-6}" y="${y+3.5}" fill="#8f877b" font-size="10" text-anchor="end">${m==='kd'?v.toFixed(1):Math.round(v)+(m==='acc'||m==='hs'?'%':'')}</text>`;}
  g+=`<text x="${pl}" y="${Hd-6}" fill="#8f877b" font-size="10">${L.length} matches ago</text><text x="${Wd-pr}" y="${Hd-6}" fill="#8f877b" font-size="10" text-anchor="end">latest</text>`;
  const path=a=>a.map((p,k)=>(k?'L':'M')+X(p.i).toFixed(1)+','+Y(p.v).toFixed(1)).join('');
  const area=path(avg)+`L${X(avg[avg.length-1].i)},${Y(lo)}L${X(avg[0].i)},${Y(lo)}Z`;
  const dots=pts.map(p=>`<circle cx="${X(p.i)}" cy="${Y(p.v)}" r="4" fill="${p.r.win?'#ffd08a':'#14161c'}" stroke="#f2a33a" stroke-width="2"/>`).join('');
  box.innerHTML=`<svg viewBox="0 0 ${Wd} ${Hd}" preserveAspectRatio="none" style="height:${Hd}px"><defs><linearGradient id="acG" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f2a33a" stop-opacity=".28"/><stop offset="1" stop-color="#f2a33a" stop-opacity="0"/></linearGradient></defs>${g}
    <path d="${area}" fill="url(#acG)"/><path d="${path(pts)}" fill="none" stroke="rgba(242,163,58,.45)" stroke-width="1.5" stroke-dasharray="3 3"/><path d="${path(avg)}" fill="none" stroke="#f2a33a" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>${dots}
    <line id="acX" x1="0" x2="0" y1="${pt}" y2="${Hd-pb}" stroke="rgba(255,255,255,.35)" stroke-width="1" style="display:none"/><rect x="${pl}" y="0" width="${Wd-pl-pr}" height="${Hd}" fill="transparent" id="acHit"/></svg>
    <div class="ac-leg"><span><i style="background:#f2a33a"></i>5-match average</span><span><i style="background:rgba(242,163,58,.5)"></i>each match</span><span><i style="background:#ffd08a;width:8px;height:8px;border-radius:50%"></i>win</span></div><div class="ac-tip" id="acTip"></div>`;
  const hit=$('acHit'),tip=$('acTip'),xl=$('acX'),svg=box.querySelector('svg');
  const show=ev=>{const rc=svg.getBoundingClientRect(),sx=(ev.clientX-rc.left)/rc.width*Wd;let best=pts[0];for(const p of pts)if(Math.abs(X(p.i)-sx)<Math.abs(X(best.i)-sx))best=p;
    const r=best.r,d=new Date(r.t);xl.setAttribute('x1',X(best.i));xl.setAttribute('x2',X(best.i));xl.style.display='';
    tip.innerHTML=`<b>${fmt(best.v)}</b> ${label.toLowerCase()} · <span class="ac-res ${r.win?'w':'l'}">${r.win?'WIN':'LOSS'}</span><br>${esc(acModeName(r))} · ${r.k}/${r.d} K/D · ${d.toLocaleDateString(undefined,{day:'numeric',month:'short'})}`;
    tip.style.display='block';tip.style.left=(X(best.i)/Wd*rc.width+8)+'px';tip.style.top=(Y(best.v)/Hd*rc.height+8)+'px';};
  hit.addEventListener('mousemove',show);hit.addEventListener('touchstart',e=>show(e.touches[0]),{passive:true});hit.addEventListener('mouseleave',()=>{tip.style.display='none';xl.style.display='none';});}
function acModeName(r){if(r.mode==='duel')return '1v1 Duel';if(r.fmt)return r.fmt+' Team Deathmatch';return (MODES[r.mode]||{name:r.mode}).name;}
function acWeapons(A){const rows=Object.entries(A.w).filter(([id,w])=>w.s>0||w.k>0||w.dmg>0);if(!rows.length)return '<div class="ac-empty"><b>No weapon stats yet</b>Shoot something!</div>';
  const val={k:w=>w.k,acc:w=>pct(w.h,w.s)??-1,hs:w=>pct(w.hk,w.k)??-1,dmg:w=>w.dmg,dph:w=>w.h?w.dmg/w.h:0,s:w=>w.s,m:w=>w.m};
  rows.sort((a,b)=>val[AC.wsort](b[1])-val[AC.wsort](a[1]));const maxK=Math.max(1,...rows.map(r=>r[1].k));
  const best=rows.filter(r=>r[1].s>=30).sort((a,b)=>b[1].k-a[1].k)[0];
  const th=(k,l,c)=>`<th data-s="${k}" class="${AC.wsort===k?'on':''} ${c||''}">${l}${AC.wsort===k?' ▾':''}</th>`;
  return `<table class="ac-wt"><thead><tr>${th('k','WEAPON')}${th('k','KILLS')}${th('acc','ACCURACY')}${th('hs','HS KILLS')}${th('dmg','DAMAGE')}${th('dph','DMG / HIT','opt')}${th('s','SHOTS','opt')}${th('m','MATCHES','opt')}</tr></thead><tbody>`+
    rows.map(([id,w])=>{const ic=wIcon(id);return `<tr><td><div class="ac-wn">${ic?`<img src="${ic}" alt="">`:''}<b>${esc(wName(id))}</b>${best&&best[0]===id?'<span class="ac-best">BEST</span>':''}</div></td><td><span class="ac-bar" style="width:${Math.round(w.k/maxK*60)}px"></span>${w.k}</td><td>${w.s?fmtP(pct(w.h,w.s)):'—'}</td><td>${fmtP(pct(w.hk,w.k))}</td><td>${fmtN(w.dmg)}</td><td class="opt">${w.h?Math.round(w.dmg/w.h):'—'}</td><td class="opt">${fmtN(w.s)}</td><td class="opt">${w.m}</td></tr>`;}).join('')+`</tbody></table><div class="ac-note">Tap a column to sort. Knife accuracy isn't counted; grenade and fire damage count toward damage and kills.</div>`;}
function acHistory(A){const L=A.hist.slice().reverse().slice(0,40);
  return `<table class="ac-wt"><thead><tr><th>MATCH</th><th>RESULT</th><th>K / D</th><th>ACCURACY</th><th>HS KILLS</th><th>DAMAGE</th><th class="opt">TOP WEAPON</th><th class="opt">WHEN</th></tr></thead><tbody>`+
    L.map(r=>{const tw=Object.entries(r.w||{}).sort((a,b)=>b[1].k-a[1].k||b[1].dmg-a[1].dmg)[0];const d=new Date(r.t);const map=MAPS[r.map]?MAPS[r.map].n:'';
      const res=r.mode==='practice'?'<span class="ac-res" style="color:#a99f90">RANGE</span>':r.mode==='br'&&r.rank?`<span class="ac-res ${r.win?'w':'l'}">#${r.rank}</span>`:`<span class="ac-res ${r.win?'w':'l'}">${r.win?'WIN':'LOSS'}</span>`;
      return `<tr><td><div style="line-height:1.25"><b style="color:#fff">${esc(acModeName(r))}</b>${r.net?' <span style="color:#7dd87d;font-size:10px">ONLINE</span>':''}<br><small style="color:#8f877b">${esc(map)}</small></div></td><td>${res}</td><td>${r.k} / ${r.d}</td><td>${fmtP(pct(r.hi,r.sh))}</td><td>${fmtP(pct(r.hk,r.k))}</td><td>${fmtN(r.dmg)}</td><td class="opt">${tw?esc(wName(tw[0])):'—'}</td><td class="opt">${d.toLocaleDateString(undefined,{day:'numeric',month:'short'})} ${d.toLocaleTimeString(undefined,{hour:'2-digit',minute:'2-digit'})}</td></tr>`;}).join('')+'</tbody></table>';}
$('bAcct').onclick=openAccount;$('acClose').onclick=closeAccount;$('acct').addEventListener('click',e=>{if(e.target.id==='acct')closeAccount();});
$('acTabs').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;AC.tab=b.dataset.t;sfx('click');acRender();});
$('acBody').addEventListener('click',e=>{const m=e.target.closest('#acMet button');if(m){AC.metric=m.dataset.m;sfx('click');acRender();return;}const th=e.target.closest('th[data-s]');if(th){AC.wsort=th.dataset.s;sfx('click');acRender();}});
addEventListener('keydown',e=>{if(e.code==='Escape'&&!$('acct').classList.contains('hidden'))closeAccount();});
/* ===== Versus picker: 1v1, 1v2, 1v3, 2v2, 3v3, 4v4, 5v5 ===== */
const VS_FMTS=['1v1','1v2','1v3','2v2','3v3','4v4','5v5'];
/* small formats (1v1, 1v2, 2v2 and the FFA duel) fight on a compact arena instead of the full 100 m map */
function smallArenaH(){if(S.duel)return 20;const F=S.fmt;if(!F||S.mode!=='tdm')return 0;const big=Math.max(F[0],F[1]);if(big>2)return 0;const tot=F[0]+F[1];return tot<=2?20:tot===3?23:26;}
function fmtParse(f){const m=/^([1-5])v([1-5])$/.exec(String(f||''));return m?[+m[1],+m[2]]:null;}
function fmtGoal(F){return F?Math.min(40,Math.max(10,5*(F[0]+F[1]))):40;}
function fmtMode(f){return f==='1v1'?'duel':'tdm';}
const VP={friend:null};
function vpRender(){const cur=VS_FMTS.includes(save.vsFmt)?save.vsFmt:'1v1',F=fmtParse(cur),fr=VP.friend;
  const dots=n=>Array.from({length:n},()=>'<i></i>').join('');
  $('vpGrid').innerHTML=VS_FMTS.map(f=>{const[a,b]=fmtParse(f);const tag=a<b?'UNDERDOG':a===1?'DUEL':a===b&&a>=4?'SQUADS':'TEAMS';
    return `<button class="vp-f${f===cur?' on':''}" data-f="${f}"><b>${f}</b><div class="vp-dots"><span class="a">${dots(a)}</span><em>VS</em><span class="b">${dots(b)}</span></div><small>${tag}</small></button>`;}).join('');
  const goal=cur==='1v1'?10:fmtGoal(F),allies=F[0]-1;
  $('vpInfo').innerHTML=`<b>${cur.toUpperCase()}</b> · ${cur==='1v1'?'Duel, respawns, first to 10 kills.':`Team Deathmatch, respawns, first team to ${goal} kills.`}<br>`+
    (fr?`You challenge <b>${esc(fr.name)}</b>. They'll be on the other side${F[1]>1?`, with ${F[1]-1} bot${F[1]>2?'s':''}`:''}${allies?` and you get ${allies} bot teammate${allies>1?'s':''}`:''}. You can move players between sides in the lobby, and more friends can join.`
      :`You${allies?` + ${allies} teammate${allies>1?'s':''}`:''} vs ${F[1]} opponent${F[1]>1?'s':''}${F[0]<F[1]?' — you are outnumbered':''}. With bots, every other slot is a bot; with friends, they take slots and bots fill the rest.`);
  $('vpTitle').textContent=fr?'CHALLENGE '+String(fr.name).toUpperCase():'VERSUS';
  $('vpBots').classList.toggle('hidden',!!fr);$('vpFriends').textContent=fr?'⚔ Send challenge':'👥 Host & invite friends';}
function openVsPick(friend){VP.friend=friend||null;vpRender();$('vsPick').classList.remove('hidden');sfx('click');}
function closeVsPick(){$('vsPick').classList.add('hidden');VP.friend=null;}
$('vpGrid').addEventListener('click',e=>{const b=e.target.closest('[data-f]');if(!b)return;save.vsFmt=b.dataset.f;persist();vpRender();sfx('click');});
$('vpClose').onclick=closeVsPick;$('vsPick').addEventListener('click',e=>{if(e.target.id==='vsPick')closeVsPick();});
$('vpBots').onclick=()=>{const f=save.vsFmt||'1v1';save.lastMode='duel';persist();closeVsPick();initAudio();if(gangPlay(fmtMode(f),f))return;versusStart(f);};
$('vpFriends').onclick=()=>{const f=save.vsFmt||'1v1',fr=VP.friend;closeVsPick();initAudio();
  save.lastMode='duel';persist();if(fr){if(NET.role)netLeave(true);frInvite(fr,fmtMode(f),f);}else if(!gangPlay(fmtMode(f),f)){hostRoom(fmtMode(f),f);}};
function homeDeck(){}
$('rkClose').onclick=()=>$('rkPick').classList.add('hidden');
$('rkCards').addEventListener('click',e=>{const b=e.target.closest('button[data-rk]');if(!b)return;rankedStart(b.dataset.rk,b.dataset.v);});
$('modes').addEventListener('click',e=>{const b=e.target.closest('.mode');if(!b)return;if(b.dataset.m==='ranked'){openRanked();return;}save.lastMode=b.dataset.m;persist();if(b.dataset.m==='duel'){openVsPick();return;}if(gangPlay(b.dataset.m))return;if(save.cat==='mp')hostRoom(b.dataset.m);else startMatch(b.dataset.m);});
$('catSeg').addEventListener('click',e=>{const b=e.target.closest('button');if(b){setCat(b.dataset.c);sfx('click');}});
$('nameIn').addEventListener('input',e=>{save.name=e.target.value.replace(/[<>]/g,'').slice(0,14)||'Rival';persist();$('opName').textContent=save.name.toUpperCase();});
$('codeIn').addEventListener('input',e=>{e.target.value=e.target.value.toUpperCase().replace(/[^A-Z0-9]/g,'');});
$('codeIn').addEventListener('keydown',e=>{if(e.key==='Enter')joinRoom($('codeIn').value);});
$('joinBtn').onclick=()=>joinRoom($('codeIn').value);
$('diffSeg').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;save.diff=b.dataset.d;persist();renderMenu();sfx('click');});
$('sideSeg').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;save.side=b.dataset.s;persist();renderMenu();sfx('click');});

/* ================= SETTINGS ================= */
document.querySelectorAll('.stabs button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.stabs button').forEach(x=>x.classList.toggle('on',x===b));document.querySelectorAll('.sp').forEach(sp=>sp.classList.toggle('on',sp.dataset.sp===b.dataset.tabk));sfx('click');});
function openSettings(){renderVidUI();try{$('sMusic').value=save.music==='off'?'off':'on';$('sMusVol').value=save.musicVol!=null?save.musicVol:0.5;$('vMus').textContent=Math.round((save.musicVol!=null?save.musicVol:0.5)*100)+'%';}catch(e){}try{$('sWeight').value=save.weightMode||'normal';$('sWeightNote').textContent=weightNote();}catch(e){}$('sUpd').value=save.updUrl||'';$('sTsize').value=save.touchSize||1;$('vTsize').textContent=Math.round((save.touchSize||1)*100)+'%';$('sTouch').value=save.touchMode||'auto';$('sTsens').value=save.touchSens||1;$('vTsens').textContent=(+(save.touchSens||1)).toFixed(2);$('sReload').value=save.reloadMode||'auto';$('sAim').value=save.aimAssist||'auto';$('sAnn').checked=save.announcer!==false;$('s3d').checked=save.audio3d!==false;$('sUiS').checked=save.uiSnd!==false;$('sPsens').value=save.padSens||1;$('vPsens').textContent=(+(save.padSens||1)).toFixed(2);$('sPinv').checked=!!save.padInv;$('sPdz').value=save.padDZ||0.16;$('vPdz').textContent=Math.round((save.padDZ||0.16)*100)+'%';$('sPvib').checked=save.padVib!==false;gpStatus();$('sAutoEmpty').checked=save.autoEmpty!==false;setTimeout(syncXhUI,0);$('sQual').value=save.qual||'auto';$('sFps').checked=!!save.showFps;const minor=(save.age||18)<16;$('sBlood').checked=bloodOn();$('sBlood').disabled=minor;$('sProf').textContent=save.name+(save.age?' · age '+save.age:'')+(minor?' · blood off (under 16)':'');$('sDmg').checked=!!save.dmgNums;$('sSens').value=save.sens;$('sFov').value=save.fov;$('sVol').value=save.vol;$('sXh').value=save.xh;syncSetLabels();$('settings').classList.remove('hidden');}
function syncSetLabels(){$('vSens').textContent=(+save.sens).toFixed(2);$('vFov').textContent=save.fov+'°';$('vVol').textContent=Math.round(save.vol*100)+'%';}
$('sSens').oninput=e=>{save.sens=+e.target.value;syncSetLabels();persist();};
$('sQual').onchange=e=>{save.qual=e.target.value;setQuality(save.qual==='auto'?'high':save.qual);persist();};
$('sTsize').oninput=e=>{save.touchSize=+e.target.value;$('vTsize').textContent=Math.round(save.touchSize*100)+'%';persist();};
$('sTouch').onchange=e=>{save.touchMode=e.target.value;persist();};$('sTsens').oninput=e=>{save.touchSens=+e.target.value;$('vTsens').textContent=save.touchSens.toFixed(2);persist();};
$('sReload').onchange=e=>{save.reloadMode=e.target.value;persist();};$('sWeight').onchange=e=>{save.weightMode=e.target.value;persist();$('sWeightNote').textContent=weightNote();sfx('click');};$('sAim').onchange=e=>{save.aimAssist=e.target.value;persist();};$('sAnn').onchange=e=>{save.announcer=e.target.checked;persist();if(e.target.checked)announce('Announcer on');};$('s3d').onchange=e=>{save.audio3d=e.target.checked;persist();};$('sUiS').onchange=e=>{save.uiSnd=e.target.checked;persist();};$('sPsens').oninput=e=>{save.padSens=+e.target.value;$('vPsens').textContent=save.padSens.toFixed(2);persist();};$('sPinv').onchange=e=>{save.padInv=e.target.checked;persist();};$('sPdz').oninput=e=>{save.padDZ=+e.target.value;$('vPdz').textContent=Math.round(save.padDZ*100)+'%';persist();};
setInterval(()=>{const el=$('gpLive');if(!el||$('settings').classList.contains('hidden'))return;const L=GP.live;el.textContent=L?`Left stick ${L[0].toFixed(2)}, ${L[1].toFixed(2)}  ·  Right stick ${L[2].toFixed(2)}, ${L[3].toFixed(2)}  (should read 0.00 when you let go)`:'Press any button on the controller to test it here.';},150);$('sPvib').onchange=e=>{save.padVib=e.target.checked;persist();if(e.target.checked)gpRumble(0.6,0.6,160);};$('sAutoEmpty').onchange=e=>{save.autoEmpty=e.target.checked;persist();};
$('sFps').onchange=e=>{save.showFps=e.target.checked;persist();};
$('sFov').oninput=e=>{save.fov=+e.target.value;if(S.state==='game'){camera.fov=save.fov;camera.updateProjectionMatrix();}syncSetLabels();persist();};
$('sMusic').onchange=e=>{save.music=e.target.value;persist();try{CHM.setEnabled(save.music!=='off');}catch(err){}};
$('sMusVol').oninput=e=>{save.musicVol=+e.target.value;$('vMus').textContent=Math.round(save.musicVol*100)+'%';persist();try{CHM.setVol(save.musicVol);}catch(err){}};
$('sVol').oninput=e=>{save.vol=+e.target.value;if(master)master.gain.value=save.vol;syncSetLabels();persist();};
$('sXh').oninput=e=>{save.xh=e.target.value;document.documentElement.style.setProperty('--xh',save.xh);syncXhUI();persist();};
function applyXhStyle(){const st=save.xhStyle||'crossdot';for(const el of[$('xh'),$('xhP')]){if(!el)continue;el.className=el.className.replace(/\bst-\w+/g,'').trim()+' st-'+st;}}
function syncXhUI(){applyXhStyle();const st=save.xhStyle||'crossdot';document.querySelectorAll('#xhStyles button').forEach(b=>b.classList.toggle('on',b.dataset.st===st));document.querySelectorAll('#xhCols button').forEach(b=>b.classList.toggle('on',b.dataset.c.toLowerCase()===String(save.xh).toLowerCase()));if($('sXh'))$('sXh').value=save.xh;}
$('xhStyles').onclick=e=>{const b=e.target.closest('button');if(!b)return;save.xhStyle=b.dataset.st;syncXhUI();persist();sfx('click');};
$('xhCols').onclick=e=>{const b=e.target.closest('button');if(!b)return;save.xh=b.dataset.c;document.documentElement.style.setProperty('--xh',save.xh);syncXhUI();persist();sfx('click');};
applyXhStyle();
$('sDmg').onchange=e=>{save.dmgNums=e.target.checked;persist();};
$('sBlood').onchange=e=>{if((save.age||18)<16){e.target.checked=false;return;}save.blood=e.target.checked;persist();};
$('sEditProf').onclick=()=>{$('settings').classList.add('hidden');showSetup();};
$('setClose').onclick=()=>$('settings').classList.add('hidden');
/* =====================================================================
   META GAME: items, rarities, paints, agents, medals, icons,
   Inventory / Loadout / Store screens, cases and the weekly care package
   ===================================================================== */
const RAR=[{n:'Common',c:'#b0c3d9'},{n:'Uncommon',c:'#5e98d9'},{n:'Rare',c:'#4b69ff'},{n:'Epic',c:'#8847ff'},{n:'Legendary',c:'#d32ce6'},{n:'Mythic',c:'#eb4b4b'},{n:'Exotic',c:'#e4ae39'}];
const RAR_PRICE=[150,300,600,1200,2500,5000,8000];
const PAINTS={sand:{n:'Sand Dune',c:0xc9b07a,r:0},arctic:{n:'Arctic',c:0xdfe7ec,r:0},jungle:{n:'Jungle',c:0x4a6b2f,r:0},urban:{n:'Urban Gray',c:0x6f7377,r:0},
  cobalt:{n:'Cobalt',c:0x2a5bd7,r:2},crimson:{n:'Crimson',c:0xa3262a,r:2},neon:{n:'Neon Rush',c:0x19e3c8,r:2},gold:{n:'24K Gold',c:0xd8b03a,r:5}};
const FIN_R={sand_viper:4,forest_ddpat:0,safari_mesh:0,boreal_forest:0,scorched:0,rust_coat:0,urban_masked:0,night:1,blue_steel:1,flip_knife_pattern:1,black_laminate:1,freehand:1,bright_water:1,damascus_steel:1,vanilla:1,ultraviolet:2,blood_web:2,tiger_tooth_blue:2,case_hardened:3,crimson_web:3,lore:3,autotronic:3,slaughter:3,tiger_tooth:4,doppler:4,fade:4,emerald:4,marble_fade:5,gamma_doppler:5,ruby:5,sapphire:5};
for(const k in FINS)if(k!=='vanilla')PAINTS[k]={n:FINS[k].n,fin:k,r:FIN_R[k]!==undefined?FIN_R[k]:2};
const AGENTS={operator:{n:'Operator',r:0,price:0,pal:{}},
  viper:{n:'Sand Viper',r:2,price:1100,pal:{camo:0xb39a6b,camo2:0x8f7a52,vest:0x6b5a3a,scarf:0xb83a2a,helm:0x8a7650,mask:0xd8c49a,lens:0x1c1e21}},
  ghost:{n:'Jungle Ghost',r:2,price:1100,pal:{camo:0x3f5a2a,camo2:0x2c401c,vest:0x4a5f2c,scarf:0x7a8a3a,helm:0x34481f,mask:0x5a6b3a,lens:0xc8ff4a}},
  owl:{n:'Night Owl',r:3,price:1700,pal:{camo:0x24262c,camo2:0x1a1c21,vest:0x2f3440,scarf:0x3b4a6b,helm:0x1f2229,mask:0x2a2d33,lens:0x2ad0ff}},
  fox:{n:'Arctic Fox',r:3,price:1700,pal:{camo:0xd9dde0,camo2:0xaeb4b9,vest:0x8d949a,scarf:0x6aa6d8,helm:0xe8eaec,mask:0xf0f0f0,lens:0x4a90d9}},
  fang:{n:'Crimson Fang',r:4,price:2800,pal:{camo:0x3a2224,camo2:0x2a1618,vest:0x4a2a2c,scarf:0xd8242a,helm:0x2a1a1c,mask:0x1c1214,lens:0xff3030}},
  gold:{n:'Gold Standard',r:5,price:5200,pal:{camo:0x1c1c1e,camo2:0x141416,vest:0x2a2a2c,scarf:0xd8b03a,helm:0xd8b03a,mask:0x111111,lens:0xffd24a}}};
function agentPal(id){return(AGENTS[id]||AGENTS.operator).pal;}
const MEDAL_TIER=['#b08d57','#c0c6cc','#e4ae39','#5fd4ff','#ff6b5f'];
const MEDAL_DEFS=[
  ...[10,25,50,75,100,150,200,300,400,500].map((l,i)=>({id:'svc'+l,n:'Service Medal · Lv '+l,d:'Reach level '+l,ok:()=>save.level>=l,r:Math.min(6,Math.floor(i/1.6)),tier:Math.min(4,Math.floor(i/2)),lv:l})),
  {id:'win1',n:'First Victory Coin',d:'Win a match',ok:()=>save.wins>=1,r:1,tier:0,icon:'★'},
  {id:'vet',n:'Veteran Coin',d:'Play 25 matches',ok:()=>save.matches>=25,r:2,tier:1,icon:'✦'},
  {id:'k100',n:'Centurion Coin',d:'Get 100 kills',ok:()=>save.kills>=100,r:2,tier:1,icon:'✚'},
  {id:'k500',n:'Marksman Coin',d:'Get 500 kills',ok:()=>save.kills>=500,r:4,tier:3,icon:'◎'},
  {id:'range',n:'Range Master Coin',d:'Score 3000 in Target Practice',ok:()=>save.bestPractice>=3000,r:3,tier:2,icon:'◉'},
  {id:'rival',n:'Combat Horizens Coin',d:'Reach level 100',ok:()=>save.level>=100,r:6,tier:2,icon:'♛'}];
const MEDAL_BY={};MEDAL_DEFS.forEach(m=>{const o=m.ok;m.ok=()=>!!save.allMedals||o();MEDAL_BY[m.id]=m;});
function medalSvg(m,size=96){const c=MEDAL_TIER[m.tier||0];
  if(m.lv)return `<svg width="${size}" height="${size}" viewBox="0 0 100 100"><path d="M30 4 L46 4 L56 40 L40 44 Z" fill="#c23a3a"/><path d="M70 4 L54 4 L44 40 L60 44 Z" fill="#2f5fb5"/><circle cx="50" cy="64" r="28" fill="${c}" stroke="rgba(0,0,0,.35)" stroke-width="3"/><circle cx="50" cy="64" r="21" fill="none" stroke="rgba(0,0,0,.25)" stroke-width="2"/><text x="50" y="72" text-anchor="middle" font-family="Arial" font-weight="900" font-size="${m.lv>=100?20:24}" fill="#1a1206">${m.lv}</text></svg>`;
  return `<svg width="${size}" height="${size}" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="${c}" stroke="rgba(0,0,0,.4)" stroke-width="4"/><circle cx="50" cy="50" r="31" fill="none" stroke="rgba(0,0,0,.3)" stroke-width="2" stroke-dasharray="4 3"/><text x="50" y="63" text-anchor="middle" font-family="Arial" font-size="36" fill="#1a1206">${m.icon||'★'}</text></svg>`;}
/* ---------- items ---------- */
function newUid(){save.uidSeq=(save.uidSeq||0)+1;return 'i'+save.uidSeq+'_'+Date.now().toString(36);}
function addItem(it){it.uid=newUid();it.t=Date.now();save.items.push(it);persist();return it;}
function itemByUid(uid){return save.items.find(i=>i.uid===uid);}
function equippedPaint(wid){const it=itemByUid(save.equipSkin[wid]);return it?it.p:null;}
const _paintMat={};
function paintMat(pid){const p=PAINTS[pid];if(!p)return null;if(_paintMat[pid])return _paintMat[pid];
  const m=p.fin?new THREE.MeshPhongMaterial({map:finTex(p.fin),shininess:70,specular:0x555555}):new THREE.MeshPhongMaterial({color:p.c,shininess:pid==='gold'?110:45,specular:pid==='gold'?0xffe9a0:0x333333});return _paintMat[pid]=m;}
function allItems(){const out=save.items.filter(i=>(i.k!=='ktn'||KTN[i.s])&&(i.k!=='skin'||(WEAPONS[i.w]&&PAINTS[i.p]))&&(i.k!=='fin'||FINS[i.f])&&(i.k!=='agent'||AGENTS[i.a])&&(i.k!=='kskin'||(window.CR_HZ&&window.CR_HZ.kv[i.v])));
  KNIVES.forEach(([id,name,lvl])=>{if(save.level>=lvl||save.allKnives)out.push({uid:'k_'+id,k:'knife',w:id,t:lvl});});
  out.push({uid:'a_operator',k:'agent',a:'operator',t:0});
  MEDAL_DEFS.filter(m=>m.ok()).forEach(m=>out.push({uid:'m_'+m.id,k:'medal',m:m.id,t:0}));
  return out;}
function info(it){switch(it.k){
  case 'skin':{const p=PAINTS[it.p];return{top:WEAPONS[it.w].name,bot:p.n+(it.starter?' · Starter':'')+(it.limited?' · Limited':''),r:p.r,img:()=>weaponIcon(it.w,it.p),eq:save.equipSkin[it.w]===it.uid,type:'weapon',price:it.starter?0:RAR_PRICE[p.r]};}
  case 'knife':{const eq=knifeId()===it.w;const f=eq&&FINS[save.knifeFin]?save.knifeFin:'';return{top:'★ '+WEAPONS[it.w].name,bot:f?FINS[f].n:'Vanilla',r:6,img:()=>knifeIcon(it.w,f),eq,type:'knife'};}
  case 'kskin':{const v=HZ.kv[it.v];return{top:'★ '+WEAPONS[v.w].name,bot:v.n,r:6,img:()=>realIcon(v.w,null,it.v)||knifeIcon(v.w,''),eq:save.kskin===it.v&&knifeId()===v.w,type:'knife',price:KSKIN_PRICE[it.v]||4000};}
  case 'fin':return{top:'★ Blade Finish',bot:FINS[it.f].n,r:6,img:()=>knifeIcon(knifeId(),it.f),eq:save.knifeFin===it.f,type:'knife',price:FINS[it.f].p};
  case 'agent':{const a=AGENTS[it.a];return{top:a.n,bot:'Agent',r:a.r,img:()=>agentIcon(it.a),eq:(save.agent||'operator')===it.a,type:'agent',price:a.price};}
  case 'ktn':{const K=KTN[it.s];if(!K)return{top:'?',bot:'',r:0,svg:'',eq:false,type:'knife'};return{top:'★ Katana',bot:K.n+' · works with Dual Katanas',r:({wooden:1,iron:2,sun:6})[it.s]||1,img:()=>katanaIcon(it.s),eq:save.knife==='katana'&&ktnSkin()===it.s,type:'knife',price:K.p};}
  case 'nade':{const w=WEAPONS[it.n];if(!w)return{top:'?',bot:'',r:0,svg:'',eq:false,type:'weapon'};const t=window.CR_NADEPK&&CR_NADEPK.tex[{he:'hegrenade',smoke:'smokegrenade',flashbang:'flashbang',decoy:'decoy',molotov:'molotov',incendiary:'incendiary'}[it.n]];
    return{top:w.name,bot:'Stock · Starter',r:0,svg:t?`<img src="${t}" style="image-rendering:pixelated;width:46%;height:auto;margin:auto;display:block">`:'',eq:!(save.nadeOff||{})[it.n],type:'weapon'};}
  case 'medal':{const m=MEDAL_BY[it.m];return{top:m.n,bot:m.d,r:m.r,svg:medalSvg(m),eq:save.medal===it.m,type:'medal'};}}}
/* ---------- icon renderer: real renders of the in-game 3D models ---------- */
let ICON=false,iconR=null,iconScene=null,iconCam=null,iconModels=null,iconM=null,iconSkin=null;const iconCache={};
function iconSetup(){iconR=new THREE.WebGLRenderer({alpha:true,antialias:true,preserveDrawingBuffer:true});iconR.setPixelRatio(1);
  iconScene=new THREE.Scene();iconScene.add(new THREE.HemisphereLight(0xffffff,0x60584a,1.05));const dl=new THREE.DirectionalLight(0xffffff,0.85);dl.position.set(-3,4,2);iconScene.add(dl);const dl2=new THREE.DirectionalLight(0xffe0b0,0.35);dl2.position.set(3,-1,-2);iconScene.add(dl2);
  iconCam=new THREE.OrthographicCamera(-1,1,1,-1,0.01,40);}
function getIconModels(){if(iconModels)return iconModels;ICON=true;buildVM();iconModels=Object.assign({},vm.models);iconM=vm.M;iconSkin=vm.skinMat;
  for(const k in iconModels){vmRoot.remove(iconModels[k]);iconModels[k].visible=true;iconModels[k].position.set(0,0,0);iconModels[k].rotation.set(0,0,0);}
  for(const k in vm.flash)vm.flash[k].visible=false;ICON=false;buildVM();return iconModels;}
function snap(obj,w,h,view){if(!iconR)iconSetup();iconR.setSize(w,h);iconScene.add(obj);obj.updateMatrixWorld(true);
  const box=new THREE.Box3();obj.traverse(o=>{if(o.isMesh&&o.visible&&o.material&&o.material.visible!==false&&!(o.parent&&o.parent.visible===false)){o.geometry.computeBoundingBox();box.union(o.geometry.boundingBox.clone().applyMatrix4(o.matrixWorld));}});
  const c=box.getCenter(new V3()),sz=box.getSize(new V3()),asp=w/h;
  if(view==='front'){iconCam.position.set(c.x,c.y+0.02,c.z+6);const L=Math.max(sz.x/asp,sz.y)*0.56;iconCam.top=L;iconCam.bottom=-L;iconCam.left=-L*asp;iconCam.right=L*asp;}
  else{iconCam.position.set(c.x-6,c.y,c.z);const L=Math.max(sz.z/asp,sz.y)*0.58;iconCam.top=L;iconCam.bottom=-L;iconCam.left=-L*asp;iconCam.right=L*asp;}
  iconCam.lookAt(c);iconCam.updateProjectionMatrix();iconR.setClearColor(0x000000,0);iconR.clear();iconR.render(iconScene,iconCam);const url=iconR.domElement.toDataURL('image/png');iconScene.remove(obj);return url;}
/* ---------- Kevlar vest: shaped front/back panels, shoulder straps, cummerbund, MOLLE webbing, pouches, name tape ---------- */
const VEST={};
function vestMats(){if(VEST.m)return VEST.m;
  const fab=canvasTex(128,(c,w,h)=>{c.fillStyle='#56616f';c.fillRect(0,0,w,h);const id=c.getImageData(0,0,w,h),d=id.data;
    for(let y=0;y<h;y++)for(let x=0;x<w;x++){const k=(y*w+x)*4;const weave=((x>>1)+(y>>1))%2?7:-7;const n=(Math.random()-0.5)*16+weave;d[k]+=n;d[k+1]+=n;d[k+2]+=n;}c.putImageData(id,0,0);
    c.strokeStyle='rgba(20,24,30,.55)';c.lineWidth=1;c.setLineDash([3,2]);for(const o of[3,w-4]){c.beginPath();c.moveTo(o,0);c.lineTo(o,h);c.stroke();c.beginPath();c.moveTo(0,o);c.lineTo(w,o);c.stroke();}},128);
  fab.wrapS=fab.wrapT=THREE.RepeatWrapping;
  const web=canvasTex(64,(c,w,h)=>{c.fillStyle='#1b1e22';c.fillRect(0,0,w,h);c.strokeStyle='rgba(255,255,255,.07)';for(let y=1;y<h;y+=3){c.beginPath();c.moveTo(0,y);c.lineTo(w,y);c.stroke();}},64);web.wrapS=web.wrapT=THREE.RepeatWrapping;
  const tape=canvasTex(128,(c,w,h)=>{c.fillStyle='#16191d';c.fillRect(0,0,w,h);c.strokeStyle='#5c6470';c.lineWidth=3;c.strokeRect(3,3,w-6,h-6);c.fillStyle='#d9dde2';c.font='bold 30px Arial';c.textAlign='center';c.textBaseline='middle';c.fillText('KEVLAR',w/2,h/2+1);},40);
  tape.repeat.set(1,1);
  return VEST.m={fab:new THREE.MeshLambertMaterial({map:fab}),fab2:new THREE.MeshLambertMaterial({map:fab,color:0xc4ccd6}),web:new THREE.MeshLambertMaterial({map:web}),
    tape:new THREE.MeshLambertMaterial({map:tape}),buckle:new THREE.MeshPhongMaterial({color:0x2a2c2f,shininess:40}),metal:new THREE.MeshPhongMaterial({color:0x8d939b,shininess:80}),
    velcro:new THREE.MeshLambertMaterial({color:0x2c323a})};}
/* vest outline (front view, x right, y up), scooped neck and armholes */
function vestShape(neck){const s=new THREE.Shape();const W=0.22,H=0.52;
  s.moveTo(-W,0);s.lineTo(W,0);s.lineTo(W,0.33);s.quadraticCurveTo(0.15,0.36,0.145,0.46);s.lineTo(0.145,H);s.lineTo(0.075,H);
  s.quadraticCurveTo(0.06,H-neck,0,H-neck);s.quadraticCurveTo(-0.06,H-neck,-0.075,H);s.lineTo(-0.145,H);s.lineTo(-0.145,0.46);s.quadraticCurveTo(-0.15,0.36,-W,0.33);s.lineTo(-W,0);return s;}
/* extrude, subdivide, then bend round the torso (smooth analytic normals, so the panel wraps instead of being a flat board) */
function vestTess(g,maxE){g=g.index?g.toNonIndexed():g;let P=Array.from(g.attributes.position.array),N=Array.from(g.attributes.normal.array),U=Array.from(g.attributes.uv.array);
  for(let pass=0;pass<6;pass++){const P2=[],N2=[],U2=[];let split=false;
    for(let t=0;t<P.length/9;t++){const v=[0,1,2].map(k=>({p:P.slice(t*9+k*3,t*9+k*3+3),n:N.slice(t*9+k*3,t*9+k*3+3),u:U.slice(t*6+k*2,t*6+k*2+2)}));
      const d=(a,b)=>Math.hypot(a.p[0]-b.p[0],a.p[1]-b.p[1],a.p[2]-b.p[2]);const e=[d(v[0],v[1]),d(v[1],v[2]),d(v[2],v[0])];const m=e.indexOf(Math.max(...e));
      const push=(...vs)=>{for(const x of vs){P2.push(...x.p);N2.push(...x.n);U2.push(...x.u);}};
      if(e[m]>maxE){split=true;const a=v[m],b=v[(m+1)%3],c=v[(m+2)%3];const mid={p:a.p.map((x,i)=>(x+b.p[i])/2),n:a.n.map((x,i)=>(x+b.n[i])/2),u:a.u.map((x,i)=>(x+b.u[i])/2)};push(a,mid,c,mid,b,c);}else push(...v);}
    P=P2;N=N2;U=U2;if(!split)break;}
  const o=new THREE.BufferGeometry();o.setAttribute('position',new THREE.Float32BufferAttribute(P,3));o.setAttribute('normal',new THREE.Float32BufferAttribute(N,3));o.setAttribute('uv',new THREE.Float32BufferAttribute(U,2));return o;}
function vestPanel(neck,dir,K){K=K===undefined?0.9:K;let g=new THREE.ExtrudeGeometry(vestShape(neck),{depth:0.03,bevelEnabled:true,bevelThickness:0.012,bevelSize:0.012,bevelSegments:2,curveSegments:10});
  g.computeVertexNormals();g=vestTess(g,0.03);
  const P=g.attributes.position,Nn=g.attributes.normal,U=g.attributes.uv;
  for(let i=0;i<P.count;i++){const x=P.getX(i);P.setZ(i,P.getZ(i)*dir-dir*x*x*K);
    let nx=Nn.getX(i),nz=Nn.getZ(i)*dir;const a=Math.atan(2*K*x)*dir;const c=Math.cos(a),sn=Math.sin(a);Nn.setXYZ(i,nx*c+nz*sn,Nn.getY(i),-nx*sn+nz*c);
    U.setXY(i,x*4,P.getY(i)*4);}
  return g;}
function kevlarVest(o){o=o||{};const M=vestMats();const g=new THREE.Group();const BK=o.flat?0.22:0.9;
  const add=(geo,mat,x,y,z,rx=0,ry=0,rz=0)=>{const m=new THREE.Mesh(geo,mat);m.position.set(x,y,z);m.rotation.set(rx,ry,rz);m.castShadow=true;m.receiveShadow=true;g.add(m);return m;};
  const D=o.flat?0.075:0.25;// chest depth between the panels (a vest lying on the floor is flattened)
  add(vestPanel(0.11,1,BK),M.fab,0,0,0);add(vestPanel(0.05,-1,BK),M.fab,0,0,-D);
  // armour plate pocket (raised) on the front
  add(rbox(0.3,0.3,0.02,0.02),M.fab2,0,0.2,0.035);
  // MOLLE webbing rows with bar-tacks
  for(let r=0;r<4;r++){const y=0.07+r*0.05;for(let c=0;c<5;c++){const x=-0.16+c*0.08;const z=0.045-x*x*BK;add(new THREE.BoxGeometry(0.066,0.02,0.006),M.web,x,y,z,0,-x*2*BK,0);}}
  // name tape + velcro on the upper chest
  add(rbox(0.15,0.06,0.006,0.004),M.velcro,0,0.37,0.047);add(new THREE.PlaneGeometry(0.13,0.044),M.tape,0,0.37,0.051);
  // three magazine pouches with flaps and snaps across the bottom
  for(const x of[-0.1,0,0.1]){const z=0.06-x*x*BK;add(rbox(0.085,0.11,0.05,0.012),M.fab,x,0.075,z,0,-x*2*BK,0);add(rbox(0.088,0.035,0.054,0.01),M.fab2,x,0.125,z+0.002,0,-x*2*BK,0);
    add(new THREE.CylinderGeometry(0.007,0.007,0.006,10),M.metal,x,0.118,z+0.03,Math.PI/2,0,0);}
  // shoulder straps (front shoulder -> back shoulder) with pads
  for(const sx of[-1,1]){const x=sx*0.11;add(rbox(0.075,0.028,D+0.06,0.012),M.fab,x,0.53,-D/2);add(rbox(0.085,0.034,0.12,0.014),M.fab2,x,0.538,-D/2);
    for(const z of[0.004,-D-0.004])add(new THREE.BoxGeometry(0.05,0.012,0.012),M.buckle,x,0.505,z);}
  // side cummerbund (elastic sides) with buckles
  for(const sx of[-1,1]){const sxx=o.flat?0.232:0.218;add(rbox(0.03,0.3,Math.max(0.04,D-0.05),0.012),M.web,sx*sxx,0.165,-D/2);for(const y of[0.08,0.165,0.25])add(new THREE.BoxGeometry(0.033,0.012,Math.max(0.05,D-0.04)),M.fab2,sx*(sxx+0.001),y,-D/2);if(!o.flat){add(rbox(0.036,0.05,0.03,0.008),M.buckle,sx*0.224,0.165,-0.03);add(rbox(0.036,0.05,0.03,0.008),M.buckle,sx*0.224,0.165,-D+0.03);}}
  // drag handle on the back
  const dh=add(new THREE.TorusGeometry(0.035,0.008,8,16,Math.PI),M.web,0,0.46,-D-0.045,0,Math.PI,0);
  // centre on the ground plane
  const box=new THREE.Box3().setFromObject(g);const c=box.getCenter(new V3());for(const ch of g.children)ch.position.sub(new V3(c.x,box.min.y,c.z));
  return g;}
function vestIcon(){if(VEST.icon)return VEST.icon;try{const v=kevlarVest();v.rotation.set(0.12,-0.45,0);VEST.icon=snap(v,160,160,'front');}catch(e){VEST.icon='';}return VEST.icon;}
function agentIcon(id){const key='a|'+id;if(iconCache[key])return iconCache[key];const s=makeSoldier(0xb08a3e,agentPal(id));s.g.rotation.y=-0.35;const url=snap(s.g,160,240,'front');return iconCache[key]=url;}
/* ---------- item art: hand-tuned vector side profiles for every gun & knife (muzzle / tip to the left).
   The equipped finish is mapped over the body parts like a real skin; dark parts stay gunmetal. ---------- */
const SVGICON=(()=>{
  const DEF_BODY='#4a4f57',COL={D:'#1f2227',M:'#5a6068',P:'#2b2e33',W:'#7b4a26',G:'#4d5636',T:'#b8a27a',Y:'#e3b51e',X:'rgba(214,190,120,.55)',R:'#2c3a26'};
  function mk(){
    const out=[];let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;
    const ext=(x,y)=>{if(x<x0)x0=x;if(x>x1)x1=x;if(y<y0)y0=y;if(y>y1)y1=y;};
    const f=n=>+n.toFixed(1);
    const shape=(tag,mat,shade=true)=>{out.push({tag,mat,shade});};
    return{
      poly(pts,mat,holes,shade=true){pts.forEach(p=>ext(p[0],p[1]));let d='M'+pts.map(p=>f(p[0])+','+f(p[1])).join('L')+'Z';if(holes)for(const h of holes)d+='M'+h.map(p=>f(p[0])+','+f(p[1])).join('L')+'Z';shape(`<path d="${d}"${holes?' fill-rule="evenodd"':''} @/>`,mat,shade);},
      path(d,mat,bpts,shade=true){bpts.forEach(p=>ext(p[0],p[1]));shape(`<path d="${d}" @/>`,mat,shade);},
      rect(x,y,w,h,mat,rx=1,shade=true){ext(x,y);ext(x+w,y+h);shape(`<rect x="${f(x)}" y="${f(y)}" width="${f(w)}" height="${f(h)}" rx="${rx}" @/>`,mat,shade);},
      circ(cx,cy,r,mat,shade=true){ext(cx-r,cy-r);ext(cx+r,cy+r);shape(`<circle cx="${f(cx)}" cy="${f(cy)}" r="${f(r)}" @/>`,mat,shade);},
      line(pts,col,w){pts.forEach(p=>ext(p[0],p[1]));out.push({raw:`<polyline points="${pts.map(p=>f(p[0])+','+f(p[1])).join(' ')}" fill="none" stroke="${col}" stroke-width="${w}" stroke-linecap="round" stroke-linejoin="round"/>`});},
      raw(s,bx0,by0,bx1,by1){if(bx0!==undefined){ext(bx0,by0);ext(bx1,by1);}out.push({raw:s});},
      svg(fill,bladeFill,W=320,H=140){
        const pad=6,bx=x0-pad,by=y0-pad,bw=x1-x0+pad*2,bh=y1-y0+pad*2;
        let defs=`<linearGradient id="sh" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".34"/><stop offset=".42" stop-color="#fff" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".4"/></linearGradient>`+
          `<linearGradient id="st" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset=".45" stop-color="#cfd5db"/><stop offset=".55" stop-color="#9aa3ab"/><stop offset="1" stop-color="#e4e8ec"/></linearGradient>`+
          `<linearGradient id="wd" x1="0" y1="0" x2="1" y2=".3"><stop offset="0" stop-color="#8a5228"/><stop offset=".5" stop-color="#6a3c1c"/><stop offset="1" stop-color="#8f5a30"/></linearGradient>`;
        let bodyFill=DEF_BODY;
        if(fill&&fill.img){const pw=Math.min(bw,190);defs+=`<pattern id="fp" patternUnits="userSpaceOnUse" x="${bx}" y="${by}" width="${pw}" height="${bh}"><image href="${fill.img}" width="${pw}" height="${bh}" preserveAspectRatio="none"/></pattern>`;bodyFill='url(#fp)';}
        else if(fill&&fill.col)bodyFill=fill.col;
        let bf='url(#st)';
        if(bladeFill){defs+=`<pattern id="fb" patternContentUnits="objectBoundingBox" width="1" height="1"><image href="${bladeFill}" width="1" height="1" preserveAspectRatio="none"/></pattern>`;bf='url(#fb)';}
        const fillOf=m=>m==='B'?bodyFill:m==='S'?bf:m==='W'?(fill?bodyFill:'url(#wd)'):(COL[m]||m);
        const body=out.map(o=>{if(o.raw)return o.raw;const base=o.tag.replace('@',`fill="${fillOf(o.mat)}" stroke="#0c0d0f" stroke-width="1.3" stroke-linejoin="round"`);
          return o.shade?base+o.tag.replace('@','fill="url(#sh)"'):base;}).join('');
        return `<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="${f(bx)} ${f(by)} ${f(bw)} ${f(bh)}" preserveAspectRatio="xMidYMid meet"><defs>${defs}</defs>${body}</svg>`;
      }};
  }
  /* ---- long guns ---- */
  function longGun(g,o){
    const y=50;let x=0;const B=o.mat||'B';
    // muzzle
    if(o.sup){g.rect(x,y-7,o.sup,14,'P',5);g.rect(x+o.sup*0.12,y-7,2,14,'D',0,false);g.rect(x+o.sup*0.88,y-7,2,14,'D',0,false);x+=o.sup;}
    else if(o.brake){g.rect(x,y-7,18,14,'D',2);g.rect(x+5,y-7,3,14,'P',0,false);g.rect(x+11,y-7,3,14,'P',0,false);x+=18;}
    else if(o.comp){g.rect(x,y-4.5,16,9,'D',1);for(let i=0;i<4;i++)g.rect(x+2+i*3.4,y-4.5,1.6,9,'P',0,false);x+=16;}
    else {g.rect(x,y-4,9,8,'D',1);x+=9;}
    const bl=o.barrel||50;
    if(o.tube){const tl=o.tubeLen||bl*0.9;g.rect(x+bl-tl,y+3.5,tl+(o.hg||0),8,'D',2);}
    if(o.shield){g.rect(x,y-6,bl,12,'P',2);for(let i=6;i<bl-4;i+=8)g.rect(x+i,y-3.5,4,7,'D',1,false);}
    else g.rect(x,y-2.8,bl,5.6,'D',1);
    if(o.fs)g.poly([[x+bl*0.06,y-2.8],[x+bl*0.06+2,y-13],[x+bl*0.06+7,y-13],[x+bl*0.06+9,y-2.8]],'D');
    if(o.bipod){const bx=x+bl*0.55;g.line([[bx,y+3],[bx-12,y+40]],'#1f2227',3.2);g.line([[bx+4,y+3],[bx+15,y+40]],'#1f2227',3.2);g.rect(bx-15,y+38,6,4,'P',1);g.rect(bx+12,y+38,6,4,'P',1);}
    if(o.vgripT){const vx=x+bl*0.45;g.poly([[vx,y+2],[vx+14,y+2],[vx+12,y+30],[vx+2,y+30]],'W');}
    x+=bl;
    // handguard / pump
    const hg=o.hg||0;
    if(hg){const hm=o.wood?'W':(o.hgMat||B);
      if(o.pump){g.rect(x,y+1,hg,14,hm,4);for(let i=6;i<hg-4;i+=7)g.rect(x+i,y+2.5,2.2,11,'D',0.5,false);}
      else{g.poly([[x,y-8],[x+hg,y-10],[x+hg,y+10],[x,y+8]],hm);
        if(o.rail)g.rect(x+3,y-13,hg-5,3.5,'D',0.5);
        if(o.vents)for(let i=8;i<hg-6;i+=11)g.rect(x+i,y-3,6,4,'P',1,false);}
      if(o.vgrip){g.poly([[x+hg*0.4,y+9],[x+hg*0.4+12,y+9],[x+hg*0.4+10,y+34],[x+hg*0.4+2,y+34]],o.wood?'W':'P');}
    }
    x+=hg;const rx=x,rl=o.rl||74,rh=o.rh||22;
    // magazine (behind receiver so its top tucks in)
    const mx=rx+rl*(o.magAt!==undefined?o.magAt:0.14);
    if(o.mag==='straight')g.poly([[mx,y+8],[mx+17,y+8],[mx+19,y+(o.magL||44)],[mx+3,y+(o.magL||44)]],o.magMat||'P');
    else if(o.mag==='curved')g.path(`M${mx},${y+8}L${mx+19},${y+8}Q${mx+17},${y+38} ${mx+5},${y+52}L${mx-12},${y+46}Q${mx-1},${y+33} ${mx},${y+8}Z`,o.magMat||'P',[[mx-12,y+8],[mx+19,y+52]]);
    else if(o.mag==='box')g.rect(mx-8,y+6,40,o.boxH||34,o.magMat||'G',3);
    else if(o.mag==='drum'){g.rect(mx,y+6,16,10,'P',1);g.circ(mx+8,y+32,20,'P');g.circ(mx+8,y+32,6,'D',false);}
    else if(o.mag==='tube')g.rect(rx-(o.tubeBack||70),y+8,(o.tubeBack||70)+rl*0.45,15,'P',7);
    else if(o.mag==='short')g.poly([[mx,y+8],[mx+16,y+8],[mx+17,y+22],[mx+1,y+22]],'P');
    // receiver
    if(o.dust)g.path(`M${rx},${y-9}L${rx+rl},${y-9}L${rx+rl},${y+11}L${rx},${y+11}Z`,B,[[rx,y-9],[rx+rl,y+11]]);
    else g.rect(rx,y-(rh/2),rl,rh,B,2);
    if(o.dust)g.path(`M${rx+2},${y-9}Q${rx+rl*0.5},${y-17} ${rx+rl-2},${y-9}Z`,B,[[rx,y-17],[rx+rl,y-9]]);
    g.rect(rx+rl*0.32,y-5,rl*0.3,6,'D',1,false);
    if(o.rail&&!o.scope)g.rect(rx,y-rh/2-4,rl,4,'D',0.5);
    if(o.rail&&o.scope)g.rect(rx,y-rh/2-3,rl,3,'D',0.5);
    if(o.handle){const hl=o.handleL||rl*0.8,hs=rx+(rl-hl)/2;g.poly([[hs,y-rh/2],[hs+5,y-rh/2-14],[hs+hl-5,y-rh/2-14],[hs+hl,y-rh/2]],B,[[[hs+9,y-rh/2-1],[hs+12,y-rh/2-9],[hs+hl-12,y-rh/2-9],[hs+hl-9,y-rh/2-1]]]);}
    if(o.bolt){g.line([[rx+rl*0.8,y-2],[rx+rl*0.92,y+10]],'#1f2227',3);g.circ(rx+rl*0.93,y+12,3.6,'D');}
    // grip
    const gx=rx+rl*(o.gripAt!==undefined?o.gripAt:0.55);
    if(!o.noGrip){const gl=o.gripMag?54:34;g.poly([[gx,y+9],[gx+15,y+9],[gx+15+gl*0.28,y+gl],[gx+gl*0.28,y+gl+2]],o.gripMat||(o.wood&&o.woodGrip?'W':'P'));
      if(o.gripMag)g.rect(gx+gl*0.28-1,y+gl,17,5,'D',1);
      g.path(`M${gx-12},${y+11}Q${gx-13},${y+23} ${gx-2},${y+23}L${gx+3},${y+19}`,'none',[[gx-13,y+11],[gx+3,y+23]],false);
      g.line([[gx-12,y+11],[gx-12.5,y+20],[gx-5,y+23.5],[gx+2,y+21]],'#1f2227',2.4);
      g.line([[gx-5,y+11],[gx-4,y+17]],'#1f2227',2);}
    // stock
    const sx=rx+rl,sl=o.sl||66,sm=o.wood?'W':(o.stockMat||B);
    switch(o.stock){
      case 'fixed':g.poly([[sx,y-(o.dust?9:rh/2-1)],[sx+sl,y-4],[sx+sl,y+26],[sx+sl-6,y+28],[sx+12,y+14],[sx,y+11]],sm);g.rect(sx+sl-3,y-5,5,33,'P',1);break;
      case 'rifle':g.poly([[sx,y-6],[sx+sl,y-2],[sx+sl,y+28],[sx+sl-6,y+30],[sx+sl*0.35,y+16],[sx-10,y+28],[sx-24,y+22],[sx-6,y+10]],sm);g.rect(sx+sl-3,y-3,5,33,'P',1);break;
      case 'm4':g.rect(sx,y-7,sl*0.55,9,'D',2);g.poly([[sx+sl*0.35,y-11],[sx+sl,y-11],[sx+sl,y+20],[sx+sl-8,y+22],[sx+sl*0.35,y+5]],o.stockMat||'P');break;
      case 'wire':g.line([[sx,y-6],[sx+sl,y-9]],'#1f2227',3.4);g.line([[sx,y+8],[sx+sl,y+17]],'#1f2227',3.4);g.rect(sx+sl-3,y-14,6,36,'D',2);break;
      case 'skeleton':g.poly([[sx,y-9],[sx+sl,y-7],[sx+sl,y+22],[sx+sl-6,y+24],[sx,y+10]],o.stockMat||'P',[[[sx+9,y-3],[sx+sl-10,y-1],[sx+sl-10,y+15],[sx+9,y+6]]]);break;
      case 'thumbhole':g.poly([[sx,y-10],[sx+sl,y-12],[sx+sl,y+28],[sx+sl-10,y+31],[sx+16,y+31],[sx-2,y+14]],sm,[[[sx+12,y+3],[sx+36,y+1],[sx+42,y+21],[sx+16,y+22]]]);g.rect(sx+sl-4,y-12,6,43,'P',1);break;
      case 'folded':g.rect(sx,y-6,9,18,'P',2);break;
      case 'stub':g.path(`M${sx},${y-6}L${sx+16},${y-4}Q${sx+30},${y+10} ${sx+26},${y+30}L${sx+12},${y+32}Q${sx+12},${y+16} ${sx},${y+11}Z`,o.wood?'W':sm,[[sx,y-6],[sx+30,y+32]]);break;
    }
    // optic on top
    if(o.scope){const big=o.scope>1,tr=big?6.5:4.5,ty=y-rh/2-(big?17:12),t0=rx-(big?26:10),tl=rl*(big?1.05:0.75)+(big?26:10);
      g.rect(t0+10,ty-tr,tl-20,tr*2,'D',2);
      g.poly([[t0+10,ty-tr],[t0,ty-tr-(big?5:3)],[t0,ty+tr+(big?5:3)],[t0+10,ty+tr]],'D');
      g.poly([[t0+tl-10,ty-tr],[t0+tl,ty-tr-3],[t0+tl,ty+tr+3],[t0+tl-10,ty+tr]],'D');
      g.rect(t0+tl*0.42,ty-tr-6,10,6,'D',1);
      g.rect(t0+tl*0.25,ty+tr,6,y-rh/2-(ty+tr),'D',0.5,false);g.rect(t0+tl*0.68,ty+tr,6,y-rh/2-(ty+tr),'D',0.5,false);}
    if(o.dot){const dx=rx+rl*0.35;g.rect(dx,y-rh/2-12,20,10,'D',2);g.rect(dx+3,y-rh/2-9,3,4,'#c23',0.5,false);}
  }
  /* ---- pistols ---- */
  function pistol(g,o,ox=0,oy=0){
    const sl=o.sl||76,sh=o.sh||17,y=oy;let x=ox;
    if(o.sup){g.rect(x,y+3,o.sup,12,'P',5);x+=o.sup;}
    else g.rect(x,y+sh*0.35,4,sh*0.35,'D',0.5);
    x+=o.sup?0:3;
    g.rect(x,y,sl,sh,'B',2);
    for(let i=0;i<5;i++)g.rect(x+sl-18+i*3.2,y+3,1.3,sh-6,'D',0,false);
    g.rect(x+sl*0.42,y+3,sl*0.22,4,'D',0.5,false);
    if(o.rail)g.rect(x+6,y-3,sl*0.5,3,'D',0.5);
    const fy=y+sh;g.rect(x+4,fy,sl*0.62,o.frameH||8,'P',1);
    if(o.rail)for(let i=0;i<3;i++)g.rect(x+8+i*7,fy+(o.frameH||8),4,2,'D',0,false);
    const gx=x+sl*0.6;const gl=o.gripL||40,ang=o.ang||0.32;
    g.poly([[gx,fy],[gx+sl*0.36,fy],[gx+sl*0.36+gl*ang,fy+gl],[gx+gl*ang-2,fy+gl+1]],'P');
    for(let i=0;i<4;i++){const d=12+i*7;g.line([[gx+d*ang+5,fy+d],[gx+sl*0.36+d*ang-5,fy+d]],'#3a3e44',1.2);}
    if(o.magOut)g.rect(gx+gl*ang-2,fy+gl,sl*0.32,6,'D',1);
    g.line([[gx-17,fy+1],[gx-18,fy+10],[gx-9,fy+15],[gx+1,fy+12]],'#1f2227',2.4);
    g.line([[gx-8,fy+2],[gx-7,fy+9]],'#1f2227',2);
    g.rect(x+sl-6,y-2,4,2.5,'D',0.5,false);
  }
  const SPEC={
    glock:{t:'pistol',sl:78,sh:17},usp:{t:'pistol',sl:80,sh:18,sup:44},p2000:{t:'pistol',sl:74,sh:17},p250:{t:'pistol',sl:70,sh:17,ang:0.36},
    fiveseven:{t:'pistol',sl:86,sh:16,rail:1},cz75:{t:'pistol',sl:76,sh:16,magOut:1},deagle:{t:'pistol',sl:98,sh:23,rail:1,gripL:44,frameH:10},
    dualies:{t:'dual'},r8:{t:'revolver'},tec9:{t:'tec9'},zeus:{t:'taser'},
    mac10:{rl:66,rh:26,barrel:16,gripMag:1,gripAt:0.42,stock:'wire',sl:46},
    mp9:{rl:70,rh:22,barrel:20,gripMag:1,gripAt:0.44,stock:'folded',hg:0,vgrip:0,rail:1},
    mp7:{rl:66,rh:22,barrel:20,hg:22,rail:1,gripMag:1,gripAt:0.42,stock:'m4',sl:36,dot:1},
    mp5:{sup:66,barrel:0,hg:36,rl:70,mag:'curved',magAt:0.12,stock:'fixed',sl:58},
    ump45:{barrel:18,hg:42,rail:1,rl:70,mag:'straight',stock:'skeleton',sl:54},
    bizon:{barrel:30,fs:1,hg:0,rl:78,mag:'tube',tubeBack:60,stock:'wire',sl:56},
    thompson:{comp:1,barrel:48,hg:0,rl:72,mag:'drum',magAt:0.1,stock:'fixed',sl:72,wood:1,woodGrip:1,vgripT:1},
    p90:{t:'p90'},famas:{t:'famas'},aug:{t:'aug'},
    ak47:{barrel:56,fs:1,hg:60,wood:1,rl:76,dust:1,mag:'curved',stock:'fixed',sl:78},
    m4a4:{barrel:44,fs:1,hg:68,rail:1,vents:1,rl:74,mag:'straight',stock:'m4',sl:70},
    m4a1s:{sup:54,barrel:6,hg:68,rail:1,vents:1,rl:74,mag:'straight',magL:38,stock:'m4',sl:70},
    galil:{barrel:50,fs:1,hg:56,vents:1,rl:80,mag:'curved',stock:'skeleton',sl:66},
    sg553:{barrel:38,hg:56,vents:1,rl:84,mag:'curved',stock:'skeleton',sl:62,scope:1},
    ssg08:{barrel:100,hg:76,rl:56,scope:2,mag:'short',stock:'fixed',sl:76,bolt:1,stockMat:'B',hgMat:'B'},
    awp:{brake:1,barrel:104,hg:66,rl:66,scope:2,mag:'short',stock:'thumbhole',sl:86,bolt:1},
    g3sg1:{barrel:70,hg:64,vents:1,rl:84,scope:2,mag:'straight',magL:38,stock:'thumbhole',sl:76},
    scar20:{barrel:62,hg:64,rail:1,rl:82,scope:2,mag:'straight',magL:36,stock:'m4',sl:72},
    m1a:{barrel:52,fs:1,hg:94,wood:1,rl:58,scope:1,mag:'short',noGrip:1,stock:'rifle',sl:76},
    barrett:{brake:1,barrel:96,hg:76,rl:100,rh:26,scope:2,mag:'straight',magL:34,magAt:0.2,stock:'fixed',sl:78,bipod:1},
    m249:{shield:1,barrel:66,hg:44,rl:96,rh:26,mag:'box',boxH:30,stock:'fixed',sl:64,bipod:1,handle:1,handleL:30,rail:1},
    negev:{barrel:70,hg:50,vents:1,rl:88,rh:24,mag:'box',boxH:28,magMat:'P',stock:'skeleton',sl:58,bipod:1},
    nova:{barrel:100,tube:1,hg:40,pump:1,rl:58,stock:'fixed',sl:72},
    xm1014:{barrel:86,tube:1,hg:50,rl:66,stock:'fixed',sl:70,rail:1},
    mag7:{barrel:54,hg:38,pump:1,rl:64,rh:24,mag:'box',boxH:30,magMat:'P',magAt:0.3,gripAt:0.68,stock:'folded'},
    sawedoff:{barrel:44,tube:1,tubeLen:40,hg:34,pump:1,wood:1,rl:46,stock:'stub',noGrip:1},
    remington:{barrel:100,tube:1,hg:42,pump:1,wood:1,rl:56,stock:'fixed',sl:76},
    spas:{barrel:88,tube:1,hg:44,pump:1,hgMat:'P',rl:60,stock:'wire',sl:60}
  };
  function special(g,t){
    const y=50;
    if(t==='dual'){pistol(g,{sl:80,sh:17},26,-16);pistol(g,{sl:80,sh:17},0,0);return;}
    if(t==='revolver'){g.rect(0,y-4,72,9,'B',2);g.rect(4,y-8,64,4,'D',1);g.rect(72,y-11,30,22,'B',3);for(let i=0;i<4;i++)g.rect(75+i*6.5,y-9,3,18,'D',1,false);
      g.rect(102,y-8,16,18,'B',2);g.poly([[112,y+8],[128,y+6],[142,y+40],[124,y+46],[114,y+20]],'W');g.line([[100,y+10],[98,y+20],[106,y+22],[110,y+16]],'#1f2227',2.4);g.poly([[114,y-8],[124,y-16],[128,y-12],[118,y-4]],'D');return;}
    if(t==='tec9'){g.rect(0,y-4,14,8,'D',1);g.rect(14,y-7,52,14,'P',2);for(let i=0;i<5;i++)g.circ(20+i*9,y,2.2,'D',false);g.rect(66,y-9,62,19,'B',2);
      g.poly([[72,y+10],[88,y+10],[86,y+58],[74,y+58]],'P');g.poly([[100,y+10],[116,y+10],[124,y+40],[110,y+42]],'P');g.line([[90,y+11],[90,y+22],[98,y+24],[102,y+18]],'#1f2227',2.4);return;}
    if(t==='taser'){g.rect(0,y-8,14,16,'D',2);g.rect(14,y-11,62,22,'Y',4);g.rect(20,y-7,40,4,'#7a5f10',1,false);g.poly([[52,y+11],[70,y+11],[80,y+44],[62,y+46]],'P');g.line([[46,y+12],[45,y+22],[54,y+24],[58,y+18]],'#1f2227',2.4);return;}
    if(t==='p90'){g.rect(0,y-4,12,8,'D',1);g.path(`M12,${y-10}L60,${y-14}Q120,${y-16} 150,${y-6}Q160,${y+8} 150,${y+30}L120,${y+34}Q112,${y+10} 96,${y+12}L80,${y+30}L62,${y+30}L58,${y+12}L12,${y+10}Z`,'B',[[12,y-16],[160,y+34]]);
      g.rect(40,y-24,108,12,'X',3);g.path(`M84,${y+14}Q98,${y+10} 108,${y+28}L98,${y+30}Q92,${y+20} 86,${y+22}Z`,'D',[[84,y+10],[108,y+30]],false);return;}
    if(t==='famas'){g.rect(0,y-4,10,8,'D',1);g.rect(10,y-3,40,6,'D',1);g.line([[22,y+3],[10,y+38]],'#1f2227',3);g.line([[26,y+3],[38,y+38]],'#1f2227',3);
      g.poly([[50,y-10],[180,y-12],[180,y+14],[170,y+24],[110,y+14],[50,y+10]],'B');g.poly([[60,y-10],[66,y-30],[150,y-30],[162,y-12]],'B',[[[72,y-14],[76,y-24],[146,y-24],[150,y-14]]]);
      g.poly([[124,y+12],[142,y+12],[146,y+44],[128,y+46]],'P');g.poly([[74,y+12],[90,y+12],[96,y+38],[82,y+40]],'P');g.line([[66,y+12],[66,y+22],[74,y+24],[78,y+18]],'#1f2227',2.4);g.rect(178,y-12,5,36,'P',1);return;}
    if(t==='aug'){g.rect(0,y-4,12,8,'D',1);g.rect(12,y-3,34,6,'D',1);g.path(`M46,${y-10}L170,${y-12}Q182,${y} 176,${y+24}L120,${y+20}L46,${y+10}Z`,'B',[[46,y-12],[182,y+24]]);
      g.poly([[60,y+10],[72,y+10],[70,y+38],[62,y+38]],'P');g.path(`M78,${y+10}Q92,${y+40} 110,${y+18}`,'none',[[78,y+10],[110,y+40]],false);g.line([[78,y+10],[84,y+32],[100,y+34],[110,y+18]],'#1f2227',3);
      g.poly([[120,y+18],[138,y+18],[140,y+48],[122,y+48]],'X');g.rect(58,y-26,74,12,'D',4);g.poly([[58,y-26],[50,y-30],[50,y-10],[58,y-14]],'D');g.rect(130,y-24,8,8,'D',2);return;}
  }
  function weapon(id,fill){const s=SPEC[id];const g=mk();if(!s){g.rect(0,40,120,20,'B',3);return g.svg(fill);}
    if(s.t==='pistol')pistol(g,s,0,40);else if(s.t)special(g,s.t);else longGun(g,s);
    return g.svg(fill);}
  /* ---- knives ---- */
  function knife(id,blade){
    const w=WEAPONS[id]||WEAPONS.knife,s=w.shape||{};const g=mk();const L=(s.L||0.22)*640,Wd=(s.W||0.042)*520,c=s.curve||0,y=50,hc='#'+((s.hc||0x2b2b2b).toString(16).padStart(6,'0'));
    const hl=s.t==='push'?0:Math.max(70,L*0.72);
    if(s.t==='push'){g.rect(L-6,y-40,16,80,hc,6);g.path(`M${L},${y-Wd*0.8}L4,${y}L${L},${y+Wd*0.8}Z`,'S',[[4,y-Wd],[L,y+Wd]]);g.rect(L-8,y-Wd*0.9,10,Wd*1.8,'D',2);return g.svg(null,blade);}
    const dy=-c*0.34*L,tipX=0,gx=L;
    // handle
    if(s.t==='butterfly'){g.rect(gx,y-10,hl,8,hc,3);g.rect(gx,y+2,hl,8,hc,3);for(let i=0;i<5;i++){g.circ(gx+12+i*(hl-24)/4,y-6,1.8,'D',false);g.circ(gx+12+i*(hl-24)/4,y+6,1.8,'D',false);}g.circ(gx+3,y,4,'M');}
    else if(s.ring&&c<-0.5){g.path(`M${gx},${y-8}Q${gx+hl*0.5},${y-14} ${gx+hl},${y-2}L${gx+hl-4},${y+12}Q${gx+hl*0.5},${y+4} ${gx},${y+9}Z`,hc,[[gx,y-14],[gx+hl,y+12]]);}
    else g.path(`M${gx},${y-9}L${gx+hl-6},${y-8}Q${gx+hl+4},${y-6} ${gx+hl},${y+6}Q${gx+hl-4},${y+12} ${gx+hl-12},${y+11}L${gx},${y+9}Z`,hc,[[gx,y-9],[gx+hl+4,y+12]]);
    if(s.cord)for(let i=0;i<7;i++)g.line([[gx+8+i*(hl-16)/6,y-9],[gx+3+i*(hl-16)/6,y+10]],'#111',2.2);
    if(s.ring){const rcx=gx+hl+10,rcy=y+(c<-0.5?6:0);g.raw(`<circle cx="${rcx}" cy="${rcy}" r="10" fill="none" stroke="#c9ced4" stroke-width="4"/><circle cx="${rcx}" cy="${rcy}" r="12" fill="none" stroke="#0c0d0f" stroke-width="1"/><circle cx="${rcx}" cy="${rcy}" r="8" fill="none" stroke="#0c0d0f" stroke-width="1"/>`,rcx-13,rcy-13,rcx+13,rcy+13);}
    if(id==='skeleton')g.raw(`<ellipse cx="${gx+hl*0.5}" cy="${y}" rx="${hl*0.3}" ry="4" fill="#15171a"/>`);
    // guard / bolster
    if(s.guard)g.rect(gx-4,y-15,7,30,'M',2);else if(s.t==='fold'||s.t==='butterfly')g.circ(gx+2,y,5,'M');else g.rect(gx-3,y-10,6,20,'M',2);
    // blade
    const sp=-Wd*0.5,ed=Wd*0.5;
    const clip=(id==='bowie'||id==='huntsman'||id==='survival');
