    if(r<0.35&&w>4&&d>4){const tx=x+rand(-w/4,w/4),tz=z+rand(-d/4,d/4);for(const[ox,oz]of[[-0.45,-0.45],[0.45,-0.45],[-0.45,0.45],[0.45,0.45]])deco(new THREE.BoxGeometry(0.07,0.6,0.07),H.metalD,tx+ox,h+0.3,tz+oz);
      const tk=deco(new THREE.CylinderGeometry(0.6,0.6,1.1,16),H.tank,tx,h+1.15,tz);tk.castShadow=true;deco(new THREE.CylinderGeometry(0.62,0.62,0.06,16),H.metalD,tx,h+1.72,tz);colliders.push({minX:tx-0.6,maxX:tx+0.6,minZ:tz-0.6,maxZ:tz+0.6,minY:h,maxY:h+1.75});}
    else if(r<0.6){const vx=x+rand(-w/3,w/3),vz=z+rand(-d/3,d/3);const v=deco(new THREE.BoxGeometry(0.9,0.55,0.9),H.metal,vx,h+0.28,vz);v.castShadow=true;deco(new THREE.BoxGeometry(0.7,0.05,0.7),H.metalD,vx,h+0.58,vz);}
    if(rng()<0.4){const ax=x+rand(-w/3,w/3),az=z+rand(-d/3,d/3),ah=rand(1.4,2.6);deco(new THREE.CylinderGeometry(0.025,0.03,ah,6),H.metalD,ax,h+ah/2,az);for(let i=1;i<=3;i++)deco(new THREE.BoxGeometry(0.7-i*0.15,0.025,0.025),H.metalD,ax,h+ah*(0.5+i*0.15),az);}
    if(rng()<0.3){const dx=x+rand(-w/3,w/3),dz=z+rand(-d/3,d/3);const dish=deco(new THREE.SphereGeometry(0.42,14,8,0,Math.PI*2,0,Math.PI/3.2),H.metal,dx,h+0.75,dz);dish.material=H.metal;dish.rotation.x=-1.1;dish.rotation.z=rand(-1,1);deco(new THREE.CylinderGeometry(0.03,0.03,0.7,6),H.metalD,dx,h+0.35,dz);}}
}
/* ===== 3D steel ladder: rails, round rungs, wall brackets, grab rails over the roof edge, safety cage on tall ladders ===== */
const LAD={};
function ladderMats(){if(LAD.m)return LAD.m;
  const tx=(typeof pbrTex==='function'&&pbrTex('metal'))||canvasTex(128,(x,s)=>{x.fillStyle='#8d918f';x.fillRect(0,0,s,s);hdGrain(x,s,2500,0.18);
    for(let i=0;i<10;i++){const px=Math.random()*s,py=Math.random()*s,g=x.createRadialGradient(px,py,0,px,py,4+Math.random()*10);g.addColorStop(0,'rgba(120,62,30,.55)');g.addColorStop(1,'rgba(120,62,30,0)');x.fillStyle=g;x.fillRect(px-14,py-14,28,28);}
    for(let i=0;i<6;i++){const px=Math.random()*s;const g=x.createLinearGradient(0,0,0,s);g.addColorStop(0,'rgba(110,60,30,.0)');g.addColorStop(0.5,'rgba(110,60,30,.28)');g.addColorStop(1,'rgba(110,60,30,0)');x.fillStyle=g;x.fillRect(px,0,2,s);}});
  const steel=new THREE.MeshPhongMaterial({color:0xb4b8b6,map:tx,shininess:38,specular:0x3a3a3a});
  const rung=new THREE.MeshPhongMaterial({color:0xd0d2cf,map:tx,shininess:60,specular:0x555555});
  const brk=new THREE.MeshLambertMaterial({color:0x5a5d5c,map:tx});
  const cage=new THREE.MeshPhongMaterial({color:0xc9a227,map:tx,shininess:30,specular:0x2a2a2a});
  LAD.m={steel,rung,brk,cage};return LAD.m;}
function ladderMesh(lx,lz,nx,nz,along,h){const M=ladderMats();
  const rx=along?1:0,rz=along?0:1,yaw=Math.atan2(nx,nz);
  const at=(u,y,w)=>[lx+rx*u+nx*w,y,lz+rz*u+nz*w];
  const box=(sx,sy,sw,mat,u,y,w,clutter)=>{const g=new THREE.BoxGeometry(along?sx:sw,sy,along?sw:sx);const[a,b,c]=at(u,y,w);const m=new THREE.Mesh(g,mat);m.position.set(a,b,c);m.castShadow=true;m.receiveShadow=true;if(clutter)m.userData.clutter=1;world.add(m);return m;};
  const W=0.21,top=h+1.05;
  // rails (slightly tapered look: front flange + web)
  for(const u of[-W,W]){box(0.07,top,0.05,M.steel,u,top/2,0.2);box(0.02,top,0.03,M.brk,u+(u<0?0.03:-0.03),top/2,0.185);}
  // round anti-slip rungs every 30 cm
  if(!LAD.rg)LAD.rg=new THREE.CylinderGeometry(0.019,0.019,W*2,10);
  for(let y=0.3;y<h+0.05;y+=0.3){const r=new THREE.Mesh(LAD.rg,M.rung);const[a,b,c]=at(0,y,0.2);r.position.set(a,b,c);if(along)r.rotation.z=Math.PI/2;else r.rotation.x=Math.PI/2;r.castShadow=true;world.add(r);}
  // wall brackets every 1.8 m and at the top
  for(let y=0.9;y<h;y+=1.8)for(const u of[-W,W])box(0.05,0.05,0.2,M.brk,u,y,0.1);
  for(const u of[-W,W])box(0.05,0.05,0.2,M.brk,u,h-0.15,0.1);
  // base plates
  for(const u of[-W,W])box(0.14,0.03,0.14,M.brk,u,0.015,0.2);
  // grab rails bend back over the roof edge
  for(const u of[-W,W]){box(0.05,0.05,0.55,M.steel,u,top-0.025,-0.05);box(0.05,0.5,0.05,M.steel,u,top-0.3,-0.3);}
  // safety cage on tall ladders (yellow hoops + vertical straps); removed on low prop detail
  if(h>4.2){if(!LAD.hoop){LAD.hoop=new THREE.TorusGeometry(0.42,0.018,6,20,Math.PI);LAD.hoop.rotateX(Math.PI/2);}
    for(let y=2.3;y<=top-0.1;y+=0.85){const m=new THREE.Mesh(LAD.hoop,M.cage);const[a,b,c]=at(0,y,0.2);m.position.set(a,b,c);m.rotation.y=yaw;m.userData.clutter=1;m.castShadow=true;world.add(m);}
    const ch=top-2.3;for(const th of[0.35,1.0,1.5708,2.14,2.79]){const u=Math.cos(th)*0.42,w=0.2+Math.sin(th)*0.42;box(0.035,ch,0.012,M.cage,u,2.3+ch/2,w,true);}}
}
const DOOR_SPOTS=[];
function addLadder(x,z,w,d,h){
  const faces=[[0,1],[0,-1],[1,0],[-1,0]].sort(()=>rng()-0.5);let nx,nz,along,lx,lz,ok=false;
  for(const f of faces){[nx,nz]=f;along=nz!==0;const len=along?w:d;if(len<3)continue;
    for(let k=0;k<4&&!ok;k++){const t=rand(-len/2+1,len/2-1);lx=along?x+t:x+nx*w/2;lz=along?z+nz*d/2:z+t;
      if(blocked(lx+nx*0.8,lz+nz*0.8,0.5))continue;if(DOOR_SPOTS.some(([a,b])=>Math.hypot(a-lx,b-lz)<1.5))continue;ok=true;}
    if(ok)break;}
  if(!ok)return;
  ladderMesh(lx,lz,nx,nz,along,h);
  const cx=lx+nx*0.38,cz=lz+nz*0.38;
  ladders.push({minX:cx-(along?0.45:0.4),maxX:cx+(along?0.45:0.4),minZ:cz-(along?0.4:0.45),maxZ:cz+(along?0.4:0.45),top:h,nx,nz});
}
function ladderAt(p){for(const L of ladders)if(p.x>L.minX&&p.x<L.maxX&&p.z>L.minZ&&p.z<L.maxZ&&p.y<L.top-0.02)return L;return null;}
function inLadderZone(x,z,m){for(const L of ladders)if(x>L.minX-m&&x<L.maxX+m&&z>L.minZ-m&&z<L.maxZ+m)return true;return false;}
function groundPlane(size,rep){const gm=GROUND_MAT||MAT_SAND;if(gm.map&&gm!==MAT_SAND&&(!gm.isMeshPhongMaterial||gm.userData.pbr)){gm.map.repeat.set(size/THEME._m.gtile,size/THEME._m.gtile);}const m=new THREE.Mesh(new THREE.PlaneGeometry(size,size),gm);m.userData.noMerge=1;m.rotation.x=-Math.PI/2;m.receiveShadow=true;world.add(m);worldMeshes.push(m);}
function boundary(H,h=7){const t=2,B=MAT.boundary;solidT(0,0,-H-t/2,H*2+t*2,h,t,B,3);solidT(0,0,H+t/2,H*2+t*2,h,t,B,3);solidT(-H-t/2,0,0,t,h,H*2,B,3);solidT(H+t/2,0,0,t,h,H*2,B,3);
  for(const[x,z,w,d]of[[0,-H-t/2,H*2+t*2,t+0.2],[0,H+t/2,H*2+t*2,t+0.2],[-H-t/2,0,t+0.2,H*2],[H+t/2,0,t+0.2,H*2]]){solidT(x,0,z,w,0.6,d,shadeOf(B,0.72),3,false);solidT(x,h,z,w+0.2,0.2,d+0.2,MAT.ledge,3,false);}}
function crate(x,z,s=1.1,y=0){return solid(x,y,z,s,s,s,MAT.crate);}
/* ================= MAP THEMES (random each match) ================= */
const texBrick=canvasTex(512,(x,s)=>{x.fillStyle='#a9a39c';x.fillRect(0,0,s,s);hdGrain(x,s,6000,0.2);const R=32,BH=s/R,BW=BH*3;
  for(let r=0;r<R;r++)for(let c=-1;c<=s/BW;c++){const o=r%2?BW/2:0,px=c*BW+o+1.5,py=r*BH+1.5,w=BW-3,h=BH-3;const v=185+Math.random()*55|0;x.fillStyle=`rgb(${v},${v-4},${v-8})`;x.fillRect(px,py,w,h);
    x.fillStyle='rgba(255,255,255,.18)';x.fillRect(px,py,w,1.2);x.fillStyle='rgba(0,0,0,.18)';x.fillRect(px,py+h-1.2,w,1.2);if(Math.random()<0.25){x.fillStyle='rgba(60,50,40,.18)';x.fillRect(px+Math.random()*w*0.6,py,w*0.4,h);}}
  hdNoise(x,s,50,0.04,0.12,30,110);hdGrain(x,s,9000,0.12);hdCracks(x,s,2,0.3,8);});
const texConcrete=canvasTex(512,(x,s)=>{x.fillStyle='#e4e4e2';x.fillRect(0,0,s,s);hdNoise(x,s,50,0.03,0.07,40,140);hdNoise(x,s,70,0.02,0.06,6,24);hdGrain(x,s,20000,0.14);
  // air bubbles
  for(let i=0;i<260;i++){const px=Math.random()*s,py=Math.random()*s,r=0.6+Math.random()*1.6;x.fillStyle='rgba(60,60,60,.4)';x.beginPath();x.arc(px,py,r,0,7);x.fill();}
  // form panel seams + tie holes
  x.strokeStyle='rgba(40,40,40,.28)';x.lineWidth=2;for(let i=0;i<=s;i+=256){x.beginPath();x.moveTo(0,i);x.lineTo(s,i);x.moveTo(i,0);x.lineTo(i,s);x.stroke();}
  x.strokeStyle='rgba(255,255,255,.18)';x.lineWidth=1;for(let i=2;i<=s;i+=256){x.beginPath();x.moveTo(0,i);x.lineTo(s,i);x.moveTo(i,0);x.lineTo(i,s);x.stroke();}
  for(let a=64;a<s;a+=128)for(let b=64;b<s;b+=128){x.fillStyle='rgba(50,50,50,.55)';x.beginPath();x.arc(a,b,4,0,7);x.fill();x.fillStyle='rgba(255,255,255,.2)';x.beginPath();x.arc(a+1.5,b+1.5,3,0,3.14);x.fill();
    if(Math.random()<0.4){const g=x.createLinearGradient(0,b,0,b+90);g.addColorStop(0,'rgba(120,80,50,.22)');g.addColorStop(1,'rgba(120,80,50,0)');x.fillStyle=g;x.fillRect(a-3,b+3,6,90);}}
  hdCracks(x,s,4,0.3,10);});
const texStone=canvasTex(512,(x,s)=>{x.fillStyle='#8f8b84';x.fillRect(0,0,s,s);const R=6,RH=s/R;
  for(let r=0;r<R;r++){let cx=-(Math.random()*60);const y=r*RH;while(cx<s){const w=60+Math.random()*90,v=175+Math.random()*55|0;const px=cx+2.5,py=y+2.5,ww=Math.min(w,s+40-cx)-5,hh=RH-5;
    for(const ox of[0,-s])if(px+ox+ww>0){x.fillStyle=`rgb(${v},${v-3},${v-9})`;x.fillRect(px+ox,py,ww,hh);
      const g=x.createLinearGradient(0,py,0,py+hh);g.addColorStop(0,'rgba(255,255,255,.22)');g.addColorStop(0.15,'rgba(255,255,255,0)');g.addColorStop(0.85,'rgba(0,0,0,0)');g.addColorStop(1,'rgba(0,0,0,.28)');x.fillStyle=g;x.fillRect(px+ox,py,ww,hh);
      x.fillStyle='rgba(0,0,0,.16)';x.fillRect(px+ox+ww-3,py,3,hh);x.fillStyle='rgba(255,255,255,.12)';x.fillRect(px+ox,py,2,hh);}
    cx+=w;}}
  hdNoise(x,s,60,0.03,0.08,10,50);hdGrain(x,s,22000,0.16);hdCracks(x,s,4,0.3,7);hdPocks(x,s,4);});
{const an=Math.min(8,renderer.capabilities.getMaxAnisotropy?renderer.capabilities.getMaxAnisotropy():1);for(const t of[texBrick,texConcrete,texStone])t.anisotropy=an;}
const WALLFX_V='varying vec3 vWP;\n',WALLFX_F=`varying vec3 vWP;
float wh(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float wn(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);return mix(mix(wh(i),wh(i+vec2(1,0)),f.x),mix(wh(i+vec2(0,1)),wh(i+vec2(1,1)),f.x),f.y);}
`;
function wallFX(m){if(!m||m.userData.wallfx)return m;m.userData.wallfx=1;
  m.onBeforeCompile=sh=>{sh.vertexShader=WALLFX_V+sh.vertexShader.replace('#include <project_vertex>','#include <project_vertex>\n vWP=(modelMatrix*vec4(transformed,1.0)).xyz;');
    sh.fragmentShader=WALLFX_F+sh.fragmentShader.replace('#include <map_fragment>',`#include <map_fragment>
  { float h1=wn(vWP.xz*0.23+vec2(vWP.y*0.11,0.0))*0.65+wn(vWP.xz*0.9+vWP.y*0.4)*0.35;
    float st=wn(vec2((vWP.x+vWP.z)*2.1,vWP.y*0.09));float st2=wn(vec2((vWP.x-vWP.z)*0.7,3.7));
    float streak=1.0-0.16*smoothstep(0.6,0.95,st)*smoothstep(0.35,0.8,st2);
    float g=1.0-smoothstep(0.0,1.6,vWP.y);float grime=1.0-0.30*g*g*(0.55+0.45*h1);
    float rise=1.0-0.07*(1.0-smoothstep(0.0,0.35,vWP.y));
    diffuseColor.rgb*=(0.9+0.18*h1)*streak*grime*rise; }`);};
  m.customProgramCacheKey=()=>'wallfx';m.needsUpdate=true;return m;}
const texGConcrete=canvasTex(256,(x,s)=>{x.fillStyle='#8f8e89';x.fillRect(0,0,s,s);speckle(x,s,9000,0.16);x.strokeStyle='rgba(30,30,30,.35)';x.lineWidth=2;for(let i=0;i<=s;i+=64){x.beginPath();x.moveTo(i,0);x.lineTo(i,s);x.stroke();x.beginPath();x.moveTo(0,i);x.lineTo(s,i);x.stroke();}
  x.strokeStyle='rgba(20,20,20,.3)';x.lineWidth=1;for(let i=0;i<10;i++){let px=Math.random()*s,py=Math.random()*s;x.beginPath();x.moveTo(px,py);for(let j=0;j<6;j++){px+=(Math.random()-0.5)*24;py+=(Math.random()-0.5)*24;x.lineTo(px,py);}x.stroke();}
  for(let i=0;i<14;i++){x.fillStyle=`rgba(40,35,30,${Math.random()*0.12})`;x.beginPath();x.arc(Math.random()*s,Math.random()*s,8+Math.random()*26,0,7);x.fill();}});
const texCobble=canvasTex(256,(x,s)=>{x.fillStyle='#5d5650';x.fillRect(0,0,s,s);for(let r=0;r<16;r++)for(let c=0;c<17;c++){const o=r%2?8:0;const v=120+Math.random()*50|0;x.fillStyle=`rgb(${v},${v-8},${v-18})`;x.beginPath();x.ellipse(c*16+o,r*16+8,7+Math.random()*1.5,6.5,Math.random(),0,7);x.fill();}speckle(x,s,4000,0.15);});
const texGrass=canvasTex(256,(x,s)=>{x.fillStyle='#5d7a35';x.fillRect(0,0,s,s);for(let i=0;i<9000;i++){const g=90+Math.random()*70|0;x.fillStyle=`rgba(${g*0.55|0},${g},${g*0.35|0},.55)`;x.fillRect(Math.random()*s,Math.random()*s,1,2+Math.random()*3);}
  for(let i=0;i<18;i++){x.fillStyle=`rgba(110,85,50,${0.15+Math.random()*0.25})`;x.beginPath();x.arc(Math.random()*s,Math.random()*s,6+Math.random()*20,0,7);x.fill();}});
function makeSand(tint){const m=MAT_SAND.clone();const t=new THREE.Vector3(...tint);m.onBeforeCompile=sh=>{MAT_SAND.onBeforeCompile(sh);sh.uniforms.uTint={value:t};sh.fragmentShader=sh.fragmentShader.replace('uniform sampler2D saC','uniform vec3 uTint;uniform sampler2D saC').replace('diffuseColor*=vec4(sC.rgb,1.0);','diffuseColor*=vec4(sC.rgb*uTint,1.0);');};m.customProgramCacheKey=()=>'sand4t';return m;}
