  for(let i=0;i<3;i++)brSpot(x+rand(-2.4,2.4),1.4,z+rand(-2.4,2.4));}
function poiRadio(p){const x=p.x,z=p.z;const red=new THREE.MeshLambertMaterial({color:0xc0392b,wireframe:true}),wht=new THREE.MeshLambertMaterial({color:0xe8e8e8,wireframe:true});
