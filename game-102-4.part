const sharedGeo=new Set(Object.values(GEO));
const TSIDE=Lm({color:0xdddddd}),TFACE=Lm({map:texTarget});
const DECAL=new THREE.MeshBasicMaterial({color:0x1e1a14});
const PMAT={water:new THREE.MeshBasicMaterial({color:0xcfe9f0,transparent:true,opacity:0.8}),dust:new THREE.MeshBasicMaterial({color:0xcbb68e}),blood:new THREE.MeshBasicMaterial({color:0x8a1010}),spark:new THREE.MeshBasicMaterial({color:0xffd060}),glass:new THREE.MeshBasicMaterial({color:0xcfeefa,transparent:true,opacity:0.75})};
const TRACER=new THREE.LineBasicMaterial({color:0xffe7a8,transparent:true,opacity:0.8});
