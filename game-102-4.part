  const supp=(z,r,len)=>{cyl(g,r,len,black,0,0.01,z-len/2);for(let i=0;i<3;i++)cyl(g,r*1.04,0.004,metal,0,0.01,z-len*(0.2+i*0.3));const cap=new THREE.Mesh(new THREE.CircleGeometry(r*0.35,12),dark);cap.position.set(0,0.01,z-len-0.0005);cap.rotation.y=Math.PI;g.add(cap);return z-len-0.01;};
