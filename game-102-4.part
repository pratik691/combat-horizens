    if(rng()<0.55&&len>2.6){const t=rand(-len/2+1,len/2-1);if(faceCovAny(x,z,w,d,nx,nz,[t-0.95,t,t+0.95],[0.3,1.2,2.8],self))continue;const[a,b]=P(t);const dm=pick(MAT.door);deco(alongX?GEO.doorZ:GEO.doorX,dm,a,1.1,b);DOOR_SPOTS.push([a,b]);
      bx(1.35,0.12,0.1,H.frameD,t,2.26,0.04);bx(0.1,2.3,0.1,H.frameD,t-0.63,1.15,0.04);bx(0.1,2.3,0.1,H.frameD,t+0.63,1.15,0.04);bx(0.1,0.03,0.05,H.metal,t+0.4,1.05,0.09);
