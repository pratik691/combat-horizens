       vec3 sM=vec3(0.80,0.75,0.62);sC.rgb=sM+(sC.rgb-sM)*mix(1.55,2.1,sW.x);sC.rgb*=(0.8+0.2*fbm(vGW*0.018+vec2(9.,3.)))*0.92;float sD=length(vViewPosition);
