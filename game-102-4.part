  const grp=new THREE.Group();grp.scale.setScalar(1/k);g.add(grp);
  let s=new V3().crossVectors(a,new V3(0,0,1));if(s.lengthSq()<1e-4)s=new V3(1,0,0);s.normalize();if(left)s.negate();const u=new V3().crossVectors(s,a).normalize();
  const fist=p0.clone().addScaledVector(a,L*0.11),wrist=p0.clone().addScaledVector(a,L*0.3);
  const q=new THREE.Quaternion().setFromRotationMatrix(new THREE.Matrix4().makeBasis(s,u,a));
  // palm / back of the hand
  hSph(grp,M.glove,fist.clone().addScaledVector(a,r*0.35),r*0.82,r*0.62,r*1.15,q);
  hSph(grp,M.pad,fist.clone().addScaledVector(a,r*0.3).addScaledVector(u,r*0.5),r*0.6,r*0.2,r*0.8,q);
  // four curled fingers wrapping round the grip (axis = s), knuckles toward the tip of the hand
  const ring=new THREE.Quaternion().setFromRotationMatrix(new THREE.Matrix4().makeBasis(a.clone().negate(),u,s));
  const fr=r*0.5,ft=r*0.24;
  [-0.6,-0.2,0.2,0.58].forEach((o,i)=>{const cc=fist.clone().addScaledVector(s,o*r).addScaledVector(a,-r*0.35);const T=ft*(i===3?0.85:1);
    hArc(grp,M.glove,fr,T,-1.3,1.95,ring,cc);hSph(grp,M.pad,hRing(cc,a.clone().negate(),u,fr,-1.3),T*1.15,T*1.15,T*1.15);});
  // thumb along the side, pointing forward
  const t0=fist.clone().addScaledVector(s,-r*0.85).addScaledVector(u,r*0.2).addScaledVector(a,r*0.3),t1=t0.clone().addScaledVector(a,-r*0.95).addScaledVector(u,r*0.25);
  hLimb(grp,M.glove,t0,t1,r*0.27,r*0.23);
  hLimb(grp,M.glove,fist.clone().addScaledVector(a,r*0.6),wrist,r*0.68,r*0.7,14,false);
  hArm(grp,M,wrist,p1,r*0.95,r*1.55);
  grp.traverse(o=>{if(o.isMesh)o.userData.arm=1;});return grp;}
function isArmMesh(o){return o.userData&&o.userData.arm||Object.values(ARM_MAT).includes(o.material);}
function geoBuild(data,mat,opts={}){
  const root=new THREE.Group(),bones={},rest={},list=[];
  for(const b of data.b){const g=new THREE.Group();g.name=b[0];g.userData.piv=[-b[2],b[3],b[4]];list.push(g);bones[b[0]]=g;}
  data.b.forEach((b,i)=>{const g=list[i],P=g.userData.piv,pp=b[1]>=0?list[b[1]].userData.piv:[0,0,0];
    g.position.set(P[0]-pp[0],P[1]-pp[1],P[2]-pp[2]);g.rotation.order='ZYX';g.rotation.set(-b[5]*DEG,-b[6]*DEG,b[7]*DEG);
    rest[g.name]={p:g.position.clone(),r:new V3(g.rotation.x,g.rotation.y,g.rotation.z)};(b[1]>=0?list[b[1]]:root).add(g);});
  const per={};for(const c of data.c)(per[c[0]]=per[c[0]]||[]).push(c);
  const viewish=i=>{let k=i;while(k>=0){if(/view/i.test(data.b[k][0]))return true;k=data.b[k][1];}return false;};
  const mesh=(pos,uv,m,g)=>{if(!pos.length)return;const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));geo.setAttribute('uv',new THREE.Float32BufferAttribute(uv,2));geo.computeVertexNormals();const me=new THREE.Mesh(geo,m);g.add(me);return me;};
  for(const bi in per){const g=list[bi],nm=g.name,bp=g.userData.piv;
    if((opts.skipBone&&opts.skipBone(nm))||viewish(+bi))continue;
    if(/hand_pos$/.test(nm)){if(!opts.arms)continue;
      for(const c of per[bi]){try{realArmFromCube(g,c,bp,/left/i.test(nm));}catch(e){console.warn('arm',e);}}
      continue;}
    const pos=[],uv=[];for(const c of per[bi])addCube(c,bp,pos,uv,data.tw,data.th);mesh(pos,uv,mat,g);}
  return{root,bones,rest};
}
function realMaterial(tex){const U=tex&&tex.userData||{};const mode=U.mode||'stock';
  return new THREE.MeshPhongMaterial({map:tex,side:THREE.DoubleSide,alphaTest:0.35,specular:mode==='gold'?0x3a2a0c:mode==='paint'?0x24272c:0x1a1c20,shininess:mode==='gold'?90:80,specularMap:U.spec||null,envMap:mode==='gold'?null:gunEnv(),combine:THREE.MixOperation,reflectivity:mode==='paint'?0.16:0.12,emissive:mode==='gold'?0x2a1a00:0x000000});}
function attachParts(id,B,mat){
  const add=(attId,boneName)=>{const A=HZ.att[attId],bone=B.bones[boneName];if(!A||!bone)return;const im=HZIMG[A.tex];const t=im&&im.naturalWidth?texFromImg(im,A.tex):null;
    const g=geoBuild(A,realMaterial(t),{skipBone:n=>/view|division|reticle|lens/i.test(n)});bone.add(g.root);};
  const bid=realBase(id);if(bid==='awp')add('awp_scope','scope_pos');
  if(bid==='usp'||id==='m4a1s')add('usp_silencer','muzzle_pos');
}
/* ---- animation sampling (Bedrock keyframes, linear + catmull-rom) ---- */
function sampleCh(ch,t){
  if(!Array.isArray(ch[0]))return ch;
  const n=ch.length;if(t<=ch[0][0])return ch[0][3]||ch[0][1];if(t>=ch[n-1][0])return ch[n-1][1];
  let i=0;while(i<n-2&&ch[i+1][0]<t)i++;
  const a=ch[i],b=ch[i+1],k=(t-a[0])/Math.max(1e-6,b[0]-a[0]);const A=a[1],B=b[3]||b[1];
  if(a[2]||b[2]){const P0=(ch[i-1]||a)[1],P3=(ch[i+2]||b)[1],k2=k*k,k3=k2*k;
    return[0,1,2].map(j=>0.5*(2*A[j]+(-P0[j]+B[j])*k+(2*P0[j]-5*A[j]+4*B[j]-P3[j])*k2+(-P0[j]+3*A[j]-3*B[j]+P3[j])*k3));}
  return[A[0]+(B[0]-A[0])*k,A[1]+(B[1]-A[1])*k,A[2]+(B[2]-A[2])*k];
}
class RealAnim{
  constructor(id,B){this.id=id;this.B=B;this.set=HZ.anims[id]||{};this.main=null;this.t=0;this.st=0;this.speed=1;this.si=0;this.touched=new Set();}
  has(n){return !!this.set[n];}
  play(n,speed=1){const a=this.set[n];if(!a)return false;this.main={n,a};this.t=0;this.speed=speed;this.si=0;return true;}
  is(n){return this.main&&this.main.n.startsWith(n);}
  stop(){this.main=null;}
  update(dt,silent){
    this.st+=dt;
    if(this.main){this.t+=dt*this.speed;const se=this.main.a.s;
      while(this.si<se.length&&se[this.si][0]<=this.t){if(!silent)playHZ(se[this.si][1],0.75);this.si++;}
      if(this.t>=this.main.a.l+0.02)this.main=null;}
    const st=this.set.static_idle,mb=this.main&&this.main.a.b,stb=st?st.b:{};const stT=st&&st.l?this.st%st.l:0;
    const names=new Set([...Object.keys(stb),...(mb?Object.keys(mb):[])]);
    for(const n of this.touched)if(!names.has(n)){const g=this.B.bones[n],r=this.B.rest[n];if(g){g.position.copy(r.p);g.rotation.set(r.r.x,r.r.y,r.r.z);g.scale.set(1,1,1);}}
    this.touched=names;
    for(const n of names){const g=this.B.bones[n];if(!g)continue;const r=this.B.rest[n];const m=mb&&mb[n],s=stb[n];
      const ch=c=>m&&m[c]?sampleCh(m[c],this.t):s&&s[c]?sampleCh(s[c],stT):null;
      const p=ch('position'),ro=ch('rotation'),sc=ch('scale');
      if(p)g.position.set(r.p.x-p[0],r.p.y+p[1],r.p.z+p[2]);else g.position.copy(r.p);
      if(ro)g.rotation.set(r.r.x-ro[0]*DEG,r.r.y-ro[1]*DEG,r.r.z+ro[2]*DEG);else g.rotation.set(r.r.x,r.r.y,r.r.z);
      if(sc)g.scale.set(sc[0],sc[1],sc[2]);else g.scale.set(1,1,1);}
  }
}
/* ---- first-person real viewmodel ---- */
const VM_S=1/40;
window.REAL_OFF={rifle:[0.1,-0.105,-0.04,0.25,1.2,-2.5],sniper:[0.1,-0.11,-0.06,0.25,1.1,-2.5],smg:[0.085,-0.095,-0.03,0.3,1.4,-2.5],pistol:[0.07,-0.078,0,0.3,1.8,-2.5],melee:[0,0,0,0,0,0]};const REAL_OFF=window.REAL_OFF;
function makeRealVM(id,pid,variant,fm){
  const tex=realTexFor(id,pid,variant);const mat=realMaterial(tex);
  const B=geoBuild(HZ.models[id],mat,{arms:true});attachParts(id,B,mat);
  const outer=new THREE.Group(),pivot=new THREE.Group(),inner=B.root;inner.scale.setScalar(VM_S);
  const cam=B.bones.camera||B.bones.idle_view;const cp=cam?cam.userData.piv:[0,16,12];
  inner.position.set(-cp[0]*VM_S,-cp[1]*VM_S,-cp[2]*VM_S);pivot.add(inner);outer.add(pivot);
  let flash=null;const mz=B.bones.muzzle_pos||B.bones.muzzle_flash;
  if(mz&&fm){flash=new THREE.Group();for(let i=0;i<3;i++){const pl=new THREE.Mesh(new THREE.PlaneGeometry(0.17,0.17),fm);pl.rotation.z=i*1.05;flash.add(pl);}flash.scale.setScalar(1/VM_S);flash.visible=false;mz.add(flash);}
  const anim=new RealAnim(id,B);anim.update(0,true);
  const w=WEAPONS[id];
  if(w.melee){outer.updateMatrixWorld(true);const bb=new THREE.Box3();inner.traverse(o=>{if(o.isMesh&&!isArmMesh(o)){o.geometry.computeBoundingBox();bb.union(o.geometry.boundingBox.clone().applyMatrix4(o.matrixWorld));}});
    if(!bb.isEmpty())inner.position.add(new V3(0.13,-0.165,-0.36).sub(bb.getCenter(new V3())));}
  let hip=[0,0,0,0,0,0],ads=[0,0,0];
  if(!w.melee){const o=REAL_OFF[id]||REAL_OFF[w.cat]||REAL_OFF.rifle;hip=[o[0],o[1],o[2],(o[3]||0)*DEG,(o[4]||0)*DEG,(o[5]||0)*DEG];
    pivot.position.set(0,0,0);pivot.rotation.set(0,0,0);outer.updateMatrixWorld(true);
    const bb=new THREE.Box3(),parts=[];inner.traverse(m=>{if(m.isMesh&&!isArmMesh(m)&&m.parent!==flash){m.geometry.computeBoundingBox();const b=m.geometry.boundingBox.clone().applyMatrix4(m.matrixWorld);bb.union(b);parts.push(b);}});
    const zf=bb.min.z+(bb.max.z-bb.min.z)*0.42;let top=-1e9,xs=0,n=0;
    for(const b of parts){if((b.min.z+b.max.z)/2<zf){top=Math.max(top,b.max.y);xs+=(b.min.x+b.max.x)/2;n++;}}
    let mx=n?xs/n:(bb.min.x+bb.max.x)/2;if(mz){const v=new V3();mz.getWorldPosition(v);mx=v.x;}
    ads=[-mx,-(top>-1e8?top:bb.max.y)-0.005,0.035];
    pivot.position.set(hip[0],hip[1],hip[2]);pivot.rotation.set(hip[3],hip[4],hip[5]);}
  return{id,outer,B,anim,flash,real:true,tex,pivot,hip,ads};
}
/* static, meter-scaled model (no arms) for icons and the lobby operator */
const REAL_LEN={pistol:0.24,smg:0.5,rifle:0.9,sniper:1.2,melee:0.3};
function makeRealStatic(id,pid,variant){
  const tex=realTexFor(id,pid,variant);const mat=realMaterial(tex);const B=geoBuild(HZ.models[id],mat,{arms:false});attachParts(id,B,mat);
  const an=new RealAnim(id,B);if(WEAPONS[id].melee){an.update(0.001,true);}
  const outer=new THREE.Group();outer.add(B.root);B.root.updateMatrixWorld(true);
  const box=new THREE.Box3().setFromObject(B.root),sz=box.getSize(new V3()),c=box.getCenter(new V3());
  const L=Math.max(sz.x,sz.y,sz.z)||1,s=(REAL_LEN[WEAPONS[id].cat]||0.6)/L;
  B.root.scale.setScalar(s);B.root.position.set(-c.x*s,-c.y*s,-c.z*s);return outer;
}
let _realIconPending=false;
function realIcon(id,pid,variant){
  const key='r|'+id+'|'+(pid||'')+'|'+(variant||'');if(_svgCache[key])return _svgCache[key];
  if(!hzReady){_realIconPending=true;return null;}
  const g=makeRealStatic(id,pid,variant);
  if(WEAPONS[id].melee){const box=new THREE.Box3().setFromObject(g),sz=box.getSize(new V3());if(sz.x>sz.z)g.rotation.y=Math.PI/2;}
  const url=snap(g,256,128,'side');
  g.traverse(o=>{if(o.geometry)o.geometry.dispose();});
  return _svgCache[key]=url;
}
/* ---- real sound samples ---- */
const HZB={};
function loadHZ(){if(!actx)return;const all=Object.assign({},HZ.snd,(window.CR_NADEPK&&CR_NADEPK.snd)||{},window.CR_KTN_SND||{},window.CR_NADE_SND||{});for(const k in HZ.kisnd)all['ki:'+k]=HZ.kisnd[k];
  for(const k in all){try{const p=actx.decodeAudioData(b64buf(all[k]),b=>{HZB[k]=b;},()=>{});if(p&&p.catch)p.catch(()=>{});}catch(e){}}}
function playHZ(id,vol=1,rate=1,pos){
  if(!actx)return false;const b=HZB[id]||HZB['gp:'+id]||HZB['kp:'+id];if(!b)return false;
  const sp=spatial(pos);if(sp.vol<0.03)return true;const s=actx.createBufferSource();s.buffer=b;s.playbackRate.value=rate*(0.97+Math.random()*0.06);
  s.connect(bus(vol*sp.vol,sp.pan,pos?0.25:0.08));s.start();return true;}
/* every gun gets a real recorded shot: own sample, or the closest one re-pitched */
const SHOT_MAP={ak47:['ak47m/ak47_01',1],galil:['ak47m/ak47_01',1.06],famas:['ak47m/ak47_01',1.12],m4a4:['ak47m/ak47_01',1.16],sg553:['ak47m/ak47_01',0.95],aug:['ak47m/ak47_01',1.1],
  m249:['ak47m/ak47_01',0.88],negev:['mac10/mac10',0.8],m4a1s:['usp/usp_shoot',0.82],mp5:['usp/usp_shoot',0.95],usp:['usp/usp_shoot',1],
  awp:['awp/awp_01',1],ssg08:['awp/awp_01',1.25],barrett:['awp/awp_01',0.82],scar20:['awp/awp_01',1.18],g3sg1:['awp/awp_01',1.14],m1a:['awp/awp_01',1.1],
  glock:['glock18/glock18',1],p2000:['usp/usp_unsilenced',1],p250:['p250/p250_01',1],fiveseven:['p250/p250_01',1.12],cz75:['glock18/glock18',0.94],dualies:['glock18/glock18',1.06],
  tec9:['tec9/tec9_02',1],deagle:['p250/p250_01',0.74],r8:['p250/p250_01',0.68],mac10:['mac10/mac10',1],mp9:['mp9/mp9_01',1],mp7:['mp9/mp9_01',0.94],ump45:['mac10/mac10',0.9],
  bizon:['mac10/mac10',1.06],p90:['mp9/mp9_01',1.1],thompson:['mac10/mac10',0.84]};
const DISTANT={'ak47m/ak47_01':'ak47m/ak47_distant','awp/awp_01':'awp/awp_distant','p250/p250_01':'p250/p250_distant_01','mp9/mp9_01':'mp9/mp9-1-distant'};
function realShot(id,pos){const m=SHOT_MAP[id];if(!m)return false;let s=m[0];const d=pos?Math.hypot(pos.x-player.pos.x,pos.z-player.pos.z):0;
  if(d>32&&DISTANT[s]&&HZB['gp:'+DISTANT[s]])s=DISTANT[s];return playHZ('gp:'+s,pos?1:0.8,m[1],pos);}
/* ---- kill banner (rolling skulls, combo medals, kill cards) ---- */
const KB={skulls:0,t:0,el:null};
function killBanner(n,head,ace){
  const el=$('kban');if(!el||!HZ.ki.kill)return;
  KB.t=3.2;KB.skulls=Math.min(n,6);
  const card=ace?HZ.ki.cardace:HZ.ki['card'+Math.min(n,4)];
  const combo=n>=2?HZ.ki['combo'+Math.min(n-1,6)]:'';
  el.innerHTML=`<div class="kb-card"><img class="kb-light" src="${HZ.ki.light}"><img src="${card}"></div><div class="kb-row">${Array.from({length:KB.skulls},(_,i)=>`<img class="kb-sk ${i===KB.skulls-1?'new':''}" src="${i===KB.skulls-1&&head?HZ.ki.head:HZ.ki.kill}">`).join('')}</div>${combo?`<img class="kb-combo" src="${combo}">`:''}`;
  el.className='show';void el.offsetWidth;el.classList.add('pop');
  if(ace)playHZ('ki:ultimatekill_sound',0.9);else if(n>=2)playHZ('ki:combo_'+Math.min(n-1,6),0.85);else playHZ('ki:kill_sound',0.8);
}
function updateKillBanner(dt){if(KB.t>0){KB.t-=dt;if(KB.t<=0){const el=$('kban');if(el)el.className='';}}}
/* ---- starter kit for new players ---- */
const STARTER_GUNS=['ak47','awp','glock'],STARTER_KNIVES=['knife','classic','bayonet'];
const STARTER_NADES=['he','flashbang','smoke','molotov'];
function grantKatana(){if(!save.items.some(i=>i.k==='ktn'&&i.s==='wooden'))addItem({k:'ktn',s:'wooden',starter:1});}
function grantStarterNades(){grantKatana();if(save.starterNades)return false;save.starterNades=1;for(const n of STARTER_NADES)if(!save.items.some(i=>i.k==='nade'&&i.n===n))addItem({k:'nade',n,starter:1});persist();return true;}
function starterNadeLoadout(){const off=save.nadeOff||{};return STARTER_NADES.filter(n=>!off[n]&&save.items.some(i=>i.k==='nade'&&i.n===n));}
function giveStarterNades(p){if(!(S.mode==='tdm'||S.mode==='ffa'||S.mode==='practice'))return;const l=starterNadeLoadout();if(!l.length)return;for(const n of l)if(!p.nades.includes(n)&&p.nades.length<4)p.nades.push(n);refreshNades();}
function grantStarter(){
  grantStarterNades();
  if(save.starterKit)return false;save.starterKit=1;
  for(const w of STARTER_GUNS){const it=addItem({k:'skin',w,p:'stock',starter:1});if(!save.equipSkin[w])save.equipSkin[w]=it.uid;}
  if(!save.knife||!WEAPONS[save.knife]||save.knife==='knife')save.knife='classic';
  save.spawnPrimary=save.spawnPrimary||'ak47';persist();return true;
}
function showWelcome(){
  const m=$('welcome');if(!m)return;
  $('wcItems').innerHTML=[...STARTER_GUNS.map(w=>({k:'skin',w,p:'stock'})),...STARTER_KNIVES.map(w=>({k:'knife',w})),...STARTER_NADES.map(n=>({k:'nade',n}))].map(it=>itemCardHtml(it)).join('');
  m.classList.remove('hidden');
}

/* ---------- loadout ---------- */
const LD_GROUPS=[['start','STARTING PISTOL',['pistol']],['pistols','OTHER PISTOLS',['pistol']],['mid','MID-TIER',['smg','shotgun','mg']],['rifles','RIFLES',['rifle','sniper','dmr']]];
function defaultLoadout(){return{T:{start:'glock',pistols:['dualies','p250','tec9','deagle'],mid:['mac10','ump45','nova','xm1014','negev'],rifles:['galil','ak47','ssg08','sg553','awp']},
  CT:{start:'usp',pistols:['dualies','p250','fiveseven','deagle'],mid:['mp9','ump45','nova','mag7','m249'],rifles:['famas','m4a4','ssg08','aug','awp']}};}
function LD(){if(!save.loadout||!save.loadout.T||!save.loadout.CT)save.loadout=defaultLoadout();return save.loadout;}
function startPistolFor(team){const L=LD()[team==='CT'?'CT':'T'];return WEAPONS[L.start]?L.start:(team==='CT'?'usp':'glock');}
function buyColumns(){if(S.mode==='defuse'){const L=LD()[player.team==='CT'?'CT':'T'];return[['PISTOLS',[L.start,...L.pistols]],['MID-TIER',L.mid],['RIFLES',L.rifles],['GEAR',['med','armor','he','flashbang','smoke','molotov','incendiary','decoy','zeus','kit','ammo']]];}return SHOP;}
let ldSide='T';
function ldSlotList(side,g){const L=LD()[side];return g==='start'?[L.start]:L[g];}
function wCard(id,attrs=''){const w=WEAPONS[id];const pid=equippedPaint(id);const r=pid?PAINTS[pid].r:0;
  return `<div class="ic r" style="--rc:${RAR[r].c}" ${attrs}><div class="ic-img"><img src="${weaponIcon(id,pid)}" alt=""></div><div class="ic-n">${esc(w.name)}</div><div class="ic-f">${pid?esc(PAINTS[pid].n):'&nbsp;'}</div></div>`;}
function renderLoadout(){
  $('ldSpawn').innerHTML=[['ak47','AK-47'],['awp','AWP']].map(([v,l])=>`<button data-w="${v}" class="${(save.spawnPrimary||'ak47')===v?'on':''}">${l}</button>`).join('');
  $('ldSide').innerHTML=[['T','ATTACK · T'],['CT','DEFENSE · CT']].map(([v,l])=>`<button data-s="${v}" class="${ldSide===v?'on':''}">${l}</button>`).join('');
  let h='';
  h+=`<div class="ldcol"><div class="ldh">▾ STARTING PISTOL</div>${wCard(LD()[ldSide].start,'data-g="start" data-i="0"')}<div class="ldh">▾ OTHER PISTOLS</div>${LD()[ldSide].pistols.map((id,i)=>wCard(id,`data-g="pistols" data-i="${i}"`)).join('')}</div>`;
  for(const g of['mid','rifles'])h+=`<div class="ldcol"><div class="ldh">▾ ${g==='mid'?'MID-TIER':'RIFLES'}</div>${ldSlotList(ldSide,g).map((id,i)=>wCard(id,`data-g="${g}" data-i="${i}"`)).join('')}</div>`;
  const kid=knifeId(),kf=FINS[save.knifeFin]?save.knifeFin:'';const ag=save.agent||'operator';const md=save.medal&&MEDAL_BY[save.medal];
  h+=`<div class="ldcol slim"><div class="ldh">▾ KNIFE</div><div class="ic r" style="--rc:${RAR[6].c}" data-x="knife"><div class="ic-img"><img src="${knifeIcon(kid,kf)}"></div><div class="ic-n">★ ${esc(WEAPONS[kid].name)}</div><div class="ic-f">${kf?esc(FINS[kf].n):'Vanilla'}</div></div>
    <div class="ldh">▾ AGENT</div><div class="ic r tall" style="--rc:${RAR[AGENTS[ag].r].c}" data-x="agent"><div class="ic-img"><img src="${agentIcon(ag)}"></div><div class="ic-n">${esc(AGENTS[ag].n)}</div><div class="ic-f">Agent</div></div>
    <div class="ldh">▾ DISPLAY MEDAL</div><div class="ic r" style="--rc:${md?RAR[md.r].c:'#555'}" data-x="medal"><div class="ic-img">${md?medalSvg(md,64):'<span class="sub">none</span>'}</div><div class="ic-n">${md?esc(md.n):'No medal'}</div><div class="ic-f">&nbsp;</div></div></div>`;
  $('ldCols').innerHTML=h;
  showOperatorWeapon(LD()[ldSide].rifles[1]||LD()[ldSide].start);
}
function openPicker(title,cards,onPick){$('pkTitle').textContent=title;$('pkGrid').innerHTML=cards.join('')||'<div class="sub">Nothing here yet.</div>';$('picker').classList.remove('hidden');PICK=onPick;}
let PICK=null;
$('pkGrid').addEventListener('click',e=>{const c=e.target.closest('[data-pk]');if(!c||!PICK)return;PICK(c.dataset.pk);$('picker').classList.add('hidden');sfx('buy');});
$('pkClose').onclick=()=>$('picker').classList.add('hidden');
$('ldSpawn').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;save.spawnPrimary=b.dataset.w;persist();renderLoadout();sfx('click');});
$('ldSide').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;ldSide=b.dataset.s;renderLoadout();sfx('click');});
$('ldCols').addEventListener('mouseover',e=>{const c=e.target.closest('[data-g]');if(c){const g=c.dataset.g,i=+c.dataset.i;showOperatorWeapon(ldSlotList(ldSide,g)[i]);}});
$('ldCols').addEventListener('click',e=>{
  const c=e.target.closest('[data-g],[data-x]');if(!c)return;sfx('click');
  if(c.dataset.x==='knife'){openPicker('CHOOSE KNIFE',KNIVES.map(([id,n,l])=>(save.level>=l||save.allKnives)?`<div data-pk="${id}">${(()=>{const s=`<div class="ic r" style="--rc:${RAR[6].c}"><div class="ic-img"><img src="${knifeIcon(id,FINS[save.knifeFin]?save.knifeFin:'')}"></div><div class="ic-n">★ ${esc(n)}</div><div class="ic-f">${knifeId()===id?'Equipped':'Unlocked'}</div></div>`;return s;})()}</div>`:`<div class="ic r lock" style="--rc:#444"><div class="ic-img"><span class="sub">🔒 Level ${l}</span></div><div class="ic-n">★ ${esc(n)}</div><div class="ic-f">Locked</div></div>`),id=>{save.knife=id;persist();renderMenu();rebuildOperator();});return;}
  if(c.dataset.x==='agent'){const owned=['operator',...new Set(save.items.filter(i=>i.k==='agent').map(i=>i.a))];openPicker('CHOOSE AGENT',owned.map(a=>`<div data-pk="${a}"><div class="ic r tall" style="--rc:${RAR[AGENTS[a].r].c}"><div class="ic-img"><img src="${agentIcon(a)}"></div><div class="ic-n">${esc(AGENTS[a].n)}</div><div class="ic-f" style="color:${agSig(a).hex}">${agSig(a).glyph} ${esc(agSig(a).perk)}${(save.agent||'operator')===a?' · Equipped':''}</div></div></div>`),a=>{save.agent=a;persist();rebuildOperator();renderMenu();try{agLobbyTint();agKillPreview();}catch(e){}});return;}
  if(c.dataset.x==='medal'){openPicker('DISPLAY MEDAL',[`<div data-pk=""><div class="ic r" style="--rc:#555"><div class="ic-img"><span class="sub">none</span></div><div class="ic-n">No medal</div><div class="ic-f">&nbsp;</div></div></div>`,...MEDAL_DEFS.filter(m=>m.ok()).map(m=>`<div data-pk="${m.id}"><div class="ic r" style="--rc:${RAR[m.r].c}"><div class="ic-img">${medalSvg(m,64)}</div><div class="ic-n">${esc(m.n)}</div><div class="ic-f">${esc(m.d)}</div></div></div>`)],id=>{save.medal=id;persist();renderMenu();});return;}
  const g=c.dataset.g,i=+c.dataset.i;const cats=LD_GROUPS.find(x=>x[0]===g)[2];const L=LD()[ldSide];const cur=ldSlotList(ldSide,g)[i];
  const cands=GUN_IDS.filter(id=>{const w=WEAPONS[id];return cats.includes(w.cat)&&(!w.side||w.side===ldSide);});
  openPicker(`${g==='start'?'STARTING PISTOL':g.toUpperCase()} · ${ldSide==='T'?'ATTACK':'DEFENSE'} · slot ${i+1}`,cands.map(id=>`<div data-pk="${id}" class="${id===cur?'pkcur':''}">${wCard(id)}</div>`),id=>{
    const all=['start','pistols','mid','rifles'];
    for(const gg of all){const arr=gg==='start'?null:L[gg];if(gg==='start'){if(L.start===id&&!(g==='start'))L.start=cur;}else{const j=arr.indexOf(id);if(j>=0&&!(gg===g&&j===i))arr[j]=cur;}}
    if(g==='start')L.start=id;else L[g][i]=id;persist();renderLoadout();});
});
/* operator holds the hovered weapon */
let opWeapon=null;
function showOperatorWeapon(id){if(!id||!WEAPONS[id])return;const M=getIconModels();const src=M[id];if(!src)return;
  if(opWeapon){operator.gun.remove(opWeapon);opWeapon=null;}
  for(const c of operator.gun.children)if(!c.userData.hand)c.visible=false;
  const m=src.clone(true);const pid=equippedPaint(id);if(pid){const mat=paintMat(pid);m.traverse(o=>{if(o.isMesh&&o.material===iconSkin)o.material=mat;});}
  m.traverse(o=>{if(o.isMesh)o.castShadow=true;});m.rotation.y=Math.PI;m.scale.setScalar(WEAPONS[id].cat==='pistol'?1.25:1.05);m.position.set(-0.02,0.04,WEAPONS[id].cat==='pistol'?0.02:0.12);
  operator.gun.add(m);opWeapon=m;}
function rebuildOperator(){try{agLobbyTint();}catch(e){}const was=operator.g.parent;const pos=operator.g.position.clone(),rot=operator.g.rotation.y;if(was)scene.remove(operator.g);
  const n=makeSoldier(0xb08a3e,agentPal(save.agent));Object.assign(operator,n);operator.g.position.copy(pos);operator.g.rotation.y=rot;if(was)scene.add(operator.g);opWeapon=null;
  showOperatorWeapon(LD()[ldSide].rifles[1]||'ak47');}
/* ---------- inventory ---------- */
let invF='all',invQ='',invSort='new',invSel=null,invLimit=120;
document.addEventListener('click',e=>{if(e.target&&e.target.id==='invMore'){invLimit+=120;renderInventory();}});
function renderInventory(){
  let items=allItems().map(it=>({it,i:info(it)}));
  if(invF!=='all')items=items.filter(x=>x.i.type===invF);
  if(invQ){const q=invQ.toLowerCase();items=items.filter(x=>(x.i.top+' '+x.i.bot).toLowerCase().includes(q));}
  items.sort(invSort==='rarity'?(a,b)=>b.i.r-a.i.r||(b.it.t-a.it.t):invSort==='name'?(a,b)=>(a.i.top+a.i.bot).localeCompare(b.i.top+b.i.bot):(a,b)=>(b.it.t||0)-(a.it.t||0)||b.i.r-a.i.r);
  $('invCount').textContent=items.length+' items';
  const total=items.length;if(invSel){const k=items.findIndex(x=>x.it.uid===invSel);if(k>=invLimit)invLimit=k+1;}items=items.slice(0,invLimit);
  $('invGrid2').innerHTML=items.map(({it,i})=>`<div class="ic r ${invSel===it.uid?'sel':''}" style="--rc:${RAR[i.r].c}" data-uid="${it.uid}"><div class="ic-img">${i.svg?i.svg.replace(/width="96" height="96"/,'width="64" height="64"'):`<img src="${i.img()}" alt="">`}</div><div class="ic-n">${i.eq?'<span class="eqd">●</span>':''}${esc(i.top)}</div><div class="ic-f">${esc(i.bot)}</div></div>`).join('')+(total>items.length?`<button class="btn inv-more" id="invMore">Show ${Math.min(120,total-items.length)} more · ${total-items.length} left</button>`:'')||'<div class="sub" style="padding:30px">No items match.</div>';
  renderItemPanel();
}
function renderItemPanel(){
  const it=invSel&&allItems().find(x=>x.uid===invSel);const el=$('itemPanel');
  if(!it){el.classList.add('hidden');return;}el.classList.remove('hidden');const i=info(it);
  let body='',btns='';
  if(it.k==='skin'||it.k==='knife'){const w=WEAPONS[it.w];
    if(!w.melee){const bar=(l,v)=>`<div class="stat"><span>${l}</span><div class="sb"><i style="width:${clamp(v,0,100)}%"></i></div></div>`;const dmg=w.pellets?w.dmg*w.pellets:w.dmg;
      body=`<div class="wt">${CAT_NAME[w.cat]}${w.side?' · '+w.side+' only':''} · $${w.price} · kill $${w.reward} · mag ${w.mag}</div>`+bar('Damage',dmg/170*100)+bar('Fire rate',(1/w.rate)/14*100)+bar('Range',w.range/120*100)+bar('Mobility',(w.speed-3.4)/1.4*100)+`<div class="ipat">${patternSvg(w)}<span class="sub">Spray pattern</span></div>`;}
    else body=`<div class="wt">Knife · unlocked at level ${w.unlock} · kill reward $${w.reward}</div>`;}
  else if(it.k==='medal')body=`<div class="wt">${esc(MEDAL_BY[it.m].d)}</div>`;
  else if(it.k==='agent'){const G=agSig(it.a);body=`<div class="agperk" style="--ag:${G.hex}"><i>${G.glyph}</i><div><b>${esc(G.perk)}</b><span>${esc(G.d)}</span></div></div>`+(it.a!=='operator'?`<div class="wt">Signature kill effect: ${G.glyph} burst in ${esc(AGENTS[it.a].n)} colours. Your lobby pad glows in the same colour. Health perks work in bot matches and rooms you host.</div>`:'<div class="wt">Your character model. Other players see it online.</div>');}
  else if(it.k==='fin')body=`<div class="wt">Blade finish — applies to whichever knife you have equipped.</div>`;
  if(it.k==='skin')btns=i.eq?`<button class="btn" data-act="unequip">Unequip</button>`:`<button class="btn pri" data-act="equip">Equip</button>`;
  if(it.k==='knife')btns=i.eq?'<button class="btn" disabled>Equipped</button>':`<button class="btn pri" data-act="equip">Equip knife</button>`;
  if(it.k==='ktn')btns=i.eq?`<button class="btn" disabled>Equipped</button>`:`<button class="btn pri" data-act="equip">Equip katana</button>`;
  if(it.k==='nade')btns=i.eq?`<button class="btn" data-act="unequip">Remove from loadout</button>`:`<button class="btn pri" data-act="equip">Add to loadout</button>`;
  if(it.k==='kskin')btns=i.eq?`<button class="btn" data-act="unequip">Remove skin</button>`:`<button class="btn pri" data-act="equip">Equip knife</button>`;
  if(it.k==='fin')btns=i.eq?`<button class="btn" data-act="unequip">Remove finish</button>`:`<button class="btn pri" data-act="equip">Apply to knife</button>`;
  if(it.k==='agent')btns=i.eq?'<button class="btn" disabled>Equipped</button>':`<button class="btn pri" data-act="equip">Equip agent</button>`;
  if(it.k==='medal')btns=i.eq?`<button class="btn" data-act="unequip">Hide from profile</button>`:`<button class="btn pri" data-act="equip">Display on profile</button>`;
  if(i.price&&save.items.includes(it))btns+=`<button class="btn" data-act="sell">Sell ⛃ ${Math.floor(i.price*0.4)}</button>`;
  el.innerHTML=`<div class="ip-img" style="--rc:${RAR[i.r].c}">${i.svg?i.svg:`<img src="${i.img()}">`}</div><div class="ip-r" style="color:${RAR[i.r].c}">${RAR[i.r].n.toUpperCase()}</div><div class="ip-n">${esc(i.top)}</div><div class="ip-f">${esc(i.bot)}</div>${body}<div class="ip-b">${btns}</div>`;
}
$('invFilter').onchange=e=>{invF=e.target.value;invLimit=120;renderInventory();};
$('invSort').onchange=e=>{invSort=e.target.value;renderInventory();};
$('invSearch').oninput=e=>{invQ=e.target.value;invLimit=120;renderInventory();};
$('invGrid2').addEventListener('click',e=>{const c=e.target.closest('[data-uid]');if(!c)return;invSel=c.dataset.uid;sfx('click');renderInventory();});
$('itemPanel').addEventListener('click',e=>{const b=e.target.closest('[data-act]');if(!b)return;const it=allItems().find(x=>x.uid===invSel);if(!it)return;const a=b.dataset.act;
  if(a==='equip'&&it.k==='ktn'){save.katanaSkin=it.s;save.knife='katana';save.kskin='';}
  if(a==='equip'&&it.k==='nade'){save.nadeOff=save.nadeOff||{};delete save.nadeOff[it.n];}
  if(a==='unequip'&&it.k==='nade'){save.nadeOff=save.nadeOff||{};save.nadeOff[it.n]=1;}
  if(a==='equip'){if(it.k==='skin'){save.equipSkin[it.w]=it.uid;if(it.w==='awp'||it.w==='ak47')save.spawnPrimary=it.w;}if(it.k==='knife')save.knife=it.w;if(it.k==='fin'){save.knifeFin=it.f;save.kskin='';}if(it.k==='kskin'){save.kskin=it.v;save.knife=HZ.kv[it.v].w;}if(it.k==='knife'&&save.kskin&&HZ.kv[save.kskin]&&HZ.kv[save.kskin].w!==it.w)save.kskin='';if(it.k==='agent'){save.agent=it.a;rebuildOperator();}if(it.k==='medal')save.medal=it.m;sfx('buy');}
  if(a==='unequip'){if(it.k==='skin'){delete save.equipSkin[it.w];if(it.w==='awp'&&save.spawnPrimary==='awp')save.spawnPrimary='ak47';}if(it.k==='fin')save.knifeFin='';if(it.k==='kskin')save.kskin='';if(it.k==='medal')save.medal='';sfx('click');}
  if(a==='sell'){const i=info(it);save.items=save.items.filter(x=>x!==it);if(it.k==='skin'&&save.equipSkin[it.w]===it.uid)delete save.equipSkin[it.w];if(it.k==='fin'&&save.knifeFin===it.f&&!save.items.some(x=>x.k==='fin'&&x.f===it.f))save.knifeFin='';if(it.k==='agent'&&save.agent===it.a&&!save.items.some(x=>x.k==='agent'&&x.a===it.a)){save.agent='operator';rebuildOperator();}save.coins+=Math.floor(i.price*0.4);invSel=null;sfx('pickup');}
  persist();renderMenu();});
/* ---------- store: cases, care package, featured ---------- */
const CASES={
  desert:{n:'Desert Storm Case',price:250,col:['#c9923a','#7a4a1a'],items:[['p250','sand'],['nova','safari_mesh'],['mac10','scorched'],['galil','rust_coat'],['sawedoff','urban_masked'],['mp9','forest_ddpat'],['deagle','damascus_steel'],['famas','bright_water'],['ump45','night'],['m4a4','crimson'],['ak47','case_hardened'],['usp','slaughter'],['awp','tiger_tooth'],['deagle','fade'],['ak47','gold']]},
  neon:{n:'Neon Nights Case',price:400,col:['#19e3c8','#4b2a8a'],items:[['glock','urban'],['mp7','boreal_forest'],['xm1014','arctic'],['p90','blue_steel'],['fiveseven','flip_knife_pattern'],['tec9','freehand'],['mp5','neon'],['m4a1s','ultraviolet'],['glock','blood_web'],['aug','tiger_tooth_blue'],['p90','autotronic'],['ak47','lore'],['m4a1s','doppler'],['awp','emerald'],['glock','gamma_doppler'],['usp','sapphire']]},
  elite:{n:'Horizens Elite Case',price:900,col:['#e4ae39','#5a1a1a'],knife:0.04,items:[['m4a1s','black_laminate'],['awp','cobalt'],['ak47','crimson_web'],['deagle','slaughter'],['usp','case_hardened'],['m4a4','fade'],['awp','doppler'],['ak47','emerald'],['glock','marble_fade'],['deagle','ruby'],['m4a1s','sapphire'],['awp','gold'],['ak47','marble_fade']]}};
const GOLD_FIRST=['ak47','awp','m4a4','deagle'];
CASES.golden={n:'Golden Case',price:5000,col:['#f3c93c','#7a5410'],items:GOLD_FIRST.concat(GUN_IDS.filter(w=>!GOLD_FIRST.includes(w))).filter(w=>WEAPONS[w]).map(w=>[w,'gold'])};
const ODDS=[45,25,16,9,4,1];
const KSKIN_PRICE={bayoauto:4200,buemerald:6500,busnowfall:4800,karobsidian:6000,m9amethyst:5200,m9auto:4500,m9emerald:6200,m9sapphire:7000,stilettosapphire:6400,stilettott:5600};
function rollCase(cid){const C=CASES[cid];if(C.knife&&Math.random()<C.knife&&Math.random()<0.5){const v=Object.keys(HZ.kv);if(v.length)return{k:'kskin',v:v[Math.floor(Math.random()*v.length)]};}if(C.knife&&Math.random()<C.knife){const f=Object.keys(FINS).filter(k=>k!=='vanilla'&&!FINS[k].ex);return{k:'fin',f:f[Math.floor(Math.random()*f.length)]};}
  const by={};const pool=casePool(cid);for(const[w,p]of(pool.length?pool:C.items)){const r=PAINTS[p].r;(by[r]=by[r]||[]).push([w,p]);}const rs=Object.keys(by).map(Number);const tot=rs.reduce((s,r)=>s+(ODDS[r]||0.5),0);
  let x=Math.random()*tot;let r=rs[0];for(const k of rs){x-=ODDS[k]||0.5;if(x<=0){r=k;break;}}const pk=by[r][Math.floor(Math.random()*by[r].length)];return{k:'skin',w:pk[0],p:pk[1]};}
function itemCardHtml(it,extra=''){const i=info(it);return `<div class="ic r" style="--rc:${RAR[i.r].c}" ${extra}><div class="ic-img">${i.svg?i.svg:`<img src="${i.img()}">`}</div><div class="ic-n">${esc(i.top)}</div><div class="ic-f">${esc(i.bot)}</div></div>`;}
function caseArt(c){const best=c.items.reduce((a,b)=>PAINTS[b[1]].r>=PAINTS[a[1]].r?b:a);
  return `<div class="crate-w"><div class="crate-h"></div><div class="crate" style="--c1:${c.col[0]};--c2:${c.col[1]}"><div class="crate-l" style="left:16%"></div><div class="crate-l" style="right:16%"></div><div class="crate-img" style="background-image:url(&quot;${weaponIcon(best[0],best[1])}&quot;)"></div><div class="crate-lbl">${esc(c.n.toUpperCase())}</div></div></div>`;}
function dayKey(){return Math.floor(Date.now()/86400000);}
const SHOP_REF=3;
function shopRoll(){const r=save.shopRef;return r&&r.d===dayKey()?r.n:0;}
function skinPoolOK(p){return !(PAINTS[p].fin&&FINS[PAINTS[p].fin]&&FINS[PAINTS[p].fin].ex);}
/* 0.89: skins that are inside a case can only be won from that case, never bought directly */
function caseOf(w,p){for(const k in CASES){if(CASES[k].items.some(x=>x[0]===w&&x[1]===p))return k;}return null;}
function skinBuyable(w,p){return skinPoolOK(p)&&!caseOf(w,p);}
/* 0.94: a gun skin can only be got once that gun is unlocked */
function skinGunOK(w){return gunOwned(w);}
function casePool(cid){return CASES[cid].items.filter(([w])=>gunOwned(w));}
function ownsSkin(w,p){return save.items.some(i=>i.k==='skin'&&i.w===w&&i.p===p);}
function dayShuffle(arr,salt){const r=mulberry32(dayKey()*7919+shopRoll()*104729+salt),a=arr.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(r()*(i+1));const t=a[i];a[i]=a[j];a[j]=t;}return a;}
function featured(){const r=mulberry32(dayKey()*7919+shopRoll()*104729);const pool=[];for(const id of GUN_IDS)for(const p of Object.keys(PAINTS)){if(!skinBuyable(id,p)||!gunOwned(id))continue;pool.push([id,p]);}const out=[],seen={};let g=0;while(out.length<5&&g++<400){const x=pool[Math.floor(r()*pool.length)];if(seen[x[0]+'|'+x[1]])continue;seen[x[0]+'|'+x[1]]=1;out.push({k:'skin',w:x[0],p:x[1],uid:'f'+out.length});}return out;}
function fmtLeft(ms){const h=Math.ceil(ms/3600000);return h>24?Math.floor(h/24)+'d '+(h%24)+'h':h+'h';}
const REDEEM={FIRSTONE:{n:'Karambit | Obsidian',items:[{k:'kskin',v:'karobsidian'}]},ARENA:{n:'+20 Levels',levels:20,items:[]},
  COMMUNITY26:{n:'★ Butterfly Knife | Emerald',items:[{k:'kskin',v:'buemerald'}]},
  COMBAT:{n:'MAC-10 | Dusk Fade',limit:50,items:[{k:'skin',w:'mac10',p:'fade'}]},
  FREE1:{n:'AK-47 | Sand Viper',limit:100,items:[{k:'skin',w:'ak47',p:'sand_viper'}]},
  BONUS:{n:'500 coins',coins:500,items:[]},
  HORIZENS:{n:'200 coins',coins:200,items:[]},
  /* rank-reward codes (revealed when the reward is claimed in Ranks) */
  'PLAT-7K2Q':{n:'400 coins',coins:400,items:[]},'PLAT-4M9X':{n:'800 coins',coins:800,items:[]},'DIAM-9X4M':{n:'1500 coins',coins:1500,items:[]},'HERO-3R8T':{n:'2500 coins',coins:2500,items:[]},'LGND-5V1W':{n:'5000 coins',coins:5000,items:[]}};
function boostItems(){const out=[];const has=(f)=>save.items.some(f);
  if(window.CR_HZ)for(const v in HZ.kv)if(!has(i=>i.k==='kskin'&&i.v===v))out.push({k:'kskin',v});
  for(const f in FINS)if(f!=='vanilla'&&!has(i=>i.k==='fin'&&i.f===f))out.push({k:'fin',f});
  for(const a in AGENTS)if(a!=='operator'&&!has(i=>i.k==='agent'&&i.a===a))out.push({k:'agent',a});
  const rare=Object.keys(PAINTS).filter(p=>PAINTS[p].r>=4&&p!=='gold'&&!(PAINTS[p].fin&&FINS[PAINTS[p].fin]&&FINS[PAINTS[p].fin].ex));
  for(const w of GUN_IDS){out.push({k:'skin',w,p:'gold'});if(rare.length)out.push({k:'skin',w,p:rare[Math.floor(Math.random()*rare.length)]});}
  return out;}
let rdLast=null;
function redeemCode(raw){const code=String(raw||'').trim().toUpperCase().replace(/\s+/g,'');const m=$('rdMsg');save.redeemed=save.redeemed||[];
  const say=(t,ok)=>{m.textContent=t;m.className='rd-msg '+(ok?'ok':'bad');};
  if(!code){say('Type a code first.');sfx('deny');return false;}
  const R=REDEEM[code];if(!R){say('That code is not valid.');sfx('deny');return false;}
  if(save.redeemed.includes(code)){say('You have already redeemed this code.');sfx('deny');return false;}
  if(R.levels){if(save.level>=MAX_LEVEL){say('You are already at the max level ('+MAX_LEVEL+').');sfx('deny');return false;}
    const from=save.level,target=Math.min(MAX_LEVEL,from+R.levels);let guard=0;while(save.level<target&&guard++<1000)addXP(Math.max(1,xpToNext(save.level)-save.xp));
    save.redeemed.push(code);persist();rdLast={lv:[from,save.level]};$('rdIn').value='';
    say('Code accepted! Level '+from+' → '+save.level,true);sfx('levelup');
    const box=document.querySelector('.redeem');box.classList.remove('pop');void box.offsetWidth;box.classList.add('pop');renderMenu();return true;}
  if(R.ktnAll){let n=0;for(const k of Object.keys(KTN)){if(!save.items.some(i=>i.k==='ktn'&&i.s===k)){addItem({k:'ktn',s:k});n++;}}
    save.redeemed.push(code);persist();$('rdIn').value='';rdLast={big:'⚔',sub:'Katana + Dual Katanas · '+Object.keys(KTN).length+' katana skins'+(n?'':' (already owned)'),title:R.n};
    say('Code accepted! Katana Collection: Katana, Dual Katanas and every katana skin ('+Object.values(KTN).map(x=>x.n).join(', ')+') are yours.',true);sfx('levelup');
    const box=document.querySelector('.redeem');box.classList.remove('pop');void box.offsetWidth;box.classList.add('pop');renderMenu();return true;}
  if(R.boost||R.coins){let n=0;if(R.boost){save.allKnives=1;const list=boostItems();for(const it of list){addItem(it);n++;}}if(R.coins)save.coins+=R.coins;
    save.redeemed.push(code);persist();$('rdIn').value='';rdLast={big:R.coins?'+'+R.coins:'+'+n,sub:R.coins?'coins':'items · all knives unlocked',title:R.n};
    say(R.coins?'Code accepted! +'+R.coins+' coins added.':'Code accepted! Mega Pack: '+n+' items added and every knife unlocked.',true);sfx('levelup');
    const box=document.querySelector('.redeem');box.classList.remove('pop');void box.offsetWidth;box.classList.add('pop');renderMenu();return true;}
  const got=R.items.filter(it=>(it.k!=='kskin'||(window.CR_HZ&&HZ.kv[it.v]))&&(it.k!=='skin'||(WEAPONS[it.w]&&PAINTS[it.p]))).map(it=>addItem(Object.assign({},it)));
  if(!got.length){say('Item data is still loading, try again in a moment.');return false;}
  save.redeemed.push(code);persist();rdLast=got[0];$('rdIn').value='';if(R.limit){got[0].limited=R.limit;persist();}
  say('Code accepted! '+R.n+' was added to your inventory.',true);sfx('levelup');
  const box=document.querySelector('.redeem');box.classList.remove('pop');void box.offsetWidth;box.classList.add('pop');
  renderMenu();return true;}
/* ---------- 3D hard-shell cases (0.86) ---------- */
const CS3={};
const CASE_SK={desert:{b:0xc4601a,e:0x2f9a4a},neon:{b:0x18b8a6,e:0x6a3ad0},elite:{b:0x2c2e35,e:0xe4ae39,t:0xb8892e,x:1},golden:{b:0xa87a16,e:0x16120a,t:0x6a4a0c,g:1}};
function caseModel(c,id){
  const sk=CASE_SK[id]||{};const base=new THREE.Color(sk.b!=null?sk.b:c.col[0]),acc=new THREE.Color(sk.e!=null?sk.e:c.col[1]);
  const W=2.4,D=1.2,HB=0.62,HL=0.46,GAP=0.05,H=HB+GAP+HL,y0=-H/2;
  let plastic=sk.g?new THREE.MeshPhongMaterial({color:base,specular:0xc9a85a,shininess:55}):new THREE.MeshStandardMaterial({color:base,roughness:0.5,metalness:0.04});const el=!!sk.x;
  if(el){const cc=document.createElement('canvas');cc.width=cc.height=64;const k=cc.getContext('2d');
    for(let yy=0;yy<8;yy++)for(let xx=0;xx<8;xx++){const a=(xx+yy)%2;const gr=k.createLinearGradient(xx*8,yy*8,xx*8+8,yy*8+8);gr.addColorStop(0,a?'#343843':'#1a1c22');gr.addColorStop(1,a?'#1a1c22':'#343843');k.fillStyle=gr;k.fillRect(xx*8,yy*8,8,8);}
    const carbon=new THREE.CanvasTexture(cc);carbon.wrapS=carbon.wrapT=THREE.RepeatWrapping;carbon.repeat.set(4,4);
    plastic=new THREE.MeshStandardMaterial({map:carbon,roughness:0.72,metalness:0.08});}
  const trim=new THREE.MeshStandardMaterial({color:sk.t!=null?new THREE.Color(sk.t):base.clone().multiplyScalar(0.7),roughness:sk.t!=null?0.35:0.55,metalness:sk.t!=null?0.45:0.04});
  const dark=new THREE.MeshStandardMaterial({color:0x22252a,roughness:0.42,metalness:0.55});
  const metal=new THREE.MeshPhongMaterial({color:0x5a6068,specular:0xbbbbbb,shininess:70});
  const brass=new THREE.MeshPhongMaterial({color:0xd9b24c,specular:0xfff0c0,shininess:90});
  const g=new THREE.Group();
  function rbox(w,h,d,r,mat){const b=Math.min(r*0.55,0.05),ww=w-2*b,hh=h-2*b,rr=Math.max(0.01,r-b),x=-ww/2,y=-hh/2,sh=new THREE.Shape();
    sh.moveTo(x+rr,y);sh.lineTo(x+ww-rr,y);sh.quadraticCurveTo(x+ww,y,x+ww,y+rr);sh.lineTo(x+ww,y+hh-rr);sh.quadraticCurveTo(x+ww,y+hh,x+ww-rr,y+hh);sh.lineTo(x+rr,y+hh);sh.quadraticCurveTo(x,y+hh,x,y+hh-rr);sh.lineTo(x,y+rr);sh.quadraticCurveTo(x,y,x+rr,y);
    const geo=new THREE.ExtrudeGeometry(sh,{depth:Math.max(0.01,d-2*b),bevelEnabled:true,bevelThickness:b,bevelSize:b,bevelSegments:3,curveSegments:5});
    geo.translate(0,0,-(d-2*b)/2);return new THREE.Mesh(geo,mat);}
  function box(w,h,d,mat,x,y,z){const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);m.position.set(x,y,z);g.add(m);return m;}
  const body=rbox(W,HB,D,0.13,plastic);body.position.y=y0+HB/2;g.add(body);
  const lid=rbox(W,HL,D,0.13,plastic);lid.position.y=y0+HB+GAP+HL/2;g.add(lid);
  const seamY=y0+HB+GAP/2;box(W-0.05,GAP+0.02,D-0.05,dark,0,seamY,0);
  // elite: gold framing, armoured corners, glowing seam, plaque
  if(el){
    for(const sg of[1,-1]){const z=sg*(D/2+0.008);
      box(W-0.7,0.032,0.03,brass,0,y0+0.1,z);box(W-0.7,0.032,0.03,brass,0,y0+H-0.1,z);
      for(const sx of[-1,1])box(0.034,H-0.34,0.03,brass,sx*1.08,0,z);}
    for(const sx of[-1,1])for(const sz of[-1,1])for(const yy of[y0+0.11,y0+H-0.11]){const cp=rbox(0.27,0.24,0.27,0.05,brass);cp.position.set(sx*(W/2-0.1),yy,sz*(D/2-0.1));g.add(cp);}
    box(W-0.01,0.03,D-0.01,new THREE.MeshBasicMaterial({color:0xff4a22}),0,seamY,0);
    const pc=document.createElement('canvas');pc.width=256;pc.height=48;const px=pc.getContext('2d');px.fillStyle='#14161b';px.fillRect(0,0,256,48);px.strokeStyle='#e4ae39';px.lineWidth=3;px.strokeRect(3,3,250,42);
    px.fillStyle='#f0c24a';px.font='900 30px sans-serif';px.textAlign='center';px.textBaseline='middle';
    if(px.letterSpacing!==undefined)px.letterSpacing='6px';px.fillText('ELITE',128+(px.letterSpacing!==undefined?3:0),26);
    const pl=new THREE.Mesh(new THREE.PlaneGeometry(0.9,0.17),new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(pc)}));pl.rotation.x=-Math.PI/2;pl.position.set(0,y0+H+0.006,D/2-0.23);g.add(pl);
  }
  // ribs + stepped corner panels (front and back)
  if(!el)for(const sg of[1,-1]){const z=sg*(D/2+0.006);
    for(let i=-4;i<=4;i++){const x=i*0.27;if(Math.abs(x)<0.42)continue;box(0.075,HB-0.2,0.03,trim,x,y0+HB/2+0.02,z);box(0.075,HL-0.2,0.03,trim,x,y0+HB+GAP+HL/2,z);}
    for(const cx of[-1,1])box(0.36,0.17,0.03,trim,cx*0.98,y0+0.17,z);
    for(const cx of[-1,1])box(0.36,0.12,0.03,trim,cx*0.98,y0+H-0.17,z);}
  // front latches / back hinges
  for(const x of(el?[-0.95,-0.32,0.32,0.95]:[-0.8,0,0.8])){
    box(0.24,0.17,0.07,dark,x,seamY+0.17,D/2+0.02);box(0.24,0.17,0.07,dark,x,seamY-0.17,D/2+0.02);
    box(0.09,0.4,0.05,el?brass:sk.g?dark:metal,x,seamY,D/2+0.065);
    for(const dy of[-0.15,0.15]){const b=new THREE.Mesh(new THREE.CylinderGeometry(0.03,0.03,0.04,10),brass);b.rotation.x=Math.PI/2;b.position.set(x,seamY+dy,D/2+0.1);g.add(b);}
    box(0.24,0.15,0.07,dark,x,seamY,-D/2-0.02);}
  // handle
  box(1.02,0.05,0.38,dark,0,y0+H+0.015,0);
  const hp=new THREE.CatmullRomCurve3([[-0.4,0,0],[-0.4,0.2,0],[-0.32,0.27,0],[0.32,0.27,0],[0.4,0.2,0],[0.4,0,0]].map(p=>new THREE.Vector3(p[0],y0+H+0.02+p[1],p[2])),false,'catmullrom',0.12);
  g.add(new THREE.Mesh(new THREE.TubeGeometry(hp,28,0.048,10,false),el?brass:sk.g?dark:metal));
  // padlock on the +X end
  box(0.04,0.34,0.16,dark,W/2+0.01,y0+HB+GAP/2+0.02,0);
  const lk=rbox(0.22,0.26,0.1,0.03,brass);lk.rotation.y=Math.PI/2;lk.position.set(W/2+0.06,y0+HB+GAP/2-0.11,0);g.add(lk);
  const sh=new THREE.Mesh(new THREE.TorusGeometry(0.075,0.022,8,16,Math.PI),metal);sh.rotation.y=Math.PI/2;sh.position.set(W/2+0.06,y0+HB+GAP/2+0.02,0);g.add(sh);
  // emblem (original "CH" diamond) on the front and back of the lower half
  const cvs=document.createElement('canvas');cvs.width=cvs.height=128;const cx=cvs.getContext('2d');
  const hex=k=>'#'+k.getHexString();
  cx.translate(64,64);cx.beginPath();cx.moveTo(0,-58);cx.lineTo(58,0);cx.lineTo(0,58);cx.lineTo(-58,0);cx.closePath();
  cx.fillStyle='#14171c';cx.fill();cx.scale(0.88,0.88);cx.beginPath();cx.moveTo(0,-58);cx.lineTo(58,0);cx.lineTo(0,58);cx.lineTo(-58,0);cx.closePath();
  const lg=cx.createLinearGradient(-50,-50,50,50);lg.addColorStop(0,hex(acc.clone().lerp(new THREE.Color(0xffffff),0.35)));lg.addColorStop(1,hex(acc));cx.fillStyle=lg;cx.fill();
  cx.lineWidth=4;cx.strokeStyle='rgba(255,255,255,.85)';cx.stroke();cx.setTransform(1,0,0,1,0,0);
  cx.fillStyle=(acc.r*0.3+acc.g*0.59+acc.b*0.11>0.6)?'#1a1206':'#fff';cx.font='900 40px sans-serif';cx.textAlign='center';cx.textBaseline='middle';cx.shadowColor='rgba(0,0,0,.5)';cx.shadowBlur=4;cx.fillText('CH',64,68);
  const tex=new THREE.CanvasTexture(cvs);const em=new THREE.MeshBasicMaterial({map:tex,transparent:true});
  for(const sg of[1,-1]){const p=new THREE.Mesh(new THREE.PlaneGeometry(el?0.74:0.64,el?0.74:0.64),em);p.position.set(0,y0+HB/2+0.02,sg*(D/2+0.035));if(sg<0)p.rotation.y=Math.PI;g.add(p);}
  const inner=new THREE.Group();inner.add(g);const root=new THREE.Group();root.add(inner);root.rotation.x=0.36;root.position.y=-0.04;
  return {root,inner};
}
function csShot(o,i){const{root,inner}=o.m;inner.rotation.y=-0.6+i*Math.PI*2/o.n;if(!iconR)iconSetup();iconR.setSize(o.W,o.H);iconScene.add(root);root.updateMatrixWorld(true);
  const L=1.1,asp=o.W/o.H;iconCam.position.set(0,0,9);iconCam.top=L;iconCam.bottom=-L;iconCam.left=-L*asp;iconCam.right=L*asp;iconCam.lookAt(0,0,0);iconCam.updateProjectionMatrix();
  iconR.setClearColor(0x000000,0);iconR.clear();iconR.render(iconScene,iconCam);
  const cv=document.createElement('canvas');cv.width=o.W;cv.height=o.H;cv.getContext('2d').drawImage(iconR.domElement,0,0);iconScene.remove(root);o.f[i]=cv;}
function case3d(id){let o=CS3[id];if(o)return o;o=CS3[id]={f:[],n:16,W:360,H:240,m:caseModel(CASES[id],id),done:false};csShot(o,0);
  const step=()=>{if(o.f.length>=o.n){o.m=null;o.done=true;return;}try{csShot(o,o.f.length);}catch(e){console.error(e);o.n=o.f.length||1;}setTimeout(step,14);};setTimeout(step,40);return o;}
function csDraw(cv,o,i){const c=cv.getContext('2d');c.clearRect(0,0,o.W,o.H);c.drawImage(o.f[i],0,0);}
function csKick(cv){if(cv._raf)return;let last=performance.now(),acc=0;
  const tick=t=>{cv._raf=0;if(!cv.isConnected)return;const o=cv._o;
    if(!o.done){if(cv._h)cv._raf=requestAnimationFrame(tick);return;}
    const want=cv._h&&!cv._drag;if(!want&&!cv._drag&&cv._i===0)return;
    if(!cv._drag){acc+=t-last;const ms=want?70:45;while(acc>=ms){acc-=ms;cv._i=(cv._i+1)%o.n;if(!want&&cv._i===0){acc=0;break;}}csDraw(cv,o,cv._i);}
    last=t;cv._raf=requestAnimationFrame(tick);};
  cv._raf=requestAnimationFrame(tick);}
function csAttach(){document.querySelectorAll('#caseRow canvas.cs-cv').forEach(cv=>{const o=case3d(cv.dataset.cs),st=cv.parentNode;cv._o=o;cv._i=0;cv._h=false;cv._drag=false;csDraw(cv,o,0);
  st.onpointerenter=e=>{if(e.pointerType==='touch')return;cv._h=true;csKick(cv);};st.onpointerleave=()=>{cv._h=false;csKick(cv);};
  let x0=null,i0=0;
  st.onpointerdown=e=>{x0=e.clientX;i0=cv._i;cv._drag=true;try{st.setPointerCapture(e.pointerId);}catch(_){}};
  st.onpointermove=e=>{if(x0==null||!o.done)return;const k=Math.round((e.clientX-x0)/Math.max(8,st.clientWidth/o.n*1.15));cv._i=(((i0-k)%o.n)+o.n)%o.n;csDraw(cv,o,cv._i);};
  st.onpointerup=st.onpointercancel=()=>{x0=null;cv._drag=false;csKick(cv);};});}
var shopTab='daily',shopSk='',sxDay=0,_finOrder=null;
function sxImg(i){return i.svg?i.svg:`<img src="${i.img()}" alt="">`;}
function sxCard(o){const free=o.free&&!o.own,none=!o.own&&!free&&!o.price;
  const lbl=o.own?(o.ownTxt||'OWNED'):(free||none)?'FREE':`<i class="coin"></i>${o.price}`;
  return `<div class="sx-c ${o.cls||''} ${o.own?'own-c':''}" style="--rc:${o.rc}"${o.tip?` title="${esc(o.tip)}"`:''}${o.it?` data-it="${sxEnc(o.it)}" data-pr="${o.price||0}" data-rn="${esc(o.rn||'')}"`:''}>${o.rn?`<span class="sx-rn">${esc(o.rn)}</span>`:''}<div class="sx-n">${esc(o.top)}</div><div class="sx-im ${o.imc||''}" ${o.imAttr||''}>${o.img}</div>${o.sub?`<div class="sx-s">${esc(o.sub)}</div>`:''}<button class="sx-pr ${o.own?'own':(free||none)?'free':o.dis?'need':''}" ${o.attr} ${o.own||(o.dis&&!free&&!none)?'disabled':''}>${lbl}</button></div>`;}
function sxItem(it,price,attr,o={}){const i=info(it);return sxCard(Object.assign({it,rn:RAR[i.r].n,rc:RAR[i.r].c,top:i.top,img:sxImg(i),sub:i.bot,price,attr,dis:save.coins<price},o));}
function finList(){return Object.entries(FINS).filter(([k,f])=>k!=='vanilla'&&!f.ex).sort((a,b)=>a[1].p-b[1].p).map(x=>x[0]);}
function finRc(k){if(!_finOrder||!_finOrder.length)_finOrder=finList();const i=Math.max(0,_finOrder.indexOf(k)),n=_finOrder.length||1;return RAR[2+Math.min(4,Math.floor(i*5/n))].c;}
function sxFin(k,free){const f=FINS[k],own=save.items.some(i=>i.k==='fin'&&i.f===k),claimed=!!free&&!own&&save.freeDay===dayKey();
  return sxCard({it:{k:'fin',f:k},rn:'Finish',rc:finRc(k),top:f.n,img:`<div class="fin-sw" style="background-image:url(${finUrl(k)})"></div>`,sub:free?'Daily free':'Blade finish',price:f.p,free:!!free&&!claimed,ownTxt:claimed?'CLAIMED':'OWNED',own:own||claimed,dis:!free&&save.coins<f.p,attr:free?`data-fcl="${k}"`:`data-fin="${k}"`,cls:'fin-c'});}
function sxAgent(k){const a=AGENTS[k],own=save.items.some(i=>i.k==='agent'&&i.a===k),g=agSig(k);return sxItem({k:'agent',a:k},a.price,`data-agent="${k}"`,{sub:g.glyph+' '+g.perk,tip:g.d,own,cls:'tall'});}
function sxHead(){const left=Math.max(0,SHOP_REF-shopRoll());$('sxRefN').textContent=left;$('sxRef').disabled=left<=0;$('sxBal').textContent=Number(save.coins||0).toLocaleString();}
function sxTick(){const s=Math.floor((86400000-Date.now()%86400000)/1000);$('sxTm').textContent=Math.floor(s/3600)+'h '+Math.floor(s%3600/60)+'m '+(s%60)+'s';const d=dayKey();if(sxDay&&sxDay!==d){sxDay=d;renderStore();}sxDay=d;}
function renderStore(){
  {const w=$('rdWin');if(w){if(rdLast&&rdLast.big){w.innerHTML=`<div class="rd-lv"><div class="rd-lvr" style="color:#d9c8ff">${esc(rdLast.title)}</div><div class="rd-lvn">${esc(rdLast.big)}</div><div class="rd-lvf">${esc(rdLast.sub)}</div></div>`;}else if(rdLast&&rdLast.lv){const rk=rankOf(rdLast.lv[1]);w.innerHTML=`<div class="rd-lv"><div class="rd-lvn">LV ${rdLast.lv[1]}</div><div class="rd-lvr" style="color:${rk.color}">${esc(rk.name)}</div><div class="rd-lvf">+${rdLast.lv[1]-rdLast.lv[0]} levels</div></div>`;}else{const it=rdLast&&save.items.includes(rdLast)?rdLast:null;if(it){const i=info(it);w.innerHTML=itemCardHtml(it)+(i.eq?'<button class="btn" disabled>Equipped</button>':'<button class="btn pri" id="rdEq">EQUIP NOW</button>');}else w.innerHTML='';}}}
  const tab=shopTab||'daily';sxHead();sxTick();
  document.querySelectorAll('#sxTabs .sx-t').forEach(b=>b.classList.toggle('on',b.dataset.sx===tab));
  document.querySelectorAll('.sx-pn').forEach(p=>p.classList.toggle('hidden',p.dataset.pn!==tab));
  {const dt=document.querySelector('.sx-t[data-sx=daily]');if(dt){let d=dt.querySelector('.sx-dot');const want=save.freeDay!==dayKey();if(want&&!d){d=document.createElement('i');d.className='sx-dot';dt.appendChild(d);}else if(!want&&d)d.remove();}}
  if(tab==='home'){
    $('sxHero2').innerHTML=sxHeroHtml();
    const now=Date.now(),ready=now>=(save.careNext||0),offer=save.careOffer;
    $('care').innerHTML=`<div class="care-cards">${offer?offer.map((it,i)=>`<div class="care-c open" data-care="${i}">${itemCardHtml(it)}<div class="care-pick">CLAIM</div></div>`).join(''):[0,1,2,3].map(()=>`<div class="care-c"><span>?</span></div>`).join('')}</div>
    <div class="care-txt"><h2>WEEKLY CARE PACKAGE</h2><p>${offer?'Pick one of the four items to keep it.':'One free package every week — open it and choose one of four items.'}</p>${offer?'':ready?`<button class="btn pri" id="careOpen">OPEN PACKAGE</button>`:`<button class="btn" disabled>Next package in ${fmtLeft(save.careNext-now)}</button>`}</div>`;
  }else if(tab==='cases'){
    $('caseRow').innerHTML=Object.entries(CASES).map(([k,c])=>{const nOk=casePool(k).length,lockd=!nOk,need=save.coins<c.price||lockd;
      const top=c.items.slice().sort((a,b)=>PAINTS[b[1]].r-PAINTS[a[1]].r).slice(0,3);
      return `<div class="sx-c cs" style="--rc:${c.col[0]}"><div class="sx-n">${esc(c.n)}</div><div class="cs-stage" title="Hover or drag to spin"><canvas class="cs-cv" data-cs="${k}" width="360" height="240"></canvas></div><div class="cs-drops">${top.map(([w,p])=>`<img src="${weaponIcon(w,p)}" alt="" style="--dc:${RAR[PAINTS[p].r].c}">`).join('')}${c.knife?'<span class="cs-k" title="Small chance at a rare knife">★</span>':''}</div><div class="sx-s">${nOk<c.items.length?`${nOk} of ${c.items.length} skins unlocked`:`${c.items.length} items inside`}</div><button class="sx-pr ${lockd?'own lockc':need?'need':''}" data-case="${k}" ${need?'disabled':''} ${lockd?'title="Unlock a gun from this case in the Armory first"':''}>${lockd?'&#128274; UNLOCK A GUN':`<i class="coin"></i>${c.price}`}</button></div>`;}).join('');
    csAttach();
  }else if(tab==='skins'){
    const ch=$('skChips'),sc=ch.scrollLeft;if(!shopSk||!GUN_IDS.includes(shopSk))shopSk=GUN_IDS[0];
    ch.innerHTML=GUN_IDS.map(id=>`<button class="sx-chip ${id===shopSk?'on':''} ${gunOwned(id)?'':'lk'}" data-skw="${id}">${gunOwned(id)?'':'&#128274; '}${esc(WEAPONS[id].name)}</button>`).join('');ch.scrollLeft=sc;const gOk=gunOwned(shopSk);
    $('skGrid').innerHTML=Object.keys(PAINTS).filter(skinPoolOK).sort((a,b)=>PAINTS[a].r-PAINTS[b].r||PAINTS[a].n.localeCompare(PAINTS[b].n)).map(p=>{const r=PAINTS[p].r,pr=RAR_PRICE[r];const ck=caseOf(shopSk,p),o=ownsSkin(shopSk,p);if(ck&&!o)return sxCard({it:{k:'skin',w:shopSk,p},rn:RAR[r].n,rc:RAR[r].c,top:WEAPONS[shopSk].name,img:`<img src="${weaponIcon(shopSk,p)}" alt="">`,sub:PAINTS[p].n+' · '+RAR[r].n,price:pr,attr:'',own:true,ownTxt:'CASE ONLY',tip:'Only from the '+CASES[ck].n,cls:'caseonly'});if(!gOk&&!o)return sxCard({it:{k:'skin',w:shopSk,p},rn:RAR[r].n,rc:RAR[r].c,top:WEAPONS[shopSk].name,img:`<img src="${weaponIcon(shopSk,p)}" alt="">`,sub:PAINTS[p].n+' · '+RAR[r].n,price:pr,attr:'',own:true,ownTxt:'&#128274; LOCKED',tip:'Unlock the '+WEAPONS[shopSk].name+' first',cls:'gunlock'});return sxCard({it:{k:'skin',w:shopSk,p},rn:RAR[r].n,rc:RAR[r].c,top:WEAPONS[shopSk].name,img:`<img src="${weaponIcon(shopSk,p)}" alt="">`,sub:PAINTS[p].n+' · '+RAR[r].n,price:pr,attr:`data-sk="${shopSk}|${p}"`,own:o,dis:save.coins<pr});}).join('');
    if(!gOk){const gc=gunCost(shopSk);$('skGrid').insertAdjacentHTML('afterbegin',`<div class="sk-lock"><div><b>&#128274; ${esc(WEAPONS[shopSk].name)} is locked</b><span>Unlock the gun first, then you can get its skins.</span></div><button class="btn pri" data-ugun="${shopSk}" ${save.coins<gc?'disabled':''}>UNLOCK GUN &middot; <i class="coin"></i>${gc}</button></div>`);}
  }else if(tab==='daily'){
    $('sxHero').innerHTML=sxHeroHtml();
    $('featRow').innerHTML=featured().map((it,i)=>{const pr=RAR_PRICE[PAINTS[it.p].r];return sxItem(it,pr,`data-feat="${i}"`,{own:ownsSkin(it.w,it.p)});}).join('');
    $('dAgRow').innerHTML=dayShuffle(Object.keys(AGENTS).filter(k=>k!=='operator'),11).slice(0,5).map(sxAgent).join('');
    $('dFinRow').innerHTML=dayShuffle(finList(),23).slice(0,5).map((k,i)=>sxFin(k,i===0)).join('');
  }else if(tab==='more'){
    $('agentRow').innerHTML=Object.keys(AGENTS).filter(k=>k!=='operator').map(sxAgent).join('');
    $('kskRow').innerHTML=Object.entries(HZ.kv).sort((a,b)=>(KSKIN_PRICE[a[0]]||0)-(KSKIN_PRICE[b[0]]||0)).map(([k,v])=>{const own=save.items.some(i=>i.k==='kskin'&&i.v===k),pr=KSKIN_PRICE[k]||4000;return sxItem({k:'kskin',v:k},pr,`data-ksk="${k}"`,{own});}).join('');
    $('ktnRow').innerHTML=Object.entries(KTN).map(([k,K])=>{const own=save.items.some(i=>i.k==='ktn'&&i.s===k);return sxItem({k:'ktn',s:k},K.p,`data-ktn="${k}"`,{own});}).join('');
    $('finRow2').innerHTML=finList().map(k=>sxFin(k,false)).join('');
  }
}
setInterval(()=>{const pg=$('pg-store');if(pg&&!pg.classList.contains('hidden')&&!document.hidden)sxTick();},1000);
$('rdIn')&&$('rdIn').addEventListener('keydown',e=>{e.stopPropagation();if(e.key==='Enter')redeemCode(e.target.value);});
$('pg-store').addEventListener('click',e=>{
  const t=e.target;
  if(!SXP.go&&!t.closest('[data-case],#sxRef,#sxClose,[data-skw],[data-ugun],[data-sx],#rdGo,#rdEq,#careOpen,[data-care],.cs-stage')){const c=t.closest('.sx-c[data-it],.sx-hero[data-it]');if(c){sxPreview(c);return;}}
  if(t.id==='rdGo'){redeemCode($('rdIn').value);return;}
  if(t.id==='rdEq'&&rdLast){if(rdLast.k==='skin'){save.equipSkin[rdLast.w]=rdLast.uid;}if(rdLast.k==='kskin'){save.kskin=rdLast.v;save.knife=HZ.kv[rdLast.v].w;}persist();sfx('click');renderMenu();return;}
  if(t.id==='careOpen'){const offer=[];for(let i=0;i<4;i++){const ids=GUN_IDS.filter(gunOwned),ps=Object.keys(PAINTS).filter(p=>PAINTS[p].r<=3);offer.push({k:'skin',w:ids[Math.floor(Math.random()*ids.length)],p:ps[Math.floor(Math.random()*ps.length)]});}
    save.careOffer=offer;persist();sfx('levelup');renderStore();return;}
  const cc=t.closest('[data-care]');if(cc&&save.careOffer){const it=save.careOffer[+cc.dataset.care];addItem({k:it.k,w:it.w,p:it.p});save.careOffer=null;save.careNext=Date.now()+7*86400000;persist();sfx('buy');renderMenu();center('',0);return;}
  if(t.closest('#sxClose')){showTab('home');return;}
  if(t.closest('#sxRef')){if(SHOP_REF-shopRoll()<=0){sfx('deny');return;}save.shopRef={d:dayKey(),n:shopRoll()+1};persist();sfx('levelup');renderStore();return;}
  const sx=t.closest('[data-sx]');if(sx){shopTab=sx.dataset.sx;renderStore();const w=$('pg-store');if(w&&w.scrollTo)w.scrollTo(0,0);return;}
  const sw=t.closest('[data-skw]');if(sw){shopSk=sw.dataset.skw;renderStore();return;}
  const ug=t.closest('[data-ugun]');if(ug){if(buyGun(ug.dataset.ugun))renderStore();return;}
  const sk=t.closest('[data-sk]');if(sk){const[w,p]=sk.dataset.sk.split('|'),pr=RAR_PRICE[PAINTS[p].r];if(save.coins<pr||ownsSkin(w,p)||caseOf(w,p)||!gunOwned(w)){sfx('deny');return;}save.coins-=pr;addItem({k:'skin',w,p});sfx('buy');renderMenu();return;}
  const fc=t.closest('[data-fcl]');if(fc){const k=fc.dataset.fcl;if(save.freeDay===dayKey()||save.items.some(i=>i.k==='fin'&&i.f===k)){sfx('deny');return;}save.freeDay=dayKey();addItem({k:'fin',f:k});save.knifeFin=k;persist();sfx('levelup');renderMenu();return;}
  const cs=t.closest('[data-case]');if(cs){openCase(cs.dataset.case);return;}
  const f=t.closest('[data-feat]');if(f){const it=featured()[+f.dataset.feat];const p=RAR_PRICE[PAINTS[it.p].r];if(save.coins<p||ownsSkin(it.w,it.p)||caseOf(it.w,it.p)||!gunOwned(it.w)){sfx('deny');return;}save.coins-=p;addItem({k:'skin',w:it.w,p:it.p});sfx('buy');renderMenu();return;}
  const a=t.closest('[data-agent]');if(a){const k=a.dataset.agent,ag=AGENTS[k];if(save.coins<ag.price||save.items.some(i=>i.k==='agent'&&i.a===k))return;save.coins-=ag.price;addItem({k:'agent',a:k});sfx('buy');renderMenu();return;}
  const ks=t.closest('[data-ksk]');if(ks){const k=ks.dataset.ksk,pr=KSKIN_PRICE[k]||4000;if(save.coins<pr||save.items.some(i=>i.k==='kskin'&&i.v===k))return;save.coins-=pr;addItem({k:'kskin',v:k});sfx('buy');renderMenu();return;}
  const kt=t.closest('[data-ktn]');if(kt){const k=kt.dataset.ktn,K=KTN[k];if(save.coins<K.p||save.items.some(i=>i.k==='ktn'&&i.s===k))return;save.coins-=K.p;addItem({k:'ktn',s:k});save.katanaSkin=k;save.knife='katana';sfx('buy');renderMenu();return;}
  const fn=t.closest('[data-fin]');if(fn){const k=fn.dataset.fin,fp=FINS[k].p;if(save.coins<fp||save.items.some(i=>i.k==='fin'&&i.f===k))return;save.coins-=fp;addItem({k:'fin',f:k});save.knifeFin=k;sfx('buy');renderMenu();}
});
/* case opening reel */
let opCase=null,reelAnim=0;
/* ===== 0.98: case opening animation — the real 3D case drops in, rattles, latches pop, lid swings open with a rarity-coloured glow, then the reel ===== */
const COP={r:null,scene:null,cam:null,raf:0,skip:null};
function copSetup(){if(COP.r)return;const cv=$('opCv');COP.r=new THREE.WebGLRenderer({canvas:cv,alpha:true,antialias:true});COP.r.setPixelRatio(Math.min(2,window.devicePixelRatio||1));
  COP.scene=new THREE.Scene();COP.scene.add(new THREE.HemisphereLight(0xffffff,0x4a4438,1.0));const dl=new THREE.DirectionalLight(0xffffff,0.9);dl.position.set(-3,5,4);COP.scene.add(dl);
  const dl2=new THREE.DirectionalLight(0xffe0b0,0.35);dl2.position.set(3,-1,-2);COP.scene.add(dl2);COP.glowL=new THREE.PointLight(0xffffff,0,6);COP.glowL.position.set(0,0.6,0.2);COP.scene.add(COP.glowL);
  COP.cam=new THREE.PerspectiveCamera(30,2,0.1,50);COP.cam.position.set(0,1.75,7.4);COP.cam.lookAt(0,0.42,0);
  const gc=document.createElement('canvas');gc.width=gc.height=128;const gx=gc.getContext('2d');const gr=gx.createRadialGradient(64,64,0,64,64,64);gr.addColorStop(0,'rgba(255,255,255,1)');gr.addColorStop(0.3,'rgba(255,255,255,.55)');gr.addColorStop(1,'rgba(255,255,255,0)');gx.fillStyle=gr;gx.fillRect(0,0,128,128);
  COP.glowTex=new THREE.CanvasTexture(gc);
  const sc=document.createElement('canvas');sc.width=256;sc.height=64;const sx=sc.getContext('2d');const sg=sx.createRadialGradient(128,32,0,128,32,128);sg.addColorStop(0,'rgba(0,0,0,.55)');sg.addColorStop(1,'rgba(0,0,0,0)');sx.fillStyle=sg;sx.fillRect(0,0,256,64);
  const sh=new THREE.Mesh(new THREE.PlaneGeometry(3.6,0.9),new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(sc),transparent:true,depthWrite:false}));sh.rotation.x=-Math.PI/2;sh.position.y=-0.62;COP.scene.add(sh);COP.shadow=sh;}
/* split a fresh case model into body + a lid hinged at the back edge of the seam */
function copModel(cid){const m=caseModel(CASES[cid],cid);const g=m.inner.children[0];const HB=0.62,GAP=0.05,HL=0.46,H=HB+GAP+HL,y0=-H/2,seamY=y0+HB+GAP/2,D=1.2;
  const lid=new THREE.Group();lid.position.set(0,seamY,-D/2-0.06);g.add(lid);const bb=new THREE.Box3(),c=new THREE.Vector3();
  for(const ch of g.children.slice()){if(ch===lid)continue;bb.setFromObject(ch);bb.getCenter(c);
    if(c.y>seamY+0.012){g.remove(ch);ch.position.sub(lid.position);lid.add(ch);continue;}
    if(bb.max.y-bb.min.y<0.09&&bb.max.x-bb.min.x>2&&bb.max.z-bb.min.z>1){ch.material=COP.foam||(COP.foam=new THREE.MeshStandardMaterial({color:0x1b1d22,roughness:0.95,metalness:0}));continue;}
    /* parts that cross the seam (frame rails, latch bars, hasp) are cut at the seam so nothing sticks up when the lid opens */
    if(bb.max.y>seamY+0.03&&bb.min.y<seamY-0.03&&ch.geometry&&ch.geometry.type==='BoxGeometry'&&!ch.rotation.x&&!ch.rotation.z){const h0=bb.max.y-bb.min.y,h1=seamY-bb.min.y;ch.scale.y*=h1/h0;ch.position.y=bb.min.y+h1/2;}}
  m.root.rotation.x=0;m.root.position.y=0;return{root:m.root,inner:m.inner,lid};}
function copCaseSnd(k){if(!actx)return;try{const o=bus(0.7,0,0.12);
  if(k==='land'){tn(o,90,0.18,0.7,'sine',0,50);nz(o,700,0.08,0.45,'lowpass');metal(o,1300,0.06,0.12,0.01);}
  else if(k==='rattle'){metal(o,1600+Math.random()*700,0.05,0.18);nz(o,2600,0.03,0.2,'bandpass',0,3);tn(o,140,0.05,0.25,'triangle',0,90);}
  else if(k==='latch'){metal(o,2400,0.09,0.32);nz(o,5200,0.02,0.35,'highpass');tn(o,600,0.04,0.2,'square',0.005,300);}
  else if(k==='open'){nz(o,900,0.5,0.4,'bandpass',0,0.8,2400);tn(o,180,0.35,0.25,'sawtooth',0,320);nz(o,5200,0.6,0.18,'highpass',0.05);}
  else if(k==='burst'){[523,784,1046,1568].forEach((f,i)=>tn(o,f,0.7-i*0.1,0.12,'triangle',0.02+i*0.04));nz(o,7000,0.9,0.22,'highpass',0.02);tn(o,70,0.5,0.5,'sine',0,40);}
  else if(k==='reveal'){[659,880,1175].forEach((f,i)=>tn(o,f,0.5,0.14,'triangle',i*0.07));metal(o,2900,0.4,0.15,0.1);}
  else if(k==='legend'){[523,659,784,1046,1318].forEach((f,i)=>{tn(o,f,0.9,0.13,'sawtooth',i*0.08);tn(o,f*2,0.7,0.05,'triangle',i*0.08);});nz(o,8000,1.4,0.25,'highpass',0.1);}}catch(e){}}
function caseIntro(cid,rc,done){copSetup();const st=$('opStage');st.classList.remove('hidden','out','burst');st.style.setProperty('--rc',rc);
  const cv=$('opCv'),W=st.clientWidth||720,Hh=Math.round(W*0.42);COP.r.setSize(W,Hh,false);COP.cam.aspect=W/Hh;COP.cam.updateProjectionMatrix();
  if(COP.m)COP.scene.remove(COP.m.root);const m=copModel(cid);COP.m=m;COP.scene.add(m.root);
  const glow=new THREE.Sprite(new THREE.SpriteMaterial({map:COP.glowTex,color:new THREE.Color(rc),transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,opacity:0}));glow.position.set(0,0.25,0);glow.scale.set(0.1,0.1,1);m.root.add(glow);
  const beam=new THREE.Group();m.root.add(beam);const col=new THREE.Color(rc);
  for(let i=0;i<5;i++){const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:COP.glowTex,color:col,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,opacity:0}));sp.position.set(0,0.45+i*0.42,0);sp.userData.k=1-i*0.17;beam.add(sp);}
  const sparks=[];for(let i=0;i<26;i++){const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:COP.glowTex,color:i%3?col:new THREE.Color(0xffffff),transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,opacity:0}));sp.userData={a:Math.random()*6.28,r:0.15+Math.random()*0.7,v:0.9+Math.random()*1.6,d:Math.random()*0.5,s:0.05+Math.random()*0.08};beam.add(sp);sparks.push(sp);}
  COP.glowL.color.set(rc);COP.glowL.intensity=0;
  const T0=performance.now(),DUR=2350;let ev={land:0,r1:0,r2:0,r3:0,l1:0,l2:0,open:0,burst:0};let fin=false;
  const finish=()=>{if(fin)return;fin=true;cancelAnimationFrame(COP.raf);st.classList.add('out');COP.skip=null;setTimeout(()=>{st.classList.add('hidden');m.root.remove(glow);m.root.remove(beam);glow.material.dispose();beam.children.forEach(c=>c.material.dispose());},380);done();};
  COP.skip=finish;
  const ease=k=>1-Math.pow(1-k,3),bounce=k=>{const n=7.5625,d=2.75;if(k<1/d)return n*k*k;if(k<2/d)return n*(k-=1.5/d)*k+0.75;if(k<2.5/d)return n*(k-=2.25/d)*k+0.9375;return n*(k-=2.625/d)*k+0.984375;};
  const tick=now=>{const t=(now-T0)/1000;const R=m.root,I=m.inner;
    // 1 drop in with a bounce (0 – 0.55 s)
    const kd=Math.min(1,t/0.55);R.position.y=3.2*(1-bounce(kd));I.rotation.y=-0.55+0.35*ease(Math.min(1,t/0.9));
    COP.shadow.material.opacity=0.25+0.75*kd;COP.shadow.scale.setScalar(0.6+0.4*kd);
    if(t>0.2&&!ev.land){ev.land=1;copCaseSnd('land');}
    // 2 rattle, faster and harder (0.6 – 1.25 s)
    if(t>0.6&&t<1.25){const k=(t-0.6)/0.65,a=0.035+0.06*k;I.rotation.z=Math.sin(t*58)*a;R.position.x=Math.sin(t*71)*a*0.6;R.position.y+=Math.abs(Math.sin(t*44))*a*0.8;
      for(const[kk,at]of[['r1',0.64],['r2',0.86],['r3',1.06]])if(t>at&&!ev[kk]){ev[kk]=1;copCaseSnd('rattle');}}
    else{I.rotation.z*=0.8;R.position.x*=0.8;}
    // 3 latches pop (1.25, 1.36 s), 4 lid swings open (1.42 – 1.85 s)
    if(t>1.25&&!ev.l1){ev.l1=1;copCaseSnd('latch');}if(t>1.36&&!ev.l2){ev.l2=1;copCaseSnd('latch');}
    const ko=Math.max(0,Math.min(1,(t-1.42)/0.43));m.lid.rotation.x=-1.95*(1-Math.pow(1-ko,4))-(ko>=1?Math.sin((t-1.85)*14)*0.04*Math.max(0,1-(t-1.85)*3):0);
    if(ko>0&&!ev.open){ev.open=1;copCaseSnd('open');}
    // 5 glow + light beam in the item's rarity colour, then a burst
    const kg=Math.max(0,Math.min(1,(t-1.4)/0.5));glow.material.opacity=kg;glow.scale.setScalar(0.4+3.2*ease(kg)+0.15*Math.sin(t*9));
    for(const sp of beam.children){if(sp.userData.k!==undefined){sp.material.opacity=0.55*kg*sp.userData.k;sp.scale.set(1.5*sp.userData.k*(0.6+0.4*ease(kg)),1.3,1);}}
    for(const sp of sparks){const u=sp.userData,tt=t-1.5-u.d;if(tt<0){sp.material.opacity=0;continue;}const ph=(tt*u.v)%1.6;sp.position.set(Math.cos(u.a+tt)*u.r,0.3+ph*1.8,Math.sin(u.a+tt)*u.r*0.6);sp.material.opacity=Math.max(0,1-ph/1.6)*kg;sp.scale.setScalar(u.s);}
    COP.glowL.intensity=1.5*kg;
    if(t>1.75&&!ev.burst){ev.burst=1;st.classList.add('burst');copCaseSnd('burst');}
    COP.r.render(COP.scene,COP.cam);
    if(now-T0>=DUR){finish();return;}COP.raf=requestAnimationFrame(tick);};
  COP.raf=requestAnimationFrame(tick);}

function openCase(cid){const C=CASES[cid];if(save.coins<C.price){sfx('deny');return;}if(!casePool(cid).length){center('<span style="color:#ffd34d">Unlock a gun from this case first</span><br><small>Buy guns in the Armory</small>',1.8);sfx('deny');return;}save.coins-=C.price;persist();opCase=cid;
  const win=rollCase(cid);const N=48,W_IDX=40;const strip=[];for(let i=0;i<N;i++)strip.push(i===W_IDX?win:rollCase(cid));
  $('opTitle').textContent=C.n.toUpperCase();$('opResult').innerHTML='';$('opAgain').disabled=true;$('opClose').disabled=true;
  const reel=$('reel');reel.style.transition='none';reel.style.transform='translateX(0)';
  reel.innerHTML=strip.map(it=>`<div class="rc">${itemCardHtml(it)}</div>`).join('');
  const wr=$('opening').querySelector('.reelwrap');wr.classList.add('pre');wr.classList.remove('won');
  $('opening').classList.remove('hidden');renderMenu();
  const wi=info(win),rc=RAR[wi.r].c;wr.style.setProperty('--rc',rc);
  const spin=()=>{wr.classList.remove('pre');requestAnimationFrame(()=>spinReel(reel,wr,win,W_IDX,C,rc,wi));};
  try{caseIntro(cid,rc,spin);}catch(e){console.error(e);$('opStage').classList.add('hidden');spin();}
}
function spinReel(reel,wr,win,W_IDX,C,rc,wi){
  const cw=reel.firstElementChild.getBoundingClientRect().width+8;const wrap=wr.getBoundingClientRect().width;
  const target=W_IDX*cw-wrap/2+cw*(0.15+Math.random()*0.7);
  requestAnimationFrame(()=>requestAnimationFrame(()=>{reel.style.transition='transform 5.6s cubic-bezier(.12,.62,.08,1)';reel.style.transform=`translateX(${-target}px)`;}));
  let lastIdx=-1;cancelAnimationFrame(reelAnim);const tick=()=>{const m=new DOMMatrixReadOnly(getComputedStyle(reel).transform);const idx=Math.floor((-m.m41+wrap/2)/cw);if(idx!==lastIdx){lastIdx=idx;sfx('click');}reelAnim=requestAnimationFrame(tick);};tick();
  const done=()=>{reel.removeEventListener('transitionend',done);cancelAnimationFrame(reelAnim);const it=addItem(Object.assign({},win));const i=info(it);
    $('opResult').innerHTML=`<div class="op-win" style="color:${RAR[i.r].c}">${RAR[i.r].n.toUpperCase()}</div><div class="op-name">${esc(i.top)} | ${esc(i.bot)}</div>`;
    sfx(i.r>=4?'levelup':i.r>=2?'medal':'buy');const wc=reel.children[W_IDX];if(wc){wc.style.setProperty('--rc',rc);wc.classList.add('win');}wr.classList.add('won');copCaseSnd(i.r>=4?'legend':'reveal');$('opAgain').disabled=save.coins<C.price;$('opClose').disabled=false;renderMenu();};
  reel.addEventListener('transitionend',done);
}
$('opAgain').onclick=()=>{if(opCase)openCase(opCase);};
$('opClose').onclick=()=>{$('opening').classList.add('hidden');};
$('opStage').onclick=()=>{if(COP.skip)COP.skip();};
/* ===== 1.00 STORE: featured hero banner, item preview with live 3D, buy confirmation, equip from the store, card tilt ===== */
const SXP={go:false,r:null,scene:null,cam:null,obj:null,raf:0,yaw:0,drag:null,sel:'',it:null,card:null};
function sxEnc(it){return encodeURIComponent(JSON.stringify(it));}
function sxOwned(it){const I=save.items;switch(it.k){case 'skin':return ownsSkin(it.w,it.p);case 'agent':return I.some(i=>i.k==='agent'&&i.a===it.a);case 'kskin':return I.some(i=>i.k==='kskin'&&i.v===it.v);
  case 'ktn':return I.some(i=>i.k==='ktn'&&i.s===it.s);case 'fin':return I.some(i=>i.k==='fin'&&i.f===it.f);}return false;}
function sxKind(it){return{skin:'Weapon skin',agent:'Agent',kskin:'Knife skin',ktn:'Katana',fin:'Blade finish'}[it.k]||'Item';}
function sxEquipped(it){switch(it.k){case 'skin':{const u=save.equipSkin&&save.equipSkin[it.w];const o=save.items.find(i=>i.uid===u);return!!o&&o.p===it.p;}case 'agent':return(save.agent||'operator')===it.a;
  case 'kskin':return save.kskin===it.v;case 'ktn':return save.knife==='katana'&&save.katanaSkin===it.s;case 'fin':return save.knifeFin===it.f&&!save.kskin;}return false;}
function sxEquip(it){const o=save.items.find(i=>i.k===it.k&&(it.k==='skin'?i.w===it.w&&i.p===it.p:it.k==='agent'?i.a===it.a:it.k==='kskin'?i.v===it.v:it.k==='ktn'?i.s===it.s:i.f===it.f));if(!o)return;
  if(it.k==='skin'){save.equipSkin[it.w]=o.uid;if(it.w==='awp'||it.w==='ak47')save.spawnPrimary=it.w;}
  if(it.k==='agent'){save.agent=it.a;rebuildOperator();}if(it.k==='kskin'){save.kskin=it.v;save.knife=HZ.kv[it.v].w;}
  if(it.k==='ktn'){save.katanaSkin=it.s;save.knife='katana';save.kskin='';}if(it.k==='fin'){save.knifeFin=it.f;save.kskin='';}
  persist();sfx('buy');renderMenu();}
/* ---- featured hero ---- */
function sxHeroHtml(){const F=featured();if(!F.length)return'';let fi=0;F.forEach((x,k)=>{if(PAINTS[x.p].r>PAINTS[F[fi].p].r)fi=k;});const it=F[fi],i=info(it),r=PAINTS[it.p].r,pr=RAR_PRICE[r],own=ownsSkin(it.w,it.p),lk=!gunOwned(it.w);
  const s=Math.floor((86400000-Date.now()%86400000)/1000),left=Math.floor(s/3600)+'h '+Math.floor(s%3600/60)+'m';
  return `<div class="sx-hero" style="--rc:${RAR[r].c}" data-it="${sxEnc(it)}" data-pr="${pr}"><div class="sxh-art"><img src="${i.img()}" alt=""></div>
    <div class="sxh-l"><div class="sxh-tag">&#9733; FEATURED TODAY</div><div class="sxh-rar">${RAR[r].n.toUpperCase()} &middot; WEAPON SKIN</div><h2>${esc(WEAPONS[it.w].name)}</h2><div class="sxh-skin">${esc(PAINTS[it.p].n)}</div>
    <div class="sxh-row"><button class="sx-pr sxh-buy ${own?'own':lk?'own lockc':save.coins<pr?'need':''}" data-feat="${fi}" ${own||lk?'disabled':''}>${own?'OWNED':lk?'&#128274; UNLOCK GUN FIRST':`<i class="coin"></i>${pr}`}</button><span class="sxh-t">&#9201; Leaves in <b>${left}</b></span></div></div></div>`;}
/* ---- preview modal ---- */
function sxpSetup(){if(SXP.r)return;const cv=$('sxpCv');SXP.r=new THREE.WebGLRenderer({canvas:cv,alpha:true,antialias:true});SXP.r.setPixelRatio(Math.min(2,window.devicePixelRatio||1));
  SXP.scene=new THREE.Scene();SXP.scene.add(new THREE.HemisphereLight(0xffffff,0x3a3630,1.05));const k=new THREE.DirectionalLight(0xffffff,1.0);k.position.set(-2,3,3);SXP.scene.add(k);
  SXP.rim=new THREE.DirectionalLight(0xffffff,0.9);SXP.rim.position.set(2.5,1.2,-3);SXP.scene.add(SXP.rim);SXP.cam=new THREE.PerspectiveCamera(30,1.4,0.05,60);
  const st=$('sxpStage');st.addEventListener('pointerdown',e=>{SXP.drag={x:e.clientX,y:SXP.yaw};try{st.setPointerCapture(e.pointerId);}catch(_){}});
  st.addEventListener('pointermove',e=>{if(SXP.drag){SXP.yaw=SXP.drag.y+(e.clientX-SXP.drag.x)*0.012;SXP.hold=performance.now();}});
  const up=()=>{SXP.drag=null;};st.addEventListener('pointerup',up);st.addEventListener('pointercancel',up);}
function sxpModel(it){try{if(it.k==='skin'&&typeof hasReal==='function'&&hasReal(it.w)){const g=makeRealStatic(it.w,it.p);const w=new THREE.Group();g.rotation.y=-Math.PI/2;w.add(g);return{o:w,kind:'gun'};}
  if(it.k==='agent'){const s=makeSoldier(0xb08a3e,agentPal(it.a));const w=new THREE.Group();w.add(s.g);return{o:w,kind:'agent'};}}catch(e){console.error(e);}return null;}
function sxpFrame(m){const box=new THREE.Box3().setFromObject(m.o),c=box.getCenter(new THREE.Vector3()),sz=box.getSize(new THREE.Vector3());m.o.children[0].position.sub(c);
  const st=$('sxpStage'),W=st.clientWidth||520,H=st.clientHeight||320;SXP.r.setSize(W,H,false);SXP.cam.aspect=W/H;SXP.cam.updateProjectionMatrix();
  const f=Math.tan(SXP.cam.fov*Math.PI/360),need=m.kind==='agent'?Math.max(sz.y/2/f,sz.x/2/f/SXP.cam.aspect):Math.max(Math.max(sz.x,sz.z)/2/f/SXP.cam.aspect,sz.y/2/f);
  const d=need*(m.kind==='agent'?1.12:1.5);SXP.cam.position.set(0,m.kind==='agent'?sz.y*0.04:d*0.12,d);SXP.cam.lookAt(0,0,0);}
function sxpLoop(){cancelAnimationFrame(SXP.raf);const t0=performance.now();const tick=now=>{if($('sxPrev').classList.contains('hidden'))return;
  if(SXP.obj){if(!SXP.drag&&now-(SXP.hold||0)>1500)SXP.yaw+=0.006;SXP.obj.o.rotation.y=SXP.obj.kind==='gun'?Math.sin(SXP.yaw)*0.7:SXP.yaw;SXP.obj.o.position.y=Math.sin((now-t0)/700)*0.02;SXP.r.render(SXP.scene,SXP.cam);}
  SXP.raf=requestAnimationFrame(tick);};SXP.raf=requestAnimationFrame(tick);}
function sxpClear(){if(SXP.obj){SXP.scene.remove(SXP.obj.o);SXP.obj.o.traverse(o=>{if(o.geometry)o.geometry.dispose();});SXP.obj=null;}}
function sxPreview(card){const it=JSON.parse(decodeURIComponent(card.dataset.it));const btn=card.querySelector('.sx-pr');const i=info(it);
  SXP.it=it;SXP.sel=btn?[...btn.attributes].filter(a=>a.name.startsWith('data-')).map(a=>`[${a.name}="${a.value}"]`).join(''):'';SXP.pr=+card.dataset.pr||0;SXP.free=!!(btn&&btn.classList.contains('free'));
  const r=i.r!=null?i.r:0,rc=card.style.getPropertyValue('--rc')||RAR[r].c;const box=$('sxPrev');box.style.setProperty('--rc',rc);
  $('sxpRar').textContent=(card.dataset.rn||RAR[r].n).toUpperCase()+' · '+sxKind(it).toUpperCase();$('sxpName').textContent=i.top;$('sxpSub').textContent=it.k==='skin'||it.k==='kskin'||it.k==='fin'||it.k==='ktn'?i.bot:'';
  let desc='';if(it.k==='skin'){const w=WEAPONS[it.w];desc=`${/^[aeiou]/i.test(RAR[r].n)?'An':'A'} ${RAR[r].n.toLowerCase()} finish for the ${esc(w.name)}. Cosmetic only, the gun plays the same.`;if(!gunOwned(it.w))desc+=' <b class="bad">Unlock the gun in the Armory first.</b>';const ck=caseOf(it.w,it.p);if(ck)desc+=` <b class="warn">Only from the ${esc(CASES[ck].n)}.</b>`;}
  else if(it.k==='agent'){const g=agSig(it.a);desc=`<b>${esc(g.glyph+' '+g.perk)}</b> &middot; ${esc(g.d||'')}`;}
  else if(it.k==='kskin')desc='A rare knife skin. Equipping it also switches you to that knife.';else if(it.k==='ktn')desc='Katana skin. Hold right-click with the katana to deflect bullets.';else if(it.k==='fin')desc=SXP.free?'Today\'s free blade finish. Claim it before the shop refreshes.':'A finish for your knife blade.';
  $('sxpDesc').innerHTML=desc;$('sxpOk').classList.add('hidden');box.classList.remove('done');
  // 3D model or picture
  sxpSetup();sxpClear();const m=sxpModel(it);const img=$('sxpImg');
  box.classList.remove('hidden');
  if(m){SXP.obj=m;SXP.scene.add(m.o);SXP.yaw=m.kind==='gun'?0.25:-0.3;sxpFrame(m);SXP.rim.color.set(rc);img.classList.add('hidden');$('sxpCv').classList.remove('hidden');$('sxpHint').classList.remove('hidden');sxpLoop();}
  else{img.src=i.img?i.img():'';img.classList.remove('hidden');$('sxpCv').classList.add('hidden');$('sxpHint').classList.add('hidden');}
  sxpState();sfx('click');}
function sxpState(){const it=SXP.it,own=sxOwned(it),eq=own&&sxEquipped(it),b=$('sxpBuy'),e=$('sxpEq'),bal=$('sxpBal');const btn=SXP.sel?document.querySelector('#pg-store '+SXP.sel):null;
  e.classList.toggle('hidden',!own);e.disabled=eq;e.textContent=eq?'✓ EQUIPPED':'EQUIP';
  if(own){b.classList.add('hidden');bal.textContent='In your inventory';return;}
  b.classList.remove('hidden');const lockTxt=it.k==='skin'&&!gunOwned(it.w)?'🔒 UNLOCK THE GUN FIRST':it.k==='skin'&&caseOf(it.w,it.p)?'CASE ONLY':null;
  if(lockTxt||!btn){b.disabled=true;b.className='sxp-buy off';b.innerHTML=lockTxt||'NOT FOR SALE';bal.textContent='';return;}
  if(SXP.free){b.disabled=btn.disabled;b.className='sxp-buy free';b.innerHTML=btn.disabled?'CLAIMED':'CLAIM FREE';bal.textContent='';return;}
  const need=save.coins<SXP.pr;b.disabled=need;b.className='sxp-buy'+(need?' need':'');b.innerHTML=`BUY <i class="coin"></i>${SXP.pr.toLocaleString()}`;
  bal.innerHTML=need?`You need <b>${(SXP.pr-save.coins).toLocaleString()}</b> more coins`:`Balance after: <i class="coin"></i><b>${(save.coins-SXP.pr).toLocaleString()}</b>`;}
function sxpBuy(){const btn=SXP.sel?document.querySelector('#pg-store '+SXP.sel):null;if(!btn||btn.disabled)return;const c0=save.coins;
  SXP.go=true;try{btn.click();}finally{SXP.go=false;}
  if(sxOwned(SXP.it)){const box=$('sxPrev');box.classList.add('done');const ok=$('sxpOk');ok.classList.remove('hidden');ok.innerHTML=`<b>${c0>save.coins?'PURCHASED!':'CLAIMED!'}</b><span>${c0>save.coins?'−'+(c0-save.coins).toLocaleString()+' coins':'Added to your inventory'}</span>`;
    void ok.offsetWidth;ok.classList.add('pop');try{copCaseSnd('reveal');}catch(e){}}
  sxpState();}
function sxpClose(){$('sxPrev').classList.add('hidden');cancelAnimationFrame(SXP.raf);sxpClear();}
$('sxpX').onclick=sxpClose;$('sxPrev').addEventListener('click',e=>{if(e.target.id==='sxPrev')sxpClose();});
$('sxpBuy').onclick=sxpBuy;$('sxpEq').onclick=()=>{if(SXP.it){sxEquip(SXP.it);sxpState();}};
document.addEventListener('keydown',e=>{if(e.code==='Escape'&&!$('sxPrev').classList.contains('hidden')){sxpClose();e.stopPropagation();}},true);
/* ---- card tilt + light that follows the mouse ---- */
$('pg-store').addEventListener('pointermove',e=>{if(e.pointerType!=='mouse')return;const c=e.target.closest&&e.target.closest('.sx-c:not(.cs),.sx-hero');
  if(SXP.tc&&SXP.tc!==c){SXP.tc.style.transform='';SXP.tc=null;}if(!c)return;SXP.tc=c;const R=c.getBoundingClientRect(),x=(e.clientX-R.left)/R.width-0.5,y=(e.clientY-R.top)/R.height-0.5;
  const k=c.classList.contains('sx-hero')?2.5:7;c.style.transform=`perspective(700px) rotateX(${(-y*k).toFixed(2)}deg) rotateY(${(x*k).toFixed(2)}deg) translateY(-3px)`;c.style.setProperty('--mx',((x+0.5)*100).toFixed(1)+'%');c.style.setProperty('--my',((y+0.5)*100).toFixed(1)+'%');});
$('pg-store').addEventListener('pointerleave',()=>{if(SXP.tc){SXP.tc.style.transform='';SXP.tc=null;}});

/* 0.99 UI: news as collapsible patch cards, filled slider tracks */
function newsCards(){const box=document.querySelector('#pg-news .news');if(!box||box.dataset.nc)return;box.dataset.nc=1;let n=0;
  for(const tag of[...box.querySelectorAll(':scope>.tag')]){const ul=tag.nextElementSibling&&tag.nextElementSibling.tagName==='UL'?tag.nextElementSibling:null;
    const m=/PATCH\s+([\d.]+)\s*[·\-–]\s*(.*)/i.exec(tag.textContent.trim());const d=document.createElement('details');d.className='nc';if(n<2)d.open=true;
    const sm=document.createElement('summary');sm.innerHTML=m?`<span class="nv">v${esc(m[1])}</span><span class="nt">${esc(m[2])}</span>${n===0?'<span class="nn">NEW</span>':''}`:`<span class="nt">${esc(tag.textContent)}</span>`;
    d.appendChild(sm);tag.replaceWith(d);if(ul)d.appendChild(ul);n++;}}
function rangeFill(el){const mn=+el.min||0,mx=+el.max||100,v=+el.value;el.style.setProperty('--p',((v-mn)/((mx-mn)||1)*100)+'%');}
document.addEventListener('input',e=>{if(e.target&&e.target.matches&&e.target.matches('.setbox input[type=range]'))rangeFill(e.target);},true);
{const st=$('settings');if(st)new MutationObserver(()=>{if(!st.classList.contains('hidden'))setTimeout(()=>st.querySelectorAll('input[type=range]').forEach(rangeFill),30);}).observe(st,{attributes:true,attributeFilter:['class']});
 document.addEventListener('click',e=>{if(e.target&&e.target.closest&&e.target.closest('.stabs'))setTimeout(()=>document.querySelectorAll('.setbox input[type=range]').forEach(rangeFill),30);},true);}
try{newsCards();}catch(e){console.error(e);}


if(save.ownedFin&&save.ownedFin.length&&!save.migratedFin){save.ownedFin.forEach(f=>{if(FINS[f])addItem({k:'fin',f});});save.migratedFin=true;persist();}
LD();

addEventListener('beforeunload',()=>{try{netLeave(true);}catch(e){}});

rebuildOperator();
if(!PAINTS.stock)PAINTS.stock={n:'Stock',c:0x4a4f57,r:0};
const _newPlayer=grantStarter();
let _pendingWelcome=false;
function showSetup(mode){mode=mode||(save.profile?(save.pw?'edit':'secure'):'create');$('setup').dataset.mode=mode;AV.pending=undefined;
  $('suName').value=save.profile?save.name:'';$('suAge').value=save.age||'';$('suPw').value='';$('suPw2').value='';$('suErr').textContent='';pwMeter($('suPw'),$('suPwM'));
  $('suTitle').textContent=mode==='create'?'CREATE YOUR ACCOUNT':mode==='secure'?'SECURE YOUR ACCOUNT':'EDIT YOUR PROFILE';
  $('suAgeL').classList.toggle('hidden',mode==='secure');$('suGo').textContent=mode==='create'?'CREATE ACCOUNT ▸':mode==='secure'?'SAVE & CONTINUE ▸':'SAVE ▸';
  document.querySelector('#setup .su-pw').classList.toggle('hidden',mode==='edit');$('suPwM').parentElement.classList.toggle('hidden',mode==='edit');
  if(mode==='secure')$('suErr').innerHTML='<span style="color:#ffd08a">New: protect your account with a password and add a profile photo.</span>';
  avRefresh();$('setup').classList.remove('hidden');setTimeout(()=>{try{(mode==='secure'?$('suPw'):$('suName')).focus();}catch(e){}},60);}
function submitSetup(){const mode=$('setup').dataset.mode||'create';const n=$('suName').value.trim().replace(/\s+/g,' '),a=parseInt($('suAge').value,10),pw=$('suPw').value,pw2=$('suPw2').value;
  if(!/^[A-Za-z0-9_ .-]{3,14}$/.test(n)){$('suErr').textContent='Username: 3–14 letters, numbers, spaces, _ . or -';return;}
  if(mode!=='secure'&&!(a>=5&&a<=100)){$('suErr').textContent='Please enter an age between 5 and 100.';return;}
  if(mode!=='edit'){if(pw.length<6){$('suErr').textContent='Password must be at least 6 characters.';return;}if(pw!==pw2){$('suErr').textContent="The two passwords don't match.";return;}
    if(pw.toLowerCase()===n.toLowerCase()){$('suErr').textContent="Don't use your username as your password.";return;}}
  const other=acctReg().list.find(x=>x.id!==save.acctId&&(x.name||'').toLowerCase()===n.toLowerCase());if(other){$('suErr').textContent='Another account on this device already uses that name.';return;}
  save.name=n;if(mode!=='secure')save.age=a;const first=!save.profile;save.profile=1;delete save.newAcct;if(AV.pending!==undefined){save.av=AV.pending||'';AV.pending=undefined;}
  setTimeout(()=>{try{frStart();}catch(e){}},500);if(mode!=='secure'){if(a<16)save.blood=false;else if(save.blood===undefined)save.blood=true;}
  let code=null;if(mode!=='edit'){pwSet(pw);code=recNew();}persist();acctSync();try{sessionStorage.setItem('ch_unlocked',save.acctId);}catch(e){}
  $('setup').classList.add('hidden');initAudio();sfx('buy');renderMenu();avRefresh();
  const after=()=>{if(_pendingWelcome){_pendingWelcome=false;showWelcome();}};if(code)recShow(code,after);else after();}
$('suGo').onclick=submitSetup;
for(const id of['suName','suAge','suPw','suPw2'])$(id).addEventListener('keydown',e=>{if(e.key==='Enter')submitSetup();});
toMenu();
if(!save.profile){_pendingWelcome=_newPlayer;showSetup('create');}else{if(_newPlayer)showWelcome();acctBoot();}
setTimeout(()=>{try{frStart();}catch(e){}},1500);
$('wcOk').onclick=()=>{$('welcome').classList.add('hidden');showTab('inventory');};
requestAnimationFrame(loop);
try{$('btVer').textContent='v'+GAME_VER;bootStep(96,'DEPLOYING');setTimeout(()=>window.bootDone&&window.bootDone(),400);}catch(e){}
})();
</script>
</body>
</html>
