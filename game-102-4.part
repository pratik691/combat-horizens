function knifeVM(w,M,finO){
  if(w.shape&&w.shape.t==='katana')return katanaVM(M,false);
  if(w.shape&&w.shape.t==='dualkatana')return katanaVM(M,true);
  const g=new THREE.Group();const s=w.shape||{};const{mk,P,steel,black,glove,sleeve}=M;const hc=P(s.hc||0x2b2b2b,20);const fid=finO!==undefined?finO:save.knifeFin;const blade=FINS[fid]?new THREE.MeshPhongMaterial({map:finTex(fid),shininess:90,specular:0x777777}):steel;
  const L=s.L||0.22,W=s.W||0.042;
  if(s.t==='push'){for(const ox of[0,-0.32]){mk(g,0.1,0.03,0.035,hc,ox,0,0.02);mk(g,0.008,W,L,blade,ox,0,-0.01-L/2);if(!ICON){const hg=handGrip(g,handMats(),{c:new V3(0,-0.004,0.05),tilt:-Math.PI/2,r:0.017,arm:new V3(0.06,-0.12,0.3)});if(ox){hg.scale.x=-1;hg.position.x=ox;}}}return g;}
  if(s.t==='butterfly'){mk(g,0.016,0.03,0.13,hc,0.012,0,0.02);mk(g,0.016,0.03,0.13,hc,-0.012,0,0.02);}else mk(g,0.03,0.036,0.13,hc,0,0,0.02);
  if(s.cord)for(let i=0;i<4;i++)mk(g,0.034,0.04,0.012,black,0,0,-0.02+i*0.025);
  if(s.ring){const r=new THREE.Mesh(new THREE.TorusGeometry(0.024,0.006,6,14),steel);r.position.set(0,0,0.1);r.rotation.y=Math.PI/2;g.add(r);}
  if(s.guard)mk(g,0.014,0.075,0.02,steel,0,0,-0.05);
  if(s.t==='fold')mk(g,0.034,0.02,0.02,steel,0,0.005,-0.05);
  const n=5,seg=L/n,curve=s.curve||0;let y=0.006,z=-0.055,ang=0;
  for(let i=0;i<n;i++){const ww=W*(1-i/n*0.6);const cy=y+Math.sin(ang)*seg/2,cz=z-Math.cos(ang)*seg/2;mk(g,0.008,ww,seg*1.04,blade,0,cy,cz,ang);
    if(s.serr&&i<2)for(let k=0;k<3;k++)mk(g,0.009,0.008,0.008,steel,0,cy+ww/2+0.002,cz-seg/2+seg*(k+0.5)/3);
    if(s.t==='gut'&&i===1)mk(g,0.009,0.02,0.02,steel,0,cy+ww/2,cz,0.6);
    y+=Math.sin(ang)*seg;z-=Math.cos(ang)*seg;ang+=curve/n;}
  if(!ICON)handGrip(g,handMats(),{c:new V3(0,-0.002,0.035),tilt:-Math.PI/2,r:0.017,arm:new V3(0.06,-0.12,0.3)});
  return g;
}
function muzzleStart(){const p=player,id=p.inv[p.slot]&&p.inv[p.slot].id;const f=vm.flash&&vm.flash[id];if(!f||p.tp||p.scoped)return null;
  vmScene.updateMatrixWorld(true);const v=new V3();f.getWorldPosition(v);vmCam.updateMatrixWorld();v.project(vmCam);if(!(v.z<1))return null;
  const q=new V3(v.x,v.y,0.5).unproject(camera);const dir=q.sub(camera.position).normalize();return camera.position.clone().addScaledVector(dir,0.9);}
function curReal(){const s=player.inv&&player.inv[player.slot];return s&&vm.real?vm.real[s.id]:null;}
/* ---- KATANA (textures by Loxmo, Academic Free License 3.0) ---- */
const KTN=window.CR_KTN||{};
function ktnSkin(){return KTN[save.katanaSkin]?save.katanaSkin:'wooden';}
/* ---- KATANA v2: modelled blade (curved, hamon temper line), tsuba, wrapped tsuka ---- */
const KSTYLE={
  wooden:{blade:'wood',edge:0xcaa274,spine:0x8a5a32,ito:0x6b4a2a,same:0x9a7a52,tsuba:0x2a2018,habaki:0x5a3a20,glow:0},
  iron:{blade:'steel',edge:0xf4f7fa,spine:0x8e969e,ito:0x1a1c22,same:0xe9e4d6,tsuba:0x3a2e22,habaki:0xc9a24a,glow:0},
  sun:{blade:'sun',edge:0xfffbe8,spine:0xffd56a,ito:0xa3141c,same:0xfff1c8,tsuba:0xd8b03a,habaki:0xffe08a,glow:0x5a3a00}};
const _kTex={};
function hamonTex(k){if(_kTex['h'+k])return _kTex['h'+k];const S=KSTYLE[k];
  const t=canvasTex(512,(x,w,h)=>{const sp='#'+S.spine.toString(16).padStart(6,'0'),ed='#'+S.edge.toString(16).padStart(6,'0');
    if(S.blade==='wood'){x.fillStyle='#a97a4a';x.fillRect(0,0,w,h);for(let i=0;i<90;i++){x.strokeStyle=`rgba(${80+Math.random()*40|0},${50+Math.random()*25|0},20,${0.25+Math.random()*0.3})`;x.lineWidth=1+Math.random()*2;const y=Math.random()*h;x.beginPath();x.moveTo(0,y);x.bezierCurveTo(w*0.3,y+Math.random()*8-4,w*0.6,y+Math.random()*8-4,w,y+Math.random()*6-3);x.stroke();}return;}
    const g=x.createLinearGradient(0,0,0,h);g.addColorStop(0,sp);g.addColorStop(0.38,S.blade==='sun'?'#ffe9a8':'#c3cad1');g.addColorStop(0.55,S.blade==='sun'?'#fff6d8':'#dfe5ea');g.addColorStop(1,ed);x.fillStyle=g;x.fillRect(0,0,w,h);
    // hamon: wavy temper boundary
    x.fillStyle=S.blade==='sun'?'rgba(255,255,255,.9)':'rgba(250,252,255,.85)';x.beginPath();x.moveTo(0,h);for(let i=0;i<=w;i+=4){const yy=h*0.62+Math.sin(i*0.09)*h*0.07+Math.sin(i*0.031+1)*h*0.05+Math.sin(i*0.21)*h*0.02;x.lineTo(i,yy);}x.lineTo(w,h);x.fill();
    x.strokeStyle='rgba(255,255,255,.55)';x.lineWidth=1.2;x.beginPath();for(let i=0;i<=w;i+=4){const yy=h*0.62+Math.sin(i*0.09)*h*0.07+Math.sin(i*0.031+1)*h*0.05+Math.sin(i*0.21)*h*0.02;i?x.lineTo(i,yy):x.moveTo(i,yy);}x.stroke();
    for(let i=0;i<500;i++){x.fillStyle=`rgba(255,255,255,${Math.random()*0.12})`;x.fillRect(Math.random()*w,h*0.55+Math.random()*h*0.4,2,1);}
    x.fillStyle='rgba(0,0,0,.18)';x.fillRect(0,h*0.33,w,1.5);},64);
  t.wrapS=t.wrapT=THREE.ClampToEdgeWrapping;return _kTex['h'+k]=t;}
function itoTex(k){if(_kTex['i'+k])return _kTex['i'+k];const S=KSTYLE[k];const c=n=>'#'+n.toString(16).padStart(6,'0');
  const t=canvasTex(64,(x,w,h)=>{x.fillStyle=c(S.same);x.fillRect(0,0,w,h);for(let i=0;i<300;i++){x.fillStyle=`rgba(0,0,0,${Math.random()*0.08})`;x.fillRect(Math.random()*w,Math.random()*h,1.5,1.5);}
    x.fillStyle=c(S.ito);x.beginPath();x.moveTo(0,0);x.lineTo(w*0.5,h*0.5);x.lineTo(0,h);x.lineTo(0,h*0.86);x.lineTo(w*0.36,h*0.5);x.lineTo(0,h*0.14);x.fill();
    x.beginPath();x.moveTo(w,0);x.lineTo(w*0.5,h*0.5);x.lineTo(w,h);x.lineTo(w,h*0.86);x.lineTo(w*0.64,h*0.5);x.lineTo(w,h*0.14);x.fill();
    x.beginPath();x.moveTo(w*0.14,0);x.lineTo(w*0.5,h*0.36);x.lineTo(w*0.86,0);x.fill();x.beginPath();x.moveTo(w*0.14,h);x.lineTo(w*0.5,h*0.64);x.lineTo(w*0.86,h);x.fill();
    x.strokeStyle='rgba(255,255,255,.25)';x.lineWidth=1;x.beginPath();x.moveTo(2,2);x.lineTo(w*0.46,h*0.46);x.stroke();});
  t.repeat.set(1,7);return _kTex['i'+k]=t;}
function bladeGeo(){if(_kTex.geo)return _kTex.geo;const N=40,L=0.72,z0=-0.075,pos=[],uv=[],idx=[];
  const prof=t=>{let w=0.031-0.007*t,th=0.0075-0.002*t,lift=0;if(t>0.9){const k=(t-0.9)/0.1;w*=Math.max(0.02,1-k*k*0.98);lift=k*k*0.012;}return{w,th,lift};};
  const ring=[[-0.5,0.5,0.0],[0.5,0.5,0.0],[0.4,-0.1,0.38],[0,-0.5,1],[-0.4,-0.1,0.38]];// [x*th, y*w, v]
  for(let i=0;i<=N;i++){const t=i/N,z=z0-t*L,cy=0.05*t*t,P=prof(t);for(const r of ring){pos.push(r[0]*P.th,cy+r[1]*P.w+P.lift*(r[1]<0?1:0),z);uv.push(t,1-(r[1]+0.5));}}
  const R=ring.length;for(let i=0;i<N;i++)for(let j=0;j<R;j++){const a=i*R+j,b=i*R+(j+1)%R,c=(i+1)*R+j,d=(i+1)*R+(j+1)%R;idx.push(a,c,b,b,c,d);}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));g.setAttribute('uv',new THREE.Float32BufferAttribute(uv,2));g.setIndex(idx);g.computeVertexNormals();return _kTex.geo=g;}
function makeKatana(k){k=KSTYLE[k]?k:'wooden';const S=KSTYLE[k];const g=new THREE.Group();
  const bm=new THREE.MeshPhongMaterial({map:hamonTex(k),shininess:S.blade==='wood'?18:150,specular:S.blade==='wood'?0x332211:0xffffff,emissive:S.glow,side:THREE.DoubleSide});
  const blade=new THREE.Mesh(bladeGeo(),bm);g.add(blade);g.userData.bladeMesh=blade;
  const gold=new THREE.MeshPhongMaterial({color:S.habaki,shininess:120,specular:0xfff2c0});
  const hab=new THREE.Mesh(new THREE.BoxGeometry(0.012,0.036,0.03),gold);hab.position.set(0,0.0,-0.065);g.add(hab);
  const tsM=new THREE.MeshPhongMaterial({color:S.tsuba,shininess:60,specular:0x886644});
  const tsuba=new THREE.Mesh(new THREE.CylinderGeometry(0.042,0.042,0.008,18),tsM);tsuba.rotation.x=Math.PI/2;tsuba.scale.set(1,1,0.85);tsuba.position.z=-0.046;g.add(tsuba);
  const seppa=new THREE.Mesh(new THREE.CylinderGeometry(0.022,0.022,0.012,12),gold);seppa.rotation.x=Math.PI/2;seppa.position.z=-0.038;g.add(seppa);
  const tsuka=new THREE.Mesh(new THREE.CylinderGeometry(0.0155,0.0175,0.25,10,1),new THREE.MeshPhongMaterial({map:itoTex(k),shininess:20}));tsuka.rotation.x=Math.PI/2;tsuka.scale.set(0.82,1,1);tsuka.position.z=0.093;g.add(tsuka);
  const fuchi=new THREE.Mesh(new THREE.CylinderGeometry(0.019,0.019,0.014,10),tsM);fuchi.rotation.x=Math.PI/2;fuchi.scale.set(0.82,1,1);fuchi.position.z=-0.028;g.add(fuchi);
  const kash=new THREE.Mesh(new THREE.SphereGeometry(0.018,10,6,0,Math.PI*2,0,Math.PI/2),tsM);kash.rotation.x=Math.PI/2;kash.scale.set(0.82,1,0.8);kash.position.z=0.218;g.add(kash);
  for(const s of[-1,1]){const mn=new THREE.Mesh(new THREE.BoxGeometry(0.004,0.008,0.03),gold);mn.position.set(s*0.0135,0,0.07+s*0.03);g.add(mn);}
  g.traverse(o=>{if(o.isMesh)o.castShadow=true;});return g;}
const _kIcon={};
function katanaIcon(skin,dual){skin=KSTYLE[skin]?skin:ktnSkin();const key=skin+(dual?'d':'');if(_kIcon[key])return _kIcon[key];
  const g=new THREE.Group();const a=makeKatana(skin);a.rotation.x=dual?-0.62:-0.32;g.add(a);if(dual){const b=makeKatana(skin);b.rotation.x=0.62;b.position.set(0.02,0,0.02);b.rotation.y=Math.PI;g.add(b);}
  try{return _kIcon[key]=snap(g,256,128,'side');}catch(e){return (KTN[skin]&&KTN[skin].png)||'';}}
const KROLL=1.15;
function katanaVM(M,dual){const g=new THREE.Group();const{mk,glove,sleeve}=M;const skin=ktnSkin();
  const hand=(side)=>{const H=new THREE.Group();const O=new THREE.Group();O.rotation.set(0.9,0,0.12);O.position.set(0,0.005,0.0);H.add(O);const k=makeKatana(skin);k.scale.setScalar(0.74);k.rotation.z=KROLL;O.add(k);H.userData.k=k;
    mk(H,0.07,0.075,0.085,glove,0,-0.004,0.0);mk(H,0.072,0.072,0.2,sleeve,side*0.02,-0.075,0.13,0.55);return H;};
  const R=hand(1);g.add(R);g.userData.R=R;R.userData.rest={x:0,y:0,z:0};
  if(dual){const L=hand(-1);L.position.set(-0.36,0,0);L.scale.x=-1;g.add(L);g.userData.L=L;L.userData.rest={x:-0.36,y:0,z:0};}
  // slash trail lives in the viewmodel group
  const tm=new THREE.MeshBasicMaterial({color:skin==='sun'?0xffd36a:skin==='wooden'?0xe8d2a8:0xdff4ff,transparent:true,opacity:0,depthWrite:false,side:THREE.DoubleSide});
  const trail=new THREE.Mesh(new THREE.RingGeometry(0.34,0.5,40,1,0,Math.PI*0.95),tm);trail.renderOrder=5;g.userData.trail=trail;g.userData.trailMat=tm;g.add(trail);
  const fl=new THREE.Mesh(new THREE.PlaneGeometry(0.16,0.16),new THREE.MeshBasicMaterial({map:FIRE_TEX,color:0xbfefff,transparent:true,opacity:0,blending:THREE.AdditiveBlending,depthWrite:false}));g.userData.flash=fl;g.add(fl);
  return g;}
/* combo animation: each attack = windup → fast cut → recover */
const KCOMBO=[
  {s:{x:0.1,y:0.04,rx:0.15,ry:-0.55,rz:0.95},e:{x:-0.26,y:-0.02,rx:-0.1,ry:0.8,rz:-1.35},tr:{z:0.05,flip:0}},
  {s:{x:-0.2,y:-0.06,rx:-0.15,ry:0.7,rz:-1.5},e:{x:0.16,y:0.09,rx:0.2,ry:-0.6,rz:0.85},tr:{z:2.6,flip:1}},
  {s:{x:0.02,y:0.16,rx:1.05,ry:0.05,rz:0.25},e:{x:-0.04,y:-0.12,rx:-1.25,ry:0,rz:0.1},tr:{z:-1.45,flip:0}}];
const easeOut=t=>1-Math.pow(1-t,3),easeInOut=t=>t<0.5?2*t*t:1-Math.pow(-2*t+2,2)/2;
function kAttackPose(t,c){const C=KCOMBO[c%3];const o={x:0,y:0,z:0,rx:0,ry:0,rz:0};const lerp=(a,b,k)=>a+(b-a)*k;
  if(t<0.22){const k=easeInOut(t/0.22);for(const q in C.s)o[q]=C.s[q]*k;}
  else if(t<0.5){const k=easeOut((t-0.22)/0.28);for(const q in C.s)o[q]=lerp(C.s[q],C.e[q],k);o.z=-0.06*Math.sin(k*Math.PI);}
  else{const k=easeInOut(Math.min(1,(t-0.5)/0.5));for(const q in C.e)o[q]=C.e[q]*(1-k);}
  return o;}
function katanaAnim(m,dt,p,dual){const R=m.userData.R,L=m.userData.L;if(!R)return;const T=S.time;
  const breathe=Math.sin(T*1.7)*0.004,sway=Math.sin(T*0.9)*0.02;
  const dur=dual?0.34:0.48;const bk=vm.blockK||0;
  const poseFor=(H,which)=>{let o={x:0,y:breathe,z:0,rx:0,ry:0,rz:sway*(which?-1:1)};
    const atk=which?vm.kAtkL:vm.kAtk;if(atk!==undefined&&atk>=0&&atk<1){const a=kAttackPose(atk,which?(vm.kComboL||0):(vm.kCombo||0));for(const q in a)o[q]+=a[q]*(which?(q==='x'||q==='ry'||q==='rz'?-1:1):1);}
    // guard: single = horizontal blade across the screen; dual = crossed X
    if(bk>0){if(dual){o.x+=(which?0.1:-0.1)*bk;o.y+=0.06*bk;o.rz+=(which?-0.75:0.75)*bk;o.rx+=0.25*bk;}else{o.x-=0.08*bk;o.y+=0.04*bk;o.rz+=1.15*bk;o.rx+=0.12*bk;o.ry-=0.15*bk;}}
    const pr=vm.parry||0;o.rz+=Math.sin(pr*Math.PI)*0.3*(which?-1:1);
    const r=H.userData.rest;H.position.set(r.x+o.x*(which?-1:1)*(which?-1:1),r.y+o.y,r.z+o.z);H.rotation.set(o.rx,o.ry,o.rz);};
  if(vm.kAtk!==undefined&&vm.kAtk>=0){vm.kAtk+=dt/dur;if(vm.kAtk>=1)vm.kAtk=-1;}
  if(vm.kAtkL!==undefined&&vm.kAtkL>=0){vm.kAtkL+=dt/dur;if(vm.kAtkL>=1)vm.kAtkL=-1;}
  poseFor(R,0);if(L)poseFor(L,1);
  // inspect: spin the blade around its length
  if(vm.inspect>0){const k=1-vm.inspect/1.4;R.userData.k.rotation.z=KROLL+k*Math.PI*2;R.rotation.y+=Math.sin(k*Math.PI)*0.6;}else R.userData.k.rotation.z=KROLL;
  // trail
  const tr=m.userData.trail,tm=m.userData.trailMat;let tv=0,which=-1;
  for(const [a,w] of [[vm.kAtk,0],[vm.kAtkL,1]])if(a!==undefined&&a>0.2&&a<0.62){const k=(a-0.2)/0.42;const v=Math.sin(Math.min(1,k*1.4)*Math.PI)*0.55;if(v>tv){tv=v;which=w;}}
  if(which>=0){const c=KCOMBO[(which?vm.kComboL:vm.kCombo)%3];const k=((which?vm.kAtkL:vm.kAtk)-0.2)/0.42;tr.position.set(which?-0.2:-0.02,0.0,-0.22);tr.rotation.set(-0.35,0,c.tr.z+(which?Math.PI:0));tr.scale.set(1,1,1);tr.rotation.z+= (c.tr.flip?-1:1)*(k-0.5)*0.6;}
  tm.opacity=tv;tr.visible=tv>0.01;
  const fl=m.userData.flash;const pv=vm.parry||0;fl.material.opacity=pv*0.9;fl.visible=pv>0.01;fl.position.set(dual?-0.18:-0.05,0.09,-0.3);fl.scale.setScalar(1+pv*1.5);fl.rotation.z+=dt*8;}

/* ---- deflect: hold right-click with the katana; bullets that hit your blade fly back at the shooter ---- */
const isKatana=id=>id==='katana'||id==='dualkatana';
function canDeflect(p){return p.alive&&p.blocking&&isKatana(curW().id)&&!p.blockBroken;}
function facingFrom(p,src){const fx=-Math.sin(p.yaw),fz=-Math.cos(p.yaw);const dx=src.x-p.pos.x,dz=src.z-p.pos.z,d=Math.hypot(dx,dz)||1;return (fx*dx+fz*dz)/d;}
function tryDeflect(v,amt,att,wid,head){if(v!==player||!att||att===v||!att.alive||!canDeflect(v))return false;
  const W=WEAPONS[wid];if(!W||W.melee||W.nade||W.taser)return false;
  if(facingFrom(v,att.pos)<0.3)return false;
  const perfect=S.time-(v.blockStart||-9)<0.22;const mult=perfect?1.5:1;
  v.stamina=Math.max(0,(v.stamina||0)-(perfect?0.02:0.07));if(v.stamina<=0){v.blockBroken=true;v.blocking=false;center('<span style="color:#ff6b5f">GUARD BROKEN</span>',0.8);}
  const from=camera.position.clone().add(viewDir(v.yaw,v.pitch).multiplyScalar(0.7));const to=new V3(att.pos.x,att.pos.y+1.3,att.pos.z);
  tracer(from,to,DEFL_TR);particles(from,'spark',perfect?14:7,3);vm.parry=1;
  if(!playHZ('gp:misc/head_hit',0.7))sfx('clang');sfx('clang',perfect?1.2:0.8);
  floatText(from,perfect?'PERFECT PARRY':'DEFLECT',perfect?'#ffd23f':'#9fe8ff');
  const back=amt*0.9*mult;
  if(NET.role==='client'){netToHost({t:'hit',id:att.id,d:Math.round(back*10)/10,h:!!head,w:'katana',rf:1});}
  else damage(att,back,v,'katana',head);
  if(!att.alive){medal(perfect?'RETURN TO SENDER':'DEFLECT KILL',2);}
  return true;}
const DEFL_TR=new THREE.LineBasicMaterial({color:0x9fe8ff,transparent:true,opacity:0.95});

/* ADS height for generated/blocky models: put the top of the gun (sights, carry handle, rails) just under the
   eye line so nothing on the gun blocks the centre of the screen */
const _adsInv=new THREE.Matrix4(),_adsM=new THREE.Matrix4(),_adsB=new THREE.Box3();
function vmAdsY(m,gs){if(m.userData.adsY!==undefined)return m.userData.adsY;const def=gs?-0.058:-0.068;
  try{const P=m.position.clone(),R=m.rotation.clone();m.position.set(0,0,0);m.rotation.set(0,0,0);m.updateMatrixWorld(true);_adsInv.copy(m.matrixWorld).invert();
    let top=-1e9;m.traverse(o=>{if(!o.isMesh||!o.geometry||o.visible===false)return;if(!o.geometry.boundingBox)o.geometry.computeBoundingBox();
      _adsM.multiplyMatrices(_adsInv,o.matrixWorld);_adsB.copy(o.geometry.boundingBox).applyMatrix4(_adsM);
      if(_adsB.max.x>-0.07&&_adsB.min.x<0.07&&_adsB.min.z<0.3)top=Math.max(top,_adsB.max.y);});
    m.position.copy(P);m.rotation.copy(R);m.updateMatrixWorld(true);
    const v=top>-1e8?Math.min(def,-top-0.024):def;return m.userData.adsY=v;}catch(e){return m.userData.adsY=def;}}
function vmBase(id){const w=WEAPONS[id];const c=w.melee?'melee':w.nade?'nade':w.cat;return VMB[c]||VMB.rifle;}

/* ================= AUDIO ================= */
/* ================= AUDIO ENGINE =================
   Everything is synthesised with WebAudio except the hit/kill/throw clips (decoded from the
   embedded sound pack). Gunshots are layered: crack + body + low thump + mechanical click + reverb tail,
   with stereo panning and distance muffling for other players. Reloads play staged mechanical sounds. */
let actx=null,master=null,noiseBuf=null,verbIn=null;const AUD={pend:null,indoor:0,envT:0,beatT:0,ui:0};const OWB={};let lastHitSnd=0;
function makeIR(sec,decay){const r=actx.sampleRate,len=Math.floor(r*sec),b=actx.createBuffer(2,len,r);for(let c=0;c<2;c++){const d=b.getChannelData(c);for(let i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,decay);}return b;}
function b64buf(b64){const s=atob(b64),u=new Uint8Array(s.length);for(let i=0;i<s.length;i++)u[i]=s.charCodeAt(i);return u.buffer;}
function loadOW(){const A=window.CR_ASSETS&&window.CR_ASSETS.sounds;if(!A)return;for(const k in A){try{const p=actx.decodeAudioData(b64buf(A[k]),buf=>{OWB[k]=buf;},()=>{});if(p&&p.catch)p.catch(()=>{});}catch(e){}}}
function initAudio(){if(actx)return;try{actx=new(window.AudioContext||window.webkitAudioContext)();
  const comp=actx.createDynamicsCompressor();comp.threshold.value=-14;comp.ratio.value=6;comp.connect(actx.destination);AUD.comp=comp;
  master=actx.createGain();master.gain.value=save.vol;AUD.hp=actx.createBiquadFilter();AUD.hp.type='lowpass';AUD.hp.frequency.value=20000;master.connect(AUD.hp);AUD.hp.connect(comp);
  noiseBuf=actx.createBuffer(1,actx.sampleRate*2,actx.sampleRate);const d=noiseBuf.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;
  const verb=actx.createConvolver();verb.buffer=makeIR(1.8,3.2);verbIn=actx.createGain();verbIn.gain.value=0.5;AUD.open=actx.createGain();AUD.room=actx.createGain();verbIn.connect(AUD.open);verbIn.connect(AUD.room);AUD.open.connect(verb);verb.connect(master);
  const roomV=actx.createConvolver();roomV.buffer=makeIR(0.9,2.2);AUD.room.connect(roomV);roomV.connect(master);AUD.open.gain.value=1;AUD.room.gain.value=0;
  /* open-air slapback echo off distant buildings */const dl=actx.createDelay(1);dl.delayTime.value=0.19;const fb=actx.createGain();fb.gain.value=0.28;const dlf=actx.createBiquadFilter();dlf.type='lowpass';dlf.frequency.value=1800;AUD.slap=actx.createGain();AUD.slap.gain.value=0.35;
  AUD.open.connect(dl);dl.connect(dlf);dlf.connect(fb);fb.connect(dl);dlf.connect(AUD.slap);AUD.slap.connect(master);
  loadOW();loadHZ();}catch(e){actx=null;}}
/* 3D voice: HRTF panning (front/back + height), air absorption with distance, and muffling when a wall is in the way */
function bus3d(vol,wet,pos){const g=actx.createGain();const cam=camera.position;const dx=pos.x-cam.x,dy=(pos.y||0)+1.2-cam.y,dz=pos.z-cam.z,d=Math.hypot(dx,dy,dz);
  let occ=0;if(d>1.5&&typeof worldMeshes!=='undefined'){const dir=new V3(dx,dy,dz).divideScalar(d);raycaster.set(cam,dir);raycaster.far=d-0.6;const h=raycaster.intersectObjects(worldMeshes,false);raycaster.far=Infinity;occ=Math.min(2,h.length);}
  g.gain.value=vol*(occ?0.55/occ:1);const lp=actx.createBiquadFilter();lp.type='lowpass';lp.frequency.value=Math.max(500,(occ?1400/occ:18000)*Math.exp(-d/90));
  const pn=actx.createPanner();pn.panningModel='HRTF';pn.distanceModel='linear';pn.rolloffFactor=0;pn.refDistance=1;
  if(pn.positionX){pn.positionX.value=pos.x;pn.positionY.value=(pos.y||0)+1.2;pn.positionZ.value=pos.z;}else pn.setPosition(pos.x,(pos.y||0)+1.2,pos.z);
  g.connect(lp);lp.connect(pn);pn.connect(master);if(wet>0&&verbIn){const w=actx.createGain();w.gain.value=wet*(1+occ*0.5);pn.connect(w);w.connect(verbIn);}return g;}
function audioListener(dt){if(!actx)return;const L=actx.listener,c=camera.position;const f=new V3(0,0,-1).applyQuaternion(camera.quaternion),u=new V3(0,1,0).applyQuaternion(camera.quaternion);
  if(L.positionX){L.positionX.value=c.x;L.positionY.value=c.y;L.positionZ.value=c.z;L.forwardX.value=f.x;L.forwardY.value=f.y;L.forwardZ.value=f.z;L.upX.value=u.x;L.upY.value=u.y;L.upZ.value=u.z;}else{L.setPosition(c.x,c.y,c.z);L.setOrientation(f.x,f.y,f.z,u.x,u.y,u.z);}
  // room detection: roof over your head = tight indoor reverb, open sky = long outdoor tail + slapback
  AUD.envT-=dt;if(AUD.envT<=0&&S.state==='game'){AUD.envT=0.4;raycaster.set(c,new V3(0,1,0));raycaster.far=14;const h=raycaster.intersectObjects(worldMeshes,false);raycaster.far=Infinity;AUD.indoor=h.length?1:0;
    const t=actx.currentTime;AUD.room.gain.setTargetAtTime(AUD.indoor?1.3:0,t,0.3);AUD.open.gain.setTargetAtTime(AUD.indoor?0.25:1,t,0.3);AUD.slap.gain.setTargetAtTime(AUD.indoor?0.05:0.35,t,0.3);}
  // low health: world goes muffled and you hear your heartbeat
  const low=S.state==='game'&&player.alive&&player.hp<30*hpK();{const sc=stunCut(dt);AUD.hp.frequency.setTargetAtTime(Math.min(low?1500+player.hp/hpK()*40:20000,sc),actx.currentTime,sc<20000?0.06:0.25);}
  if(low){AUD.beatT-=dt;if(AUD.beatT<=0){AUD.beatT=0.55+player.hp/hpK()/60;const o=bus(0.9,0,0);tn(o,52,0.12,0.9,'sine',0,38);tn(o,48,0.14,0.7,'sine',0.17,34);}}}
document.addEventListener('mouseover',e=>{const t=e.target.closest&&e.target.closest('button,.mode,.tab,[data-pk],.ic.r,.case-hit,.frf');if(t&&t!==AUD.hov){AUD.hov=t;if(S.state!=='game'||S.uiOpen)uiSnd('hover');}},true);
document.addEventListener('click',e=>{const t=e.target.closest&&e.target.closest('button,.mode,.tab,[data-pk],.ic.r,.case-hit');if(!t||t.disabled)return;if(S.state==='game'&&!S.uiOpen)return;uiSnd(t.classList.contains('tab')?'tab':/close|leave|back|✕/i.test(t.id+t.textContent)?'back':'click');},true);
/* match announcer: short radio callouts using the device's voice */
let _annV=null;function announce(t){if(save.announcer===false||!window.speechSynthesis)return;try{const sy=speechSynthesis;if(!_annV){const vs=sy.getVoices();_annV=vs.find(v=>/en(-|_)(GB|US)/i.test(v.lang)&&/male|daniel|google uk english male|david|alex/i.test(v.name))||vs.find(v=>/^en/i.test(v.lang))||null;}
  sy.cancel();const u=new SpeechSynthesisUtterance(t);if(_annV)u.voice=_annV;u.rate=1.05;u.pitch=0.75;u.volume=Math.min(1,(save.vol||0.6)*1.3);setTimeout(()=>{try{sy.speak(u);}catch(e){}},0);if(actx){const o=bus(0.4,0,0);nz(o,2400,0.05,0.25,'bandpass',0,1.5);}}catch(e){}}
function uiSnd(kind){if(!actx||save.uiSnd===false)return;const now=performance.now();if(kind==='hover'&&now-AUD.ui<45)return;AUD.ui=now;const o=bus(kind==='hover'?0.18:0.35,0,0.02);
  if(kind==='hover'){tn(o,2400,0.025,0.25,'sine');tn(o,3600,0.015,0.12,'sine',0.006);}
  else if(kind==='click'){nz(o,4200,0.02,0.4,'bandpass',0,3);tn(o,1250,0.05,0.35,'triangle',0,900);tn(o,1870,0.05,0.18,'sine',0.02);}
  else if(kind==='back'){tn(o,900,0.06,0.3,'triangle',0,600);}
  else if(kind==='tab'){nz(o,2600,0.03,0.3,'bandpass',0,2);tn(o,700,0.08,0.22,'sine',0,1100);}}
function bus(vol,pan=0,wet=0){if(AUD.pend){const p=AUD.pend;AUD.pend=null;return bus3d(vol,wet,p);}const g=actx.createGain();g.gain.value=vol;let n=g;if(pan&&actx.createStereoPanner){const p=actx.createStereoPanner();p.pan.value=clamp(pan,-1,1);g.connect(p);n=p;}n.connect(master);if(wet>0&&verbIn){const w=actx.createGain();w.gain.value=wet;n.connect(w);w.connect(verbIn);}return g;}
function _env(dest,node,a,dur,at,atk=0.002){const t=actx.currentTime+at,g=actx.createGain();g.gain.setValueAtTime(0.0001,t);g.gain.linearRampToValueAtTime(Math.max(0.0001,a),t+atk);g.gain.exponentialRampToValueAtTime(0.0001,t+atk+dur);node.connect(g);g.connect(dest);return t;}
function nz(dest,f,dur,a,type='lowpass',at=0,q=0.7,f2=null){const n=actx.createBufferSource();n.buffer=noiseBuf;n.playbackRate.value=0.8+Math.random()*0.4;const fl=actx.createBiquadFilter();fl.type=type;fl.frequency.value=f;fl.Q.value=q;const t=actx.currentTime+at;if(f2)fl.frequency.exponentialRampToValueAtTime(f2,t+dur);n.connect(fl);_env(dest,fl,a,dur,at);n.start(t,Math.random()*1.5);n.stop(t+dur+0.05);}
function tn(dest,f,dur,a,type='sine',at=0,f2=null){const o=actx.createOscillator();o.type=type;const t=actx.currentTime+at;o.frequency.setValueAtTime(f,t);if(f2)o.frequency.exponentialRampToValueAtTime(f2,t+dur);_env(dest,o,a,dur,at);o.start(t);o.stop(t+dur+0.05);}
/* ===== 0.93 grenade audio: layered procedural explosion · glass · fire roar · smoke hiss · ear ringing ===== */
function sb(pos,vol,wet){const sp=spatial(pos);return bus(vol*sp.vol,sp.pan,wet);}
function nzP(dest,type,f1,f2,q,pts,at=0){const n=actx.createBufferSource();n.buffer=noiseBuf;n.loop=true;n.playbackRate.value=0.8+Math.random()*0.4;const fl=actx.createBiquadFilter();fl.type=type;fl.Q.value=q;
  const t=actx.currentTime+at,T=pts[pts.length-1][0];fl.frequency.setValueAtTime(f1,t);if(f2&&f2!==f1)fl.frequency.exponentialRampToValueAtTime(f2,t+T);
  const g=actx.createGain();g.gain.setValueAtTime(0.0001,t);for(const[pt,pg]of pts)g.gain.linearRampToValueAtTime(Math.max(0.0001,pg),t+pt);n.connect(fl);fl.connect(g);g.connect(dest);n.start(t,Math.random()*1.5);n.stop(t+T+0.05);}
function spat2(pos){const dx=pos.x-player.pos.x,dz=pos.z-player.pos.z,d=Math.hypot(dx,dz);if(d<0.5)return{vol:1,pan:0,d};const rx=Math.cos(player.yaw),rz=-Math.sin(player.yaw);return{vol:clamp(1.2/(1+d*0.06),0.03,1),pan:clamp((dx*rx+dz*rz)/d,-1,1)*0.85,d};}
function audStun(k){if(!actx||k<0.12)return;const t=actx.currentTime,dur=1.4+k*3.4;AUD.stunK=Math.max(AUD.stunK||0,k);AUD.stunT=Math.max(AUD.stunT||0,dur);AUD.stunMax=Math.max(AUD.stunT,dur);
  if(AUD.ring){try{AUD.ring.g.gain.cancelScheduledValues(t);AUD.ring.g.gain.setTargetAtTime(0.0001,t,0.05);AUD.ring.o.forEach(o=>o.stop(t+0.3));}catch(e){}}
  const g=actx.createGain(),a=0.07*k;g.gain.setValueAtTime(0.0001,t);g.gain.linearRampToValueAtTime(a,t+0.1);g.gain.setValueAtTime(a,t+0.1+dur*0.3);g.gain.exponentialRampToValueAtTime(0.0003,t+dur+0.6);
  const o1=actx.createOscillator(),o2=actx.createOscillator(),g2=actx.createGain();o1.frequency.value=4100+Math.random()*150;o2.frequency.value=6050+Math.random()*250;g2.gain.value=0.4;
  o1.connect(g);o2.connect(g2);g2.connect(g);g.connect(AUD.comp||actx.destination);o1.start(t);o2.start(t);o1.stop(t+dur+0.7);o2.stop(t+dur+0.7);AUD.ring={g,o:[o1,o2]};}
function stunCut(dt){if(!(AUD.stunT>0))return 20000;AUD.stunT-=dt;if(AUD.stunT<=0){AUD.stunT=0;AUD.stunK=0;return 20000;}
  const p=clamp(AUD.stunT/AUD.stunMax,0,1),lo=400+19600*Math.pow(1-AUD.stunK,3.2);return lo+(20000-lo)*Math.pow(1-p,2.2);}
function nadeAudio(kind,pos,vol=1){if(!actx||!pos)return;if(actx.state==='suspended')actx.resume();const d=Math.hypot(pos.x-player.pos.x,(pos.y||0)-player.pos.y,pos.z-player.pos.z);
  if(kind==='he'){const cr=clamp(1-d/45,0.12,1),o=sb(pos,1.25*vol,0.55);
    nz(o,3200,0.05,0.9*cr,'highpass',0,0.7);nz(o,1800,0.13,0.8*cr,'bandpass',0,0.9,520);
    nz(o,2600,0.6,1.0,'lowpass',0,0.8,140);nzP(o,'lowpass',900,80,0.7,[[0.005,0.8],[0.3,0.35],[1.1,0]],0.03);
    tn(o,118,0.5,1.0,'sine',0,36);tn(o,62,1.4,0.9,'sine',0.01,26);tn(o,230,0.18,0.45,'triangle',0,70);
    nzP(o,'lowpass',340,70,0.8,[[0.12,0.45],[0.6,0.3],[2.8,0]],0.06);
    const deb=sb(pos,0.9*vol*cr,0.3);for(let i=0;i<18;i++){const at=0.14+Math.pow(Math.random(),1.5)*1.7;nz(deb,700+Math.random()*3800,0.02+Math.random()*0.05,(0.22+Math.random()*0.3)*(1-at/2.2),'bandpass',at,2+Math.random()*3);}
    for(let i=0;i<5;i++)metal(deb,1800+Math.random()*2400,0.07,0.05*(1-i/6),0.35+Math.random()*1.0);
    if(d<11&&player.alive)audStun(clamp(1-d/11,0,1));}
  else if(kind==='molly'){sfx('glass',0.9,pos);const o=sb(pos,1.0*vol,0.4);
    nzP(o,'bandpass',300,1500,0.9,[[0.06,0.85],[0.25,0.55],[0.8,0]],0.03);nzP(o,'highpass',2400,5200,0.7,[[0.04,0.3],[0.55,0]],0.03);tn(o,95,0.45,0.85,'sine',0.02,38);
    nzP(o,'lowpass',520,220,0.8,[[0.2,0.5],[1.2,0.3],[2.4,0]],0.05);
    for(let i=0;i<12;i++)nz(o,1500+Math.random()*3500,0.015+Math.random()*0.03,0.18+Math.random()*0.22,'bandpass',0.12+Math.random()*1.1,3);}
  else if(kind==='smoke'){const o=sb(pos,1.0*vol,0.45);
    tn(o,150,0.14,0.75,'sine',0,55);nz(o,900,0.07,0.6,'bandpass',0,1.2,300);nz(o,3000,0.03,0.35,'highpass');
    nzP(o,'highpass',2600,1700,0.7,[[0.18,0.42],[3.2,0.34],[6.6,0]],0.05);nzP(o,'bandpass',1100,650,0.6,[[0.25,0.32],[3.0,0.24],[5.2,0]],0.06);nzP(o,'lowpass',380,200,0.7,[[0.4,0.22],[2.4,0.15],[4.2,0]],0.05);}
  else if(kind==='pin'){const o=bus(0.45*vol,0,0.05);metal(o,3500,0.22,0.16);nz(o,5200,0.02,0.18,'highpass',0.08);metal(o,2700,0.14,0.08,0.09);}}
function smokeAudio(pos){nadeAudio('smoke',pos);}
function fireCrackle(pos,k){if(!actx)return;const s=spat2(pos);if(s.vol<0.06)return;const o=sb(pos,0.42*k,0.2);const n=1+(Math.random()*3|0);
  for(let i=0;i<n;i++){const at=Math.random()*0.26;nz(o,1600+Math.random()*3600,0.012+Math.random()*0.025,0.25+Math.random()*0.3,'bandpass',at,2.5+Math.random()*2);}
  if(Math.random()<0.3)tn(o,70+Math.random()*30,0.09,0.25,'sine',Math.random()*0.2,40);}
function fireRoarStart(f){if(!actx)return null;try{const src=actx.createBufferSource();src.buffer=noiseBuf;src.loop=true;src.playbackRate.value=0.55;
  const lp=actx.createBiquadFilter();lp.type='lowpass';lp.frequency.value=520;lp.Q.value=0.6;const bp=actx.createBiquadFilter();bp.type='bandpass';bp.frequency.value=1700;bp.Q.value=0.5;
  const g2=actx.createGain();g2.gain.value=0.22;const g=actx.createGain();g.gain.value=0.0001;let out=g;let pn=null;if(actx.createStereoPanner){pn=actx.createStereoPanner();g.connect(pn);out=pn;}
  src.connect(lp);lp.connect(g);src.connect(bp);bp.connect(g2);g2.connect(g);out.connect(master);src.start(actx.currentTime,Math.random()*1.5);return{src,g,pn};}catch(e){return null;}}
function fireRoarTick(f,k){const r=f.roar;if(!r)return;const s=spat2(f.pos),t=actx.currentTime;r.g.gain.setTargetAtTime(Math.max(0.0001,0.42*k*s.vol*(0.85+0.15*Math.sin(S.time*5.3))),t,0.08);if(r.pn)r.pn.pan.setTargetAtTime(s.pan,t,0.08);}
function fireRoarStop(f){const r=f.roar;if(!r)return;f.roar=null;try{const t=actx.currentTime;r.g.gain.cancelScheduledValues(t);r.g.gain.setTargetAtTime(0.0001,t,0.08);r.src.stop(t+0.5);}catch(e){}}

function metal(dest,f,dur,a,at=0){for(const[m,k]of[[1,1],[2.76,0.6],[5.4,0.35],[8.9,0.2]])tn(dest,f*m*(0.98+Math.random()*0.04),dur*(1.2-k*0.4),a*k,'sine',at);}
function playOW(name,vol=1,rate=1,pan=0){const b=OWB[name];if(!b||!actx)return false;const s=actx.createBufferSource();s.buffer=b;s.playbackRate.value=rate;s.connect(bus(vol,pan,0.15));s.start();return true;}
function spatial(pos){AUD.pend=pos&&actx&&(save.audio3d!==false)?pos:null;if(AUD.pend)queueMicrotask(()=>{AUD.pend=null;});if(!pos)return{vol:1,pan:0,dist:0};const dx=pos.x-player.pos.x,dz=pos.z-player.pos.z,d=Math.hypot(dx,dz);if(d<0.5)return{vol:1,pan:0,dist:d};
  const rx=Math.cos(player.yaw),rz=-Math.sin(player.yaw);return{vol:clamp(1.2/(1+d*0.06),0.03,1),pan:clamp((dx*rx+dz*rz)/d,-1,1)*0.85,dist:d};}
/* per-gun voice: [crackHz, bodyHz, bodyDur, thumpHz, power, tail] */
const CATV={pistol:[5200,1500,0.09,170,0.8,0.35],smg:[5600,1700,0.07,160,0.7,0.3],shotgun:[3200,700,0.2,85,1.15,0.6],mg:[4200,1100,0.12,110,0.95,0.5],rifle:[4800,1200,0.12,130,0.95,0.5],sniper:[3800,650,0.3,60,1.3,0.85],dmr:[4200,900,0.2,90,1.1,0.65]};
const GUNV={deagle:[4300,900,0.16,95,1.15,0.6],r8:[4000,850,0.18,90,1.15,0.6],ak47:[4400,1000,0.14,115,1.0,0.55],m249:[4000,950,0.13,100,1.0,0.55],negev:[4400,1250,0.1,120,0.9,0.5],awp:[3500,520,0.38,50,1.45,1],barrett:[3300,480,0.42,45,1.5,1],ssg08:[4600,900,0.22,80,1.1,0.7],thompson:[4000,1050,0.1,120,0.85,0.4],p90:[6000,1900,0.06,170,0.65,0.3],xm1014:[3300,800,0.17,90,1.05,0.55],sawedoff:[3000,600,0.24,75,1.2,0.6]};
function hashId(id){let h=0;for(const c of id)h=(h*31+c.charCodeAt(0))>>>0;return h;}
function gunSound(id,pos){
  if(realShot(id,pos))return;
  if(!actx)return;const w=WEAPONS[id];if(!w)return;const sp=spatial(pos);if(sp.vol<0.035)return;
  const far=clamp(sp.dist/60,0,1),pv=0.96+Math.random()*0.08,hv=0.9+(hashId(id)%20)/100;
  if(w.sil){const o=bus(0.9*sp.vol,sp.pan,0.15);nz(o,3800*pv,0.07,0.45,'bandpass',0,1.2);tn(o,240*pv,0.06,0.3,'sine',0,110);metal(o,1900*pv,0.05,0.06,0.012);return;}
  const v=GUNV[id]||CATV[w.cat]||CATV.rifle;const[cr,bd,bdur,th,pw,tail]=v;
  const o=bus(sp.vol*0.85,sp.pan,tail*(0.6+far));
  if(far<0.8)nz(o,cr*hv*pv,0.018,0.55*pw*(1-far),'highpass',0,0.5);
  nz(o,bd*hv*pv*(1-far*0.6),bdur*(1+far*0.5),0.9*pw,'bandpass',0,0.6);
  nz(o,900*(1-far*0.5),bdur*1.6,0.55*pw,'lowpass',0.004);
  tn(o,th*pv,bdur*1.2,0.9*pw,'sine',0,Math.max(28,th*0.35));
  if(!pos||sp.dist<6)metal(o,2600*hv,0.035,0.05,0.015);
}
/* staged reload / handling sounds */
const REAL_MECH={rifle:{magout:'ak47m/ak47_clipout',magin:'ak47m/ak47_clipin',charge:'ak47m/ak47_boltpull',draw:'ak47m/ak47_draw'},
  smg:{magout:'mp9/mp9_clipout',magin:'mp9/mp9_clipin',charge:'mp9/mp9_boltback',draw:'mp9/mp9_draw'},
  pistol:{magout:'glock18/glock_clipout',magin:'glock18/glock_clipin',slide:'glock18/glock_sliderelease',draw:'glock18/glock_draw'},
  sniper:{magout:'awp/awp_clipout',magin:'awp/awp_clipin',bolt:'awp/awp_boltback_r',draw:'awp/awp_draw'}};
REAL_MECH.dmr=REAL_MECH.rifle;REAL_MECH.mg=Object.assign({},REAL_MECH.rifle,{draw:'ak47m/ak47_draw'});
function realMech(w,name){const m=REAL_MECH[w&&w.cat];const s=m&&m[name];if(!s)return false;const ok=playHZ('gp:'+s,0.8);
  if(ok&&name==='magout')setTimeout(()=>playHZ('gp:all/mag_drop_'+(1+(Math.random()*2|0)),0.45),280);
  if(ok&&name==='bolt')setTimeout(()=>playHZ('gp:awp/awp_boltforward_r',0.8),220);
  if(ok&&name==='charge'&&w.cat==='smg')setTimeout(()=>playHZ('gp:mp9/mp9_boltforward',0.8),160);
  return ok;}
function mech(name,pos,vol=1){
  if(!actx)return;const sp=spatial(pos);const o=bus(0.7*vol*sp.vol,sp.pan,0.08);
  switch(name){
    case 'magout':nz(o,2200,0.05,0.35,'bandpass',0,2);metal(o,1300,0.06,0.12,0.01);nz(o,700,0.08,0.25,'lowpass',0.05);break;
    case 'magin':nz(o,1600,0.04,0.4,'bandpass',0,2);metal(o,1700,0.05,0.18,0.0);tn(o,180,0.05,0.3,'square',0.0,90);metal(o,2200,0.04,0.12,0.06);break;
    case 'charge':nz(o,3000,0.06,0.35,'bandpass',0,3);metal(o,2100,0.05,0.2,0.0);nz(o,2600,0.05,0.4,'bandpass',0.12,3);metal(o,1500,0.07,0.25,0.12);tn(o,140,0.06,0.25,'square',0.12,70);break;
    case 'slide':nz(o,3400,0.05,0.35,'bandpass',0,3);metal(o,2400,0.05,0.25,0.02);tn(o,200,0.04,0.2,'square',0.02,100);break;
    case 'shell':nz(o,1800,0.03,0.3,'bandpass',0,2);metal(o,2000+Math.random()*300,0.05,0.12,0.0);tn(o,150,0.04,0.25,'square',0.0,80);break;
    case 'pump':nz(o,1400,0.07,0.5,'bandpass',0,1.5);metal(o,900,0.06,0.2,0);nz(o,1800,0.07,0.5,'bandpass',0.13,1.5);metal(o,1200,0.07,0.25,0.13);break;
    case 'bolt':nz(o,2600,0.05,0.4,'bandpass',0,2.5);metal(o,1800,0.06,0.2,0);nz(o,2000,0.06,0.35,'bandpass',0.16,2.5);metal(o,1300,0.06,0.25,0.16);nz(o,2400,0.05,0.35,'bandpass',0.32,2.5);metal(o,2000,0.05,0.2,0.32);break;
    case 'cyl':for(let i=0;i<3;i++)metal(o,2400-i*200,0.04,0.12,i*0.07);nz(o,2000,0.04,0.25,'bandpass',0,2);break;
    case 'boxopen':nz(o,1200,0.1,0.4,'bandpass',0,1.5);metal(o,800,0.12,0.2,0.02);break;
    case 'belt':for(let i=0;i<6;i++)metal(o,2600+Math.random()*600,0.03,0.07,i*0.03);break;
    case 'draw':nz(o,1200,0.12,0.25,'bandpass',0,1,2400);metal(o,2000,0.05,0.12,0.1);break;
    case 'knifedraw':nz(o,4000,0.25,0.3,'bandpass',0,4,9000);metal(o,3600,0.25,0.08,0.05);break;
    case 'swing':nz(o,1800,0.16,0.4,'bandpass',0,1.2,4200);break;
    case 'empty':metal(o,2600,0.03,0.25,0);tn(o,900,0.02,0.15,'square');break;
    case 'casing':for(let i=0;i<3;i++)metal(o,(4200+Math.random()*1200)*(i?0.92:1),0.07,0.06/(i+1),i*0.06+Math.random()*0.02);break;
    case 'hull':tn(o,320,0.06,0.15,'triangle',0,200);tn(o,300,0.05,0.08,'triangle',0.12,190);break;
    case 'step':nz(o,700+Math.random()*300,0.07,0.55,'lowpass',0,0.8);nz(o,2400,0.025,0.12,'highpass',0.005);break;
    case 'land':nz(o,500,0.12,0.7,'lowpass');tn(o,90,0.08,0.3,'sine',0,50);break;
    case 'whiz':nz(o,5000,0.16,0.5,'bandpass',0,6,1400);break;
    case 'ric':tn(o,3000+Math.random()*2000,0.18,0.08,'sine',0,1200+Math.random()*600);nz(o,4000,0.03,0.12,'highpass');break;
  }
}
const RELOAD_STAGES={pistol:[[0.15,'magout'],[0.55,'magin'],[0.85,'slide']],smg:[[0.15,'magout'],[0.55,'magin'],[0.85,'charge']],rifle:[[0.15,'magout'],[0.55,'magin'],[0.85,'charge']],dmr:[[0.15,'magout'],[0.55,'magin'],[0.85,'charge']],sniper:[[0.15,'magout'],[0.5,'magin'],[0.8,'bolt']],mg:[[0.1,'boxopen'],[0.35,'magout'],[0.55,'belt'],[0.75,'magin'],[0.9,'charge']],shotgun:[[0.15,'magout'],[0.55,'magin'],[0.85,'pump']]};
function reloadStages(w){if(w.id==='r8')return[[0.1,'cyl'],[0.5,'shell'],[0.6,'shell'],[0.85,'cyl']];if(w.id==='dualies')return[[0.1,'magout'],[0.35,'magin'],[0.55,'magout'],[0.75,'magin'],[0.9,'slide']];return RELOAD_STAGES[w.cat]||RELOAD_STAGES.rifle;}
function sfx(name,vol=1,pos){
  if(!actx)return;if(actx.state==='suspended')actx.resume();
  const GW=WEAPONS[name];if(GW&&!GW.nade&&!GW.melee&&!GW.taser){gunSound(name,pos);return;}
  const sp=spatial(pos);const o=bus(vol*sp.vol,sp.pan,0.12);
  switch(name){
    case 'enemy':gunSound('ak47',pos);break;
    case 'knife':mech('swing',null,vol);break;
    case 'throw':if(!playOW('bow',0.7*vol,1.1))nz(o,1800,0.15,0.2,'bandpass');break;
    case 'hit':{const now=performance.now();if(now-lastHitSnd<55)break;lastHitSnd=now;if(!playOW('successful_hit',0.55*vol,1.0))tn(o,1300,0.05,0.12,'square');break;}
    case 'head':lastHitSnd=performance.now();if(!playHZ('gp:misc/head_hit',0.9)){if(!playOW('successful_hit',0.6*vol,1.38))tn(o,1900,0.12,0.25);metal(o,2900,0.18,0.18,0.0);}break;
    case 'kill':if(HZB['ki:kill_sound'])break;playOW(pick(['bowhit1','bowhit2','bowhit3','bowhit4']),0.7*vol,1.15);tn(o,880,0.09,0.18,'triangle');tn(o,1320,0.16,0.18,'triangle',0.08);break;
    case 'empty':if(!playHZ('gp:misc/dry_fire',0.8))mech('empty');break;
    case 'reload':mech('magout');break;
    case 'shell':mech('shell');break;
    case 'scope':/* lens zoom: click + short servo whirr */nz(o,4200,0.02,0.28,'highpass');metal(o,1800,0.03,0.08,0.01);tn(o,320,0.12,0.06,'sawtooth',0.02,520);nz(o,2600,0.1,0.08,'bandpass',0.02,6,3600);break;
    case 'buy':/* gear grab: cloth rustle + metal clack + soft confirm */nz(o,1800,0.09,0.35,'bandpass',0,1.2,900);metal(o,1500,0.05,0.12,0.03);tn(o,140,0.06,0.35,'sine',0.03,80);tn(o,880,0.07,0.12,'triangle',0.05);tn(o,1320,0.12,0.12,'triangle',0.11);break;
    case 'deny':/* muted double thud */for(const at of[0,0.11]){tn(o,170,0.09,0.22,'triangle',at,120);nz(o,400,0.06,0.18,'lowpass',at);}break;
    case 'pickup':nz(o,2200,0.12,0.3,'bandpass',0,1.4,1100);metal(o,1100,0.06,0.16,0.04);tn(o,90,0.08,0.4,'sine',0.04,60);metal(o,1700,0.05,0.1,0.12);break;
    case 'hurt':if(!playOW('sx_hit'+(1+Math.floor(Math.random()*3)),0.8*vol))tn(o,120,0.18,0.5,'sine',0,60);nz(o,600,0.08,0.2);break;
    case 'beep':/* radio chirp */nz(o,2600,0.03,0.25,'bandpass',0,2);tn(o,1180,0.06,0.18,'square',0.02);tn(o,1480,0.07,0.14,'square',0.08);nz(o,3200,0.05,0.12,'bandpass',0.15,3);break;
    case 'bombbeep':/* C4 beep: two detuned square tones through a tiny speaker */{const f=actx.createBiquadFilter();f.type='bandpass';f.frequency.value=2200;f.Q.value=2.5;f.connect(o);tn(f,2093,0.085,0.35,'square');tn(f,2108,0.085,0.25,'square');nz(o,6000,0.006,0.08,'highpass');}break;
    case 'go':/* round start: radio squelch + rising horn */nz(o,2400,0.05,0.35,'bandpass',0,1.5);[392,523,659].forEach((f,i)=>{tn(o,f,0.5-i*0.1,0.12,'sawtooth',0.04+i*0.06);tn(o,f*2,0.4,0.05,'triangle',0.04+i*0.06);});nz(o,120,0.25,0.35,'lowpass',0.04);nz(o,2400,0.04,0.25,'bandpass',0.6,1.5);break;
    case 'warn':/* alarm: two-tone klaxon with a low pulse */for(let i=0;i<3;i++){tn(o,i%2?622:880,0.2,0.13,'sawtooth',i*0.22);tn(o,i%2?311:440,0.2,0.09,'square',i*0.22);}tn(o,55,0.8,0.35,'sine',0,40);break;
    case 'land':if(!playOW(vol>1?'sx_fallbig':'sx_fallsmall',0.8))mech('land');break;
    case 'click':nz(o,5000,0.012,0.25,'highpass');metal(o,2400,0.03,0.08,0.004);tn(o,180,0.02,0.15,'square',0.002,90);break;
    case 'slide':nz(o,1500,0.6,0.32,'bandpass',0,0.9,420);nz(o,300,0.35,0.18,'lowpass');break;
    case 'jump':/* gear shake + push-off */nz(o,650,0.09,0.2,'lowpass');nz(o,2800,0.07,0.08,'bandpass',0.01,2);metal(o,1600,0.04,0.04,0.02);break;
    case 'backstab':if(!playHZ('gp:misc/head_hit',1))tn(o,1900,0.12,0.25);tn(o,140,0.3,0.5,'sine',0,50);metal(o,3200,0.15,0.2);break;
    case 'boom':{const b2=bus(vol*sp.vol,sp.pan,0.9);if(!playOW(Math.random()<.5?'sx_explode1':'sx_explode2',1.1*vol*sp.vol,0.95+Math.random()*0.1,sp.pan))nz(b2,500,1.4,1.0);nz(b2,2500,0.08,0.4,'highpass');tn(b2,70,0.9,0.8,'sine',0,22);break;}
    case 'smoke':/* pop, then a long pressurised hiss that settles */nz(o,1200,0.05,0.5,'bandpass',0,1.5);tn(o,110,0.12,0.4,'sine',0,60);nz(o,5200,2.4,0.28,'highpass',0.05,0.7,1800);nz(o,900,1.8,0.25,'lowpass',0.08,0.7,250);break;
    case 'molly':nz(o,3800,0.12,0.5,'highpass');for(let i=0;i<4;i++)nz(o,5200+i*700,0.04,0.25,'bandpass',0.02+i*0.035,6);nz(o,700,0.9,0.45,'lowpass',0.05,0.7,180);break;
    case 'fire':for(let i=0;i<3;i++)nz(o,1800+Math.random()*2400,0.03,0.12+Math.random()*0.1,'bandpass',Math.random()*0.4,3);nz(o,400,0.6,0.12,'lowpass');break;
    case 'splash':nz(o,1400,0.35,0.5,'bandpass',0,1.2,500);nz(o,5000,0.12,0.2,'highpass');break;
    case 'wade':nz(o,900,0.28,0.35,'bandpass',0,1.5,350);nz(o,2600,0.1,0.12,'bandpass',0.05,3);break;
    case 'kwhoosh':nz(o,900,0.28,0.45,'bandpass',0,1.4,2600);nz(o,3200,0.18,0.18,'highpass',0.05);break;
    case 'glass':nz(o,5200,0.09,1.1*vol,'highpass');nz(o,2600,0.22,0.55*vol,'bandpass',0.01,1.2);nz(o,7000,0.5,0.35*vol,'highpass',0.05);
      for(let i=0;i<9;i++){const at=0.04+Math.random()*0.55,f=2800+Math.random()*5200;tn(o,f,0.05+Math.random()*0.08,(0.18+Math.random()*0.2)*vol,'sine',at);tn(o,f*1.51,0.04,0.08*vol,'triangle',at);}
      nz(o,1800,0.12,0.25*vol,'bandpass',0.45+Math.random()*0.2,2);break;
    case 'clang':metal(o,2600+Math.random()*900,0.35,0.55*vol);tn(o,1800,0.12,0.25,'triangle');nz(o,6000,0.06,0.3,'highpass');break;
    case 'hiss':nz(o,4200,0.9,0.35,'highpass',0,0.7,2000);break;
    case 'zeus':nz(o,5200,0.3,0.5,'highpass');tn(o,95,0.25,0.3,'square');for(let i=0;i<5;i++)nz(o,3000+i*400,0.03,0.3,'bandpass',i*0.05,4);break;
    case 'inspect':nz(o,1800,0.25,0.16,'bandpass',0,1.2,900);metal(o,1300,0.05,0.07,0.12);nz(o,3600,0.05,0.08,'bandpass',0.3,2);metal(o,2200,0.04,0.05,0.34);break;
    case 'win':{/* victory fanfare: brass-like stabs, rising major arpeggio, held chord + cymbal */
      const br=(f,at,d,a)=>{tn(o,f,d,a,'sawtooth',at);tn(o,f*2,d,a*0.35,'triangle',at);tn(o,f*1.005,d,a*0.5,'square',at);};
      br(392,0,0.14,0.16);br(392,0.16,0.14,0.16);br(523,0.32,0.5,0.2);
      [523,659,784,1046].forEach((f,i)=>tn(o,f,0.22,0.16,'triangle',0.62+i*0.09));
      [523,659,784].forEach(f=>{tn(o,f,1.5,0.13,'sawtooth',1.0);tn(o,f/2,1.5,0.1,'triangle',1.0);});tn(o,1046,1.4,0.1,'sine',1.0);
      nz(o,7000,1.1,0.22,'highpass',1.0);nz(o,140,0.35,0.5,'lowpass',0.32);nz(o,140,0.35,0.55,'lowpass',1.0);break;}
    case 'lose':{/* defeat stinger: slow falling minor line over a low drum and a dark drone */
      [[392,0],[349,0.42],[311,0.84],[262,1.26]].forEach(([f,at],i)=>{tn(o,f,i===3?1.6:0.48,0.15,'sawtooth',at);tn(o,f/2,i===3?1.6:0.48,0.1,'triangle',at);});
      tn(o,98,2.6,0.2,'sine',0.0);tn(o,65,2.6,0.16,'sine',1.26);
      nz(o,110,0.6,0.55,'lowpass',0.0);nz(o,90,0.9,0.6,'lowpass',1.26);nz(o,2400,1.2,0.05,'bandpass',1.3,0.8);break;}
    case 'rwin':[392,523,659,784].forEach((f,i)=>{tn(o,f,0.3,0.12,'sawtooth',i*0.08);tn(o,f/2,0.35,0.08,'triangle',i*0.08);});tn(o,784,0.9,0.1,'triangle',0.32);nz(o,7000,0.6,0.07,'highpass',0.32);nz(o,120,0.3,0.35,'lowpass',0);break;
    case 'rlose':[392,370,311].forEach((f,i)=>{tn(o,f,0.38,0.12,'sawtooth',i*0.2);tn(o,f/2,0.4,0.08,'triangle',i*0.2);});tn(o,73,1.1,0.3,'sine',0.4,55);break;
    case 'levelup':/* rising arpeggio, bass hit, shimmering chord */tn(o,65,0.5,0.45,'sine',0,45);[523,659,784,1046,1318].forEach((f,i)=>{tn(o,f,0.22,0.16,'triangle',i*0.07);tn(o,f*2,0.12,0.05,'sine',i*0.07);});[1046,1318,1568].forEach(f=>tn(o,f,1.0,0.07,'sine',0.38));nz(o,8000,0.9,0.08,'highpass',0.36);break;
    case 'medal':{const k=vol>1.2?1.26:1;[784,988,1175,1568].forEach((f,i)=>{tn(o,f*k,0.16,0.15,'triangle',i*0.06);tn(o,f*k*2.01,0.08,0.04,'sine',i*0.06);});metal(o,3000*k,0.4,0.05,0.24);nz(o,9000,0.4,0.05,'highpass',0.22);}break;
  }
}

/* footsteps from the sound pack: sand outdoors, wood on crates, stone on rooftops, cloth on ladders */
const STEP_N={sand:5,stone:4,wood:3,cloth:2};
function stepSound(pos,surface,vol=1){const sp=spatial(pos);if(sp.vol<0.04)return;const n=STEP_N[surface]||5;
  if(!playOW('sx_'+surface+(1+Math.floor(Math.random()*n)),0.55*vol*sp.vol,0.94+Math.random()*0.12,sp.pan))mech('step',pos,vol);}

/* ================= STATE ================= */
const S={state:'menu',mode:null,time:0,ents:[],bots:[],byId:{},targets:[],loot:[],fx:[],decals:[],floats:[],nades:[],smokes:[],uiOpen:false,buyOpen:false,paused:false,ended:false,locked:false,noLock:false,countdown:0,timeLeft:0,teamScore:{A:0,B:0},score:0,tHits:0,zone:null,respawns:false,endT:0,place:0,tSpawnT:0,nearLoot:null,cdShown:0,round:null,simClock:0,spec:null,netT:0};
const player={isPlayer:true,id:'h',name:'You',team:'A',pos:new V3(),vel:new V3(),yaw:0,pitch:0,hp:100,armor:0,alive:true,onGround:true,onLadder:false,crouch:0,money:0,inv:{},nades:[],kit:false,hasBomb:false,planting:0,defusing:0,slot:2,prevSlot:3,cool:0,reloading:false,reloadT:0,switchT:0,kills:0,deaths:0,heads:0,shots:0,hits:0,spawnTime:0,respawnT:0,deadT:0,sprayIdx:0,punchP:0,punchY:0,lastFire:-9,moving:false,lastShot:-9,scoped:false,rescope:false,score:0,place:0};
const keys={};const mouse={down:false};
const raycaster=new THREE.Raycaster();const tmpV2=new V3();
function DIFFC(){return DIFF[(S&&S.rankDiff)||save.diff]||DIFF.normal;}
function eyeOf(e){tmpV2.set(e.pos.x,e.pos.y+(e.isPlayer?1.62-e.crouch*0.55:1.6-(e.crouch||0)*0.42),e.pos.z);if(e.isPlayer&&e.leanOff){tmpV2.x+=e.leanOff.x;tmpV2.z+=e.leanOff.z;}return tmpV2;}

/* ---- sub-tick key log ---- */
const KL={};
function klDown(code,t){let r=KL[code];if(!r)r=KL[code]={down:false,since:0,segs:[]};if(!r.down){r.down=true;r.since=t;}}
function klUp(code,t){const r=KL[code];if(r&&r.down){r.down=false;r.segs.push([r.since,t]);if(r.segs.length>8)r.segs.shift();}}
function held(code,t0,t1){const r=KL[code];if(!r)return 0;let h=0;for(const[s,e]of r.segs)h+=Math.max(0,Math.min(e,t1)-Math.max(s,t0));if(r.down)h+=Math.max(0,t1-Math.max(r.since,t0));return clamp(h/(t1-t0),0,1);}

/* ================= COLLISION ================= */
/* spatial hash for colliders: movement checks only nearby boxes instead of the whole map */
const CG=4;let CGRID=null,CGSRC=null,CGN=-1,CGQ=0;const CGOUT=[];
function cgrid(){if(CGRID&&CGSRC===colliders&&CGN===colliders.length)return CGRID;const m=new Map();
  for(const c of colliders){const x0=Math.floor(c.minX/CG),x1=Math.floor(c.maxX/CG),z0=Math.floor(c.minZ/CG),z1=Math.floor(c.maxZ/CG);
    for(let i=x0;i<=x1;i++)for(let j=z0;j<=z1;j++){const k=(i+4096)*8192+(j+4096);let a=m.get(k);if(!a)m.set(k,a=[]);a.push(c);}}
  CGRID=m;CGSRC=colliders;CGN=colliders.length;return m;}
function nearCol(x,z,r){const m=cgrid();CGQ++;CGOUT.length=0;const x0=Math.floor((x-r)/CG),x1=Math.floor((x+r)/CG),z0=Math.floor((z-r)/CG),z1=Math.floor((z+r)/CG);
  for(let i=x0;i<=x1;i++)for(let j=z0;j<=z1;j++){const a=m.get((i+4096)*8192+(j+4096));if(!a)continue;for(const c of a){if(c._q===CGQ)continue;c._q=CGQ;CGOUT.push(c);}}return CGOUT;}
function collide(p,r,feetY,height,step=0){let stepTo=-1;
  for(const c of nearCol(p.x,p.z,r+0.1)){
    if(feetY>=c.maxY-0.05||feetY+height<=c.minY)continue;
    if(step>0&&c.maxY-feetY<=step){const cx=Math.max(c.minX,Math.min(p.x,c.maxX)),cz=Math.max(c.minZ,Math.min(p.z,c.maxZ));if((p.x-cx)**2+(p.z-cz)**2<r*r){stepTo=Math.max(stepTo,c.maxY);continue;}}
    const cx=Math.max(c.minX,Math.min(p.x,c.maxX)),cz=Math.max(c.minZ,Math.min(p.z,c.maxZ));
    const dx=p.x-cx,dz=p.z-cz,d2=dx*dx+dz*dz;
    if(d2<r*r){
      if(d2>1e-8){const d=Math.sqrt(d2);p.x=cx+dx/d*r;p.z=cz+dz/d*r;}
      else{const pl=p.x-c.minX,pr=c.maxX-p.x,pb=p.z-c.minZ,pf=c.maxZ-p.z,m=Math.min(pl,pr,pb,pf);
        if(m===pl)p.x=c.minX-r;else if(m===pr)p.x=c.maxX+r;else if(m===pb)p.z=c.minZ-r;else p.z=c.maxZ+r;}
    }
  }
  return stepTo;
}
function groundAt(x,z,feetY,r){let h=0;for(const c of nearCol(x,z,r+0.1)){if(c.maxY<=feetY+0.35&&x>c.minX-r*0.5&&x<c.maxX+r*0.5&&z>c.minZ-r*0.5&&z<c.maxZ+r*0.5)h=Math.max(h,c.maxY);}return h;}
function openPoint(cx,cz,rad,minDist,team){
  for(let i=0;i<70;i++){
    const a=rng()*Math.PI*2,r=Math.sqrt(rng())*rad;
    const x=clamp(cx+Math.cos(a)*r,-mapH+2,mapH-2),z=clamp(cz+Math.sin(a)*r,-mapH+2,mapH-2);
    if(blocked(x,z,0.8))continue;
    if(ISL&&!islIn(x,z,3))continue;
    if(minDist&&i<55){let ok=true;for(const e of S.ents){if(e.alive&&e.team!==team&&e.pos&&Math.hypot(e.pos.x-x,e.pos.z-z)<minDist){ok=false;break;}}if(!ok)continue;}
    return new V3(x,0,z);
  }
  return new V3(cx,0,cz);
}
function smokeBlocks(o,t){for(const s of S.smokes){if(s.age<0.8)continue;const d=t.clone().sub(o),L=d.length();if(L<0.01)continue;d.divideScalar(L);const k=clamp(s.pos.clone().sub(o).dot(d),0,L);const cp=o.clone().addScaledVector(d,k);if(cp.distanceTo(s.pos)<s.r*0.85)return true;}return false;}
function los(a,b){
  const o=new V3(a.pos.x,a.pos.y+(a.isPlayer?1.62-a.crouch*0.55:1.6),a.pos.z);
  const t=eyeOf(b).clone();if(smokeBlocks(o,t))return false;
  const dir=t.clone().sub(o);const dist=dir.length();if(dist<0.01)return true;dir.divideScalar(dist);
  raycaster.set(o,dir);raycaster.far=dist;const h=raycaster.intersectObjects(worldMeshes,false);raycaster.far=Infinity;
  return h.length===0;
}

/* ================= FX ================= */
function bloodOn(){return (save.age||18)>=16&&save.blood!==false;}
/* ---- blood v2: exit mist, stretched droplets with gravity, wall + floor splatter, pools under bodies ---- */
const BLOOD={};
function bloodInit(){if(BLOOD.mist)return BLOOD;
  BLOOD.mistTex=canvasTex(64,(c,s)=>{const g=c.createRadialGradient(s/2,s/2,0,s/2,s/2,s/2);g.addColorStop(0,'rgba(150,10,10,.95)');g.addColorStop(0.45,'rgba(110,6,6,.55)');g.addColorStop(1,'rgba(80,0,0,0)');c.fillStyle=g;c.fillRect(0,0,s,s);});
  const splat=(seed,big)=>canvasTex(128,(c,s)=>{let sd=seed;const R=()=>((sd=(Math.imul(sd,1103515245)+12345)>>>0)/4294967296);c.clearRect(0,0,s,s);
    const blob=(x,y,r,a)=>{const g=c.createRadialGradient(x,y,0,x,y,r);g.addColorStop(0,`rgba(92,4,4,${a})`);g.addColorStop(0.7,`rgba(120,8,8,${a*0.9})`);g.addColorStop(1,'rgba(120,8,8,0)');c.fillStyle=g;c.beginPath();c.arc(x,y,r,0,7);c.fill();};
    const cx=s/2,cy=s/2;for(let i=0;i<(big?9:5);i++)blob(cx+(R()-0.5)*s*0.22,cy+(R()-0.5)*s*0.22,s*(0.1+R()*0.12),0.95);
    for(let i=0;i<(big?26:14);i++){const a=R()*Math.PI*2,d=s*(0.18+R()*0.3),r=1+R()*4;blob(cx+Math.cos(a)*d,cy+Math.sin(a)*d,r,0.9);
      if(R()<0.4){c.strokeStyle='rgba(100,6,6,.8)';c.lineWidth=1+R()*1.5;c.beginPath();c.moveTo(cx+Math.cos(a)*s*0.12,cy+Math.sin(a)*s*0.12);c.lineTo(cx+Math.cos(a)*d,cy+Math.sin(a)*d);c.stroke();}}});
  BLOOD.splats=[splat(11,true),splat(23,false),splat(37,true),splat(51,false)].map(t=>new THREE.MeshLambertMaterial({map:t,transparent:true,depthWrite:false,polygonOffset:true,polygonOffsetFactor:-4,color:0xffffff}));
  BLOOD.pool=new THREE.MeshPhongMaterial({map:canvasTex(128,(c,s)=>{c.clearRect(0,0,s,s);let sd=77;const R=()=>((sd=(Math.imul(sd,1103515245)+12345)>>>0)/4294967296);for(let i=0;i<14;i++){const x=s/2+(R()-0.5)*s*0.4,y=s/2+(R()-0.5)*s*0.4,r=s*(0.12+R()*0.16);const g=c.createRadialGradient(x,y,0,x,y,r);g.addColorStop(0,'rgba(70,0,0,.95)');g.addColorStop(0.8,'rgba(85,3,3,.9)');g.addColorStop(1,'rgba(85,3,3,0)');c.fillStyle=g;c.beginPath();c.arc(x,y,r,0,7);c.fill();}}),transparent:true,depthWrite:false,shininess:90,specular:0x552222,polygonOffset:true,polygonOffsetFactor:-6});
  BLOOD.drop=new THREE.MeshBasicMaterial({color:0x7a0606});BLOOD.dropGeo=new THREE.SphereGeometry(0.018,5,4);BLOOD.plane=new THREE.PlaneGeometry(1,1);return BLOOD;}
/* height of the visible surface under a point (ray down, ignoring invisible collision boxes) */
const _bfDown=new V3(0,-1,0);function bloodFloor(x,z,y){raycaster.set(new V3(x,y+0.3,z),_bfDown);raycaster.far=y+2;const h=raycaster.intersectObjects(worldMeshes,false).find(o=>o.object.material&&o.object.material.visible!==false);raycaster.far=Infinity;return h?h.point.y:0;}
function bloodClear(){if(S.blood)for(const b of S.blood)scene.remove(b.m);S.blood=[];const orphans=scene.children.filter(o=>o.userData&&o.userData.blood);for(const o of orphans)scene.remove(o);}
function bloodDecal(pos,normal,size,mat,life=40){const B=bloodInit();const m=new THREE.Mesh(B.plane,mat.clone());m.material.opacity=1;m.position.copy(pos).addScaledVector(normal,0.012);m.lookAt(pos.clone().add(normal));m.rotateZ(Math.random()*Math.PI*2);m.scale.setScalar(size);m.renderOrder=2;m.userData.blood=1;scene.add(m);
  S.blood=S.blood||[];S.blood.push({m,kind:'decal',life,max:life});if(S.blood.filter(b=>b.kind!=='drop'&&b.kind!=='mist').length>70){const i=S.blood.findIndex(b=>b.kind==='decal');if(i>=0){scene.remove(S.blood[i].m);S.blood.splice(i,1);}}return m;}
/* main entry: a bullet (or blade) hit flesh at `pt`, travelling along `dir` */
function bloodHit(pt,dir,head,power=1){if(!bloodOn()){particles(pt,'dust',4);return;}const B=bloodInit();S.blood=S.blood||[];dir=(dir||new V3(0,0,-1)).clone().normalize();
  const nm=head?3:2;for(let i=0;i<nm;i++){const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:B.mistTex,transparent:true,depthWrite:false,opacity:0.75}));sp.position.copy(pt).addScaledVector(dir,0.05+i*0.08);sp.scale.setScalar(0.12);sp.userData.blood=1;scene.add(sp);
    S.blood.push({m:sp,kind:'mist',life:0.35+i*0.08+(head?0.15:0),max:0.35+i*0.08+(head?0.15:0),v:dir.clone().multiplyScalar(1.2+i*0.6).add(new V3(0,0.25,0)),grow:(head?1.6:1)*(0.9+Math.random()*0.5)});}
  const nd=Math.round((head?14:8)*power*fxMul());for(let i=0;i<nd;i++){const m=new THREE.Mesh(B.dropGeo,B.drop);m.position.copy(pt);const v=dir.clone().multiplyScalar(2+Math.random()*3.5).add(new V3((Math.random()-0.5)*2.2,Math.random()*2.2-0.2,(Math.random()-0.5)*2.2));
    m.scale.set(1,1,1.8+Math.random()*1.4);m.userData.blood=1;scene.add(m);S.blood.push({m,kind:'drop',life:1.6,max:1.6,v,splat:Math.random()<0.35});}
  // splatter on a wall behind the target
  raycaster.set(pt.clone().addScaledVector(dir,0.25),dir);raycaster.far=head?3.2:2.4;const h=raycaster.intersectObjects(worldMeshes,false).find(x=>x.object.material&&x.object.material.visible!==false&&!x.object.userData.gloo);raycaster.far=Infinity;
  if(h&&h.face){const n=h.face.normal.clone().transformDirection(h.object.matrixWorld);bloodDecal(h.point,n,(head?1.15:0.75)*(0.8+Math.random()*0.5)*(1-h.distance/5),B.splats[(Math.random()*4)|0]);}
  // a few drops on the floor under the hit
  if(Math.random()<0.7){const gy=bloodFloor(pt.x,pt.z,pt.y);bloodDecal(new V3(pt.x+dir.x*0.5+(Math.random()-0.5)*0.4,gy,pt.z+dir.z*0.5+(Math.random()-0.5)*0.4),new V3(0,1,0),0.45+Math.random()*0.35,B.splats[(Math.random()*4)|0]);}}
function bloodPool(v){if(!bloodOn()||!v||!v.pos)return;const B=bloodInit();const a=v.deathAng!==undefined?v.deathAng:Math.random()*6;const gy=bloodFloor(v.pos.x+Math.sin(a)*0.9,v.pos.z+Math.cos(a)*0.9,v.pos.y+0.5);
  const m=bloodDecal(new V3(v.pos.x+Math.sin(a)*0.9,gy,v.pos.z+Math.cos(a)*0.9),new V3(0,1,0),0.05,B.pool,30);const rec=S.blood[S.blood.length-1];rec.kind='pool';rec.grow=1.5+Math.random()*0.7;rec.delay=0.6;}
function updateBlood(dt){if(!S.blood||!S.blood.length)return;for(let i=S.blood.length-1;i>=0;i--){const b=S.blood[i];b.life-=dt;
  if(b.kind==='mist'){const k=1-b.life/b.max;b.m.position.addScaledVector(b.v,dt);b.v.multiplyScalar(Math.exp(-5*dt));b.v.y-=0.6*dt;b.m.scale.setScalar(0.15+k*0.8*b.grow);b.m.material.opacity=0.75*Math.max(0,1-k)*(1-k*0.3);}
  else if(b.kind==='drop'){b.v.y-=12*dt;b.m.position.addScaledVector(b.v,dt);b.m.lookAt(b.m.position.clone().add(b.v));const gy=bloodFloor(b.m.position.x,b.m.position.z,b.m.position.y+0.05);
    if(b.m.position.y<=gy+0.01||b.life<0.05){if(b.splat)bloodDecal(new V3(b.m.position.x,gy,b.m.position.z),new V3(0,1,0),0.16+Math.random()*0.2,BLOOD.splats[(Math.random()*4)|0],25);b.life=0;}}
  else if(b.kind==='pool'){if(b.delay>0)b.delay-=dt;else{const s=b.m.scale.x;if(s<b.grow)b.m.scale.setScalar(Math.min(b.grow,s+dt*0.7*(1.25-s/b.grow)));}if(b.life<4)b.m.material.opacity=Math.max(0,b.life/4);}
  else if(b.kind==='decal'){if(b.life<4)b.m.material.opacity=Math.max(0,b.life/4);}
  if(b.life<=0){scene.remove(b.m);if(b.m.material&&b.kind!=='drop')b.m.material.dispose();const j=S.blood.indexOf(b);if(j>=0)S.blood.splice(j,1);}}}
function particles(pos,type,n,spd=2){if(type==='blood'&&!bloodOn())type='dust';n=Math.max(1,Math.round(n*(typeof fxMul==='function'?fxMul():1)));for(let i=0;i<n;i++){const m=new THREE.Mesh(GEO.part,PMAT[type]);m.position.copy(pos);scene.add(m);S.fx.push({m,v:new V3((Math.random()-0.5)*2*spd,0.5+Math.random()*spd,(Math.random()-0.5)*2*spd),life:0.25+Math.random()*0.3,kind:'p'});}}
function tracer(a,b,mat=TRACER){const g=new THREE.BufferGeometry().setFromPoints([a.clone(),b.clone()]);const l=new THREE.Line(g,mat);scene.add(l);S.fx.push({m:l,life:0.05,kind:'t'});}
function boom(pos,size){if(GP.active){const d=player.pos.distanceTo(pos);if(d<30)gpRumble(clamp(1.1-d/25,0,1),clamp(0.9-d/30,0,1),320);}{const dd=player.pos.distanceTo(pos);shake(clamp(1.2-dd/25,0,1.2));if(size>=2)FUN.rum=Math.max(FUN.rum||0,clamp(1-dd/22,0,1)*0.9);}boomFX(pos,size);}
function decal(pos,normal){const m=new THREE.Mesh(GEO.decal,DECAL);m.position.copy(pos);if(normal)m.position.addScaledVector(normal,0.01);scene.add(m);S.decals.push(m);if(S.decals.length>80)scene.remove(S.decals.shift());}
function updateFx(dt){updateBlood(dt);for(let i=S.fx.length-1;i>=0;i--){const f=S.fx[i];f.life-=dt;
  if(f.kind==='p'){f.v.y-=9.8*dt;f.v.multiplyScalar(Math.exp(-1.6*dt));f.m.position.addScaledVector(f.v,dt);if(f.m.position.y<0.02&&f.v.y<0){f.m.position.y=0.02;f.v.y*=-0.28;f.v.x*=0.55;f.v.z*=0.55;}}
  else if(f.kind==='case'){if(!f.landed){f.v.y-=12*dt;f.m.position.addScaledVector(f.v,dt);f.m.rotation.x+=f.spin.x*dt;f.m.rotation.z+=f.spin.y*dt;const gy=groundAt(f.m.position.x,f.m.position.z,f.m.position.y,0)+0.01;if(f.m.position.y<=gy){f.m.position.y=gy;if(!f.bounced)mech(f.hull?'hull':'casing',f.m.position,0.6);if(f.v.y<-1.4&&(f.bounced||0)<2){f.v.y*=-0.35;f.v.x*=0.5;f.v.z*=0.5;f.spin.multiplyScalar(0.5);f.bounced=(f.bounced||0)+1;}else{f.landed=true;f.m.rotation.x=Math.PI/2;}}}}
  else if(f.kind==='boom'){const k=1-f.life/0.55;f.m.scale.setScalar(0.3+k*f.max);f.m.material.opacity=Math.max(0,1-k);}
  else if(f.kind==='spr')fxTickSpr(f,dt);
  else if(f.kind==='spk')fxSparkTick(f,dt);
  else if(f.kind==='deb'){f.v.y-=13*dt;f.m.position.addScaledVector(f.v,dt);f.m.rotation.x+=f.spin.x*dt;f.m.rotation.y+=f.spin.y*dt;const gy=groundAt(f.m.position.x,f.m.position.z,f.m.position.y,0)+0.04;if(f.m.position.y<gy){f.m.position.y=gy;f.v.y*=-0.3;f.v.x*=0.5;f.v.z*=0.5;f.spin.multiplyScalar(0.5);}if(f.life<0.3)f.m.scale.setScalar(Math.max(0.01,(f.s||1)*f.life/0.3));}
  if(f.life<=0){scene.remove(f.m);if(f.kind==='t'||f.kind==='spk')f.m.geometry.dispose();if(f.kind==='boom'||f.kind==='spr')f.m.material.dispose();S.fx.splice(i,1);}}}
function floatText(pos,txt,color){const el=document.createElement('div');el.className='float';el.textContent=txt;el.style.color=color;$('floats').appendChild(el);S.floats.push({el,pos:pos.clone(),t:0});return el;}
function updateFloats(dt){for(let i=S.floats.length-1;i>=0;i--){const f=S.floats[i];f.t+=dt;if(f.t>0.9){f.el.remove();S.floats.splice(i,1);continue;}const p=f.pos.clone().project(camera);if(p.z>1){f.el.style.opacity=0;continue;}f.el.style.left=((p.x*.5+.5)*innerWidth)+'px';f.el.style.top=((-p.y*.5+.5)*innerHeight-f.t*50)+'px';f.el.style.opacity=1-f.t/0.9;}}
let cmT=0,hmT=0,dmgA=0;
function dmgDirShow(src){const el=$('dmgDir');if(!el)return;const p=player;const a=Math.atan2(src.x-p.pos.x,src.z-p.pos.z);let rel=a-(p.yaw+Math.PI);rel=Math.atan2(Math.sin(rel),Math.cos(rel));
  const b=document.createElement('div');b.className='dd';b.style.transform=`rotate(${-rel}rad)`;el.appendChild(b);setTimeout(()=>{b.style.opacity=0;},250);setTimeout(()=>b.remove(),1300);while(el.children.length>4)el.firstChild.remove();}
function gpKeys(t){if(!GP.active||!t)return t;const u=padName(5),f=padName(7);return String(t).replace(/\[E\]/g,'['+u+']').replace(/holding E\b/g,'holding '+u).replace(/HOLD E\b/g,'HOLD '+u).replace(/press B\b/g,'press D-pad →').replace(/click to switch/g,f+' to switch');}
function center(html,dur=2){const el=$('cmsg');el.innerHTML=gpKeys(html);el.style.opacity=html?1:0;cmT=dur;}
function hitmarker(head,kill){const el=$('hitmark');el.className=kill?'kill':head?'head':'';el.style.opacity=1;hmT=kill?0.35:0.18;}
function teamColor(e){if(!e)return '#ffb38a';if(e.isPlayer)return '#ffd34d';if(S.mode==='tdm')return e.team==='A'?'#6cb8ff':'#ff7a6b';if(S.mode==='defuse')return e.team==='CT'?'#6cb8ff':'#ffb35c';return '#ff9a7a';}
function wName(wid){return wid==='fall'?'⤓ Fall':wid==='zone'?'☁ Zone':wid==='bomb'?'✸ Bomb':(WEAPONS[wid]?WEAPONS[wid].name:'');}
function feed(att,wid,v,head){const d=document.createElement('div');d.className='kf';if(att===player||v===player)d.classList.add('me');
  d.innerHTML=(att?`<b style="color:${teamColor(att)}">${esc(att.name)}</b>`:'')+`<span class="kw">${wName(wid)}${head?' ◉':''}</span><b style="color:${teamColor(v)}">${esc(v.name)}</b>`;
  const kf=$('killfeed');kf.prepend(d);setTimeout(()=>d.remove(),5000);while(kf.children.length>6)kf.lastChild.remove();}

/* ================= FUN LAYER: medals, streaks, damage numbers, shake, casings, footsteps ================= */
const FUN={multi:0,multiT:-9,streak:0,firstBlood:false,medals:[],queue:[],showT:0,shake:0,stepAcc:0,stepSide:0,slowmo:0,pendingFinish:null};
const MULTI={2:'DOUBLE KILL',3:'TRIPLE KILL',4:'QUAD KILL',5:'ACE'},STREAK={3:'KILLING SPREE',5:'RAMPAGE',7:'UNSTOPPABLE',10:'GODLIKE',15:'LEGENDARY',20:'COMBAT HORIZENS'};
function resetFun(){Object.assign(FUN,{multi:0,multiT:-9,streak:0,firstBlood:false,medals:[],queue:[],showT:0,shake:0,slowmo:0,pendingFinish:null});const el=$('medal');if(el)el.className='';}
function medal(name,tier=1){FUN.medals.push(name);FUN.queue.push({name,tier});}
function onPlayerKill(v,wid,head,dist){
  const p=player,w=WEAPONS[wid]||{};anKill(wid,head,dist);try{agOnKill();if(v&&v.pos)agKillFx(v.pos);}catch(e){}
  if(S.time-FUN.multiT<4)FUN.multi++;else FUN.multi=1;FUN.multiT=S.time;FUN.streak++;
  if(!FUN.firstBlood){FUN.firstBlood=true;if(S.mode!=='practice')medal('FIRST BLOOD',2);}
  if(MULTI[FUN.multi])medal(MULTI[FUN.multi],FUN.multi>=4?3:2);
  if(STREAK[FUN.streak])medal(STREAK[FUN.streak],FUN.streak>=7?3:2);
  if(w.melee)medal('HUMILIATION',2);else if(wid==='zeus')medal('SHOCKER',2);else if(wid==='he')medal('BOOM',1);
  else if(head)medal('HEADSHOT',1);
  if((w.cat==='sniper'||w.cat==='dmr')&&!p.scoped&&w.zoom)medal('NO-SCOPE',3);
  if(!p.onGround&&!w.melee&&p.alive)medal('AIR STRIKE',2);
  if(dist>45&&!w.melee)medal('LONG SHOT',1);
  if(p.alive&&p.hp<=20*hpK())medal('CLUTCH',2);
  killBanner(FUN.multi,!!head&&!w.melee,FUN.multi>=5);
}
function onPlayerDeathFun(){FUN.streak=0;}
function updateFun(dt){
  const el=$('medal');
  if(FUN.showT>0){FUN.showT-=dt;if(FUN.showT<=0)el.className='';}
  else if(FUN.queue.length){const m=FUN.queue.shift();el.textContent=m.name;el.className='show t'+m.tier;void el.offsetWidth;el.classList.add('pop');FUN.showT=1.1;sfx('medal',m.tier>=3?1.5:1);}
  FUN.shake=Math.max(0,FUN.shake-dt*6);FUN.rum=Math.max(0,(FUN.rum||0)-dt*1.6);
  const k=$('streak');const sv=FUN.streak>=2&&player.alive?'🔥 '+FUN.streak:'';if(k._v!==sv){k._v=sv;k.textContent=sv;}
}
function shake(a){FUN.shake=Math.min(1.2,FUN.shake+a);}
function dmgNumber(pos,dmg,head){if(!save.dmgNums||!pos)return;const el=floatText(pos,String(Math.round(dmg)),head?'#ffd34d':'#ffffff');if(el){el.classList.add('dn');if(head)el.classList.add('hd');}}
const CASING_GEO=new THREE.CylinderGeometry(0.008,0.008,0.03,6),CASING_MAT=new THREE.MeshLambertMaterial({color:0xd6a842,emissive:0x3a2a08}),HULL_MAT=new THREE.MeshLambertMaterial({color:0xb02a20});
function ejectCasing(w){
  if(w.melee||w.nade||w.taser||!w.mag)return;
  const p=player,f=viewDir(p.yaw,p.pitch),r=new V3(Math.cos(p.yaw),0,-Math.sin(p.yaw));
  const m=new THREE.Mesh(CASING_GEO,w.pellets?HULL_MAT:CASING_MAT);if(w.pellets)m.scale.set(2,1.6,2);
  m.position.copy(camera.position).addScaledVector(f,0.45).addScaledVector(r,0.18).add(new V3(0,-0.1,0));scene.add(m);
  const v=r.clone().multiplyScalar(2+Math.random()*1.2).add(new V3(0,2+Math.random(),0)).add(p.vel.clone().multiplyScalar(0.8));
  S.fx.push({m,v,life:1.2,kind:'case',spin:new V3(Math.random()*20,Math.random()*20,0),landed:false,hull:!!w.pellets});
}
function footsteps(dt){
  const p=player;if(!p.alive||!p.onGround||p.onLadder)return;
  const walk=keys.AltLeft||keys.AltRight;const sp=Math.hypot(p.vel.x,p.vel.z);
  if(walk||p.crouch>0.5||sp<2.4)return;   // walking / crouching is silent — like the real thing
  FUN.stepAcc+=sp*dt;if(FUN.stepAcc>1.9){FUN.stepAcc=0;const g=p.pos.y;stepSound(null,g<0.05?'sand':g<2.5?'wood':'stone',p.sprinting?1.15:0.8);}
}
function botStepSounds(b,dt){if(!b.alive||!b.moving)return;const d=Math.hypot(b.pos.x-player.pos.x,b.pos.z-player.pos.z);if(d>24)return;b.stepAcc=(b.stepAcc||0)+dt*3.4;if(b.stepAcc>1.9){b.stepAcc=0;stepSound(b.pos,'sand',1.1);}}
function ladderSteps(dt){const p=player;if(!p.onLadder||Math.abs(p.vel.y)<0.5)return;FUN.ladAcc=(FUN.ladAcc||0)+Math.abs(p.vel.y)*dt;if(FUN.ladAcc>0.55){FUN.ladAcc=0;stepSound(null,'cloth',0.9);}}

/* ================= TACTICAL SYSTEMS ================= */
/* ---- weapon weight / feel ---- */
const WEIGHT={pistol:0.6,smg:0.8,rifle:1.0,dmr:1.15,shotgun:1.2,mg:1.45,sniper:1.35,melee:0.5,taser:0.5};
const KICK={pistol:0.014,smg:0.009,rifle:0.016,dmr:0.032,shotgun:0.05,mg:0.013,sniper:0.065,taser:0.01};
function wWeight(w){return w?(WEIGHT[w.cat]||(w.melee?0.5:1)):1;}
function shotFeel(w){const p=player,k=KICK[w.cat]||0.012;p.vkP=(p.vkP||0)+k*(0.8+Math.random()*0.4);p.vkY=(p.vkY||0)+(Math.random()-0.5)*k*0.7;p.vkR=(p.vkR||0)+(Math.random()-0.5)*k*0.9;
  p.vkF=Math.min(5,(p.vkF||0)+(w.cat==='sniper'?3.2:w.cat==='shotgun'?2.4:w.cat==='dmr'?1.2:0.35));p.vkZ=Math.min(0.06,(p.vkZ||0)+k*0.9);
  if(actx){const W=wWeight(w);const o=bus(0.55*Math.min(1.4,W),0,0.25);tn(o,48+Math.random()*10,0.13*W,0.5,'sine',0,30);nz(o,380,0.35*W,0.12,'lowpass',0.03,0.6,140);}}
function updateShotFeel(dt){const p=player;const d=Math.exp(-dt*16),df=Math.exp(-dt*9);p.vkP=(p.vkP||0)*d;p.vkY=(p.vkY||0)*d;p.vkR=(p.vkR||0)*d;p.vkF=(p.vkF||0)*df;p.vkZ=(p.vkZ||0)*d;}
/* ---- magazines + manual multi-step reload ---- */
function syncMags(ws,w){if(!w.mag||w.shell)return;const tot=ws.reserve|0;let sum=0;if(ws.mags)for(const m of ws.mags)sum+=m;if(!ws.mags||sum!==tot){ws.mags=[];let r=tot;while(r>0){const n=Math.min(w.mag,r);ws.mags.push(n);r-=n;}}}
function magTotal(ws){let s=0;for(const m of ws.mags||[])s+=m;return s;}
function manualOn(){return (save.reloadMode||'auto')==='manual';}
const MR_STEP={out:0.42,in:0.5,chamber:0.36};
function manualReloadPress(){const p=player,ws=p.inv[p.slot],w=curW();if(!ws||!w.mag||w.shell||p.reloading)return false;if(p.healT>0){if(p.healDone)return true;cancelHeal(true);}syncMags(ws,w);
  const st=ws.mr||'ready';
  if(st==='ready'){if(ws.ammo>=w.mag+(ws.chamber?1:0))return true;if(!ws.mags.length){center(S.mode==='br'?'No spare ammo — loot some':'No spare ammo — find an AMMO crate',1.2);sfx('deny');return true;}
    setScoped(false);ws.chamber=ws.ammo>0?1:0;p.reloading=true;p.reloadT=MR_STEP.out;p.mstep='out';if(!realMech(w,'magout'))mech('magout');return true;}
  if(st==='out'){if(!ws.mags.length){center('No magazines left — grab ammo',1);return true;}p.reloading=true;p.reloadT=MR_STEP.in;p.mstep='in';if(!realMech(w,'magin'))mech('magin');return true;}
  if(st==='chamber'){p.reloading=true;p.reloadT=MR_STEP.chamber;p.mstep='chamber';if(!realMech(w,'charge'))mech('charge');return true;}
  return false;}
function finishManualStep(){const p=player,ws=p.inv[p.slot],w=curW();const s=p.mstep;p.mstep=null;p.reloading=false;if(!ws)return;
  if(s==='out'){const left=ws.ammo-(ws.chamber||0);if(left>0)ws.mags.push(left);ws.ammo=ws.chamber||0;ws.mr='out';}
  else if(s==='in'){ws.mags.sort((a,b)=>b-a);const m=ws.mags.shift();ws.ammo+=m;ws.mr=ws.chamber?'ready':'chamber';if(!ws.chamber)ws.ammo=Math.max(0,ws.ammo);}
  else if(s==='chamber'){ws.chamber=1;ws.mr='ready';}
  if(S.mode==='practice'&&s==='in')ws.mags.push(w.mag);
  ws.reserve=magTotal(ws);}
function mrHint(){const p=player,ws=p.inv[p.slot],w=curW();if(!ws||!w.mag||w.shell||!manualOn()||!p.alive)return '';
  if(p.mstep)return p.mstep==='out'?'Dropping magazine…':p.mstep==='in'?'Inserting magazine…':'Chambering…';
  if(ws.mr==='out')return '<kbd>R</kbd> insert magazine'+(ws.mags&&ws.mags.length?` <small>(${ws.mags.length} in rig · best ${Math.max(...ws.mags)})</small>`:' <small>(rig empty)</small>');
  if(ws.mr==='chamber')return '<kbd>R</kbd> chamber a round';
  if(ws.ammo===0&&ws.reserve>0)return '<kbd>R</kbd> drop magazine';return '';}
/* ---- ammo crates (hold E to restock your rig) ---- */
function ammoCrate(x,z){const g=new THREE.Group();const M=pm(0x3f4f2a),Y=pm(0xd8b030),D=pm(0x22261c);
  solid(x,0,z,1.2,0.62,0.7,M);const lid=new THREE.Mesh(new THREE.BoxGeometry(1.24,0.06,0.74),D);lid.position.set(x,0.65,z);world.add(lid);
  for(const ox of[-0.45,0.45]){const st=new THREE.Mesh(new THREE.BoxGeometry(0.06,0.63,0.72),Y);st.position.set(x+ox,0.31,z);world.add(st);}
  const tag=new THREE.Mesh(new THREE.PlaneGeometry(0.42,0.2),new THREE.MeshBasicMaterial({map:canvasTex(64,(c,w,h)=>{c.fillStyle='#d8b030';c.fillRect(0,0,w,h);c.fillStyle='#1a1a1a';c.font='bold 22px Arial';c.textAlign='center';c.textBaseline='middle';c.fillText('AMMO',w/2,h/2+1);},32)}));tag.position.set(x,0.36,z+0.356);world.add(tag);
  const tag2=tag.clone();tag2.position.z=z-0.356;tag2.rotation.y=Math.PI;world.add(tag2);
  S.crates.push({x,z,cd:{}});}
function nearCrate(p){for(const c of S.crates||[])if(Math.hypot(p.pos.x-c.x,p.pos.z-c.z)<1.6)return c;return null;}
function updateCrates(dt){const p=player;if(!p.alive||!S.crates||!S.crates.length){S.rearm=0;return;}const c=nearCrate(p);S.nearCrate=c;
  const ready=c&&!(c.cd[p.id]>S.time);
  if(c&&ready&&keys.KeyE&&!S.uiOpen&&!S.nearLoot){S.rearm=(S.rearm||0)+dt;if(S.rearm>=1.4){S.rearm=0;c.cd[p.id]=S.time+20;let got=0;
      for(const sl of[1,2]){const ws=p.inv[sl];if(ws){const w=WEAPONS[ws.id];const add=Math.max(0,w.reserve-ws.reserve);ws.reserve=w.reserve;if(ws.mags){let r=add;while(r>0){const n=Math.min(w.mag,r);ws.mags.push(n);r-=n;}}got+=add;}}
      if(p.armor<50)p.armor=50;mech('magin');sfx('buy');floatText(new V3(c.x,1.2,c.z),got?'+'+got+' rounds':'Rig full','#9fe870');}}
  else S.rearm=0;}
/* ---- lean (Z / X) ---- */
function updateLean(p,dt,busy){const want=busy?0:(keys.KeyZ?-1:0)+(keys.KeyX?1:0);p.lean=(p.lean||0)+(want-(p.lean||0))*Math.min(1,dt*10);
  const r=new V3(Math.cos(p.yaw),0,-Math.sin(p.yaw));let off=0.42*p.lean;
  if(Math.abs(off)>0.01){const head=new V3(p.pos.x,p.pos.y+1.5-p.crouch*0.55,p.pos.z);const dir=r.clone().multiplyScalar(Math.sign(off));raycaster.set(head,dir);raycaster.far=Math.abs(off)+0.25;const h=raycaster.intersectObjects(worldMeshes,false)[0];raycaster.far=Infinity;if(h)off=Math.sign(off)*Math.max(0,h.distance-0.25);}
  p.leanOff=(p.leanOff||new V3()).copy(r).multiplyScalar(off);p.leanRoll=-0.16*p.lean;}
/* ---- cover: how much of the player can a shooter actually see ---- */
function exposure(from,t){if(!t.isPlayer)return 1;const lo=t.leanOff||{x:0,z:0};const head=new V3(t.pos.x+lo.x,t.pos.y+1.62-t.crouch*0.55,t.pos.z+lo.z),body=new V3(t.pos.x,t.pos.y+1.05-t.crouch*0.4,t.pos.z);
  const vis=pt=>{const d=pt.clone().sub(from),L=d.length();d.divideScalar(L);raycaster.set(from,d);raycaster.far=L-0.05;const h=raycaster.intersectObjects(worldMeshes,false);raycaster.far=Infinity;return !h.length;};
  const hv=vis(head),bv=vis(body);return bv?1:hv?0.4:0;}
/* ---- enemy classes ---- */
const BOT_CLASS={
  rusher:{n:'Rusher',guns:['mp9','mac10','mp7','p90','ump45','xm1014','mag7','nova'],hp:85,armor:0,spd:1.32,react:0.75,want:4,col:0xd0342c},
  heavy:{n:'Heavy',guns:['m249','negev','m249','spas'],hp:150,armor:100,spd:0.74,react:1.1,want:12,col:0x3a3d42},
  tactical:{n:'Tactical',guns:['ak47','m4a4','m4a1s','aug','sg553','awp','ssg08','m1a'],hp:100,armor:50,spd:1.0,react:0.95,want:22,col:0x5f7a3a}};
function pickClass(){const r=Math.random();return r<0.35?'rusher':r<0.6?'heavy':'tactical';}
function classMark(b){const s=b.model,C=BOT_CLASS[b.cls];if(!s||!C)return;if(s.clsMark){for(const m of s.clsMark)m.parent&&m.parent.remove(m);}s.clsMark=[];
  const add=(geo,mat,x,y,z)=>{const m=new THREE.Mesh(geo,mat);const par=s.up?(y>1.68?s.head:s.up):s.g,o=par.userData.o||new V3();m.position.set(x-o.x,y-o.y,z-o.z);m.castShadow=true;par.add(m);s.clsMark.push(m);m.userData.ent=b;m.userData.head=par===s.head;return m;};
  if(b.cls==='rusher'){add(new THREE.BoxGeometry(0.35,0.06,0.33),pm(C.col),0,1.86,0);add(new THREE.BoxGeometry(0.06,0.18,0.04),pm(C.col),0.08,1.75,-0.17);}
  if(b.cls==='heavy'){add(new THREE.BoxGeometry(0.5,0.46,0.12),pm(C.col),0,1.33,0.2);add(new THREE.BoxGeometry(0.5,0.46,0.1),pm(C.col),0,1.33,-0.2);
    for(const sx of[-1,1])add(new THREE.BoxGeometry(0.16,0.14,0.26),pm(C.col),sx*0.3,1.52,0);add(new THREE.BoxGeometry(0.3,0.12,0.06),pm(0x111111),0,1.77,0.15);s.g.scale.set(1.08,1.02,1.08);}
  if(b.cls==='tactical'){for(let i=0;i<6;i++)add(new THREE.BoxGeometry(0.12+Math.random()*0.1,0.05,0.1),pm(i%2?0x4a6a2a:0x6a7a3a),(Math.random()-0.5)*0.3,1.9+Math.random()*0.04,(Math.random()-0.5)*0.3);}}
function applyClass(b,keepGun){if(b.isNet||b.isProxy||b.human)return;if(!(S.mode==='tdm'||S.mode==='ffa'||S.mode==='br'))return;
  b.cls=b.cls||pickClass();const C=BOT_CLASS[b.cls];b.hp=Math.round(C.hp*hpK());b.armor=C.armor;b.spdK=C.spd;b.reactK=C.react;
  if(!keepGun&&S.mode!=='br'){b.wpn=WEAPONS[C.guns[Math.floor(Math.random()*C.guns.length)]]||b.wpn;b.mag=b.wpn.mag;}
  b.nadeT=S.time+6+Math.random()*8;classMark(b);}
function botThrow(b,t){const kinds=['he','he','he','flashbang','molotov'];const id=kinds[Math.floor(Math.random()*kinds.length)];
  const from=new V3(b.pos.x,b.pos.y+1.6,b.pos.z);const dx=t.pos.x-from.x,dz=t.pos.z-from.z,d=Math.hypot(dx,dz);
  const vy=5+d*0.16,g=15;const tf=(vy+Math.sqrt(vy*vy+2*g*Math.max(0,from.y-t.pos.y)))/g;const vh=Math.min(17,d/tf*1.06);
  const vel=new V3(dx/d*vh,vy,dz/d*vh);spawnNade(id,from,vel,b,false);if(NET.role==='host')netBroadcast({t:'nade',id,p:[from.x,from.y,from.z],v:[vel.x,vel.y,vel.z],by:b.id});
  b.nadeT=S.time+10+Math.random()*8;if(t===player&&Math.random()<0.8)center('<span style="color:#ffb35c">GRENADE!</span>',0.8);sfx('throw',0.6,b.pos);}
function coverSpot(b,t){let best=null,bd=1e9;for(const c of nearCol(b.pos.x,b.pos.z,14)){const h=c.maxY-c.minY;if(h<1||h>12)continue;
    const cx=(c.minX+c.maxX)/2,cz=(c.minZ+c.maxZ)/2;const ax=cx-t.pos.x,az=cz-t.pos.z,al=Math.hypot(ax,az)||1;const half=Math.max(c.maxX-c.minX,c.maxZ-c.minZ)/2+0.9;
    const sx=cx+ax/al*half,sz=cz+az/al*half;const d=Math.hypot(sx-b.pos.x,sz-b.pos.z);if(d<bd&&!blocked(sx,sz,0.35)){bd=d;best=new V3(sx,0,sz);}}return best;}
/* ---- cover props + ammo crate placement ---- */
let _sbTex=null;function sandbagMat(){if(!_sbTex)_sbTex=canvasTex(128,(c,w,h)=>{c.fillStyle='#6e6248';c.fillRect(0,0,w,h);for(let r=0;r<4;r++){const off=r%2?w/4:0;for(let i=-1;i<3;i++){const x=off+i*w/2,y=r*h/4;const g=c.createLinearGradient(0,y,0,y+h/4);g.addColorStop(0,'#9a8a66');g.addColorStop(0.5,'#857552');g.addColorStop(1,'#4d4330');c.fillStyle=g;c.beginPath();c.ellipse(x+w/4,y+h/8,w/4-2,h/8-1.5,0,0,Math.PI*2);c.fill();c.strokeStyle='rgba(40,32,20,.5)';c.beginPath();c.moveTo(x+w/4,y+3);c.lineTo(x+w/4,y+h/4-3);c.stroke();}}},128);return pm(0xffffff,{map:_sbTex});}
let _bagTex=null,_bagMats=null,_bagGeo=null,_bagInv=null;
function bagMats(){if(_bagMats)return _bagMats;
  _bagTex=canvasTex(128,(c,w,h)=>{c.fillStyle='#fff';c.fillRect(0,0,w,h);for(let y=0;y<h;y+=2)for(let x=0;x<w;x+=2){const v=((x>>1)+(y>>1))%2?222:250;c.fillStyle=`rgb(${v},${v-4},${v-12})`;c.fillRect(x,y,2,2);}
    for(let i=0;i<60;i++){c.strokeStyle=`rgba(90,70,40,${0.08+Math.random()*0.15})`;c.lineWidth=1;c.beginPath();const x0=Math.random()*w,y0=Math.random()*h;c.moveTo(x0,y0);c.lineTo(x0+(Math.random()-0.5)*30,y0+(Math.random()-0.5)*8);c.stroke();}
    for(let i=0;i<18;i++){c.fillStyle=`rgba(80,60,35,${Math.random()*0.18})`;c.beginPath();c.arc(Math.random()*w,Math.random()*h,4+Math.random()*12,0,7);c.fill();}
    c.strokeStyle='rgba(70,50,30,.55)';c.lineWidth=2;c.setLineDash([3,3]);c.beginPath();c.moveTo(w*0.88,0);c.lineTo(w*0.88,h);c.stroke();});
  _bagMats=[0xa8946a,0x9a8660,0xb39f74,0x8f7d58].map(c=>Lm({color:c,map:_bagTex}));_bagInv=new THREE.MeshBasicMaterial({visible:false});
  _bagGeo=rbox(0.54,0.19,0.32,0.085,2);return _bagMats;}
/* sandbag wall: staggered courses of individual pillow-shaped bags, two deep; one invisible box handles collision and bullets */
function sandbags(x,z,len,hor){const M=bagMats();const W=hor?len:0.72,D=hor?0.72:len;const col=solid(x,0,z,W,1.0,D,_bagInv);
  const rows=5,bl=0.5;for(let r=0;r<rows;r++){const n=Math.max(1,Math.round(len/bl)),off=(r%2?bl/2:0),y=0.1+r*0.18;const top=r===rows-1;
    for(const dz of top?[0]:[-0.17,0.17]){for(let i=0;i<n-(r%2?1:0);i++){const t=-len/2+bl/2+i*bl+off;if(t>len/2-bl/2+0.01)continue;
      const m=new THREE.Mesh(_bagGeo,M[(i*7+r*3+(dz>0?1:0))%M.length]);const jx=(Math.random()-0.5)*0.03,jr=(Math.random()-0.5)*0.12;
      if(hor){m.position.set(x+t+jx,y,z+dz);m.rotation.set((Math.random()-0.5)*0.06,jr,(Math.random()-0.5)*0.05);}else{m.position.set(x+dz,y,z+t+jx);m.rotation.set((Math.random()-0.5)*0.05,Math.PI/2+jr,(Math.random()-0.5)*0.06);}
      m.scale.set(1+(Math.random()-0.5)*0.08,top?0.9:1,top?1.25:1);m.castShadow=true;m.receiveShadow=true;world.add(m);}}}
  return col;}
function tacticalProps(mode,H){S.crates=S.crates||[];if(mode==='practice')return;const keep=CL_MODES[mode]?navKeep():[];
  const nS=CL_MODES[mode]?3:Math.min(14,Math.round(H/5));for(let i=0;i<nS*3&&i<200;i++){if(i>=nS*3)break;const len=rand(2.4,4.2),hor=rng()<0.5,f=freeSpot(H,len/2+1.2,keep,8);if(!f)continue;sandbags(f[0],f[1],len,hor);if(rng()<0.45){const l2=rand(1.6,2.6);const ox=hor?(rng()<.5?-1:1)*(len/2+0.38):0.75*(rng()<.5?-1:1),oz=hor?0.75*(rng()<.5?-1:1):(rng()<.5?-1:1)*(len/2+0.38);if(!blocked(f[0]+ox,f[1]+oz,(hor?0.75:l2)/2+0.4))sandbags(f[0]+ox*(hor?1:1),f[1]+oz,hor?0.75:l2,!hor);}}
  const at=[];if(mode==='tdm'){at.push([spawns.A.x+5,spawns.A.z-6],[spawns.B.x-5,spawns.B.z+6]);}if(mode==='defuse'){at.push([spawns.T.x+5,spawns.T.z-6],[spawns.CT.x-5,spawns.CT.z+6]);}
  /* 0.95: ammo crates never land on a bot route */const okA=(x,z)=>!blocked(x,z,1)&&!keep.some(([kx,kz,kr])=>Math.hypot(x-kx,z-kz)<(kr||5)+0.9);
  for(const[x,z]of at){let q=okA(x,z)?[x,z]:null;for(let k=0;!q&&k<24;k++){const a=k*0.9,d=2+k*0.35,qx=x+Math.cos(a)*d,qz=z+Math.sin(a)*d;if(okA(qx,qz))q=[qx,qz];}if(!q)q=freeSpot(H,1,keep,20);if(q)ammoCrate(q[0],q[1]);}
  const extra=mode==='br'?26:mode==='tdm'?4:0;for(let i=0;i<extra;i++){const f=freeSpot(H,1,keep,20);if(f)ammoCrate(f[0],f[1]);}}

/* ================= ENTITIES / BOTS ================= */
const BOT_GUNS=['ak47','ak47','m4a4','m4a1s','galil','famas','sg553','aug','mp9','mac10','mp7','ump45','p90','mp5','bizon','xm1014','nova','mag7','deagle','p250','fiveseven','tec9','awp','ssg08','m249','negev','thompson','spas','m1a'];
function randBotGun(){return BOT_GUNS[Math.floor(Math.random()*BOT_GUNS.length)];}
let botSeq=0;
function spawnBot(name,team,accent,wid,opts={}){
  const s=makeSoldier(accent,opts.pal);scene.add(s.g);if(S.mut==='bighead'&&s.head)s.head.scale.setScalar(1.6);
  const b={isPlayer:false,id:opts.id||('b'+(botSeq++)),isNet:!!opts.isNet,isProxy:!!opts.isProxy,human:!!opts.human,lvl:opts.lvl||0,name,team,model:s,pos:new V3(),tpos:new V3(),tyaw:0,yaw:0,hp:hpMax(),armor:0,alive:true,wpn:WEAPONS[wid]||WEAPONS.glock,mag:(WEAPONS[wid]||WEAPONS.glock).mag,kills:0,deaths:0,money:800,kit:false,hasBomb:false,planting:0,defusing:0,role:null,target:null,hasLOS:false,think:Math.random()*0.3,react:0,burst:0,cool:0,strafe:1,strafeT:0,advance:0,wp:null,stuckT:0,holdT:0,waitT:0,deadT:0,lastShot:-9,walkT:0,moving:false,crouch:0,score:0,place:0};
  for(const p of s.parts)p.userData.ent=b;for(const p of s.hit||[])p.userData.ent=b;
  const myTeam=player.team;
  if((S.mode==='tdm'||S.mode==='defuse')&&team===myTeam){const mk=new THREE.Mesh(new THREE.OctahedronGeometry(0.12),new THREE.MeshBasicMaterial({color:b.human?0x7dff9b:0x4ea8ff}));mk.position.y=2.35;s.g.add(mk);}
  S.bots.push(b);S.ents.push(b);S.byId[b.id]=b;
  if(!opts.isProxy){placeEnt(b);b.tpos.copy(b.pos);}
  applyClass(b,false);
  syncBot(b);return b;
}
/* ---- death animation: knees buckle, body falls away from the shot, small bounce, gun drops ---- */
function resetPose(m){if(!m||!m.g)return;if(m.up){m.pelvis.position.set(0,0.92,0);m.pelvis.rotation.set(0,0,0);m.up.rotation.set(0,0,0);m.head.rotation.set(0,0,0);m.gun.position.set(0.06,0.23,0.22);m.legL.rotation.set(0,0,0);m.legR.rotation.set(0,0,0);if(m.an){m.an.recoil=0;m.an.spd=0;m.an.crouch=0;}}m.g.rotation.order='YXZ';m.g.rotation.set(0,m.g.rotation.y,0);if(m.gun){m.gun.rotation.set(0,0,0);}if(m.kneeL){m.kneeL.rotation.x=0.08;m.kneeR.rotation.x=0.08;}if(m.ankL){m.ankL.rotation.set(-0.08,0,0);m.ankR.rotation.set(-0.08,0,0);}m.legL.rotation.x=0;m.legR.rotation.x=0;}
function deathPose(e,m,yawG,baseY){const t=e.deadT||0,hs=!!e.deathHead,seed=e.deathSeed||0.5;
  const T1=hs?0.1:0.2,T2=hs?0.42:0.68;
  const k1=Math.min(1,t/T1);const kf=clamp((t-T1*0.5)/(T2-T1*0.5),0,1);const fe=kf*kf*(2-kf*0.9);
  let fall=Math.PI/2*0.94*Math.min(1,fe);if(t>T2)fall-=Math.abs(Math.sin((t-T2)*17))*Math.exp(-(t-T2)*7.5)*0.16;
  const a=(e.deathAng!==undefined?e.deathAng:yawG+Math.PI)-yawG;
  m.g.rotation.order='YXZ';m.g.rotation.y=yawG+(seed-0.5)*0.7*kf;m.g.rotation.x=Math.cos(a)*fall;m.g.rotation.z=-Math.sin(a)*fall;
  m.g.position.y=baseY-0.32*k1*(1-kf);
  if(m.kneeL){m.kneeL.rotation.x=0.08+1.15*k1*(1-0.55*kf)*(0.8+seed*0.4);m.kneeR.rotation.x=0.08+1.0*k1*(1-0.6*kf)*(1.2-seed*0.4);}
  m.legL.rotation.x=-0.55*k1*(1-0.4*kf);m.legR.rotation.x=-0.35*k1*(1-0.5*kf)+0.25*kf*(seed-0.5);
  if(m.gun){m.gun.rotation.x=1.25*fe;m.gun.rotation.z=(seed-0.5)*0.9*fe;}
  if(m.up){m.pelvis.position.y=0.92;m.pelvis.rotation.set(0,0,0);m.up.rotation.x=(hs?-0.35:0.28)*k1*(1-kf)+0.12*fe;m.up.rotation.z=(seed-0.5)*0.3*fe;m.up.rotation.y=0;m.head.rotation.x=(hs?-0.7:0.2)*k1*(1-kf*0.5)+(seed-0.5)*0.5*fe;m.head.rotation.y=(seed-0.5)*0.9*fe;m.gun.position.z=0.22;m.legL.rotation.z=0;m.legR.rotation.z=0;soldierArms(m);}}
function markDeath(v,att,head){{const a=att&&att!==v&&att.pos?Math.atan2(v.pos.x-att.pos.x,v.pos.z-att.pos.z):null;v.slideV=a===null?null:new V3(Math.sin(a),0,Math.cos(a)).multiplyScalar(head?1.6:2.4);}v.deathAng=att&&att!==v&&att.pos?Math.atan2(v.pos.x-att.pos.x,v.pos.z-att.pos.z):undefined;v.deathHead=!!head;v.deathSeed=Math.random();v.killer=att&&att!==v?att:null;try{bloodPool(v);}catch(e){}}
/* player death cam: float out of the body, look at it, then turn toward the killer */
function deathCam(p,dt){const B=p.body;const t=p.deadT;
  if(B){B.g.visible=true;B.g.position.set(p.pos.x,p.pos.y,p.pos.z);deathPose(p,B,p.yaw+Math.PI,p.pos.y);}
  const d=p.deathAng!==undefined?new V3(Math.sin(p.deathAng),0,Math.cos(p.deathAng)):new V3(-Math.sin(p.yaw),0,-Math.cos(p.yaw)).negate();
  const body=new V3(p.pos.x,p.pos.y+0.45,p.pos.z);
  if(!p.dcFrom){p.dcFrom=camera.position.clone();p.dcQ=camera.quaternion.clone();}
  const want=body.clone().addScaledVector(d,3.0).add(new V3(0,2.1,0));const dir=want.clone().sub(body),L=dir.length();dir.normalize();
  raycaster.set(body,dir);raycaster.far=L;const h=raycaster.intersectObjects(worldMeshes,false)[0];raycaster.far=Infinity;if(h)want.copy(body).addScaledVector(dir,Math.max(0.6,h.distance-0.3));
  const k=Math.min(1,t/0.9),ke=k*k*(3-2*k);camera.position.lerpVectors(p.dcFrom,want,ke);
  let look=body.clone();const K=p.killer;if(K&&K.alive&&t>1.1){const kk=Math.min(1,(t-1.1)/0.7);const kp=new V3(K.pos.x,K.pos.y+1.4,K.pos.z);look.lerp(kp,kk*kk*(3-2*kk)*0.85);}
  const m4=new THREE.Matrix4().lookAt(camera.position,look,new V3(0,1,0));const q=new THREE.Quaternion().setFromRotationMatrix(m4);
  camera.quaternion.copy(p.dcQ).slerp(q,Math.min(1,ke*1.15));camera.rotation.setFromQuaternion(camera.quaternion,'YXZ');}

function syncBot(b){const g=b.model.g;g.position.copy(b.pos);const d=angDiff(b.yaw,g.rotation.y);if(Math.abs(d)>2.6||!b.alive)g.rotation.y=b.yaw;else{const dt=(b.model.an&&b.model.an.dt)||1/60;g.rotation.y+=d*(1-Math.exp(-dt*15));}}
function respawnBot(b){b.alive=true;b.hp=hpMax();b.armor=0;b.deadT=0;b.target=null;resetPose(b.model);b.model.g.visible=true;b.wpn=WEAPONS[randBotGun()];b.mag=b.wpn.mag;applyClass(b,false);placeEnt(b);b.tpos.copy(b.pos);syncBot(b);}
function placeEnt(e){
  let pt;
  if((S.mode==='tdm'||S.mode==='defuse')&&spawns[e.team]){const s=spawns[e.team];pt=openPoint(s.x,s.z,6,0,e.team);}
  else if(S.mode==='practice'){pt=spawns.A.clone();pt.x+=(e.isPlayer?0:rand(-8,8));}
  else if(S.duel){const opp=S.ents.find(o=>o!==e&&o.alive);const A=spawns.A,B=spawns.B;let s2=(e.isPlayer?A:B);if(opp){s2=Math.hypot(opp.pos.x-A.x,opp.pos.z-A.z)>Math.hypot(opp.pos.x-B.x,opp.pos.z-B.z)?A:B;}pt=openPoint(s2.x,s2.z,6,0,e.team);}
  else pt=openPoint(0,0,mapH-4,S.mode==='br'?25:18,e.team);
  e.pos.set(pt.x,0,pt.z);
  const dx=-pt.x,dz=-pt.z;
  if(e.isPlayer){e.yaw=S.mode==='practice'?0:Math.atan2(-dx,-dz);e.pitch=0;}else e.yaw=S.mode==='practice'?Math.PI:Math.atan2(dx,dz);
}
/* ================= BOMB DEFUSAL TACTICS =================
   T side : map control (A Lane / Mid / B Long), staging, utility execute (smoke CT, flash, molly), plant, post-plant angles.
   CT side: 2-1-2 / stack setups holding angles, info callouts + rotations, defensive utility, grouped retake with utility. */
const LANES={
  A:{long:{n:'A Main',pts:[[-24,40],[-40,22],[-32,2],[-31,-7]]},mid:{n:'A Connector',pts:[[0,20],[-9,-4],[-16,-7],[-22,-13]]}},
  B:{long:{n:'B Halls',pts:[[24,40],[39,22],[39,0],[37,-8]]},mid:{n:'B Garage',pts:[[0,20],[9,-4],[16,-7],[22,-13]]}}};
const CT_IN={A:[[-28,-33],[-38,-33]],B:[[28,-33],[38,-33]]};
const TSTRATS=['exec','exec','split','default','rush'];
function radio(team,who,msg){if(team&&player.team!==team)return;const el=$('radio');if(!el)return;const d=document.createElement('div');d.className='rl '+(team==='T'?'t':team==='CT'?'ct':'all');
  d.innerHTML=(who?`<b>${esc(who)}</b> `:'')+msg;el.appendChild(d);while(el.children.length>5)el.firstChild.remove();setTimeout(()=>{d.classList.add('out');setTimeout(()=>d.remove(),600);},5200);}
function dLive(team){return S.ents.filter(e=>e.alive&&e.team===team);}
function dBots(team){return S.bots.filter(b=>b.alive&&b.team===team&&!b.isNet&&!b.isProxy);}
const jit=(p,r)=>openPoint(p[0]!==undefined?p[0]:p.x,p[1]!==undefined?p[1]:p.z,r,0)||new V3(p[0]!==undefined?p[0]:p.x,0,p[1]!==undefined?p[1]:p.z);
function watchTo(b,x,z){b.watch=Math.atan2(x-b.pos.x,z-b.pos.z);}
/* throw any grenade so it lands near a point */
function botThrowAt(b,id,tx,tz,ty=0){if(!b||!b.alive)return;const from=new V3(b.pos.x,b.pos.y+1.6,b.pos.z);const dx=tx-from.x,dz=tz-from.z,d=Math.max(1,Math.hypot(dx,dz));
  const tf=0.75+d*0.045,g=15;const vh=Math.min(20,d/tf*0.9),vy=Math.min(14,((ty-from.y)+0.5*g*tf*tf)/tf);const vel=new V3(dx/d*vh,vy,dz/d*vh);
  b.yaw=Math.atan2(dx,dz);spawnNade(id,from,vel,b,false);if(NET.role==='host')netBroadcast({t:'nade',id,p:[from.x,from.y,from.z],v:[vel.x,vel.y,vel.z],by:b.id});sfx('throw',0.5,b.pos);}
const UTIL_NAME={smoke:'Smoke',flashbang:'Flash',molotov:'Molly',incendiary:'Incendiary',he:'HE'};
/* ---------- round plan ---------- */
function planRound(){const R=S.round;const D=R.dt={t:{},ct:{},intel:[],lastCall:{},rotT:0,util:new Set(),q:[]};
  // ---- T plan
  const strat=TSTRATS[Math.floor(Math.random()*TSTRATS.length)];D.t.strat=strat;D.t.site=R.siteTarget;D.t.exec=false;D.t.stageBy=ROUND.freeze+(strat==='rush'?0:strat==='default'?40:22);
  tAssign(strat==='default'?'probe':'go');
  // ---- CT plan
  const forms=[['2-1-2',['A','A','mid','B','B']],['2-1-2',['A','B','mid','A','B']],['3-1-1 stack A',['A','A','A','mid','B']],['1-1-3 stack B',['A','mid','B','B','B']],['2-2-1',['A','A','B','B','mid']]];
  const f=forms[Math.floor(Math.random()*forms.length)];D.ct.form=f[0];let i=0;
  for(const b of dBots('CT')){b.role=f[1][i++%5];ctHold(b,b.role);}
  D.ct.retake=null;
  const tl=dLive('T')[0],cl=dLive('CT')[0];
  dSched(0.4,()=>{
    if(player.team==='T'){const lead=dBots('T')[0];const m=strat==='rush'?`Rush ${R.siteTarget}! Everyone go, no stopping!`:strat==='default'?'Default — spread out, get map control and find info.':strat==='split'?`Split ${R.siteTarget} — 2 through mid, rest through ${R.siteTarget} Long.`:`Execute ${R.siteTarget} — group at ${R.siteTarget} Long, smoke CT, flash and go.`;radio('T',lead?lead.name:'',m);}
    else{const lead=dBots('CT')[0];radio('CT',lead?lead.name:'',`Setup ${D.ct.form}. Hold your angles, call everything.`);}});}
/* give every T bot a lane for the current plan */
function tAssign(kind){const R=S.round,D=R.dt;const site=D.t.site;const bots=dBots('T');let i=0;
  for(const b of bots){let lane;
    if(kind==='probe'){lane=[LANES.A.long,LANES.A.mid,LANES.B.long,LANES.B.mid,LANES.A.long][i%5];}
    else if(D.t.strat==='split'){lane=i%5<2?LANES[site].mid:LANES[site].long;}
    else lane=(b.hasBomb||i%5<3)?LANES[site].long:LANES[site].mid;
    b.dt={mode:'route',pts:lane.pts.map(p=>p.slice()),i:0,lane:lane.n,end:kind==='probe'?'probe':'stage'};b.wp=null;b.holdT=0;b.watch=undefined;b.holdCrouch=false;i++;}}
/* CT: pick a hold spot near a site (or mid) and the angle to watch */
function ctHold(b,role){let hx,hz,wx,wz;
  if(role==='mid'){hx=rand(-4,4);hz=rand(-12,-6);wx=0;wz=20;}
  else{const s=SITES[role],L=LANES[role];const e=Math.random()<0.5?L.long.pts[2]:L.mid.pts[2];hx=s.x+(s.x-e[0])*0.25+rand(-3,3);hz=s.z-5+rand(-2,2);wx=e[0];wz=e[1];}
  const p=openPoint(hx,hz,3,0)||new V3(hx,0,hz);b.dt={mode:'hold',goal:p,w:[wx,wz]};b.wp=null;b.holdT=0;b.holdCrouch=Math.random()<0.5;}
/* ---------- waypoint + arrival hooks used by the generic bot brain ---------- */
function dtWaypoint(b){const st=b.dt;if(!st)return null;
  if(st.mode==='route'){if(b.stuckT>1.2)st.i++;if(st.i<st.pts.length)return jit(st.pts[st.i],2.2);return st.goal||jit(st.pts[st.pts.length-1],2);}
  if(st.mode==='goto'||st.mode==='hold'||st.mode==='post'||st.mode==='gather'){
    if(b.stuckT>1.2){st.stuck=(st.stuck||0)+1;const g=st.goal;const mx=(b.pos.x+g.x)/2,mz=(b.pos.z+g.z)/2;const sd=Math.hypot(g.x-b.pos.x,g.z-b.pos.z);
      if(st.stuck>5&&st.mode!=='goto'){st.goal=openPoint(b.pos.x,b.pos.z,4,0)||st.goal;st.stuck=0;return st.goal;}
      const side=(st.stuck%2?1:-1)*Math.min(8,3+st.stuck*1.5);const nx=-(g.z-b.pos.z)/(sd||1),nz=(g.x-b.pos.x)/(sd||1);return openPoint(mx+nx*side,mz+nz*side,2.5,0)||st.goal;}
    return st.goal;}
  return null;}
function dtArrive(b){const st=b.dt;if(!st)return false;const R=S.round;
  if(st.mode==='route'){st.i++;if(st.i<st.pts.length){b.wp=null;return true;}
    if(st.end==='stage'||st.end==='probe'){st.mode='staged';const s=SITES[S.round.dt.t.site];watchTo(b,s.x,s.z);b.holdT=999;b.holdCrouch=Math.random()<0.6;return true;}}
  if(st.mode==='goto'){if(st.then==='plant'){if(b.hasBomb&&R.phase==='live'&&siteAt(b.pos)){b.planting=0.001;return true;}const s2=SITES[R.siteTarget];st.goal=openPoint(s2.x,s2.z,2.5,0)||st.goal;b.wp=null;return true;}
    if(st.then==='clear'){b.holdT=rand(1.5,3);const s=SITES[S.round.dt.t.site];watchTo(b,s.x,s.z-10);return true;}}
  if(st.mode==='hold'||st.mode==='post'||st.mode==='gather'){if(st.w)watchTo(b,st.w[0],st.w[1]);b.holdT=st.mode==='gather'?2:999;return true;}
  return false;}
/* ---------- per-frame coordinator ---------- */
function dSched(dly,fn){const D=S.round&&S.round.dt;if(D)D.q.push([S.time+dly,fn]);}
function dtUpdate(dt){const R=S.round;if(!R||!R.dt||NET.role==='client')return;const D=R.dt,bomb=R.bomb;const el=ROUND.freeze+ROUND.live-R.t;
  if(D.q.length){const due=D.q.filter(q=>q[0]<=S.time);D.q=D.q.filter(q=>q[0]>S.time);for(const q of due){try{q[1]();}catch(e){console.warn('dtac',e);}}}
  if(R.phase==='freeze')return;
  // ----- intel: CTs (and Ts) who see an enemy call it out
  for(const b of S.bots){if(!b.alive||!b.target||b.isNet||b.isProxy)continue;const t=b.target;const site=siteNear(t.pos);const k=b.team+site;
    if(!D.lastCall[k]||S.time-D.lastCall[k]>6){D.lastCall[k]=S.time;const n=S.ents.filter(e=>e.alive&&e.team===t.team&&Math.hypot(e.pos.x-t.pos.x,e.pos.z-t.pos.z)<10).length;
      radio(b.team,b.name,`${n>1?n+' enemies':'Enemy'} spotted ${site}!`);if(b.team==='CT')D.intel.push({site:site[0]==='A'?'A':site[0]==='B'?'B':'mid',n,t:S.time});}}
  if(R.phase==='live'){tUpdate(D,el);ctUpdate(D);}
  else if(R.phase==='planted'){postPlant(D);retake(D,R);}}
function siteNear(p){let best='Mid',bd=1e9;const A=SITES.A,B=SITES.B;for(const[k,L]of[['A',LANES.A],['B',LANES.B]]){for(const lane of[L.long,L.mid])for(const q of lane.pts){const d=Math.hypot(p.x-q[0],p.z-q[1]);if(d<bd){bd=d;best=lane.n;}}const s=SITES[k];const d=Math.hypot(p.x-s.x,p.z-s.z);if(d<s.r+4&&d<bd+6){bd=d;best=k+' Site';}}
  if(bd>16&&Math.abs(p.x)<12)best='Mid';return best;}
/* ----- T side ----- */
function tUpdate(D,el){const R=S.round,T=D.t;const bots=dBots('T');if(!bots.length)return;
  // player carrying the bomb decides the site
  if(player.team==='T'&&player.alive&&player.hasBomb&&!T.exec){for(const k of['A','B']){const s=SITES[k];if(k!==T.site&&Math.hypot(player.pos.x-s.x,player.pos.z-s.z)<20){T.site=k;R.siteTarget=k;tAssign('go');radio('T',bots[0].name,`Following the bomb — going ${k}!`);}}}
  // default: after probing, pick the site with the least CT presence
  if(T.strat==='default'&&!T.regroup&&(el>T.stageBy||D.intel.some(i=>S.time-i.t<3&&i.n>=2))){T.regroup=true;
    const seen={A:0,B:0};for(const i of D.intel)if(seen[i.site]!==undefined)seen[i.site]+=i.n;T.site=seen.A<=seen.B?'A':'B';R.siteTarget=T.site;T.strat='exec';T.stageBy=el+14;tAssign('go');
    radio('T',bots[0].name,`Info says ${T.site} is light — regroup ${T.site} Long and execute!`);}
  if(T.exec)return;
  const staged=bots.filter(b=>b.dt&&b.dt.mode==='staged').length;const need=Math.max(1,Math.ceil(bots.length*0.7));
  if(T.strat==='default'&&!T.regroup)return;
  if(staged>=need||el>T.stageBy||T.strat==='rush'){T.exec=true;execSite(D);}}
function execSite(D){const R=S.round,site=D.t.site,s=SITES[site];const bots=dBots('T');const rush=D.t.strat==='rush';
  // utility: smoke the CT side of the site, molly a default corner, flash over the site
  const ctSide=[s.x+(site==='A'?6:-6),s.z-9],corner=[s.x+(site==='A'?-4:4),s.z-4];let used=0;
  if(!rush){const thr=bots.filter(b=>b.dt&&b.dt.mode==='staged');const plan=[['smoke',ctSide],['smoke',[s.x,s.z-14]],['molotov',corner],['flashbang',[s.x,s.z]]];
    thr.forEach((b,i)=>{const u=plan[i];if(!u)return;dSched(i*0.45,()=>{if(b.alive&&S.round&&S.round.phase==='live'){botThrowAt(b,u[0],u[1][0],u[1][1],u[0]==='flashbang'?3:0);if(i===0||u[0]==='flashbang')radio('T',b.name,`${UTIL_NAME[u[0]]} out${u[0]==='flashbang'?' — go go go!':'!'}`);}});used++;});}
  const go=()=>{for(const b of dBots('T')){const carrier=b.hasBomb;const goal=carrier?new V3(s.x+rand(-1.2,1.2),0,s.z+rand(-1.2,1.2)):(openPoint(s.x,s.z,s.r+2,0)||new V3(s.x,0,s.z));
      b.dt={mode:'goto',goal,then:carrier?'plant':'clear'};b.holdT=0;b.waitT=0;b.wp=null;b.holdCrouch=false;}
    // a dropped bomb still gets fetched by the existing logic
  };
  if(rush){go();radio('T',bots[0]&&bots[0].name,`RUSH ${site}!`);}else dSched(used?1.6:0.2,()=>{if(S.round.phase==='live')go();});}
/* ----- CT side ----- */
function ctUpdate(D){const bots=dBots('CT');if(!bots.length)return;
  // rotate toward a site under pressure (2+ enemies seen recently)
  const hot=D.intel.filter(i=>S.time-i.t<6&&i.site!=='mid');const press={A:0,B:0};for(const i of hot)press[i.site]+=i.n;
  for(const site of['A','B']){if(press[site]>=2&&S.time>D.rotT){D.rotT=S.time+12;const other=site==='A'?'B':'A';
      const rot=bots.find(b=>b.role==='mid')||bots.find(b=>b.role===other);if(rot){rot.role=site;ctHold(rot,site);radio('CT',rot.name,`Rotating ${site}!`);}
      // defensive utility on the choke
      const h=bots.find(b=>b.role===site&&!D.util.has(b.id));if(h){D.util.add(h.id);const L=LANES[site];const e=hot.find(i=>i.site===site);const c=L.long.pts[2];botThrowAt(h,Math.random()<0.5?'incendiary':'he',c[0],c[1]);radio('CT',h.name,`Molly ${L.long.n}, stall them!`);}}}}
/* ----- post-plant: Ts take hidden angles around the bomb ----- */
function postPlant(D){const R=S.round,bomb=R.bomb;if(D.post)return;D.post=true;const site=bomb.site&&SITES[bomb.site]?bomb.site:D.t.site;const L=LANES[site]||LANES.A;
  const spots=[L.long.pts[2],L.mid.pts[2],L.long.pts[1],[bomb.pos.x+(site==='A'?-9:9),bomb.pos.z+2],[bomb.pos.x,bomb.pos.z+10]];
  dBots('T').forEach((b,i)=>{const sp=spots[i%spots.length];const g=openPoint(sp[0],sp[1],3,0)||new V3(sp[0],0,sp[1]);b.dt={mode:'post',goal:g,w:[bomb.pos.x,bomb.pos.z]};b.wp=null;b.holdT=0;b.holdCrouch=Math.random()<0.7;});
  const lead=dBots('T')[0];if(lead)radio('T',lead.name,`Bomb down ${site}! Play post-plant — hold your angles, don't peek.`);}
/* ----- retake: group up, utility, push together, defuse ----- */
function retake(D,R){const bomb=R.bomb,bots=dBots('CT');if(!bots.length)return;const site=bomb.site&&SITES[bomb.site]?bomb.site:'A';const C=D.ct;const dTime=b=>b.kit?ROUND.kit:ROUND.defuse;
  if(!C.retake){C.retake={phase:'gather',t0:S.time};const ins=CT_IN[site];bots.forEach((b,i)=>{const p=ins[i%2];const g=openPoint(p[0],p[1],3,0)||new V3(p[0],0,p[1]);b.dt={mode:'gather',goal:g,w:[bomb.pos.x,bomb.pos.z]};b.wp=null;b.holdT=0;b.defusing=0;b.holdCrouch=false;});
    radio('CT',bots[0].name,`Bomb's on ${site}. Group up for the retake!`);return;}
  const T=C.retake,late=R.t<Math.min(...bots.map(dTime))+4;
  if(T.phase==='gather'){const ready=bots.filter(b=>b.dt&&b.dt.mode==='gather'&&b.pos.distanceTo(b.dt.goal)<4).length;
    if(ready>=Math.ceil(bots.length*0.6)||S.time-T.t0>9||late){T.phase='util';T.t1=S.time;const post=[LANES[site].long.pts[2],LANES[site].mid.pts[2]];
      bots.slice(0,3).forEach((b,i)=>{const u=[['smoke',post[0]],['flashbang',[bomb.pos.x,bomb.pos.z]],['smoke',post[1]]][i];dSched(i*0.4,()=>{if(b.alive&&S.round.phase==='planted')botThrowAt(b,u[0],u[1][0],u[1][1],u[0]==='flashbang'?3:0);});});
      radio('CT',bots[0].name,late?'No time — everyone on the bomb NOW!':'Smokes out, flash — retake together!');}}
  else if(T.phase==='util'&&(S.time-T.t1>1.4||late)){T.phase='push';
    bots.forEach((b,i)=>{const g=i===0?new V3(bomb.pos.x+rand(-0.3,0.3),0,bomb.pos.z+rand(-0.3,0.3)):(openPoint(bomb.pos.x,bomb.pos.z,6,0)||new V3(bomb.pos.x,0,bomb.pos.z));b.dt={mode:'goto',goal:g,then:i===0?'defuse':'clear'};b.wp=null;b.holdT=0;});}
  else if(T.phase==='push'){const tAlive=dLive('T').filter(e=>Math.hypot(e.pos.x-bomb.pos.x,e.pos.z-bomb.pos.z)<18).length;
    for(const b of bots){if(b.defusing>0)continue;if((tAlive===0||late)&&b.dt&&b.dt.then!=='defuse'&&!bots.some(o=>o.defusing>0||(o.dt&&o.dt.then==='defuse'&&o.alive))){b.dt={mode:'goto',goal:new V3(bomb.pos.x,0,bomb.pos.z),then:'defuse'};b.wp=null;b.holdT=0;}}}}

function findTarget(b){
  const range=S.mut==='fog'?34:S.mode==='br'?(S.zone&&S.zone.phase<2?42:60):65;const cands=[];
  for(const e of S.ents){
    if(e===b||!e.alive||e.team===b.team||e.drop)continue;
    const dx=e.pos.x-b.pos.x,dz=e.pos.z-b.pos.z,d=Math.hypot(dx,dz);if(d>range)continue;
    if(d>12&&e!==b.target&&Math.abs(angDiff(Math.atan2(dx,dz),b.yaw))>1.05)continue;
    cands.push([d,e]);
  }
  cands.sort((a,c)=>a[0]-c[0]);
  for(let i=0;i<Math.min(3,cands.length);i++)if(los(b,cands[i][1]))return cands[i][1];
  return null;
}
/* ===== bot navigation graph for the classic three-lane map (A*), so bots path around buildings instead of hugging walls ===== */
let NAV=null;
const NAV_CL={n:{T0:[0,42],TW:[-16,40],TW2:[-28,40],W1:[-40,40],W2:[-40,31],W2b:[-40,21],W3:[-40,12],W4:[-40,3],AM:[-32,2],A1:[-32,-7],A:[-31,-15],A2:[-40,-21],A3:[-22,-14],ACi:[-28,-24],AC:[-28,-33],
  MA:[-25,12],M1:[0,30],M2:[0,19],M3:[0,12],P1:[-9,10],P2:[9,10],P3:[-9,-6],P4:[9,-6],Acon:[-16,-7],Bcon:[16,-7],Ain:[-20,-7],Bin:[20,-7],C0:[0,-8],C1:[0,-15],C2:[0,-25],CS:[0,-33],CT0:[0,-42],CTW:[-14,-33],CTE:[14,-33],
  TE:[16,40],TE2:[28,40],E1:[39,40],E2:[39,31],E3:[39,18],E4:[39,4],B1:[37,-8],B:[31,-15],B2:[40,-18],B3:[22,-14],BCi:[28,-24],BC:[28,-33]},
 e:'T0-TW TW-TW2 TW2-W1 W1-W2 W2-W2b W2b-W3 W3-W4 W4-AM AM-A1 A1-A A-A2 A-A3 A1-A2 A-ACi A2-ACi ACi-AC AC-CTW CTW-CS CTW-CT0 CS-CT0 CS-C2 C2-C1 C1-C0 C0-P3 C0-P4 P3-P1 P4-P2 P1-M3 P2-M3 M3-M2 M2-M1 M1-T0 P1-P2 P3-P4 P3-Acon Acon-Ain Ain-A3 Ain-A1 W3-MA MA-P1 T0-TE TE-TE2 TE2-E1 E1-E2 E2-E3 E3-E4 E4-B1 B1-B B-B2 B1-B2 B-B3 B3-Bin Bin-Bcon Bin-B1 Bcon-P4 B-BCi B2-BCi BCi-BC BC-CTE CTE-CS CTE-CT0'};
function navKeep(){const out=[];for(const pr of NAV_CL.e.split(' ')){const[a,b]=pr.split('-'),A=NAV_CL.n[a],B=NAV_CL.n[b];const L=Math.hypot(B[0]-A[0],B[1]-A[1]),n=Math.ceil(L/3);for(let i=0;i<=n;i++)out.push([A[0]+(B[0]-A[0])*i/n,A[1]+(B[1]-A[1])*i/n,1.4]);}return out;}
function navSegClear(a,b,r=0.32){const dx=b.x-a.x,dz=b.z-a.z,L=Math.hypot(dx,dz);const n=Math.max(1,Math.ceil(L/0.6));
  for(let i=1;i<n;i++){const x=a.x+dx*i/n,z=a.z+dz*i/n;for(const c of nearCol(x,z,r+0.1)){if(c.maxY<0.5||c.minY>1.5)continue;if(x>c.minX-r&&x<c.maxX+r&&z>c.minZ-r&&z<c.maxZ+r)return false;}}return true;}
function navBuild(def){const ids=Object.keys(def.n),nodes={};for(const id of ids){const[x,z]=def.n[id];let p=new V3(x,0,z);if(colliders.some(c=>c.maxY>=0.5&&c.minY<1.5&&x>c.minX-0.35&&x<c.maxX+0.35&&z>c.minZ-0.35&&z<c.maxZ+0.35)){const q=openPoint(x,z,3,0);if(q)p=q;}p.id=id;p.adj=[];nodes[id]=p;}
  for(const pr of def.e.split(' ')){const[a,b]=pr.split('-');if(nodes[a]&&nodes[b]){nodes[a].adj.push(nodes[b]);nodes[b].adj.push(nodes[a]);}}NAV={nodes:Object.values(nodes),byId:nodes};}
function navNearest(p){let best=null,bd=1e9;for(const n of NAV.nodes){const d=Math.hypot(n.x-p.x,n.z-p.z);if(d<bd&&(d<30)&&navSegClear(p,n)){bd=d;best=n;}}
  if(!best){for(const n of NAV.nodes){const d=Math.hypot(n.x-p.x,n.z-p.z);if(d<bd){bd=d;best=n;}}}return best;}
function navPath(from,goal){if(!NAV)return null;const s=navNearest(from),t=navNearest(goal);if(!s||!t)return null;if(s===t)return[s];
  const g=new Map([[s,0]]),prev=new Map(),open=[s],h=n=>Math.hypot(n.x-t.x,n.z-t.z);
  while(open.length){open.sort((a,b)=>(g.get(a)+h(a))-(g.get(b)+h(b)));const c=open.shift();if(c===t)break;
    for(const nb of c.adj){const ng=g.get(c)+Math.hypot(nb.x-c.x,nb.z-c.z);if(!g.has(nb)||ng<g.get(nb)){g.set(nb,ng);prev.set(nb,c);if(!open.includes(nb))open.push(nb);}}}
  if(!prev.has(t))return null;const path=[t];let c=t;while(prev.has(c)){c=prev.get(c);path.unshift(c);}return path;}
function navRoute(b,g,cont){if(!NAV||!g){b.navP=null;return g;}
  if(navSegClear(b.pos,g)){b.navP=null;return g;}
  if(!cont||!b.navP||b.navG!==g){b.navG=g;b.navP=navPath(b.pos,g);}
  const P=b.navP;if(!P||!P.length){b.navP=null;return g;}
  while(P.length&&Math.hypot(P[0].x-b.pos.x,P[0].z-b.pos.z)<1.6)P.shift();
  while(P.length>1&&navSegClear(b.pos,P[1]))P.shift();
  if(P.length===1&&navSegClear(b.pos,g)){P.shift();}
  if(!P.length)return g;const w=new V3(P[0].x+rand(-0.8,0.8),0,P[0].z+rand(-0.8,0.8));w._nav=true;return w;}
function siteAt(p){for(const k in SITES){const s=SITES[k];if(Math.hypot(p.x-s.x,p.z-s.z)<s.r)return k;}return null;}
function pickWaypoint(b){
  if(S.mode==='defuse'){const R=S.round,bomb=R.bomb;
    if(b.team==='T'&&bomb.state==='dropped'&&bomb.fetcher===b)return bomb.pos.clone();
    {const dw=dtWaypoint(b);if(dw)return dw;}
    if(b.team==='T'){
      if(bomb.state==='dropped'&&bomb.fetcher===b)return bomb.pos.clone();
      if(bomb.state==='planted')return openPoint(bomb.pos.x,bomb.pos.z,9,0);
      const s=SITES[R.siteTarget];if(b.hasBomb)return new V3(s.x+rand(-1.5,1.5),0,s.z+rand(-1.5,1.5));return openPoint(s.x,s.z,8,0);
    }else{
      if(bomb.state==='planted')return new V3(bomb.pos.x+rand(-0.3,0.3),0,bomb.pos.z+rand(-0.3,0.3));
      if(b.role==='roam')return openPoint(0,-5,20,0);
      const s=SITES[b.role||'A'];return openPoint(s.x,s.z,8,0);
    }}
  if(S.mode==='br'&&S.zone){const z=S.zone;return openPoint(z.tx,z.tz,Math.max(4,Math.min(z.r,z.tr)*0.8),0);}
  if(S.mode==='tdm'&&Math.random()<0.4){const s=b.team==='A'?spawns.B:spawns.A;return openPoint(s.x*0.6,s.z*0.6,14,0);}
  return openPoint(0,0,mapH*0.85,0);
}
function onArrive(b){
  if(S.mode!=='defuse')return;
  const R=S.round,bomb=R.bomb;if(dtArrive(b))return;
  if(b.team==='T'){
    if(b.hasBomb&&R.phase==='live'&&siteAt(b.pos)){b.planting=0.001;return;}
    if(bomb.state==='planted'){b.holdT=rand(3,7);return;}
    if(siteAt(b.pos))b.holdT=rand(1,3);
  }else{
    if(R.phase==='planted'&&bomb.state==='planted'&&Math.hypot(b.pos.x-bomb.pos.x,b.pos.z-bomb.pos.z)<1.7){if(!S.ents.some(e=>e!==b&&e.defusing>0))b.defusing=0.001;else b.holdT=2;return;}
    b.holdT=rand(3,7);
  }
}
function botDamage(w,dist,head){if(w.pellets)return w.dmg*w.pellets*0.55*rangeMul(w,dist);return w.dmg*rangeMul(w,dist)*(head?w.head:1);}
function angN(a){a=(a+Math.PI)%(Math.PI*2);if(a<0)a+=Math.PI*2;return a-Math.PI;}
function gauss(){let u=0,v=0;while(u===0)u=Math.random();v=Math.random();return clamp(Math.sqrt(-2*Math.log(u))*Math.cos(6.2832*v),-2.6,2.6);}
/* human-like bot shooting: a real shot ray with aim error that settles over time, weapon spread, moving penalty and
   recoil climb, tested against the target's head sphere and body. Bots mostly aim centre mass, so headshots need good aim. */
function botShoot(b,t,dist){
  const w=b.wpn;
  if(b.mag<=0){b.mag=w.mag;b.cool=w.shell?w.shell*w.mag*0.6:w.reload*1.2;return;}
  const from=new V3(b.pos.x,b.pos.y+1.55,b.pos.z);
  const ex=exposure(from,t);if(ex===0){b.cool=0.2;return;}
  b.mag--;b.burst++;
  if(b.burst>=(w.auto?3+Math.floor(Math.random()*3)+(b.cls==='heavy'?4:0):2)){b.burst=0;b.cool=Math.max(w.rate,0.3+Math.random()*0.4);}else b.cool=w.rate*(w.auto?1.15:2.2);
  if(w.zoom)b.cool=Math.max(b.cool,1.1+Math.random()*0.6);
  b.lastShot=S.time;soldierRecoil(b.model);
  if(!w.pellets&&w.cat!=='smg'&&b.cls!=='rusher')b.stopT=0.32;
  const D=DIFFC();if(b.hb===undefined)b.hb=0.7+Math.random()*0.6;
  const eye=eyeOf(t).clone(),foot=t.pos.y,headC=new V3(eye.x,eye.y-0.03,eye.z),chestY=foot+(headC.y-foot)*0.7;
  const hb=clamp(D.headBias*b.hb,0,0.95);const aim=new V3(eye.x,chestY+(headC.y-chestY)*hb,eye.z);
  const dir=aim.clone().sub(from);const L=dir.length()||1;dir.divideScalar(L);
  const right=new V3(dir.z,0,-dir.x).normalize(),up=new V3().crossVectors(right,dir).normalize();
  const cat=w.cat,spread=({pistol:0.008,smg:0.012,rifle:0.006,mg:0.013,dmr:0.004,sniper:0.003}[cat])||0.008;
  const mov=b.moving?(({smg:1.5,pistol:2.2,shotgun:1.2}[cat])||3.4):1;const rec=w.auto?Math.min(6,Math.max(0,b.burst-1)):0;
  const err=b.aimErr===undefined?D.err0:b.aimErr;
  const n=w.pellets||1;let dmg=0,head=false,hit=false,imp=null;const hsRoll=Math.random()<(D.hs||0);
  for(let k=0;k<n;k++){
    let ax=err*gauss()*0.7+spread*mov*gauss(),ay=err*gauss()*0.7+spread*mov*gauss()+rec*0.0065*(0.6+Math.random()*0.8);
    if(w.pellets){const a=Math.random()*6.283,r=Math.sqrt(Math.random())*(w.pelletSpread||0.06);ax+=Math.cos(a)*r;ay+=Math.sin(a)*r;}
    if(w.zoom&&b.moving){ax+=gauss()*0.05;ay+=gauss()*0.05;}
    const ox=Math.tan(ax)*L,oy=Math.tan(ay)*L;const p=aim.clone().addScaledVector(right,ox).addScaledVector(up,oy);
    const inHead=Math.hypot(ox,p.y-headC.y)<0.15;
    let isBody=!inHead&&Math.abs(ox)<0.25&&p.y<headC.y-0.15&&p.y>foot+0.08;
    if(isBody&&ex<1&&p.y<foot+1.05)isBody=false;/* legs and hips behind cover */
    if(inHead||isBody){hit=true;const isHead=hsRoll;head=head||isHead;dmg+=w.pellets?w.dmg*rangeMul(w,dist):botDamage(w,dist,isHead);if(!imp||isHead)imp=isHead?headC.clone():p;}else if(!imp&&k===n-1)imp=p.addScaledVector(dir,6);}
  const start=new V3();b.model.gun.getWorldPosition(start);
  tracer(start,imp,TRACER2);
  gunSound(w.id,b.pos);if(!hit&&t===player&&dist>3&&Math.random()<0.6)mech('whiz',null,0.8);
  if(NET.role==='host')netShotFx(start,imp,w.id,b.id);
  b._last={hit,head};
  if(hit){if(t!==player)bloodHit(imp,imp.clone().sub(start),head);damage(t,dmg*D.dmg,b,w.id,head&&!w.pellets);}
}
const _nvT=new V3();
function nvUpdate(e,x,z,moving){const t=S.time;if(moving&&e.nT!==undefined){const iv=t-e.nT;if(iv>0.02&&iv<0.4){e.nvx=(x-e.tpos.x)/iv;e.nvz=(z-e.tpos.z)/iv;const sp=Math.hypot(e.nvx,e.nvz);if(sp>12){e.nvx*=12/sp;e.nvz*=12/sp;}}}else{e.nvx=0;e.nvz=0;}e.nT=t;}
function netEntUpdate(b,dt){
  const m=b.model;
  if(!b.alive){b.deadT+=dt;deathPose(b,m,b.yaw,b.pos.y);
    if(NET.role==='host'&&S.respawns&&b.deadT>3.5)respawnNet(b);return;}
  const nox=b.pos.x,noz=b.pos.z;{const ex=b.moving&&b.nT!==undefined?Math.min(0.08,Math.max(0,S.time-b.nT)):0;if(ex>0&&b.nvx!==undefined){_nvT.set(b.tpos.x+b.nvx*ex,b.tpos.y,b.tpos.z+b.nvz*ex);b.pos.lerp(_nvT,Math.min(1,dt*14));}else b.pos.lerp(b.tpos,Math.min(1,dt*14));}b.yaw=lerpAng(b.yaw,b.tyaw,Math.min(1,dt*14));
  botStepSounds(b,dt);b.walkT+=dt*(b.moving?11:0);{const iv=1/Math.max(dt,1e-4);let vx=(b.pos.x-nox)*iv,vz=(b.pos.z-noz)*iv;if(!b.moving){vx=0;vz=0;}animSoldier(m,{vx,vz,crouch:b.crouch,pitch:b.pitch||0,dt});}
  m.g.position.copy(b.pos);m.g.rotation.y=b.yaw;
}
function updateBot(b,dt){
  if(b.isNet||b.isProxy){netEntUpdate(b,dt);return;}
  if(b.drop){if(b.alive)updateDropBot(b,dt);return;}
  const m=b.model;
  if(!b.alive){b.deadT+=dt;if(b.slideV){b.pos.addScaledVector(b.slideV,dt);b.slideV.multiplyScalar(Math.exp(-5*dt));collide(b.pos,0.3,b.pos.y+0.05,0.5);if(b.slideV.lengthSq()<0.001)b.slideV=null;}m.g.position.x=b.pos.x;m.g.position.z=b.pos.z;deathPose(b,m,b.yaw,b.pos.y);if(!S.respawns&&b.deadT>5)m.g.position.y=b.pos.y-Math.min(0.5,(b.deadT-5)*0.12);
    if(S.respawns&&b.deadT>3.5)respawnBot(b);else if(!S.respawns&&S.mode!=='defuse'&&b.deadT>8)m.g.visible=false;return;}
  const R=S.mode==='defuse'?S.round:null;
  if(R&&R.phase==='freeze'){animSoldier(m,{spd:0,dt});syncBot(b);return;}
  if(S.mode==='practice'){syncBot(b);return;}
  b.think-=dt;
  if(b.blindT>0){b.blindT-=dt;b.target=null;b.yaw+=Math.sin(S.time*2.3+b.pos.z)*dt*1.6;legPose(m,0);syncBot(b);return;}
  if(b.think<=0){b.think=0.2+Math.random()*0.15;const t=findTarget(b);if(t!==b.target){b.target=t;if(t){const D0=DIFFC();if(b.skill===undefined)b.skill=0.8+Math.random()*0.45;b.react=D0.react*(0.7+Math.random()*0.6)*(b.reactK||1)+(b.wpn&&b.wpn.zoom?0.35:0);const da=Math.abs(angN(Math.atan2(t.pos.x-b.pos.x,t.pos.z-b.pos.z)-b.yaw));b.aimErr=D0.err0*b.skill*(0.8+Math.random()*0.5)+(da>1?0.07:0);b.burst=0;}}b.hasLOS=!!t;}
  const t=b.target;
  if(b.planting>0){if(t||!b.hasBomb){b.planting=0;}else{b.planting+=dt;if(b.planting>=ROUND.plant)plantBomb(b);animSoldier(m,{spd:0,crouch:1,pitch:-0.5,dt});syncBot(b);return;}}
  if(b.defusing>0){if(!R||R.phase!=='planted'){b.defusing=0;}else if(t&&R.t>12){b.defusing=0;}else{b.defusing+=dt;if(b.defusing>=(b.kit?ROUND.kit:ROUND.defuse))defuseBomb(b);animSoldier(m,{spd:0,crouch:1,pitch:-0.5,dt});syncBot(b);return;}}
  let mx=0,mz=0,speed=3.4;
  if(t&&t.alive){
    const dx=t.pos.x-b.pos.x,dz=t.pos.z-b.pos.z,dist=Math.hypot(dx,dz)||1;
    {const D1=DIFFC();if(b.skill===undefined)b.skill=0.8+Math.random()*0.45;const dyaw=angN(Math.atan2(dx,dz)-b.yaw),mt=D1.turn*dt/Math.max(0.7,b.reactK||1);b.yaw+=clamp(dyaw*Math.min(1,dt*9),-mt,mt);b.facing=Math.abs(dyaw);
      let lat=0;if(t.vel)lat=Math.abs(t.vel.x*dz-t.vel.z*dx)/dist;else if(t.moving)lat=2.5;
      const own=b.moving?(b.wpn&&b.wpn.cat==='smg'?1.3:1.7):1;const fl=D1.floor*b.skill*(1+lat*0.3)*own*((t.crouch||0)>0.5?1.1:1)*(dist>30?1+(dist-30)*0.01:1);
      const e0=b.aimErr===undefined?D1.err0:b.aimErr;b.aimErr=e0+(fl-e0)*Math.min(1,dt*D1.settle);}
    b.strafeT-=dt;if(b.strafeT<=0){b.strafe=Math.random()<.5?-1:1;b.strafeT=0.6+Math.random()*1.4;const want=b.cls?BOT_CLASS[b.cls].want:b.wpn.pellets?6:b.wpn.zoom?28:14;b.advance=dist>want+6?1:dist<want-7?-1:(Math.random()<.4?0.5:0);}
    const fx=dx/dist,fz=dz/dist;mx=fx*b.advance-fz*b.strafe;mz=fz*b.advance+fx*b.strafe;speed=2.6;
    if(b.cls==='rusher'&&dist>4&&!b.coverPt)b.advance=1;
    if(b.cls==='tactical'){if(NET.role!=='client'&&S.time>(b.nadeT||0)&&b.hasLOS&&dist>8&&dist<32)botThrow(b,t);
      if(b.hp<60*hpK()&&!b.coverPt&&!(b.coverCd>S.time)){b.coverPt=coverSpot(b,t);b.coverCd=S.time+9;b.coverT=0;}
      if(b.coverPt){b.coverT+=dt;const cx=b.coverPt.x-b.pos.x,cz=b.coverPt.z-b.pos.z,cd=Math.hypot(cx,cz);if(cd>0.7){mx=cx/cd;mz=cz/cd;speed=4.3;}else{mx=0;mz=0;}if(b.coverT>4.5)b.coverPt=null;}}
    b.react-=dt;b.cool-=dt;
    if(b.react<=0&&b.cool<=0&&b.hasLOS&&(b.facing===undefined||b.facing<0.2))botShoot(b,t,dist);
    b.holdT=0;
  }else{
    b.target=null;b.cool-=dt;
    if(b.waitT>0)b.waitT-=dt;
    else if(b.holdT>0){b.holdT-=dt;if(b.watch!==undefined)b.yaw=lerpAng(b.yaw,b.watch+Math.sin(S.time*0.55+b.pos.x)*0.4,Math.min(1,dt*4));else b.yaw+=Math.sin(S.time*0.7+b.pos.x)*dt*0.8;}
    else{
      if(!b.wp||b.stuckT>1.2){if(b.stuckT>1.2)b.navP=null;const g=pickWaypoint(b);b.wp=navRoute(b,g,false);b.stuckT=0;}
      const dx=b.wp.x-b.pos.x,dz=b.wp.z-b.pos.z,d=Math.hypot(dx,dz)||1;
      if(d<1.2){if(b.wp._nav&&b.navG){b.wp=navRoute(b,b.navG,true);}else{b.wp=null;onArrive(b);}}
      else{mx=dx/d;mz=dz/d;b.yaw=lerpAng(b.yaw,Math.atan2(dx,dz),Math.min(1,dt*5));}
    }
  }
  if(S.mode==='br'&&S.zone){const z=S.zone,dx=z.x-b.pos.x,dz=z.z-b.pos.z,d=Math.hypot(dx,dz);if(d>z.r*0.95){mx=dx/d;mz=dz/d;speed=4;b.wp=null;}}
  if(S.fires&&S.fires.length)for(const f of S.fires){const dx=b.pos.x-f.pos.x,dz=b.pos.z-f.pos.z,d=Math.hypot(dx,dz);if(d<f.r+0.7&&Math.abs(b.pos.y-f.pos.y)<1.3){mx=dx/(d||1);mz=dz/(d||1);speed=4.4;b.wp=null;break;}}
  if(b.stopT>0){b.stopT-=dt;speed*=0.15;}
  const ml=Math.hypot(mx,mz);if(ml>0){mx/=ml;mz/=ml;}
  const ox=b.pos.x,oz=b.pos.z;
  {const rk=S.mut==='rush'?1.2:1;b.pos.x+=mx*speed*1.1*(b.spdK||1)*rk*dt;b.pos.z+=mz*speed*1.1*(b.spdK||1)*rk*dt;}if(b.kbV){b.pos.addScaledVector(b.kbV,dt);b.kbV.multiplyScalar(Math.exp(-6*dt));if(b.kbV.lengthSq()<0.01)b.kbV=null;}collide(b.pos,0.35,(b.pos.y||0)+0.36,1.45);if(ISL)islClamp(b.pos);botGround(b,dt);/* bots step over low kerbs (≤0.35 m), fall off roofs and ledges instead of walking on air */
  const moved=Math.hypot(b.pos.x-ox,b.pos.z-oz);b.moving=moved>0.005*dt*60;
  if(ml>0&&moved<speed*dt*0.3)b.stuckT+=dt;else b.stuckT=Math.max(0,b.stuckT-dt);
  if(b.stuckT>0.8&&t){b.strafe*=-1;b.advance=0;b.stuckT=0;}
  botStepSounds(b,dt);b.walkT+=moved*3.3;
  {const tp=t&&t.alive?Math.atan2(eyeOf(t).y-(b.pos.y+1.45),Math.hypot(t.pos.x-b.pos.x,t.pos.z-b.pos.z)||1):0;const vx=(b.pos.x-ox)/Math.max(dt,1e-4),vz=(b.pos.z-oz)/Math.max(dt,1e-4);const lat=(vx*Math.cos(b.yaw)-vz*Math.sin(b.yaw))/4;
   b.crouch=(b.holdCrouch&&b.holdT>0&&!b.moving)?1:0;animSoldier(m,{vx,vz,pitch:tp,crouch:b.crouch,air:(b.vy||0)<-3,dt});}
  syncBot(b);
}
function botBuy(b){
  const R=S.round,T=b.team==='T';const good=['ak47','m4a4','m4a1s','awp','sg553','aug','galil','famas'];const has=id=>b.wpn.id===id;const buyW=id=>{b.money-=WEAPONS[id].price;b.wpn=WEAPONS[id];};
  if(b.money>=6500&&Math.random()<0.12&&!has('awp'))buyW('awp');
  else if(!good.includes(b.wpn.id)){
    const main=T?(Math.random()<0.8?'ak47':'sg553'):(Math.random()<0.5?'m4a4':Math.random()<0.6?'m4a1s':'aug');
    const cheap=T?'galil':'famas';
    if(b.money>=WEAPONS[main].price+650)buyW(main);else if(b.money>=WEAPONS[main].price)buyW(main);
    else if(b.money>=WEAPONS[cheap].price&&R.n>1)buyW(cheap);
    else if(WEAPONS[b.wpn.id].cat==='pistol'&&R.n>1&&b.money>=1300&&Math.random()<0.6)buyW([T?'mac10':'mp9','ump45','mp7',T?'sawedoff':'mag7','nova'][Math.floor(Math.random()*5)]);
    else if(WEAPONS[b.wpn.id].cat==='pistol'&&b.money>=700&&Math.random()<0.35)buyW(['deagle','p250',T?'tec9':'fiveseven'][Math.floor(Math.random()*3)]);
  }
  if(b.armor<100&&b.money>=650){b.money-=650;b.armor=100;}
  if(!T&&!b.kit&&b.money>=400){b.money-=400;b.kit=true;}
  b.mag=b.wpn.mag;
}

/* ================= DAMAGE / KILLS ================= */
function damage(v,amt,att,wid,head){if(v===player&&GP.active&&amt>0)gpRumble(Math.min(1,0.3+amt/90),0.4,160+Math.min(200,amt*2));
  if(!v.alive||v.drop)return;
  if(tryDeflect(v,amt,att,wid,head))return;
  if(NET.role==='client')return;
  if(v.isPlayer&&S.mode==='practice')return;
  if(S.mut==='glass'&&wid!=='fall')amt*=1.5;
  if(v.armor>0){const ab=Math.min(v.armor,amt*0.5);v.armor-=ab;amt-=ab;}
  if(att&&att.isPlayer&&v!==att&&v.team!==att.team)anDmg(wid,Math.min(amt,Math.max(0,v.hp)));else if(v.isPlayer)AN.taken+=Math.min(amt,Math.max(0,v.hp));
  if(NET.role==='host'&&v.isNet&&att&&att.id!==undefined)REF.hurt[v.id]={by:att.id,t:S.time,amt,used:0};
  v.hp-=amt;if(!v.isPlayer)v.aimErr=(v.aimErr===undefined?0.06:v.aimErr)+0.035;
  if(v.isPlayer){v.lastHurtT=S.time;dmgA=Math.min(0.75,dmgA+0.25+amt/150);sfx('hurt',0.6);if(att&&att!==v&&att.pos)dmgDirShow(att.pos);}
  else if(!v.isNet&&att&&att!==v&&att!==v.target&&att.team!==v.team){v.target=att;v.react=Math.min(v.react,0.25);v.yaw=lerpAng(v.yaw,Math.atan2(att.pos.x-v.pos.x,att.pos.z-v.pos.z),0.6);}
  if(att&&att.isPlayer&&v!==att){hitmarker(head,v.hp<=0);sfx(head?'head':'hit');}
  if(S.mut==='vamp'&&att&&att!==v&&att.alive&&att.team!==v.team&&amt>0)att.hp=Math.min(hpMax(),att.hp+amt*0.3);
  if(v.hp<=0)kill(v,att,wid,head);
}
function kill(v,att,wid,head){
  markDeath(v,att,head);v.alive=false;v.hp=0;v.deaths++;v.planting=0;v.defusing=0;
  const enemyKill=att&&att!==v&&att.team!==v.team;
  if(enemyKill){att.kills++;if(head&&att.isPlayer)att.heads++;if(S.mode==='tdm')S.teamScore[att.team]++;}
  if(S.mode==='br')v.place=S.ents.filter(e=>e.alive).length+1;
  feed(att,wid,v,head);
  let reward=0;
  if(enemyKill&&!isVersus()&&(S.mode==='tdm'||S.mode==='ffa'||S.mode==='defuse')&&WEAPONS[wid]){reward=WEAPONS[wid].reward;att.money=Math.min(16000,(att.money||0)+reward);}
  if(NET.role==='host')netBroadcast({t:'feed',a:att?att.id:null,w:wid,v:v.id,h:!!head,r:reward});
  if(att&&att.isPlayer&&enemyKill){onPlayerKill(v,wid,head,att.pos.distanceTo(v.pos));sfx('kill');center(`<span style="color:#ff6b5f">ELIMINATED</span> ${esc(v.name)}`+(reward?` <span style="color:#7dff9b">+$${reward}</span>`:''),1.4);}
  if(S.mode==='defuse'){const bomb=S.round.bomb;if(v.hasBomb)dropBomb(v);if(bomb.fetcher===v)chooseFetcher();}
  if(v.isPlayer)onLocalDeath(att,wid);else{v.deadT=0;v.target=null;}
  checkEnd();
}
function onLocalDeath(att,wid){
  if(player.deathSeed===undefined||player.alive)markDeath(player,att,false);player.dcFrom=null;
  player.ads=false;player.sprinting=false;player.slideT=0;player.roll=0;
  onPlayerDeathFun();
  const p=player;p.alive=false;p.reloading=false;mouse.down=false;p.deadT=0;p.planting=p.defusing=0;setScoped(false);
  const by=att&&att!==p?`${esc(att.name)} · ${wName(wid)}`:wName(wid)||'yourself';
  if(S.respawns){p.respawnT=3;center(`<span style="color:#ff6b5f">YOU WERE ELIMINATED</span><br><small>by ${by} — respawning…</small>`,3);}
  else if(S.mode==='br'&&!NET.role){S.place=p.place||S.ents.filter(e=>e.alive).length+1;S.endT=2;center(`<span style="color:#ff6b5f">ELIMINATED</span><br><small>by ${by} — placed #${S.place}</small>`,2);}
  else if(S.mode==='br'){center(`<span style="color:#ff6b5f">ELIMINATED</span><br><small>by ${by} — placed #${p.place||'?'} · spectating</small>`,3);}
  else if(S.mode==='defuse'){center(`<span style="color:#ff6b5f">YOU DIED</span><br><small>by ${by} — spectating</small>`,2.5);}
}
function checkEnd(){
  if(S.ended||NET.role==='client')return;
  if(S.mode==='tdm'){const G=S.tdmGoal||40;if(S.teamScore.A>=G)return finish(player.team==='A');if(S.teamScore.B>=G)return finish(player.team==='B');}
  if(S.mode==='ffa'){const lead=S.ents.reduce((a,b)=>b.kills>a.kills?b:a);if(lead.kills>=(S.duel?10:20)){S.endReason='kills';finish(lead===player);}}
  if(S.mode==='br'){const alive=S.ents.filter(e=>e.alive);const teams=new Set(alive.map(e=>e.team));/* last squad (or solo player) standing wins */
    if(NET.role==='host'){if(teams.size<=1){for(const e of alive)e.place=1;finish(!!alive[0]&&alive[0].team===player.team);}}
    else if(player.alive&&teams.size===1){S.place=1;player.place=1;finish(true);}}
  if(S.mode==='defuse'){const R=S.round;if(R.phase!=='live'&&R.phase!=='planted')return;
    const aT=S.ents.filter(e=>e.alive&&e.team==='T').length,aC=S.ents.filter(e=>e.alive&&e.team==='CT').length;
    if(aC===0)endRound('T','elim');else if(aT===0&&R.phase==='live')endRound('CT','elim');}
}

/* ================= BOMB DEFUSAL ROUNDS ================= */
/* ===== C4: six wrapped charges, taped, with a keypad timer, LCD, wires, antenna and a blinking LED ===== */
let _c4lcd=null;function c4LcdTex(txt){const c=document.createElement('canvas');c.width=128;c.height=40;const x=c.getContext('2d');x.fillStyle='#1d3a1a';x.fillRect(0,0,128,40);x.fillStyle='rgba(120,255,120,.12)';for(let i=0;i<40;i+=3)x.fillRect(0,i,128,1);
  x.font='bold 26px monospace';x.textAlign='center';x.textBaseline='middle';x.fillStyle='#8dff7a';x.shadowColor='#8dff7a';x.shadowBlur=6;x.fillText(txt,64,21);const t=new THREE.CanvasTexture(c);t.needsUpdate=true;return t;}
function c4Model(small){const g=new THREE.Group();const S2=small?0.55:1;
  const wrap=Lm({color:0xc9b48a}),wrap2=Lm({color:0xb8a276}),tape=Lm({color:0x1b1b1b}),plate=Lm({color:0x2c3026}),key=Lm({color:0x3d4238}),keyHi=Lm({color:0x8a8f84});
  for(let i=0;i<6;i++){const st=new THREE.Mesh(new THREE.BoxGeometry(0.052,0.05,0.27),i%2?wrap:wrap2);st.position.set(-0.13+i*0.052,0.027,0);st.castShadow=true;g.add(st);}
  for(const z of[-0.085,0.085]){const t=new THREE.Mesh(new THREE.BoxGeometry(0.33,0.056,0.028),tape);t.position.set(0,0.028,z);g.add(t);}
  const pl=new THREE.Mesh(new THREE.BoxGeometry(0.2,0.022,0.15),plate);pl.position.set(-0.01,0.064,0.0);g.add(pl);
  const lcdMat=new THREE.MeshBasicMaterial({map:c4LcdTex('*******')});const lcd=new THREE.Mesh(new THREE.PlaneGeometry(0.15,0.045),lcdMat);lcd.rotation.x=-Math.PI/2;lcd.position.set(-0.01,0.0765,-0.042);g.add(lcd);
  for(let r=0;r<3;r++)for(let c=0;c<4;c++){const k=new THREE.Mesh(new THREE.BoxGeometry(0.026,0.008,0.018),r===2&&c===3?Lm({color:0x7a2a22}):(r+c)%3?key:keyHi);k.position.set(-0.07+c*0.04,0.079,0.0+r*0.026);g.add(k);}
  const wireC=[0xd22b2b,0x2b6ad2,0xe0c020];wireC.forEach((col,i)=>{const pts=[new V3(0.09,0.07,-0.05+i*0.03),new V3(0.13,0.1,-0.04+i*0.03),new V3(0.16,0.06,-0.02+i*0.035),new V3(0.15,0.03,0.02+i*0.03)];
    const w=new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts),10,0.0055,5),Lm({color:col}));g.add(w);});
  const ant=new THREE.Mesh(new THREE.CylinderGeometry(0.004,0.004,0.09,5),tape);ant.position.set(0.08,0.11,0.06);g.add(ant);
  const led=new THREE.Mesh(new THREE.SphereGeometry(0.011,8,6),new THREE.MeshBasicMaterial({color:0xff2a1a}));led.position.set(0.07,0.082,-0.05);g.add(led);
  const glow=new THREE.Sprite(new THREE.SpriteMaterial({map:FX_BALL,color:0xff3020,blending:THREE.AdditiveBlending,depthWrite:false,transparent:true,opacity:0.9}));glow.scale.set(0.16,0.16,1);glow.position.copy(led.position);g.add(glow);
  g.scale.setScalar(S2*1.25);return{g,led,glow,lcd,lcdMat};}
function makeBombMesh(){const m=c4Model(false);m.g.visible=false;scene.add(m.g);return m;}
function c4SetLcd(mesh,txt){if(!mesh||!mesh.lcdMat||mesh._txt===txt)return;mesh._txt=txt;if(mesh.lcdMat.map)mesh.lcdMat.map.dispose();mesh.lcdMat.map=c4LcdTex(txt);mesh.lcdMat.needsUpdate=true;}
/* carrier wears the C4 on their back */
function c4Back(e){const M=e.model||e.body;if(!M||!M.up)return;const want=S.mode==='defuse'&&e.hasBomb&&e.alive;
  if(want&&!e._c4){const m=c4Model(true);m.g.rotation.set(-Math.PI/2+0.15,0,0);m.g.position.set(0,0.3,-0.3);m.glow.visible=false;M.up.add(m.g);e._c4=m;}
  else if(!want&&e._c4){if(e._c4.g.parent)e._c4.g.parent.remove(e._c4.g);e._c4=null;}
  if(e._c4)e._c4.led.visible=(S.time*2%1)<0.15;}
function setupDefuse(){S.round={n:0,phase:'freeze',t:ROUND.freeze,wins:{T:0,CT:0},loss:{T:0,CT:0},planted:false,siteTarget:'A',bomb:{state:'carried',pos:new V3(),mesh:makeBombMesh(),beepT:0,ledT:0,fetcher:null,site:null}};}
function resetLoadout(e){
  const pistol=e.isPlayer&&S.mode==='defuse'?startPistolFor(e.team):((S.mode==='defuse'&&e.team==='CT')?'usp':'glock');
  if(e.isPlayer){const kn=(e.inv&&e.inv[3])?e.inv[3].id:knifeId();e.inv={1:null,2:{id:pistol,ammo:WEAPONS[pistol].mag,reserve:WEAPONS[pistol].reserve},3:{id:kn},4:null,5:null};e.nades=[];e.kit=false;e.slot=2;setScoped(false);}
  else{e.wpn=WEAPONS[pistol];e.kit=false;}
  e.armor=0;
}
function refillAmmo(p){p.mstep=null;for(const s of[1,2]){const ws=p.inv[s];if(ws){ws.ammo=WEAPONS[ws.id].mag;ws.reserve=WEAPONS[ws.id].reserve;ws.mr=null;ws.mags=null;ws.chamber=0;}}}
function roundStartMsg(n,hasBomb){const side=player.team==='T'?'ATTACK (T)':'DEFENSE (CT)';center(`<span style="color:var(--acc2)">ROUND ${n}</span><br><small>You are on ${side} · Buy phase — press B${hasBomb?' · YOU HAVE THE BOMB':''}</small>`,4);sfx('beep');}
function startRound(){
  const R=S.round;R.n++;R.phase='freeze';R.t=ROUND.freeze;R.planted=false;R.siteTarget=Math.random()<0.5?'A':'B';
  const bomb=R.bomb;bomb.state='carried';bomb.fetcher=null;bomb.site=null;bomb.mesh.g.visible=false;c4SetLcd(bomb.mesh,'*******');
  clearNadesSmokes();for(const d of S.decals)scene.remove(d);S.decals=[];bloodClear();barrelsSpawn();winsRestore();
  for(const e of S.ents){
    const died=!e.alive||R.n===1;
    if(died)resetLoadout(e);
    e.alive=true;e.hp=100;e.hasBomb=false;e.planting=0;e.defusing=0;
    if(e.isPlayer){e.healT=0;if(died||!(e.meds>0))e.meds=1;refillAmmo(e);e.vel.set(0,0,0);e.pos.y=0;e.sprayIdx=0;e.reloading=false;e.deadT=0;e.respawnT=0;if(!e.inv[e.slot])e.slot=2;}
    else{resetPose(e.model);e.model.g.visible=true;e.target=null;e.wp=null;e.holdT=0;e.waitT=e.team==='T'?rand(0,6):rand(0,2);e.deadT=0;if(!e.isNet)botBuy(e);}
    placeEnt(e);if(!e.isPlayer){e.tpos.copy(e.pos);syncBot(e);}
    e._died=died;
  }
  player.spawnTime=S.time;camera.rotation.z=0;S.spec=null;
  const Ts=S.ents.filter(e=>e.team==='T');const carrier=Ts[Math.floor(Math.random()*Ts.length)];carrier.hasBomb=true;
  let i=0;for(const b of S.bots){b.dt=null;b.watch=undefined;b.holdCrouch=false;b.crouch=0;if(b.team==='CT')b.role=['A','B','A','B','roam'][i++%5];}
  if(NET.role!=='client')planRound();
  if(NET.role==='host')for(const e of S.ents)if(e.isNet){REF.grant(e.id,e.pos.x,e.pos.y,e.pos.z);netSend(e.id,{t:'round',n:R.n,reset:e._died,bomb:e.hasBomb,x:e.pos.x,z:e.pos.z,yaw:e.yaw+Math.PI});}
  roundStartMsg(R.n,carrier===player);
}
function dropBomb(e){const bomb=S.round.bomb;e.hasBomb=false;bomb.state='dropped';bomb.pos.set(e.pos.x,e.pos.y,e.pos.z);bomb.mesh.g.position.copy(bomb.pos);bomb.mesh.g.visible=true;chooseFetcher();}
function chooseFetcher(){const bomb=S.round.bomb;if(bomb.state!=='dropped'){bomb.fetcher=null;return;}let best=null,bd=1e9;for(const b of S.bots){if(!b.alive||b.team!=='T'||b.isNet)continue;const d=b.pos.distanceTo(bomb.pos);if(d<bd){bd=d;best=b;}}bomb.fetcher=best;if(best){best.wp=null;best.holdT=0;best.waitT=0;}}
function plantedMsg(site){center(`<span style="color:#ff5a4f">THE BOMB HAS BEEN PLANTED</span><br><small>Site ${site} · 40 seconds</small>`,3);sfx('warn');setTimeout(()=>announce('The bomb has been planted'),500);}
function plantBomb(e){const R=S.round,bomb=R.bomb;e.hasBomb=false;e.planting=0;bomb.state='planted';bomb.pos.set(e.pos.x,e.pos.y,e.pos.z);bomb.site=siteAt(e.pos)||'?';bomb.mesh.g.position.copy(bomb.pos);bomb.mesh.g.visible=true;
  R.phase='planted';R.t=ROUND.bomb;R.planted=true;bomb.beepT=0;e.money=Math.min(16000,(e.money||0)+300);
  plantedMsg(bomb.site);if(NET.role==='host')netBroadcast({t:'planted',site:bomb.site});
  for(const b of S.bots){b.wp=null;b.holdT=0;b.waitT=0;}}
function defuseBomb(e){const bomb=S.round.bomb;bomb.state='defused';announce('The bomb has been defused');e.money=Math.min(16000,(e.money||0)+300);for(const x of S.ents)x.defusing=0;endRound('CT','defused');}
function explodeBomb(){const bomb=S.round.bomb;bomb.state='exploded';bomb.mesh.g.visible=false;endRound('T','exploded');
  const p=bomb.pos.clone();p.y+=1;boom(p,9);sfx('boom');dmgA=Math.max(dmgA,0.4);
  if(NET.role==='host')netBroadcast({t:'boom',p:[p.x,p.y,p.z],s:9});
  for(const e of S.ents){if(!e.alive)continue;const d=e.pos.distanceTo(bomb.pos);if(d<25){const dmg=520*Math.pow(1-d/25,1.5);if(dmg>1)damage(e,dmg,null,'bomb',false);}}}
const ROUND_TXT={elim:'Enemy team eliminated',time:'Time ran out',defused:'The bomb has been defused',exploded:'Target destroyed'};
function roundEndMsg(win,reason,reward,lossB){const mine=win===player.team;
  center(`<span style="color:${win==='CT'?'#6cb8ff':'#ffb35c'}">${win==='CT'?'DEFENDERS (CT)':'ATTACKERS (T)'} WIN</span><br><small>${ROUND_TXT[reason]} · ${mine?'+$'+reward+' round win':'+$'+lossB+' loss bonus'}</small>`,4.5);sfx(mine?'rwin':'rlose');setTimeout(()=>announce(win==='CT'?'Counter-terrorists win':'Terrorists win'),reason==='exploded'?900:250);}
function endRound(win,reason){
  const R=S.round;if(R.phase==='post')return;
  const wasPlanted=R.planted;R.phase='post';R.t=ROUND.post;R.wins[win]++;
  const lose=win==='T'?'CT':'T';
  const reward={elim:3250,time:3250,defused:3500,exploded:3500}[reason];
  const lossB=1400+500*Math.min(R.loss[lose],4);
  for(const e of S.ents){e.money+=e.team===win?reward:lossB+(lose==='T'&&wasPlanted?800:0);e.money=Math.min(16000,e.money);e.planting=0;e.defusing=0;}
  R.loss[lose]++;R.loss[win]=Math.max(0,R.loss[win]-1);
  if(NET.role==='host')netBroadcast({t:'roundend',win,reason,reward,lossB});
  roundEndMsg(win,reason,reward,lossB);
}
function bombFx(dt){const R=S.round,bomb=R.bomb;
  if(R.phase==='planted'&&bomb.state==='planted'){bomb.beepT-=dt;if(bomb.beepT<=0){bomb.beepT=clamp(R.t/ROUND.bomb,0.09,1);bomb.ledT=0.08;const d=player.pos.distanceTo(bomb.pos);sfx('bombbeep',clamp(1-d/60,0.08,1));}}
  bomb.ledT-=dt;const on=bomb.state!=='planted'||bomb.ledT>0;bomb.mesh.led.visible=on;if(bomb.mesh.glow){bomb.mesh.glow.visible=bomb.state==='planted'&&bomb.ledT>0;bomb.mesh.glow.scale.setScalar(0.16+(bomb.ledT>0?0.12:0));}
  if(bomb.state==='planted')c4SetLcd(bomb.mesh,R.t<10?Math.max(0,R.t).toFixed(1).padStart(4,'0'):'*******');else if(bomb.state==='defused')c4SetLcd(bomb.mesh,'-------');
  for(const e of S.ents)c4Back(e);}
function updateRound(dt){
  const R=S.round,bomb=R.bomb;R.t-=dt;
  if(R.phase==='freeze'){if(R.t<=0){R.phase='live';R.t=ROUND.live;center('<span class="cd">GO</span>',0.9);sfx('go');announce(pick(['Go go go','Let\'s move out','Lock and load']));}}
  else if(R.phase==='live'){if(R.t<=0)endRound('CT','time');}
  else if(R.phase==='planted'){if(R.t<=0)explodeBomb();}
  else if(R.phase==='post'){if(R.t<=0){if(R.wins.T>=ROUND.toWin||R.wins.CT>=ROUND.toWin)finish(R.wins[player.team]>=ROUND.toWin);else startRound();return;}}
  bombFx(dt);dtUpdate(dt);
  if(bomb.state==='dropped'&&R.phase!=='post'){for(const e of S.ents){if(e.alive&&e.team==='T'&&e.pos.distanceTo(bomb.pos)<1.3){e.hasBomb=true;bomb.state='carried';bomb.mesh.g.visible=false;bomb.fetcher=null;if(e.isPlayer){center('You picked up the bomb',1.5);sfx('pickup');}break;}}}
}
function handleObjective(dt){
  const p=player;if(S.mode!=='defuse'){p.planting=p.defusing=0;return;}
  const R=S.round,bomb=R.bomb,E=keys.KeyE&&!S.uiOpen;
  if(p.hasBomb&&R.phase==='live'&&siteAt(p.pos)&&p.onGround&&E){if(p.planting===0)sfx('click');p.planting+=dt;if(p.planting>=ROUND.plant){p.planting=0;if(NET.role==='client')netToHost({t:'plant'});else plantBomb(p);}}else p.planting=0;
  if(p.team==='CT'&&R.phase==='planted'&&bomb.state==='planted'&&p.pos.distanceTo(bomb.pos)<1.8&&E){if(p.defusing===0)sfx('click');p.defusing+=dt;if(p.defusing>=(p.kit?ROUND.kit:ROUND.defuse)){p.defusing=0;if(NET.role==='client')netToHost({t:'defuse'});else defuseBomb(p);}}else p.defusing=0;
}

/* ---- FFA top leaderboard ---- */
const AVA={};
function avatarUrl(name,isMe){const k=name+(isMe?'*':'');if(AVA[k])return AVA[k];
  let h=2166136261;for(const ch of name)h=Math.imul(h^ch.charCodeAt(0),16777619);const R=()=>((h=Math.imul(h^(h>>>15),2246822507)>>>0)/4294967296);
  const c=document.createElement('canvas');c.width=c.height=64;const x=c.getContext('2d');
  const skins=['#f2c9a0','#e0ac7e','#c68a5a','#8d5a3b','#f5d36b','#ffd9b8'],shirts=['#2f6fd0','#d03a3a','#3aa04a','#7a4ad0','#e08a20','#20a0a0','#444','#e05090'];
  const skin=skins[R()*skins.length|0],shirt=isMe?'#f0b030':shirts[R()*shirts.length|0],style=R()*7|0;
  x.fillStyle=shirt;x.fillRect(12,50,40,14);x.fillStyle='rgba(0,0,0,.18)';x.fillRect(12,50,40,3);
  if(style===5){x.fillStyle='#ff8a1a';x.beginPath();x.ellipse(32,30,22,20,0,0,7);x.fill();x.strokeStyle='#c45a00';x.lineWidth=2;for(const dx of[-10,0,10]){x.beginPath();x.ellipse(32+dx,30,6,19,0,0,7);x.stroke();}
    x.fillStyle='#3a6a1a';x.fillRect(29,8,6,6);x.fillStyle='#2a1200';x.beginPath();x.moveTo(20,26);x.lineTo(27,24);x.lineTo(24,31);x.fill();x.beginPath();x.moveTo(44,26);x.lineTo(37,24);x.lineTo(40,31);x.fill();
    x.beginPath();x.moveTo(20,37);for(let i=0;i<=6;i++)x.lineTo(20+i*4,i%2?44:38);x.lineTo(44,37);x.fill();}
  else{x.fillStyle=skin;x.fillRect(16,14,32,34);x.fillStyle='rgba(0,0,0,.08)';x.fillRect(16,40,32,8);
    x.fillStyle='#1b1b1b';x.fillRect(23,26,5,6);x.fillRect(36,26,5,6);x.fillStyle='#fff';x.fillRect(24,27,2,2);x.fillRect(37,27,2,2);
    x.strokeStyle='#1b1b1b';x.lineWidth=2;x.beginPath();x.arc(32,36,6,0.2,Math.PI-0.2);x.stroke();
    const hc=['#2b1a10','#5a3a1a','#d8b040','#111','#a03020','#888'][R()*6|0];
    if(style===0){x.fillStyle='#5a6a3a';x.fillRect(13,8,38,12);x.fillRect(15,6,34,4);x.fillStyle=isMe?'#f0b030':'#2f6fd0';x.fillRect(13,18,38,3);}
    else if(style===1){x.fillStyle=hc;x.fillRect(14,8,36,10);x.fillRect(14,8,6,22);x.fillRect(44,8,6,16);}
    else if(style===2){x.fillStyle='#d03030';x.beginPath();x.moveTo(14,16);x.lineTo(50,16);x.lineTo(40,0);x.fill();x.fillStyle='#fff';x.fillRect(12,14,40,6);x.beginPath();x.arc(40,2,4,0,7);x.fill();}
    else if(style===3){x.fillStyle=shirt;x.fillRect(14,8,36,10);x.fillRect(8,15,20,5);}
    else if(style===4){x.fillStyle='#ddd';for(let i=0;i<7;i++){x.beginPath();x.moveTo(12+i*6,16);x.lineTo(15+i*6,2+(i%2)*5);x.lineTo(19+i*6,16);x.fill();}x.fillStyle='#222';x.fillRect(16,30,32,9);}
    else if(style===6){x.fillStyle='#202020';x.fillRect(14,24,36,10);x.fillStyle='#6cf';x.fillRect(18,26,11,6);x.fillRect(35,26,11,6);x.fillStyle=hc;x.fillRect(14,8,36,8);}}
  return AVA[k]=c.toDataURL();}
function entWeapon(e){if(e.isPlayer){const s=e.inv&&e.inv[e.slot];return s?s.id:null;}if(e.wpn&&e.wpn.id)return e.wpn.id;return e.wid||null;}
function wIconFor(id){if(!id||!WEAPONS[id])return '';const w=WEAPONS[id];try{if(w.melee)return knifeIcon(id,'')||'';if(w.nade)return '';return weaponIcon(id,null)||'';}catch(e){return '';}}
let _lbT=0,_lbKey='';
function renderLeaderboard(force){const el=$('lb');if(!el)return;const on=S.mode==='ffa'&&S.state==='game'&&!S.ended;document.body.classList.toggle('ffa-lb',on);if(!on)return;
  if(!force&&S.time>=_lbT&&S.time-_lbT<0.25)return;_lbT=S.time;
  const list=S.ents.filter(e=>e&&e.name!==undefined).slice().sort((a,b)=>(b.kills||0)-(a.kills||0)||(a.deaths||0)-(b.deaths||0)).slice(0,8);
  if(!list.includes(player)&&S.ents.includes(player)){list.pop();list.push(player);}
  const rows=list.map(e=>{const rank=S.ents.filter(o=>(o.kills||0)>(e.kills||0)).length+1;return{e,rank,me:e===player,name:e===player?(save.name||'You'):e.name,k:e.kills||0,w:entWeapon(e),dead:!e.alive};});
  const key=rows.map(r=>r.rank+r.name+r.k+r.w+r.dead).join('|')+fmtTime(S.timeLeft);if(key===_lbKey)return;_lbKey=key;
  el.innerHTML=`<div class="lb-time">${fmtTime(S.timeLeft)}<small>FIRST TO ${S.ffaGoal||20}</small></div>`+rows.map(r=>{const wi=wIconFor(r.w);
    return `<div class="lb-c${r.me?' me':''}${r.dead?' dead':''}${r.rank===1?' gold':''}"><b class="lb-r">#${r.rank}</b><div class="lb-a"><img src="${avatarUrl(r.name,r.me)}">${wi?`<img class="lb-w" src="${wi}">`:''}<span class="lb-k">${r.k}</span></div><div class="lb-n">${esc(r.name)}</div></div>`;}).join('');}

/* ================= GRENADES ================= */
/* ---- Grenade pack assets (PiSquad, MIT) ---- */
var NPK=window.CR_NADEPK||{snd:{},tex:{},models:{}};
var NPK_ID={he:'hegrenade',smoke:'smokegrenade',flashbang:'flashbang',decoy:'decoy',molotov:'molotov',incendiary:'incendiary'};
const NADE_DRAW={he:'hegrenade/hegrenade_draw',smoke:'smokegrenade/smokegrenade_draw',flashbang:'flashbang/flashbang_draw',decoy:'decoy/decoy_draw',molotov:'incendiary/incendiary_draw',incendiary:'incendiary/incendiary_draw',firebomb:'incendiary/incendiary_draw'};
const npkPlay=(k,vol=1,pos)=>playHZ('np:'+k,vol,1,pos);
var NPK_TEX;function npkTex(n){NPK_TEX=NPK_TEX||{};if(NPK_TEX[n])return NPK_TEX[n];const t=new THREE.Texture();t.magFilter=THREE.LinearFilter;t.minFilter=THREE.LinearMipmapLinearFilter;t.anisotropy=4;const im=new Image();im.onload=()=>{try{t.image=typeof hdCanvas==='function'?hdCanvas(im):im;}catch(e){t.image=im;}t.needsUpdate=true;};im.src=NPK.tex[n];return NPK_TEX[n]=t;}
function javaModel(name,scale){NPK=NPK||window.CR_NADEPK||{snd:{},tex:{},models:{}};const M=NPK.models[name];if(!M||!NPK.tex[M.tex])return null;const mat=new THREE.MeshLambertMaterial({map:npkTex(M.tex),alphaTest:0.4});
  const pos=[],uv=[];
  for(const e of M.el){const f=e.f,t=e.t;
    const C={north:[[t[0],t[1],f[2]],[f[0],t[1],f[2]],[f[0],f[1],f[2]],[t[0],f[1],f[2]]],south:[[f[0],t[1],t[2]],[t[0],t[1],t[2]],[t[0],f[1],t[2]],[f[0],f[1],t[2]]],
      west:[[f[0],t[1],f[2]],[f[0],t[1],t[2]],[f[0],f[1],t[2]],[f[0],f[1],f[2]]],east:[[t[0],t[1],t[2]],[t[0],t[1],f[2]],[t[0],f[1],f[2]],[t[0],f[1],t[2]]],
      up:[[f[0],t[1],f[2]],[t[0],t[1],f[2]],[t[0],t[1],t[2]],[f[0],t[1],t[2]]],down:[[f[0],f[1],t[2]],[t[0],f[1],t[2]],[t[0],f[1],f[2]],[f[0],f[1],f[2]]]};
    let rot=null;if(e.r){const[a,ax,o]=e.r;rot={m:new THREE.Matrix4().makeRotationAxis(new V3(ax==='x'?1:0,ax==='y'?1:0,ax==='z'?1:0),a*Math.PI/180),o:new V3(...o)};}
    for(const k in e.fc){if(!C[k])continue;const[q,fr]=e.fc[k];const U=q||[0,0,16,16];
      const c=[[U[0],U[1]],[U[2],U[1]],[U[2],U[3]],[U[0],U[3]]];for(let i=0;i<(((fr||0)/90)|0);i++)c.unshift(c.pop());
      const v=C[k].map(p=>{const P=new V3(...p);if(rot)P.sub(rot.o).applyMatrix4(rot.m).add(rot.o);return P;});
      for(const i of[0,2,1,0,3,2]){pos.push(v[i].x,v[i].y,v[i].z);uv.push(c[i][0]/16,1-c[i][1]/16);}}}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));g.setAttribute('uv',new THREE.Float32BufferAttribute(uv,2));g.computeVertexNormals();
  g.computeBoundingBox();const bb=g.boundingBox;g.translate(-(bb.min.x+bb.max.x)/2,-(bb.min.y+bb.max.y)/2,-(bb.min.z+bb.max.z)/2);g.scale(scale,scale,scale);
  const m=new THREE.Mesh(g,mat);m.castShadow=true;return m;}
const NADE_TPL={};function nadeMesh(id){const n=NPK_ID[id];if(n){if(NADE_TPL[id]===undefined)NADE_TPL[id]=javaModel(n,0.016)||null;if(NADE_TPL[id])return NADE_TPL[id].clone();}return null;}
/* ---- flashbang ---- */
function popFlash(n){const pos=n.pos.clone();
  const fl=new THREE.Mesh(GEO.boom,new THREE.MeshBasicMaterial({color:0xffffff,transparent:true,opacity:1,blending:THREE.AdditiveBlending,depthWrite:false,fog:false}));fl.position.copy(pos);scene.add(fl);S.fx.push({m:fl,life:0.3,max:1.6,kind:'boom'});particles(pos,'spark',10,4);
  const d0=player.pos.distanceTo(pos);if(!(d0>40?npkPlay('flashbang/flashbang_explode_distant',0.8):npkPlay('flashbang/flashbang_explode',1.2,pos)))sfx('boom',0.5,pos);
  const blindFor=(eye,fwd)=>{const d=eye.distanceTo(pos);if(d>32)return 0;const dir=pos.clone().sub(eye);dir.divideScalar(d||1);
    raycaster.set(eye,dir);raycaster.far=Math.max(0.01,d-0.15);const hit=raycaster.intersectObjects(worldMeshes,false);raycaster.far=Infinity;if(hit.length)return 0;if(smokeBlocks(eye,pos))return 0;
    const dot=fwd.dot(dir),face=dot>0.6?1:dot>0.1?0.55:0.18;return 4.8*face*Math.pow(1-d/32,0.6);};
  if(player.alive&&S.state==='game'){const eye=camera.position.clone();const dur=blindFor(eye,viewDir(player.yaw,player.pitch));
    if(dur>0.25){S.flashEnd=Math.max(S.flashEnd||0,S.time+dur);S.flashDur=Math.max(dur,S.flashEnd-S.time);if(dur>1.6)npkPlay('flashbang/explosion_ring',Math.min(1,dur/4));}}
  if(n.visual||NET.role==='client')return;
  for(const b of S.bots){if(!b.alive||b.isNet||b.isProxy)continue;const eye=new V3(b.pos.x,b.pos.y+1.6,b.pos.z);const dur=blindFor(eye,new V3(Math.sin(b.yaw),0,Math.cos(b.yaw)));if(dur>0.3){b.blindT=Math.max(b.blindT||0,dur*0.9);b.target=null;}}}
/* ---- decoy ---- */
function decoyGun(o){if(!o)return 'ak47';if(o.isPlayer){const s=o.inv[1]||o.inv[2];return s?s.id:'glock';}return (o.wpn&&o.wpn.id)||'ak47';}
function startDecoy(n){n.dc={t:0,next:0.3,w:decoyGun(n.owner)};n.vel.set(0,0,0);
  if(n.visual||NET.role==='client'||!n.owner)return;
  for(const b of S.bots){if(!b.alive||b.isNet||b.isProxy||b.target)continue;if(n.owner.team===b.team&&S.mode!=='ffa'&&S.mode!=='br')continue;if(b.pos.distanceTo(n.pos)<40){b.wp=new V3(n.pos.x+rand(-2,2),0,n.pos.z+rand(-2,2));b.holdT=0;b.waitT=0;}}}
function updateDecoy(n,dt){const D=n.dc;D.t+=dt;D.next-=dt;
  if(D.next<=0){const burst=1+(Math.random()*4|0),w=D.w,p=n.pos.clone();for(let k=0;k<burst;k++)setTimeout(()=>{if(S.state==='game'&&!S.ended)gunSound(w,p);},k*(WEAPONS[w]&&WEAPONS[w].rate?Math.max(90,WEAPONS[w].rate*1000):120));D.next=0.6+Math.random()*1.7;
    if(Math.random()<0.5)particles(p.clone().setY(p.y+0.1),'spark',2,1);}
  return D.t>15;}

function refreshNades(){const p=player;p.inv[4]=p.nades.length?{id:p.nades[0]}:null;if(!p.inv[4]&&p.slot===4)switchSlot(p.inv[1]?1:2);}
function spawnNade(id,pos,vel,owner,visual){const mesh=nadeMesh(id)||new THREE.Mesh(GEO.nade,Lm({color:{he:0x4a5a2a,smoke:0x9aa0a6,molotov:0x7a4518,incendiary:0x8a8f95,firebomb:0xa12a1a}[id]||0x9aa0a6}));mesh.position.copy(pos);scene.add(mesh);S.nades.push({id,pos:pos.clone(),vel:vel.clone(),t:0,owner,mesh,visual});}
function throwNade(id){
  const p=player;const i=p.nades.indexOf(id);if(i<0)return;p.nades.splice(i,1);
  p.cool=Math.max(p.cool,0)+0.8;if(!npkPlay(id==='molotov'||id==='incendiary'||id==='firebomb'?'incendiary/incendiary_throw':'common/grenade_throw',0.9))sfx('throw');if(id==='he'||id==='smoke'||id==='flashbang')nadeAudio('pin',player.pos);
  const f=viewDir(p.yaw,p.pitch);
  const pos=camera.position.clone().addScaledVector(f,0.5);
  const vel=f.clone().multiplyScalar(15);vel.y+=2.5;vel.x+=p.vel.x*0.5;vel.z+=p.vel.z*0.5;
  spawnNade(id,pos,vel,p,NET.role==='client');
  if(NET.role)netSendOrBroadcast({t:'nade',id,p:[pos.x,pos.y,pos.z],v:[vel.x,vel.y,vel.z],by:player.id});
  refreshNades();
}
function clearNadesSmokes(){clearFires();for(const n of S.nades)scene.remove(n.mesh);S.nades=[];for(const s of S.smokes)for(const m of s.meshes){scene.remove(m);if(m.material)m.material.dispose();}S.smokes=[];}
/* ---- physics helpers ---- */
const NR=0.075;
function nadeStep(n,dt){const sub=Math.max(1,Math.ceil(Math.hypot(n.vel.x,n.vel.y,n.vel.z)*dt/0.06));const h=dt/sub;let contact=false;
  for(let s=0;s<sub;s++){
    n.vel.y-=15*h;const drag=Math.exp(-0.12*h);n.vel.multiplyScalar(drag);
    n.pos.addScaledVector(n.vel,h);
    // ground
    if(n.pos.y<NR){n.pos.y=NR;contact=true;nadeHit(n,0,1,0,0);}
    // boxes
    for(const c of nearCol(n.pos.x,n.pos.z,NR+0.1)){if(n.pos.y+NR<c.minY||n.pos.y-NR>c.maxY)continue;
      const cx=clamp(n.pos.x,c.minX,c.maxX),cy=clamp(n.pos.y,c.minY,c.maxY),cz=clamp(n.pos.z,c.minZ,c.maxZ);
      let dx=n.pos.x-cx,dy=n.pos.y-cy,dz=n.pos.z-cz;let d=Math.hypot(dx,dy,dz);
      if(d>=NR)continue;
      if(d<1e-5){const pen=[[n.pos.x-c.minX,-1,0,0],[c.maxX-n.pos.x,1,0,0],[n.pos.y-c.minY,0,-1,0],[c.maxY-n.pos.y,0,1,0],[n.pos.z-c.minZ,0,0,-1],[c.maxZ-n.pos.z,0,0,1]].sort((a,b)=>a[0]-b[0])[0];dx=pen[1];dy=pen[2];dz=pen[3];d=0;
        n.pos.x+=dx*(pen[0]+NR);n.pos.y+=dy*(pen[0]+NR);n.pos.z+=dz*(pen[0]+NR);}
      else{dx/=d;dy/=d;dz/=d;n.pos.x=cx+dx*NR;n.pos.y=cy+dy*NR;n.pos.z=cz+dz*NR;}
      contact=true;nadeHit(n,dx,dy,dz,dy>0.6?c.maxY:undefined);}
    // players / bots (grenades bounce off bodies)
    for(const e of S.ents){if(!e.alive||e===n.owner&&n.t<0.25)continue;const ddx=n.pos.x-e.pos.x,ddz=n.pos.z-e.pos.z,dd=Math.hypot(ddx,ddz);
      if(dd<0.38+NR&&n.pos.y>e.pos.y&&n.pos.y<e.pos.y+1.8){const nx=ddx/(dd||1),nz=ddz/(dd||1);n.pos.x=e.pos.x+nx*(0.38+NR);n.pos.z=e.pos.z+nz*(0.38+NR);nadeHit(n,nx,0,nz,undefined,0.25);}}
  }
  // rolling resistance while resting on something
  if(contact&&Math.abs(n.vel.y)<0.6){const sp=Math.hypot(n.vel.x,n.vel.z);if(sp>0){const ns=Math.max(0,sp-3.2*dt);n.vel.x*=ns/sp;n.vel.z*=ns/sp;}n.rolling=true;}else n.rolling=false;}
function nadeHit(n,nx,ny,nz,topY,eOverride){const vn=n.vel.x*nx+n.vel.y*ny+n.vel.z*nz;if(vn>=0)return;
  const e=eOverride!==undefined?eOverride:(n.id==='molotov'?0.15:0.42);
  n.vel.x-=(1+e)*vn*nx;n.vel.y-=(1+e)*vn*ny;n.vel.z-=(1+e)*vn*nz;
  const tx=n.vel.x-(n.vel.x*nx+n.vel.y*ny+n.vel.z*nz)*nx,ty=n.vel.y-(n.vel.x*nx+n.vel.y*ny+n.vel.z*nz)*ny,tz=n.vel.z-(n.vel.x*nx+n.vel.y*ny+n.vel.z*nz)*nz;
  const fr=0.22;n.vel.x-=tx*fr;n.vel.y-=ty*fr;n.vel.z-=tz*fr;
  if(-vn>1.5)nadeBounce(n);
  if(ny>0.6)n.landY=topY!==undefined?topY:0;
  if(n.vel.y<0.05&&ny>0.6&&-vn<1.2)n.vel.y=0;}
/* ---- bullet penetration (wallbangs) ---- */
function penPower(w){if(w.pellets)return 0;const c=w.cat;if(w.id==='awp')return 1.0;if(w.id==='deagle'||w.id==='r8')return 0.45;return c==='sniper'?0.8:c==='dmr'?0.6:c==='mg'?0.55:c==='rifle'?0.5:c==='smg'?0.28:c==='pistol'?0.22:0;}
function penRay(o,dir,w,objs){const far=w.range*4;let h=shotRay(o,dir,far,objs);let k=1,travelled=0,pens=0;const maxP=w.id==='awp'?2:1;const P=penPower(w);
  while(h&&P>0&&pens<maxP&&!h.object.userData.ent&&!h.object.userData.target){
    const back=h.point.clone().addScaledVector(dir,P+0.02);raycaster.set(back,dir.clone().negate());raycaster.far=P+0.02;const ex=raycaster.intersectObjects(worldMeshes,false);raycaster.far=Infinity;
    if(!ex.length)break;const exitP=ex[0].point;const thick=exitP.distanceTo(h.point);if(thick>P)break;
    const n=h.face?h.face.normal.clone().transformDirection(h.object.matrixWorld):null;decal(h.point,n);particles(h.point,'dust',2,1.2);
    decal(exitP,dir);particles(exitP,'dust',3,1.6);
    k*=Math.max(0.15,(1-thick/P)*0.78);pens++;travelled+=h.distance+thick;
    const o2=exitP.clone().addScaledVector(dir,0.02);const h2=shotRay(o2,dir,far-travelled,objs);if(h2)h2.distance+=travelled;h=h2;}
  return{h,k,pens};}

function nadeBounce(n){if(S.time-(n.bt||-9)<0.12)return;n.bt=S.time;const k=n.id==='he'?'hegrenade/hegrenade_bounce':(n.id==='molotov'||n.id==='incendiary'||n.id==='firebomb')?'incendiary/incendiary_bounce':'common/grenade_hit';npkPlay(k,0.7,n.pos);}
function updateNades(dt){updateWater(dt);try{fxOverlayTick(dt);}catch(e){}
  for(let i=S.nades.length-1;i>=0;i--){const n=S.nades[i];n.t+=dt;
    if(!n.dc)nadeStep(n,dt);
    n.mesh.position.copy(n.pos);{const sp=Math.hypot(n.vel.x,n.vel.y,n.vel.z);if(sp>0.15&&!n.dc){if(n.rolling){n.mesh.rotation.x+=dt*sp/NR*0.5;}else{n.mesh.rotation.x+=dt*sp*1.1;n.mesh.rotation.z+=dt*sp*0.4;}}}
    if(n.id==='he'&&n.t>1.6){scene.remove(n.mesh);S.nades.splice(i,1);explodeHE(n);}
    else if(n.id==='smoke'&&n.t>1.8){scene.remove(n.mesh);S.nades.splice(i,1);deploySmoke(n.pos);}
    else if((n.id==='molotov'||n.id==='incendiary')&&(n.landY!==undefined||n.t>2.2)){scene.remove(n.mesh);S.nades.splice(i,1);
      if(n.landY===undefined&&n.pos.y>1.4){particles(n.pos,'spark',10,2);if(!npkPlay('incendiary/incendiary_explode_air',0.9,n.pos))sfx('hiss',0.6,n.pos);}else igniteAt(n,n.landY!==undefined?n.landY:0,n.id,3.0,7);}
    else if(n.id==='flashbang'&&n.t>1.6){scene.remove(n.mesh);S.nades.splice(i,1);popFlash(n);}
    else if(n.id==='decoy'){if(!n.dc&&(n.t>3||(n.landY!==undefined&&Math.hypot(n.vel.x,n.vel.z)<0.8)))startDecoy(n);if(n.dc&&updateDecoy(n,dt)){scene.remove(n.mesh);S.nades.splice(i,1);boom(n.pos,0.7);sfx('boom',0.3,n.pos);}}
    else if(n.id==='firebomb'){if(n.landY!==undefined&&n.fuse===undefined)n.fuse=n.t+0.9;if((n.fuse!==undefined&&n.t>=n.fuse)||n.t>2.6){scene.remove(n.mesh);S.nades.splice(i,1);explodeFirebomb(n);}}
  }
  updateFires(dt);
  updateSmokes(dt);
}
function explodeHE(n){
  boom(n.pos,3.5);shrapnel(n);blastPush(n.pos,6.5,8);barrelsBlast(n.pos,6,n.owner);winsBlast(n.pos,6);const d0=player.pos.distanceTo(n.pos);nadeAudio('he',n.pos);if(!playHZ('nade:he',d0>38?0.8:1.15,d0>38?0.92:1,n.pos)&&!(d0>38?npkPlay('hegrenade/hegrenade_explode_distant',0.8):npkPlay('hegrenade/hegrenade_explode',1.3,n.pos)))sfx('boom',1,n.pos);
  if(n.visual||NET.role==='client'||!n.owner)return;
  for(const e of S.ents){if(!e.alive)continue;const eye=new V3(e.pos.x,e.pos.y+1.0,e.pos.z),d=eye.distanceTo(n.pos);if(d>7)continue;
    if(e!==n.owner&&e.team===n.owner.team&&S.mode!=='ffa'&&S.mode!=='br')continue;
    const dir=eye.clone().sub(n.pos).normalize();raycaster.set(n.pos,dir);raycaster.far=d;const hit=raycaster.intersectObjects(worldMeshes,false);raycaster.far=Infinity;if(hit.length)continue;
    damage(e,98*(1-d/7),n.owner,'he',false);}
}
function blastPush(pos,R,F){for(const e of S.ents){const dx=e.pos.x-pos.x,dy=e.pos.y+0.9-pos.y,dz=e.pos.z-pos.z,d=Math.hypot(dx,dy,dz);if(d>R||d<0.01)continue;const k=(1-d/R)*F;
    if(e===player&&e.alive){e.vel.x+=dx/d*k;e.vel.z+=dz/d*k;e.vel.y=Math.max(e.vel.y,Math.max(0,dy/d)*k*0.5+k*0.25);e.onGround=false;shake(0.5*(1-d/R));}
    else if(!e.alive){e.slideV=(e.slideV||new V3()).add(new V3(dx/d*k*0.6,0,dz/d*k*0.6));}
    else if(!e.isNet&&!e.isPlayer){e.kbV=new V3(dx/d*k*0.5,0,dz/d*k*0.5);}}}
function shrapnel(n){const o=n.pos.clone();o.y=Math.max(o.y,0.25);
  for(let i=0;i<22;i++){const a=Math.random()*Math.PI*2,el=Math.random()*0.9-0.15,dir=new V3(Math.cos(a)*Math.cos(el),Math.sin(el),Math.sin(a)*Math.cos(el));
    raycaster.set(o,dir);raycaster.far=11;const h=raycaster.intersectObjects(worldMeshes,false)[0];raycaster.far=Infinity;const L=h?h.distance:5+Math.random()*6;
    tracer(o,o.clone().addScaledVector(dir,L),SHRAP);if(h&&Math.random()<0.4)decal(h.point,h.face&&h.face.normal);}
  if(n.visual||NET.role==='client'||!n.owner)return;
  for(const e of S.ents){if(!e.alive)continue;const eye=new V3(e.pos.x,e.pos.y+1.0,e.pos.z),d=eye.distanceTo(o);if(d<=7||d>12)continue;
    if(e!==n.owner&&e.team===n.owner.team&&S.mode!=='ffa'&&S.mode!=='br')continue;
    const dir=eye.clone().sub(o).normalize();raycaster.set(o,dir);raycaster.far=d;const hit=raycaster.intersectObjects(worldMeshes,false);raycaster.far=Infinity;if(hit.length)continue;
    if(Math.random()<0.75)damage(e,6+Math.random()*10*(1-(d-7)/5),n.owner,'he',false);}}
/* ---- fire: molotov / incendiary / fire bomb ---- */
const SHRAP=new THREE.LineBasicMaterial({color:0xffd27a,transparent:true,opacity:0.85});
const FIRE_TEX=canvasTex(64,(x,s)=>{x.clearRect(0,0,s,s);const g=x.createRadialGradient(s/2,s*0.62,1,s/2,s*0.6,s/2);g.addColorStop(0,'rgba(255,250,200,1)');g.addColorStop(0.25,'rgba(255,200,70,.95)');g.addColorStop(0.55,'rgba(255,90,20,.6)');g.addColorStop(1,'rgba(120,20,0,0)');x.fillStyle=g;x.beginPath();x.moveTo(s*0.5,0);x.quadraticCurveTo(s*0.95,s*0.55,s*0.5,s);x.quadraticCurveTo(s*0.05,s*0.55,s*0.5,0);x.fill();});
const FIRE_MAT=new THREE.SpriteMaterial({map:FIRE_TEX,blending:THREE.AdditiveBlending,depthWrite:false,transparent:true});

/* ===== VFX v2: layered explosions (flash · fireball · smoke · shockwave · debris) and richer fire (core/tips · glow · smoke · embers) ===== */
const FX_BALL=canvasTex(64,(x,S)=>{x.clearRect(0,0,S,S);const g=x.createRadialGradient(S/2,S/2,0,S/2,S/2,S/2);g.addColorStop(0,'rgba(255,255,255,1)');g.addColorStop(0.35,'rgba(255,255,255,.75)');g.addColorStop(0.7,'rgba(255,255,255,.2)');g.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=g;x.fillRect(0,0,S,S);});
const FX_SMOKE=canvasTex(128,(x,S)=>{x.clearRect(0,0,S,S);for(let i=0;i<46;i++){const ang=Math.random()*6.28,rr=Math.pow(Math.random(),0.7)*S*0.3;const r=S*(0.06+Math.random()*0.14),cx=S/2+Math.cos(ang)*rr,cy=S/2+Math.sin(ang)*rr;const g=x.createRadialGradient(cx,cy,0,cx,cy,r);const v=150+Math.random()*105|0;const a=0.25+Math.random()*0.45;g.addColorStop(0,`rgba(${v},${v},${v},${a})`);g.addColorStop(0.6,`rgba(${v},${v},${v},${a*0.5})`);g.addColorStop(1,`rgba(${v},${v},${v},0)`);x.fillStyle=g;x.fillRect(0,0,S,S);}});
const FX_FIREBALL=canvasTex(64,(x,S)=>{x.clearRect(0,0,S,S);const g=x.createRadialGradient(S/2,S/2,0,S/2,S/2,S/2);g.addColorStop(0,'rgba(255,250,220,1)');g.addColorStop(0.3,'rgba(255,200,90,1)');g.addColorStop(0.6,'rgba(240,110,30,.85)');g.addColorStop(0.85,'rgba(150,40,10,.35)');g.addColorStop(1,'rgba(80,20,5,0)');x.fillStyle=g;x.fillRect(0,0,S,S);});FX_FIREBALL.wrapS=FX_FIREBALL.wrapT=THREE.ClampToEdgeWrapping;
const FX_RING=canvasTex(128,(x,S)=>{x.clearRect(0,0,S,S);const g=x.createRadialGradient(S/2,S/2,S*0.3,S/2,S/2,S/2);g.addColorStop(0,'rgba(255,255,255,0)');g.addColorStop(0.75,'rgba(255,230,200,.85)');g.addColorStop(0.88,'rgba(255,200,140,.35)');g.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=g;x.fillRect(0,0,S,S);});
for(const t of[FX_BALL,FX_SMOKE,FX_RING]){t.wrapS=t.wrapT=THREE.ClampToEdgeWrapping;}
const FX_PLANE=new THREE.PlaneGeometry(1,1);const FX_DEBRIS=new THREE.BoxGeometry(0.12,0.08,0.1);
function fxN(n){return Math.max(1,Math.round(n*(typeof fxMul==='function'?fxMul():1)));}
/* generic animated sprite/mesh: grows s0→s1 with ease-out, fades, drifts, tints c0→c1 */
function fxSpr(o){const add=o.add!==false;const mat=new THREE.SpriteMaterial({map:o.tex||FX_BALL,color:o.c0||0xffffff,transparent:true,depthWrite:false,blending:add?THREE.AdditiveBlending:THREE.NormalBlending,fog:!add,opacity:0});
  const m=new THREE.Sprite(mat);m.position.copy(o.pos);m.scale.setScalar(o.s0||0.1);if(o.rot!==undefined)mat.rotation=o.rot;scene.add(m);
  S.fx.push({kind:'spr',m,life:o.life,L:o.life,s0:o.s0||0.1,s1:o.s1||1,o0:o.o0??1,fi:o.fadeIn||0.06,pw:o.pw||1.4,vel:o.vel||new V3(),drag:o.drag||0,rise:o.rise||0,c0:o.c0!==undefined?new THREE.Color(o.c0):null,c1:o.c1!==undefined?new THREE.Color(o.c1):null,spin:o.spin||0,delay:o.delay||0});return m;}
function fxGround(pos,tex,col,s0,s1,life,o0,add=true){const mat=new THREE.MeshBasicMaterial({map:tex,color:col,transparent:true,depthWrite:false,blending:add?THREE.AdditiveBlending:THREE.NormalBlending,opacity:0,fog:false,polygonOffset:true,polygonOffsetFactor:-2});
  const m=new THREE.Mesh(FX_PLANE,mat);m.rotation.x=-Math.PI/2;m.position.set(pos.x,(pos.groundY??0)+0.05,pos.z);m.scale.setScalar(s0);scene.add(m);
  S.fx.push({kind:'spr',m,life,L:life,s0,s1,o0,fi:0.02,pw:1.2,vel:new V3(),drag:0,rise:0,c0:null,c1:null,spin:0,delay:0});return m;}
function fxTickSpr(f,dt){if(f.delay>0){f.delay-=dt;f.life+=dt;f.m.material.opacity=0;return;}
  const k=clamp(1-f.life/f.L,0,1);const e=1-Math.pow(1-k,2.6);const sc=f.s0+(f.s1-f.s0)*e;
  if(f.m.isSprite)f.m.scale.set(sc,sc,1);else f.m.scale.set(sc,sc,1);
  const fin=f.fi>0?Math.min(1,k*f.L/f.fi):1;f.m.material.opacity=f.o0*fin*Math.pow(1-k,f.pw);
  if(f.c0&&f.c1)f.m.material.color.copy(f.c0).lerp(f.c1,Math.min(1,k*1.4));
  if(f.drag)f.vel.multiplyScalar(Math.exp(-f.drag*dt));f.vel.y+=f.rise*dt;f.m.position.addScaledVector(f.vel,dt);
  if(f.spin&&f.m.isSprite)f.m.material.rotation+=f.spin*dt;}
function fxDebris(pos,n,spd){for(let i=0;i<n;i++){const m=new THREE.Mesh(FX_DEBRIS,pm(Math.random()<0.5?0x2a2622:Math.random()<0.5?0x4a4038:0x6b5a44));m.position.copy(pos);const dsc=0.5+Math.random()*1.3;m.scale.setScalar(dsc);m.position.y=Math.max(0.2,pos.y);m.rotation.set(Math.random()*3,Math.random()*3,0);scene.add(m);
  const a=Math.random()*Math.PI*2,u=0.35+Math.random()*0.65;S.fx.push({kind:'deb',m,s:dsc,life:1.2+Math.random()*0.8,v:new V3(Math.cos(a)*spd*u,2.5+Math.random()*spd*0.9,Math.sin(a)*spd*u),spin:new V3(Math.random()*12,Math.random()*12,0)});}}
/* ===== VFX v3 (0.93): procedural textures — turbulent fireballs, billowing smoke, flame tongues, embers, scorch, glare ===== */
const FXT={ready:false,smoke:[],fire:[],flame:[],ember:null,scorch:null,rays:null,flameMats:null};
const FXO={flash:0,burn:0};
function _nh(x,y,s){let h=Math.imul(x|0,374761393)+Math.imul(y|0,668265263)+Math.imul(s|0,1274126177);h=Math.imul(h^(h>>>13),1274126177);h^=h>>>16;return(h>>>0)/4294967295;}
function _vn(x,y,s){const ix=Math.floor(x),iy=Math.floor(y),fx=x-ix,fy=y-iy,u=fx*fx*(3-2*fx),v=fy*fy*(3-2*fy);const a=_nh(ix,iy,s),b=_nh(ix+1,iy,s),c=_nh(ix,iy+1,s),d=_nh(ix+1,iy+1,s);return a+(b-a)*u+(c-a)*v+(a-b-c+d)*u*v;}
function _fb(x,y,s,o){let a=0.5,t=0,f=1;for(let i=0;i<o;i++){t+=a*_vn(x*f,y*f,s+i*31);f*=2.07;a*=0.5;}return t/(1-Math.pow(0.5,o));}
function _ss(a,b,x){const t=Math.min(1,Math.max(0,(x-a)/(b-a)));return t*t*(3-2*t);}
function _ramp(t,st,o){for(let i=1;i<st.length;i++){if(t<=st[i][0]||i===st.length-1){const a=st[i-1],b=st[i],k=Math.min(1,Math.max(0,(t-a[0])/((b[0]-a[0])||1)));o[0]=a[1]+(b[1]-a[1])*k;o[1]=a[2]+(b[2]-a[2])*k;o[2]=a[3]+(b[3]-a[3])*k;return;}}}
function _mkT(N,fn){const c=document.createElement('canvas');c.width=c.height=N;const x=c.getContext('2d'),im=x.createImageData(N,N),d=im.data;const o=[0,0,0,0];
  for(let j=0;j<N;j++)for(let i=0;i<N;i++){o[0]=o[1]=o[2]=o[3]=0;fn((i+0.5)/N*2-1,(j+0.5)/N*2-1,o);const k=(j*N+i)*4;d[k]=o[0];d[k+1]=o[1];d[k+2]=o[2];d[k+3]=o[3];}
  x.putImageData(im,0,0);const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.ClampToEdgeWrapping;return t;}
const FIRE_RAMP=[[0,90,22,6],[0.18,170,45,10],[0.4,235,95,20],[0.62,255,165,45],[0.82,255,222,125],[1,255,250,225]];
function _texSmoke(s){return _mkT(128,(x,y,o)=>{const r=Math.hypot(x,y);const n=_fb(x*2.1+s*7.3,y*2.1+s*3.1,s*13+1,4),w=_fb(x*4.3-s*1.7,y*4.3+s*2.9,s*13+9,3);
  let a=1-_ss(0.22,1.0,r+(n-0.5)*0.85);a*=1-_ss(0.8,0.98,r);a*=0.72+0.5*w;
  const lit=0.74+0.26*Math.max(-1,Math.min(1,-(x*0.55+y*0.8)/(r+0.35)));const g=Math.min(255,236*lit*(0.84+0.3*w));o[0]=g;o[1]=g;o[2]=Math.min(255,g*1.02);o[3]=Math.min(1,a)*255;});}
function _texSmokeD(s){return _mkT(128,(x,y,o)=>{const r=Math.hypot(x,y);const n=_fb(x*2.0+s*5.3,y*2.0+s*6.1,s*17+2,4),w=_fb(x*4.1-s*2.7,y*4.1+s*1.9,s*17+7,3);
  let a=1-_ss(0.5,0.96,r+(n-0.5)*0.55);a*=1-_ss(0.86,0.99,r);a=Math.min(1,a*1.15);
  const sh=Math.max(-1,Math.min(1,-(x*0.5+y*0.85)/(r+0.25))),lit=0.66+0.34*(0.5+0.5*sh)*(0.55+0.45*Math.min(1,r*1.6));const g=Math.min(255,255*lit*(0.8+0.26*w));o[0]=g;o[1]=g;o[2]=Math.min(255,g*1.01);o[3]=Math.min(1,a)*255;});}
function _texFire(s){return _mkT(128,(x,y,o)=>{const r=Math.hypot(x,y);const n=_fb(x*2.4+s*5.1,y*2.4+s*8.3,s*7+3,4),m=_fb(x*5.2+s,y*5.2-s*2,s*7+11,3);
  const d=(1-_ss(0.08,1.0,r+(n-0.5)*0.95))*(1-_ss(0.82,0.98,r));const t=Math.max(0,Math.min(1,d*(0.55+0.75*(1-r))*(0.75+0.5*m)));_ramp(t,FIRE_RAMP,o);o[3]=_ss(0.02,0.32,d)*255;});}
function _texFlame(s){return _mkT(64,(x,y,o)=>{const h=(1-y)/2;const wp=(_fb(x*1.5+s*4.3,h*3.1-s*1.9,s*5+5,3)-0.5)*0.9*(0.15+h);const xx=x+wp;
  const wd=0.8*Math.pow(Math.max(0,1-h),0.7)*(0.45+0.55*Math.min(1,h*6));const e=Math.abs(xx)/Math.max(0.03,wd);
  let d=(1-_ss(0.25,1.0,e))*(1-_ss(0.62,0.97,h))*_ss(0.0,0.08,h);d*=0.75+0.5*_fb(x*3+s,h*6-s,s*5+8,2);
  const t=Math.max(0,Math.min(1,d*(1.05-0.8*h)*(1-0.45*e)));_ramp(t,FIRE_RAMP,o);o[3]=Math.min(1,d*1.2)*255;});}
function _texEmber(){return _mkT(128,(x,y,o)=>{const r=Math.hypot(x,y);const sc=5.5,px=(x*0.5+0.5)*sc,py=(y*0.5+0.5)*sc,ix=Math.floor(px),iy=Math.floor(py);let f1=9,f2=9;
  for(let j=-1;j<=1;j++)for(let i=-1;i<=1;i++){const cx=ix+i+_nh(ix+i,iy+j,3),cy=iy+j+_nh(ix+i,iy+j,7),dd=Math.hypot(px-cx,py-cy);if(dd<f1){f2=f1;f1=dd;}else if(dd<f2)f2=dd;}
  const n=_fb(x*3.2,y*3.2,5,3),rad=1-_ss(0.4,0.97,r+(n-0.5)*0.3);const crack=(1-_ss(0.0,0.17,f2-f1))*(0.4+0.6*n);const glow=0.22+0.4*n;
  const a=Math.min(1,crack*0.95+glow*0.55)*rad;_ramp(Math.min(1,crack*0.8+0.25),[[0,170,30,0],[0.5,255,95,15],[1,255,205,90]],o);o[3]=a*255;});}
function _texScorch(){return _mkT(128,(x,y,o)=>{const r=Math.hypot(x,y),ang=Math.atan2(y,x);const n=_fb(x*2.6,y*2.6,21,4),st=_fb(Math.cos(ang)*1.6+3,Math.sin(ang)*1.6+3,22,3);
  const rr=r*(0.8+0.45*n)*(0.85+0.35*st);const a=(1-_ss(0.3,1.0,rr))*(1-_ss(0.88,0.99,r)),core=1-_ss(0.0,0.55,rr);
  o[0]=12+14*n;o[1]=9+10*n;o[2]=6+6*n;o[3]=a*(0.5+0.5*core)*255;});}
function _texRays(){return _mkT(128,(x,y,o)=>{const r=Math.hypot(x,y),ang=Math.atan2(y,x);const ray=Math.pow(Math.abs(Math.sin(ang*5+_fb(Math.cos(ang)+2,Math.sin(ang)+2,31,2)*4)),8);
  const a=Math.min(1,Math.exp(-r*r*9)+ray*Math.exp(-r*2.6)*0.85)*(1-_ss(0.75,0.99,r));o[0]=255;o[1]=238;o[2]=200;o[3]=a*255;});}
function fxTexInit(){if(FXT.ready)return;FXT.ready=true;try{
  FXT.smoke=[0,1,2].map(_texSmoke);FXT.smokeD=[0,1,2].map(_texSmokeD);FXT.fire=[0,1,2].map(_texFire);FXT.flame=[0,1,2,3].map(_texFlame);FXT.ember=_texEmber();FXT.scorch=_texScorch();FXT.rays=_texRays();
  FXT.flameMats=[[0xffb060,0.92,0],[0xffd890,0.9,1],[0xff6a28,0.8,1]].map(([c,op,ad])=>FXT.flame.map(t=>new THREE.SpriteMaterial({map:t,color:c,opacity:op,blending:ad?THREE.AdditiveBlending:THREE.NormalBlending,depthWrite:false,transparent:true})));
  SCORCH.map=FXT.scorch;SCORCH.color.setHex(0xffffff);SCORCH.opacity=0.95;SCORCH.needsUpdate=true;
}catch(e){FXT.smoke=[FX_SMOKE];FXT.smokeD=[FX_SMOKE];FXT.fire=[FX_FIREBALL];FXT.flame=[FIRE_TEX];FXT.ember=FX_BALL;FXT.rays=FX_BALL;FXT.flameMats=[[FIRE_MAT],[FIRE_CORE],[FIRE_TIP]];}}
setTimeout(()=>{const go=()=>{try{fxTexInit();}catch(e){}};if(window.requestIdleCallback)requestIdleCallback(go,{timeout:6000});else go();},2500);
const _rp=a=>a[(Math.random()*a.length)|0];
/* streak sparks: short glowing lines that fly, fall and bounce */
const SPK_MAT=new THREE.LineBasicMaterial({color:0xffc466,transparent:true,opacity:0.95,blending:THREE.AdditiveBlending,depthWrite:false,fog:false});
function fxSparks(pos,n,spd){for(let i=0;i<n;i++){const arr=new Float32Array(6);for(let k=0;k<6;k++)arr[k]=k%3===0?pos.x:k%3===1?pos.y:pos.z;const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(arr,3));
  const l=new THREE.Line(g,SPK_MAT);l.frustumCulled=false;scene.add(l);const a=Math.random()*6.283,u=0.3+Math.random()*0.7,el=Math.random();
  S.fx.push({kind:'spk',m:l,p:pos.clone(),v:new V3(Math.cos(a)*spd*u*(1-el*0.5),1.5+spd*(0.25+el*0.6)*Math.random(),Math.sin(a)*spd*u*(1-el*0.5)),life:0.45+Math.random()*0.75});}}
function fxSparkTick(f,dt){f.v.y-=11*dt;f.v.multiplyScalar(Math.exp(-0.7*dt));f.p.addScaledVector(f.v,dt);const gy=groundAt(f.p.x,f.p.z,f.p.y,0)+0.03;if(f.p.y<gy){f.p.y=gy;f.v.y*=-0.35;f.v.x*=0.6;f.v.z*=0.6;}
  const tl=0.06*(f.life<0.2?Math.max(0,f.life)/0.2:1),a=f.m.geometry.attributes.position.array;a[0]=f.p.x;a[1]=f.p.y;a[2]=f.p.z;a[3]=f.p.x-f.v.x*tl;a[4]=f.p.y-f.v.y*tl;a[5]=f.p.z-f.v.z*tl;f.m.geometry.attributes.position.needsUpdate=true;}
/* the explosion itself — BGMI-style: glare · turbulent fireball · dust ring · shock ring · smoke column · scorch · debris · sparks */
function boomFX(pos,size){fxTexInit();const R=Math.random;const P=pos.clone();const gy=typeof groundAt==='function'?groundAt(P.x,P.z,P.y+0.5,0):0;P.groundY=gy;const c=P.clone();c.y=Math.max(gy+0.5,P.y);const big=size>=2;
  // 1 flash: starburst glare + white-hot core
  fxSpr({tex:FXT.rays,pos:c,s0:size*1.1,s1:size*4.4,life:0.22,o0:1,fadeIn:0.01,pw:1.2,rot:R()*6.28,spin:1.4});
  fxSpr({pos:c,s0:size*1.2,s1:size*3.4,life:0.15,o0:1,c0:0xffffff,c1:0xffd070,fadeIn:0.01,pw:1.6});
  // 2 turbulent fireball (white → orange → glowing brown), rolling upwards
  const nb=fxN(big?11:6);for(let i=0;i<nb;i++){const off=new V3(R()-0.5,R()*0.9,R()-0.5).multiplyScalar(size*0.7);
    fxSpr({tex:_rp(FXT.fire),add:false,pos:c.clone().add(off),s0:size*0.5,s1:size*(1.15+R()*0.8),life:0.55+R()*0.45,o0:1,c0:0xffffff,c1:0x4a3226,vel:off.clone().multiplyScalar(3).add(new V3(0,1.8,0)),drag:3.2,rise:2.0,fadeIn:0.005,pw:1.6,rot:R()*6.28,spin:(R()-0.5)*2.4});}
  for(let i=0;i<fxN(3);i++)fxSpr({tex:FXT.fire[i%FXT.fire.length],pos:c.clone().add(new V3((R()-0.5)*size*0.4,R()*size*0.4,(R()-0.5)*size*0.4)),s0:size*0.7,s1:size*1.6,life:0.34,o0:0.9,fadeIn:0.005,pw:1.3,rot:R()*6.28});
  // 3 thick smoke column that billows up and lingers
  const ns=fxN(big?20:9);for(let i=0;i<ns;i++){const h=R();const off=new V3((R()-0.5)*1.1,h*1.4,(R()-0.5)*1.1).multiplyScalar(size*0.55);
    fxSpr({tex:_rp(FXT.smoke),add:false,pos:c.clone().add(off),s0:size*0.45,s1:size*(1.25+R()*0.9),life:3.0+R()*2.4,o0:0.85,c0:0x2c2622,c1:0x8a847d,vel:new V3(off.x*2.2,1.2+h*2.4+R()*1.2,off.z*2.2),drag:1.4,rise:0.35,fadeIn:0.18,pw:1.5,delay:0.06+R()*0.35,rot:R()*6.28,spin:(R()-0.5)*0.5});}
  // 4 ground dust ring kicked outwards + shockwaves
  const nd=fxN(big?16:7);for(let i=0;i<nd;i++){const a=(i/nd)*6.283+R()*0.4,sp=size*(1.8+R()*1.2);
    fxSpr({tex:_rp(FXT.smoke),add:false,pos:new V3(P.x+Math.cos(a)*0.4,gy+0.3+R()*0.3,P.z+Math.sin(a)*0.4),s0:size*0.5,s1:size*(1.3+R()*0.8),life:1.5+R()*1.0,o0:0.7,c0:0x8f7f68,c1:0xb5a68e,vel:new V3(Math.cos(a)*sp,0.2+R()*0.5,Math.sin(a)*sp),drag:2.6,rise:0.3,fadeIn:0.08,pw:1.4,delay:R()*0.06,rot:R()*6.28,spin:(R()-0.5)*0.8});}
  fxSpr({tex:FX_RING,pos:c,s0:size*0.5,s1:size*5.0,life:0.32,o0:0.75,c0:0xfff0d8,c1:0xffc890,fadeIn:0.01,pw:1.1});
  fxGround(P,FX_RING,0xffe2b0,size*0.4,size*3.6,0.45,0.95);fxGround(P,FX_BALL,0xff8a30,size*1.4,size*2.6,0.8,0.9);
  // 5 scorch mark
  if(gy<0.2){const sc=new THREE.Mesh(GEO_SCORCH,SCORCH);sc.rotation.x=-Math.PI/2;sc.rotation.z=R()*6.28;sc.position.set(P.x,gy+0.02,P.z);sc.scale.setScalar(size*0.6);scene.add(sc);S.decals.push(sc);if(S.decals.length>80)scene.remove(S.decals.shift());}
  // 6 dirt chunks + streak sparks
  fxDebris(c,fxN(big?18:8),size*2.4);fxSparks(c,fxN(big?30:12),size*3.2);particles(c,'dust',fxN(10),size*1.2);
  // 7 screen flash when close
  if(typeof player!=='undefined'&&player.pos){const dk=clamp(1.15-player.pos.distanceTo(pos)/(size*4.2),0,1);if(dk>0)FXO.flash=Math.max(FXO.flash,dk*0.8);}}
/* molotov / incendiary ignition: glass, splash of burning fuel, flash */
const FX_SHARD=new THREE.BoxGeometry(0.07,0.012,0.05);
function fireBurst(pos,r){fxTexInit();const R=Math.random;const c=new V3(pos.x,pos.y+0.45,pos.z);const P=pos.clone();P.groundY=pos.y;
  fxSpr({pos:c,s0:r*0.5,s1:r*2.3,life:0.2,o0:1,c0:0xffffff,c1:0xffb050,fadeIn:0.01,pw:1.4});
  for(let i=0;i<fxN(8);i++){const a=R()*6.28,sp=r*(1.1+R()*1.5);fxSpr({tex:FXT.fire[i%FXT.fire.length],add:false,pos:c.clone(),s0:r*0.35,s1:r*(0.8+R()*0.6),life:0.45+R()*0.4,o0:1,c0:0xffffff,c1:0x7a3a20,vel:new V3(Math.cos(a)*sp,1.2+R()*2.6,Math.sin(a)*sp),drag:2.8,rise:1.4,fadeIn:0.01,pw:1.6,rot:R()*6.28,spin:(R()-0.5)*2});}
  for(let i=0;i<fxN(4);i++)fxSpr({tex:_rp(FXT.smoke),add:false,pos:c.clone().add(new V3((R()-0.5)*r*0.6,0.6,(R()-0.5)*r*0.6)),s0:r*0.4,s1:r*(1.0+R()*0.5),life:2.2+R(),o0:0.6,c0:0x231d19,c1:0x6b655f,vel:new V3((R()-0.5)*1.2,2.2+R(),(R()-0.5)*1.2),drag:1.2,fadeIn:0.15,pw:1.5,delay:0.1+R()*0.2,rot:R()*6.28});
  fxGround(P,FX_BALL,0xff7a22,r*1.0,r*3.2,0.55,0.9);fxSparks(c,fxN(16),r*2.2);
  for(let i=0;i<fxN(10);i++){const m=new THREE.Mesh(FX_SHARD,pm(0xcfe6ea,{transparent:true,opacity:0.75}));m.position.copy(c);m.rotation.set(R()*3,R()*3,0);scene.add(m);const a=R()*6.283,sp=2+R()*3.5;
    S.fx.push({kind:'deb',m,life:0.8+R()*0.6,v:new V3(Math.cos(a)*sp,1.5+R()*3,Math.sin(a)*sp),spin:new V3(R()*20,R()*20,0)});}}

/* fire upgrade materials */
const FIRE_CORE=new THREE.SpriteMaterial({map:FIRE_TEX,color:0xfff2b8,blending:THREE.AdditiveBlending,depthWrite:false,transparent:true});
const FIRE_TIP=new THREE.SpriteMaterial({map:FIRE_TEX,color:0xff5a1e,blending:THREE.AdditiveBlending,depthWrite:false,transparent:true,opacity:0.8});
function fireExtras(f){fxTexInit();const g=new THREE.Mesh(FX_PLANE,new THREE.MeshBasicMaterial({map:FX_BALL,color:0xff7a22,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,opacity:0.55,fog:false}));
  g.rotation.x=-Math.PI/2;g.position.set(f.pos.x,f.pos.y+0.04,f.pos.z);g.scale.setScalar(f.r*3.2);scene.add(g);f.glow=g;
  const e=new THREE.Mesh(FX_PLANE,new THREE.MeshBasicMaterial({map:FXT.ember,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,opacity:0,fog:false,polygonOffset:true,polygonOffsetFactor:-3}));
  e.rotation.x=-Math.PI/2;e.rotation.z=Math.random()*6.28;e.position.set(f.pos.x,f.pos.y+0.045,f.pos.z);e.scale.setScalar(f.r*2.25);scene.add(e);f.emb=e;
  f.smT=0;f.emT=0;f.crT=0.2;if(!f.gen)f.roar=fireRoarStart(f);}
function fireTick(f,dt,k){if(f.glow){f.glow.material.opacity=k*(0.45+0.15*Math.sin(S.time*17+f.pos.x)+0.08*Math.sin(S.time*41));}
  if(f.emb)f.emb.material.opacity=Math.min(1,k*1.15)*(0.78+0.22*Math.sin(S.time*7+f.pos.z*3));
  fireRoarTick(f,k);
  if(k<0.05)return;const lowfx=typeof fxMul==='function'&&fxMul()<1;
  f.crT-=dt;if(f.crT<=0){f.crT=0.28+Math.random()*0.22;if(!f.gen)fireCrackle(f.pos,k);}
  f.smT-=dt;if(f.smT<=0){f.smT=(f.gen?1.1:0.3)*(lowfx?2:1);const a=Math.random()*6.28,d=Math.random()*f.r*0.7;
    fxSpr({tex:_rp(FXT.smoke),add:false,pos:new V3(f.pos.x+Math.cos(a)*d,f.pos.y+1.3,f.pos.z+Math.sin(a)*d),s0:0.8,s1:2.6+Math.random()*1.2,life:3.0+Math.random()*1.4,o0:0.42*k,c0:0x2a2420,c1:0x77716b,vel:new V3((Math.random()-0.5)*0.4,1.6+Math.random()*0.7,(Math.random()-0.5)*0.4),rise:0.25,fadeIn:0.35,pw:1.5,rot:Math.random()*6.28,spin:(Math.random()-0.5)*0.5});}
  f.emT-=dt;if(f.emT<=0){f.emT=(f.gen?0.25:0.06)*(lowfx?2.5:1);const a=Math.random()*6.28,d=Math.random()*f.r;
    fxSpr({pos:new V3(f.pos.x+Math.cos(a)*d,f.pos.y+0.3,f.pos.z+Math.sin(a)*d),s0:0.07+Math.random()*0.05,s1:0.03,life:0.9+Math.random()*0.9,o0:1,c0:0xffd27a,c1:0xff4010,vel:new V3((Math.random()-0.5)*0.9,1.8+Math.random()*1.8,(Math.random()-0.5)*0.9),rise:-0.6,fadeIn:0.02,pw:0.8});}}
function fireDispose(f){if(f.glow){scene.remove(f.glow);f.glow.material.dispose();f.glow=null;}if(f.emb){scene.remove(f.emb);f.emb.material.dispose();f.emb=null;}fireRoarStop(f);}
const SCORCH=new THREE.MeshBasicMaterial({color:0x140c06,transparent:true,opacity:0.55,depthWrite:false});
const GEO_SCORCH=new THREE.CircleGeometry(1,20);
function inSmoke(pos,r){return S.smokes.some(sm=>sm.age>0.3&&Math.hypot(sm.pos.x-pos.x,sm.pos.z-pos.z)<sm.r+r*0.5);}
function igniteAt(n,y,wid,r,life,gen=0){const pos=new V3(n.pos.x,y+0.02,n.pos.z);if(!S.fires)S.fires=[];
  if(inSmoke(pos,r)){particles(pos,'dust',10,2);sfx('hiss',0.8,pos);return null;}
  const f={pos,r,age:0,life,owner:n.owner,visual:n.visual,wid,gen,spreadT:0.8,tick:0,snd:0,sprites:[],scorch:null};
  const sc=new THREE.Mesh(GEO_SCORCH,SCORCH);sc.rotation.x=-Math.PI/2;sc.position.copy(pos);sc.position.y+=0.015;sc.scale.setScalar(r*0.95);scene.add(sc);f.scorch=sc;
  fxTexInit();const N=Math.round((gen?10+r*6:14+r*8)*(typeof fxMul==='function'?Math.max(0.6,fxMul()):1));for(let i=0;i<N;i++){const lay=i%5===0?'core':i%7===3?'tip':'main';const li=lay==='core'?1:lay==='tip'?2:0,vi=(Math.random()*4)|0;const sp=new THREE.Sprite((FXT.flameMats[li]||FXT.flameMats[0])[vi%FXT.flameMats[0].length]);const a=Math.random()*Math.PI*2,d=Math.sqrt(Math.random())*r*(lay==='core'?0.6:0.95);
    sp.userData={x:pos.x+Math.cos(a)*d,z:pos.z+Math.sin(a)*d,h:(lay==='core'?0.7:lay==='tip'?1.5:0.95)+Math.random()*(lay==='tip'?1.6:1.3),ph:Math.random()*10,li,vi,sw:Math.random()*0.1};sp.position.set(sp.userData.x,pos.y,sp.userData.z);sp.scale.set(0.01,0.01,1);scene.add(sp);f.sprites.push(sp);}
  fireExtras(f);
  if(gen===0){fireBurst(pos,r);nadeAudio('molly',pos);if(!playHZ('nade:fire0',1.0,1,pos)&&!npkPlay(wid==='incendiary'?'incendiary/incendiary_pop':'incendiary/incendiary_explode',1.1,pos))sfx('molly',1,pos);f.snd=3.0;f.fi=0;particles(pos,'spark',12,3);}S.fires.push(f);return f;}
function explodeFirebomb(n){const y=n.landY!==undefined?n.landY:0;const p=new V3(n.pos.x,y+0.3,n.pos.z);boom(p,2.2);sfx('boom',0.7,p);
  if(!n.visual&&NET.role!=='client'&&n.owner)for(const e of S.ents){if(!e.alive)continue;const d=new V3(e.pos.x,e.pos.y+1,e.pos.z).distanceTo(p);if(d<3.2&&(e===n.owner||e.team!==n.owner.team||S.mode==='ffa'))damage(e,30*(1-d/3.2),n.owner,'firebomb',false);}
  igniteAt(n,y,'firebomb',2.3,6.5);}
function clearFires(){for(const f of S.fires||[]){for(const sp of f.sprites)scene.remove(sp);scene.remove(f.scorch);fireDispose(f);}S.fires=[];}
function extinguishNear(pos,r){if(!S.fires)return;let any=false;for(const f of S.fires){if(Math.hypot(f.pos.x-pos.x,f.pos.z-pos.z)<r+f.r*0.6){f.life=Math.min(f.life,f.age+0.4);any=true;}}if(any)sfx('hiss',1,pos);}
function updateFires(dt){if(!S.fires)S.fires=[];const T=S.time;{let inF=false;if(player&&player.alive)for(const f of S.fires){if(f.age>0.2&&f.age<f.life-0.5&&Math.hypot(player.pos.x-f.pos.x,player.pos.z-f.pos.z)<f.r&&Math.abs(player.pos.y-f.pos.y)<1.2){inF=true;break;}}FXO.burn+=((inF?1:0)-FXO.burn)*Math.min(1,dt*(inF?7:2.5));}
  for(let i=S.fires.length-1;i>=0;i--){const f=S.fires[i];f.age+=dt;const grow=Math.min(1,f.age/0.35),fade=clamp((f.life-f.age)/0.8,0,1),k=grow*fade;
    const FM=FXT.flameMats;for(const sp of f.sprites){const u=sp.userData,fl=0.75+0.35*Math.sin(T*13+u.ph)+0.15*Math.sin(T*29+u.ph*2)+0.1*Math.sin(T*53+u.ph*3);const h=u.h*k*fl;sp.scale.set(h*0.8,h,1);if(FM&&u.li!==undefined){u.sw-=dt;if(u.sw<=0){u.sw=0.06+Math.random()*0.08;u.vi=(u.vi+1+(Math.random()*2|0))%FM[0].length;sp.material=(FM[u.li]||FM[0])[u.vi];}}sp.position.set(u.x+Math.sin(T*3+u.ph)*0.05,f.pos.y+h*0.45,u.z+Math.cos(T*2.6+u.ph)*0.05);}
    fireTick(f,dt,k);
    if(f.wid==='firebomb'&&f.gen<2&&f.age<4.5&&!f.visual){f.spreadT-=dt;if(f.spreadT<=0){f.spreadT=0.9+Math.random()*0.5;const a=Math.random()*Math.PI*2,d=f.r+0.9+Math.random()*1.4,x=f.pos.x+Math.cos(a)*d,z=f.pos.z+Math.sin(a)*d;
      if(Math.abs(x)<mapH&&Math.abs(z)<mapH&&!blocked(x,z,0.3)){igniteAt({pos:new V3(x,0,z),owner:f.owner,visual:f.visual},f.pos.y-0.02,'firebomb',1.7,5,f.gen+1);if(NET.role==='host')netBroadcast({t:'fire',x,z,y:f.pos.y-0.02,g:f.gen+1});}}}
    f.snd-=dt;if(f.snd<=0&&fade>0.3){if(HZB['nade:fire1']){if(f.gen===0){f.fi=(f.fi||0)^1;f.snd=2.85+Math.random()*0.2;playHZ('nade:fire'+f.fi,0.75*Math.min(1,fade+0.2),0.94+Math.random()*0.12,f.pos);}else f.snd=99;}else{f.snd=0.55+Math.random()*0.3;sfx('fire',0.55,f.pos);}}
    f.tick-=dt;if(f.tick<=0&&f.age>0.2&&fade>0.2){f.tick=0.25;
      if(!f.visual&&NET.role!=='client')for(const e of S.ents){if(!e.alive)continue;if(Math.hypot(e.pos.x-f.pos.x,e.pos.z-f.pos.z)>f.r)continue;if(Math.abs(e.pos.y-f.pos.y)>1.2)continue;
        if(f.owner&&e!==f.owner&&e.team===f.owner.team&&S.mode!=='ffa'&&S.mode!=='br')continue;
        damage(e,f.wid==='firebomb'?7:9,f.owner,f.wid,false);}}
    if(f.age>=f.life){for(const sp of f.sprites)scene.remove(sp);scene.remove(f.scorch);fireDispose(f);S.fires.splice(i,1);}}}

function deploySmoke(pos){fxTexInit();
  const s={pos:pos.clone(),gp:pos.clone(),r:4.2,age:0,meshes:[],jetT:0};s.pos.y=Math.max(1.6,pos.y+1.2);
  if(!npkPlay('smokegrenade/smoke_emit',0.75,pos))sfx('smoke');smokeAudio(pos);
  const lv=(typeof HEMI!=='undefined'&&HEMI)?clamp(HEMI.intensity/0.85,0.45,1):1;
  const n=fxN(34);for(let i=0;i<n;i++){const col=new THREE.Color(0xf4f3f0).multiplyScalar(lv*(0.92+Math.random()*0.08));
    const mat=new THREE.SpriteMaterial({map:_rp(FXT.smokeD||FXT.smoke),color:col,transparent:true,depthWrite:false,opacity:0});const m=new THREE.Sprite(mat);
    const a=Math.random()*6.283,rr=Math.sqrt(Math.random())*s.r*0.72,hy=(Math.random()-0.42)*2.8;
    m.userData={ox:Math.cos(a)*rr,oy:hy,oz:Math.sin(a)*rr,D:(4.2+Math.random()*2.4)*(n<20?1.25:1),dl:Math.random()*1.3,ph:Math.random()*6.28,fs:10.6+Math.random()*2.4,rot:Math.random()*6.28,sp:(Math.random()-0.5)*0.22};
    m.position.copy(s.gp);m.scale.set(0.01,0.01,1);mat.rotation=m.userData.rot;scene.add(m);s.meshes.push(m);}
  S.smokes.push(s);extinguishNear(s.pos,s.r);}
function updateSmokes(dt){const T=S.time,cam=camera.position;
  for(let i=S.smokes.length-1;i>=0;i--){const s=S.smokes[i];s.age+=dt;
    for(const m of s.meshes){const u=m.userData,t=Math.max(0,s.age-u.dl),e=1-Math.pow(1-Math.min(1,t/(1.5+u.dl*0.6)),3);
      const sc=Math.max(0.01,u.D*e*(1+0.04*Math.sin(T*0.7+u.ph)));m.scale.set(sc,sc,1);
      m.position.set(s.gp.x+(s.pos.x-s.gp.x)*e+u.ox*e+Math.sin(T*0.31+u.ph)*0.15,s.gp.y+(s.pos.y-s.gp.y)*e+u.oy*e+Math.min(t,8)*0.04+Math.sin(T*0.5+u.ph*2)*0.12,s.gp.z+(s.pos.z-s.gp.z)*e+u.oz*e+Math.cos(T*0.27+u.ph)*0.15);
      m.material.rotation=u.rot+u.sp*s.age;
      let op=0.96*Math.min(1,t/0.3)*clamp((u.fs+2-s.age)/2,0,1);
      const dd=Math.hypot(m.position.x-cam.x,m.position.y-cam.y,m.position.z-cam.z);if(dd<1.3)op*=clamp(dd/1.3,0.2,1);
      m.material.opacity=op;m.visible=op>0.01;}
    if(s.age<3.4){s.jetT-=dt;if(s.jetT<=0){s.jetT=(typeof fxMul==='function'&&fxMul()<1)?0.2:0.1;const a=Math.random()*6.283,sp=0.6+Math.random()*1.4;
      fxSpr({tex:_rp(FXT.smokeD||FXT.smoke),add:false,pos:new V3(s.gp.x,s.gp.y+0.2,s.gp.z),s0:0.35,s1:2.2+Math.random()*1.2,life:1.4+Math.random()*0.6,o0:0.6,c0:0xf4f2ee,c1:0xdcdad6,vel:new V3(Math.cos(a)*sp,1.3+Math.random()*1.2,Math.sin(a)*sp),drag:1.5,fadeIn:0.05,pw:1.3,rot:Math.random()*6.28,spin:(Math.random()-0.5)*0.6});}}
    if(s.age>=15){for(const m of s.meshes){scene.remove(m);m.material.dispose();}S.smokes.splice(i,1);}}}
/* screen overlays: blast flash, burning vignette + BGMI-style grenade warning markers */
function fxOverlayTick(dt){const b=$('boomO'),u=$('burnO');if(!b)return;const live=S.state==='game'&&player.alive;
  FXO.flash=Math.max(0,FXO.flash-dt*2.8);const fv=live?Math.round(FXO.flash*100)/100:0;if(b._v!==fv){b._v=fv;b.style.opacity=fv;}
  const bv=live&&FXO.burn>0.02?Math.round(FXO.burn*(0.5+0.15*Math.sin(S.time*17)+0.08*Math.sin(S.time*29))*100)/100:0;if(u._v!==bv){u._v=bv;u.style.opacity=bv;}
  nadeWarnTick();}
const NW_SVG='<svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="17" fill="rgba(150,10,10,.55)" stroke="#ff4a3a" stroke-width="2.6"/><circle cx="20" cy="23.5" r="7.2" fill="#ffe1da"/><rect x="17" y="12.5" width="6" height="5.5" rx="1.2" fill="#ffe1da"/><rect x="21.5" y="10.2" width="7.5" height="2.6" rx="1.2" fill="#ffe1da"/><circle cx="15" cy="12.6" r="2.3" fill="none" stroke="#ffe1da" stroke-width="1.6"/></svg>';
function nadeWarnTick(){const root=$('nadeW');if(!root)return;const p=player,list=[];
  if(save.nadeWarn!==false&&p.alive&&S.state==='game'&&!S.ended)for(const n of S.nades){if(n.dc||!(n.id==='he'||n.id==='molotov'||n.id==='incendiary'||n.id==='firebomb'))continue;
    const d=p.pos.distanceTo(n.pos);if(d>(n.owner===p?10:20))continue;if(n.owner===p&&n.t<0.6)continue;list.push([n,d]);}
  list.sort((a,b)=>a[1]-b[1]);
  while(root.children.length<3){const el=document.createElement('div');el.className='nw';el.innerHTML=NW_SVG+'<b></b>';el.style.display='none';root.appendChild(el);}
  for(let i=0;i<3;i++){const el=root.children[i];if(i>=list.length){if(el.style.display!=='none')el.style.display='none';continue;}
    const[n,d]=list[i];const v=n.pos.clone().project(camera);let x=v.x,y=v.y;const behind=v.z>1;if(behind){x=-x;y=-y;}
    if(behind&&Math.hypot(x,y)<0.05){x=0;y=-0.8;}let m=Math.max(Math.abs(x)/0.86,Math.abs(y)/0.8);if(behind&&m<1)m=Math.max(m,1e-4);if(m>1||behind){x/=m;y/=m;m=Math.max(m,1.01);}
    el.style.display='';el.style.left=(50+x*50)+'%';el.style.top=(50-y*50)+'%';el.classList.toggle('edge',m>1);
    const lb=Math.round(d)+'m';const bb=el.lastChild;if(bb._v!==lb){bb._v=lb;bb.textContent=lb;}}}

/* ================= PLAYER ================= */
function curW(){const s=player.inv[player.slot];return s?WEAPONS[s.id]:WEAPONS.knife;}
function giveWeapon(id,reserve){const w=WEAPONS[id];const slot=w.slot;player.inv[slot]={id,ammo:w.mag,reserve:reserve!==undefined?reserve:w.reserve};if(slot!==5||!player.inv[player.slot])switchSlot(slot,true);}
const SC_RET={
  sn:'<svg viewBox="-100 -100 200 200"><g stroke="#050505" stroke-linecap="butt"><path d="M-100 0H-34M34 0H100M0 -100V-34M0 34V100" stroke-width="2.6"/><path d="M-34 0H-1.6M1.6 0H34M0 -34V-1.6M0 1.6V34" stroke-width=".42"/></g><g fill="#050505"><circle r=".55"/>'+[8,16,24].map(d=>`<circle cx="${d}" r=".7"/><circle cx="${-d}" r=".7"/><circle cy="${d}" r=".7"/><circle cy="${-d}" r=".7"/>`).join('')+'</g></svg>',
  dm:'<svg viewBox="-100 -100 200 200"><g stroke="#0a0a0a" stroke-width=".5"><path d="M0 4V40M-40 0H-8M8 0H40"/><path d="M-3 12H3M-2.5 20H2.5M-2 28H2" stroke-width=".45"/></g><path d="M-3.4 2.6 0 -.6 3.4 2.6" fill="none" stroke="#ff3b30" stroke-width=".9" stroke-linejoin="round"/><circle r=".55" fill="#ff3b30"/></svg>',
  rd:'<svg viewBox="-50 -50 100 100"><circle r="30" fill="none" stroke="rgba(255,70,55,.55)" stroke-width="1"/><path d="M0 -30V-24M0 24V30M-30 0H-24M24 0H30" stroke="rgba(255,70,55,.7)" stroke-width="1.2"/><circle r="2" fill="#ff3b30"/></svg>'};
function scopeKind(w){return w.cat==='sniper'?'sn':w.cat==='dmr'?'dm':'rd';}
function setScoped(on){const p=player;if(p.scoped===on)return;p.scoped=on;const w=curW();camera.fov=on&&w.zoom?save.fov/w.zoom:save.fov;camera.updateProjectionMatrix();
  const el=$('scope');if(on&&w.zoom){const k=scopeKind(w);if(el.dataset.o!==k||!$('scRet').firstChild){el.dataset.o=k;$('scRet').innerHTML=SC_RET[k];}}el.classList.toggle('hidden',!on);}
function switchSlot(s,force){if(player.healT>0&&!force){if(player.healDone)return;cancelHeal(true);}if(!player.inv[s]||(!force&&s===player.slot&&player.switchT<=0))return;player.ads=false;if(s!==player.slot)player.prevSlot=player.slot;setScoped(false);player.rescope=false;player.slot=s;player.reloading=false;player.mstep=null;player.switchT=0.35;player.sprayIdx=0;const nid=player.inv[s].id,R=vm.real&&vm.real[nid];if(R&&R.anim.play('draw'))return;if(actx){const nw=WEAPONS[nid];if(nw.nade&&npkPlay(NADE_DRAW[nid]||'',0.8)){}else if(nw.melee||!realMech(nw,'draw'))mech(nw.melee?'knifedraw':'draw');}}
function startReload(){if(player.healT>0){if(player.healDone)return;cancelHeal(true);}/* R cancels a medkit instead of being ignored */
  const ws=player.inv[player.slot],w=curW();if(!ws||!w.mag||!(w.reload>0||w.shell>0)||player.reloading||ws.ammo>=w.mag)return;
  if(ws.reserve<=0){center(S.mode==='br'?'No spare ammo — loot some':'No spare ammo — find an AMMO crate',1.2);sfx('deny');return;}setScoped(false);player.reloading=true;player.reloadT=w.shell||w.reload;player.rstage=0;player.realReload=false;const R=curReal();if(R&&!w.shell){const n=ws.ammo===0&&R.anim.has('reload_empty')?'reload_empty':'reload_tactical';if(R.anim.has(n)){R.anim.play(n,R.anim.set[n].l/w.reload);player.realReload=true;}}}
function finishReload(){const p=player,ws=p.inv[p.slot],w=curW();if(!w.mag){p.reloading=false;return;}
  if(w.shell){ws.ammo++;mech('shell');if(S.mode!=='practice')ws.reserve--;if(ws.ammo<w.mag&&(ws.reserve>0||S.mode==='practice')){p.reloadT=w.shell;}else{p.reloading=false;if(w.pump)p.pumpSnd=0.12;}return;}
  p.reloading=false;const take=Math.min(w.mag-ws.ammo,ws.reserve);ws.ammo+=take;if(S.mode!=='practice')ws.reserve-=take;}
function viewDir(yaw,pitch){return new V3(-Math.sin(yaw)*Math.cos(pitch),Math.sin(pitch),-Math.cos(yaw)*Math.cos(pitch));}
function shootables(){const o=worldMeshes.slice();for(const b of S.bots)if(b.alive){for(const p of b.model.parts)o.push(p);if(b.model.hit)for(const p of b.model.hit)o.push(p);if(b.model.clsMark)for(const p of b.model.clsMark)o.push(p);}for(const t of S.targets)if(t.state==='up'||t.state==='rising')o.push(t.disc);return o;}
function shotRay(o,d,far,objs){raycaster.set(o,d);raycaster.far=far;const h=raycaster.intersectObjects(objs||shootables(),false);raycaster.far=Infinity;return h[0]||null;}
/* Inaccuracy: still = 0 (first bullet exact), movement only hurts above 34% speed; scoped snipers are exact, unscoped they're not */
function inaccuracy(){
  const p=player,w=curW();if(!w.inacc)return 0;const I=w.inacc;
  const sp=Math.hypot(p.vel.x,p.vel.z),max=wSpeed(w);
  let s=(w.zoom&&p.scoped)?I.scoped:(p.crouch>0.5?I.crouch:I.stand);
  s+=I.move*clamp((sp-max*0.34)/(max*0.66),0,1);
  if(p.onLadder)s+=I.ladder;else if(!p.onGround)s+=I.air;
  s+=I.spray*Math.min(p.sprayIdx,12);
  if(p.sprinting)s+=I.move*0.8;
  if(p.ads&&!w.zoom)s*=0.55;
  return s;
}
function canFire(){const p=player;return S.state==='game'&&p.alive&&!S.uiOpen&&!S.ended&&!(S.paused&&!NET.role)&&S.countdown<=0&&(S.locked||S.noLock)&&!(S.mode==='defuse'&&S.round&&S.round.phase==='freeze')&&p.planting<=0&&p.defusing<=0&&!p.drop;}
function tryFire(){const p=player,w=curW(),ws=p.inv[p.slot];if(p.blocking)return;if(p.healT>0){if(p.healDone)return;cancelHeal(true);}if(p.sprinting){p.sprinting=false;p.noSprintUntil=S.time+0.45;}
  if(p.reloading&&w.shell&&ws&&ws.ammo>0)p.reloading=false;
  if(canFire()&&p.cool<=0&&p.switchT<=0&&!p.reloading)fire();}
/* anti-cheat bookkeeping: every trigger pull gets an id; the hit claims quote it, plus the eye position and the exact bullet ray,
   so the host can verify them (see REF). */
const ACC={n:0,o:null};
function acShot(o){ACC.n=(ACC.n+1)&0xffff||1;ACC.o=[+o.x.toFixed(2),+o.y.toFixed(2),+o.z.toFixed(2)];}
function acDir(d){return d?[+d.x.toFixed(3),+d.y.toFixed(3),+d.z.toFixed(3)]:undefined;}
function applyHit(e,dmg,wid,head,pt,dir){
  dmgNumber(pt,dmg,head);anHit(wid,head);
  if(NET.role==='client'){{let d=dmg;if(e.armor>0)d-=Math.min(e.armor,d*0.5);if(typeof e.hp==='number'&&e.hp>0)d=Math.min(d,e.hp);anDmg(wid,d);}hitmarker(head,false);sfx(head?'head':'hit');netToHost({t:'hit',id:e.id,d:Math.round(dmg*10)/10,h:!!head,w:wid,s:ACC.n,o:ACC.o,dr:acDir(dir)});return;}
  damage(e,dmg,player,wid,head);
}
function fire(){
  const p=player,w=curW(),ws=p.inv[p.slot];
  if(w.nade){throwNade(ws.id);return;}
  const o=camera.position.clone();
  if(p.tp&&p.tpEye){const f0=viewDir(p.yaw,p.pitch);o.addScaledVector(f0,p.tpEye.clone().sub(o).dot(f0));}
  if(w.taser){p.cool=1;acShot(o);sfx('zeus');p.shots++;anShot(w.id);const d=viewDir(p.yaw,p.pitch);const h=shotRay(o,d,w.range);const end=h?h.point:o.clone().addScaledVector(d,w.range);tracer(o.clone().addScaledVector(d,0.4).add(new V3(0,-0.1,0)),end,ZAP);
    if(h&&h.object.userData.ent){const e=h.object.userData.ent;if(e.team!==p.team){p.hits++;applyHit(e,w.dmg,'zeus',false,h.point,d);particles(h.point,'spark',8,3);}}
    p.inv[5]=null;switchSlot(p.inv[1]?1:2);return;}
  if(w.melee){p.cool=Math.max(p.cool,0)+w.rate;p.shots++;anShot(w.id,true);{const R=curReal();vm.mIdx=((vm.mIdx||0)%3)+1;if(R&&R.anim.play('melee_'+vm.mIdx,1.7)){}else if(isKatana(w.id)){if(!playHZ('ktn:swoosh'+Math.floor(Math.random()*6),0.95))sfx('kwhoosh');if(w.id==='dualkatana'){vm.kHand=1-(vm.kHand||0);if(vm.kHand){vm.kAtkL=0;vm.kComboL=((vm.kComboL||0)+1)%3;}else{vm.kAtk=0;vm.kCombo=((vm.kCombo||0)+1)%3;}}else{vm.kAtk=0;vm.kCombo=((vm.kCombo||0)+1)%3;}}else{vm.slash=1;sfx('knife');}}
    acShot(o);const vd=viewDir(p.yaw,p.pitch);const h=shotRay(o,vd,w.range);
    if(h){const e=h.object.userData.ent;if(e&&e.team!==p.team){const head=!!h.object.userData.head;p.hits++;const dx=p.pos.x-e.pos.x,dz=p.pos.z-e.pos.z,dl=Math.hypot(dx,dz)||1;const back=(Math.sin(e.yaw)*dx+Math.cos(e.yaw)*dz)/dl<-0.3;
      if(isKatana(w.id)&&!playHZ('ktn:slash',1.1))sfx('knife');
      if(back){applyHit(e,999,w.id,head,h.point,vd);sfx('backstab');center('<span style="color:#ff5a4f">BACKSTAB!</span>',0.9);shake(0.35);if(!e.alive)medal('BACKSTAB',2);}else applyHit(e,w.dmg*(head?w.head:1),w.id,head,h.point,vd);bloodHit(h.point,viewDir(p.yaw,p.pitch),head,back?1.6:0.8);}else if(h.object.userData.target)hitTarget(h.object.userData.target,h.point);}
    return;}
  if(manualOn()&&w.mag&&!w.shell&&ws.mr==='chamber'&&ws.ammo>0){sfx('empty');p.cool=Math.max(p.cool,0)+0.25;center('<kbd>R</kbd> chamber a round',0.6);return;}
  if(ws.ammo<=0){sfx('empty');p.cool=Math.max(p.cool,0)+0.25;if(ws.reserve>0&&!(manualOn()&&w.mag&&!w.shell)&&save.autoEmpty!==false)startReload();return;}
  ws.ammo--;p.cool=Math.max(p.cool,0)+w.rate;p.shots++;anShot(w.id);p.lastFire=S.time;p.lastShot=S.time;
  sfx(w.id);vm.kick=1;shotFeel(w);vm.flashT=0.05;if(w.pump){vm.pumpT=0.45;p.pumpSnd=0.28;}{const R=curReal();if(R)R.anim.play('shoot');if(w.bolt&&!R)p.boltSnd=w.rate*0.3;if(R&&ws.ammo>0&&ws.ammo<=Math.max(2,w.mag*0.2))playHZ('gp:all/lowammo_01',0.45);}ejectCasing(w);shake({sniper:0.5,shotgun:0.45,dmr:0.3,mg:0.14,rifle:0.12,smg:0.07,pistol:0.1}[w.cat]||0.1);
  const[py0,pp0]=patternAt(w,p.sprayIdx);const _rk=agentK('recoil'),py=py0*_rk,pp=pp0*_rk;
  const yaw=p.yaw-py*D2R,pitch=clamp(p.pitch+pp*D2R,-1.55,1.55);
  const f=viewDir(yaw,pitch),r=new V3(Math.cos(yaw),0,-Math.sin(yaw)),u=new V3().crossVectors(r,f);
  const spread=inaccuracy();
  const vf=viewDir(p.yaw,p.pitch),vr=new V3(Math.cos(p.yaw),0,-Math.sin(p.yaw));
  const muzzle=muzzleStart()||o.clone().addScaledVector(vf,0.7).addScaledVector(vr,0.16).add(new V3(0,-0.13,0));
  const objs=shootables();acShot(o);
  const pellets=w.pellets||1;const hitsByEnt=new Map();let lastEnd=null;
  for(let k=0;k<pellets;k++){
    const a=Math.random()*Math.PI*2,rr=Math.sqrt(Math.random())*spread,a2=Math.random()*Math.PI*2,r2=w.pellets?Math.sqrt(Math.random())*w.pelletSpread:0;
    const dir=f.clone().addScaledVector(r,Math.cos(a)*rr+Math.cos(a2)*r2).addScaledVector(u,Math.sin(a)*rr+Math.sin(a2)*r2).normalize();
    const PR=penRay(o,dir,w,objs);const h=PR.h;
    const end=h?h.point:o.clone().addScaledVector(dir,150);lastEnd=end;if(k<2)waterShot(o,end);
    if(k<3||!w.pellets)tracer(muzzle,end);
    if(!h)continue;const obj=h.object;
    if(obj.userData.ent){const e=obj.userData.ent;if(e.team!==p.team){const head=!!obj.userData.head;const dmg=w.dmg*(head?w.head:1)*rangeMul(w,h.distance)*PR.k;const cur=hitsByEnt.get(e)||{d:0,head:false};cur.d+=dmg;cur.pt=h.point;if(!cur.dir)cur.dir=dir;if(PR.pens)cur.wb=true;cur.head=cur.head||head;hitsByEnt.set(e,cur);if(!w.pellets||k<3)bloodHit(h.point,dir,head,w.pellets?0.5:1);}}
    else if(obj.userData.target){hitTarget(obj.userData.target,h.point);}
    else if(obj.userData.gloo){glooHit(obj.userData.gloo,w.dmg*(PR.k||1),h.point);}
    else if(obj.userData.barrel!==undefined){barrelHit(obj.userData.barrel,w.dmg*(PR.k||1),h.point,player);}
    else{const wn=winAt(h.point);if(wn){winBreak(wn,true);continue;}const n=h.face?h.face.normal.clone().transformDirection(obj.matrixWorld):null;decal(h.point,n);if(k<3)particles(h.point,'dust',3);}
  }
  if(NET.role)netShotFx(muzzle,lastEnd,w.id,player.id);   /* shot message first, so the host holds the credit before the hit claims arrive */
  for(const[e,v]of hitsByEnt){p.hits++;applyHit(e,v.d,w.id,v.head,v.pt,v.dir);if(v.wb){floatText(v.pt.clone().add(new V3(0,0.4,0)),'WALLBANG','#ffb020');if(!e.alive)medal('WALLBANG',2);}}
  if(GP.active){const kk=w.pellets?0.55:w.zoom?0.7:Math.min(0.45,0.12+(w.dmg||25)/160);gpRumble(kk*0.7,kk,w.zoom?150:70);}
  p.sprayIdx+=1;
  if(w.zoom&&p.scoped&&w.bolt){setScoped(false);p.rescope=true;}
  if(!(manualOn()&&w.mag&&!w.shell)&&save.autoEmpty!==false&&ws.ammo===0&&ws.reserve>0)setTimeout(()=>{if(S.state==='game'&&player.inv[player.slot]===ws)startReload();},150);
}
function spawnPrimaryId(){const id=save.spawnPrimary;const w=WEAPONS[id];return (w&&w.slot===1&&GUN_IDS.includes(id)&&(typeof gunOwned!=='function'||gunOwned(id)))?id:'ak47';}
function spawnPistolId(){const id=save.spawnPistol;const w=WEAPONS[id];return (w&&w.cat==='pistol'&&(typeof gunOwned!=='function'||gunOwned(id)))?id:'glock';}
function applySpawnPrimary(p){if(!(S.mode==='tdm'||S.mode==='ffa'||S.mode==='practice'))return;const want=spawnPrimaryId(),cur=p.inv[1]&&p.inv[1].id;if(cur&&cur!=='ak47'&&cur!=='awp'&&cur!==p._spawnGun)return;p._spawnGun=want;if(cur!==want){giveWeapon(want);if(p.slot===1)switchSlot(1,true);}}
function respawnPlayer(){const p=player;p.alive=true;p.hp=hpMax();p.healT=0;if(S.mode!=='br')p.meds=1;try{applySpawnPrimary(p);}catch(e){}p.armor=0;p.vel.set(0,0,0);p.reloading=false;p.sprayIdx=0;p.deadT=0;refillAmmo(p);giveStarterNades(p);
  if(NET.role!=='client')placeEnt(p);p.pos.y=0;p.spawnTime=S.time;camera.rotation.z=0;center('',0);}
function updateBody(dt){const p=player,B=p.body;if(!B)return;if(B.g.rotation.z!==0||B.g.rotation.order!=='YXZ'){resetPose(B);B.g.position.y=p.pos.y;}p.deathSeed=undefined;const show=p.tp&&p.alive&&!p.scoped;B.g.visible=show;if(!show){p.tpEye=null;return;}
  B.g.position.set(p.pos.x,p.pos.y,p.pos.z);B.g.rotation.y=p.yaw+Math.PI;B.g.rotation.x+=((p.slideT>0?-0.4:0)-B.g.rotation.x)*Math.min(1,dt*12);
  const sp=Math.hypot(p.vel.x,p.vel.z);p.walkT=(p.walkT||0)+sp*dt*(p.sprinting?2.2:1.6);animSoldier(B,{vx:p.vel.x,vz:p.vel.z,ref:4.2,crouch:p.crouch>0.5,pitch:p.pitch,slide:p.slideT>0,air:!p.onGround&&p.vel.y!==0,dt});
  const eye=camera.position.clone();const f=viewDir(p.yaw,p.pitch),r=new V3(Math.cos(p.yaw),0,-Math.sin(p.yaw));
  const want=eye.clone().addScaledVector(f,-2.7).addScaledVector(r,0.62).add(new V3(0,0.28,0));const dir=want.clone().sub(eye);const L=dir.length();dir.normalize();
  raycaster.set(eye,dir);raycaster.far=L;const h=raycaster.intersectObjects(worldMeshes,false);raycaster.far=Infinity;const dd=h.length?Math.max(0.3,h[0].distance-0.25):L;
  p.tpEye=eye;camera.position.copy(eye).addScaledVector(dir,dd);}
const MOVE_K=1.12;
function friction(p,dt){const sp=Math.hypot(p.vel.x,p.vel.z);if(sp<0.01){p.vel.x=p.vel.z=0;return;}const drop=Math.max(sp,1.9)*5.2*dt,ns=Math.max(0,sp-drop);p.vel.x*=ns/sp;p.vel.z*=ns/sp;}
function accelerate(p,wx,wz,ws,acc,dt){const cur=p.vel.x*wx+p.vel.z*wz,add=ws-cur;if(add<=0)return;const as=Math.min(acc*dt*ws,add);p.vel.x+=wx*as;p.vel.z+=wz*as;}
function airAccelerate(p,wx,wz,ws,dt){const cap=Math.min(ws,0.76),cur=p.vel.x*wx+p.vel.z*wz,add=cap-cur;if(add<=0)return;const as=Math.min(12*ws*dt,add);p.vel.x+=wx*as;p.vel.z+=wz*as;}
function spectateCam(){const p=player;let s=S.spec;if(!s||!s.alive){s=S.ents.find(e=>e.alive&&e!==p&&e.team===p.team)||S.ents.find(e=>e.alive&&e!==p&&S.mode==='br')||S.ents.find(e=>e.alive&&e!==p);S.spec=s;}
  if(s){const fx=Math.sin(s.yaw),fz=Math.cos(s.yaw);const head=new V3(s.pos.x,s.pos.y+1.75,s.pos.z);
    const want=new V3(s.pos.x-fx*2.8,s.pos.y+2.35,s.pos.z-fz*2.8);const d=want.clone().sub(head),L=d.length();d.divideScalar(L);
    raycaster.set(head,d);raycaster.far=L;const h=raycaster.intersectObjects(worldMeshes,false)[0];raycaster.far=Infinity;
    if(h)want.copy(head).addScaledVector(d,Math.max(0.35,h.distance-0.3));
    if(S.specFor!==s||camera.position.distanceTo(want)>6){camera.position.copy(want);S.specFor=s;}else camera.position.lerp(want,0.18);
    const look=new V3(s.pos.x+fx*6,s.pos.y+1.3,s.pos.z+fz*6);const q=look.sub(camera.position);
    camera.rotation.set(Math.atan2(q.y,Math.hypot(q.x,q.z)),Math.atan2(-q.x,-q.z),0);
    if(s.model&&s.model.g)s.model.g.visible=true;return true;}return false;}
function updatePlayer(dt,t0,t1){
  const p=player;
  if(!p.alive){p.deadT+=dt;
    const canSpec=S.mode==='defuse'||(S.mode==='br'&&NET.role);
    if(canSpec&&p.deadT>2.6&&spectateCam())return;
    deathCam(p,dt);
    if(S.respawns&&NET.role!=='client'){p.respawnT-=dt;if(p.respawnT<=0)respawnPlayer();}return;}
  if(p.drop&&S.mode==='br'){updateDropPlayer(p,dt);return;}
  updateHeal(p,dt);try{agTick(dt);}catch(e){}
  const busy=S.uiOpen,frozen=S.mode==='defuse'&&S.round&&S.round.phase==='freeze';
  handleObjective(dt);
  const acting=p.planting>0||p.defusing>0;
  const ck=!busy&&(keys.ControlLeft||keys.KeyC);p.crouch+=((ck||acting||p.slideT>0?1:0)-p.crouch)*Math.min(1,dt*(p.slideT>0?14:10));
  const walk=keys.AltLeft||keys.AltRight;const w=curW();
  let fw=0,sd=0;
  if(!busy&&!frozen&&!acting){fw=held('KeyW',t0,t1)-held('KeyS',t0,t1);sd=held('KeyD',t0,t1)-held('KeyA',t0,t1);}
  if(!busy){const kt=(keys.ArrowLeft?1:0)-(keys.ArrowRight?1:0),kp=(keys.ArrowUp?1:0)-(keys.ArrowDown?1:0);
    if(kt)p.yaw+=kt*2.4*dt*(camera.fov/80);if(kp)p.pitch=clamp(p.pitch+kp*1.6*dt,-1.55,1.55);
    if(S.noLock&&!S.locked&&S.mIn&&!GP.active&&!TOUCH.on){const Wd=innerWidth,Hd=innerHeight,ex=Wd*0.07,ey=Hd*0.08;
      const es=3.4*Math.max(0.5,save.sens||1);if(S.mx<ex)p.yaw+=es*dt*Math.min(1,0.35+(1-S.mx/ex));else if(S.mx>Wd-ex)p.yaw-=es*dt*Math.min(1,0.35+(1-(Wd-S.mx)/ex));
      if(S.my<ey)p.pitch=clamp(p.pitch+1.4*dt*(1-S.my/ey),-1.55,1.55);else if(S.my>Hd-ey)p.pitch=clamp(p.pitch-1.4*dt*(1-(Hd-S.my)/ey),-1.55,1.55);}}
  if(p.stamina===undefined)p.stamina=1;
  if(p.blocking&&!isKatana(curW().id))p.blocking=false;if(p.blocking){p.stamina=Math.max(0,p.stamina-dt*0.12);if(p.stamina<=0){p.blocking=false;p.blockBroken=true;}}if(p.blockBroken&&p.stamina>0.35)p.blockBroken=false;
  p.sprinting=!busy&&!frozen&&!acting&&!(p.slideT>0)&&!p.blocking&&(keys.ShiftLeft||keys.ShiftRight)&&fw>0.3&&p.crouch<0.3&&!p.ads&&!p.scoped&&!p.exhausted&&S.time>=(p.noSprintUntil||0);
  if(p.sprinting){p.stamina=Math.max(0,p.stamina-dt/6);if(p.stamina<=0){p.exhausted=true;p.sprinting=false;}}else if(!p.blocking){p.stamina=Math.min(1,p.stamina+dt/3.5);if(p.exhausted&&p.stamina>0.35)p.exhausted=false;}
  const maxs=(p.healT>0?0.55:1)*(1-0.2*Math.abs(p.lean||0))*(p.blocking?0.7:1)*MOVE_K*agentK('speed')*wSpeed(w)*(waterAt(p.pos.x,p.pos.z,p.pos.y)?0.82:1)*(walk?0.52:1)*(p.sprinting?1.36:1)*(1-p.crouch*0.66)*(p.scoped?0.6:1)*(p.ads?0.72:1)*(S.mut==='rush'?1.2:1);
  const sy=Math.sin(p.yaw),cy=Math.cos(p.yaw);
  let wx=-sy*fw+cy*sd,wz=-cy*fw-sy*sd;const wl=Math.hypot(wx,wz);let wish=0;
  if(wl>0.0001){wish=maxs*Math.min(1,wl);wx/=wl;wz/=wl;}
  p.onLadder=!!ladderAt(p.pos)&&!frozen;
  if(p.onLadder){p.vel.y=fw*3.2;p.vel.x=wx*wish*0.4;p.vel.z=wz*wish*0.4;
    if(!busy&&keys.Space){p.onLadder=false;p.vel.x=sy*2.5;p.vel.z=cy*2.5;p.vel.y=2;}}
  else if(p.onGround){
    p.slideCd=Math.max(0,(p.slideCd||0)-dt);
    if(p.slideQ!=null&&S.time-p.slideQ<0.2&&!busy&&!frozen&&!acting&&p.slideCd<=0&&!(p.slideT>0)){const sp=Math.hypot(p.vel.x,p.vel.z);
      if(sp>2.2){p.slideQ=null;const bx=p.vel.x/sp,bz=p.vel.z/sp,ns=Math.min(9.6,sp+3.4);p.vel.x=bx*ns;p.vel.z=bz*ns;p.slideT=0.8;p.slideCd=1.25;p.sprinting=false;p.slideRoll=(sd>0?-1:sd<0?1:(Math.random()<.5?-1:1))*0.1;p.slDust=0;sfx('slide');shake(0.12);}}
    if(p.slideT>0){p.slideT-=dt;p.slDust=(p.slDust||0)-dt;if(p.slDust<=0){p.slDust=0.035;const fp=new V3(p.pos.x-p.vel.x*0.03,p.pos.y+0.06,p.pos.z-p.vel.z*0.03);if(typeof waterAt==='function'&&waterAt(fp.x,fp.z,fp.y))splash(fp,0.5);else particles(fp,'dust',2,1.1);}const sp=Math.hypot(p.vel.x,p.vel.z);if(sp>0.01){const ns=Math.max(0,sp-3.6*dt);p.vel.x*=ns/sp;p.vel.z*=ns/sp;}
      if(wl>0.0001){const ang=(p.vel.x*wz-p.vel.z*wx);const st=clamp(ang*0.25,-1.2,1.2)*dt;const c=Math.cos(st),sn=Math.sin(st);const vx=p.vel.x*c-p.vel.z*sn;p.vel.z=p.vel.x*sn+p.vel.z*c;p.vel.x=vx;}
      if(sp<2.6)p.slideT=0;}
    else{friction(p,dt);accelerate(p,wx,wz,wish,5.5,dt);}}
  else airAccelerate(p,wx,wz,wish,dt);
  if(frozen||acting){p.vel.x=0;p.vel.z=0;}
  p.pos.x+=p.vel.x*dt;p.pos.z+=p.vel.z*dt;
  {if(ISL)islClamp(p.pos);const st=collide(p.pos,0.38,p.pos.y,1.8-p.crouch*0.6,p.onGround&&!p.onLadder?0.55:0);if(st>p.pos.y){p.stepOff=(p.stepOff||0)+(st-p.pos.y);p.pos.y=st;p.vel.y=Math.max(p.vel.y,0);}}
  if(p.onGround)p.lastGround=S.time;
  const canJump=(p.onGround||(S.time-(p.lastGround||-9)<0.1&&p.vel.y<=0.1))&&!p.onLadder;
  if(!busy&&!frozen&&!acting&&(keys.Space||S.time-(p.jumpQ??-9)<0.15)&&canJump){p.jumpQ=-9;p.lastGround=-9;p.vel.y=7.3;p.onGround=false;p.slideT=0;p.cjDone=false;sfx('jump',0.7);}
  if(!p.onGround&&!p.onLadder&&ck&&!p.cjDone&&p.vel.y>-1){p.cjDone=true;p.pos.y+=0.2;}
  if(p.slideT>0&&!p.onGround&&p.vel.y<-2)p.slideT=0;
  if(!p.onLadder)p.vel.y-=20*(S.mut==='lowg'?0.5:1)*dt;
  p.pos.y+=p.vel.y*dt;
  const g=groundAt(p.pos.x,p.pos.z,p.pos.y,0.38);
  if(p.pos.y<=g){if(!p.onGround&&p.vel.y<-6)sfx('land',p.vel.y<-11?1.5:0.8);if(!p.onGround&&p.vel.y<-3)p.landDip=Math.min(0.2,-p.vel.y*0.013);if(!p.onGround&&p.vel.y<-13.5&&S.state==='game'){const fd=Math.round((-p.vel.y-13.5)*11*hpK());damage(p,fd,null,'fall',false);shake(0.4);if(p.hp<=0&&p.alive)kill(p,null,'fall',false);}p.pos.y=g;p.vel.y=0;p.onGround=true;}else if(p.pos.y>g+0.05)p.onGround=false;
  p.moving=Math.hypot(p.vel.x,p.vel.z)>0.5;footsteps(dt);ladderSteps(dt);
  p.cool-=dt;if(p.switchT>0)p.switchT-=dt;
  if(p.reloading){p.reloadT-=dt*agentK('reload');const RW=curW();if(!p.mstep&&!RW.shell&&RW.reload){const st=reloadStages(RW),k=1-p.reloadT/RW.reload;while(p.rstage<st.length&&k>=st[p.rstage][0]){const nm=st[p.rstage++][1];if(!p.realReload&&!realMech(RW,nm))mech(nm);}}if(p.reloadT<=0){if(p.mstep)finishManualStep();else finishReload();}}
  if(p.pumpSnd>0){p.pumpSnd-=dt;if(p.pumpSnd<=0)mech('pump');}if(p.boltSnd>0){p.boltSnd-=dt;if(p.boltSnd<=0&&!realMech(curW(),'bolt'))mech('bolt');}
  if(mouse.down&&w.auto&&canFire()&&p.cool<=0&&p.switchT<=0&&!p.reloading)fire();
  if(p.rescope&&p.cool<=0&&!p.reloading&&w.zoom){p.rescope=false;const ws=p.inv[p.slot];if(ws&&ws.ammo>0)setScoped(true);}
  if(w.recover&&S.time-p.lastFire>w.rate*1.1&&p.sprayIdx>0){p.sprayIdx=Math.max(0,p.sprayIdx*Math.exp(-dt*w.recover.k)-dt*w.recover.lin);}
  const[py,pp]=w.pattern?patternAt(w,p.sprayIdx).map(v=>v*agentK('recoil')):[0,0];
  p.punchP+=(pp*0.5*D2R-p.punchP)*Math.min(1,dt*30);p.punchY+=(py*0.5*D2R-p.punchY)*Math.min(1,dt*30);
  p.stepOff=(p.stepOff||0)*Math.max(0,1-dt*14);p.landDip=(p.landDip||0)*Math.max(0,1-dt*9);
  updateShotFeel(dt);updateLean(p,dt,busy||frozen);updateCrates(dt);
  camera.position.set(p.pos.x+p.leanOff.x,p.pos.y+1.62-p.crouch*0.55-p.stepOff-p.landDip-Math.abs(p.lean)*0.06,p.pos.z+p.leanOff.z);if(p.vkZ){camera.position.x+=Math.sin(p.yaw)*p.vkZ;camera.position.z+=Math.cos(p.yaw)*p.vkZ;}
  {const sk=FUN.shake+(FUN.rum||0)*(0.6+0.4*Math.sin(S.time*38));p.shx=(Math.random()-0.5)*sk*0.014;p.shy=(Math.random()-0.5)*sk*0.014;}p.roll=(p.roll||0)+(((p.slideT>0)?(p.slideRoll||0):0)-(p.roll||0))*Math.min(1,dt*10);
  camera.rotation.set(clamp(p.pitch+p.punchP+p.shx+(p.vkP||0),-1.56,1.56),p.yaw-p.punchY+p.shy+(p.vkY||0),p.roll+(p.vkR||0)+(p.leanRoll||0));
  updateBody(dt);
  S.nearLoot=null;
  if(S.mode==='br'){let bd=1.8;for(const L of S.loot){if(L.taken)continue;const d=Math.hypot(L.g.position.x-p.pos.x,L.g.position.z-p.pos.z);if(d<bd){bd=d;S.nearLoot=L;}}}
}

/* ================= BUY ================= */
/* Versus (1v1 duel and 2v2…5v5 formats, not Ranked): no buying — you fight with your equipped loadout */
function isVersus(){return !S.ranked&&(!!S.duel||!!S.fmt);}
function buyAllowed(){
  if(S.mode==='practice')return true;if(S.mode==='br')return false;if(isVersus())return false;
  if(!player.alive)return false;
  if(S.mode==='defuse'){const R=S.round;if(R.phase==='freeze')return true;if(R.phase==='live'&&ROUND.live-R.t<20){const s=spawns[player.team];return Math.hypot(player.pos.x-s.x,player.pos.z-s.z)<14;}return false;}
  if(S.countdown>0)return true;
  if(S.time-player.spawnTime<15)return true;
  if(S.mode==='tdm'){const s=spawns[player.team];return Math.hypot(player.pos.x-s.x,player.pos.z-s.z)<12;}
  return false;
}
function owned(k){const p=player;if(k==='med')return (p.meds||0)>=medMax();if(k==='armor')return p.armor>=100;if(k==='kit')return p.kit;if(isNadeId(k))return p.nades.filter(x=>x===k).length>=(k==='flashbang'?2:1)||p.nades.length>=4;if(k==='ammo')return false;
  const w=WEAPONS[k];const s=p.inv[w.slot];return !!(s&&s.id===k);}
function renderBuy(){
  const free=S.mode==='practice';
  $('buyMoney').textContent=free?'∞':'$'+player.money;
  $('buyGrid').style.gridTemplateColumns='repeat('+buyColumns().length+',1fr)';
  $('buyGrid').innerHTML=buyColumns().map(([cat,list])=>`<div><h4>${cat}</h4>`+list.filter(k=>(k!=='kit'||(S.mode==='defuse'&&player.team==='CT'))&&!(S.mode==='defuse'&&WEAPONS[k]&&WEAPONS[k].side&&WEAPONS[k].side!==player.team)).map(k=>{const it=itemInfo(k),own=owned(k),gl=!free&&!gunOwned(k),no=(!free&&player.money<it.price)||own||gl;
    const W=WEAPONS[k];let pic='';const NT={he:'hegrenade',smoke:'smokegrenade',flashbang:'flashbang',decoy:'decoy',molotov:'molotov',incendiary:'incendiary'}[k];
    try{if(W&&W.nade&&NT&&window.CR_NADEPK&&CR_NADEPK.tex[NT])pic=CR_NADEPK.tex[NT];else if(W&&!W.nade)pic=weaponIcon(k,equippedPaint&&equippedPaint(k))||'';}catch(e){}if(k==='armor'){try{pic=vestIcon()||'';}catch(e){}}const nadeGlyph=W&&W.nade&&!pic?({firebomb:'🔥'}[k]||'💣'):'';
    const glyph={med:'✚',armor:'🛡',kit:'🔧',ammo:'▤'}[k]||nadeGlyph||'';const poor=!free&&!own&&player.money<it.price;
    return `<button class="bi${no?' no':''}${own?' own':''}${poor?' poor':''}${gl?' glk':''}" data-k="${k}"><div class="bpic">${pic?`<img src="${pic}" alt=""${W&&W.nade?' class="nd"':''}>`:`<span>${glyph||'◆'}</span>`}</div><div class="bt"><div class="n">${it.name}</div><div class="d">${it.d}</div></div><div class="p">${own?'Owned':gl?'🔒 Armory':free?'Free':'$'+it.price}</div></button>`;}).join('')+'</div>').join('');
  $('buyNote').textContent=free?'Practice range: everything is free.':S.mode==='defuse'?'Buy during the 15 s freeze or the first 20 s of the round near spawn. Dead players lose their gear.':'Buy near spawn or within 15 s of spawning. Buying a gun replaces the one in that slot.';
}
function applyBuy(k){
  if(k==='med')player.meds=Math.min(medMax(),(player.meds||0)+1);
  else if(k==='armor')player.armor=100;
  else if(k==='kit')player.kit=true;
  else if(isNadeId(k)){player.nades.push(k);refreshNades();}
  else if(k==='ammo'){for(const s of[1,2]){const ws=player.inv[s];if(ws)ws.reserve=WEAPONS[ws.id].reserve;}}
  else giveWeapon(k);
  sfx('buy');if(S.buyOpen)renderBuy();
}
function buy(k){
  if(!buyAllowed()){sfx('deny');return;}
  const it=itemInfo(k);if(!it)return;
  if(k==='kit'&&!(S.mode==='defuse'&&player.team==='CT')){sfx('deny');return;}
  if(S.mode!=='practice'&&!gunOwned(k)){center('<span style="color:#ffd34d">Unlock this gun in the Armory first</span>',1.3);sfx('deny');return;}
  if(S.mode!=='practice'&&player.money<it.price){sfx('deny');return;}
  if(S.mode==='defuse'&&WEAPONS[k]&&WEAPONS[k].side&&WEAPONS[k].side!==player.team){sfx('deny');return;}
  if(owned(k)){sfx('deny');return;}
  if(NET.role==='client'&&S.mode!=='practice'){netToHost({t:'buy',k});return;}
  if(S.mode!=='practice')player.money-=it.price;
  applyBuy(k);
}
function openBuy(){if(!buyAllowed()){center(S.mode==='br'?'No buy menu in Battle Royale — loot the map':isVersus()?'No buying in Versus — you fight with your equipped loadout':'Buy time is over / outside buy zone',1.6);sfx('deny');return;}
  S.buyOpen=true;S.uiOpen=true;mouse.down=false;setScoped(false);renderBuy();$('buy').classList.remove('hidden');if(document.pointerLockElement)document.exitPointerLock();}
$('buyClose').onclick=()=>closeBuy();$('buy').addEventListener('click',e=>{if(e.target.id==='buy')closeBuy();});
function closeBuy(){S.buyOpen=false;S.uiOpen=false;$('buy').classList.add('hidden');lockPointer();}
$('buyGrid').addEventListener('click',e=>{const b=e.target.closest('.bi');if(b)buy(b.dataset.k);});

/* ================= PRACTICE ================= */
function spawnTarget(){
  let x=0,z=-10;for(let i=0;i<30;i++){x=-20+Math.random()*40;z=-28+Math.random()*26;if(!blocked(x,z,1.2))break;}
  const g=new THREE.Group();g.position.set(x,0,z);
  const pole=new THREE.Mesh(new THREE.BoxGeometry(0.08,1.1,0.08),MAT.metal);pole.position.y=0.55;pole.castShadow=true;g.add(pole);
  const s=0.75+Math.random()*0.4;const disc=new THREE.Mesh(GEO.target,[TSIDE,TFACE,TFACE]);disc.rotation.x=Math.PI/2;disc.position.y=1.1+0.45*s;disc.scale.set(s,1,s);disc.castShadow=true;g.add(disc);
  g.rotation.x=-Math.PI/2;scene.add(g);
  const t={g,disc,state:'rising',a:0,moving:Math.random()<0.4,bx:x,amp:2+Math.random()*3,spd:0.7+Math.random()*0.9,ph:Math.random()*6.28,life:4+Math.random()*3};
  disc.userData.target=t;S.targets.push(t);
}
function hitTarget(t,point){
  if(t.state!=='up'&&t.state!=='rising')return;
  const lp=t.disc.worldToLocal(point.clone());const r=Math.hypot(lp.x,lp.z)/0.45;
  const pts=r<0.22?100:r<0.55?50:25;S.score+=pts;player.score=S.score;S.tHits++;player.hits++;anHit(curW().id,r<0.22);
  floatText(point,'+'+pts,pts===100?'#ffd34d':'#ffffff');sfx(pts===100?'head':'hit');hitmarker(pts===100,false);if(S.tut)TUT.st.hits++;
  particles(point,'spark',5);t.state='falling';
}
function updateTargets(dt){
  for(let i=S.targets.length-1;i>=0;i--){const t=S.targets[i];
    if(t.state==='rising'){t.a=Math.min(1,t.a+dt*4);if(t.a>=1)t.state='up';}
    else if(t.state==='up'){t.life-=dt;if(t.life<=0)t.state='falling';}
    else if(t.state==='falling'){t.a-=dt*5;if(t.a<=0){scene.remove(t.g);S.targets.splice(i,1);continue;}}
    t.g.rotation.x=-Math.PI/2*(1-t.a);
    if(t.moving)t.g.position.x=clamp(t.bx+Math.sin(S.time*t.spd+t.ph)*t.amp,-22,22);
  }
  S.tSpawnT-=dt;if(S.targets.length<5&&S.tSpawnT<=0){spawnTarget();S.tSpawnT=0.35;}
}

/* ================= BATTLE ROYALE — Free Fire style =================
   plane flight + jump, freefall/parachute, Gloo Walls, channelled medkits, airdrops, BOOYAH! */
const BRF={plane:null,planeMesh:null};
function brPlaneMesh(){const g=new THREE.Group();
  const P=(c,sh=40,o={})=>new THREE.MeshPhongMaterial(Object.assign({color:c,shininess:sh,specular:0x333333},o));
  const skin=P(0xffffff,55,{vertexColors:true}),wingM=P(0xa7aeb5,45),dark=P(0x2d3237,30),navy=P(0x1d2a3a,40),orange=P(0xe58a1f,50),
    glass=P(0x0d1620,120,{specular:0x99aabb}),metal=P(0x80878e,90),rubber=P(0x15171a,10);
  const add=(geo,m,x,y,z,rx=0,ry=0,rz=0,par=g)=>{const o=new THREE.Mesh(geo,m);o.position.set(x,y,z);o.rotation.set(rx,ry,rz);o.castShadow=true;par.add(o);return o;};
  const R=2.2,NOSE=14.5,N0=9,T0=-6,TAIL=-15.5;
  const rad=y=>y>N0?R*Math.sqrt(Math.max(0,1-Math.pow((y-N0)/(NOSE-N0),2))):y<T0?R-(R-0.55)*Math.pow((T0-y)/(T0-TAIL),1.3):R;
  // fuselage: lathe along the length, belly flattened, tail swept up (the cargo-ramp shape of a military transport)
  const pts=[];const NS=70;for(let i=0;i<=NS;i++){const y=TAIL+(NOSE-TAIL)*i/NS;pts.push(new THREE.Vector2(Math.max(0.001,rad(y)),y));}
  const fg=new THREE.LatheGeometry(pts,36);fg.rotateX(Math.PI/2);
  const pos=fg.attributes.position,col=[];const cTop=new THREE.Color(0xc3c9cf),cMid=new THREE.Color(0x9ba4ad),cBel=new THREE.Color(0x5f666d),cLine=new THREE.Color(0x1d2a3a),cOr=new THREE.Color(0xe58a1f);
  for(let i=0;i<pos.count;i++){let x=pos.getX(i),y=pos.getY(i),z=pos.getZ(i);const r=Math.max(0.001,rad(z));
    if(y<-0.72*r)y=-0.72*r-(y+0.72*r)*0.45;// flatter belly
    const k=clamp((-5-z)/10.5,0,1);y+=k*k*1.5*(y<0?1:0.3);
    pos.setXYZ(i,x,y,z);const v=(pos.getY(i)-k*k*1.5*0.3)/r;
    const c=v>0.42?cTop:v>0.24?cLine:v>0.17?cOr:v>-0.62?cMid:cBel;col.push(c.r,c.g,c.b);}
  fg.setAttribute('color',new THREE.Float32BufferAttribute(col,3));fg.computeVertexNormals();add(fg,skin,0,0,0);
  // cockpit glazing on the nose
  const ws=add(new THREE.SphereGeometry(R+0.03,28,10,Math.PI/2-0.62,1.24,0.62,0.5),glass,0,0,N0);ws.scale.set(1,1,(NOSE-N0)/R);
  for(const sx of[-1,1]){const sw=add(new THREE.SphereGeometry(R+0.025,10,6,Math.PI/2+sx*0.9-0.2,0.4,0.9,0.32),glass,0,0,N0);sw.scale.set(1,1,(NOSE-N0)/R);}
  // radome tip
  const rd=add(new THREE.SphereGeometry(0.5,14,10),dark,0,-0.25,NOSE-0.35);rd.scale.set(1,0.9,0.9);
  // cabin windows, para doors, name on both sides
  for(const sx of[-1,1]){const yy=0.95,xx=sx*Math.sqrt(R*R-yy*yy);for(let z=7;z>-4;z-=1.55)add(new THREE.BoxGeometry(0.06,0.34,0.42),glass,xx+sx*0.005,yy,z,0,0,-sx*0.45);
    const dx=sx*Math.sqrt(R*R-0.1);add(new THREE.BoxGeometry(0.05,1.85,0.95),dark,dx,-0.3,-4.9,0,0,0);add(new THREE.BoxGeometry(0.06,1.65,0.78),P(0x8f98a1,40),dx+sx*0.01,-0.3,-4.9);
    add(new THREE.BoxGeometry(0.05,1.2,0.75),dark,sx*Math.sqrt(R*R-0.4),-0.1,8.6);
    const tx=canvasTex(512,(c,w,h)=>{c.clearRect(0,0,w,h);c.fillStyle='#1d2a3a';c.font='900 54px Arial';c.textAlign='center';c.textBaseline='middle';c.fillText('COMBAT HORIZENS',w/2,h/2+2);},64);
    const nm=new THREE.Mesh(new THREE.PlaneGeometry(7.2,0.9),new THREE.MeshBasicMaterial({map:tx,transparent:true,depthWrite:false,fog:true}));
    nm.position.set(sx*(Math.sqrt(R*R-0.2)+0.03),-0.45,1.6);nm.rotation.y=sx*Math.PI/2;g.add(nm);}
  // landing-gear sponsons along the lower sides
  for(const sx of[-1,1]){const sp=add(new THREE.SphereGeometry(1,18,12),P(0x8a939c,40),sx*1.95,-1.05,0.6);sp.scale.set(0.62,0.8,4.6);
    for(const z of[-1.2,1.6])add(new THREE.CylinderGeometry(0.55,0.55,0.35,16),rubber,sx*2.15,-1.75,z,0,0,Math.PI/2);}
  // open cargo ramp at the back (that's where everyone jumps from)
  add(new THREE.BoxGeometry(2.5,0.06,4.4),P(0x0b0d10,5),0,-0.42,-8.6);
  const ramp=new THREE.Group();ramp.position.set(0,-0.4,-6.6);ramp.rotation.x=0.42;g.add(ramp);add(new THREE.BoxGeometry(2.6,0.14,4.2),P(0x6c747c,30),0,0,-2.1,0,0,0,ramp);
  for(let i=0;i<5;i++)add(new THREE.BoxGeometry(2.4,0.05,0.12),dark,0,0.09,-0.5-i*0.8,0,0,0,ramp);
  // tapered, slightly swept high wing
  const taper=(span,c0,c1,t0,t1,sweep,seg=14)=>{const w=new THREE.BoxGeometry(span,1,1,seg,1,2);const p=w.attributes.position;
    for(let i=0;i<p.count;i++){const x=p.getX(i),f=Math.abs(x)/(span/2);const c=c0+(c1-c0)*f,t=t0+(t1-t0)*f;let z=p.getZ(i)*c,y=p.getY(i)*t;
      if(Math.abs(p.getZ(i))<0.01)y*=1.18;// rounded airfoil crown
      if(p.getZ(i)>0)y*=0.8;z-=f*sweep;p.setXYZ(i,x,y,z);}w.computeVertexNormals();return w;};
  const WY=2.35,WZ=1.6;add(taper(40,4.8,2.2,0.62,0.26,0.7),wingM,0,WY,WZ);
  add(new THREE.BoxGeometry(2.4,0.55,5.6),P(0xb5bcc3,45),0,WY-0.1,WZ);// wing fairing
  for(const sx of[-1,1]){add(new THREE.BoxGeometry(0.3,0.06,2.0),orange,sx*19.6,WY+0.02,WZ-0.7);// tip markings
    add(new THREE.BoxGeometry(11,0.08,0.7),P(0x8b939b,40),sx*8.5,WY-0.12,WZ-2.15);}// flaps
  // four turboprops
  for(const ex of[-11.6,-6.2,6.2,11.6]){const nz=WZ+2.8;
    const np=[];for(let i=0;i<=16;i++){const t=i/16,y=-3.4+t*6.4;const r=t>0.85?0.82*Math.sqrt(Math.max(0,1-Math.pow((t-0.85)/0.16,2)))+0.05:t<0.3?0.35+0.47*Math.sin(t/0.3*Math.PI/2):0.82;np.push(new THREE.Vector2(Math.max(0.02,r),y));}
    const ng=new THREE.LatheGeometry(np,18);ng.rotateX(Math.PI/2);const n=add(ng,wingM,ex,WY-0.62,nz-3);n.scale.set(1,1.12,1);
    add(new THREE.BoxGeometry(0.5,0.32,0.18),dark,ex,WY-0.15,nz-3.2);// exhaust
    add(new THREE.CylinderGeometry(0.3,0.36,0.5,12),dark,ex+0.55*Math.sign(ex),WY-0.15,nz-2.4,Math.PI/2,0,0);
    const sp=add(new THREE.ConeGeometry(0.42,1.1,16),metal,ex,WY-0.62,nz+0.95,Math.PI/2,0,0);
    const pr=new THREE.Group();pr.position.set(ex,WY-0.62,nz+0.55);pr.userData.prop=1;g.add(pr);
    for(let b=0;b<4;b++){const bl=new THREE.Mesh(taper(2.05,0.34,0.18,0.06,0.04,0,4),dark);bl.geometry.translate(1.15,0,0);bl.rotation.set(0,0,b*Math.PI/2);bl.rotation.x=0;const bw=new THREE.Group();bw.rotation.z=b*Math.PI/2;bl.rotation.set(0.35,0,0);bw.add(bl);pr.add(bw);
      const tip=new THREE.Mesh(new THREE.BoxGeometry(0.22,0.3,0.07),new THREE.MeshBasicMaterial({color:0xf2c14e}));tip.position.set(2.1,0,0);bw.add(tip);}
    const disc=new THREE.Mesh(new THREE.CircleGeometry(2.25,32),new THREE.MeshBasicMaterial({color:0x22262a,transparent:true,opacity:0.16,depthWrite:false,side:THREE.DoubleSide}));disc.position.set(ex,WY-0.62,nz+0.52);g.add(disc);}
  // tail: tall swept fin + tailplane
  const TY=1.75;add(taper(15.5,3.7,1.7,0.36,0.18,0.9,8),wingM,0,TY,-13.2);
  const fs=new THREE.Shape();fs.moveTo(-16.0,0);fs.lineTo(-9.6,0);fs.lineTo(-13.4,7.6);fs.lineTo(-16.2,7.6);fs.lineTo(-16.0,0);
  const fgeo=new THREE.ExtrudeGeometry(fs,{depth:0.42,bevelEnabled:true,bevelThickness:0.08,bevelSize:0.08,bevelSegments:2});fgeo.translate(0,0,-0.21);fgeo.rotateY(-Math.PI/2);
  const fin=add(fgeo,wingM,0,TY-0.4,0);fin.scale.set(1,1,1);
  // flip: rotateY(-90°) maps shape x -> world z
  add(new THREE.BoxGeometry(0.55,1.0,2.95),orange,0,TY+6.25,-14.85);add(new THREE.BoxGeometry(0.56,0.18,2.98),navy,0,TY+5.65,-14.75);
  // lights: red/green wingtips, white tail, flashing beacons and strobes
  const lamp=(c,x,y,z,blink)=>{const l=new THREE.Mesh(new THREE.SphereGeometry(0.16,10,8),new THREE.MeshBasicMaterial({color:c}));l.position.set(x,y,z);g.add(l);
    const h=new THREE.Mesh(new THREE.SphereGeometry(0.45,12,10),new THREE.MeshBasicMaterial({color:c,transparent:true,opacity:0.28,blending:THREE.AdditiveBlending,depthWrite:false}));h.position.copy(l.position);g.add(h);
    if(blink!==undefined){l.userData.blink=h.userData.blink=blink+0.001;}return l;};
  lamp(0xff2a2a,-20.05,WY,WZ-0.3);lamp(0x2aff5a,20.05,WY,WZ-0.3);lamp(0xffffff,0,TY+7.3,-16.3);
  lamp(0xff3020,0,R+0.55,-1,0);lamp(0xff3020,0,-1.75,2,0.5);lamp(0xffffff,-20.05,WY,WZ-0.9,0.25);lamp(0xffffff,20.05,WY,WZ-0.9,0.25);
  g.traverse(o=>{if(o.isMesh&&o.material&&!o.material.transparent)o.receiveShadow=true;});
  return g;}
function canopyMesh(col){const g=new THREE.Group();const m=new THREE.MeshLambertMaterial({color:col,side:THREE.DoubleSide});const c=new THREE.Mesh(new THREE.SphereGeometry(2.2,14,6,0,Math.PI*2,0,Math.PI/2.6),m);c.scale.y=0.55;c.position.y=4.2;g.add(c);
  const st=new THREE.Mesh(new THREE.SphereGeometry(2.21,14,6,0,Math.PI*2,0,Math.PI/2.6),new THREE.MeshLambertMaterial({color:0xffffff,side:THREE.DoubleSide,wireframe:true}));st.scale.y=0.55;st.position.y=4.2;g.add(st);
  const lm=new THREE.LineBasicMaterial({color:0x222222});for(let i=0;i<8;i++){const a=i/8*Math.PI*2;const geo=new THREE.BufferGeometry().setFromPoints([new V3(0,1.5,0),new V3(Math.cos(a)*2,3.9,Math.sin(a)*2)]);g.add(new THREE.Line(geo,lm));}return g;}
/* ---------- start of a BR match ---------- */
function brStart(){if(S.mode!=='br')return;const H=mapH;const a=Math.random()*Math.PI*2;const L=H*1.35;
  const A=new V3(Math.cos(a)*L,120,Math.sin(a)*L),B=new V3(-Math.cos(a)*L,120,-Math.sin(a)*L);
  BRF.plane={A,B,t:0,dur:Math.round(34*Math.max(1,H/150)),pos:A.clone(),dir:B.clone().sub(A).normalize()};
  if(BRF.planeMesh)scene.remove(BRF.planeMesh);BRF.planeMesh=brPlaneMesh();BRF.planeMesh.position.copy(A);BRF.planeMesh.rotation.y=Math.atan2(BRF.plane.dir.x,BRF.plane.dir.z);scene.add(BRF.planeMesh);
  S.air={next:70+Math.random()*20,list:[]};
  for(const e of S.ents){if(e.isNet||e.isProxy)continue;e.drop={phase:'plane'};if(e.isPlayer){e.meds=1;}else{e.drop.jumpAt=0.12+Math.random()*0.72;const L2=S.loot.filter(l=>!l.taken);const tgt=L2.length?L2[(Math.random()*L2.length)|0].g.position:new V3(rand(-H*0.7,H*0.7),0,rand(-H*0.7,H*0.7));e.drop.tx=tgt.x+rand(-6,6);e.drop.tz=tgt.z+rand(-6,6);if(e.model)e.model.g.visible=false;}}
}
function brEnd(){if(BRF.planeMesh){scene.remove(BRF.planeMesh);BRF.planeMesh=null;}BRF.plane=null;for(const w of S.gloos||[])glooRemove(w,true);S.gloos=[];for(const a of (S.air&&S.air.list)||[])airRemove(a);S.air=null;
  vmRoot.visible=true;document.body.classList.remove('dropping');for(const e of S.ents||[]){if(e.canopy){scene.remove(e.canopy);e.canopy=null;}e.drop=null;}const dh=$('dropHud');if(dh)dh.classList.remove('show');}
function updatePlane(dt){const P=BRF.plane;if(!P)return;P.t+=dt;const k=Math.min(1,P.t/P.dur);P.pos.lerpVectors(P.A,P.B,k);
  if(BRF.planeMesh){BRF.planeMesh.position.copy(P.pos);BRF.planeMesh.rotation.y=Math.atan2(P.dir.x,P.dir.z);BRF.planeMesh.rotation.z=Math.sin(S.time*0.6)*0.03;BRF.planeMesh.traverse(o=>{if(o.userData.prop)o.rotation.z+=dt*40;if(o.userData.blink)o.visible=((S.time+o.userData.blink)%1)<0.09;});}
  if(k>=1){for(const e of S.ents)if(e.drop&&e.drop.phase==='plane')dropJump(e);scene.remove(BRF.planeMesh);BRF.planeMesh=null;BRF.plane=null;}
  else for(const e of S.ents)if(e.drop&&e.drop.phase==='plane'&&!e.isPlayer&&k>=e.drop.jumpAt)dropJump(e);}
function dropJump(e){const P=BRF.plane;const p=P?P.pos:new V3(e.pos.x,120,e.pos.z);e.pos.set(p.x+rand(-1,1),p.y-3,p.z+rand(-1,1));e.drop.phase='fall';e.drop.vy=-8;e.drop.vh=P?P.dir.clone().multiplyScalar(14):new V3();
  if(e.model){e.model.g.visible=true;}if(e.isPlayer){sfx('jump');center('',0);}}
function openChute(e){if(!e.drop||e.drop.phase!=='fall')return;e.drop.phase='chute';e.drop.vy=Math.min(e.drop.vy,-6);
  const cols=[0xff7a1a,0x3d9bff,0xe8e8e8,0x5ac85a,0xff4a6a,0xffd23a];e.canopy=canopyMesh(e.isPlayer?0xffb347:cols[(Math.random()*cols.length)|0]);scene.add(e.canopy);if(e.isPlayer)sfx('pickup');}
function dropLand(e,gy){e.pos.y=gy;e.drop=null;if(e.canopy){scene.remove(e.canopy);e.canopy=null;}if(e.model){resetPose(e.model);e.model.g.rotation.x=0;}if(e.isPlayer){vmRoot.visible=true;document.body.classList.remove('dropping');e.vel.set(0,0,0);sfx('land',1);center('',0);const dh=$('dropHud');if(dh)dh.classList.remove('show');}else{e.wp=null;e.tpos&&e.tpos.copy(e.pos);}}
/* player: camera + steering while in the plane / air. returns true when it handled the frame */
function updateDropPlayer(p,dt){const d=p.drop;vmRoot.visible=false;document.body.classList.add('dropping');const dh=$('dropHud');const f=viewDir(p.yaw,p.pitch);
  if(d.phase==='plane'){const P=BRF.plane;if(!P){dropJump(p);return true;}p.pos.copy(P.pos);
    camera.position.copy(P.pos).addScaledVector(f,-24).add(new V3(0,5,0));camera.rotation.set(clamp(p.pitch,-1.4,1.2),p.yaw,0);
    if((keys.Space||keys.KeyF)&&P.t>0.6)dropJump(p);
    if(dh){dh.classList.add('show');dh.innerHTML=`<b>IN FLIGHT</b><span>${TOUCH.on?'Tap <kbd>⤒</kbd> to jump':'<kbd>SPACE</kbd> jump'} · ${Math.max(0,Math.ceil(P.dur-P.t))}s until forced drop</span>`;}return true;}
  const gy=groundAt(p.pos.x,p.pos.z,p.pos.y,0.3)||0;const alt=p.pos.y-gy;const fx=Math.sin(p.yaw)*-1,fz=Math.cos(p.yaw)*-1;
  const fw=new V3(-Math.sin(p.yaw),0,-Math.cos(p.yaw)),rt=new V3(Math.cos(p.yaw),0,-Math.sin(p.yaw));let mx=0,mz=0;
  if(keys.KeyW){mx+=fw.x;mz+=fw.z;}if(keys.KeyS){mx-=fw.x*0.6;mz-=fw.z*0.6;}if(keys.KeyD){mx+=rt.x;mz+=rt.z;}if(keys.KeyA){mx-=rt.x;mz-=rt.z;}
  if(d.phase==='fall'){const dive=keys.KeyW?1:0;const tv=-(38+dive*14);d.vy+=(tv-d.vy)*Math.min(1,dt*1.2);const hs=keys.KeyW?20:13;d.vh.x+=(mx*hs-d.vh.x)*Math.min(1,dt*1.6);d.vh.z+=(mz*hs-d.vh.z)*Math.min(1,dt*1.6);
    if((keys.Space&&!d.spaceHeld&&d.t>0.5)||alt<42)openChute(p);d.spaceHeld=keys.Space;}
  else{d.vy+=(-6.5-d.vy)*Math.min(1,dt*3);const hs=9.5;d.vh.x+=(mx*hs-d.vh.x)*Math.min(1,dt*2);d.vh.z+=(mz*hs-d.vh.z)*Math.min(1,dt*2);}
  d.t=(d.t||0)+dt;p.pos.x=clamp(p.pos.x+d.vh.x*dt,-mapH+2,mapH-2);p.pos.z=clamp(p.pos.z+d.vh.z*dt,-mapH+2,mapH-2);p.pos.y+=d.vy*dt;
  if(alt<6)collide(p.pos,0.35,p.pos.y+0.2,1.7);if(ISL&&alt<30)islClamp(p.pos,-2);
  const g2=groundAt(p.pos.x,p.pos.z,p.pos.y+0.5,0.3)||0;if(p.pos.y<=g2){dropLand(p,g2);return true;}
  if(p.canopy){p.canopy.position.set(p.pos.x,p.pos.y,p.pos.z);p.canopy.rotation.y=p.yaw;}
  const sway=d.phase==='fall'?Math.sin(S.time*7)*0.01:Math.sin(S.time*1.3)*0.03;
  camera.position.set(p.pos.x,p.pos.y+1.62,p.pos.z);camera.rotation.set(clamp(p.pitch+sway,-1.56,1.56),p.yaw,d.phase==='fall'?Math.sin(S.time*5)*0.02:Math.sin(S.time*1.1)*0.04);
  if(dh){dh.classList.add('show');dh.innerHTML=d.phase==='fall'?`<b>FREEFALL · ${Math.round(alt)} m</b><span>${TOUCH.on?'Joystick up: dive · <kbd>⤒</kbd> parachute':'<kbd>W</kbd> dive · <kbd>A</kbd><kbd>D</kbd> steer · <kbd>SPACE</kbd> parachute'}</span>`:`<b>PARACHUTE · ${Math.round(alt)} m</b><span>${TOUCH.on?'Use the joystick':'<kbd>WASD</kbd>'} to glide to your landing spot</span>`;}
  return true;}
/* bots in the plane / air */
function updateDropBot(b,dt){const d=b.drop;if(d.phase==='plane'){if(BRF.plane)b.pos.copy(BRF.plane.pos);b.model.g.visible=false;return;}
  const gy=groundAt(b.pos.x,b.pos.z,b.pos.y,0.3)||0;const alt=b.pos.y-gy;const dx=d.tx-b.pos.x,dz=d.tz-b.pos.z,dl=Math.hypot(dx,dz)||1;
  if(d.phase==='fall'){d.vy+=(-42-d.vy)*Math.min(1,dt*1.2);const hs=Math.min(19,dl*0.6);d.vh.x+=(dx/dl*hs-d.vh.x)*Math.min(1,dt*1.5);d.vh.z+=(dz/dl*hs-d.vh.z)*Math.min(1,dt*1.5);if(alt<40+Math.random()*4)openChute(b);}
  else{d.vy+=(-6.5-d.vy)*Math.min(1,dt*3);const hs=Math.min(9,dl*0.5);d.vh.x+=(dx/dl*hs-d.vh.x)*Math.min(1,dt*2);d.vh.z+=(dz/dl*hs-d.vh.z)*Math.min(1,dt*2);}
  b.pos.x=clamp(b.pos.x+d.vh.x*dt,-mapH+2,mapH-2);b.pos.z=clamp(b.pos.z+d.vh.z*dt,-mapH+2,mapH-2);b.pos.y+=d.vy*dt;if(alt<6)collide(b.pos,0.35,b.pos.y+0.2,1.7);if(ISL&&alt<30)islClamp(b.pos,-2);
  const m=b.model;m.g.position.copy(b.pos);m.g.rotation.order='YXZ';m.g.rotation.y=Math.atan2(d.vh.x,d.vh.z)||b.yaw;m.g.rotation.x=d.phase==='fall'?1.15:0;animSoldier(m,{spd:0,pitch:d.phase==='fall'?-0.6:0,dt});
  if(b.canopy){b.canopy.position.copy(b.pos);b.canopy.rotation.y=m.g.rotation.y;}
  const g2=groundAt(b.pos.x,b.pos.z,b.pos.y+0.5,0.3)||0;if(b.pos.y<=g2){b.yaw=m.g.rotation.y;dropLand(b,g2);syncBot(b);}}
/* ---------- Gloo Wall ---------- */
let _glooMat=null;function glooMat(){if(_glooMat)return _glooMat;const t=canvasTex(128,(c,s)=>{const g=c.createLinearGradient(0,0,0,s);g.addColorStop(0,'#dff6ff');g.addColorStop(1,'#8fd0f0');c.fillStyle=g;c.fillRect(0,0,s,s);
    for(let i=0;i<26;i++){c.strokeStyle=`rgba(255,255,255,${0.2+Math.random()*0.4})`;c.lineWidth=1+Math.random()*2;c.beginPath();let x=Math.random()*s,y=Math.random()*s;c.moveTo(x,y);for(let j=0;j<4;j++){x+=(Math.random()-0.5)*40;y+=(Math.random()-0.5)*40;c.lineTo(x,y);}c.stroke();}
    for(let i=0;i<40;i++){c.fillStyle=`rgba(255,255,255,${Math.random()*0.5})`;c.beginPath();c.arc(Math.random()*s,Math.random()*s,1+Math.random()*3,0,7);c.fill();}});
  _glooMat=new THREE.MeshPhongMaterial({map:t,color:0xbfe9ff,emissive:0x1a4a66,shininess:120,specular:0xffffff,transparent:true,opacity:0.88});return _glooMat;}
function glooSfx(kind,pos){if(!actx)return;const sp=spatial(pos);if(sp.vol<0.03)return;const o=bus(0.6*sp.vol,sp.pan||0,0.2);
  if(kind==='up'){nz(o,2400,0.35,0.35,'bandpass',0,2,800);tn(o,180,0.3,0.4,'sine',0,90);tn(o,1200,0.18,0.08,'triangle',0.05,2400);}
  else if(kind==='hit'){tn(o,2600+Math.random()*900,0.06,0.12,'triangle');}
  else{nz(o,3200,0.5,0.6,'highpass',0,0.8);for(let i=0;i<6;i++)tn(o,1800+Math.random()*2500,0.15,0.12,'triangle',i*0.03);}}
function deployGloo(e){if(!e||!e.alive||(e.gloo||0)<=0||e.drop)return false;const f=e.isPlayer?new V3(-Math.sin(e.yaw),0,-Math.cos(e.yaw)):new V3(Math.sin(e.yaw),0,Math.cos(e.yaw));
  const c=new V3(e.pos.x+f.x*2.3,e.pos.y,e.pos.z+f.z*2.3);const yaw=Math.atan2(f.x,f.z);e.gloo--;
  const w={hp:600,life:22,age:0,parts:[],cols:[],owner:e,pos:c.clone()};const R=2.0,N=5;
  for(let i=0;i<N;i++){const a=yaw+(i-(N-1)/2)*0.32;const x=c.x+Math.sin(a)*R-f.x*R,z=c.z+Math.cos(a)*R-f.z*R;
    const m=new THREE.Mesh(new THREE.BoxGeometry(0.72,2.15,0.32),glooMat());m.position.set(x,c.y+1.075,z);m.rotation.y=a;m.castShadow=true;m.receiveShadow=true;m.scale.y=0.05;m.userData.gloo=w;scene.add(m);worldMeshes.push(m);w.parts.push(m);
    const col={minX:x-0.33,maxX:x+0.33,minZ:z-0.33,maxZ:z+0.33,minY:c.y,maxY:c.y+2.15};colliders.push(col);w.cols.push(col);}
  CGN=-1;S.gloos=S.gloos||[];S.gloos.push(w);glooSfx('up',c);if(e.isPlayer)center('<span style="color:#9fe0ff">GLOO WALL</span> · '+e.gloo+' left',0.8);return true;}
function glooRemove(w,silent){for(const m of w.parts){scene.remove(m);const i=worldMeshes.indexOf(m);if(i>=0)worldMeshes.splice(i,1);}for(const c of w.cols){const i=colliders.indexOf(c);if(i>=0)colliders.splice(i,1);}w.parts=[];w.cols=[];w.dead=true;CGN=-1;
  if(!silent){particles(w.pos.clone().add(new V3(0,1,0)),'water',22,4);glooSfx('break',w.pos);}}
function glooHit(w,dmg,pt){if(!w||w.dead)return;w.hp-=dmg;glooSfx('hit',pt||w.pos);if(pt)particles(pt,'water',3,2);const k=Math.max(0,w.hp/600);for(const m of w.parts){m.material=m.material===glooMat()?glooMat().clone():m.material;m.material.opacity=0.45+0.43*k;m.material.color.setHex(k>0.5?0xbfe9ff:k>0.25?0x9fcfe8:0x7fb0cc);}if(w.hp<=0)glooRemove(w);}
/* ===== breakable windows: shoot the glass (or blast it) and it shatters with a glass-break sound ===== */
let WINDOWS=[];let _winBroken=null;const _GEO_WINB_Z=new THREE.BoxGeometry(0.92,1.12,0.085),_GEO_WINB_X=new THREE.BoxGeometry(0.085,1.12,0.92);
function winBrokenMat(){if(_winBroken)return _winBroken;const t=canvasTex(64,(x,S)=>{x.fillStyle='#0d1116';x.fillRect(0,0,S,S);
    x.fillStyle='rgba(150,190,210,.85)';const edge=(pts)=>{x.beginPath();x.moveTo(pts[0],pts[1]);for(let i=2;i<pts.length;i+=2)x.lineTo(pts[i],pts[i+1]);x.closePath();x.fill();};
    edge([0,0,26,0,8,18,0,30]);edge([S,0,S-20,0,S-6,22,S,12]);edge([0,S,0,S-24,14,S-8,30,S]);edge([S,S,S-28,S,S-10,S-14,S,S-34]);edge([30,0,40,0,35,10]);
    x.strokeStyle='rgba(220,240,250,.6)';x.lineWidth=1;for(let i=0;i<8;i++){x.beginPath();x.moveTo(Math.random()*S,Math.random()*12);x.lineTo(Math.random()*S,Math.random()*S*0.3);x.stroke();}});
  _winBroken=new THREE.MeshLambertMaterial({map:t});return _winBroken;}
function winReg(m,x,y,z,alongX){WINDOWS.push({i:WINDOWS.length,x,y,z,alongX,broken:false,ov:null});}
function winsClear(){for(const w of WINDOWS)if(w.ov)scene.remove(w.ov);WINDOWS=[];}
function winsRestore(){for(const w of WINDOWS)if(w.broken){w.broken=false;if(w.ov){scene.remove(w.ov);w.ov=null;}}}
function winAt(pt,tol=0.45){for(const w of WINDOWS){if(w.broken)continue;const along=w.alongX?Math.abs(pt.x-w.x):Math.abs(pt.z-w.z),across=w.alongX?Math.abs(pt.z-w.z):Math.abs(pt.x-w.x);
    if(along<0.5&&Math.abs(pt.y-w.y)<0.58&&across<tol)return w;}return null;}
function winBreak(w,net){if(!w||w.broken)return;w.broken=true;const ov=new THREE.Mesh(w.alongX?_GEO_WINB_Z:_GEO_WINB_X,winBrokenMat());ov.position.set(w.x,w.y,w.z);scene.add(ov);w.ov=ov;
  const c=new V3(w.x,w.y,w.z);const n=Math.round(16*(typeof fxMul==='function'?fxMul():1))||6;
  for(let i=0;i<n;i++){const m=new THREE.Mesh(GEO.part,PMAT.glass);const s=0.6+Math.random()*1.6;m.scale.set(s,s*1.4,0.4);m.rotation.set(Math.random()*3,Math.random()*3,0);
    m.position.set(c.x+(w.alongX?(Math.random()-0.5)*0.85:0),c.y+(Math.random()-0.5)*1.0,c.z+(w.alongX?0:(Math.random()-0.5)*0.85));scene.add(m);
    S.fx.push({m,v:new V3((Math.random()-0.5)*2.2,Math.random()*1.4,(Math.random()-0.5)*2.2),life:0.9+Math.random()*0.8,kind:'p'});}
  sfx('glass',1,c);if(net&&NET.role)netSendOrBroadcast({t:'win',i:w.i});}
function winsBlast(pos,R){for(const w of WINDOWS){if(w.broken)continue;if(Math.hypot(w.x-pos.x,w.y-pos.y,w.z-pos.z)<R)winBreak(w,false);}}
/* ===== AIM ASSIST: mobile/tablet, the Android beta app, and new players below level 15 =====
   gentle pull toward the closest visible enemy near the crosshair + look slow-down over targets.
   Only active while you're aiming/looking/firing, never snaps, never locks on through walls or smoke. */
const AA_LEVEL=15;
function aimAssistOn(){const m=save.aimAssist||'auto';if(m==='off')return false;if(m==='on')return true;
  return !!(TOUCH.on||GP.active||(typeof IN_APP!=='undefined'&&IN_APP)||(save.level||1)<AA_LEVEL);}
function aimAssistWhy(){if(TOUCH.on)return 'touch controls';if(GP.active)return 'controller';if(typeof IN_APP!=='undefined'&&IN_APP)return 'beta app';if((save.level||1)<AA_LEVEL)return 'new player · until level '+AA_LEVEL;return '';}
const AA={t:null,act:0,fr:0};const _aaV=new V3(),_aaE=new V3();
function aaEnemy(e){if(!e.alive||e===player||e.drop)return false;if(S.mode==='ffa')return true;return e.team!==player.team;}
function aimAssistTick(dt){AA.t=null;AA.fr=0;const p=player;if(S.state!=='game'||S.uiOpen||!p.alive||S.paused||p.drop||!aimAssistOn())return;
  AA.act=Math.max(0,AA.act-dt);const w=curW();if(!w||w.nade||w.melee)return;
  const engaged=AA.act>0||mouse.down||p.ads||p.scoped;
  _aaE.copy(camera.position);const fwd=new V3(-Math.sin(p.yaw)*Math.cos(p.pitch),Math.sin(p.pitch),-Math.cos(p.yaw)*Math.cos(p.pitch));
  let best=null,bs=1e9;
  for(const e of S.ents){if(!aaEnemy(e))continue;_aaV.set(e.pos.x,e.pos.y+(e.crouch?0.95:1.25),e.pos.z).sub(_aaE);const d=_aaV.length();if(d>70||d<0.5)continue;
    const ang=Math.acos(clamp(_aaV.dot(fwd)/d,-1,1));const cone=clamp(Math.atan(1.6/d)*(p.ads||p.scoped?1.35:1),0.035,0.16)*(TOUCH.on?1.25:1);if(ang>cone)continue;
    const dir=_aaV.clone().divideScalar(d);raycaster.set(_aaE,dir);raycaster.far=d-0.4;const hit=raycaster.intersectObjects(worldMeshes,false).find(h=>h.object.material&&h.object.material.visible!==false);raycaster.far=Infinity;if(hit)continue;
    const tp=_aaE.clone().add(_aaV);if(smokeBlocks(_aaE,tp))continue;const sc=ang/cone+d*0.004;if(sc<bs){bs=sc;best={e,ang,cone,d,v:_aaV.clone()};}}
  if(!best)return;AA.t=best.e;const prox=1-best.ang/best.cone;AA.fr=prox;
  if(!engaged)return;
  const ty=Math.atan2(-best.v.x,-best.v.z),tpi=Math.atan2(best.v.y,Math.hypot(best.v.x,best.v.z));
  let dy=ty-p.yaw;dy=Math.atan2(Math.sin(dy),Math.cos(dy));const dpi=tpi-p.pitch;
  const k=(TOUCH.on?5.2:3.0)*(0.35+0.65*prox)*dt;   // fraction of the gap closed per second
  p.yaw+=dy*Math.min(1,k);p.pitch=clamp(p.pitch+dpi*Math.min(1,k*0.8),-1.55,1.55);applyCamRot();}
function aaFriction(){return AA.t?1-(TOUCH.on?0.4:0.28)*AA.fr:1;}
/* ===== explosive barrels: shoot until it ignites, then it blows (chains to nearby barrels, HE also sets them off) ===== */
let BARREL_SPOTS=[];const BARREL_HP=55;let _barrelMats=null;
function barrelMats(){if(_barrelMats)return _barrelMats;const lab=canvasTex(64,(x,s)=>{x.fillStyle='#b5221a';x.fillRect(0,0,s,s);x.fillStyle='#f2c21b';x.fillRect(0,s*0.3,s,s*0.4);x.fillStyle='#111';for(let i=-2;i<8;i++){x.beginPath();x.moveTo(i*12,s*0.3);x.lineTo(i*12+6,s*0.3);x.lineTo(i*12+14,s*0.7);x.lineTo(i*12+8,s*0.7);x.fill();}x.fillStyle='rgba(0,0,0,.25)';for(let i=0;i<40;i++)x.fillRect(Math.random()*s,Math.random()*s,2,2);});
  _barrelMats={body:pm(0xffffff,{map:lab}),rim:pm(0x7d1712),lid:pm(0x5a120e),hot:new THREE.MeshBasicMaterial({color:0xff7a20})};return _barrelMats;}
function barrelsClear(){for(const br of (S.barrels||[]))barrelRemove(br);S.barrels=[];}
function barrelRemove(br){if(br.g){scene.remove(br.g);const i=worldMeshes.indexOf(br.hit);if(i>=0)worldMeshes.splice(i,1);}const j=colliders.indexOf(br.col);if(j>=0)colliders.splice(j,1);if(br.flame){scene.remove(br.flame);br.flame=null;}br.g=null;CGN=-1;}
function barrelsSpawn(){barrelsClear();const M=barrelMats();
  BARREL_SPOTS.forEach(([x,z],i)=>{const g=new THREE.Group();g.position.set(x,0,z);g.rotation.y=i*1.3;
    const body=new THREE.Mesh(new THREE.CylinderGeometry(0.42,0.42,1.12,16),M.body);body.position.y=0.56;body.castShadow=body.receiveShadow=true;g.add(body);
    for(const y of[0.04,0.38,0.74,1.08]){const r=new THREE.Mesh(new THREE.CylinderGeometry(0.445,0.445,0.05,16),M.rim);r.position.y=y;g.add(r);}
    const lid=new THREE.Mesh(new THREE.CylinderGeometry(0.4,0.4,0.03,16),M.lid);lid.position.y=1.13;g.add(lid);
    const cap=new THREE.Mesh(new THREE.CylinderGeometry(0.06,0.06,0.05,8),M.rim);cap.position.set(0.22,1.16,0.05);g.add(cap);
    scene.add(g);g.updateMatrixWorld(true);body.userData.barrel=i;worldMeshes.push(body);
    const col={minX:x-0.42,maxX:x+0.42,minZ:z-0.42,maxZ:z+0.42,minY:0,maxY:1.14};colliders.push(col);
    S.barrels.push({i,g,hit:body,col,pos:new V3(x,0.6,z),hp:BARREL_HP,fuse:-1,owner:null,dead:false,flame:null});});CGN=-1;}
function barrelHit(i,dmg,pt,owner){const br=S.barrels&&S.barrels[i];if(!br||br.dead)return;br.hp-=dmg;br.owner=owner||br.owner;
  if(pt){particles(pt,'spark',5,3);decal(pt,null);}sfx('clang',0.5,pt||br.pos);
  if(br.hp<=0&&br.fuse<0)barrelIgnite(br,0.12);
  else if(br.hp<BARREL_HP*0.5&&br.fuse<0)barrelIgnite(br,1.4);}
function barrelIgnite(br,t){br.fuse=t;if(!br.flame){const f=new THREE.Sprite(FIRE_MAT);f.position.set(br.pos.x,1.35,br.pos.z);f.scale.set(0.6,0.9,1);scene.add(f);br.flame=f;sfx('hiss',0.8,br.pos);}}
function barrelExplode(br,net){if(br.dead)return;br.dead=true;const pos=br.pos.clone();pos.y=0.7;barrelRemove(br);
  boom(pos,4.2);particles(pos,'spark',26,7);particles(pos,'dust',20,5);
  const sc=new THREE.Mesh(GEO_SCORCH,SCORCH);sc.rotation.x=-Math.PI/2;sc.position.set(pos.x,0.02,pos.z);sc.scale.setScalar(1.8);scene.add(sc);S.decals.push(sc);
  const d0=player.pos.distanceTo(pos);nadeAudio('he',pos,1.1);if(!playHZ('nade:he',d0>38?0.8:1.15,d0>38?0.92:1,pos)&&!npkPlay('hegrenade/hegrenade_explode',1.3,pos))sfx('boom',1,pos);
  blastPush(pos,7,9);
  if(net&&NET.role)netSendOrBroadcast({t:'bar',i:br.i,by:br.owner?br.owner.id:null});
  if(NET.role!=='client'){for(const e of S.ents){if(!e.alive)continue;const eye=new V3(e.pos.x,e.pos.y+1.0,e.pos.z),d=eye.distanceTo(pos);if(d>7.5)continue;
      const dir=eye.clone().sub(pos).normalize();raycaster.set(pos,dir);raycaster.far=d;const hit=raycaster.intersectObjects(worldMeshes,false);raycaster.far=Infinity;if(hit.length)continue;
      damage(e,110*(1-d/7.5),br.owner&&br.owner.alive!==undefined?br.owner:null,'he',false);}}
  barrelsBlast(pos,5.5,br.owner);winsBlast(pos,6.5);}
function barrelsBlast(pos,R,owner){if(!S.barrels)return;for(const o of S.barrels){if(o.dead)continue;const d=o.pos.distanceTo(pos);if(d<R){o.owner=o.owner||owner;if(o.fuse<0||o.fuse>0.25)barrelIgnite(o,0.12+d*0.04);}}}
function barrelNet(m,ent){const br=S.barrels&&S.barrels[m.i];if(!br||br.dead)return;br.owner=ent||null;barrelExplode(br,false);}
function updateBarrels(dt){if(!S.barrels||!S.barrels.length)return;for(const br of S.barrels){if(br.dead||br.fuse<0)continue;br.fuse-=dt;
  if(br.flame){const k=0.8+Math.sin(S.time*30+br.i)*0.2;br.flame.scale.set(0.55*k,0.95*k,1);}if(Math.random()<dt*14)particles(new V3(br.pos.x,1.3,br.pos.z),'spark',1,1.5);
  if(br.fuse<=0)barrelExplode(br,true);}}
function updateGloos(dt){if(!S.gloos||!S.gloos.length)return;for(let i=S.gloos.length-1;i>=0;i--){const w=S.gloos[i];if(w.dead){S.gloos.splice(i,1);continue;}w.age+=dt;const g=Math.min(1,w.age/0.28);for(const m of w.parts){m.scale.y=0.05+0.95*(1-Math.pow(1-g,3));m.position.y=w.pos.y+1.075*m.scale.y;}
  if(w.age>w.life){glooRemove(w);S.gloos.splice(i,1);}}}
/* ---------- medkit: full heal with a first-person animation (case up, lid flips open, syringe out, stab, plunger, case away) ---------- */
const MED_HOLD=3.4,MED_T=2.6+MED_HOLD,MED_COMMIT=1.72+MED_HOLD;
/* 6 s total: the quick moves keep their natural speed, the extra time is a slow injection (plunger 1.42→1.70 in animation time) */
function medA(e){if(e<1.42)return e;const P=0.28+MED_HOLD;if(e<1.42+P)return 1.42+(e-1.42)*0.28/P;return e-MED_HOLD;}
function medMax(){return S.mode==='br'?5:2;}
function startHeal(){const p=player;if(S.state!=='game'||S.ended||!p.alive||p.drop)return;
  if(p.healT>0)return;if((p.meds||0)<=0){center('No medkits',0.8);return;}if(p.hp>=hpMax()){center('Health already full',0.8);return;}
  if(p.planting>0||p.defusing>0)return;
  p.healT=MED_T;p.healDone=false;p.reloading=false;p.ads=false;p.sprinting=false;try{setScoped(false);}catch(e){}sfx('click');}
function cancelHeal(msg){const p=player;if(!(p.healT>0)||p.healDone)return false;p.healT=0;if(msg)center('Healing cancelled',0.6);return true;}
function updateHeal(p,dt){medHud();if(!(p.healT>0))return;
  if(!p.alive||S.state!=='game'){p.healT=0;return;}
  const el=MED_T-p.healT;
  if(!p.healDone&&mouse.down&&el>0.2){cancelHeal(true);return;}
  p.healT-=dt;const e2=MED_T-p.healT;
  if(e2>0.42&&!p._medLid){p._medLid=1;sfx('click');}
  if(!p.healDone&&e2>=MED_COMMIT){p.healDone=true;p.meds=Math.max(0,(p.meds||0)-1);medApply();}
  if(p.healT<=0){p.healT=0;p._medLid=0;}}
function medApply(){const p=player;const gain=Math.max(0,Math.round(hpMax()-p.hp));
  if(NET.role==='client')netToHost({t:'heal'});
  p.hp=hpMax();sfx('pickup');
  const fx=$('healFx');if(fx){fx.classList.remove('on');void fx.offsetWidth;fx.classList.add('on');}
  center('<span style="color:#7dff9b">+'+gain+' HP</span> · '+(p.meds||0)+' medkit'+((p.meds||0)===1?'':'s')+' left',1.1);}
let _medHudK='';
function medHud(){const el=$('medChip');if(!el)return;const n=(player.alive&&S.state==='game')?(player.meds||0):0;const k=n+'|'+(player.healT>0?1:0);if(k===_medHudK)return;_medHudK=k;
  el.classList.toggle('hidden',n<=0&&!(player.healT>0));el.classList.toggle('on',player.healT>0);const nn=$('medN');if(nn)nn.textContent='×'+n;}

/* ---- first-person model ---- */
const MEDVM={g:null,ag:null};
function medBuild(){const ag=(typeof save!=='undefined'&&save.agent)||'operator';if(MEDVM.g&&MEDVM.ag===ag)return MEDVM;
  if(MEDVM.g){vmRoot.remove(MEDVM.g);}
  const HM=handMats();const g=new THREE.Group();g.visible=false;vmRoot.add(g);MEDVM.g=g;MEDVM.ag=ag;MEDVM.tr=null;
  const red=gunMat(0xc4232b,40,'poly'),redD=gunMat(0x8e161c,30,'poly'),white=gunMat(0xf1efe8,20,'poly'),grey=gunMat(0x8d9399,70,'metal'),foam=gunMat(0xd9d5ca,6,'poly'),dark=gunMat(0x2a2c30,30,'poly'),orange=gunMat(0xe0861f,30,'poly');
  const bx=(par,w,h,d,mat,x,y,z)=>{const m=new THREE.Mesh(rbox(w,h,d,Math.min(w,h,d)*0.22,2),mat);m.position.set(x,y,z);par.add(m);return m;};
  const cy=(par,r,len,mat,x,y,z,rx=0,rz=0,seg=14)=>{const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,len,seg),mat);m.position.set(x,y,z);m.rotation.set(rx,0,rz);par.add(m);return m;};
  // case
  const K=new THREE.Group();g.add(K);MEDVM.K=K;
  K.scale.setScalar(0.88);
  bx(K,0.17,0.085,0.15,red,0,-0.0175,0);bx(K,0.172,0.008,0.152,redD,0,0.022,0);
  bx(K,0.06,0.017,0.003,white,0,-0.02,0.076);bx(K,0.017,0.06,0.003,white,0,-0.02,0.076);
  for(const sx of[-1,1])bx(K,0.018,0.012,0.006,grey,sx*0.052,0.017,0.0765);
  bx(K,0.16,0.004,0.14,foam,0,0.0235,0);
  cy(K,0.011,0.034,white,-0.052,0.032,-0.02,Math.PI/2,0);cy(K,0.0115,0.004,white,-0.052,0.032,-0.02,Math.PI/2,0).scale.set(0.6,1,0.6);
  cy(K,0.010,0.026,orange,0.052,0.036,0.03);cy(K,0.0105,0.008,white,0.052,0.052,0.03);
  bx(K,0.03,0.006,0.05,white,-0.052,0.028,0.035);
  // side handle (right side) + standoffs
  cy(K,0.0085,0.072,dark,0.105,-0.018,0);for(const dy of[-0.05,0.014])bx(K,0.026,0.012,0.014,dark,0.093,dy,0);
