  const sock=new THREE.Mesh(new THREE.ConeGeometry(0.4,2,10,1,true),new THREE.MeshLambertMaterial({color:0xff6a1a,side:THREE.DoubleSide}));sock.rotation.z=-Math.PI/2;const sg=new THREE.Group();sg.position.set(tx+(p.rot?3:-3),5.7,tz+(p.rot?-3:3));sock.position.x=1;sg.add(sock);sg.userData.noMerge=1;world.add(sg);
  let wt=rng()*6;S.wanim.push(dt=>{wt+=dt;sg.rotation.y=0.6+Math.sin(wt*0.7)*0.35;sock.rotation.x=Math.sin(wt*3.1)*0.08;});}
function poiBase(p){const x=p.x,z=p.z,H=22;const cw=pm(0xa8a294,{map:texConcrete});
  /* perimeter wall with two gates */
  for(const s of[-1,1]){solid(x-H/2-3.5,0,z+s*H,H-7,3,0.6,cw);solid(x+H/2+3.5,0,z+s*H,H-7,3,0.6,cw);solid(x+s*H,0,z,0.6,3,2*H,cw);}
  /* watch towers in the corners */
  for(const sx of[-1,1])for(const sz of[-1,1])brWatchTower(x+sx*(H-1.5),z+sz*(H-1.5),-sx,0);
  /* barracks (enterable), tents, containers and sandbags */
  brHouse(x-8,z-9,13,7,1,'flat1');brHouse(x+9,z+9,11,7,1,'flat1');
  for(const[tx,tz,r]of[[x+10,z-10,0],[x+3,z-12,1],[x-12,z+10,0]])brTent(tx,tz,r);
  container(x-2,z+4,0,0x3f6f3a,true);container(x+5,z-2,1,0x2f5f8a,false);container(x-14,z-1,1,0x8a3b2a,rng()<0.5);
  sandbags(x-4,z-3,4,true);sandbags(x+1,z+11,5,true);sandbags(x-H+3,z+H-5,4,false);
  for(let i=0;i<8;i++)brSpot(x+rand(-H+4,H-4),0.1,z+rand(-H+4,H-4));
  /* flag */
  const pole=new THREE.Mesh(new THREE.CylinderGeometry(0.07,0.07,9,8),pm(0xcccccc));brDeco(pole,x,4.5,z);
  const fl=new THREE.Mesh(new THREE.PlaneGeometry(2.6,1.5,8,1),new THREE.MeshLambertMaterial({map:brTex(128,72,(c,w,h)=>{c.fillStyle='#ff7a1a';c.fillRect(0,0,w,h);c.fillStyle='#1c1c1c';c.fillRect(0,h*0.38,w,h*0.24);c.fillStyle='#fff';c.beginPath();c.moveTo(w*0.42,h*0.5);c.lineTo(w*0.5,h*0.2);c.lineTo(w*0.58,h*0.5);c.lineTo(w*0.5,h*0.36);c.fill();}),side:THREE.DoubleSide}));
  fl.position.set(x+1.3,8.2,z);fl.userData.noMerge=1;world.add(fl);const P0=fl.geometry.attributes.position.array.slice();let ft=0;
  S.wanim.push(dt=>{ft+=dt;const a=fl.geometry.attributes.position;for(let i=0;i<a.count;i++){const px=P0[i*3];a.setZ(i,Math.sin(ft*4+px*2.2)*0.18*(px+1.3)/2.6);}a.needsUpdate=true;});
  brFlatRect(x,z,2*H,2*H);}
function poiHarbor(p){const x=p.x,z=p.z,th=p.th,cx=Math.cos(th),cz=Math.sin(th);
  /* container yard */
  const cols=[0x8a3b2a,0x2f5f8a,0x3f6f3a,0xb08a2a,0x6b4a8a,0xc0632a];
  for(let i=-1;i<=1;i++)for(let j=-1;j<=1;j++){if(i===0&&j===0)continue;container(x+i*9,z+j*5.5,0,cols[(i+2+j*3+9)%cols.length],rng()<0.55);}
  for(let i=0;i<8;i++)brSpot(x+rand(-12,12),0.1,z+rand(-9,9));
  /* gantry crane */
  const cr=pm(0xe0a21a),gx=x-cx*4,gz=z-cz*4;for(const s of[-1,1]){const lx=gx+(-cz)*s*5,lz=gz+cx*s*5;solid(lx,0,lz,0.8,16,0.8,cr);}
  const beam=new THREE.Mesh(new THREE.BoxGeometry(11.5,1,1),cr);beam.rotation.y=-Math.atan2(cx,-cz)+Math.PI/2;brDeco(beam,gx,16.5,gz);
  const boom=new THREE.Mesh(new THREE.BoxGeometry(0.8,0.8,26),cr);boom.rotation.y=Math.atan2(cx,cz);brDeco(boom,gx+cx*11,17.4,gz+cz*11);
  const cab=new THREE.Mesh(new THREE.BoxGeometry(2,1.8,2),pm(0x3a3f44));brDeco(cab,gx,15.4,gz);
  /* pier out into the sea (walkable deck tiles) */
  const R=islR(th);const deck=pm(0x7a5c3e),post=pm(0x4a3828);for(let d=-6;d<34;d+=2.4){const r=R+d,px=cx*r,pz=cz*r;solid(px,0,pz,2.6,0.45,2.6,deck);if(((d+6)/2.4|0)%2===0){const ps=new THREE.Mesh(new THREE.CylinderGeometry(0.16,0.16,3.4,6),post);brDeco(ps,px+(-cz)*1.25,-1.3,pz+cx*1.25,false);}}
  /* fishing boat bobbing at the end */
  const bx=cx*(R+31)+(-cz)*4,bz=cz*(R+31)+cx*4;const boat=new THREE.Group();const hull=new THREE.Mesh(new THREE.BoxGeometry(2.4,1.1,6.5),pm(0xe8e2d4));hull.position.y=0.1;boat.add(hull);
  const hs=new THREE.Mesh(new THREE.BoxGeometry(2.45,0.25,6.55),pm(0x2f5f8a));hs.position.y=-0.25;boat.add(hs);const wh=new THREE.Mesh(new THREE.BoxGeometry(1.6,1.3,1.8),pm(0xf2f0ea));wh.position.set(0,1.2,-1);boat.add(wh);
  boat.position.set(bx,-0.1,bz);boat.rotation.y=Math.atan2(cx,cz);boat.userData.noMerge=1;boat.traverse(o=>{if(o.isMesh)o.castShadow=true;});world.add(boat);let bt=rng()*6;S.wanim.push(dt=>{bt+=dt;boat.position.y=-0.1+Math.sin(bt*1.3)*0.08;boat.rotation.z=Math.sin(bt*0.9)*0.04;});
  /* warehouse (enterable) */
  brHouse(x+(-cz)*18,z+cx*18,12,9,1,'flat1');
  brFlatRect(x,z,30,20);}
function poiFarm(p){const x=p.x,z=p.z;const wood=pm(0x6d5338);
  brBarn(x,z);
  /* silo */
  const sm=pm(0xb9bcc0);const si=new THREE.Mesh(new THREE.CylinderGeometry(2.3,2.3,12,18),sm);brDeco(si,x+9,6,z-3);const dome=new THREE.Mesh(new THREE.SphereGeometry(2.3,18,10,0,Math.PI*2,0,Math.PI/2),sm);brDeco(dome,x+9,12,z-3);brCol(x+9,z-3,4.4,14,4.4);
  /* fields with crop rows + fences */
  if(!_fieldMat)_fieldMat=Lm({map:brTex(256,256,(c,w,h)=>{c.fillStyle='#6b4e32';c.fillRect(0,0,w,h);for(let i=0;i<16;i++){const g=i%2?'#7c9a3a':'#8fae45';c.fillStyle=g;c.fillRect(0,i*16+3,w,9);for(let k=0;k<60;k++){c.fillStyle='rgba(40,60,20,.4)';c.fillRect(Math.random()*w,i*16+3+Math.random()*9,3,3);}}},2,2),polygonOffset:true,polygonOffsetFactor:-2});
  for(const[fx,fz]of[[x-18,z+3],[x+2,z+19]]){const f=new THREE.Mesh(new THREE.PlaneGeometry(18,13),_fieldMat);f.rotation.x=-Math.PI/2;f.position.set(fx,0.026,fz);f.receiveShadow=true;f.userData.noMerge=1;world.add(f);brFlatRect(fx,fz,19,14);
    for(const s of[-1,1]){solid(fx,0,fz+s*6.8,18.5,1.0,0.12,wood);}solid(fx-9.2,0,fz,0.12,1.0,6,wood);
    for(let k=0;k<3;k++){const hb=new THREE.Mesh(new THREE.CylinderGeometry(0.75,0.75,1.3,14),pm(0xd8b860));hb.rotation.z=Math.PI/2;const hx=fx+rand(-6,6),hz=fz+rand(-4,4);brDeco(hb,hx,0.75,hz);brCol(hx,hz,1.4,1.5,1.5);}}
  /* water-pump windmill with turning blades */
  const wx=x-8,wz=z-12;for(const lx of[-1,1])for(const lz of[-1,1])solid(wx+lx*0.8,0,wz+lz*0.8,0.18,9,0.18,pm(0x8c9096),false);
  const hub=new THREE.Group();hub.position.set(wx,9.4,wz+0.6);const bm=pm(0xd9d6cf);for(let i=0;i<12;i++){const b=new THREE.Mesh(new THREE.BoxGeometry(0.3,1.7,0.05),bm);b.position.y=0.95;const arm=new THREE.Group();arm.rotation.z=i/12*Math.PI*2;arm.add(b);hub.add(arm);}
  hub.userData.noMerge=1;world.add(hub);const vane=new THREE.Mesh(new THREE.BoxGeometry(0.06,1.1,2.2),bm);brDeco(vane,wx,9.4,wz-1.3);S.wanim.push(dt=>{hub.rotation.z+=dt*1.6;});
  brSpot(x+3,0.1,z+4);brSpot(x-3,0.1,z-4);brSpot(x,0.1,z);}
function poiTown(p,kind){const x=p.x,z=p.z;
  if(kind==='town'){/* water tower in the square */const leg=pm(0x6d5338),tank=pm(0x8a9098);for(const lx of[-1,1])for(const lz of[-1,1])solid(x+lx*1.6,0,z+lz*1.6,0.3,8,0.3,leg);
    const tk=new THREE.Mesh(new THREE.CylinderGeometry(2.6,2.6,3.6,18),tank);brDeco(tk,x,9.8,z);const tr=new THREE.Mesh(new THREE.ConeGeometry(2.8,1.4,18),pm(0x5a6068));brDeco(tr,x,12.3,z);brCol(x,z,5.2,4,5.2,8);
    const sg=new THREE.Mesh(new THREE.PlaneGeometry(4,1),new THREE.MeshLambertMaterial({map:brTex(256,64,(c,w,h)=>{c.fillStyle='#8a9098';c.fillRect(0,0,w,h);c.fillStyle='#f4efe4';c.font='bold 40px Arial';c.textAlign='center';c.fillText(p.n.toUpperCase(),w/2,46);}),transparent:false}));sg.position.set(x,10,z+2.62);sg.userData.noMerge=1;world.add(sg);
    brFlatRect(x,z,12,12);}
  else if(kind==='town3'){/* market stalls around a fountain */const cols=[0xc0392b,0x2f7fbf,0xe0a21a,0x3f8f4a,0x8e44ad,0xd35400];
    const basin=new THREE.Mesh(new THREE.CylinderGeometry(2.6,2.8,0.8,22),pm(0xc9c2b2,{map:texConcrete}));brDeco(basin,x,0.4,z);brCol(x,z,5,0.8,5);
    const wat=new THREE.Mesh(new THREE.CircleGeometry(2.4,22),new THREE.MeshLambertMaterial({color:0x5fb6d8,transparent:true,opacity:0.85}));wat.rotation.x=-Math.PI/2;wat.position.set(x,0.75,z);wat.userData.noMerge=1;world.add(wat);
    const sp=new THREE.Mesh(new THREE.CylinderGeometry(0.25,0.4,1.8,10),pm(0xc9c2b2));brDeco(sp,x,1.5,z);
    for(let i=0;i<6;i++){const a=i/6*Math.PI*2,sx=x+Math.cos(a)*9,sz=z+Math.sin(a)*9;solid(sx,0,sz,2.6,1,1.4,pm(0x7a5c3e));
      for(const ox of[-1.2,1.2])solid(sx+ox,0,sz-0.6,0.1,2.4,0.1,pm(0x5b3a24),false);const cn=new THREE.Mesh(new THREE.BoxGeometry(3,0.12,2.2),pm(cols[i]));brDeco(cn,sx,2.45,sz);brSpot(sx,1.05,sz);}
    brFlatRect(x,z,22,22);}
  else{/* palm square with a well */for(let i=0;i<5;i++){const a=i/5*Math.PI*2+0.3;brSquareTree(x+Math.cos(a)*7,z+Math.sin(a)*7);}
    const well=new THREE.Mesh(new THREE.CylinderGeometry(1.1,1.2,0.9,16),pm(0x9a8f7e,{map:texConcrete}));brDeco(well,x,0.45,z);brCol(x,z,2.2,0.9,2.2);
    const rf=new THREE.Mesh(new THREE.ConeGeometry(1.6,1,4),pm(0x7a4a2a));rf.rotation.y=Math.PI/4;brDeco(rf,x,2.5,z);for(const s of[-1,1])solid(x+s*1,0,z,0.12,2.1,0.12,pm(0x5b3a24),false);
    brFlatRect(x,z,8,8);}}
function islBuildPOIs(){S.wanim=[];S.poiFlat=[];S.roads=[];S._mapHint=0;S._poiIn=null;const P=islPlacePOIs();S.pois=P;
  for(const p of P){try{if(p.k==='lighthouse')poiLighthouse(p);else if(p.k==='radio')poiRadio(p);else if(p.k==='airfield')poiAirfield(p);else if(p.k==='base')poiBase(p);else if(p.k==='harbor')poiHarbor(p);else if(p.k==='farm')poiFarm(p);else if(p.k==='plant')poiPlant(p);else poiTown(p,p.k);}catch(e){console.warn('poi',p.k,e);}}
  islRoads(P);for(const p of P)if(p.k==='plant'){try{plantFence(p);}catch(e){console.warn('fence',e);}}return P;}
/* pick where the next house goes: most land in the named places */
function islHouseSpot(R0){const P=S.pois||[];const tot=P.reduce((a,p)=>a+p.w,0);
  if(tot>0&&rng()<0.66){let t=rng()*tot,p=P[0];for(const q of P){t-=q.w;if(t<=0){p=q;break;}}const a=rng()*Math.PI*2,rr=(0.35+0.65*Math.sqrt(rng()))*p.r;return[p.x+Math.cos(a)*rr,p.z+Math.sin(a)*rr];}
  const a=rng()*Math.PI*2,rr=Math.sqrt(rng())*R0*0.92;return[Math.cos(a)*rr,Math.sin(a)*rr];}
/* per frame in Battle Royale: world animation + "entering <place>" */
function brPoiTick(dt){for(const f of S.wanim||[])try{f(dt);}catch(e){}
  if(!S._mapHint&&S.countdown<=0){S._mapHint=1;try{frToast('🗺 Island map: press M or tap the minimap',4500);}catch(e){}}
  const P=S.pois;if(!P||!player.alive||player.drop)return;S._poiT=(S._poiT||0)-dt;if(S._poiT>0)return;S._poiT=0.5;
  const q=P.find(p=>Math.hypot(player.pos.x-p.x,player.pos.z-p.z)<p.r+4);const id=q?q.n:null;
  if(id&&id!==S._poiIn){center('📍 '+id.toUpperCase(),1.6);}S._poiIn=id;}
/* ---- full-screen island map (M, or tap the minimap) ---- */
function bmapOpen(on){const el=$('bmap');if(!el)return;if(on===undefined)on=el.classList.contains('hidden');if(on&&!(S.state==='game'&&S.mode==='br'&&ISL))return;el.classList.toggle('hidden',!on);if(on)bmapDraw();}
function bmapDraw(){const el=$('bmap');if(!el||el.classList.contains('hidden'))return;const cv=$('bmapC');const sz=Math.min(innerWidth*0.9,(innerHeight-110)*0.92)|0;const dpr=Math.min(2,window.devicePixelRatio||1);
  if(cv.width!==sz*dpr){cv.width=cv.height=sz*dpr;cv.style.width=cv.style.height=sz+'px';}const c=cv.getContext('2d');c.setTransform(dpr,0,0,dpr,0,0);
  const ext=(mapH||215)*1.05,sc=sz/2/ext,X=x=>sz/2+x*sc,Z=z=>sz/2+z*sc;
  c.fillStyle='#174f6e';c.fillRect(0,0,sz,sz);
  const isl=(off,col)=>{c.fillStyle=col;c.beginPath();for(let i=0;i<=120;i++){const th=i/120*Math.PI*2,r=islR(th)+off;const px=X(Math.cos(th)*r),pz=Z(Math.sin(th)*r);i?c.lineTo(px,pz):c.moveTo(px,pz);}c.closePath();c.fill();};
  isl(3,'#3aa0b4');isl(0,'#dcc690');isl(-6,'#9aa36a');
  c.strokeStyle='rgba(120,92,60,.9)';c.lineWidth=Math.max(2,5.6*sc);for(const r of S.roads||[]){c.beginPath();c.moveTo(X(r.ax),Z(r.az));c.lineTo(X(r.bx),Z(r.bz));c.stroke();}
  c.fillStyle='rgba(70,52,36,.85)';for(const b of colliders){if(b.minY>0.5)continue;const w=(b.maxX-b.minX)*sc,d=(b.maxZ-b.minZ)*sc;if(w<0.6&&d<0.6)continue;c.fillRect(X(b.minX),Z(b.minZ),Math.max(1,w),Math.max(1,d));}
  const z=S.zone;if(z){c.fillStyle='rgba(30,90,200,.22)';c.beginPath();c.rect(0,0,sz,sz);c.arc(X(z.x),Z(z.z),Math.max(0,z.r)*sc,0,Math.PI*2,true);c.fill();
    c.strokeStyle='#4ea8ff';c.lineWidth=2.5;c.beginPath();c.arc(X(z.x),Z(z.z),Math.max(0,z.r)*sc,0,7);c.stroke();
    if(z.state==='wait'){c.strokeStyle='#fff';c.setLineDash([6,5]);c.lineWidth=2;c.beginPath();c.arc(X(z.tx),Z(z.tz),z.tr*sc,0,7);c.stroke();c.setLineDash([]);}}
  const P=BRF&&BRF.plane;if(P&&P.A&&P.B&&P.t<P.dur){c.strokeStyle='rgba(255,255,255,.75)';c.setLineDash([10,8]);c.lineWidth=2;c.beginPath();c.moveTo(X(P.A.x),Z(P.A.z));c.lineTo(X(P.B.x),Z(P.B.z));c.stroke();c.setLineDash([]);
    c.fillStyle='#fff';c.beginPath();c.arc(X(P.pos.x),Z(P.pos.z),5,0,7);c.fill();}
  c.textAlign='center';c.textBaseline='middle';{const fs=Math.max(11,Math.min(16,sz/48)),boxes=[];c.font=`800 ${fs}px system-ui,sans-serif`;
    for(const q of S.pois||[]){const t=q.n.toUpperCase(),w=c.measureText(t).width+8,h=fs+6;let lx=X(q.x),ly=Z(q.z);
      for(const dy of[0,-h,h,-2*h,2*h]){const y=Z(q.z)+dy;if(!boxes.some(b=>Math.abs(b.x-lx)<(b.w+w)/2&&Math.abs(b.y-y)<(b.h+h)/2)){ly=y;break;}}boxes.push({x:lx,y:ly,w,h});
      c.fillStyle='rgba(255,255,255,.9)';c.beginPath();c.arc(X(q.x),Z(q.z),2.5,0,7);c.fill();c.lineWidth=4;c.strokeStyle='rgba(0,0,0,.65)';c.strokeText(t,lx,ly-(ly===Z(q.z)?fs*0.8:0));c.fillStyle='#fff';c.fillText(t,lx,ly-(ly===Z(q.z)?fs*0.8:0));}}
  for(const b of S.bots||[]){if(!b.alive||b.team!==player.team)continue;c.fillStyle=b.human?'#7dff9b':'#4ea8ff';c.beginPath();c.arc(X(b.pos.x),Z(b.pos.z),5,0,7);c.fill();}
  const p=player;c.save();c.translate(X(p.pos.x),Z(p.pos.z));c.rotate(-p.yaw+Math.PI);c.fillStyle='#ffd34d';c.strokeStyle='#000';c.lineWidth=1.5;c.beginPath();c.moveTo(0,-9);c.lineTo(-6,7);c.lineTo(0,3);c.lineTo(6,7);c.closePath();c.fill();c.stroke();c.restore();
  $('bmapT').textContent=z?('Phase '+Math.min(z.phase+1,ZP.length)+'/'+ZP.length+' · '+(z.state==='shrink'?'zone closing':z.state==='wait'?'zone shrinks in '+fmtTime(z.t):'zone closed')+' · '+fmtTime(zoneMatchLeft())+' left'):'';}
setInterval(()=>{try{bmapDraw();}catch(e){}},250);

function buildIsland(H){clearWorld();mapH=H;S.houseSpots=[];_bgGlass=[];
  ISL={R0:H*0.83,A:[0.07+rng()*0.03,0.04+rng()*0.025,0.02+rng()*0.02],P:[rng()*6.28,rng()*6.28,rng()*6.28]};
  islTerrain();islOcean();
  islBuildPOIs();
  // houses: villages of 1- and 2-storey enterable houses, mostly in the named places
  const placed=[];const K=(H/150)*(H/150)*(H>300?0.72:H>220?0.85:1);/* big islands: slightly lower density keeps them smooth */const want=Math.round(42*K);
  const inTown=(x,z)=>(S.pois||[]).some(p=>/^town/.test(p.k)&&Math.hypot(x-p.x,z-p.z)<p.r*0.85);
  for(let i=0;i<want*20&&placed.length<want;i++){const two=rng()<0.4;const[x,z]=islHouseSpot(ISL.R0);const town=inTown(x,z);
    let F=two?2:1,w=two?rand(8.6,11):rand(6.5,10),d=two?rand(7.5,9.5):rand(6,9);if(town&&rng()<0.3){F=3;w=rand(11.2,13.5);d=rand(8.2,9.6);}if(rng()<0.5){const q=w;w=d;d=q;}
    const comp=F<3&&rng()<(town?0.18:0.5),m=comp?3.3:0,ew=w+2*m,ed=d+2*m;
    if(brFlat(x,z,Math.max(ew,ed)/2+2.5)||blocked(x,z,Math.max(ew,ed)/2+1.5))continue;
    if(!islIn(x-ew/2,z-ed/2,12)||!islIn(x+ew/2,z+ed/2,12)||!islIn(x-ew/2,z+ed/2,12)||!islIn(x+ew/2,z-ed/2,12))continue;
    if(placed.some(p=>Math.abs(p.x-x)<(p.w+ew)/2+4&&Math.abs(p.z-z)<(p.d+ed)/2+4))continue;
    const arch=bgArch(F,town);placed.push({x,z,w:ew,d:ed,a:arch,F,c:comp});try{const r=bgHouse(x,z,w,d,F,arch);placed[placed.length-1].tst=r.tst;if(comp)bgCompound(r,m);}catch(e){console.warn('house',e);}}
  S.brHouses=placed;
  // cover between houses
  for(let i=0;i<110*K;i++){const s=islSpot(8,1.6);if(!s)continue;const r=rng();crate(s[0],s[1]);if(r<0.3)solid(s[0],1.1,s[1],0.85,0.85,0.85,MAT.crate);else if(r<0.55&&!blocked(s[0]+1.15,s[1],0.6))crate(s[0]+1.15,s[1]+rand(-0.2,0.2));}
  for(let i=0;i<34*K;i++){const s=islSpot(10,4);if(!s)continue;const len=rand(3,7),hor=rng()<.5;solid(s[0],0,s[1],hor?len:0.5,1.15,hor?0.5:len,MAT.ledge);}
  // palms along the beach, theme trees and bushes inland, rocks on the shore
  for(let i=0;i<70*H/150;i++){const th=rng()*Math.PI*2,rel=-(3+rng()*9),r=islR(th)+rel;const x=Math.cos(th)*r,z=Math.sin(th)*r;if(blocked(x,z,2))continue;brShoreTree(x,z);}
  for(let i=0;i<70*K;i++){const s=islSpot(16,2.5);if(s)islTree(s[0],s[1]);}
  for(let i=0;i<7*K;i++){const s=islSpot(22,6);if(!s)continue;const n=5+(rng()*6|0);for(let j=0;j<n;j++){const a=rng()*6.28,r=2.5+rng()*9;const tx=s[0]+Math.cos(a)*r,tz=s[1]+Math.sin(a)*r;if(!islIn(tx,tz,14)||blocked(tx,tz,2.2)||brFlat(tx,tz,2))continue;islTree(tx,tz);}}
  _clutter=true;for(let i=0;i<90*K;i++){const s=islSpot(6,1);if(s)bush(s[0],s[1]);}
  const rockM=pm(0x8a8579);for(let i=0;i<40*H/150;i++){const th=rng()*Math.PI*2,rel=-1+rng()*4,r=islR(th)+rel;const x=Math.cos(th)*r,z=Math.sin(th)*r;const s=0.4+rng()*1.1;
    const m=new THREE.Mesh(new THREE.DodecahedronGeometry(s,0),rockM);m.position.set(x,islBeachY(rel)+s*0.35,z);m.rotation.set(rng()*3,rng()*3,rng()*3);m.scale.y=0.6;m.castShadow=m.receiveShadow=true;m.userData.clutter=1;world.add(m);}
  _clutter=false;try{bgGlassFlush();}catch(e){}try{grassInit();}catch(e){console.warn('grass',e);}}
function botGround(b,dt){const gy=groundAt(b.pos.x,b.pos.z,b.pos.y,0.3);if(gy>=b.pos.y-0.02){b.pos.y=gy;b.vy=0;return;}b.vy=(b.vy||0)-22*dt;b.pos.y+=b.vy*dt;if(b.pos.y<=gy){b.pos.y=gy;b.vy=0;}}
/* ================= RANKED =================
   Separate from level: unlocks at level 20. Two ladders (Battle Royale, Team Deathmatch), each with its own
   rank points (RP). Online and bot matches both count; bot matches give 60% RP. */
const RANK_UNLOCK=20;
const RTIERS=[['Bronze',3,'#c07a3e'],['Silver',3,'#b8c4ce'],['Gold',4,'#f2c14e'],['Platinum',4,'#4fd1c5'],['Diamond',4,'#7aa8ff'],['Heroic',1,'#ff5a7a'],['Legend',1,'#ffcc33']];
const RK_MODES={br:{name:'Battle Royale',icon:'◍'},tdm:{name:'Team Deathmatch',icon:'⚑'}};
const ROMAN=['I','II','III','IV'];
function rkInfo(rp){rp=Math.max(0,rp|0);let lo=0;for(let ti=0;ti<RTIERS.length;ti++){const[n,d,c]=RTIERS[ti];const span=ti===5?800:d*100;
    if(ti===RTIERS.length-1||rp<lo+span){const div=d>1?Math.min(d-1,Math.floor((rp-lo)/100)):0;const dlo=lo+div*100,dhi=d>1?dlo+100:lo+span;
      const name=d>1?n+' '+ROMAN[div]:n;const nxt=ti===RTIERS.length-1?null:(d>1&&div<d-1?n+' '+ROMAN[div+1]:(RTIERS[ti+1][1]>1?RTIERS[ti+1][0]+' I':RTIERS[ti+1][0]));
      return{ti,div,name,tier:n,color:c,lo:dlo,hi:ti===RTIERS.length-1?null:dhi,next:nxt,rp};}
    lo+=span;}}
function rkData(m){save.ranked=save.ranked||{};const r=save.ranked[m]||(save.ranked[m]={rp:0,peak:0,played:0,wins:0});return r;}
function rkUnlocked(){return (save.level|0)>=RANK_UNLOCK;}
function rkDiff(m){const ti=rkInfo(rkData(m).rp).ti;return ti===0?'easy':ti<=2?'normal':'hard';}
/* rank emblem: tier-coloured hexagon, chevrons for the division, star for Heroic, crown for Legend */
let _rkBid=0;function rkBadge(rp,size=40){const I=rkInfo(rp),c=I.color,gid='rkg'+(++_rkBid);let inner='';
  if(I.ti<5){const n=I.div+1;for(let k=0;k<n;k++){const y=26-k*6+(n-1)*3;inner+=`<path d="M12 ${y} L20 ${y-5} L28 ${y}" fill="none" stroke="#14100a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>`;}
    if(I.ti>=3)inner+=`<circle cx="20" cy="9" r="2.4" fill="#14100a"/>`;if(I.ti>=4)inner+=`<circle cx="13" cy="11" r="1.8" fill="#14100a"/><circle cx="27" cy="11" r="1.8" fill="#14100a"/>`;}
  else if(I.ti===5)inner=`<path d="M20 9 L23.5 17 L32 17.5 L25.5 23 L27.5 31.5 L20 27 L12.5 31.5 L14.5 23 L8 17.5 L16.5 17 Z" fill="#14100a"/>`;
  else inner=`<path d="M9 28 L11 13 L16 20 L20 10 L24 20 L29 13 L31 28 Z" fill="#14100a"/><rect x="9" y="29.5" width="22" height="3" rx="1" fill="#14100a"/>`;
  return `<svg width="${size}" height="${size*1.1}" viewBox="0 0 40 44"><defs><linearGradient id="${gid}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".55"/><stop offset=".45" stop-color="${c}"/><stop offset="1" stop-color="${c}" stop-opacity=".75"/></linearGradient></defs><path d="M20 2 L37 11.5 L37 31.5 L20 42 L3 31.5 L3 11.5 Z" fill="url(#${gid})" stroke="rgba(0,0,0,.45)" stroke-width="1.6"/><path d="M20 6 L33.5 13.5 L33.5 29.5 L20 38 L6.5 29.5 L6.5 13.5 Z" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="1"/>${inner}</svg>`;}
/* RP for one match. BR: placement + kills. TDM: win/loss + performance. Higher tiers gain less and lose more. */
function rkCalc(m,o){const I=rkInfo(rkData(m).rp);let base=0;const lines=[];
  if(m==='br'){const pl=o.place||35;const P=pl===1?40:pl===2?32:pl===3?27:pl<=5?20:pl<=10?12:pl<=18?4:-6;lines.push(['Placement #'+pl,P]);const K=Math.min(8,o.kills|0)*4;if(K)lines.push(['Kills ×'+Math.min(8,o.kills|0),K]);base=P+K;}
  else{const W=o.win?24:-18;lines.push([o.win?'Victory':'Defeat',W]);const perf=clamp(((o.kills|0)-(o.deaths|0))*2,-8,10);if(perf)lines.push(['Performance (K−D)',perf]);const mvp=o.mvp?4:0;if(mvp)lines.push(['Team MVP',mvp]);base=W+perf+mvp;}
  let d=base>0?base*(1-I.ti*0.05):base*(1+I.ti*0.12);
  if(o.bots){d*=0.6;lines.push(['Vs bots ×0.6',null]);}
  if(I.ti===0&&d<0)d*=0.5;
  return{delta:Math.round(d),lines};}
function rkApply(m,delta,won){const R=rkData(m);const before=R.rp;R.rp=Math.max(0,R.rp+delta);R.peak=Math.max(R.peak,R.rp);R.played++;if(won)R.wins++;persist();return{before,after:R.rp};}
/* called from finish() */
function rkFinish(win,place){if(!S.ranked)return '';const m=S.ranked;const p=player;let mvp=false;
  if(m==='tdm'){const mates=S.ents.filter(e=>e.team===p.team);mvp=mates.every(e=>e===p||(e.kills|0)<=(p.kills|0))&&(p.kills|0)>0;}
  const C=rkCalc(m,{win,place,kills:p.kills,deaths:p.deaths,mvp,bots:!NET.role});const pk0=rkPeak();const A=rkApply(m,C.delta,m==='br'?place===1:win);S.rankedDone=1;const newRew=RK_REW.filter(R=>pk0<R.rp&&rkPeak()>=R.rp);
  const I0=rkInfo(A.before),I1=rkInfo(A.after);const up=I1.rp>I0.rp&&I1.name!==I0.name,down=I1.rp<I0.rp&&I1.name!==I0.name;
  const pct=I1.hi?((I1.rp-I1.lo)/(I1.hi-I1.lo)*100):100;
  return `<div class="rkres"><div class="rkres-h">${rkBadge(A.after,46)}<div style="flex:1"><div class="rkres-t">RANKED · ${RK_MODES[m].name.toUpperCase()}</div><div class="rkres-n" style="color:${I1.color}">${I1.name}</div>
    <div class="xpbar rkbar"><i style="width:${pct.toFixed(1)}%;background:${I1.color}"></i></div><div class="rkres-s">${I1.rp} RP${I1.hi?' · '+(I1.hi-I1.rp)+' RP to '+I1.next:''}</div></div>
    <div class="rkres-d ${C.delta>=0?'pos':'neg'}">${C.delta>=0?'+':''}${C.delta} RP</div></div>
    <div class="rkres-l">${C.lines.map(([k,v])=>`<span>${k}${v===null?'':` <b>${v>0?'+':''}${v}</b>`}</span>`).join('')}</div>
    ${up?`<div class="up">▲ RANK UP · ${I1.name.toUpperCase()}</div>`:down?`<div class="up" style="color:#ff7a6a">▼ ${I1.name.toUpperCase()}</div>`:''}${newRew.length?`<div class="up" style="color:#ffd34d">🎁 RANK REWARD UNLOCKED · ${newRew.map(r=>r.n.toUpperCase()).join(', ')} · CLAIM IT IN RANKS</div>`:''}</div>`;}
/* leaving a ranked match early costs RP */
function rkAbandon(){if(!S.ranked||S.rankedDone||S.state!=='game'||S.ended)return;S.rankedDone=1;const m=S.ranked;const d=-Math.round(15*(NET.role?1:0.6));rkApply(m,d,false);try{frToast(`Left a ranked match: ${d} RP (${RK_MODES[m].name})`,4500);}catch(e){}}
/* ---- rank rewards (0.89): from Platinum up, ranks give a character, redeem codes and skins (based on PEAK rank) ---- */
const RK_REW=[
 {id:'plat1',rp:1000,n:'Platinum I',r:[{t:'code',c:'PLAT-7K2Q',x:'+400 coins'}]},
 {id:'plat2',rp:1100,n:'Platinum II',r:[{t:'skin',w:'ak47',p:'neon'}]},
 {id:'plat3',rp:1200,n:'Platinum III',r:[{t:'agent',a:'owl'}]},
 {id:'plat4',rp:1300,n:'Platinum IV',r:[{t:'code',c:'PLAT-4M9X',x:'+800 coins'}]},
 {id:'dia1',rp:1400,n:'Diamond I',r:[{t:'skin',w:'m4a4',p:'case_hardened',f:'crimson'}]},
 {id:'dia2',rp:1500,n:'Diamond II',r:[{t:'agent',a:'fox'}]},
 {id:'dia3',rp:1600,n:'Diamond III',r:[{t:'code',c:'DIAM-9X4M',x:'+1500 coins'}]},
 {id:'dia4',rp:1700,n:'Diamond IV',r:[{t:'skin',w:'awp',p:'doppler',f:'cobalt'}]},
 {id:'hero',rp:1800,n:'Heroic',r:[{t:'agent',a:'fang'},{t:'code',c:'HERO-3R8T',x:'+2500 coins'}]},
 {id:'legend',rp:2600,n:'Legend',r:[{t:'agent',a:'gold'},{t:'skin',w:'ak47',p:'gold'},{t:'code',c:'LGND-5V1W',x:'+5000 coins'}]}];
function rkPeak(){return Math.max(rkData('br').peak|0,rkData('tdm').peak|0);}
function rkClaimable(){const cl=save.rkClaimed||[],pk=rkPeak();return rkUnlocked()?RK_REW.filter(R=>pk>=R.rp&&!cl.includes(R.id)):[];}
function rkSkinPaint(p){return PAINTS[p.p]?p.p:(p.f&&PAINTS[p.f]?p.f:null);}
function rkClaim(id){const R=RK_REW.find(x=>x.id===id);save.rkClaimed=save.rkClaimed||[];if(!R||!rkUnlocked()||rkPeak()<R.rp||save.rkClaimed.includes(id))return false;
  for(const p of R.r){
    if(p.t==='agent'){if(AGENTS[p.a]&&!save.items.some(i=>i.k==='agent'&&i.a===p.a))addItem({k:'agent',a:p.a});}
    else if(p.t==='skin'){const pt=rkSkinPaint(p);if(pt&&WEAPONS[p.w]&&!ownsSkin(p.w,pt))addItem({k:'skin',w:p.w,p:pt});}
    else if(p.t==='code'){save.rkCodes=save.rkCodes||[];if(!save.rkCodes.includes(p.c))save.rkCodes.push(p.c);}}
  save.rkClaimed.push(id);persist();try{sfx('levelup');}catch(e){}try{frToast('Rank reward claimed: '+R.n,3500);}catch(e){}renderRanks();return true;}
function rkRewardsHTML(){const pk=rkPeak(),ok=rkUnlocked(),cl=save.rkClaimed||[],rd=save.redeemed||[];
  const rows=RK_REW.map(R=>{const done=cl.includes(R.id),can=ok&&pk>=R.rp&&!done,I=rkInfo(R.rp);
    const parts=R.r.map(p=>{
      if(p.t==='agent'){const A=AGENTS[p.a];return A?`<span class="rkp"><i>🪖</i>Character <b>${A.n}</b></span>`:'';}
      if(p.t==='skin'){const pt=rkSkinPaint(p);return pt&&WEAPONS[p.w]?`<span class="rkp"><i>🎨</i><b>${WEAPONS[p.w].name}</b> | ${PAINTS[pt].n}</span>`:'';}
      if(done)return `<span class="rkp code"><i>🎟</i><b>${p.c}</b> ${p.x} <button class="btn" data-rkcopy="${p.c}">COPY</button>${rd.includes(p.c)?'<em style="color:#6fd98a;font-style:normal"> ✓ redeemed</em>':`<button class="btn pri" data-rkredeem="${p.c}">REDEEM</button>`}</span>`;
      return `<span class="rkp"><i>🎟</i>Redeem code <b>${p.x}</b></span>`;}).join('');
    return `<div class="rkrw ${done?'done':can?'can':'lock'}"><span>${rkBadge(R.rp,30)}</span><div class="rkrw-m"><div class="rkrw-n" style="color:${I.color}">${R.n}</div><div class="rkrw-p">${parts}</div></div><div class="rkrw-a">${done?'<span class="rkrw-d">Claimed ✓</span>':can?`<button class="btn pri" data-rkclaim="${R.id}">CLAIM</button>`:`<span class="rkrw-l">🔒 ${R.rp} RP</span>`}</div></div>`;}).join('');
  return `<h3 class="rksec">RANK REWARDS</h3><div class="note" style="margin:4px 0 8px">Reach <b>Platinum</b> and keep climbing to earn a character, redeem codes and skins. Rewards use your <b>peak</b> rank in either ladder, so you keep them if you drop. Your peak: <b style="color:${rkInfo(pk).color}">${rkInfo(pk).name}</b></div>${rows}`;}
if($('rankList'))$('rankList').addEventListener('click',e=>{const b=e.target.closest('[data-rkclaim],[data-rkredeem],[data-rkcopy]');if(!b)return;
  if(b.dataset.rkclaim){rkClaim(b.dataset.rkclaim);return;}
  if(b.dataset.rkcopy){try{navigator.clipboard.writeText(b.dataset.rkcopy);frToast('Code copied: '+b.dataset.rkcopy,2500);}catch(err){}return;}
  if(b.dataset.rkredeem){const ok=redeemCode(b.dataset.rkredeem);try{const m=$('rdMsg');frToast(ok?'Code redeemed':(m&&m.textContent)||'Could not redeem',3000);}catch(err){}renderRanks();}});
/* ---- ranked picker ---- */
function openRanked(){if(!rkUnlocked()){center(`<span style="color:#ffd34d">Ranked unlocks at Level ${RANK_UNLOCK}</span><br><small>You are level ${save.level}</small>`,2.2);sfx('deny');return;}renderRankedPick();$('rkPick').classList.remove('hidden');sfx('click');}
function renderRankedPick(){const el=$('rkCards');if(!el)return;
  el.innerHTML=Object.entries(RK_MODES).map(([m,M])=>{const R=rkData(m),I=rkInfo(R.rp),pct=I.hi?(R.rp-I.lo)/(I.hi-I.lo)*100:100,wr=R.played?Math.round(R.wins/R.played*100):0;
    return `<div class="rkc"><div class="rkc-h">${rkBadge(R.rp,56)}<div><div class="rkc-m">${M.icon} ${M.name.toUpperCase()}</div><div class="rkc-n" style="color:${I.color}">${I.name}</div><div class="rkc-s">${R.rp} RP${I.hi?' · next: '+I.next:' · top tier'}</div></div></div>
      <div class="xpbar rkbar"><i style="width:${pct.toFixed(1)}%;background:${I.color}"></i></div>
      <div class="rkc-st"><span><b>${R.played}</b> played</span><span><b>${R.wins}</b> ${m==='br'?'Booyah!':'wins'}</span><span><b>${wr}%</b></span><span>bots: <b>${rkDiff(m)}</b></span></div>
      <div class="rkc-b"><button class="btn pri" data-rk="${m}" data-v="bots">Play vs Bots</button><button class="btn" data-rk="${m}" data-v="online">Play Online</button></div></div>`;}).join('');
  const st=$('rkRewStrip');if(st){const n=rkClaimable().length,pk=rkPeak(),nx=RK_REW.find(R=>pk<R.rp);st.innerHTML=`<span>🎁 <b>Rank rewards</b>: ${n?`<b style="color:#ffd34d">${n} ready to claim</b>`:nx?`next at <b>${nx.n}</b>`:'all earned'}. Platinum and up gives a character, codes and skins.</span><button class="btn pri" id="rkRew">View rewards</button>`;const b=$('rkRew');if(b)b.onclick=()=>{$('rkPick').classList.add('hidden');showTab('ranks');};}}
function rankedStart(m,how){$('rkPick').classList.add('hidden');if(!rkUnlocked())return;
  if(gangPlay(m,m==='tdm'?'5v5':null,true))return;
  if(how==='online'){hostRoom(m,m==='tdm'?'5v5':null,true);return;}
  startMatch(m,{ranked:m,fmt:m==='tdm'?'5v5':null});}

/* ================= MAP VOTE (Versus) =================
   Before a Versus match everyone votes for a map (or Random). 10 s timer, ends early when everyone has voted.
   Offline: bots vote too. Online: the host runs the vote and relays every vote to the clients. */
const MV={on:false,votes:{},roster:[],t:0,end:0,o:null,raf:0,done:false};
const MV_DUR=10;
function mvMaps(){return['random',...MAP_IDS];}
function mvName(id){return id==='random'?'Random':(MAPS[id]?MAPS[id].n:id);}
function mvIsVersus(mode,fmt,ranked){return !ranked&&(mode==='duel'||(mode==='tdm'&&!!fmtParse(fmt)));}
/* who takes part: [{id,name,team:'A'|'B',me,bot}] */
function mvRosterOffline(fmt){const F=fmtParse(fmt)||[1,1];const nm=NAMES.slice().sort(()=>Math.random()-0.5);let k=0;
  const r=[{id:'me',name:myName(),team:'A',me:true}];
  for(let i=1;i<F[0];i++)r.push({id:'b'+k,name:nm[k++%nm.length],team:'A',bot:true});
  for(let i=0;i<F[1];i++)r.push({id:'b'+k,name:nm[k++%nm.length],team:'B',bot:true});return r;}
function mvRosterHost(){const T=lobbyTeams(NET.mode);const F=NET.mode==='tdm'&&fmtParse(NET.fmt);
  const r=NET.roster.map((x,i)=>({id:x.id,name:x.name,team:T?(x.team===T[1]?'B':'A'):(i===0?'A':'B')}));
  if(NET.fill){const want=F?{A:F[0],B:F[1]}:{A:1,B:1};const nm=NAMES.slice().sort(()=>Math.random()-0.5);let k=0;
    for(const tm of['A','B'])while(r.filter(x=>x.team===tm).length<want[tm])r.push({id:'b'+k,name:nm[k++%nm.length],team:tm,bot:true});}
  return r;}
function mvAv(p){return `<img class="mv-av${p.me?' me':''}" src="${avatarUrl(p.name,!!p.me)}" alt="" title="${esc(p.name)}">`;}
function mvBuild(){
  $('mvGrid').innerHTML=mvMaps().map(id=>{const th=id==='random'?'':((window.CR_MVT&&CR_MVT[id])||'');
    return `<button class="mv-tile${id==='random'?' rnd':''}" data-m="${id}">${th?`<img class="mv-img" src="${th}" alt="">`:''}${id==='random'?'<div class="mv-rnd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg></div>':''}<div class="mv-vot"></div><div class="mv-cnt"></div><div class="mv-nm">${esc(mvName(id))}</div></button>`;}).join('');
  mvTeams();}
function mvTeams(){const R=MV.roster;
  const side=t=>R.filter(p=>p.team===t).map(p=>`<span class="mv-ps${MV.votes[p.id]?' v':''}">${mvAv(p)}</span>`).join('');
  $('mvA').innerHTML=side('A');$('mvB').innerHTML=side('B');}
function mvRender(){const by={};for(const id in MV.votes){(by[MV.votes[id]]=by[MV.votes[id]]||[]).push(MV.roster.find(p=>p.id===id));}
  const mine=MV.votes[MV.o&&MV.o.myId];
  document.querySelectorAll('#mvGrid .mv-tile').forEach(el=>{const m=el.dataset.m,L=(by[m]||[]).filter(Boolean);
    el.classList.toggle('mine',mine===m);el.querySelector('.mv-vot').innerHTML=L.slice(0,6).map(mvAv).join('');
    const c=el.querySelector('.mv-cnt');c.textContent=L.length?L.length:'';c.classList.toggle('on',L.length>0);});
  mvTeams();}
function mvVote(id,m){if(!MV.on||MV.done)return;if(!mvMaps().includes(m))return;if(!MV.roster.find(p=>p.id===id))return;
  MV.votes[id]=m;mvRender();
  if(MV.o.net==='host')netBroadcast({t:'mvs',votes:MV.votes});
  if(MV.o.net!=='client'&&Object.keys(MV.votes).length>=MV.roster.length)MV.end=Math.min(MV.end,performance.now()+1500);}
function mvTick(){if(!MV.on)return;const left=Math.max(0,(MV.end-performance.now())/1000);
  const el=$('mvT');const v=left.toFixed(1);if(el.textContent!==v)el.textContent=v;el.classList.toggle('low',left<3);
  if(left<=0&&!MV.done&&MV.o.net!=='client'){mvFinish();return;}
  MV.raf=requestAnimationFrame(mvTick);}
/* pick the winner: most votes, ties broken at random; "Random" picks any map */
function mvWinner(){const c={};for(const id in MV.votes)c[MV.votes[id]]=(c[MV.votes[id]]||0)+1;
  const ks=Object.keys(c);if(!ks.length)return{tile:'random',map:pick(MAP_IDS)};
  const top=Math.max(...ks.map(k=>c[k]));const best=ks.filter(k=>c[k]===top);const tile=pick(best);
  return{tile,map:tile==='random'?pick(MAP_IDS):tile};}
function mvFinish(){if(MV.done)return;const W=mvWinner();if(MV.o.net==='host')netBroadcast({t:'mvend',tile:W.tile,map:W.map});mvShowWin(W.tile,W.map);}
function mvShowWin(tile,map){MV.done=true;cancelAnimationFrame(MV.raf);$('mvT').textContent='0.0';
  document.querySelectorAll('#mvGrid .mv-tile').forEach(el=>{el.classList.toggle('win',el.dataset.m===tile);el.classList.toggle('lose',el.dataset.m!==tile);});
  $('mvHint').innerHTML=`<b>${esc(mvName(map).toUpperCase())}</b>${tile==='random'?' · picked at random':''}`;sfx('buy');
  const o=MV.o;setTimeout(()=>{mvClose();if(o.net!=='client'&&o.onDone)o.onDone(map);},1700);}
function mvClose(){MV.on=false;cancelAnimationFrame(MV.raf);for(const t of MV.bt||[])clearTimeout(t);MV.bt=[];$('mvote').classList.add('hidden');}
/* o: {net:null|'host'|'client', roster, myId, dur, onDone(map)} */
function openMapVote(o){mvClose();MV.o=o;MV.on=true;MV.done=false;MV.votes={};MV.roster=o.roster;MV.bt=[];
  MV.end=performance.now()+(o.dur||MV_DUR)*1000;$('mvHint').textContent='Click a map to vote';
  mvBuild();mvRender();$('mvote').classList.remove('hidden');if(document.pointerLockElement)document.exitPointerLock();
  if(o.net!=='client')for(const p of MV.roster)if(p.bot){MV.bt.push(setTimeout(()=>{if(!MV.on||MV.done)return;
      const L=mvMaps();mvVote(p.id,Math.random()<0.18?'random':(Math.random()<0.35&&Object.keys(MV.votes).length?MV.votes[pick(Object.keys(MV.votes))]:pick(L.slice(1))));},700+Math.random()*5200));}
  sfx('click');mvTick();}
/* offline Versus: vote, then start */
function versusStart(f){const mode=fmtMode(f);
  openMapVote({net:null,roster:mvRosterOffline(f),myId:'me',onDone:map=>{initAudio();startMatch(mode,{fmt:f,map});}});}
$('mvGrid').addEventListener('click',e=>{const t=e.target.closest('.mv-tile');if(!t||!MV.on||MV.done)return;const m=t.dataset.m;
  if(MV.o.net==='client'){netToHost({t:'mv',m});MV.votes[MV.o.myId]=m;mvRender();}else mvVote(MV.o.myId,m);sfx('click');});
document.addEventListener('keydown',e=>{if(e.code==='Escape'&&MV.on&&!MV.o.net){mvClose();if(S.state==='game')toMenu();}});


/* ===== GUN UNLOCKS: buy guns with coins in the Armory. Starters are free; practice range lets you try anything. ===== */
const GUN_FREE=['glock','usp','p2000','p250','ak47','m4a4','m4a1s','awp','mp9','mac10'];
function gunCost(id){const w=WEAPONS[id];return w?200+Math.max(100,Math.round((w.price||1000)*0.1/25)*25):0;}
function ownedGuns(){if(!Array.isArray(save.gunsOwned)){const o=new Set(GUN_FREE);
    try{const W=(save.an&&save.an.w)||{};for(const id in W)if(GUN_IDS.includes(id)&&(W[id].k|0)>0)o.add(id);}catch(e){}
    for(const it of save.items||[])if(it.k==='skin'&&GUN_IDS.includes(it.w))o.add(it.w);
    save.gunsOwned=[...o];try{persist();}catch(e){}}
  return save.gunsOwned;}
function gunOwned(id){return !GUN_IDS.includes(id)||ownedGuns().includes(id);}
function buyGun(id){if(gunOwned(id))return true;const c=gunCost(id);
  if((save.coins|0)<c){center(`<span style="color:#ff7a6a">Not enough coins</span><br><small>You need ⛃ ${c-(save.coins|0)} more</small>`,1.6);sfx('deny');return false;}
  save.coins-=c;ownedGuns().push(id);persist();sfx('buy');try{renderMenu();}catch(e){}
  center(`<span style="color:#7dff9b">${esc(WEAPONS[id].name)} unlocked!</span><br><small>−⛃ ${c}</small>`,1.4);return true;}

/* ================= ARMORY (inventory showcase) =================
   Left: weapon list by category · centre: live 3D model + weapon level · right: stats and your performance.
   Bottom bar: Leave · Skins · Equip (knives) · Loadout · All items (the old item grid). */
const AR={cat:0,id:null,r:null,scene:null,cam:null,pivot:null,model:null,yaw:0,drag:null,raf:0,t0:0,skins:false};
const AR_CATS=[
  {n:'Rifles',f:w=>w.cat==='rifle'},{n:'SMGs',f:w=>w.cat==='smg'},{n:'Snipers',f:w=>w.cat==='sniper'||w.cat==='dmr'},
  {n:'Heavy',f:w=>w.cat==='shotgun'||w.cat==='mg'},{n:'Pistols',f:w=>w.cat==='pistol'},{n:'Melee',melee:true}];
const AR_DESC={rifle:'A full-auto rifle that works at almost any range.',smg:'Fast-firing and light. Best up close while on the move.',sniper:'One shot, one kill. Scope in for long range.',
  dmr:'A semi-auto marksman rifle. Hits hard at mid to long range.',shotgun:'Devastating up close, weak at range.',mg:'A huge magazine for holding angles and spraying.',
  pistol:'Your sidearm. Quick to draw and cheap.',melee:'Silent and always with you. Hits harder from behind.'};
function arIds(c){const C=AR_CATS[c];if(C.melee)return KNIVES.map(k=>k[0]).filter(id=>WEAPONS[id]);return GUN_IDS.filter(id=>C.f(WEAPONS[id]));}
function arKnifeLvl(id){const k=KNIVES.find(x=>x[0]===id);return k?k[2]:1;}
function arLocked(id){return !!(WEAPONS[id]&&WEAPONS[id].melee)&&!(save.level>=arKnifeLvl(id)||save.allKnives);}
function arStats(id){const A=save.an&&save.an.w&&save.an.w[id];return A||{s:0,h:0,hh:0,k:0,hk:0,dmg:0,m:0};}
/* weapon level: 10 kills per level, max 50 */
function arLevel(id){const k=arStats(id).k|0;const lv=Math.min(50,1+Math.floor(k/10));return{lv,k,into:lv>=50?10:k%10,max:lv>=50};}
function arTier(lv){return lv>=50?['GOLD','#ffcc33']:lv>=25?['SILVER','#c8d2dc']:lv>=10?['BRONZE','#d08a4a']:null;}
function arIcon(id){const w=WEAPONS[id];try{return w.melee?knifeIcon(id,knifeId()===id&&FINS[save.knifeFin]?save.knifeFin:''):weaponIcon(id,equippedPaint(id));}catch(e){return '';}}
function arInit(){if(AR.r)return true;try{
  const cv=$('arCv');AR.r=new THREE.WebGLRenderer({canvas:cv,alpha:true,antialias:true});AR.r.setPixelRatio(Math.min(2,window.devicePixelRatio||1));
  AR.scene=new THREE.Scene();AR.scene.add(new THREE.HemisphereLight(0xe8f0ff,0x3a3428,1.0));
  const k=new THREE.DirectionalLight(0xffffff,1.0);k.position.set(-2,3,2.5);AR.scene.add(k);
  const rim=new THREE.DirectionalLight(0x7fb8ff,0.9);rim.position.set(2.5,1.5,-3);AR.scene.add(rim);
  const f=new THREE.DirectionalLight(0xffe2b8,0.35);f.position.set(0,-2,2);AR.scene.add(f);
  AR.cam=new THREE.PerspectiveCamera(30,1,0.05,50);AR.cam.position.set(0,0.12,3.1);AR.cam.lookAt(0,0,0);
  AR.pivot=new THREE.Group();AR.scene.add(AR.pivot);
  cv.addEventListener('pointerdown',e=>{AR.drag={x:e.clientX,y0:AR.yaw};cv.setPointerCapture(e.pointerId);});
  cv.addEventListener('pointermove',e=>{if(AR.drag)AR.yaw=AR.drag.y0+(e.clientX-AR.drag.x)*0.012;});
  const up=()=>{AR.drag=null;};cv.addEventListener('pointerup',up);cv.addEventListener('pointercancel',up);
  return true;}catch(e){AR.r=null;return false;}}
function arBuildModel(id){const w=WEAPONS[id];let g=null;
  try{
    if(id==='katana'||id==='dualkatana'){g=new THREE.Group();const a=makeKatana(ktnSkin());a.rotation.x=-0.32;g.add(a);if(id==='dualkatana'){const b=makeKatana(ktnSkin());b.rotation.x=0.62;b.rotation.y=Math.PI;b.position.set(0.03,0,0.02);g.add(b);}}
    else if(hasReal(id)&&hzReady){const v=w.melee&&save.kskin&&HZ.kv[save.kskin]&&HZ.kv[save.kskin].w===id?save.kskin:undefined;g=makeRealStatic(id,w.melee?null:equippedPaint(id),v);}
    else if(typeof QA!=='undefined'&&QA[id]&&QA_TEX[id]){const r=qaGun(id,(REAL_LEN[w.cat]||0.7));if(QA_CFG[id]&&QA_CFG[id].flip)r.inner.rotation.y=0;g=r.g;}
    else if(!w.melee){const M=getIconModels();if(M[id])g=M[id].clone(true);}
  }catch(e){g=null;}
  if(!g)return null;
  const wrap=new THREE.Group();wrap.add(g);wrap.updateMatrixWorld(true);
  let box=new THREE.Box3().setFromObject(wrap),sz=box.getSize(new V3());
  if(sz.x>sz.z){g.rotation.y+=Math.PI/2;wrap.updateMatrixWorld(true);box=new THREE.Box3().setFromObject(wrap);sz=box.getSize(new V3());}
  const c=box.getCenter(new V3()),L=Math.max(sz.x,sz.y,sz.z)||1,s=1.85/L;
  g.position.sub(c);const holder=new THREE.Group();holder.add(wrap);wrap.scale.setScalar(s);
  holder.traverse(o=>{if(o.isMesh)o.visible=o.visible!==false;});return holder;}
function arSetModel(){if(!arInit())return;if(AR.model){AR.pivot.remove(AR.model);AR.model=null;}
  const m=arBuildModel(AR.id);$('arNo').classList.toggle('hidden',!!m);
  if(!m){$('arNo').innerHTML=`<img src="${arIcon(AR.id)}" alt="">`;return;}
  AR.model=m;AR.pivot.add(m);AR.yaw=0;}
function arVisible(){return S.state==='menu'&&!$('pg-inventory').classList.contains('hidden')&&!$('armory').classList.contains('hidden');}
function arLoop(now){if(!arVisible()){AR.raf=0;return;}AR.raf=requestAnimationFrame(arLoop);if(!AR.r)return;
  const cv=$('arCv'),W=cv.clientWidth|0,H=cv.clientHeight|0;if(W<10||H<10)return;
  if(cv.width!==Math.round(W*AR.r.getPixelRatio())||cv.height!==Math.round(H*AR.r.getPixelRatio())){AR.r.setSize(W,H,false);AR.cam.aspect=W/H;AR.cam.updateProjectionMatrix();}
  const dt=Math.min(0.05,(now-(AR.t0||now))/1000);AR.t0=now;if(!AR.drag)AR.yaw+=dt*0.35;
  // fit: keep the weapon inside the canvas on narrow screens
  const fit=Math.max(1,1.25/AR.cam.aspect);AR.cam.position.set(0,0.12*fit,3.1*fit);AR.cam.lookAt(0,0,0);
  AR.pivot.rotation.set(0.18*Math.cos(AR.yaw),-Math.PI/2+AR.yaw,0.32+Math.sin(now/1400)*0.025);AR.pivot.position.y=Math.sin(now/900)*0.025;
  AR.r.render(AR.scene,AR.cam);}
function arRenderList(){const ids=arIds(AR.cat);$('arCatN').textContent=AR_CATS[AR.cat].n.toUpperCase();
  $('arList').innerHTML=ids.map(id=>{const w=WEAPONS[id],lk=arLocked(id),eq=w.melee?knifeId()===id:arGunEq(id),gl=!w.melee&&!gunOwned(id);
    return `<button class="ar-it${id===AR.id?' on':''}${lk||gl?' lk':''}" data-id="${id}"><img src="${arIcon(id)}" alt=""><span>${esc(w.name)}</span>${lk?`<em>🔒 Lv ${arKnifeLvl(id)}</em>`:gl?`<em class="ar-pr">⛃ ${gunCost(id)}</em>`:eq?'<i class="ar-eq">●</i>':''}</button>`;}).join('');}
function arGunEq(id){const w=WEAPONS[id];return !!w&&!w.melee&&(w.cat==='pistol'?spawnPistolId()===id:spawnPrimaryId()===id);}
function arRow(l,v,sub){return `<div class="ar-r"><span>${l}</span><b>${v}${sub?` <small>${sub}</small>`:''}</b></div>`;}
function arRenderInfo(){const id=AR.id,w=WEAPONS[id];if(!w)return;const L=arLevel(id),T=arTier(L.lv);
  $('arTitle').textContent=w.name;$('arLvN').textContent=L.lv;$('arBarI').style.width=(L.max?100:L.into*10)+'%';
  $('arBarL').textContent=L.max?'MAX':L.into+' / 10 kills';$('arTier').innerHTML=T?`<i style="background:${T[1]}"></i>${T[0]} MASTERY`:'';
  $('arNextT').textContent=L.max?'Gold mastery reached':L.lv<10?'Bronze mastery at level 10':L.lv<25?'Silver mastery at level 25':'Gold mastery at level 50';
  const sp=Math.round((wSpeed(w)/WEIGHT_BASE-1)*100),spT=(sp>0?'+':'')+sp+'%';let o=`<div class="ar-desc">• ${esc(AR_DESC[w.cat]||AR_DESC.melee)}</div>`;
  if(w.melee){o+=arRow('Move Speed',spT)+arRow('Damage',w.dmg)+arRow('Swing',(w.rate||0.5).toFixed(2)+'s')+arRow('Headshot',`×${w.head||1}`)+arRow('Reach',(w.range||2.5).toFixed(1)+' m')+arRow('Unlocks at',`Level ${arKnifeLvl(id)}`);}
  else{const pel=w.pellets||1,far=Math.round(w.pellets?w.range*1.8:w.range*2.6),fd=Math.round(w.dmg*pel*rangeMul(w,far));
    o+=arRow('Move Speed',spT)+arRow('Damage',`${Math.round(w.dmg*pel)} → ${fd}`,w.pellets?`${pel} pellets`:'')+arRow('Dropoff',`${Math.round(w.range)}m → ${far}m`)+arRow('Fire Rate',(+w.rate||0).toFixed(2)+'s',w.auto?'auto':'semi')
      +arRow('Headshot',`×${w.head||4}`)+arRow('Ammo',w.mag,w.reserve)+(w.reload?arRow('Reload',(+w.reload).toFixed(1)+'s'):'')+arRow('Price','$'+w.price)+(w.zoom?arRow('Zoom',`${w.zoom}×`):'');}
  $('arOver').innerHTML=o;
  const A=arStats(id),acc=A.s?Math.round(A.h/A.s*100):0,hs=A.k?Math.round(A.hk/A.k*100):0;
  $('arPerf').innerHTML=arRow('Matches',A.m|0)+arRow('Kills',A.k|0)+`<div class="ar-sub">${arRow('headshot kills',`${A.hk|0}`,`${hs}%`)}${arRow('shots hit',`${A.h|0} / ${A.s|0}`,`${acc}%`)}</div>`+arRow('Damage dealt',(A.dmg|0).toLocaleString());
  const lk=arLocked(id);document.querySelector('#arBot [data-a=equip]').classList.toggle('hidden',!w.melee&&!gunOwned(id));
  {const gl=!w.melee&&!gunOwned(id),bb=document.querySelector('#arBot [data-a=buy]');bb.classList.toggle('hidden',!gl);bb.querySelector('span').textContent=gl?`Buy ⛃ ${gunCost(id)}`:'Buy';bb.classList.toggle('poor',gl&&(save.coins|0)<gunCost(id));
   const L=$('arLock');L.classList.toggle('hidden',!gl);if(gl)L.innerHTML=`🔒 LOCKED · <b>⛃ ${gunCost(id)}</b> · you have ⛃ ${save.coins|0} · try it in Target Practice`;}
  const eqb=document.querySelector('#arBot [data-a=equip] span');if(eqb)eqb.textContent=w.melee?(lk?`Lv ${arKnifeLvl(id)}`:knifeId()===id?'Equipped ✓':'Equip'):(arGunEq(id)?'Equipped ✓':'Equip');
  document.querySelector('#arBot [data-a=equip]').classList.toggle('on',w.melee?knifeId()===id:arGunEq(id));
  if(AR.skins)arRenderSkins();}
/* skins strip for the selected weapon */
function arRenderSkins(){const id=AR.id,w=WEAPONS[id];let tiles=[];
  if(!w.melee){const own=save.items.filter(i=>i.k==='skin'&&i.w===id&&PAINTS[i.p]);
    tiles.push({k:'def',n:'Default',img:weaponIcon(id,null),on:!save.equipSkin[id],c:'#8a8f98'});
    for(const it of own){const p=PAINTS[it.p];tiles.push({k:'skin',uid:it.uid,n:p.n,img:weaponIcon(id,it.p),on:save.equipSkin[id]===it.uid,c:RAR[p.r].c});}}
  else if(id==='katana'||id==='dualkatana'){const own=save.items.filter(i=>i.k==='ktn'&&KTN[i.s]);tiles.push({k:'ktn',s:'wooden',n:'Wooden',img:katanaIcon('wooden',id==='dualkatana'),on:ktnSkin()==='wooden',c:'#8a8f98'});
    for(const it of own)if(it.s!=='wooden')tiles.push({k:'ktn',s:it.s,n:KTN[it.s].n,img:katanaIcon(it.s,id==='dualkatana'),on:ktnSkin()===it.s,c:RAR[6].c});}
  else{const eq=knifeId()===id;tiles.push({k:'fin',f:'',n:'Vanilla',img:knifeIcon(id,''),on:eq&&!save.knifeFin&&!save.kskin,c:'#8a8f98'});
    const fins=[...new Set(save.items.filter(i=>i.k==='fin'&&FINS[i.f]).map(i=>i.f))];for(const f of fins)tiles.push({k:'fin',f,n:FINS[f].n,img:knifeIcon(id,f),on:eq&&save.knifeFin===f&&!save.kskin,c:RAR[6].c});
    if(window.CR_HZ)for(const it of save.items.filter(i=>i.k==='kskin'&&HZ.kv[i.v]&&HZ.kv[i.v].w===id))tiles.push({k:'kskin',v:it.v,n:HZ.kv[it.v].n,img:realIcon(id,null,it.v)||knifeIcon(id,''),on:save.kskin===it.v,c:RAR[6].c});}
  AR.tiles=tiles;const none=tiles.length<=1;
  $('arSkins').innerHTML=tiles.map((t,i)=>`<button class="ar-sk${t.on?' on':''}" data-i="${i}" style="--rc:${t.c}"><img src="${t.img}" alt=""><span>${esc(t.n)}</span></button>`).join('')+(none?`<div class="ar-skn">No skins for this ${w.melee?'knife':'weapon'} yet. <button class="btn" data-a="store">Open the Store</button></div>`:'');}
function arPickSkin(t){const id=AR.id;if(arLocked(id)&&WEAPONS[id].melee){center(`<span style="color:#ffd34d">Unlocks at Level ${arKnifeLvl(id)}</span>`,1.2);sfx('deny');return;}
  if(t.k==='def')delete save.equipSkin[id];
  if(t.k==='skin'){save.equipSkin[id]=t.uid;if(id==='awp'||id==='ak47')save.spawnPrimary=id;}
  if(t.k==='ktn'){save.katanaSkin=t.s;save.knife=id;save.kskin='';}
  if(t.k==='fin'){save.knife=id;save.knifeFin=t.f;save.kskin='';}
  if(t.k==='kskin'){save.knife=id;save.kskin=t.v;}
  persist();sfx('buy');try{renderMenu();}catch(e){}arSetModel();arRenderList();arRenderInfo();}
function arSelect(id){if(!WEAPONS[id])return;AR.id=id;if(!arIds(AR.cat).includes(id)){const c=AR_CATS.findIndex((x,i)=>arIds(i).includes(id));if(c>=0)AR.cat=c;}arRenderList();arRenderInfo();arSetModel();}
function arShow(){if(!AR.id){const sp=save.spawnPrimary||'ak47';AR.id=WEAPONS[sp]?sp:'ak47';AR.cat=Math.max(0,AR_CATS.findIndex((c,i)=>arIds(i).includes(AR.id)));}
  $('armory').classList.remove('hidden');$('invAll').classList.add('hidden');
  try{$('arAv').src=avatarUrl(myName(),true);$('arNm').textContent=myName();$('arLvl').textContent='Level '+save.level;}catch(e){}
  arRenderList();arRenderInfo();arSetModel();if(!AR.raf){AR.t0=0;AR.raf=requestAnimationFrame(arLoop);}}
$('arList').addEventListener('click',e=>{const b=e.target.closest('[data-id]');if(!b)return;arSelect(b.dataset.id);sfx('click');});
$('arCatP').onclick=()=>{AR.cat=(AR.cat+AR_CATS.length-1)%AR_CATS.length;arSelect(arIds(AR.cat)[0]);sfx('click');};
$('arCatN2').onclick=()=>{AR.cat=(AR.cat+1)%AR_CATS.length;arSelect(arIds(AR.cat)[0]);sfx('click');};
$('arSkins').addEventListener('click',e=>{if(e.target.closest('[data-a=store]')){showTab('store');return;}const b=e.target.closest('[data-i]');if(b&&AR.tiles)arPickSkin(AR.tiles[+b.dataset.i]);});
$('arBot').addEventListener('click',e=>{const b=e.target.closest('[data-a]');if(!b)return;const a=b.dataset.a;
  if(a==='leave')showTab('home');
  if(a==='skins'){AR.skins=!AR.skins;$('arSkins').classList.toggle('hidden',!AR.skins);b.classList.toggle('on',AR.skins);if(AR.skins)arRenderSkins();sfx('click');}
  if(a==='equip'&&!WEAPONS[AR.id].melee){const id=AR.id,w=WEAPONS[id];if(!gunOwned(id)){sfx('deny');return;}
    if(w.cat==='pistol')save.spawnPistol=id;else save.spawnPrimary=id;persist();sfx('buy');
    center(`<span style="color:#7dff9b">${esc(w.name)} equipped</span><br><small>You spawn with it in Team Deathmatch, Free For All, Versus and Practice</small>`,1.8);
    try{renderMenu();}catch(e){}arRenderList();arRenderInfo();return;}
  if(a==='equip'){const id=AR.id;if(arLocked(id)){center(`<span style="color:#ffd34d">Unlocks at Level ${arKnifeLvl(id)}</span>`,1.2);sfx('deny');return;}
    if(id==='katana'||id==='dualkatana'){save.knife=id;save.kskin='';}else{save.knife=id;if(save.kskin&&HZ.kv[save.kskin]&&HZ.kv[save.kskin].w!==id)save.kskin='';}
    persist();sfx('buy');try{renderMenu();}catch(e){}arRenderList();arRenderInfo();arSetModel();}
  if(a==='buy'){if(buyGun(AR.id)){arRenderList();arRenderInfo();}}
  if(a==='loadout')showTab('loadout');
  if(a==='items'){$('armory').classList.add('hidden');$('invAll').classList.remove('hidden');renderInventory();sfx('click');}});
$('invBack').onclick=()=>{arShow();sfx('click');};
document.addEventListener('keydown',e=>{if(!arVisible()||e.target.closest&&e.target.closest('input,textarea,select'))return;
  const ids=arIds(AR.cat),i=ids.indexOf(AR.id);
  if(e.code==='ArrowDown'){arSelect(ids[(i+1)%ids.length]);e.preventDefault();}
  if(e.code==='ArrowUp'){arSelect(ids[(i-1+ids.length)%ids.length]);e.preventDefault();}
  if(e.code==='ArrowRight')$('arCatN2').click();if(e.code==='ArrowLeft')$('arCatP').click();});

function resetTheme(){applyTheme('dust2');}
let _miT=0;function showMapName(){const t=S.mode==='br'?{n:'Horizon Island',loc:'Battle Royale'}:THEME;const tag=$('mapTag'),mi=$('mapIntro');if(tag)tag.innerHTML=`${esc(t.n.toUpperCase())}<small>${esc(t.loc)}</small>`;
  if(mi&&S.mode!=='practice'){mi.innerHTML=`<span>MAP</span><b>${esc(t.n.toUpperCase())}</b><span>${esc(t.loc.toUpperCase())}</span>`;mi.classList.add('show');clearTimeout(_miT);_miT=setTimeout(()=>mi.classList.remove('show'),3200);}}
/* ---- theme props ---- */
const PMATS={};const pm=(c,o={})=>PMATS[c+JSON.stringify(o)]||(PMATS[c+JSON.stringify(o)]=Lm(Object.assign({color:c},o)));
const PALM_GEO={};
/* ---- trees v2: tapered trunks with branches and clustered low-poly foliage (merged by mergeWorld) ---- */
const TREE={};
function treeMats(){if(TREE.bark)return TREE;
  const bark=canvasTex(64,(c,s)=>{c.fillStyle='#6b4a2e';c.fillRect(0,0,s,s);for(let i=0;i<22;i++){c.fillStyle=`rgba(${30+Math.random()*30|0},${18+Math.random()*16|0},8,${0.25+Math.random()*0.35})`;c.fillRect(Math.random()*s,0,1+Math.random()*3,s);}speckle(c,s,300,0.12);});
  TREE.bark=Lm({map:bark,color:0xb8a090});TREE.barkD=Lm({map:bark,color:0x8a7868});TREE.barkG=Lm({map:bark,color:0x9a9a98});
  const lv=(c)=>new THREE.MeshPhongMaterial({color:c,flatShading:true,shininess:0,specular:0x000000});
  TREE.leaf=[lv(0x4f7a2e),lv(0x5d8a34),lv(0x426b28),lv(0x6b9a3c)];TREE.dark=[lv(0x2f4a24),lv(0x38582a),lv(0x29401f)];TREE.jung=[lv(0x3f7a2c),lv(0x4f8f30),lv(0x346a26),lv(0x5a9a3a)];TREE.bush=[lv(0x3a5a22),lv(0x456a26),lv(0x52752c)];
  TREE.blob=[0,1].map(d=>{const g=new THREE.IcosahedronGeometry(1,d);const P=g.attributes.position;for(let i=0;i<P.count;i++){const v=new V3().fromBufferAttribute(P,i);const n=0.86+0.28*Math.abs(Math.sin(v.x*3.1+v.y*5.3+v.z*2.7));P.setXYZ(i,v.x*n,v.y*n,v.z*n);}g.computeVertexNormals();return g;});
  TREE.cone=new THREE.ConeGeometry(1,1,8,1);return TREE;}
function tPart(geo,mat,x,y,z,sx,sy,sz,rx=0,ry=0,rz=0,cast=true){const m=new THREE.Mesh(geo,mat);if(_clutter)m.userData.clutter=1;m.position.set(x,y,z);m.scale.set(sx,sy,sz);m.rotation.set(rx,ry,rz);m.castShadow=cast;m.receiveShadow=true;world.add(m);worldMeshes.push(m);return m;}
function limbTo(mat,a,b,r0,r1){const d=b.clone().sub(a),L=d.length();const m=new THREE.Mesh(new THREE.CylinderGeometry(r1,r0,L,7),mat);m.position.copy(a).add(b).multiplyScalar(0.5);m.quaternion.setFromUnitVectors(new V3(0,1,0),d.normalize());m.castShadow=true;world.add(m);worldMeshes.push(m);return m;}
function deadTree(x,z){const T=treeMats();const h=rand(3.4,5);const top=new V3(x+rand(-0.4,0.4),h,z+rand(-0.4,0.4));limbTo(T.barkD,new V3(x,0,z),top,0.22,0.08);colliders.push({minX:x-0.22,maxX:x+0.22,minZ:z-0.22,maxZ:z+0.22,minY:0,maxY:h});
  const grow=(a,dir,len,r,depth)=>{const b=a.clone().addScaledVector(dir,len);limbTo(T.barkD,a,b,r,r*0.6);if(depth<=0)return;for(let i=0;i<2;i++){const nd=dir.clone().add(new V3(rand(-0.7,0.7),rand(-0.1,0.5),rand(-0.7,0.7))).normalize();grow(b,nd,len*0.68,r*0.6,depth-1);}};
  for(let i=0;i<3;i++){const y=h*rand(0.5,0.9);const st=new V3(x+(top.x-x)*y/h,y,z+(top.z-z)*y/h);const a=rand(0,6.28);grow(st,new V3(Math.cos(a),rand(0.3,0.8),Math.sin(a)).normalize(),rand(0.9,1.4),0.08,2);}}
/* ---- trees v3 (1.02): leaf-card foliage like mobile battle royales — round leafy clumps with a solid core, pines, birches, olives, palm fronds ---- */
const FOL={};
function folCard(pal,opt){opt=opt||{};const S=256,c=document.createElement('canvas');c.width=S;c.height=S;const x=c.getContext('2d');x.clearRect(0,0,S,S);
  const n=opt.n||420,R=S*0.47;
  if(opt.twig){x.strokeStyle='rgba(70,48,28,.9)';x.lineWidth=3;for(let k=0;k<5;k++){x.beginPath();x.moveTo(S/2,S*0.95);x.quadraticCurveTo(S/2+(Math.random()-0.5)*60,S*0.6,S/2+(Math.random()-0.5)*S*0.8,S*0.15+Math.random()*S*0.3);x.stroke();}}
  for(let i=0;i<n;i++){const a=Math.random()*Math.PI*2,r=R*Math.sqrt(Math.random())*(0.55+0.45*Math.random());const px=S/2+Math.cos(a)*r,py=S/2+Math.sin(a)*r*0.92;
    const t=i/n,base=pal[(Math.random()*pal.length)|0];x.save();x.translate(px,py);x.rotate(Math.random()*Math.PI*2);
    const l=(opt.size||1)*(9+Math.random()*7),w=l*(opt.narrow?0.28:0.5);x.fillStyle=base;x.globalAlpha=1;
    x.beginPath();x.ellipse(0,0,l,w,0,0,Math.PI*2);x.fill();
    /* depth: leaves drawn early and low are darker, late and high are lit */
    const sh=(1-t)*0.45+(py/S)*0.25;x.fillStyle=`rgba(10,20,5,${sh})`;x.fill();
    if(t>0.6){x.fillStyle=`rgba(255,250,200,${(t-0.6)*0.35*(1-py/S)})`;x.fill();}
    x.strokeStyle='rgba(20,30,10,.35)';x.lineWidth=0.8;x.beginPath();x.moveTo(-l*0.8,0);x.lineTo(l*0.8,0);x.stroke();x.restore();}
  const t=new THREE.CanvasTexture(c);t.anisotropy=4;return new THREE.MeshLambertMaterial({map:t,alphaTest:0.5,side:THREE.DoubleSide,emissive:0x16200d});}
function folNeedle(pal){const W=256,H=128,c=document.createElement('canvas');c.width=W;c.height=H;const x=c.getContext('2d');x.clearRect(0,0,W,H);
  const spray=(sx,sy,ex,ey,len,col)=>{x.strokeStyle='#4a3420';x.lineWidth=2.2;x.beginPath();x.moveTo(sx,sy);x.lineTo(ex,ey);x.stroke();const L=Math.hypot(ex-sx,ey-sy);
    for(let i=0;i<70;i++){const k=Math.random(),px=sx+(ex-sx)*k,py=sy+(ey-sy)*k,a=Math.atan2(ey-sy,ex-sx)+(Math.random()<0.5?1:-1)*(0.6+Math.random()*0.6),ll=len*(1-k*0.55)*(0.6+Math.random()*0.5);
      x.strokeStyle=col[(Math.random()*col.length)|0];x.lineWidth=1.6;x.beginPath();x.moveTo(px,py);x.lineTo(px+Math.cos(a)*ll,py+Math.sin(a)*ll);x.stroke();}};
  spray(4,H/2,W-8,H/2+4,40,pal);for(let i=0;i<5;i++){const k=0.15+i*0.16;spray(4+(W-12)*k,H/2,4+(W-12)*k+50+Math.random()*30,H/2+(i%2?-1:1)*(28+Math.random()*16),22,pal);}
  const t=new THREE.CanvasTexture(c);t.anisotropy=4;return new THREE.MeshLambertMaterial({map:t,alphaTest:0.45,side:THREE.DoubleSide,emissive:0x1e3214});}
function folFrond(){const W=256,H=64,c=document.createElement('canvas');c.width=W;c.height=H;const x=c.getContext('2d');x.clearRect(0,0,W,H);
  for(let i=0;i<64;i++){const k=i/64,px=k*W,half=(H/2-3)*Math.sin(Math.min(1,k*1.25)*Math.PI*0.5)*(1-Math.max(0,k-0.75)*3.2);if(half<1)continue;
    for(const sg of[-1,1]){const g=x.createLinearGradient(px,H/2,px+10,H/2+sg*half);g.addColorStop(0,'#3d6a1f');g.addColorStop(1,i%3?'#5f9032':'#4f7f28');x.strokeStyle=g;x.lineWidth=2.6;x.beginPath();x.moveTo(px,H/2);x.lineTo(px+12,H/2+sg*half);x.stroke();}}
  x.strokeStyle='#8a7a3a';x.lineWidth=2.5;x.beginPath();x.moveTo(0,H/2);x.lineTo(W*0.97,H/2);x.stroke();
  const t=new THREE.CanvasTexture(c);t.anisotropy=4;return new THREE.MeshLambertMaterial({map:t,alphaTest:0.45,side:THREE.DoubleSide});}
function folMats(){if(FOL.ok)return FOL;FOL.ok=1;
  FOL.broad=[folCard(['#3f6b25','#4f7d2c','#5e8f34','#6fa03c','#355a20']),folCard(['#46722a','#58862f','#699838','#3a6122'])];
  FOL.olive=[folCard(['#5f6e3a','#6f7f45','#7f8f52','#525f32'],{narrow:1,n:520}),folCard(['#66753e','#76874a','#58663a'],{narrow:1,n:520})];
  FOL.jung=[folCard(['#2f6a24','#3f7f2a','#4f9230','#2a5a20'],{size:1.5,n:300}),folCard(['#346f26','#46872c','#2c5e22'],{size:1.4,n:320})];
  FOL.birch=[folCard(['#8fa83c','#a3b844','#7c9a34','#c2b54a'],{size:0.8,n:380,twig:1}),folCard(['#b3a43e','#c9b24a','#98a43a','#d0a040'],{size:0.8,n:340,twig:1})];
  FOL.bush=[folCard(['#3a5a22','#4a6e28','#5a7f30','#33501e'],{size:0.9})];
  FOL.cyp=[folCard(['#26401c','#2f4c22','#38582a','#22381a'],{narrow:1,n:560,size:0.8})];
  FOL.pine=folNeedle(['#3d6a2c','#4a7a34','#5a8a3c','#335a26','#2c4a22']);FOL.frond=folFrond();
  const core=c=>new THREE.MeshLambertMaterial({color:c,flatShading:true});
  FOL.core={broad:core(0x3d6324),olive:core(0x56623a),jung:core(0x2e5a22),birch:core(0x8a9238),bush:core(0x3a5a22),cyp:core(0x24391a),pine:core(0x2a4a1e)};
  FOL.plane=new THREE.PlaneGeometry(1,1);FOL.core0=new THREE.IcosahedronGeometry(1,0);FOL.cone=new THREE.ConeGeometry(1,1,7,1,true);
  const bark=canvasTex(64,(c,s)=>{c.fillStyle='#5e4430';c.fillRect(0,0,s,s);for(let i=0;i<26;i++){c.fillStyle=`rgba(${25+Math.random()*25|0},${15+Math.random()*12|0},6,${0.3+Math.random()*0.4})`;c.fillRect(Math.random()*s,0,1+Math.random()*2.5,s);}
    for(let i=0;i<12;i++){c.fillStyle='rgba(150,130,100,.18)';c.fillRect(Math.random()*s,Math.random()*s,2,6+Math.random()*10);}});bark.repeat.set(1,3);
  const birch=canvasTex(64,(c,s)=>{c.fillStyle='#e6e1d6';c.fillRect(0,0,s,s);for(let i=0;i<16;i++){c.fillStyle=`rgba(30,26,22,${0.5+Math.random()*0.4})`;const y=Math.random()*s;c.fillRect(Math.random()*s*0.6,y,6+Math.random()*24,1.5+Math.random()*2.5);}
    for(let i=0;i<300;i++){c.fillStyle='rgba(120,110,95,.15)';c.fillRect(Math.random()*s,Math.random()*s,1,1);}});birch.repeat.set(1,3);
  FOL.bark=Lm({map:bark});FOL.barkL=Lm({map:bark,color:0xc8b8a4});FOL.birchB=Lm({map:birch});return FOL;}
/* one leafy clump: three crossed cards + a top card around a solid core (the core casts the shadow) */
function folClump(kind,x,y,z,r,ry){const F=folMats(),mats=F[kind],m=mats[(rng()*mats.length)|0];ry=ry===undefined?rng()*Math.PI:ry;
  for(let i=0;i<3;i++){const p=new THREE.Mesh(F.plane,m);p.position.set(x,y,z);p.rotation.set(0,ry+i*Math.PI/3,0);p.scale.set(2.25*r,1.9*r,1);p.receiveShadow=true;if(_clutter)p.userData.clutter=1;world.add(p);}
  const tp=new THREE.Mesh(F.plane,m);tp.position.set(x,y+0.35*r,z);tp.rotation.set(-Math.PI/2+rand(-0.25,0.25),0,ry);tp.scale.set(2*r,2*r,1);world.add(tp);
  const c=new THREE.Mesh(F.core0,F.core[kind]);c.position.set(x,y,z);c.scale.set(0.55*r,0.5*r,0.55*r);c.rotation.y=ry;c.castShadow=true;c.receiveShadow=true;world.add(c);worldMeshes.push(c);}
function folTrunk(mat,a,b,r0,r1){const d=b.clone().sub(a),L=d.length();const m=new THREE.Mesh(new THREE.CylinderGeometry(r1,r0,L,7,1),mat);m.position.copy(a).add(b).multiplyScalar(0.5);m.quaternion.setFromUnitVectors(new V3(0,1,0),d.normalize());m.castShadow=true;m.receiveShadow=true;world.add(m);worldMeshes.push(m);return m;}
/* broadleaf (also olive): bent trunk, branches, leafy clumps on each branch + a crown */
function broadTree(x,z,kind){kind=kind||'broad';const F=folMats();const h=kind==='olive'?rand(3.6,5.2):rand(5,7.5),la=rand(0,6.28),bend=rand(0.15,0.6);
  const mid=new V3(x+Math.cos(la)*bend*0.4,h*0.5,z+Math.sin(la)*bend*0.4),top=new V3(x+Math.cos(la)*bend,h,z+Math.sin(la)*bend);
  const bk=kind==='olive'?F.barkL:F.bark;folTrunk(bk,new V3(x,0,z),mid,kind==='olive'?0.32:0.3,0.22);folTrunk(bk,mid,top,0.22,0.12);
  colliders.push({minX:x-0.3,maxX:x+0.3,minZ:z-0.3,maxZ:z+0.3,minY:0,maxY:h});
  const nb=3+(rng()*3|0);for(let i=0;i<nb;i++){const a=i/nb*6.28+rand(-0.4,0.4),k=rand(0.45,0.8),st=new V3(x+(top.x-x)*k,h*k,z+(top.z-z)*k);
    const len=rand(1.3,2.2)*(kind==='olive'?0.9:1),en=st.clone().add(new V3(Math.cos(a)*len,rand(0.5,1.2),Math.sin(a)*len));folTrunk(bk,st,en,0.1,0.05);
    folClump(kind,en.x,en.y+0.25,en.z,rand(1.0,1.45)*(kind==='olive'?0.95:1));}
  for(let i=0;i<3;i++){const a=i/3*6.28+rand(-0.5,0.5),r=rand(0.5,1.1);folClump(kind,top.x+Math.cos(a)*r,top.y+rand(0.2,0.8),top.z+Math.sin(a)*r,rand(1.3,1.8));}
  folClump(kind,top.x,top.y+1.3,top.z,rand(1.1,1.4));}
function birchTree(x,z){const F=folMats();const h=rand(6,9),lean=rand(-0.25,0.25),la=rand(0,6.28),top=new V3(x+Math.cos(la)*lean*2,h,z+Math.sin(la)*lean*2);
  folTrunk(F.birchB,new V3(x,0,z),top,0.18,0.07);colliders.push({minX:x-0.2,maxX:x+0.2,minZ:z-0.2,maxZ:z+0.2,minY:0,maxY:h});
  for(let i=0;i<7;i++){const k=rand(0.4,0.92),a=i/7*6.28+rand(-0.3,0.3),st=new V3(x+(top.x-x)*k,h*k,z+(top.z-z)*k),en=st.clone().add(new V3(Math.cos(a)*rand(0.7,1.3),rand(0.4,0.9),Math.sin(a)*rand(0.7,1.3)));
    folTrunk(F.birchB,st,en,0.05,0.025);folClump('birch',en.x,en.y,en.z,rand(1.0,1.4));}
  folClump('birch',top.x,top.y+0.4,top.z,rand(1.2,1.5));}
/* pine: stacked rings of needle sprays around dark cones */
function pineTree(x,z){const F=folMats();const h=rand(7,11);folTrunk(F.bark,new V3(x,0,z),new V3(x,h+0.6,z),0.3,0.08);colliders.push({minX:x-0.3,maxX:x+0.3,minZ:z-0.3,maxZ:z+0.3,minY:0,maxY:h});
  const L=6;for(let i=0;i<L;i++){const k=i/(L-1),y=2.2+k*(h-2.4),R=(2.5-k*1.9)*rand(0.9,1.1);
    const cn=new THREE.Mesh(F.cone,F.core.pine);cn.position.set(x,y+R*0.35,z);cn.scale.set(R*0.58,R*1.0,R*0.58);cn.rotation.y=rng()*3;cn.castShadow=true;cn.receiveShadow=true;world.add(cn);worldMeshes.push(cn);
    const nS=Math.max(5,Math.round(5+R*2));const o=rng()*6.28;for(let j=0;j<nS;j++){const a=o+j/nS*6.28;const p=new THREE.Mesh(F.plane,F.pine);
      p.scale.set(R*1.15,R*0.62,1);p.position.set(x+Math.cos(a)*R*0.55,y+0.05,z-Math.sin(a)*R*0.55);p.rotation.set(0,a,0);p.rotateZ(-0.3+rand(-0.08,0.08));p.rotateX(-Math.PI/2+rand(-0.45,0.45));world.add(p);}}
  const tip=new THREE.Mesh(F.cone,F.core.pine);tip.position.set(x,h+0.5,z);tip.scale.set(0.35,1.4,0.35);tip.castShadow=true;world.add(tip);}
function cypressTree(x,z){const F=folMats();const h=rand(6.5,9);folTrunk(F.bark,new V3(x,0,z),new V3(x,1.6,z),0.2,0.14);colliders.push({minX:x-0.3,maxX:x+0.3,minZ:z-0.3,maxZ:z+0.3,minY:0,maxY:h});
  const c=new THREE.Mesh(F.core0,F.core.cyp);c.position.set(x,h*0.55,z);c.scale.set(0.75,h*0.45,0.75);c.castShadow=true;world.add(c);worldMeshes.push(c);
  const n=6;for(let i=0;i<n;i++){const k=i/(n-1),y=1.6+k*(h-2),r=(0.95-k*0.55);const ry=rng()*3;
    for(let j=0;j<2;j++){const p=new THREE.Mesh(F.plane,F.cyp[0]);p.position.set(x,y,z);p.rotation.y=ry+j*Math.PI/2;p.scale.set(2.2*r,h/n*1.9,1);world.add(p);}}}
function jungleTree(x,z){const F=folMats();const h=rand(6,9);const top=new V3(x+rand(-0.6,0.6),h,z+rand(-0.6,0.6));folTrunk(F.barkL,new V3(x,0,z),top,0.45,0.24);
  for(let i=0;i<4;i++){const a=i/4*6.28+rand(-0.3,0.3);folTrunk(F.barkL,new V3(x+Math.cos(a)*0.9,0,z+Math.sin(a)*0.9),new V3(x+Math.cos(a)*0.15,1.4,z+Math.sin(a)*0.15),0.17,0.1);}
  colliders.push({minX:x-0.45,maxX:x+0.45,minZ:z-0.45,maxZ:z+0.45,minY:0,maxY:h});
  for(let i=0;i<5;i++){const a=i/5*6.28+rand(-0.4,0.4);const en=top.clone().add(new V3(Math.cos(a)*rand(1.8,2.8),rand(-0.3,0.6),Math.sin(a)*rand(1.8,2.8)));folTrunk(F.barkL,top.clone().add(new V3(0,-0.8,0)),en,0.13,0.07);
    folClump('jung',en.x,en.y+0.3,en.z,rand(1.6,2.2));if(rng()<0.6){const v=new THREE.Mesh(F.plane,F.jung[0]);v.position.set(en.x,en.y-1.2,en.z);v.scale.set(0.5,2.2,1);v.rotation.y=rng()*3;world.add(v);}}
  folClump('jung',top.x,top.y+0.9,top.z,2.4);}
function tree(x,z){broadTree(x,z,'broad');}
function bush(x,z){const n=1+(rng()*2|0);for(let i=0;i<n;i++)folClump('bush',x+rand(-0.5,0.5),rand(0.45,0.65),z+rand(-0.5,0.5),rand(0.55,0.85));}
function palmTree(x,z){const F=folMats();const h=rand(5,7.5),a0=rand(0,Math.PI*2),lean=rand(0.4,1.3),N=9;
  const tA=pm(0x8a6a44),tB=pm(0x765838),nut=pm(0x5a3a1e);
  const pt=t=>new V3(x+Math.sin(a0)*lean*t*t,h*t,z+Math.cos(a0)*lean*t*t);
  for(let i=0;i<N;i++){const A=pt(i/N),B=pt((i+1)/N),d=B.clone().sub(A),L=d.length();const r0=0.22-0.08*i/N,r1=0.22-0.08*(i+1)/N;
    const m=new THREE.Mesh(new THREE.CylinderGeometry(r1,r0*1.06,L*1.02,8),i%2?tA:tB);m.position.copy(A).add(B).multiplyScalar(0.5);m.quaternion.setFromUnitVectors(new V3(0,1,0),d.normalize());m.castShadow=true;world.add(m);worldMeshes.push(m);}
  colliders.push({minX:x-0.24,maxX:x+0.24,minZ:z-0.24,maxZ:z+0.24,minY:0,maxY:h*0.5});
  const top=pt(1);
  if(!FOL.seg){FOL.seg=[0,1,2].map(i=>{const g=new THREE.PlaneGeometry(1.25,1.0);g.rotateX(-Math.PI/2);g.translate(0.625,0,0);const uv=g.attributes.uv;for(let k=0;k<uv.count;k++)uv.setX(k,(i+uv.getX(k))/3);return g;});}
  const nf=11+(rng()*4|0);
  for(let f=0;f<nf;f++){const yaw=f/nf*Math.PI*2+rand(-0.15,0.15);const g=new THREE.Group();g.position.copy(top);g.rotation.y=yaw;world.add(g);let par=g;
    const up=rand(-0.15,0.55),droop=rand(0.32,0.5),sc=rand(0.85,1.15);
    for(let s2=0;s2<3;s2++){const q=new THREE.Group();if(s2>0)q.position.x=1.25*sc;q.rotation.z=s2===0?up:-droop;par.add(q);const m=new THREE.Mesh(FOL.seg[s2],F.frond);m.scale.set(sc,1,sc);q.add(m);par=q;}
    g.updateMatrixWorld(true);const ms=[];g.traverse(o=>{if(o.isMesh)ms.push(o);});for(const m of ms){m.matrixWorld.decompose(m.position,m.quaternion,m.scale);world.add(m);}world.remove(g);}
  const crown=new THREE.Mesh(FOL.core0,F.core.jung);crown.position.copy(top);crown.scale.set(0.45,0.35,0.45);crown.castShadow=true;world.add(crown);
  for(let c=0;c<3;c++){const nm=new THREE.Mesh(new THREE.SphereGeometry(0.13,7,6),nut);const a=c/3*Math.PI*2;nm.position.set(top.x+Math.cos(a)*0.2,top.y-0.18,top.z+Math.sin(a)*0.2);world.add(nm);}}
/* island trees: a mix that fits the map */
function islTree(x,z){const k=THEME.tree,r=rng();
  if(k==='palm'){if(r<0.55)palmTree(x,z);else broadTree(x,z,'olive');}
  else if(k==='cypress'){if(r<0.5)cypressTree(x,z);else broadTree(x,z,'olive');}
  else if(k==='jungle'){if(r<0.7)jungleTree(x,z);else broadTree(x,z,'broad');}
  else if(k==='dead'){if(r<0.4)deadTree(x,z);else birchTree(x,z);}
  else if(k==='none'){if(r<0.6)pineTree(x,z);else broadTree(x,z,'broad');}
  else{if(r<0.35)pineTree(x,z);else if(r<0.55)birchTree(x,z);else broadTree(x,z,'broad');}}
function themedTree(x,z){const k=THEME.tree;
  if(k==='palm'){palmTree(x,z);return;}
  if(k==='cypress'){cypressTree(x,z);return;}
  if(k==='cypress_old'){solid(x,0,z,0.25,1.2,0.25,pm(0x5a4030));const c=new THREE.Mesh(new THREE.ConeGeometry(0.8,rand(5,7),8),pm(0x2f4a26));c.position.set(x,1.2+c.geometry.parameters.height/2,z);c.castShadow=true;world.add(c);return;}
  if(k==='jungle'){jungleTree(x,z);return;}
  if(k==='jungle_old'){const h=rand(4,6.5);solid(x,0,z,0.5,h,0.5,pm(0x5b4630));for(let i=0;i<3;i++){const s=new THREE.Mesh(new THREE.SphereGeometry(rand(1.4,2.2),8,6),pm(i?0x3f6a2a:0x4f7a30));s.position.set(x+rand(-0.9,0.9),h+rand(-0.3,0.8),z+rand(-0.9,0.9));s.scale.y=0.7;s.castShadow=true;world.add(s);}return;}
  if(k==='dead'){deadTree(x,z);return;}
  if(k==='dead_old'){const h=rand(3,4.5);solid(x,0,z,0.25,h,0.25,pm(0x4a4038));for(let i=0;i<3;i++){const b=new THREE.Mesh(new THREE.BoxGeometry(0.1,1.4,0.1),pm(0x4a4038));b.position.set(x,h-0.6-i*0.5,z);b.rotation.set(rand(-0.9,0.9),rand(0,6),rand(-0.9,0.9));world.add(b);}return;}
  if(k==='none')return;tree(x,z);}
/* hanging ivy: a few natural leafy strands from the roofline instead of a flat green sheet */
let _ivyTex=null;function ivyMat(){if(_ivyTex)return _ivyTex;const t=canvasTex(128,(c,S)=>{c.clearRect(0,0,S,S);
    for(let k=0;k<5;k++){let x=S*(0.12+k*0.19)+Math.random()*8;const L=S*(0.45+Math.random()*0.55);c.strokeStyle='rgba(60,48,28,.9)';c.lineWidth=1.4;c.beginPath();c.moveTo(x,0);
      for(let y=0;y<L;y+=6){x+=Math.random()*6-3;c.lineTo(x,y);const n=2+Math.floor(Math.random()*3)*(1-y/L*0.6);
        for(let i=0;i<n;i++){const g=[[58,92,38],[74,112,46],[46,78,32],[88,126,54]][Math.floor(Math.random()*4)];c.fillStyle=`rgb(${g[0]},${g[1]},${g[2]})`;
          c.save();c.translate(x+Math.random()*16-8,y+Math.random()*6);c.rotate(Math.random()*6.28);c.beginPath();c.ellipse(0,0,4.2,2.6,0,0,6.28);c.fill();c.restore();}}c.stroke();}});
  t.wrapS=THREE.ClampToEdgeWrapping;_ivyTex=new THREE.MeshLambertMaterial({map:t,transparent:true,alphaTest:0.45,side:THREE.DoubleSide});return _ivyTex;}
function ivyOn(x,z,w,d,h,self){if(rng()<0.35)return;const M=ivyMat();const faces=[[0,1],[0,-1],[1,0],[-1,0]];
  for(const[nx,nz]of faces){if(rng()<0.5)continue;const along=nz!==0,len=along?w:d,n=1+Math.floor(rng()*3);
    for(let i=0;i<n;i++){const pw=rand(1.2,2.6),ph=Math.min(h-0.6,rand(1.6,h*0.55)),t=rand(-len/2+pw/2+0.3,len/2-pw/2-0.3);
      if(faceCovAny(x,z,w,d,nx,nz,[t-pw/2,t,t+pw/2],[h-ph,h-ph/2,h-0.1],self))continue;const m=new THREE.Mesh(new THREE.PlaneGeometry(pw,ph),M);m.position.set(along?x+t:x+nx*(w/2+0.06),h-ph/2+0.05,along?z+nz*(d/2+0.06):z+t);m.rotation.y=Math.atan2(nx,nz);m.userData.clutter=1;world.add(m);}}}
function themeRoof(x,z,w,d,h,self){const r=THEME.roof;const nb=BLD_OCC.length&&[[0,1],[0,-1],[1,0],[-1,0]].some(([nx,nz])=>{const L=nz?w:d;for(let t=-L/2+0.25;t<L/2;t+=0.5)if(faceCov(x,z,w,d,nx,nz,t,h-0.9,self))return true;return false;});
  if(r==='tile'&&!nb&&rng()<0.85){const along=w>=d,L=(along?w:d)+0.5,S2=(along?d:w)/2+0.3,rh=Math.min(1.7,S2*0.62),ang=Math.atan2(rh,S2),sl=Math.hypot(S2,rh)+0.08,M=pm(0xa8502e),y0=h+0.22;
    const sh=new THREE.Shape();sh.moveTo(-S2+0.3,0);sh.lineTo(S2-0.3,0);sh.lineTo(0,rh-0.12);sh.lineTo(-S2+0.3,0);
    const pg=new THREE.ExtrudeGeometry(sh,{depth:L-0.6,bevelEnabled:false});pg.translate(0,0,-(L-0.6)/2);const pr=new THREE.Mesh(pg,MAT.walls[0]);pr.position.set(x,y0,z);if(along)pr.rotation.y=Math.PI/2;pr.castShadow=true;world.add(pr);
    for(const sg of[-1,1]){const g=new THREE.Mesh(new THREE.BoxGeometry(along?L:sl,0.14,along?sl:L),M);
      g.position.set(x+(along?0:sg*S2/2),y0+rh/2,z+(along?sg*S2/2:0));if(along)g.rotation.x=sg*ang;else g.rotation.z=-sg*ang;g.castShadow=true;world.add(g);}
    const ridge=new THREE.Mesh(new THREE.BoxGeometry(along?L+0.05:0.2,0.16,along?0.2:L+0.05),pm(0x8a3e22));ridge.position.set(x,y0+rh+0.02,z);world.add(ridge);return true;}
  if(r==='dome'&&rng()<0.3&&Math.min(w,d)>5){const s=new THREE.Mesh(new THREE.SphereGeometry(Math.min(w,d)*0.3,14,8,0,Math.PI*2,0,Math.PI/2),pm(rng()<0.5?0xd8c39a:0x3c7f8f));s.position.set(x,h+0.22,z);s.castShadow=true;world.add(s);return true;}
  if(r==='moss'){const e=BLD_OCC.length?0:0.35;const m=new THREE.Mesh(new THREE.BoxGeometry(w+e,0.12,d+e),pm(0x4f6a2e));m.position.set(x,h+0.3,z);world.add(m);if(BLD_OCC.length)sideBands(x,z,w,d,h+0.24,0.12,0.17,pm(0x4f6a2e),self);ivyOn(x,z,w,d,h,self);return false;}
  return false;}
function freeSpot(H,r,keep,tries=30){for(let i=0;i<tries;i++){const x=rand(-H+r+3,H-r-3),z=rand(-H+r+3,H-r-3);if(ISL&&!islIn(x,z,r+4))continue;if(blocked(x,z,r)||nbHit(x,z,r+0.5)||inLadderZone(x,z,r)||keep.some(([kx,kz,kr])=>Math.hypot(x-kx,z-kz)<(kr||5)+r))continue;return[x,z];}return null;}
function container(x,z,rot,col,stack){const w=rot?2.45:6.1,d=rot?6.1:2.45;const m=solid(x,0,z,w,2.6,d,pm(col,{map:texConcrete}));for(let i=-2;i<=2;i++){const rib=new THREE.Mesh(new THREE.BoxGeometry(rot?2.5:0.08,2.5,rot?0.08:2.5),pm(col));rib.position.set(x+(rot?0:i*1.2),1.3,z+(rot?i*1.2:0));world.add(rib);}
  if(stack)solid(x+rand(-0.3,0.3),2.6,z+rand(-0.3,0.3),w,2.6,d,pm(pick([0x8a3b2a,0x2f5f8a,0x3f6f3a,0xb08a2a]),{map:texConcrete}));return m;}
/* ---- realistic water: wave shader + flow + interactive ripples (inspired by the HDGMP Water Flow add-on) ---- */
const WSH={uT:{value:0},uRip:{value:Array.from({length:12},()=>new THREE.Vector4(0,0,-99,0))},uSun:{value:new THREE.Vector3(0.45,0.8,0.3).normalize()},uSky:{value:new THREE.Color(0xd8ccb2)},uSkyTop:{value:new THREE.Color(0x8fb6d8)}};
let WRIP=0;let WATERS=[];
function waterRipple(x,z,str=1){const v=WSH.uRip.value[WRIP++%12];v.set(x,z,WSH.uT.value,str);}
const WATER_VS=`
uniform float uT;uniform vec2 uFlow;varying vec3 vW;varying vec2 vUv;
#include <fog_pars_vertex>
void main(){vUv=uv;vec4 wp=modelMatrix*vec4(position,1.0);vec2 p=wp.xz-uFlow*uT;
  wp.y+=0.018*sin(p.x*1.3+uT*1.7)+0.014*sin(p.y*1.7-uT*1.3)+0.01*sin((p.x+p.y)*2.3+uT*2.1);
  vW=wp.xyz;vec4 mvPosition=viewMatrix*wp;gl_Position=projectionMatrix*mvPosition;
  #include <fog_vertex>
}`;
const WATER_FS=`
uniform float uT;uniform vec2 uFlow;uniform vec4 uRip[12];uniform vec3 uSun,uSky,uSkyTop,uDeep,uShallow;uniform vec3 uSize;varying vec3 vW;varying vec2 vUv;
#include <fog_pars_fragment>
float h21(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float vn(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);return mix(mix(h21(i),h21(i+vec2(1,0)),f.x),mix(h21(i+vec2(0,1)),h21(i+vec2(1,1)),f.x),f.y);}
vec2 waveGrad(vec2 p,float t){vec2 g=vec2(0);
  vec2 d1=normalize(vec2(1.0,0.35)),d2=normalize(vec2(-0.4,1.0)),d3=normalize(vec2(0.8,-0.7)),d4=normalize(vec2(-1.0,-0.2));
  g+=d1*cos(dot(d1,p)*2.1+t*1.9)*0.045*2.1;g+=d2*cos(dot(d2,p)*3.3-t*2.4)*0.03*3.3;
  g+=d3*cos(dot(d3,p)*5.7+t*3.1)*0.016*5.7;g+=d4*cos(dot(d4,p)*8.9-t*3.7)*0.008*8.9;
  float e=0.06;vec2 q=p*1.6+vec2(t*0.35,t*0.21);g+=vec2(vn(q+vec2(e,0))-vn(q-vec2(e,0)),vn(q+vec2(0,e))-vn(q-vec2(0,e)))/(2.0*e)*0.05;
  return g;}
void main(){vec2 p=vW.xz-uFlow*uT;vec2 g=waveGrad(p,uT);
  for(int i=0;i<12;i++){vec4 r=uRip[i];float age=uT-r.z;if(age<0.0||age>3.0)continue;vec2 dv=vW.xz-r.xy;float d=length(dv)+1e-4;
    float front=age*2.4;float env=exp(-age*1.4)*exp(-abs(d-front)*2.2)*r.w;g+=(dv/d)*cos(d*11.0-age*16.0)*env*0.9;}
  vec3 N=normalize(vec3(-g.x,1.0,-g.y));vec3 V=normalize(cameraPosition-vW);
  float ndv=max(dot(N,V),0.0);float fres=0.03+0.97*pow(1.0-ndv,5.0);
  vec3 R=reflect(-V,N);vec3 refl=mix(uSky,uSkyTop,clamp(R.y*1.4,0.0,1.0));
  float edge=uSize.z>0.5?(1.0-length(vUv-0.5)*2.0)*uSize.x*0.5:min(min(vUv.x,1.0-vUv.x)*uSize.x,min(vUv.y,1.0-vUv.y)*uSize.y);
  float depthK=clamp(edge/1.6,0.0,1.0);vec3 body=mix(uShallow,uDeep,depthK);
  float caus=pow(vn(vW.xz*2.2+vec2(uT*0.6,-uT*0.4))*vn(vW.xz*2.9-vec2(uT*0.5,uT*0.3)),1.5)*0.35*(1.0-depthK*0.6);body+=caus;
  vec3 col=mix(body,refl,fres*0.85);
  vec3 H=normalize(uSun+V);float spec=pow(max(dot(N,H),0.0),180.0)*2.2;col+=vec3(1.0,0.97,0.88)*spec;
  float foam=smoothstep(0.55,0.0,edge)*(0.55+0.45*vn(vW.xz*6.0+vec2(uT*1.2,0.0)));foam+=smoothstep(0.75,0.95,vn(p*3.0+uT*0.4))*0.12;
  col=mix(col,vec3(0.93,0.96,0.95),clamp(foam,0.0,0.85));
  gl_FragColor=vec4(col,clamp(0.78+fres*0.2+foam*0.2,0.0,0.97));
  #include <fog_fragment>
}`;
function waterMat2(w,d,circle,flow){const m=new THREE.ShaderMaterial({uniforms:Object.assign(THREE.UniformsUtils.clone(THREE.UniformsLib.fog),{uT:WSH.uT,uRip:WSH.uRip,uSun:WSH.uSun,uSky:WSH.uSky,uSkyTop:WSH.uSkyTop,
    uFlow:{value:new THREE.Vector2(...(flow||[0,0]))},uSize:{value:new THREE.Vector3(w,d,circle?1:0)},uDeep:{value:new THREE.Color(0x0f4f5a)},uShallow:{value:new THREE.Color(0x3f9a9a)}}),
  vertexShader:WATER_VS,fragmentShader:WATER_FS,transparent:true,depthWrite:false,fog:true});return m;}
function addWater(x,y,z,w,d,opts={}){const circle=!!opts.circle;const geo=circle?new THREE.CircleGeometry(w/2,40):new THREE.PlaneGeometry(w,d,Math.max(1,Math.round(w/1.2)),Math.max(1,Math.round(d/1.2)));
  const m=new THREE.Mesh(geo,waterMat2(w,circle?w:d,circle,opts.flow));m.rotation.x=-Math.PI/2;m.position.set(x,y,z);m.userData.noMerge=1;m.renderOrder=2;world.add(m);
  WATERS.push({minX:x-w/2,maxX:x+w/2,minZ:z-(circle?w:d)/2,maxZ:z+(circle?w:d)/2,y,cx:x,cz:z,r:circle?w/2:0});return m;}
function waterAt(x,z,y){for(const W of WATERS){if(W.r?Math.hypot(x-W.cx,z-W.cz)<W.r:(x>W.minX&&x<W.maxX&&z>W.minZ&&z<W.maxZ))if(y===undefined||y<W.y+0.15)return W;}return null;}
function splash(pos,str=1){waterRipple(pos.x,pos.z,str);const n=Math.round(4+6*str);for(let i=0;i<n;i++){const m=new THREE.Mesh(GEO.part,PMAT.water);m.position.set(pos.x,pos.y+0.02,pos.z);scene.add(m);
  S.fx.push({m,v:new V3((Math.random()-0.5)*2.2*str,1.2+Math.random()*2.4*str,(Math.random()-0.5)*2.2*str),life:0.35+Math.random()*0.35,kind:'p'});}}
function waterShot(o,end){if(!WATERS.length)return;for(const W of WATERS){if((o.y-W.y)*(end.y-W.y)>=0)continue;const t=(W.y-o.y)/(end.y-o.y);const x=o.x+(end.x-o.x)*t,z=o.z+(end.z-o.z)*t;
  if(waterAt(x,z)===W){splash(new V3(x,W.y,z),0.8);sfx('splash',0.45,new V3(x,W.y,z));return;}}}
function updateWater(dt){WSH.uT.value+=dt;const p=player;if(!WATERS.length||S.state!=='game')return;
  for(const e of S.ents){if(!e.alive)continue;const W=waterAt(e.pos.x,e.pos.z,e.pos.y);if(!W)continue;const sp=e.vel?Math.hypot(e.vel.x,e.vel.z):(e.moving?3:0);
    e._wT=(e._wT||0)-dt;if(sp>0.6&&e._wT<=0){e._wT=Math.max(0.18,0.55-sp*0.05);waterRipple(e.pos.x,e.pos.z,Math.min(1.3,0.35+sp*0.12));
      if(e===p||e.pos.distanceTo(p.pos)<25){splash(new V3(e.pos.x,W.y,e.pos.z),Math.min(1,sp*0.12));sfx('wade',e===p?0.6:0.35,e===p?null:e.pos);}}}}

let WATER_MAT=null;
function waterMat(){if(WATER_MAT)return WATER_MAT;const t=canvasTex(128,(x,s)=>{x.fillStyle='#808080';x.fillRect(0,0,s,s);for(let i=0;i<70;i++){const y=Math.random()*s,l=10+Math.random()*30,x0=Math.random()*s;x.strokeStyle=`rgba(255,255,255,${0.15+Math.random()*0.35})`;x.lineWidth=1+Math.random()*1.5;x.beginPath();x.moveTo(x0,y);x.quadraticCurveTo(x0+l/2,y-2,x0+l,y);x.stroke();}
    for(let i=0;i<40;i++){x.fillStyle=`rgba(0,0,0,${Math.random()*0.12})`;x.beginPath();x.ellipse(Math.random()*s,Math.random()*s,8+Math.random()*14,3+Math.random()*4,0,0,7);x.fill();}});
  t.repeat.set(6,1);WATER_MAT=new THREE.MeshPhongMaterial({map:t,color:0x3f8a96,transparent:true,opacity:0.86,shininess:90,specular:0x8fb8c0,depthWrite:false});return WATER_MAT;}
function themePre(H,keep){S.canal=null;
  if(THEME.props==='anubis'){const cz=Math.round(rand(-H*0.28,H*0.28));S.canal=cz;
    const ks=keep.filter(([kx,kz,kr])=>Math.abs(kz-cz)<(kr||5)+4);if(ks.length){S.canal=null;return;}
    NOBUILD.push({minX:-H-2,maxX:H+2,minZ:cz-4.6,maxZ:cz+4.6});
    const bed=new THREE.Mesh(new THREE.PlaneGeometry(H*2,5),pm(0x6f6650,{map:texStone}));bed.rotation.x=-Math.PI/2;bed.position.set(0,0.012,cz);bed.receiveShadow=true;world.add(bed);
    addWater(0,0.24,cz,H*2,5,{flow:[0.55,0]});
    const curbM=pm(0xcdb689,{map:texStone}),gaps=[];for(let x=-H*0.62;x<=H*0.62;x+=H*0.62)gaps.push(x);
    for(const sg of[-1,1]){let x=-H;const ez=cz+sg*2.7;for(const gx of gaps.concat([H])){const x1=Math.min(gx-2.1,H);if(x1>x+0.5)solid((x+x1)/2,0,ez,x1-x,0.38,0.45,curbM);x=gx+2.1;}}
    for(const gx of gaps){solid(gx,0,cz,3.8,0.32,5.8,pm(0xbfa676,{map:texStone}));for(const sg of[-1,1])for(const ox of[-1.7,1.7])solid(gx+ox,0.32,cz+sg*2.75,0.3,0.7,0.3,curbM,true);}}}
function themeProps(H,keep){const P=THEME.props,n=Math.max(1,Math.round(H/12));
  const at=(r,fn,count)=>{for(let i=0;i<count;i++){const s=freeSpot(H,r,keep);if(s)fn(s[0],s[1]);}};
  if(P==='dust2'){at(3,(x,z)=>{const rot=rng()<.5;solid(x+(rot?0:-1.8),0,z+(rot?-1.8:0),1,4.2,1,MAT.walls[1]);solid(x+(rot?0:1.8),0,z+(rot?1.8:0),1,4.2,1,MAT.walls[1]);solid(x,4.2,z,rot?1.1:4.6,0.7,rot?4.6:1.1,MAT.ledge,false);},n);
    at(1.2,(x,z)=>{for(let i=0;i<3;i++)solid(x+i*0.7,0,z,0.6,0.9,0.6,pm(0x6e4b2c));},n);}
  if(P==='mirage'){at(3,(x,z)=>{const c=pick([0xb83a2a,0x2a6fa0,0xd09a2a,0x3a8a5a]);const a=new THREE.Mesh(new THREE.BoxGeometry(3.2,0.06,2.2),pm(c,{side:THREE.DoubleSide}));a.position.set(x,2.6,z);a.rotation.x=0.18;world.add(a);for(const sx of[-1.5,1.5])solid(x+sx,0,z-1,0.1,2.7,0.1,pm(0x6e4b2c),false);solid(x,0,z,2.4,0.9,0.9,pm(0x8a6a44));},n);
    at(2.5,(x,z)=>{const f=new THREE.Mesh(new THREE.CylinderGeometry(1.8,2,0.7,16),pm(0x3c7f8f,{map:texStone}));f.position.set(x,0.35,z);world.add(f);worldMeshes.push(f);colliders.push({minX:x-1.8,maxX:x+1.8,minZ:z-1.8,maxZ:z+1.8,minY:0,maxY:0.7});addWater(x,0.62,z,3.2,3.2,{circle:true});},Math.ceil(n/3));}
  if(P==='inferno'){at(3,(x,z)=>{const h=13;solid(x,0,z,3.2,h,3.2,MAT.walls[1]);solid(x,h,z,3.6,0.3,3.6,MAT.ledge,false);const r=new THREE.Mesh(new THREE.ConeGeometry(2.6,2.4,4),pm(0xa8502e));r.position.set(x,h+1.5,z);r.rotation.y=Math.PI/4;world.add(r);const b=new THREE.Mesh(new THREE.SphereGeometry(0.5,10,8),pm(0xb08a3a,{emissive:0x2a1a00}));b.position.set(x,h-1.4,z+1.62);world.add(b);},Math.ceil(n/4));
    at(1,(x,z)=>{solid(x,0,z,1.2,0.6,0.6,pm(0x7a4a2a));for(let i=0;i<4;i++){const f=new THREE.Mesh(new THREE.SphereGeometry(0.18,6,5),pm(pick([0xd03a3a,0xe0c040,0xf0f0f0,0xc060c0])));f.position.set(x-0.45+i*0.3,0.72,z);world.add(f);}},n*2);
    at(1.5,(x,z)=>{const c=new THREE.Mesh(new THREE.CylinderGeometry(0.75,0.75,1.2,10),pm(0xd8b860));c.position.set(x,0.6,z);c.rotation.z=Math.PI/2;world.add(c);worldMeshes.push(c);colliders.push({minX:x-0.6,maxX:x+0.6,minZ:z-0.75,maxZ:z+0.75,minY:0,maxY:1.5});},n);}
  if(P==='ancient'){at(9,(x,z)=>{const M=pm(0x8c907a,{map:texStone});let s=12;for(let i=0;i<4;i++){solid(x,i*1.15,z,s,1.15,s,M,true);s-=2.6;}solid(x,4.6,z,s+0.5,2.4,s+0.5,pm(0x7f856e,{map:texStone}));},Math.max(1,Math.ceil(n/5)));
    at(3.4,(x,z)=>{const pw=rand(3.5,5),pd=rand(3,4);addWater(x,0.12,z,pw,pd);const M2=pm(0x7f856e,{map:texStone});for(const sg of[-1,1]){solid(x,0,z+sg*(pd/2+0.2),pw+0.8,0.3,0.4,M2);solid(x+sg*(pw/2+0.2),0,z,0.4,0.3,pd,M2);}},n);
    at(1,(x,z)=>{solid(x,0,z,0.9,rand(1.5,3),0.9,pm(0x7f856e,{map:texStone}));},n*2);}
  if(P==='anubis'){
    at(1.2,(x,z)=>{solid(x,0,z,1.4,0.6,1.4,MAT.ledge);const o=new THREE.Mesh(new THREE.CylinderGeometry(0.25,0.55,7,4),pm(0xd8c08a,{map:texStone}));o.position.set(x,4.1,z);o.rotation.y=Math.PI/4;o.castShadow=true;world.add(o);worldMeshes.push(o);colliders.push({minX:x-0.6,maxX:x+0.6,minZ:z-0.6,maxZ:z+0.6,minY:0,maxY:7.6});const t=new THREE.Mesh(new THREE.ConeGeometry(0.3,0.6,4),pm(0xe0b040,{emissive:0x3a2a00}));t.position.set(x,7.9,z);t.rotation.y=Math.PI/4;world.add(t);},n);
    at(2,(x,z)=>{const M=pm(0xcdb689,{map:texStone});solid(x,0,z,1.6,1.2,3,M);solid(x,1.2,z-1,1.2,1.6,1,M);const e=new THREE.Mesh(new THREE.BoxGeometry(1.25,0.6,0.5),pm(0x2a5f86));e.position.set(x,2.5,z-1);world.add(e);},Math.ceil(n/2));}
  if(P==='cache'){at(3.5,(x,z)=>container(x,z,rng()<.5,pick([0x8a3b2a,0x2f5f8a,0x3f6f3a,0xb08a2a,0x7a7a72]),rng()<0.35),n*2);
    at(1.8,(x,z)=>{const Y=pm(0xd0a020);solid(x,0,z,1.1,1.2,2,Y);solid(x,1.2,z+0.3,1.1,1.1,0.9,pm(0x2a2a2a),true);solid(x,0,z-1.25,0.08,2.6,0.08,pm(0x3a3a3a),false);},Math.ceil(n/2));
    at(1.5,(x,z)=>{solid(x,0,z,1.2,0.25,1.2,pm(0x8a6a44));solid(x,0.25,z,1.1,0.9,1.1,pm(0x6a7a5a));},n);}
  if(P==='nuke'){at(4,(x,z)=>{const r=rand(2.4,3.4),h=rand(9,14);const s=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,18),pm(0xd9dde0,{map:texConcrete}));s.position.set(x,h/2,z);s.castShadow=true;s.receiveShadow=true;world.add(s);worldMeshes.push(s);colliders.push({minX:x-r*0.9,maxX:x+r*0.9,minZ:z-r*0.9,maxZ:z+r*0.9,minY:0,maxY:h});const c=new THREE.Mesh(new THREE.SphereGeometry(r,18,8,0,Math.PI*2,0,Math.PI/2),pm(0x9aa2a8));c.position.set(x,h,z);world.add(c);},Math.ceil(n/3));
    at(3.5,(x,z)=>container(x,z,rng()<.5,pick([0x2f5f9a,0xb08a2a,0x7a7a72,0x9a3b2a]),rng()<0.25),n);
    at(0.6,(x,z)=>{const rot=rng()<.5,L=rand(6,12);{const bad=(px,pz)=>blocked(px,pz,0.4)||keep.some(([kx,kz,kr])=>Math.hypot(px-kx,pz-kz)<(kr||5)+0.5);if(bad(x+(rot?0:L/2-0.5),z+(rot?L/2-0.5:0))||bad(x-(rot?0:L/2-0.5),z-(rot?L/2-0.5:0)))return;}const pipe=new THREE.Mesh(new THREE.CylinderGeometry(0.28,0.28,L,10),pm(0xc8a030));pipe.position.set(x,2.8,z);pipe.rotation[rot?'x':'z']=Math.PI/2;world.add(pipe);for(const e of[-L/2+0.5,L/2-0.5])solid(x+(rot?0:e),0,z+(rot?e:0),0.25,2.8,0.25,pm(0x5a5f66));},n);
    for(let i=-H+6;i<H-6;i+=6){const l=new THREE.Mesh(new THREE.PlaneGeometry(0.25,3),pm(0xe8c030));l.rotation.x=-Math.PI/2;l.position.set(0,0.025,i);world.add(l);}}
}


function blocked(x,z,m){for(const c of colliders)if(x>c.minX-m&&x<c.maxX+m&&z>c.minZ-m&&z<c.maxZ+m)return true;return false;}
function buildArena(H,nB,nC,{trees=0,lowWalls=8,keep=[],ladderChance=0.35}={}){
  clearWorld();mapH=H;groundPlane(H*2+120,(H*2+120)/8);boundary(H);
  themePre(H,keep);
  const placed=[];
  for(let i=0;i<nB*15&&placed.length<nB;i++){
    const w=rand(5,12),d=rand(5,12),h=rand(3.6,9.5);
    const x=rand(-H+w/2+3,H-w/2-3),z=rand(-H+d/2+3,H-d/2-3);
    if(keep.some(([kx,kz,kr])=>Math.hypot(x-kx,z-kz)<kr+Math.max(w,d)/2))continue;
    if(placed.some(p=>Math.abs(p.x-x)<(p.w+w)/2+4&&Math.abs(p.z-z)<(p.d+d)/2+4))continue;
    if(nbHit(x,z,w/2+1.5,d/2+1.5))continue;
    placed.push({x,z,w,d});building(x,z,w,d,h);
    if(h<8&&rng()<ladderChance)addLadder(x,z,w,d,h);
  }
  for(let i=0;i<nC;i++){
    const x=rand(-H+3,H-3),z=rand(-H+3,H-3);
    if(blocked(x,z,1.6)||nbHit(x,z,2)||inLadderZone(x,z,1.2)||keep.some(([kx,kz])=>Math.hypot(x-kx,z-kz)<5))continue;
    const r=rng();crate(x,z);
    if(r<0.3)solid(x,1.1,z,0.85,0.85,0.85,MAT.crate);else if(r<0.55&&!blocked(x+1.15,z,0.6))crate(x+1.15,z+rand(-0.2,0.2));
  }
  for(let i=0;i<lowWalls;i++){const len=rand(3,7),hor=rng()<.5,x=rand(-H+6,H-6),z=rand(-H+6,H-6);if(blocked(x,z,len/2+1.5)||nbHit(x,z,len/2+1)||inLadderZone(x,z,len/2+1)||keep.some(([kx,kz])=>Math.hypot(x-kx,z-kz)<6))continue;solid(x,0,z,hor?len:0.5,1.15,hor?0.5:len,MAT.ledge);}
  themeProps(H,keep);
  trees=Math.round(trees+H*0.25*(THEME.treeN||0));
  if(H>100){_clutter=true;for(let i=0;i<Math.round(H*0.6);i++){const f=freeSpot(H,1,keep,6);if(f)bush(f[0],f[1]);}_clutter=false;if(THEME.tree!=='none')for(let i=0;i<Math.round(H*0.12);i++){const f=freeSpot(H,2,keep,6);if(f)tree(f[0],f[1]);}}
  for(let i=0;i<trees;i++){const x=rand(-H+4,H-4),z=rand(-H+4,H-4);if(!blocked(x,z,2)&&!nbHit(x,z,1.5)&&!inLadderZone(x,z,1.5)&&!keep.some(([kx,kz,kr])=>Math.hypot(x-kx,z-kz)<(kr||5)))themedTree(x,z);}
}
/* ================= CLASSIC COMPETITIVE LAYOUT =================
   Three-lane map (T spawn north, CT spawn south): A Lane with long doors, Mid with double doors and an Xbox,
   Short A / CT cross, covered B tunnels, B window, two bomb sites with cover, CT spawn. Theme materials from the map. */
function clWall(x0,z0,x1,z1,h,mat){const w=Math.max(Math.abs(x1-x0),0.5),d=Math.max(Math.abs(z1-z0),0.5),cx=(x0+x1)/2,cz=(z0+z1)/2,M=mat||pick(MAT.walls);solidT(cx,0,cz,w,h,d,M,3);
  if(h>3&&M!==MAT.ledge){if(BLD_OCC.length){const sf=occSelf(cx,cz,w,d);sideBands(cx,cz,w,d,0,0.55,0.05,shadeOf(M,0.72),sf);sideBands(cx,cz,w,d,h,0.14,0.08,MAT.ledge,sf);if(h>6.5)sideBands(cx,cz,w,d,3.15,0.16,0.04,shadeOf(M,0.86),sf);}else{solidT(cx,0,cz,w+0.1,0.55,d+0.1,shadeOf(M,0.72),3,false);solidT(cx,h,cz,w+0.16,0.14,d+0.16,MAT.ledge,3,false);if(h>6.5)solidT(cx,3.15,cz,w+0.08,0.16,d+0.08,shadeOf(M,0.86),3,false);}}}
function clBlock(x0,z0,x1,z1,h){const w=x1-x0,d=z1-z0;building((x0+x1)/2,(z0+z1)/2,w,d,h);}
let _clDoorM=null;function clDoorMat(){if(_clDoorM)return _clDoorM;const t=canvasTex(64,(x,S,H)=>{x.fillStyle='#6b4a2c';x.fillRect(0,0,S,H);
    for(let i=0;i<S;i+=4){x.fillStyle=`rgba(${40+Math.random()*30|0},${25+Math.random()*20|0},10,.25)`;x.fillRect(i,0,2,H);}
    x.strokeStyle='rgba(30,18,8,.85)';x.lineWidth=3;x.strokeRect(6,5,S-12,H*0.42);x.strokeRect(6,H*0.53,S-12,H*0.42);x.strokeStyle='rgba(160,120,80,.4)';x.lineWidth=1;x.strokeRect(9,8,S-18,H*0.42-6);x.strokeRect(9,H*0.53+3,S-18,H*0.42-6);},128);
  t.wrapS=t.wrapT=THREE.ClampToEdgeWrapping;_clDoorM=Lm({map:t,color:0xc8b49a});return _clDoorM;}
function clDoorway(x0,x1,z,gap,h,mat,alongX=true){/* wall across a corridor with a doorway in the middle */
  const m=mat||pick(MAT.walls),c=(x0+x1)/2,g=gap/2,lint=MAT.ledge;
  if(alongX){clWall(x0,z-0.35,c-g,z+0.35,h,m);clWall(c+g,z-0.35,x1,z+0.35,h,m);solidT(c,3.1,z,gap,h-3.1,0.7,m,3);
    for(const sx of[-1,1])solidT(c+sx*(g+0.15),0,z+0.45,0.3,3.1,0.2,lint,3,false);
    // double wooden doors swung open flat against the wall (like Long A doors)
    const DM=clDoorMat();for(const sx of[-1,1]){const x0d=c+sx*(g+0.3),x1d=x0d+sx*(g-0.05),cx=(x0d+x1d)/2,lw=Math.abs(x1d-x0d);
      const leaf=new THREE.Mesh(new THREE.BoxGeometry(lw,2.95,0.1),DM);leaf.position.set(cx,1.5,z+0.62);leaf.rotation.y=sx*0.06;leaf.castShadow=leaf.receiveShadow=true;world.add(leaf);worldMeshes.push(leaf);
      colliders.push({minX:Math.min(x0d,x1d),maxX:Math.max(x0d,x1d),minZ:z+0.5,maxZ:z+0.78,minY:0,maxY:2.95});
      const hdl=new THREE.Mesh(new THREE.BoxGeometry(0.05,0.22,0.06),pm(0x9a9a92));hdl.position.set(x1d-sx*0.18,1.15,z+0.7);world.add(hdl);
      for(const hy of[0.45,2.5]){const hg=new THREE.Mesh(new THREE.BoxGeometry(0.22,0.08,0.14),pm(0x2b2b2b));hg.position.set(x0d-sx*0.06,hy,z+0.6);world.add(hg);}}}
  else{clWall(z-0.35,x0,z+0.35,c-g,h,m);}}
function clCrates(x,z,pat){const S2=1.1;for(const[ox,oz,st]of pat){crate(x+ox,z+oz);if(st)solid(x+ox,S2,z+oz,0.9,0.9,0.9,MAT.crate);}}
/* ===== 0.96 NEW MAP: "Crossroads" — a completely new competitive layout (T north, CT south, A west, B east)
   A Main: T west street → zig-zag corridor with doors → small yard → gate into the open A Courtyard.
   Mid: T street with double doors → central Plaza around a monument; Market Alley links the plaza to A Main.
   A Connector arch (plaza → A courtyard), B Garage arch (plaza → B Hall), CT Mid alley with a door down to the CT street.
   B Halls: T east street → roofed corridor → the big covered B Hall. CT street runs along the south and enters both sites. */
const XR_BLOCKS=[[14,34,-4,36,1],[-36,-5,14,34,0],[-50,-44,-50,50,0],[44,50,-50,50,1],[-44,-14,-50,-36,0],[14,44,-50,-36,0],[-18,-3,-30,-10,0],[3,18,-30,-10,1],[5,14,14,34,0],[-44,-14,44,50,0],[14,44,44,50,0],[-24,-14,-4,10,0],[-14,14,-50,-48,0],[-14,14,48,50,0],[-44,-32,-30,-26,0],[32,44,-30,-26,1],[-36,-24,6,10,0],[-36,-14,34,36,0],[-24,-18,-30,-26,0],[18,24,-30,-26,1],[-44,-36,-4,-2,0],[-28,-24,-4,-2,0],[-18,-14,-10,-9,0],[14,18,-10,-9,1],[-18,-14,-5,-4,0],[14,18,-5,-4,1]];
function buildClassic(H){
  clearWorld();mapH=H;groundPlane(H*2+120,(H*2+120)/8);boundary(H,9);S.canal=null;
  const r=()=>rng();const hh=(a,b)=>a+r()*(b-a);
  // ---- solid city: every block that is not street, plaza or site ----
  const flatR=!THEME.roof||THEME.roof==='flat';
  const XB=XR_BLOCKS.map(([x0,x1,z0,z1,hall])=>{const w=x1-x0,d=z1-z0,big=w*d>500,edge=Math.abs(x0)>=44||Math.abs(x1)>=44&&w<=6||Math.abs(z0)>=48||Math.abs(z1)>=48,thin=Math.min(w,d)<3;
    let h=hall?hh(8.6,10):edge?hh(7,9.5):big?hh(7,10):hh(5,8);if(thin)h=hall?Math.max(8.6,h):Math.min(h,6);return{x0,x1,z0,z1,h,thin};});
  BLD_OCC=XB.map(b=>({minX:b.x0,maxX:b.x1,minZ:b.z0,maxZ:b.z1,h:b.h+(b.thin?0.25:flatR?0.65:0.3)}));
  BLD_OCC.push({minX:-44,maxX:-36,minZ:25.6,maxZ:26.4,h:6.2},{minX:-5,maxX:5,minZ:23.6,maxZ:24.4,h:5.7},{minX:-3,maxX:3,minZ:-20.4,maxZ:-19.6,h:4.8},
    {minX:18,maxX:44,minZ:-26,maxZ:-4,y0:6.9,h:8.4},{minX:34,maxX:44,minZ:8,maxZ:30,y0:3.3,h:5.0},{minX:-18,maxX:-14,minZ:-9,maxZ:-5,y0:3.0,h:5.7},{minX:14,maxX:18,minZ:-9,maxZ:-5,y0:3.0,h:5.7},{minX:-36,maxX:-28,minZ:-4,maxZ:-2,y0:3.1,h:5.0});
  for(const b of XB){if(b.thin)clWall(b.x0,b.z0,b.x1,b.z1,b.h);else clBlock(b.x0,b.z0,b.x1,b.z1,b.h);}
  // ---- doors ----
  clDoorway(-44,-36,26,3.2,6);          // A Main doors
  clDoorway(-5,5,24,3.4,5.5);           // Mid doors
  clDoorway(-3,3,-20,2.4,4.6);          // CT Mid door
  // ---- arches over the two connectors ----
  for(const sx of[-1,1]){const M=pick(MAT.walls);solidT(sx*16,3.3,-7,4,2.2,4,M,3);solidT(sx*16,3.15,-7,4,0.25,4,MAT.ledge,3,false);}
  // A Main gate: lintel over the courtyard entrance
  solidT(-32,3.4,-3,8,1.4,2,pick(MAT.walls),3);solidT(-32,3.25,-3,8,0.22,2.1,MAT.ledge,3,false);
  // ---- plaza monument: stepped base + column (cover in the middle of Mid) ----
  {const SM=MAT.ledge;solidT(0,0,4,8,0.55,6,SM,3);solidT(0,0.55,4,5.4,0.65,3.6,shadeOf(SM,0.9),3);solidT(0,1.2,4,1.6,4.2,1.6,pick(MAT.walls),3);solidT(0,5.4,4,2.2,0.35,2.2,SM,3,false);}
  // ---- B Halls corridor roof (z 8..30) ----
  {const roofMat=pick(MAT.walls);solidT(39,3.6,19,10,1.2,22,roofMat,3);
   for(const z of[8.25,29.75]){solidT(39,3.6,z,10,3.2,0.5,roofMat,3);solidT(39,3.35,z,10,0.28,0.62,MAT.ledge,3,false);}
   for(let z=11;z<=27;z+=8)xrLamp(39,3.48,z,5);}
  // ---- B Hall: big covered site with support pillars and lamps ----
  {const RM=pick(MAT.walls);solidT(31,7.2,-15,26,0.9,22,RM,3);
   for(const[x,z]of[[24.5,-9.5],[37.5,-20.5],[24.5,-20.5]])solidT(x,0,z,0.9,7.2,0.9,shadeOf(RM,0.8),3);
   for(const[x,z]of[[24,-12],[31,-8],[38,-13],[31,-21],[24,-18]])xrLamp(x,7.15,z,6);}
  // ---- cover ----
  const A=SITES.A,B=SITES.B;
  clCrates(A.x-3,A.z+1,[[0,0,1],[1.15,0,1],[0,-1.15,0]]);clCrates(A.x+5,A.z-4,[[0,0,0],[0,1.15,1]]);
  solidT(-25,0,-9.2,4,1.1,0.6,MAT.ledge,3);solidT(-42.2,0,-14,1.4,1.4,6,MAT.ledge,3);solidT(-22,0,-21,0.6,1.1,4.5,MAT.ledge,3);
  clCrates(-38,-9,[[0,0,0]]);clCrates(-21,-5,[[0,0,1]]);
  clCrates(B.x-1,B.z+5,[[0,0,1],[1.15,0,0]]);clCrates(B.x-4,B.z-3,[[0,0,1],[0,-1.15,1]]);clCrates(41.5,-24,[[0,0,0]]);clCrates(19.5,-20,[[0,0,0]]);
  clCrates(-11.5,4,[[0,0,0]]);clCrates(10,-2,[[0,0,1]]);clCrates(-11,12.5,[[0,0,0]]);
  clCrates(-42.4,38,[[0,0,1]]);clCrates(-42.4,14,[[0,0,0]]);clCrates(-26,4.6,[[0,0,1]]);clCrates(-31,13.2,[[0,0,0]]);
  clCrates(41.6,38,[[0,0,0]]);clCrates(36.4,14,[[0,0,1]]);clCrates(41.6,0,[[0,0,0]]);
  clCrates(-10,-44,[[0,0,1]]);clCrates(10,-40,[[0,0,0],[1.15,0,0]]);clCrates(-38,-33,[[0,0,0]]);clCrates(38,-34.5,[[0,0,1]]);
  clCrates(-9,38,[[0,0,0]]);clCrates(9,46,[[0,0,1]]);
  solidT(-20,0,-35.2,5,1.1,0.6,MAT.ledge,3);solidT(20,0,-35.2,5,1.1,0.6,MAT.ledge,3);
  BARREL_SPOTS=[[-42.5,-25],[-19.5,-25],[42.5,-5.5],[19.5,-25],[-12.5,-9],[12.5,13],[-42.6,-1],[42.6,30],[-3.6,32],[-12,-46]];
  themeProps(H,[[0,42,9],[0,-42,9],[A.x,A.z,11],[B.x,B.z,12],[0,4,7],...BARREL_SPOTS.map(([x,z])=>[x,z,2.2]),...navKeep()]);
  barrelsSpawn();
  navBuild(NAV_CL);
}
function xrLamp(x,y,z,s){const lamp=new THREE.Mesh(new THREE.BoxGeometry(0.42,0.03,0.24),new THREE.MeshBasicMaterial({color:0xffe9b8}));lamp.position.set(x,y,z);world.add(lamp);
  const pool=new THREE.Mesh(FX_PLANE,new THREE.MeshBasicMaterial({map:FX_BALL,color:0xffd590,transparent:true,opacity:0.22,depthWrite:false,blending:THREE.AdditiveBlending}));pool.rotation.x=-Math.PI/2;pool.position.set(x,0.04,z);pool.scale.setScalar(s);pool.userData.noMerge=1;world.add(pool);}
const CL_MODES={defuse:1,tdm:1,ffa:1};
function buildDefuse(){
  spawns.T.set(0,0,43);spawns.CT.set(0,0,-43);
  buildClassic(50);
  for(const L of['A','B']){const s=SITES[L];
    const pl=new THREE.Mesh(new THREE.PlaneGeometry(s.r*2,s.r*2),new THREE.MeshBasicMaterial({map:letterTex(L),transparent:true,depthWrite:false}));pl.rotation.x=-Math.PI/2;pl.position.set(s.x,0.03,s.z);world.add(pl);
    solid(s.x+s.r+0.8,0,s.z-s.r,0.15,3,0.15,MAT.metal,true,false);
    const sg=new THREE.Mesh(new THREE.PlaneGeometry(1.4,1.4),new THREE.MeshLambertMaterial({map:signTex(L),side:THREE.DoubleSide}));sg.position.set(s.x+s.r+0.8,3.2,s.z-s.r);world.add(sg);
  }
}
function buildPractice(){
  clearWorld();const H=34;mapH=H;groundPlane(220,27);boundary(H,6);
  for(let z=-28;z<30;z+=11){building(-29,z,8,9,rand(5,9));building(29,z,8,9,rand(5,9));}
  solid(0,0,-31.5,40,6,2,MAT.walls[2]);
  const ln=new THREE.Mesh(new THREE.PlaneGeometry(42,0.3),MAT.yellow);ln.rotation.x=-Math.PI/2;ln.position.set(0,0.02,8);world.add(ln);
  solid(-7,0,9.2,9,1.1,0.5,MAT.ledge);solid(7,0,9.2,9,1.1,0.5,MAT.ledge);
  for(const[x,z]of[[-12,-12],[10,-16],[-4,-20],[16,-6],[-17,-24],[3,-9]]){crate(x,z);if(rng()<.5)crate(x+1.15,z);}
  spawns.A.set(0,0,20);
}
/* ---- lobby dressing: golden-hour sky, sun glow, light shafts, dust, spotlight, squad ---- */
const LOBBY={dust:null,squad:[],shafts:[]};
function gradTex(stops,w=8,h=256){return canvasTex(w,(x,W,H)=>{const g=x.createLinearGradient(0,0,0,H);for(const[o,c]of stops)g.addColorStop(o,c);x.fillStyle=g;x.fillRect(0,0,W,H);},h);}
const RADIAL=canvasTex(128,(x,s)=>{const g=x.createRadialGradient(s/2,s/2,0,s/2,s/2,s/2);g.addColorStop(0,'rgba(255,255,255,1)');g.addColorStop(0.35,'rgba(255,255,255,.55)');g.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=g;x.fillRect(0,0,s,s);});
let _crTex=null;
function lobbyCrate(x,y,z,S,ry){if(!_crTex){_crTex=canvasTex(512,(c,s)=>drawCrate(c,s,true));_crTex.anisotropy=8;}
  const g=new THREE.Group();g.position.set(x,y,z);g.rotation.y=ry;world.add(g);
  if(!_crTex.mats)_crTex.mats=[new THREE.MeshPhongMaterial({map:_crTex,shininess:6,specular:0x111111}),new THREE.MeshPhongMaterial({map:texCrate,color:0xb08868,shininess:8}),new THREE.MeshPhongMaterial({color:0x4a4d52,shininess:60,specular:0x666666})];const[face,fr,met]=_crTex.mats;
  const add=(geo,mat,px,py,pz)=>{const m=new THREE.Mesh(geo,mat);m.position.set(px,py,pz);m.castShadow=true;m.receiveShadow=true;g.add(m);return m;};
  add(new THREE.BoxGeometry(S*0.985,S*0.985,S*0.985),face,0,S/2,0);
  const t=S*0.075,h=S/2;for(const a of[-1,1])for(const b of[-1,1]){add(new THREE.BoxGeometry(S,t,t),fr,0,h+a*(h-t/2),b*(h-t/2));add(new THREE.BoxGeometry(t,t,S),fr,a*(h-t/2),h+b*(h-t/2),0);add(new THREE.BoxGeometry(t,S,t),fr,a*(h-t/2),h,b*(h-t/2));}
  for(const a of[-1,1])for(const b of[-1,1])for(const c of[-1,1]){add(new THREE.BoxGeometry(t*1.5,t*1.5,t*1.5),met,a*(h-t*0.6),h+b*(h-t*0.6),c*(h-t*0.6));}
  for(const a of[-1,1]){const hd=add(new THREE.BoxGeometry(S*0.28,S*0.05,S*0.04),met,0,h+S*0.18,a*(h+S*0.02));}
  g.updateMatrixWorld(true);for(const c of g.children.slice()){c.applyMatrix4(g.matrix);world.add(c);}world.remove(g);}
function lobbyGear(x,z){const add=(g,mt,px,py,pz)=>{const m=new THREE.Mesh(g,mt);m.position.set(px,py,pz);m.castShadow=true;m.receiveShadow=true;world.add(m);return m;};
  const bt=canvasTex(256,(c,w,h)=>{const g=c.createLinearGradient(0,0,w,0);g.addColorStop(0,'#2c4a6a');g.addColorStop(0.5,'#3d6690');g.addColorStop(1,'#2c4a6a');c.fillStyle=g;c.fillRect(0,0,w,h);
    for(let i=0;i<260;i++){c.fillStyle=`rgba(${120+Math.random()*60|0},${60+Math.random()*30|0},20,${Math.random()*0.35})`;const r=1+Math.random()*5;c.beginPath();c.arc(Math.random()*w,Math.random()*h,r,0,7);c.fill();}
    for(let i=0;i<40;i++){c.strokeStyle=`rgba(90,45,15,${0.15+Math.random()*0.2})`;c.lineWidth=1+Math.random()*2;const x0=Math.random()*w,y0=Math.random()*h*0.7;c.beginPath();c.moveTo(x0,y0);c.lineTo(x0+(Math.random()-0.5)*6,y0+20+Math.random()*50);c.stroke();}
    c.fillStyle='#f0a33c';c.fillRect(w*0.3,h*0.4,w*0.4,h*0.2);c.fillStyle='#1b1b1b';c.font='bold 30px Arial';c.textAlign='center';c.textBaseline='middle';c.fillText('⚠ FUEL',w/2,h/2);});
  const bm=new THREE.MeshPhongMaterial({map:bt,shininess:40,specular:0x333333});const rim=new THREE.MeshPhongMaterial({color:0x2a3e55,shininess:60,specular:0x555555});
  add(new THREE.CylinderGeometry(0.3,0.3,0.9,28,1,true),bm,x,0.47,z).rotation.y=-0.6;
  add(new THREE.CylinderGeometry(0.3,0.3,0.02,28),rim,x,0.935,z);
  for(const y of[0.04,0.3,0.64,0.92])add(new THREE.TorusGeometry(0.305,0.018,6,32),rim,x,y,z).rotation.x=Math.PI/2;
  add(new THREE.CylinderGeometry(0.04,0.04,0.025,12),rim,x+0.15,0.955,z+0.06);
  // ammo can on top
  const can=new THREE.Group();const ol=new THREE.MeshPhongMaterial({color:0x4d5a2e,shininess:25}),dk=new THREE.MeshPhongMaterial({color:0x2c3319});
  const bx=(w,h,d,m,px,py,pz)=>{const k=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);k.position.set(px,py,pz);k.castShadow=true;can.add(k);};
  bx(0.32,0.2,0.16,ol,0,0.1,0);bx(0.335,0.03,0.17,dk,0,0.205,0);bx(0.14,0.015,0.03,dk,0,0.225,0);
  const lab=new THREE.Mesh(new THREE.PlaneGeometry(0.2,0.08),new THREE.MeshBasicMaterial({map:canvasTex(64,(c,w,h)=>{c.fillStyle='#4d5a2e';c.fillRect(0,0,w,h);c.fillStyle='#e8d88a';c.font='bold 12px Arial';c.textAlign='center';c.textBaseline='middle';c.fillText('7.62 MM',w/2,h/2);},26)}));lab.position.set(0,0.1,0.081);can.add(lab);
  can.position.set(x-0.02,0.95,z+0.02);can.rotation.y=0.45;world.add(can);
  // a magazine and a few rounds dropped beside the barrel
  const mag=new THREE.Mesh(new THREE.BoxGeometry(0.05,0.2,0.09),new THREE.MeshPhongMaterial({color:0x26272a,shininess:50}));mag.position.set(x-0.45,0.03,z+0.35);mag.rotation.set(Math.PI/2,0,0.7);mag.castShadow=true;world.add(mag);
  const brass=new THREE.MeshPhongMaterial({color:0xc9a04a,shininess:90,specular:0xffe0a0});for(let i=0;i<4;i++){const r=new THREE.Mesh(new THREE.CylinderGeometry(0.008,0.008,0.05,8),brass);r.position.set(x-0.3+Math.random()*0.25,0.008,z+0.45+Math.random()*0.15);r.rotation.set(Math.PI/2,0,Math.random()*3);world.add(r);}}
function dressLobby(){
  const sky=new THREE.Mesh(new THREE.SphereGeometry(320,32,16),new THREE.MeshBasicMaterial({map:gradTex([[0,'#3b4f7a'],[0.32,'#8a86a8'],[0.46,'#e7a873'],[0.52,'#ffcf8a'],[0.6,'#d9b083'],[1,'#c9a27a']]),side:THREE.BackSide,fog:false,depthWrite:false}));sky.userData.noMerge=1;sky.renderOrder=-10;world.add(sky);
  const sunD=new THREE.Sprite(new THREE.SpriteMaterial({map:RADIAL,color:0xffd79a,transparent:true,blending:THREE.AdditiveBlending,depthWrite:false,fog:false}));sunD.position.set(0,22,-190);sunD.scale.set(90,90,1);sunD.userData.noMerge=1;world.add(sunD);
  const core=new THREE.Sprite(new THREE.SpriteMaterial({map:RADIAL,color:0xfff4d8,transparent:true,blending:THREE.AdditiveBlending,depthWrite:false,fog:false}));core.position.set(0,22,-189);core.scale.set(22,22,1);core.userData.noMerge=1;world.add(core);
  LOBBY.shafts=[];for(let i=0;i<6;i++){const m=new THREE.Mesh(new THREE.PlaneGeometry(3+Math.random()*4,60),new THREE.MeshBasicMaterial({map:gradTex([[0,'rgba(255,220,160,0)'],[0.45,'rgba(255,214,150,.16)'],[1,'rgba(255,214,150,0)']]),transparent:true,blending:THREE.AdditiveBlending,depthWrite:false,side:THREE.DoubleSide,fog:false}));
    m.position.set((Math.random()-0.5)*7,14,-30-i*12);m.rotation.set(0,0,(Math.random()-0.5)*0.5);m.rotation.x=-0.35;m.userData.noMerge=1;m.userData.ph=Math.random()*6;world.add(m);LOBBY.shafts.push(m);}
  const spot=new THREE.Mesh(new THREE.CircleGeometry(1.15,40),new THREE.MeshBasicMaterial({map:RADIAL,color:0xffc070,transparent:true,opacity:0.3,blending:THREE.AdditiveBlending,depthWrite:false}));spot.rotation.x=-Math.PI/2;spot.position.set(0,0.03,0);spot.userData.noMerge=1;world.add(spot);LOBBY.spot=spot;
  const ring=new THREE.Mesh(new THREE.RingGeometry(1.05,1.12,64),new THREE.MeshBasicMaterial({color:0xffb347,transparent:true,opacity:0.5,blending:THREE.AdditiveBlending,depthWrite:false}));ring.rotation.x=-Math.PI/2;ring.position.set(0,0.035,0);ring.userData.noMerge=1;ring.visible=false;world.add(ring);LOBBY.ring=ring;
  const N=420,pos=new Float32Array(N*3);for(let i=0;i<N;i++){pos[i*3]=(Math.random()-0.5)*14;pos[i*3+1]=Math.random()*6;pos[i*3+2]=2-Math.random()*26;}
  const pg=new THREE.BufferGeometry();pg.setAttribute('position',new THREE.BufferAttribute(pos,3));
  const dust=new THREE.Points(pg,new THREE.PointsMaterial({map:RADIAL,color:0xffe2b0,size:0.07,transparent:true,opacity:0.8,depthWrite:false,blending:THREE.AdditiveBlending}));dust.userData.noMerge=1;world.add(dust);LOBBY.dust=dust;
  // gang slots beside the operator (filled by gangLobby3D)
  LOBBY.squad=[];
  // props
  lobbyCrate(-2.7,0,-0.6,1.1,0.12);lobbyCrate(-2.78,1.1,-0.62,0.82,-0.22);lobbyCrate(-3.55,0,0.35,0.7,0.5);lobbyGear(2.75,-0.25);
  try{lobbyExtras();}catch(e){console.warn('lobbyExtras',e);}
}
/* ---- lobby life: circling helicopter, string lights, banners, parked jeep, sandbags, rim light ---- */
function lobbyExtras(){LOBBY.anim=[];
  const add=(m,x,y,z,cast=true)=>{m.position.set(x,y,z);m.castShadow=cast;m.receiveShadow=true;world.add(m);return m;};
  /* string lights across the street (one instanced mesh = one draw call) */
  const bulbs=[];for(const zz of[-5,-13,-22,-33,-46]){const N=22,sag=0.9+Math.random()*0.4,y0=5.4+Math.random()*0.6;for(let i=0;i<=N;i++){const t=i/N,x=-6.5+13*t,y=y0-Math.sin(t*Math.PI)*sag;bulbs.push([x,y,zz+Math.sin(t*Math.PI)*0.4]);}
    const wire=new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3([new THREE.Vector3(-6.5,y0,zz),new THREE.Vector3(0,y0-sag,zz+0.4),new THREE.Vector3(6.5,y0,zz)]),20,0.012,4,false),new THREE.MeshBasicMaterial({color:0x2a2420}));wire.userData.noMerge=1;world.add(wire);}
  const bm=new THREE.MeshBasicMaterial({color:0xffd8a0});const bi=new THREE.InstancedMesh(new THREE.SphereGeometry(0.06,8,6),bm,bulbs.length);const M4=new THREE.Matrix4();
  bulbs.forEach((b,i)=>{M4.makeTranslation(b[0],b[1],b[2]);bi.setMatrixAt(i,M4);});bi.userData.noMerge=1;world.add(bi);
  const glowM=new THREE.SpriteMaterial({map:RADIAL,color:0xffb060,transparent:true,opacity:0.55,blending:THREE.AdditiveBlending,depthWrite:false});
  const glows=[];bulbs.forEach((b,i)=>{if(i%2)return;const s=new THREE.Sprite(glowM);s.position.set(b[0],b[1],b[2]);s.scale.set(0.5,0.5,1);s.userData.noMerge=1;world.add(s);glows.push(s);});
  LOBBY.anim.push((dt,t)=>{glowM.opacity=0.45+0.1*Math.sin(t*3.1)+0.05*Math.sin(t*7.3);});
  /* hanging banners on the facades with the game chevron, gently swaying */
  const banTex=lobbyTex(128,384,(x,w,h)=>{const g=x.createLinearGradient(0,0,0,h);g.addColorStop(0,'#2a2a30');g.addColorStop(1,'#141418');x.fillStyle=g;x.fillRect(0,0,w,h);
    x.fillStyle='#ff8a2a';x.fillRect(0,0,w,14);x.fillRect(0,h-26,w,8);x.strokeStyle='#ff8a2a';x.lineWidth=10;x.lineJoin='round';
    for(const yy of[120,170]){x.beginPath();x.moveTo(w*0.2,yy+30);x.lineTo(w*0.5,yy);x.lineTo(w*0.8,yy+30);x.stroke();}
    x.fillStyle='#f4efe4';x.font='bold 22px Arial';x.textAlign='center';x.fillText('COMBAT',w/2,262);x.fillText('HORIZENS',w/2,290);
    x.fillStyle='rgba(255,138,42,.9)';x.beginPath();x.moveTo(0,h-18);x.lineTo(w/2,h);x.lineTo(w,h-18);x.fill();},1,1);
  const banM=new THREE.MeshLambertMaterial({map:banTex,side:THREE.DoubleSide});
  for(const[bx,bz,ry]of[[-6.45,-7,Math.PI/2],[6.45,-11,-Math.PI/2],[-6.45,-19,Math.PI/2],[6.45,-27,-Math.PI/2]]){const g=new THREE.Group();g.position.set(bx,6.2,bz);g.rotation.y=ry;
    const rod=new THREE.Mesh(new THREE.CylinderGeometry(0.03,0.03,1.2,6),new THREE.MeshLambertMaterial({color:0x3a3a3a}));rod.rotation.z=Math.PI/2;rod.position.set(0,0,0.55);g.add(rod);
    const ban=new THREE.Mesh(new THREE.PlaneGeometry(1,3,1,6),banM);ban.position.set(0,-1.5,0.6);ban.castShadow=true;g.add(ban);g.userData.noMerge=1;world.add(g);
    const ph=Math.random()*6;LOBBY.anim.push((dt,t)=>{ban.rotation.x=Math.sin(t*0.9+ph)*0.05;ban.rotation.y=Math.sin(t*0.6+ph)*0.08;});}
  /* parked military jeep behind the squad */
  {const g=new THREE.Group();const ol=Lm({color:0x55603f,map:texConcrete}),dk=Lm({color:0x23241f}),gl=new THREE.MeshLambertMaterial({color:0x9fb6c4,transparent:true,opacity:0.55});
    const body=new THREE.Mesh(new THREE.BoxGeometry(2.1,0.9,4.4),ol);body.position.y=0.95;g.add(body);const hood=new THREE.Mesh(new THREE.BoxGeometry(2.0,0.35,1.5),ol);hood.position.set(0,1.55,1.35);g.add(hood);
    const ws=new THREE.Mesh(new THREE.BoxGeometry(1.9,0.75,0.06),gl);ws.position.set(0,1.85,0.55);ws.rotation.x=-0.25;g.add(ws);
    const bar=new THREE.Mesh(new THREE.TorusGeometry(0.95,0.05,6,16,Math.PI),dk);bar.position.set(0,1.45,-0.6);g.add(bar);
    const grill=new THREE.Mesh(new THREE.BoxGeometry(1.7,0.55,0.08),dk);grill.position.set(0,1.05,2.22);g.add(grill);
    for(const s of[-1,1]){const hl=new THREE.Mesh(new THREE.CircleGeometry(0.13,12),new THREE.MeshBasicMaterial({color:0xfff2c8}));hl.position.set(s*0.62,1.12,2.27);g.add(hl);}
    for(const[wx,wz]of[[-1.05,1.4],[1.05,1.4],[-1.05,-1.35],[1.05,-1.35]]){const w=new THREE.Mesh(new THREE.CylinderGeometry(0.46,0.46,0.38,18),dk);w.rotation.z=Math.PI/2;w.position.set(wx,0.46,wz);g.add(w);}
    const sp=new THREE.Mesh(new THREE.CylinderGeometry(0.42,0.42,0.3,16),dk);sp.rotation.x=Math.PI/2;sp.position.set(0,1.1,-2.36);g.add(sp);
    const jc=new THREE.Mesh(new THREE.BoxGeometry(0.35,0.5,0.25),Lm({color:0x3f4a2e}));jc.position.set(0.75,1.65,-1.8);g.add(jc);
    g.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true;}});g.position.set(4.7,0,-13.5);g.rotation.y=-0.95;g.userData.noMerge=1;world.add(g);}
  /* sandbag wall on the left */
  {const sb=Lm({color:0xa38f6a,map:texConcrete});for(let r=0;r<3;r++)for(let i=0;i<5-r;i++){const b=new THREE.Mesh(THREE.CapsuleGeometry?new THREE.CapsuleGeometry(0.18,0.42,4,8):new THREE.CylinderGeometry(0.19,0.19,0.78,10),sb);if(!THREE.CapsuleGeometry)b.rotation.z=Math.PI/2;
      if(b.geometry.type==='CapsuleGeometry')b.rotation.z=Math.PI/2;const a=-0.5+i*0.24+r*0.12;b.position.set(-3.9+Math.cos(a)*1.6,0.18+r*0.33,-4.6+Math.sin(a)*1.6);b.rotation.y=-a;b.castShadow=b.receiveShadow=true;world.add(b);}}
  /* helicopter slowly circling far down the street */
  {const h=new THREE.Group();const hm=Lm({color:0x3c4434}),dk=Lm({color:0x1d1f1a}),gl=new THREE.MeshLambertMaterial({color:0x26323a});
    const fus=new THREE.Mesh(new THREE.SphereGeometry(1,16,12),hm);fus.scale.set(1.15,1.05,2.3);h.add(fus);const win=new THREE.Mesh(new THREE.SphereGeometry(0.95,14,10,0,Math.PI*2,0,Math.PI*0.45),gl);win.scale.set(1.12,1,1.5);win.rotation.x=Math.PI/2.4;win.position.set(0,0.15,1.2);h.add(win);
    const boom=new THREE.Mesh(new THREE.CylinderGeometry(0.16,0.32,4.2,8),hm);boom.rotation.x=Math.PI/2;boom.position.set(0,0.25,-3.8);h.add(boom);
    const fin=new THREE.Mesh(new THREE.BoxGeometry(0.08,1.2,0.8),hm);fin.position.set(0,0.75,-5.8);h.add(fin);
    const tr=new THREE.Mesh(new THREE.BoxGeometry(0.04,1.3,0.12),dk);tr.position.set(0.12,0.75,-5.8);h.add(tr);
    const mast=new THREE.Mesh(new THREE.CylinderGeometry(0.1,0.1,0.5,8),dk);mast.position.y=1.25;h.add(mast);
    const rot=new THREE.Group();rot.position.y=1.5;for(let i=0;i<4;i++){const b=new THREE.Mesh(new THREE.BoxGeometry(7.4,0.04,0.3),dk);b.rotation.y=i*Math.PI/4*2;rot.add(b);}h.add(rot);
    const disc=new THREE.Mesh(new THREE.CircleGeometry(3.7,32),new THREE.MeshBasicMaterial({color:0x111111,transparent:true,opacity:0.12,depthWrite:false}));disc.rotation.x=-Math.PI/2;disc.position.y=1.52;h.add(disc);
    for(const s of[-1,1]){const sk=new THREE.Mesh(new THREE.CylinderGeometry(0.05,0.05,3,6),dk);sk.rotation.x=Math.PI/2;sk.position.set(s*0.8,-1.15,0);h.add(sk);}
    const nav=new THREE.Mesh(new THREE.SphereGeometry(0.09,8,6),new THREE.MeshBasicMaterial({color:0xff2a1a}));nav.position.set(0,-0.9,0);h.add(nav);
    const navG=new THREE.Sprite(new THREE.SpriteMaterial({map:RADIAL,color:0xff3a2a,transparent:true,blending:THREE.AdditiveBlending,depthWrite:false,fog:false}));navG.scale.set(1.2,1.2,1);navG.position.copy(nav.position);h.add(navG);
    h.scale.setScalar(1.25);h.userData.noMerge=1;world.add(h);
    LOBBY.anim.push((dt,t)=>{const a=t*0.12;h.position.set(Math.sin(a)*8,12.5+Math.sin(t*0.5)*0.7,-52+Math.cos(a)*9);h.rotation.y=a+Math.PI/2;h.rotation.z=-0.12;h.rotation.x=0.06*Math.sin(t*0.4);
      rot.rotation.y+=dt*28;tr.rotation.x+=dt*40;const on=(t%1.2)<0.18;nav.visible=on;navG.visible=on;});}
  /* cool rim light from behind so the soldiers pop against the warm street */
  if(!LOBBY.rim){LOBBY.rim=new THREE.DirectionalLight(0x8fb4ff,0.55);scene.add(LOBBY.rim);scene.add(LOBBY.rim.target);}
  LOBBY.rim.position.set(-3,4,-6);LOBBY.rim.target.position.set(0,1,0);LOBBY.rim.visible=true;}

function lobbyLight(on){if(on){sun.color.setHex(0xffc68a);sun.intensity=1.25;if(HEMI){HEMI.color.setHex(0xffe6cc);HEMI.groundColor.setHex(0x7a5a40);HEMI.intensity=1.0;}scene.fog.color.setHex(0xe0b88c);scene.background.setHex(0xe0b88c);scene.fog.near=14;scene.fog.far=120;}
  else{sun.intensity=0.95;}}
function updateLobby(dt,t){if(LOBBY.anim)for(const f of LOBBY.anim)try{f(dt,t);}catch(e){}if(LOBBY.dust){const a=LOBBY.dust.geometry.attributes.position;for(let i=0;i<a.count;i++){let y=a.getY(i)+dt*0.06,x=a.getX(i)+Math.sin(t*0.3+i)*dt*0.05;if(y>6)y=0;a.setY(i,y);a.setX(i,x);}a.needsUpdate=true;}
  for(const m of LOBBY.shafts){m.material.opacity=0.6+0.4*Math.sin(t*0.4+m.userData.ph);}
  if(LOBBY.ring){LOBBY.ring.material.opacity=0.18+0.12*Math.sin(t*1.5);LOBBY.ring.rotation.z=t*0.2;}if(LOBBY.pad){LOBBY.pad.rotation.z=-t*0.08;LOBBY.pad.material.opacity=0.85+0.15*Math.sin(t*1.2);}
  for(const s of LOBBY.squad)animSoldier(s,{spd:0,pitch:0.05,carry:true,dt});}


/* ===== menu street v2: tiled sun-baked asphalt with cracks, patches, tyre wear and oil stains, dashed centre line,
   stone kerbs, paved sidewalks, sand drifts, a drain and a manhole, and a painted deployment pad under the operator ===== */
function lobbyTex(w,h,draw,rx,ry){const c=document.createElement('canvas');c.width=w;c.height=h;draw(c.getContext('2d'),w,h);const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(rx,ry);t.anisotropy=8;return t;}
function lobbyStreet(){const L=150,Z=-60;
  const asphalt=lobbyTex(512,512,(x,w,h)=>{x.fillStyle='#5b544b';x.fillRect(0,0,w,h);
      for(let i=0;i<26000;i++){const v=70+Math.random()*70|0;x.fillStyle=`rgba(${v+12},${v+6},${v},${0.18+Math.random()*0.3})`;const r=Math.random()*1.8+0.4;x.fillRect(Math.random()*w,Math.random()*h,r,r);}
      for(let i=0;i<900;i++){x.fillStyle=`rgba(230,220,200,${0.12+Math.random()*0.25})`;x.fillRect(Math.random()*w,Math.random()*h,1.4,1.4);}
      // tyre-polished lanes (darker, smoother)
      for(const cx of[w*0.27,w*0.38,w*0.62,w*0.73]){const g=x.createLinearGradient(cx-22,0,cx+22,0);g.addColorStop(0,'rgba(30,26,22,0)');g.addColorStop(0.5,'rgba(30,26,22,.22)');g.addColorStop(1,'rgba(30,26,22,0)');x.fillStyle=g;x.fillRect(cx-22,0,44,h);}
      // patch repairs
      for(let i=0;i<3;i++){const pw=60+Math.random()*90,ph=40+Math.random()*120,px=Math.random()*(w-pw),py=Math.random()*(h-ph);x.fillStyle='rgba(40,36,32,.55)';x.fillRect(px,py,pw,ph);x.strokeStyle='rgba(20,18,16,.6)';x.lineWidth=2;x.strokeRect(px,py,pw,ph);}
      // cracks
      x.lineCap='round';for(let i=0;i<14;i++){let px=Math.random()*w,py=Math.random()*h;x.strokeStyle=`rgba(18,15,12,${0.45+Math.random()*0.35})`;x.lineWidth=0.8+Math.random()*1.6;x.beginPath();x.moveTo(px,py);for(let k=0;k<10;k++){px+=(Math.random()-0.5)*34;py+=Math.random()*26-6;x.lineTo(px,py);if(Math.random()<0.25){x.moveTo(px,py);}}x.stroke();}
      // oil stains
      for(let i=0;i<5;i++){const cx=Math.random()*w,cy=Math.random()*h,r=10+Math.random()*26;const g=x.createRadialGradient(cx,cy,0,cx,cy,r);g.addColorStop(0,'rgba(15,12,10,.5)');g.addColorStop(1,'rgba(15,12,10,0)');x.fillStyle=g;x.beginPath();x.ellipse(cx,cy,r*1.4,r,Math.random()*3,0,6.3);x.fill();}
      // blown sand
      for(let i=0;i<10;i++){const cx=Math.random()*w,cy=Math.random()*h,r=20+Math.random()*50;const g=x.createRadialGradient(cx,cy,0,cx,cy,r);g.addColorStop(0,'rgba(214,180,130,.28)');g.addColorStop(1,'rgba(214,180,130,0)');x.fillStyle=g;x.fillRect(cx-r,cy-r,2*r,2*r);}
    },1,L/9);
  const road=new THREE.Mesh(new THREE.PlaneGeometry(9,L),Lm({map:asphalt,color:0xffffff}));road.rotation.x=-Math.PI/2;road.position.set(0,0.012,Z);road.receiveShadow=true;world.add(road);
  // sand drifting onto the road edges
  const drift=lobbyTex(64,256,(x,w,h)=>{const g=x.createLinearGradient(0,0,w,0);g.addColorStop(0,'rgba(222,190,140,.95)');g.addColorStop(0.55,'rgba(222,190,140,.35)');g.addColorStop(1,'rgba(222,190,140,0)');x.fillStyle=g;x.fillRect(0,0,w,h);
      for(let i=0;i<400;i++){x.fillStyle=`rgba(200,165,115,${Math.random()*0.4})`;x.fillRect(Math.random()*w*0.7,Math.random()*h,2,2);}},1,L/12);
  for(const sx of[-1,1]){const d=new THREE.Mesh(new THREE.PlaneGeometry(1.3,L),new THREE.MeshLambertMaterial({map:drift,transparent:true,depthWrite:false}));d.rotation.x=-Math.PI/2;if(sx>0)d.rotation.z=Math.PI;d.position.set(sx*3.85,0.016,Z);d.userData.noMerge=1;world.add(d);}
  // lane markings: worn edge lines + dashed centre
  const paint=lobbyTex(32,256,(x,w,h)=>{x.fillStyle='rgba(240,232,210,.92)';x.fillRect(0,0,w,h);for(let i=0;i<500;i++){x.clearRect(Math.random()*w,Math.random()*h,2+Math.random()*3,2+Math.random()*3);}},1,L/10);
  const yellow=lobbyTex(32,256,(x,w,h)=>{x.fillStyle='rgba(232,176,48,.92)';x.fillRect(0,0,w,h);for(let i=0;i<500;i++){x.clearRect(Math.random()*w,Math.random()*h,2+Math.random()*3,2+Math.random()*3);}},1,1);
  const pm2=t=>new THREE.MeshLambertMaterial({map:t,transparent:true,depthWrite:false,polygonOffset:true,polygonOffsetFactor:-1});
  for(const sx of[-1,1]){const l=new THREE.Mesh(new THREE.PlaneGeometry(0.13,L),pm2(paint));l.rotation.x=-Math.PI/2;l.position.set(sx*3.75,0.02,Z);l.userData.noMerge=1;world.add(l);}
  const ym=pm2(yellow);for(let z=6;z>-130;z-=4.2){if(Math.abs(z)<2.2)continue;const d=new THREE.Mesh(new THREE.PlaneGeometry(0.16,2.2),ym);d.rotation.x=-Math.PI/2;d.position.set(0,0.021,z);d.userData.noMerge=1;world.add(d);}
  // stone kerbs (alternating, like desert towns) + paved sidewalks
  const kerbA=Lm({color:0xcfc6b2,map:texConcrete}),kerbB=Lm({color:0xb03a2e,map:texConcrete});
  for(const sx of[-1,1])for(let z=12,i=0;z>-135;z-=1.2,i++){solid(sx*4.62,0,z,0.26,0.16,1.18,i%2&&Math.abs(z)<30?kerbB:kerbA,false,false);}
  const pav=lobbyTex(256,256,(x,w,h)=>{x.fillStyle='#b9a888';x.fillRect(0,0,w,h);const n=4,s=w/n;for(let r=0;r<n;r++)for(let c=0;c<n;c++){const v=165+Math.random()*30|0;x.fillStyle=`rgb(${v+16},${v+4},${v-18})`;x.fillRect(c*s+2,r*s+2,s-4,s-4);
      for(let i=0;i<120;i++){x.fillStyle=`rgba(90,70,50,${Math.random()*0.18})`;x.fillRect(c*s+Math.random()*s,r*s+Math.random()*s,2,2);}}x.strokeStyle='rgba(80,64,46,.6)';x.lineWidth=3;for(let i=0;i<=n;i++){x.beginPath();x.moveTo(i*s,0);x.lineTo(i*s,h);x.moveTo(0,i*s);x.lineTo(w,i*s);x.stroke();}
      x.strokeStyle='rgba(60,46,32,.45)';x.lineWidth=1;for(let i=0;i<5;i++){let px=Math.random()*w,py=Math.random()*h;x.beginPath();x.moveTo(px,py);for(let k=0;k<5;k++){px+=(Math.random()-0.5)*20;py+=(Math.random()-0.5)*20;x.lineTo(px,py);}x.stroke();}},1.1,L/1.9);
  const pavM=Lm({map:pav});for(const sx of[-1,1]){const sw=new THREE.Mesh(new THREE.BoxGeometry(1.95,0.14,L),pavM);sw.position.set(sx*5.72,0.07,Z);sw.receiveShadow=true;world.add(sw);}
  // street furniture: drain grate on the kerb line, manhole behind the squad, a tyre skid mark
  const iron=Lm({color:0x2e2b28,map:texConcrete});const grate=new THREE.Mesh(new THREE.PlaneGeometry(0.55,0.9),new THREE.MeshLambertMaterial({map:lobbyTex(64,96,(x,w,h)=>{x.fillStyle='#2b2724';x.fillRect(0,0,w,h);x.fillStyle='#0b0a09';for(let i=0;i<7;i++)x.fillRect(6,8+i*12,w-12,6);},1,1)}));grate.rotation.x=-Math.PI/2;grate.position.set(-4.2,0.022,-5.5);grate.userData.noMerge=1;world.add(grate);
  const mh=new THREE.Mesh(new THREE.CircleGeometry(0.42,28),new THREE.MeshLambertMaterial({map:lobbyTex(128,128,(x,w,h)=>{x.fillStyle='#3a342e';x.beginPath();x.arc(64,64,63,0,6.3);x.fill();x.strokeStyle='#221e1a';x.lineWidth=4;x.beginPath();x.arc(64,64,52,0,6.3);x.stroke();x.lineWidth=3;for(let i=-3;i<=3;i++){x.beginPath();x.moveTo(20,64+i*12);x.lineTo(108,64+i*12);x.stroke();}x.fillStyle='#8a7f72';x.font='bold 12px Arial';x.textAlign='center';x.fillText('DRAIN',64,30);},1,1)}));mh.rotation.x=-Math.PI/2;mh.position.set(1.6,0.022,-6.8);mh.userData.noMerge=1;world.add(mh);
  const skid=new THREE.Mesh(new THREE.PlaneGeometry(0.5,7),new THREE.MeshBasicMaterial({map:lobbyTex(32,256,(x,w,h)=>{x.clearRect(0,0,w,h);for(const cx of[6,26]){const g=x.createLinearGradient(0,0,0,h);g.addColorStop(0,'rgba(10,8,6,0)');g.addColorStop(0.3,'rgba(10,8,6,.5)');g.addColorStop(1,'rgba(10,8,6,0)');x.fillStyle=g;x.fillRect(cx-3,0,6,h);}},1,1),transparent:true,depthWrite:false}));
  skid.rotation.set(-Math.PI/2,0,0.18);skid.position.set(-1.8,0.023,-14);skid.userData.noMerge=1;world.add(skid);
  // deployment pad under the operator: painted stencil circle with tick marks and the team chevron
  const pad=new THREE.Mesh(new THREE.CircleGeometry(1.3,64),new THREE.MeshBasicMaterial({map:lobbyTex(512,512,(x,w,h)=>{x.clearRect(0,0,w,h);const c=w/2;
      x.strokeStyle='rgba(255,196,110,.85)';x.lineWidth=7;x.beginPath();x.arc(c,c,c-14,0,6.3);x.stroke();x.lineWidth=3;x.strokeStyle='rgba(255,196,110,.45)';x.beginPath();x.arc(c,c,c-40,0,6.3);x.stroke();
      for(let i=0;i<48;i++){const a=i/48*6.283,r1=c-24,r2=c-(i%4?32:44);x.lineWidth=i%4?2:4;x.beginPath();x.moveTo(c+Math.cos(a)*r1,c+Math.sin(a)*r1);x.lineTo(c+Math.cos(a)*r2,c+Math.sin(a)*r2);x.stroke();}
      x.fillStyle='rgba(255,196,110,.22)';x.beginPath();x.moveTo(c,c-150);x.lineTo(c+60,c-90);x.lineTo(c+28,c-90);x.lineTo(c,c-118);x.lineTo(c-28,c-90);x.lineTo(c-60,c-90);x.closePath();x.fill();
      x.font='bold 30px Arial';x.textAlign='center';x.fillStyle='rgba(255,196,110,.5)';x.fillText('DEPLOY',c,c+150);},1,1),transparent:true,depthWrite:false,blending:THREE.AdditiveBlending}));
  pad.rotation.x=-Math.PI/2;pad.position.set(0,0.026,0);pad.userData.noMerge=1;world.add(pad);LOBBY.pad=pad;try{agLobbyTint();}catch(e){}}
function buildMenuStreet(){
  resetTheme();clearWorld();mapH=200;groundPlane(400,50);
  lobbyStreet();
  for(const side of[-1,1]){let z=8;while(z>-125){const d=rand(6,12),w=rand(6,10);building(side*(6.6+w/2),z-d/2,w,d,rand(5,11));z-=d+rand(0,0.8);}}
  building(0,-131,30,6,15);
  solid(-6.75,3.6,-2.5,0.15,0.9,0.9,MAT.sign,false);solid(6.75,4,-9,0.15,0.7,1.6,MAT.door[1],false);
  dressLobby();lobbyLight(true);mergeWorld();
}

/* ================= SOLDIER MODEL ================= */
/* ---- geometry merging (fewer draw calls) ---- */
function mergeInto(list){let n=0;const gs=[];
  for(const it of list){const g=it.geo.index?it.geo.toNonIndexed():it.geo.clone();g.applyMatrix4(it.m);gs.push(g);n+=g.attributes.position.count;}
  const pos=new Float32Array(n*3),nor=new Float32Array(n*3),uv=new Float32Array(n*2);let o=0;
  for(const g of gs){const P=g.attributes.position,N=g.attributes.normal,U=g.attributes.uv;pos.set(P.array,o*3);if(N)nor.set(N.array,o*3);if(U)uv.set(U.array,o*2);o+=P.count;g.dispose();}
  const out=new THREE.BufferGeometry();out.setAttribute('position',new THREE.BufferAttribute(pos,3));out.setAttribute('normal',new THREE.BufferAttribute(nor,3));out.setAttribute('uv',new THREE.BufferAttribute(uv,2));out.computeBoundingSphere();out.computeBoundingBox();return out;}
function mergeWorld(){if(!world)return;world.updateMatrixWorld(true);const inv=new THREE.Matrix4().copy(world.matrixWorld).invert();const B=new Map();
  for(const o of world.children.slice()){if(!o.isMesh||!o.visible||Array.isArray(o.material)||o.material.transparent||o.userData.noMerge)continue;
    const k=o.material.uuid+'|'+(o.castShadow?1:0)+(o.receiveShadow?1:0);let b=B.get(k);if(!b){b={mat:o.material,cs:o.castShadow,rs:o.receiveShadow,list:[],src:[]};B.set(k,b);}
    b.list.push({geo:o.geometry,m:new THREE.Matrix4().multiplyMatrices(inv,o.matrixWorld)});b.src.push(o);}
  for(const b of B.values()){if(b.src.length<2)continue;const m=new THREE.Mesh(mergeInto(b.list),b.mat);m.castShadow=b.cs;m.receiveShadow=b.rs;m.userData.merged=1;m.matrixAutoUpdate=false;m.updateMatrix();world.add(m);
    for(const s of b.src){s.visible=false;s.matrixAutoUpdate=false;}}}
/* ---- soldier model ---- */
/* ---- soldier model v2: rounded gear, baked shading, real skeleton (pelvis > spine > head, gun, legs) ---- */
const SOLD_MAT={},CAMO_TEX={};
function soldierMat(a,b){const k=a+'_'+b;if(SOLD_MAT[k])return SOLD_MAT[k];const cam=camoTex(a,b).image;const c=document.createElement('canvas');c.width=256;c.height=128;const x=c.getContext('2d');
  x.drawImage(cam,0,0,128,128);x.fillStyle='#fff';x.fillRect(128,0,128,128);
  // right half: neutral fabric / material grain tinted by vertex colour
  const id=x.getImageData(128,0,128,128),d=id.data;let s=12345;for(let i=0;i<d.length;i+=4){s=(Math.imul(s,1103515245)+12345)>>>0;const px=(i>>2)%128,py=(i>>2)>>7;const weave=((px+py)%3===0?-5:0)+((px-py+128)%5===0?-3:0);const n=((s>>>16)%14)-7+weave;d[i]=d[i+1]=d[i+2]=Math.max(0,Math.min(255,236+n));}x.putImageData(id,128,0);
  const t=new THREE.CanvasTexture(c);t.anisotropy=4;return SOLD_MAT[k]=new THREE.MeshLambertMaterial({map:t,vertexColors:true});}
function camoTex(a,b){const k=a+'_'+b;if(CAMO_TEX[k])return CAMO_TEX[k];const S=128,c=document.createElement('canvas');c.width=c.height=S;const x=c.getContext('2d');
  const sh=(n,f)=>`rgb(${Math.min(255,((n>>16)&255)*f)|0},${Math.min(255,((n>>8)&255)*f)|0},${Math.min(255,(n&255)*f)|0})`;
  let s=((a*31)^b)>>>0||7;const rnd=()=>((s=(Math.imul(s,1664525)+1013904223)>>>0)/4294967296);
  x.fillStyle=sh(a,1);x.fillRect(0,0,S,S);
  for(let i=0;i<46;i++){x.fillStyle=i%3===0?sh(a,0.72):i%3===1?sh(b,1):sh(b,1.2);const cx=rnd()*S,cy=rnd()*S;const pts=[];for(let j=0;j<9;j++){const an=j/9*Math.PI*2,r=5+rnd()*12;pts.push([Math.cos(an)*r,Math.sin(an)*r*0.7]);}
    for(const ox of[-S,0,S])for(const oy of[-S,0,S]){x.beginPath();pts.forEach(([px,py],j)=>j?x.lineTo(cx+ox+px,cy+oy+py):x.moveTo(cx+ox+px,cy+oy+py));x.closePath();x.fill();}}
  const id=x.getImageData(0,0,S,S),d=id.data;for(let i=0;i<d.length;i+=4){const px=(i>>2)%S,py=(i>>2)/S|0;const weave=((px+py)%2?-3:3)+((py%4)===0?-4:0);const n=(rnd()-0.5)*12+weave;d[i]+=n;d[i+1]+=n;d[i+2]+=n;}x.putImageData(id,0,0);
  const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;return CAMO_TEX[k]=t;}
/* box with rounded edges; normals point away from the inner core so shading is smooth */
const _rbCache={};
function rbox(w,h,d,r,seg=3){const key=[w,h,d,r,seg].map(v=>v.toFixed(3)).join('|');if(_rbCache[key])return _rbCache[key].clone();r=Math.min(r,w/2-0.001,h/2-0.001,d/2-0.001);
  const g=new THREE.BoxGeometry(w,h,d,seg,seg,seg);const P=g.attributes.position,N=g.attributes.normal;const hx=w/2-r,hy=h/2-r,hz=d/2-r,v=new V3(),c=new V3();
  for(let i=0;i<P.count;i++){v.fromBufferAttribute(P,i);c.set(clamp(v.x,-hx,hx),clamp(v.y,-hy,hy),clamp(v.z,-hz,hz));v.sub(c);const L=v.length();if(L>1e-6){v.multiplyScalar(r/L);N.setXYZ(i,v.x/r,v.y/r,v.z/r);}v.add(c);P.setXYZ(i,v.x,v.y,v.z);}
  _rbCache[key]=g;return g.clone();}
/* realistic head shape from a deformed sphere, with stubble, blush and under-eye shading in vertex colours */
function sculptHead(tone){const g=new THREE.SphereGeometry(1,28,22);const P=g.attributes.position,C=new Float32Array(P.count*3);
  const G=(v,c,w)=>Math.exp(-((v-c)*(v-c))/(2*w*w));const skin=new THREE.Color(tone[0]),stub=new THREE.Color(tone[2]),dk=new THREE.Color(tone[1]),blush=new THREE.Color(tone[0]).lerp(new THREE.Color(0xc0585a),0.14),c=new THREE.Color();
  for(let i=0;i<P.count;i++){let x=P.getX(i),y=P.getY(i),z=P.getZ(i);const ax=Math.abs(x),fr=Math.max(0,z);
    const low=Math.max(0,-y);x*=1-0.32*low*low;if(y<-0.25)z*=1-0.12*low;
    z+=0.17*G(y,-0.8,0.18)*G(x,0,0.38)*fr;                 // chin
    if(z>0)z*=0.9;                                          // flatter face
    z+=0.085*G(y,0.22,0.08)*G(ax,0.36,0.3)*fr;             // brow ridge
    z-=0.075*G(y,0.07,0.09)*G(ax,0.37,0.15)*fr;            // eye sockets
    const cb=G(y,-0.06,0.14)*G(ax,0.66,0.16);x+=Math.sign(x)*0.05*cb;z+=0.03*cb*fr;   // cheekbones
    const jw=G(y,-0.55,0.16)*G(ax,0.72,0.2);x+=Math.sign(x)*0.035*jw;                // jaw angle
    x*=1-0.07*G(y,0.36,0.2);                                // temples
    if(z<0)z*=1.05;                                         // fuller back of the skull
    P.setXYZ(i,x*0.097,y*0.127,z*0.112);
    c.copy(skin);
    const st=clamp((-y-0.28)/0.3,0,1)*(z>-0.35?1:0)*(1-0.6*G(y,-0.5,0.06)*G(x,0,0.22));c.lerp(stub,0.5*st);   // stubble on jaw, chin, upper lip
    c.lerp(blush,G(y,-0.12,0.12)*G(ax,0.5,0.12)*fr);                                                         // cheeks
    c.lerp(dk,0.35*G(y,0.0,0.05)*G(ax,0.36,0.13)*fr);                                                       // under the eyes
    C[i*3]=c.r;C[i*3+1]=c.g;C[i*3+2]=c.b;}
  g.setAttribute('color',new THREE.BufferAttribute(C,3));g.computeVertexNormals();return g;}
function mergeSoldier(list){let n=0;const gs=[];const col=new THREE.Color();
  for(const it of list){const g0=it.geo.index?it.geo.toNonIndexed():it.geo;g0.computeBoundingBox();const bb=g0.boundingBox;const h=Math.max(1e-4,bb.max.y-bb.min.y);
    const ao=new Float32Array(g0.attributes.position.count);for(let i=0;i<ao.length;i++){const y=(g0.attributes.position.getY(i)-bb.min.y)/h;ao[i]=it.ao===false?1:0.74+0.26*Math.min(1,y*1.25);}
    g0.applyMatrix4(it.m);gs.push([g0,it,ao]);n+=g0.attributes.position.count;if(g0!==it.geo)it.geo.dispose();}
  const pos=new Float32Array(n*3),nor=new Float32Array(n*3),uv=new Float32Array(n*2),cl=new Float32Array(n*3);let o=0;
  for(const[g,it,ao]of gs){const P=g.attributes.position,N=g.attributes.normal,U=g.attributes.uv,c=P.count;pos.set(P.array,o*3);nor.set(N.array,o*3);
    if(it.camo){col.setRGB(1,1,1);for(let i=0;i<c;i++){uv[(o+i)*2]=(U.array[i*2]*it.uvs+it.uvo*(1-it.uvs))*0.49+0.005;uv[(o+i)*2+1]=U.array[i*2+1]*it.uvs+((it.uvo*1.7)%1)*(1-it.uvs);}}
    else{col.setHex(it.col);for(let i=0;i<c;i++){uv[(o+i)*2]=0.51+0.48*((U.array[i*2]*0.9+0.05)%1);uv[(o+i)*2+1]=U.array[i*2+1]*0.9+0.05;}}
    const VC=it.vc&&g.attributes.color?g.attributes.color.array:null;
