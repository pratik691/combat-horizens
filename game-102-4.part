         float pm=max(p1.x,p2.x)*sdet;bool f1=p1.x>=p2.x;float ps=f1?p1.y:p2.y;float ph=f1?p1.z:p2.z;
         vec3 pc=mix(vec3(0.52,0.46,0.38),vec3(0.84,0.76,0.63),ph)*(1.0+ps*0.5);
         sC.rgb=mix(sC.rgb,pc,pm*0.92);sC.rgb*=1.0-max(p1.w,p2.w)*0.10*sdet;
       }
       diffuseColor*=vec4(sC.rgb,1.0);`)
     .replace('vec3 mapN = texture2D( normalMap, vUv ).xyz * 2.0 - 1.0;','vec3 mapN = (texture2D( normalMap, sU ).xyz*sW.y+texture2D(saN,sU).xyz*sW.x+texture2D(scN,sU).xyz*sW.z) * 2.0 - 1.0; mapN.xy+=vec2(cos(ripP)*0.55,cos(ripP)*0.2)*ripM*0.3;');
  };
  m.customProgramCacheKey=()=>'sand4';
