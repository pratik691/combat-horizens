  const pl=pm(0xe9e6df),stripe=pm(0x2f5f8a);const g=new THREE.Group();g.position.set(hx,0,hz);g.rotation.y=p.rot?0:Math.PI/2;
  const fu=new THREE.Mesh(new THREE.CylinderGeometry(0.75,0.55,8.5,14),pl);fu.rotation.x=Math.PI/2;fu.position.set(0,1.5,0);g.add(fu);
  const nose=new THREE.Mesh(new THREE.SphereGeometry(0.75,14,10),pl);nose.scale.set(1,1,1.4);nose.position.set(0,1.5,4.3);g.add(nose);
  const wing=new THREE.Mesh(new THREE.BoxGeometry(10,0.18,1.6),pl);wing.position.set(0,1.75,0.6);g.add(wing);const st=new THREE.Mesh(new THREE.BoxGeometry(10.05,0.2,0.3),stripe);st.position.set(0,1.76,0.2);g.add(st);
  const tail=new THREE.Mesh(new THREE.BoxGeometry(0.15,1.6,1.3),pl);tail.position.set(0,2.6,-3.9);g.add(tail);const ts=new THREE.Mesh(new THREE.BoxGeometry(3.4,0.12,0.9),pl);ts.position.set(0,1.9,-3.9);g.add(ts);
  const prop=new THREE.Mesh(new THREE.BoxGeometry(2.2,0.12,0.06),pm(0x222222));prop.position.set(0,1.5,5.35);g.add(prop);
  for(const[wx,wz]of[[-1.2,0.8],[1.2,0.8],[0,3.6]]){const wh=new THREE.Mesh(new THREE.CylinderGeometry(0.3,0.3,0.2,12),pm(0x1c1c1c));wh.rotation.z=Math.PI/2;wh.position.set(wx,0.3,wz);g.add(wh);}
  g.traverse(o=>{if(o.isMesh){o.castShadow=o.receiveShadow=true;}});world.add(g);
  if(p.rot){brCol(hx,hz,1.6,2.3,8.5);brCol(hx,hz+0.6,10,0.5,1.6,1.5);}else{brCol(hx,hz,8.5,2.3,1.6);brCol(hx+0.6,hz,1.6,0.5,10,1.5);}
  for(let i=0;i<6;i++)brSpot(hx+rand(-6,6),0.1,hz+rand(-6,6));
  /* control tower + fuel tanks */
  const tx=p.rot?x-off:x+22,tz=p.rot?z+22:z-off;brCtrlTower(tx,tz,p.rot?1:0,p.rot?0:1);
  const tk=pm(0xd8d4c8);for(const s of[-1,1]){const fx=tx+(p.rot?0:s*6),fz=tz+(p.rot?s*6:0);const c=new THREE.Mesh(new THREE.CylinderGeometry(1.4,1.4,5,16),tk);c.rotation[p.rot?'x':'z']=Math.PI/2;brDeco(c,fx,1.4,fz);brCol(fx,fz,p.rot?2.8:5,2.8,p.rot?5:2.8);}
  brSpot(tx+2.6,0.1,tz+2.6);brSpot(tx-2.6,0.1,tz-2.6);
