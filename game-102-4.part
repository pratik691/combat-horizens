", "aN": "data:image/jpeg;base64,", "bC": "data:image/jpeg;base64,", "bN": "data:image/jpeg;base64,", "cC": "data:image/jpeg;base64,", "cN": "data:image/jpeg;base64,"};
const MAT_SAND=(()=>{const L=new THREE.TextureLoader(),T={};
