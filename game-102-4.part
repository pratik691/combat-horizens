     .replace('#include <map_fragment>',`vec3 sW=sandW();vec2 sU=vGW/1.7;vec2 sU2=vec2(sU.y,-sU.x)*0.83+0.37;
       vec4 sC=texture2D(map,sU)*sW.y+texture2D(saC,sU)*sW.x+texture2D(scC,sU)*sW.z;
